use std;
use std.path;
use std.testing.assert_eq_bool;
use std.testing.assert_eq_i32;
use std.string.strcmp;

std.cfg(std.target_os == .tos_windows, const EXPECT_PATH_LIST_SEPARATOR: byte = 59 as byte;)
std.cfg(std.target_os == .tos_linux, const EXPECT_PATH_LIST_SEPARATOR: byte = 58 as byte;)
std.cfg(std.target_os == .tos_macos, const EXPECT_PATH_LIST_SEPARATOR: byte = 58 as byte;)
std.cfg(std.target_os == .tos_unknown, const EXPECT_PATH_LIST_SEPARATOR: byte = 58 as byte;)
std.cfg(std.target_os == .tos_windows, const EXPECT_EXECUTABLE_SUFFIX: &const byte = ".exe";)
std.cfg(std.target_os == .tos_linux, const EXPECT_EXECUTABLE_SUFFIX: &const byte = "";)
std.cfg(std.target_os == .tos_macos, const EXPECT_EXECUTABLE_SUFFIX: &const byte = "";)
std.cfg(std.target_os == .tos_unknown, const EXPECT_EXECUTABLE_SUFFIX: &const byte = "";)

test "std.path module can import" {
    try assert_eq_bool(PATH_MODULE_PRESENT, true);
}

test "std.path path_list_separator follows target os" {
    try assert_eq_i32(path_list_separator() as i32, EXPECT_PATH_LIST_SEPARATOR as i32);
}

test "std.path executable_suffix follows target os" {
    try assert_eq_i32(strcmp(executable_suffix(), EXPECT_EXECUTABLE_SUFFIX), 0);
}

test "std.path is_abs detects unix windows and relative paths" {
    try assert_eq_bool(is_abs("/tmp/run.sh"), true);
    try assert_eq_bool(is_abs("C:\\repo\\uya.exe"), true);
    try assert_eq_bool(is_abs("scripts/build.uya"), false);
    try assert_eq_bool(is_abs(""), false);
}

test "std.path normalize collapses current parent and duplicate separators" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(normalize("scripts/./tool/../build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "scripts/build.uya"), 0);

    try assert_eq_i32(normalize("../scripts/../build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "../build.uya"), 0);
}

test "std.path normalize preserves roots and windows separator family" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(normalize("/tmp//uya/../run.sh", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp/run.sh"), 0);

    try assert_eq_i32(normalize("C:\\repo\\.\\bin\\..\\uya.exe", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\repo\\uya.exe"), 0);
}

test "std.path join joins relative child" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("scripts", "build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "scripts/build.uya"), 0);
}

test "std.path join avoids duplicate separator" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("/tmp/", "run.sh", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp/run.sh"), 0);
}

test "std.path join returns absolute child unchanged" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("/repo", "/tmp/out", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp/out"), 0);
}

test "std.path join preserves windows separator family" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("C:\\repo", "bin", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\repo\\bin"), 0);
}

test "std.path dirname returns parent for relative path" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("scripts/build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "scripts"), 0);
}

test "std.path dirname returns current directory when no separator exists" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "."), 0);
}

test "std.path dirname keeps unix root" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("/tmp/run.sh", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp"), 0);

    try assert_eq_i32(dirname("/tmp/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/"), 0);
}

test "std.path dirname preserves windows drive root" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("C:\\repo\\uya.exe", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\repo"), 0);

    try assert_eq_i32(dirname("C:\\repo\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\"), 0);
}

test "std.path basename returns last path component" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(basename("scripts/build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "build.uya"), 0);

    try assert_eq_i32(basename("build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "build.uya"), 0);
}

test "std.path basename trims trailing separators and preserves roots" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(basename("/tmp/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "tmp"), 0);

    try assert_eq_i32(basename("/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/"), 0);

    try assert_eq_i32(basename("C:\\repo\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "repo"), 0);

    try assert_eq_i32(basename("C:\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\"), 0);
}

test "std.path basename returns current directory marker for empty path" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(basename("", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "."), 0);
}

test "std.path stem strips only the last extension from basename" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(stem("scripts/build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "build"), 0);

    try assert_eq_i32(stem("archive.tar.gz", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "archive.tar"), 0);

    try assert_eq_i32(stem("build", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "build"), 0);
}

test "std.path stem preserves dotfiles and roots" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(stem("/tmp/.env", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ".env"), 0);

    try assert_eq_i32(stem("/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/"), 0);

    try assert_eq_i32(stem("C:\\repo\\uya.exe", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "uya"), 0);

    try assert_eq_i32(stem("C:\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\"), 0);
}

test "std.path extension returns the last suffix with dot" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(extension("scripts/build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ".uya"), 0);

    try assert_eq_i32(extension("archive.tar.gz", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ".gz"), 0);

    try assert_eq_i32(extension("build.", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "."), 0);

    try assert_eq_i32(extension("C:\\repo\\uya.exe", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ".exe"), 0);
}

test "std.path extension ignores dotfiles roots and extensionless names" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(extension("/tmp/.env", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ""), 0);

    try assert_eq_i32(extension("build", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ""), 0);

    try assert_eq_i32(extension("/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ""), 0);

    try assert_eq_i32(extension("C:\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], ""), 0);
}

test "std.path executable lookup rejects missing and empty PATH" {
    var out: [byte: 4096] = [];
    try assert_eq_i32(find_executable(null, "/", "sh", &out[0], 4096usize) as i32,
        ExecutableLookupKind.path_not_found as i32);
    try assert_eq_i32(find_executable("", "/", "sh", &out[0], 4096usize) as i32,
        ExecutableLookupKind.path_not_found as i32);
}

std.cfg(std.target_os != .tos_windows, {
test "std.path executable lookup resolves empty and relative components" {
    var out: [byte: 4096] = [];
    try assert_eq_i32(find_executable(":bin", "/", "sh", &out[0], 4096usize) as i32,
        ExecutableLookupKind.found as i32);
    try assert_eq_i32(strcmp(&out[0], "/bin/sh"), 0);
}

test "std.path executable lookup rejects directories and nonexecutables" {
    var out: [byte: 4096] = [];
    try assert_eq_i32(find_executable("/", "/", "tmp", &out[0], 4096usize) as i32,
        ExecutableLookupKind.permission_denied as i32);
    try assert_eq_i32(find_executable("/etc", "/", "passwd", &out[0], 4096usize) as i32,
        ExecutableLookupKind.permission_denied as i32);
}
})
