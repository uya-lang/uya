use std.path;
use std.testing.assert_eq_bool;
use std.testing.assert_eq_i32;
use std.string.strcmp;

test "std.path module can import" {
    try assert_eq_bool(PATH_MODULE_PRESENT, true);
}

test "std.path join joins relative child" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("scripts", "build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "scripts/build.uya"), 0);
}

test "std.path join avoids duplicate separator" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("/tmp/", "run.sh", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp/run.sh"), 0);
}

test "std.path join returns absolute child unchanged" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("/repo", "/tmp/out", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp/out"), 0);
}

test "std.path join preserves windows separator family" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(join("C:\\repo", "bin", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\repo\\bin"), 0);
}

test "std.path dirname returns parent for relative path" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("scripts/build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "scripts"), 0);
}

test "std.path dirname returns current directory when no separator exists" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "."), 0);
}

test "std.path dirname keeps unix root" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("/tmp/run.sh", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/tmp"), 0);

    try assert_eq_i32(dirname("/tmp/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/"), 0);
}

test "std.path dirname preserves windows drive root" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(dirname("C:\\repo\\uya.exe", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\repo"), 0);

    try assert_eq_i32(dirname("C:\\repo\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\"), 0);
}

test "std.path basename returns last path component" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(basename("scripts/build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "build.uya"), 0);

    try assert_eq_i32(basename("build.uya", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "build.uya"), 0);
}

test "std.path basename trims trailing separators and preserves roots" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(basename("/tmp/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "tmp"), 0);

    try assert_eq_i32(basename("/", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "/"), 0);

    try assert_eq_i32(basename("C:\\repo\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "repo"), 0);

    try assert_eq_i32(basename("C:\\", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "C:\\"), 0);
}

test "std.path basename returns current directory marker for empty path" {
    var buf: [byte: 64] = [];
    try assert_eq_i32(basename("", &buf[0], 64), 0);
    try assert_eq_i32(strcmp(&buf[0], "."), 0);
}
