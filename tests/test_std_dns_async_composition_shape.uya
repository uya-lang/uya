// test_std_dns_async_composition_shape.uya - DNS transport/aggregate async 组合层源码回归

use std.string.strlen;
use std.testing.assert_eq_i32;
use libc.syscall;

error DnsAsyncShapeSourceOpenFailed;
error DnsAsyncShapeSourceReadFailed;

const DNS_SOURCE_PATH: &const byte = "lib/std/net/dns.uya\0" as &const byte;
const DNS_SOURCE_MAX: usize = 131072;

fn bytes_equal_at(hay: &const byte, hay_len: usize, start: usize, needle: &const byte, needle_len: usize) bool {
    if start + needle_len > hay_len {
        return false;
    }
    var i: usize = 0;
    while i < needle_len {
        if hay[start + i] != needle[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn source_contains(hay: &const byte, hay_len: usize, needle: &const byte, needle_len: usize) bool {
    if needle_len == 0 {
        return true;
    }
    if hay_len < needle_len {
        return false;
    }
    var i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal_at(hay, hay_len, i, needle, needle_len) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn source_contains_cstr(hay: &const byte, hay_len: usize, needle: &const byte) bool {
    return source_contains(hay, hay_len, needle, strlen(needle));
}

fn read_dns_source(buf: &byte, cap: usize) !usize {
    const fd: i32 = sys_open(DNS_SOURCE_PATH, O_RDONLY as i32, 0) catch {
        return error.DnsAsyncShapeSourceOpenFailed;
    };
    const n: isize = sys_read(fd, buf as *byte, cap) catch {
        _ = sys_close(fd) catch {};
        return error.DnsAsyncShapeSourceReadFailed;
    };
    _ = sys_close(fd) catch {};
    if n < 0 {
        return error.DnsAsyncShapeSourceReadFailed;
    }
    return (n as! usize).value;
}

test "dns_async_transport_and_aggregate_use_async_fn_composition" {
    var src: [byte: DNS_SOURCE_MAX] = [0: DNS_SOURCE_MAX];
    const len: usize = try read_dns_source(&src[0], DNS_SOURCE_MAX);

    try assert_eq_i32(source_contains_cstr(&src[0], len, "@async_fn fn dns_query_transport_future_new(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize, mode: i32) Future<!usize>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "@async_fn fn dns_client_query_all_any_async(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize) Future<!usize>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct DnsQueryTransportFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct DnsQueryAllAggregateFuture : Future<!usize>\0" as &const byte) as i32, 0);
}
