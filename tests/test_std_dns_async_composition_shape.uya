// test_std_dns_async_composition_shape.uya - DNS transport/aggregate async 组合层源码回归

use std.string.strlen;
use std.testing.assert_eq_i32;
use libc.syscall;

error DnsAsyncShapeSourceOpenFailed;
error DnsAsyncShapeSourceReadFailed;

const DNS_SOURCE_PATH: &const byte = "lib/std/net/dns.uya\0" as &const byte;
const ASYNC_SOURCE_PATH: &const byte = "lib/std/async.uya\0" as &const byte;
const DNS_SOURCE_MAX: usize = 131072;

fn bytes_equal_at(hay: &const byte, hay_len: usize, start: usize, needle: &const byte, needle_len: usize) bool {
    if start + needle_len > hay_len {
        return false;
    }
    var i: usize = 0;
    while i < needle_len {
        if hay[start + i] != needle[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn source_contains(hay: &const byte, hay_len: usize, needle: &const byte, needle_len: usize) bool {
    if needle_len == 0 {
        return true;
    }
    if hay_len < needle_len {
        return false;
    }
    var i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal_at(hay, hay_len, i, needle, needle_len) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn source_contains_cstr(hay: &const byte, hay_len: usize, needle: &const byte) bool {
    return source_contains(hay, hay_len, needle, strlen(needle));
}

fn source_find(hay: &const byte, hay_len: usize, needle: &const byte, needle_len: usize) usize {
    if needle_len == 0 {
        return 0;
    }
    if hay_len < needle_len {
        return hay_len;
    }
    var i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal_at(hay, hay_len, i, needle, needle_len) {
            return i;
        }
        i = i + 1;
    }
    return hay_len;
}

fn source_find_cstr(hay: &const byte, hay_len: usize, needle: &const byte) usize {
    return source_find(hay, hay_len, needle, strlen(needle));
}

fn source_section_contains_cstr(hay: &const byte, hay_len: usize, start_marker: &const byte, end_marker: &const byte, needle: &const byte) bool {
    const start_idx: usize = source_find_cstr(hay, hay_len, start_marker);
    if start_idx >= hay_len {
        return false;
    }
    const section_ptr: &const byte = &hay[start_idx];
    const section_len: usize = hay_len - start_idx;
    const end_rel: usize = source_find_cstr(section_ptr, section_len, end_marker);
    var body_len: usize = section_len;
    if end_rel < section_len {
        body_len = end_rel;
    }
    return source_contains_cstr(section_ptr, body_len, needle);
}

fn read_source(path: &const byte, buf: &byte, cap: usize) !usize {
    const fd: i32 = sys_open(path, O_RDONLY as i32, 0) catch {
        return error.DnsAsyncShapeSourceOpenFailed;
    };
    const n: isize = sys_read(fd, buf as *byte, cap) catch {
        _ = sys_close(fd) catch {};
        return error.DnsAsyncShapeSourceReadFailed;
    };
    _ = sys_close(fd) catch {};
    if n < 0 {
        return error.DnsAsyncShapeSourceReadFailed;
    }
    return (n as! usize).value;
}

test "dns_async_transport_and_aggregate_use_async_fn_composition" {
    var src: [byte: DNS_SOURCE_MAX] = [0: DNS_SOURCE_MAX];
    const len: usize = try read_source(DNS_SOURCE_PATH, &src[0], DNS_SOURCE_MAX);
    const tcp_start: &const byte = "@async_fn fn dns_tcp_future_new(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize, mode: i32) Future<!usize> {\0" as &const byte;
    const transport_start: &const byte = "@async_fn fn dns_query_transport_future_new(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize, mode: i32) Future<!usize> {\0" as &const byte;
    const aggregate_start: &const byte = "@async_fn fn dns_client_query_all_any_async(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize) Future<!usize> {\0" as &const byte;
    const aggregate_end: &const byte = "export fn dns_client_query_a_tcp_future(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize) Future<!usize> {\0" as &const byte;
    const join_start: &const byte = "export @async_fn fn async_join2_usize_results(first: Future<!usize>, first_out: &usize, first_error_out: &u32, second: Future<!usize>, second_out: &usize, second_error_out: &u32) Future<!usize> {\0" as &const byte;
    const join_end: &const byte = "fn async_registry_ok_monos() void {\0" as &const byte;

    try assert_eq_i32(source_contains_cstr(&src[0], len, "@async_fn fn dns_tcp_future_new(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize, mode: i32) Future<!usize>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "@async_fn fn dns_query_transport_future_new(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize, mode: i32) Future<!usize>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "@async_fn fn dns_client_query_all_any_async(ctx: &DnsClient, host: &const byte, host_len: usize, out: &byte, out_max: usize, out_len: &usize) Future<!usize>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct DnsTcpFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "fn dns_tcp_future_poll(self: &DnsTcpFuture, waker: &Waker) Poll<!usize> {\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct DnsQueryTransportFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct DnsQueryAllAggregateFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, tcp_start, transport_start, ".poll(\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, tcp_start, transport_start, "@await async_connect(fd, &sockaddr[0] as &void, 16 as u32, deadline_ms)\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, tcp_start, transport_start, "@await async_socket_send(fd, send_base as &const byte, remaining, deadline_ms)\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, tcp_start, transport_start, "@await async_socket_recv(fd, prefix_recv_base, 2 - bytes_received, deadline_ms)\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, transport_start, aggregate_start, "const udp_result: !usize = @await udp_future;\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, transport_start, aggregate_start, "const tcp_n: usize = try @await tcp_future;\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, transport_start, aggregate_start, ".poll(\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, aggregate_start, aggregate_end, "async_join2_usize_results(a_future, &a_n, &a_err_id, aaaa_future, &aaaa_n, &aaaa_err_id)\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, aggregate_start, aggregate_end, ".poll(\0" as &const byte) as i32, 0);

    var async_src: [byte: DNS_SOURCE_MAX] = [0: DNS_SOURCE_MAX];
    const async_len: usize = try read_source(ASYNC_SOURCE_PATH, &async_src[0], DNS_SOURCE_MAX);
    try assert_eq_i32(source_contains_cstr(&async_src[0], async_len, "struct AsyncJoin2UsizeResultsFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&async_src[0], async_len, "return AsyncJoin2UsizeResultsFuture{\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&async_src[0], async_len, "export @async_fn fn async_join2_usize_results(first: Future<!usize>, first_out: &usize, first_error_out: &u32, second: Future<!usize>, second_out: &usize, second_error_out: &u32) Future<!usize>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&async_src[0], async_len, join_start, join_end, "const first_poll: Poll<!usize> = first.poll(&first_waker);\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&async_src[0], async_len, join_start, join_end, "const second_poll: Poll<!usize> = second.poll(&second_waker);\0" as &const byte) as i32, 1);
}
