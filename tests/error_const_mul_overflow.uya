// error_const_mul_overflow.uya - 常量乘法溢出编译错误
//
// 规范 §14.2 整数溢出行：常量溢出 → 编译错误。既有负例
// error_const_overflow.uya 覆盖加法，这里补齐乘法：46341² 略大于 i32 最大值，
// 是「两个操作数各自都在范围内、乘积越界」的经典边界。
//
// 预期：编译失败，报告「常量表达式溢出: 乘法结果超出 i32 范围」

export fn main() i32 {
    // 46341 * 46341 = 2147488281 > 2147483647
    const mul_overflow: i32 = 46341 * 46341;

    return mul_overflow;
}
