// test_bounds_const_negative_index.uya - 常量下标的边界证明正向回归
//
// 与 tests/error_array_bounds_const_negative_index.uya 配对：
// 「常量求值用成功标志而不是 -1 哨兵」这一改动最容易出的错是「收紧到误报」——
// 把合法的常量下标也当成无法求值。本用例覆盖所有应当放行的常量下标形态，
// 并在运行期校验取值正确。
//
// 覆盖：
//   1. 常量 0 / 上界 len-1；
//   2. 中间折叠结果为负数再回到合法范围的表达式（如 `a[3 - 2]`、`a[(0-1)+1]`）；
//   3. 常量参与乘法 / 除法 / 取模的下标；
//   4. 经局部 const 或全局 const 传入的下标；
//   5. `@len(arr) - 1` 这类以上界为基准的写法。

use std.runtime.entry;
use std.testing.assert_eq_i32;
use std.testing.test_suite_begin;
use std.testing.test_suite_end;
use std.testing.run_test;

const GLOBAL_LAST: i32 = 2;
const GLOBAL_NEG_THEN_BACK: i32 = (0 - 1) + 2;

fn const_zero() !void {
    const a: [i32: 3] = [10, 20, 30];
    try assert_eq_i32(a[0], 10);
}

fn const_upper_bound() !void {
    const a: [i32: 3] = [10, 20, 30];
    try assert_eq_i32(a[2], 30);
}

fn const_negative_then_legal() !void {
    const a: [i32: 3] = [10, 20, 30];
    // 中间折叠出 -1，最终仍是合法下标 1
    try assert_eq_i32(a[3 - 2], 20);
    try assert_eq_i32(a[(0 - 1) + 2], 20);
}

fn const_arithmetic_index() !void {
    const a: [i32: 4] = [1, 2, 3, 4];
    try assert_eq_i32(a[2 * 2 - 1], 4);
    try assert_eq_i32(a[4 / 2], 3);
    try assert_eq_i32(a[5 % 4], 2);
}

fn const_via_local_const() !void {
    const a: [i32: 3] = [10, 20, 30];
    const k: i32 = 1;
    try assert_eq_i32(a[k], 20);
}

fn const_via_global_const() !void {
    const a: [i32: 3] = [10, 20, 30];
    try assert_eq_i32(a[GLOBAL_LAST], 30);
    try assert_eq_i32(a[GLOBAL_NEG_THEN_BACK], 20);
}

fn const_len_minus_one() !void {
    const a: [i32: 3] = [10, 20, 30];
    try assert_eq_i32(a[@len(a) - 1], 30);
}

export fn main() i32 {
    test_suite_begin("Const Subscript Bounds");
    run_test("const zero", const_zero);
    run_test("const upper bound", const_upper_bound);
    run_test("const negative then legal", const_negative_then_legal);
    run_test("const arithmetic index", const_arithmetic_index);
    run_test("const via local const", const_via_local_const);
    run_test("const via global const", const_via_global_const);
    run_test("const len minus one", const_len_minus_one);
    return test_suite_end();
}
