// error_const_neg_overflow.uya - 常量一元负溢出编译错误
//
// 规范 §14.2 整数溢出行：常量溢出 → 编译错误。i32 最小值取负在数学上超出
// i32 范围（对称数轴上没有对应正值），是最容易漏掉的一条常量溢出路径。
// 这里确认 `check_i32_neg_overflow` 接在诊断上。
//
// 写法说明：用 `0 - 2147483647 - 1` 而不是 `-2147483648`，避免依赖字面量
// 解析对最小值的处理；外层再加一元负号即触发检查。
//
// 预期：编译失败，报告「常量表达式溢出: 一元负运算超出 i32 范围」

export fn main() i32 {
    // -(i32 最小值) 溢出
    const neg_overflow: i32 = -(0 - 2147483647 - 1);

    return neg_overflow;
}
