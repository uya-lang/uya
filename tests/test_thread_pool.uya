// test_thread_pool.uya - 并行执行器测试
// 测试 std.thread.pool 模块

use std.thread.pool;
use std.thread.pool.ParallelExecutor;
use std.thread.pool.executor_init;
use std.thread.pool.executor_destroy;
use std.thread.pool.executor_add_task;
use std.thread.pool.executor_task_done;
use std.thread.pool.executor_is_done;
use std.thread.pool.executor_has_errors;
use std.thread.pool.executor_get_completed;
use std.thread.pool.executor_get_total;
use std.testing.expect;

test "executor_init_and_destroy" {
    var exec: ParallelExecutor = ParallelExecutor {
        total_tasks: 0,
        completed_tasks: 0,
        error_count: 0,
        initialized: 0,
    };
    
    const result: i32 = executor_init(&exec);
    try expect(result == 0);
    try expect(exec.initialized == 1);
    
    executor_destroy(&exec);
    try expect(exec.initialized == 0);
}

test "executor_add_and_complete_tasks" {
    var exec: ParallelExecutor = ParallelExecutor {
        total_tasks: 0,
        completed_tasks: 0,
        error_count: 0,
        initialized: 0,
    };
    
    const init_result: i32 = executor_init(&exec);
    try expect(init_result == 0);
    
    // 添加任务
    const task1: i32 = executor_add_task(&exec);
    const task2: i32 = executor_add_task(&exec);
    const task3: i32 = executor_add_task(&exec);
    
    try expect(task1 == 0);
    try expect(task2 == 1);
    try expect(task3 == 2);
    try expect(executor_get_total(&exec) == 3);
    
    // 标记完成
    executor_task_done(&exec, 0);
    executor_task_done(&exec, 0);
    executor_task_done(&exec, 1);  // 一个错误
    
    try expect(executor_get_completed(&exec) == 3);
    try expect(executor_has_errors(&exec) == 1);
    try expect(executor_is_done(&exec) == 1);
    
    executor_destroy(&exec);
}
