// test_std_net_socket.uya - 验证 std.net.socket 的基础 fd 标志行为

use std.net.socket;
use std.testing.assert_eq_i32;
use std.testing.assert_true;
use libc.syscall;

fn write_stderr_msg(msg: &[byte]) void {
    _ = sys_write(2, msg.ptr, msg.len);
}

fn allow_skip_network() bool {
    const fd_res: !i32 = sys_open("/tmp/uya_allow_skip_network", O_RDONLY as i32, 0);
    const fd: i32 = fd_res catch {
        return false;
    };
    _ = sys_close(fd) catch {};
    return true;
}

fn socket_tests_supported() bool {
    const sock_res: !i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    const fd: i32 = sock_res catch {
        return false;
    };
    _ = sys_close(fd) catch {};
    return true;
}

fn socket_test_gate() i32 {
    if socket_tests_supported() {
        return 0;
    }
    if allow_skip_network() {
        write_stderr_msg(&"skip:std_net_socket\n"[0: 20]);
        return 1;
    }
    write_stderr_msg(&"std_net_socket unavailable; set ALLOW_SKIP_NETWORK=1 to skip\n"[0: 62]);
    return -1;
}

test "socket_set_nonblocking_on_valid_fd" {
    const gate: i32 = socket_test_gate();
    if gate > 0 {
        return;
    }
    if gate < 0 {
        try assert_eq_i32(0, 1);
        return;
    }

    const fd: i32 = try sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    defer {
        _ = sys_close(fd) catch {};
    }

    const flags_before: i32 = try sys_fcntl(fd, F_GETFL, 0);
    try assert_eq_i32(flags_before & O_NONBLOCK, 0);

    try net_socket_set_nonblocking(fd);

    const flags_after: i32 = try sys_fcntl(fd, F_GETFL, 0);
    try assert_true((flags_after & O_NONBLOCK) != 0);
}

test "socket_set_cloexec_on_valid_fd" {
    const gate: i32 = socket_test_gate();
    if gate > 0 {
        return;
    }
    if gate < 0 {
        try assert_eq_i32(0, 1);
        return;
    }

    const fd: i32 = try sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    defer {
        _ = sys_close(fd) catch {};
    }

    const flags_before: i32 = try sys_fcntl(fd, F_GETFD, 0);
    try assert_eq_i32(flags_before & FD_CLOEXEC, 0);

    try net_socket_set_cloexec(fd);

    const flags_after: i32 = try sys_fcntl(fd, F_GETFD, 0);
    try assert_true((flags_after & FD_CLOEXEC) != 0);
}
