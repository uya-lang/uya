// test_i64_wrapping_chain.uya - 饱和/包装运算在复合表达式里不能被截断成 i32 域
//
// 背景（v0.12.0 发版时定位）：C99 后端选饱和/包装运算的 C 类型时，先用
// `get_c_type_of_expr(左操作数)`；这个函数对**复合**左操作数（cast 表达式、二元表达式）
// 只会回落到 int32_t 兜底，于是整条链按 32 位发射：
//
//   const days: i64 = 29072;
//   days *% 86400 as i64 +% 3600      // 期望 2511824400，实际 -1783142896（mod 2^32）
//
// 后果不只是数值不对：lib/tls/x509/cert.uya 的 `time_components_to_unix` 用这条链算
// 证书 notAfter，凡 notAfter 晚于 2038-01-19 的证书都会被算成负时间戳（= 已过期），
// 也就是 X.509 侧的 2038 问题。VM 后端一直是正确的，所以这是 C99 后端的单边缺陷。
//
// 本用例覆盖：复合左操作数 + i32 字面量的 i64 链（包装与饱和）、以及 u8 饱和边界
// 不能被提宽（提宽会把 `u8 +| 10` 的钳位从 255 变成 int32 的 2147483647）。

use std.runtime.entry;

/// 断言两个 i64 相等；不等返回 1，相等返回 0。
fn expect_i64(actual: i64, expected: i64) i32 {
    if actual != expected {
        return 1;
    }
    return 0;
}

export fn main() i32 {
    const days: i64 = 29072;

    // 1. 左操作数是一次 cast（值已超过 i32 上限），右操作数是 i32 字面量
    if expect_i64((2511820800 as i64) +% 3600, 2511824400) != 0 {
        return 1;
    }
    // 2. 左操作数是二元表达式（结果超过 i32 上限）
    if expect_i64(days *% 86400 +% 3600, 2511824400) != 0 {
        return 2;
    }
    // 3. 整条链（x509 有效期计算的原始形状）
    if expect_i64(days *% 86400 as i64 +% 1 *% 3600 as i64 +% 44 *% 60 as i64 +% 11, 2511827051) != 0 {
        return 3;
    }
    // 4. 链上第二次运算就跨过 i32 上限
    if expect_i64(days *% 86400 as i64 +% 3600 as i64, 2511824400) != 0 {
        return 4;
    }
    // 5. 饱和运算（+|）同样不能按 i32 发射
    if expect_i64((2511820800 as i64) +| 3600, 2511824400) != 0 {
        return 5;
    }
    // 6. 负值侧：i64 域内不该被钳到 i32 边界（期望值用等价的 i64 表达式给出，
    //    避免依赖「大于 INT32_MAX 的无后缀字面量」的推断行为）
    var big: i64 = 2511820800;
    if expect_i64((0 as i64) -% big *| 2, (0 as i64) -% big -% big) != 0 {
        return 6;
    }
    // 7. u8 饱和边界必须保持 u8 语义（不能被提宽成 int32）
    var small: u8 = 250;
    const sat: u8 = small +| 10;
    if sat != (255 as u8) {
        return 7;
    }
    return 0;
}
