// test_string_layer.uya - mem 层字符串操作测试
// 测试 lib/mem/mem.uya 的纯字符串操作函数

use mem.str_len;
use mem.str_nlen;
use mem.str_cmp;
use mem.str_ncmp;
use mem.str_cpy;
use mem.str_ncpy;
use mem.str_cat;
use mem.str_ncat;
use mem.str_chr;
use mem.str_rchr;
use std.testing.expect;
use std.testing.assert_eq_i32;

// ============================================================
// 测试用例
// ============================================================

test "str_len" {
    const s1: *byte = "hello";
    const len1: usize = str_len(s1);
    try expect(len1 == 5);

    const s2: *byte = "";
    const len2: usize = str_len(s2);
    try expect(len2 == 0);
}

test "str_nlen" {
    const s: *byte = "hello world";
    const len1: usize = str_nlen(s, 5);
    try expect(len1 == 5);
    
    const len2: usize = str_nlen(s, 100);
    try expect(len2 == 11);
}

test "str_cmp" {
    const s1: *byte = "hello";
    const s2: *byte = "hello";
    const cmp1: i32 = str_cmp(s1, s2);
    try expect(cmp1 == 0);
    
    const s3: *byte = "hello";
    const s4: *byte = "world";
    const cmp2: i32 = str_cmp(s3, s4);
    try expect(cmp2 < 0);
    
    const cmp3: i32 = str_cmp(s4, s3);
    try expect(cmp3 > 0);
}

test "str_ncmp" {
    const s1: *byte = "hello";
    const s2: *byte = "hello world";
    const cmp1: i32 = str_ncmp(s1, s2, 5);
    try expect(cmp1 == 0);
    
    const s3: *byte = "hello";
    const s4: *byte = "help";
    const cmp2: i32 = str_ncmp(s3, s4, 4);
    try expect(cmp2 < 0);
}

test "str_cpy" {
    var dest: [byte: 10] = [];
    const src: *byte = "hello";
    
    const result: &byte = str_cpy(&dest[0], src);
    try expect(result == &dest[0]);
    
    try expect(dest[0] == 'h');
    try expect(dest[1] == 'e');
    try expect(dest[2] == 'l');
    try expect(dest[3] == 'l');
    try expect(dest[4] == 'o');
    try expect(dest[5] == 0);
}

test "str_ncpy" {
    var dest: [byte: 10] = [];
    const src: *byte = "hello";
    
    const result: &byte = str_ncpy(&dest[0], src, 3);
    try expect(result == &dest[0]);
    
    try expect(dest[0] == 'h');
    try expect(dest[1] == 'e');
    try expect(dest[2] == 'l');
}

test "str_cat" {
    var dest: [byte: 20] = [];
    dest[0] = 'h';
    dest[1] = 'i';
    dest[2] = 0;
    
    const src: *byte = " world";
    const result: &byte = str_cat(&dest[0], src);
    try expect(result == &dest[0]);
    
    try expect(dest[0] == 'h');
    try expect(dest[1] == 'i');
    try expect(dest[2] == ' ');
    try expect(dest[3] == 'w');
}

test "str_ncat" {
    var dest: [byte: 20] = [];
    dest[0] = 'h';
    dest[1] = 'i';
    dest[2] = 0;
    
    const src: *byte = " world";
    const result: &byte = str_ncat(&dest[0], src, 3);
    try expect(result == &dest[0]);
    
    try expect(dest[0] == 'h');
    try expect(dest[1] == 'i');
    try expect(dest[2] == ' ');
    try expect(dest[3] == 'w');
    try expect(dest[4] == 'o');
    try expect(dest[5] == 'r');
    try expect(dest[6] == 0);
}

test "str_chr" {
    const s: *byte = "hello world";
    
    const result1: &const byte = str_chr(s, 'o');
    try expect(result1 != null);
    try expect(result1[0] == 'o');
    
    const result2: &const byte = str_chr(s, 'x');
    try expect(result2 == null);
    
    const result3: &const byte = str_chr(s, 0);
    try expect(result3 != null);
    try expect(result3[0] == 0);
}

test "str_rchr" {
    const s: *byte = "hello world";
    
    const result1: &const byte = str_rchr(s, 'o');
    try expect(result1 != null);
    try expect(result1[0] == 'o');
    
    const result2: &const byte = str_rchr(s, 'x');
    try expect(result2 == null);
    
    const result3: &const byte = str_rchr(s, 0);
    try expect(result3 != null);
    try expect(result3[0] == 0);
}
