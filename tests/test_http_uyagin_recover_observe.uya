use std.async;
use std.http.types;
use std.http.uyagin;
use std.string.strlen;
use std.testing.assert_eq_i32;
use std.testing.assert_eq_u64;
use std.testing.assert_true;
use libc.O_RDONLY;
use libc.sys_close;
use libc.sys_open;
use libc.sys_pipe2;
use libc.sys_read;

error UyaginSourceOpenFailed;
error UyaginSourceReadFailed;

const UYAGIN_SOURCE_PATH: &const byte = "lib/std/http/uyagin.uya\0" as &const byte;
const UYAGIN_SOURCE_MAX: usize = 131072;

struct RecoverErrorHandler : AsyncHandler {}

RecoverErrorHandler {
    @async_fn
    fn handle(self: &Self, ctx: &GinContext) Future<!i32> {
        _ = self;
        _ = ctx;
        return error.HandlerMissing;
    }
}

fn bytes_equal_at(hay: &const byte, hay_len: usize, start: usize, needle: &const byte, needle_len: usize) bool {
    if start + needle_len > hay_len {
        return false;
    }
    var i: usize = 0;
    while i < needle_len {
        if hay[start + i] != needle[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn source_contains(hay: &const byte, hay_len: usize, needle: &const byte, needle_len: usize) bool {
    if needle_len == 0 {
        return true;
    }
    if hay_len < needle_len {
        return false;
    }
    var i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal_at(hay, hay_len, i, needle, needle_len) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn source_contains_cstr(hay: &const byte, hay_len: usize, needle: &const byte) bool {
    return source_contains(hay, hay_len, needle, strlen(needle));
}

fn find_slice(hay: &[const byte], needle: &[const byte]) usize {
    if needle.len == 0 {
        return 0;
    }
    if hay.len < needle.len {
        return hay.len;
    }
    var i: usize = 0;
    while i + needle.len <= hay.len {
        var matched: bool = true;
        var j: usize = 0;
        while j < needle.len {
            if hay.ptr[i + j] != needle.ptr[j] {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return i;
        }
        i = i + 1;
    }
    return hay.len;
}

fn slice_has(hay: &[const byte], needle: &[const byte]) bool {
    return find_slice(hay, needle) < hay.len;
}

fn read_uyagin_source(buf: &byte, cap: usize) !usize {
    const fd: i32 = sys_open(UYAGIN_SOURCE_PATH, O_RDONLY as i32, 0) catch {
        return error.UyaginSourceOpenFailed;
    };
    const n: isize = sys_read(fd, buf as *byte, cap) catch {
        _ = sys_close(fd) catch {};
        return error.UyaginSourceReadFailed;
    };
    _ = sys_close(fd) catch {};
    if n < 0 {
        return error.UyaginSourceReadFailed;
    }
    return (n as! usize).value;
}

fn fill_request_path(req: &Request, path: &[const byte]) void {
    var i: usize = 0;
    while i < path.len && i < MAX_URI_LENGTH as usize {
        req.path[i] = path.ptr[i];
        i = i + 1;
    }
    req.path_len = path.len as i32;
}

fn run_engine_request_with_log(engine: &Engine, method: Method, path: &[const byte], out: &byte, out_cap: usize, log_out: &byte, log_cap: usize, log_n_out: &isize) !isize {
    var empty_raw: [byte: 1] = [];
    var req: Request = Request{
        method: method,
        http11: true,
        path: [],
        path_len: 0,
        path_params: [],
        path_param_count: 0,
        query: [],
        query_count: 0,
        headers: [],
        header_count: 0,
        body: empty_raw[0: 0],
    };
    fill_request_path(&req, path);

    var resp_fds: [i32: 2] = [0: 2];
    _ = try sys_pipe2(&resp_fds[0], 0);
    var log_fds: [i32: 2] = [0: 2];
    _ = try sys_pipe2(&log_fds[0], 0);
    var cfg: UyaginConfig = uyagin_config(engine);
    cfg.access_log.fd = log_fds[1];
    uyagin_set_config(engine, cfg);

    var ctx: GinContext = uyagin_context_new(resp_fds[1], &req, false, null);
    const fut: Future<!i32> = engine.handle(&ctx);
    _ = try block_on<i32>(fut);
    _ = sys_close(resp_fds[1]) catch {};
    _ = sys_close(log_fds[1]) catch {};
    const resp_n: isize = try sys_read(resp_fds[0], out, out_cap);
    *log_n_out = try sys_read(log_fds[0], log_out, log_cap);
    _ = sys_close(resp_fds[0]) catch {};
    _ = sys_close(log_fds[0]) catch {};
    return resp_n;
}

test "uyagin_recover_observe_use_async_wrappers_without_manual_future" {
    var src: [byte: UYAGIN_SOURCE_MAX] = [0: UYAGIN_SOURCE_MAX];
    const len: usize = try read_uyagin_source(&src[0], UYAGIN_SOURCE_MAX);

    try assert_eq_i32(source_contains_cstr(&src[0], len, "export @async_fn fn uyagin_run_chain_recover(engine: &Engine, ctx: &GinContext, route: &GinRoute) Future<!i32>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "@async_fn fn uyagin_observe_request_future(engine: &Engine, ctx: &GinContext, inner: Future<!i32>) Future<!i32>\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct UyaginRecoverFuture : Future<!i32>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct UyaginObserveFuture : Future<!i32>\0" as &const byte) as i32, 0);
}

test "uyagin_recover_finishes_before_observe_logs_and_metrics" {
    var engine: Engine = uyagin_new();
    var handler_impl: RecoverErrorHandler = RecoverErrorHandler{};
    const handler: AsyncHandler = handler_impl;
    try engine.GET("/err", handler);

    var run_opts: EngineRunOptions = uyagin_run_options_default();
    run_opts.mode = UyaginMode.Debug;
    var access_opts: UyaginAccessLogOptions = uyagin_access_log_options_default();
    access_opts.enabled = true;
    access_opts.sample_every = 1u32;
    uyagin_set_config(&engine, UyaginConfig{
        allocator: null,
        limits: uyagin_limits_default(),
        run_options: run_opts,
        access_log: access_opts,
    });

    var rb: [byte: 512] = [];
    var logb: [byte: 1024] = [];
    var log_n: isize = 0;
    const resp_n: isize = try run_engine_request_with_log(&engine, Method.GET, "/err", &rb[0] as &byte, 512, &logb[0] as &byte, 1024, &log_n);
    if resp_n <= 0 {
        try assert_eq_i32(0, 1);
    }
    if log_n <= 0 {
        try assert_eq_i32(0, 1);
    }

    const resp: &[byte] = rb[0: resp_n as usize];
    if !slice_has(resp, "500 Internal Server Error") {
        try assert_eq_i32(0, 1);
    }

    const log: &[byte] = logb[0: log_n as usize];
    const trace_idx: usize = find_slice(log, "uyagin: trace error=HandlerMissing status=500");
    const access_idx: usize = find_slice(log, "uyagin: access GET /err status=500");
    try assert_true(trace_idx < log.len);
    try assert_true(access_idx < log.len);
    try assert_true(trace_idx < access_idx);
    if !slice_has(log, "wrote=1") {
        try assert_eq_i32(0, 1);
    }

    const metrics: &UyaginMetrics = uyagin_metrics(&engine);
    try assert_eq_u64(metrics.request_count, 1u64);
    try assert_eq_u64(metrics.status_500_count, 1u64);
}
