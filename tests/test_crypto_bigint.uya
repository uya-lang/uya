// test_crypto_bigint.uya — 定长大数与模幂向量
//
// 期望值全部由 Python 的任意精度整数独立算出（不是从本实现反推），覆盖：
//   * n0inv = -n^{-1} mod 2^64
//   * Montgomery 乘法 r = a·b·R^{-1} mod n（2048 位与 4096 位各一组）
//   * R² mod n
//   * 模幂 base^exp mod n（e=65537 与随机 2048 位指数；后者跑满 2048 轮平方乘）
//   * add/sub/cmp 的跨 limb 进位与大端往返
//
// 注意：所有 hex 字面量都是**定宽**的（2*nbytes 位），避免前导零被省略后
// 切片越界——那会让测试自己出错，而不是实现出错。

use std.crypto.bigint;
use std.crypto.bigint.BIGINT_LIMBS;
use std.testing.assert_eq_i32;

/// 小写十六进制字符转 4 位数值。
fn hex_val(c: byte) byte {
    if c >= 48 && c <= 57 {
        return (c - 48) as byte;
    }
    return (c - 87) as byte;
}

/// 大端 hex 串（定宽偶数长）解成字节。
fn hex_to_bytes(hex: &[byte], bytes: &byte, nbytes: usize) void {
    var i: usize = 0;
    while i < nbytes {
        const hi: byte = hex_val(hex.ptr[i * 2]);
        const lo: byte = hex_val(hex.ptr[i * 2 + 1]);
        bytes[i] = ((hi << 4) | lo) as byte;
        i = i + 1;
    }
}

/// 从定宽 hex 串装载一枚定长大数。
fn load_hex(hex: &[byte], nbytes: usize, l: &u64) void {
    var bytes: [byte: 512] = [];
    hex_to_bytes(hex, &bytes[0], nbytes);
    bigint_from_be(l, &bytes[0], nbytes, BIGINT_LIMBS);
}

/// 断言大数等于期望值（同为定宽 hex）。
fn check_hex(l: &const u64, hex: &[byte], nbytes: usize) !void {
    var got: [byte: 512] = [];
    var want: [byte: 512] = [];
    bigint_to_be(&got[0], l, BIGINT_LIMBS);
    hex_to_bytes(hex, &want[0], nbytes);
    const skip: usize = 512 -| nbytes;
    var z: usize = 0;
    while z < skip {
        try assert_eq_i32(got[z] as i32, 0);
        z = z + 1;
    }
    var i: usize = 0;
    while i < nbytes {
        try assert_eq_i32(got[skip + i] as i32, want[i] as i32);
        i = i + 1;
    }
}

/// 比较 u64 与期望值（拆 32 位，避开 i32 窄化）。
fn check_u64(v: u64, expected: u64) !void {
    const lo_got: u64 = v & 0xffffffffu64;
    const hi_got: u64 = v >> 32;
    const lo_exp: u64 = expected & 0xffffffffu64;
    const hi_exp: u64 = expected >> 32;
    try assert_eq_i32((lo_got >> 16) as i32, (lo_exp >> 16) as i32);
    try assert_eq_i32((lo_got & 0xffffu64) as i32, (lo_exp & 0xffffu64) as i32);
    try assert_eq_i32((hi_got >> 16) as i32, (hi_exp >> 16) as i32);
    try assert_eq_i32((hi_got & 0xffffu64) as i32, (hi_exp & 0xffffu64) as i32);
}

test "bigint_n0inv_2048" {
    var n: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 512], 256, &n[0]);
    const inv: u64 = bigint_n0inv(&n[0]);
    try check_u64(inv, 4902667234721611829u64);
}

test "bigint_n0inv_4096" {
    var n: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 1024], 512, &n[0]);
    const inv: u64 = bigint_n0inv(&n[0]);
    try check_u64(inv, 12539494449152446919u64);
}

test "bigint_mont_mul_2048" {
    var a: [u64: BIGINT_LIMBS] = [];
    var b: [u64: BIGINT_LIMBS] = [];
    var n: [u64: BIGINT_LIMBS] = [];
    var r: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 512], 256, &a[0]);
    load_hex(&""[0: 512], 256, &b[0]);
    load_hex(&""[0: 512], 256, &n[0]);
    bigint_mont_mul(&r[0], &a[0], &b[0], &n[0], 4902667234721611829u64);
    try check_hex(&r[0], &""[0: 512], 256);
}

test "bigint_mont_mul_4096" {
    var a: [u64: BIGINT_LIMBS] = [];
    var b: [u64: BIGINT_LIMBS] = [];
    var n: [u64: BIGINT_LIMBS] = [];
    var r: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 1024], 512, &a[0]);
    load_hex(&""[0: 1024], 512, &b[0]);
    load_hex(&""[0: 1024], 512, &n[0]);
    bigint_mont_mul(&r[0], &a[0], &b[0], &n[0], 12539494449152446919u64);
    try check_hex(&r[0], &""[0: 1024], 512);
}

test "bigint_mont_r2_2048" {
    var n: [u64: BIGINT_LIMBS] = [];
    var r2: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 512], 256, &n[0]);
    bigint_mont_r2(&r2[0], &n[0]);
    try check_hex(&r2[0], &""[0: 512], 256);
}

test "bigint_modexp_e65537" {
    var base: [u64: BIGINT_LIMBS] = [];
    var n: [u64: BIGINT_LIMBS] = [];
    var out: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 512], 256, &base[0]);
    load_hex(&""[0: 512], 256, &n[0]);
    var e: [byte: 3] = [1, 0, 1];
    bigint_modexp_be(&out[0], &base[0], &e[0], 3, &n[0], 4902667234721611829u64);
    try check_hex(&out[0], &""[0: 512], 256);
}

test "bigint_modexp_2048bit_exponent" {
    var base: [u64: BIGINT_LIMBS] = [];
    var n: [u64: BIGINT_LIMBS] = [];
    var out: [u64: BIGINT_LIMBS] = [];
    var eb: [byte: 256] = [];
    load_hex(&""[0: 512], 256, &base[0]);
    load_hex(&""[0: 512], 256, &n[0]);
    hex_to_bytes(&""[0: 512], &eb[0], 256);
    bigint_modexp_be(&out[0], &base[0], &eb[0], 256, &n[0], 4902667234721611829u64);
    try check_hex(&out[0], &""[0: 512], 256);
}

test "bigint_modexp_exp_zero_is_one" {
    var base: [u64: BIGINT_LIMBS] = [];
    var n: [u64: BIGINT_LIMBS] = [];
    var out: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 512], 256, &base[0]);
    load_hex(&""[0: 512], 256, &n[0]);
    var e: [byte: 1] = [0];
    bigint_modexp_be(&out[0], &base[0], &e[0], 1, &n[0], 4902667234721611829u64);
    try assert_eq_i32(out[0] as i32, 1);
    var i: usize = 1;
    while i < BIGINT_LIMBS {
        try assert_eq_i32(out[i] as i32, 0);
        i = i + 1;
    }
}

test "bigint_add_sub_cmp_carry" {
    var a: [u64: BIGINT_LIMBS] = [];
    var b: [u64: BIGINT_LIMBS] = [];
    var r: [u64: BIGINT_LIMBS] = [];
    a[0] = 5u64;
    b[0] = 3u64;
    const c: u64 = bigint_add(&r[0], &a[0], &b[0], BIGINT_LIMBS);
    try assert_eq_i32(c as i32, 0);
    try assert_eq_i32(r[0] as i32, 8);
    bigint_sub(&r[0], &a[0], &b[0], BIGINT_LIMBS);
    try assert_eq_i32(r[0] as i32, 2);
    try assert_eq_i32(bigint_cmp(&a[0], &b[0], BIGINT_LIMBS), 1);
    try assert_eq_i32(bigint_cmp(&b[0], &a[0], BIGINT_LIMBS), 0 - 1);
    try assert_eq_i32(bigint_cmp(&a[0], &a[0], BIGINT_LIMBS), 0);
    var ones: [u64: BIGINT_LIMBS] = [];
    var one: [u64: BIGINT_LIMBS] = [];
    var i: usize = 0;
    while i < BIGINT_LIMBS {
        ones[i] = 0xffffffffffffffffu64;
        one[i] = 0u64;
        i = i + 1;
    }
    one[0] = 1u64;
    const c2: u64 = bigint_add(&r[0], &ones[0], &one[0], BIGINT_LIMBS);
    try assert_eq_i32(c2 as i32, 1);
    try assert_eq_i32(r[0] as i32, 0);
    try assert_eq_i32(r[63] as i32, 0);
    bigint_sub(&r[0], &ones[0], &ones[0], BIGINT_LIMBS);
    try assert_eq_i32(r[0] as i32, 0);
    try assert_eq_i32(r[63] as i32, 0);
}

test "bigint_be_roundtrip" {
    var l: [u64: BIGINT_LIMBS] = [];
    var l2: [u64: BIGINT_LIMBS] = [];
    var bytes: [byte: 512] = [];
    load_hex(&""[0: 512], 256, &l[0]);
    bigint_to_be(&bytes[0], &l[0], BIGINT_LIMBS);
    bigint_from_be(&l2[0], &bytes[0], 512, BIGINT_LIMBS);
    try assert_eq_i32(bigint_cmp(&l[0], &l2[0], BIGINT_LIMBS), 0);
}

test "bigint_mont_mul_4096_needs_conditional_subtract" {
    // 这组向量特意挑成 REDC 的中间结果 r >= n：**必须**做末尾的条件减才正确。
    // 2048 位模数配 64 limb 的 R 时 r 恒 < n（实测 200/200 未触发），所以只测 2048 位
    // 会让「条件减」整条路径零覆盖——把条件减删掉测试照样全绿。这组就是补这个缺口的。
    var a: [u64: BIGINT_LIMBS] = [];
    var b: [u64: BIGINT_LIMBS] = [];
    var n: [u64: BIGINT_LIMBS] = [];
    var r: [u64: BIGINT_LIMBS] = [];
    load_hex(&""[0: 1024], 512, &a[0]);
    load_hex(&""[0: 1024], 512, &b[0]);
    load_hex(&""[0: 1024], 512, &n[0]);
    bigint_mont_mul(&r[0], &a[0], &b[0], &n[0], 7642621046954339187u64);
    try check_hex(&r[0], &""[0: 1024], 512);
}
