test "ed25519_tampered_signature_rejected" {
    var sk: [byte: 32] = [
        157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244,
        146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25,
        112, 59, 172, 3, 28, 174, 127, 96,
    ];

    var msg: [byte: 3] = [97, 98, 99];
    var pk: [byte: 32] = [0: 32];
    ed25519_public_key(&pk[0], &sk[0]);
    var sig: [byte: 64] = [0: 64];
    ed25519_sign(&sig[0], &msg[0], 3, &sk[0], &pk[0]);
    // 先证明基线是绿的：正确签名必须通过
    try assert_eq_i32(if ed25519_verify(&sig[0], &msg[0], 3, &pk[0]) { 1 } else { 0 }, 1);
    var bad: [byte: 64] = [0: 64];
    var i: usize = 0;
    while i < 64 {
        bad[i] = sig[i];
        i = i + 1;
    }
    // 翻转 R 的一个字节 → 必须拒绝
    bad[0] = bad[0] ^ (1 as byte);
    try assert_eq_i32(if ed25519_verify(&bad[0], &msg[0], 3, &pk[0]) { 1 } else { 0 }, 0);
    // 翻转 S 的一个字节 → 必须拒绝
    i = 0;
    while i < 64 {
        bad[i] = sig[i];
        i = i + 1;
    }
    bad[40] = bad[40] ^ (1 as byte);
    try assert_eq_i32(if ed25519_verify(&bad[0], &msg[0], 3, &pk[0]) { 1 } else { 0 }, 0);
    // 换消息 → 必须拒绝
    var msg2: [byte: 3] = [97, 98, 100];
    try assert_eq_i32(if ed25519_verify(&sig[0], &msg2[0], 3, &pk[0]) { 1 } else { 0 }, 0);
    // 换公钥 → 必须拒绝
    var pk2: [byte: 32] = [0: 32];
    i = 0;
    while i < 32 {
        pk2[i] = pk[i];
        i = i + 1;
    }
    pk2[0] = pk2[0] ^ (1 as byte);
    try assert_eq_i32(if ed25519_verify(&sig[0], &msg[0], 3, &pk2[0]) { 1 } else { 0 }, 0);
}

test "ed25519_point_encode_decode_roundtrip" {
    var pk: [byte: 32] = [
        215, 90, 152, 1, 130, 177, 10, 183, 213, 75, 254, 211,
        201, 100, 7, 58, 14, 225, 114, 243, 218, 166, 35, 37,
        175, 2, 26, 104, 247, 7, 81, 26,
    ];

    var p: Ge = Ge{};
    try assert_eq_i32(if ge_unpack(&p, &pk[0]) { 1 } else { 0 }, 1);
    var back: [byte: 32] = [0: 32];
    ge_pack(&back[0], &p);
    try eq_bytes(&back[0], &pk[0], 32);
    // 基点自往返
    var b: Ge = Ge{};
    ge_base(&b);
    var enc: [byte: 32] = [0: 32];
    ge_pack(&enc[0], &b);
    var p2: Ge = Ge{};
    try assert_eq_i32(if ge_unpack(&p2, &enc[0]) { 1 } else { 0 }, 1);
}

test "ed25519_small_order_points_rejected" {
    // RFC 8032 §5.1.7：A 或 R 的阶整除 8 时必须拒绝。
    //
    // 为什么单独测：这 8 个小阶点的**编码完全合法**（都能解成曲线上的点），
    // 所以「解码成功」不等于「可用于验签」。少了这道检查，攻击者可以用
    // 全零编码（一个 4 阶点）当公钥构造出对任意消息都通过的伪造签名——
    // 而所有正常的 RFC 8032 向量测试**照样全绿**，因为它们用的是正常密钥。
    var pts: [byte: 32 * 9] = [
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x80,
        0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0xec,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0x7f,
        0xec,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0x26,0xe8,0x95,0x8f,0xc2,0xb2,0x27,0xb0,0x45,0xc3,0xf4,0x89,0xf2,0xef,0x98,0xf0,
        0xd5,0xdf,0xac,0x05,0xd3,0xc6,0x33,0x39,0xb1,0x38,0x02,0x88,0x6d,0x53,0xfc,0x05,
        0xc7,0x17,0x6a,0x70,0x3d,0x4d,0xd8,0x4f,0xba,0x3c,0x0b,0x76,0x0d,0x10,0x67,0x0f,
        0x2a,0x20,0x53,0xfa,0x2c,0x39,0xcc,0xc6,0x4e,0xc7,0xfd,0x77,0x92,0xac,0x03,0x7a,
        0x26,0xe8,0x95,0x8f,0xc2,0xb2,0x27,0xb0,0x45,0xc3,0xf4,0x89,0xf2,0xef,0x98,0xf0,
        0xd5,0xdf,0xac,0x05,0xd3,0xc6,0x33,0x39,0xb1,0x38,0x02,0x88,0x6d,0x53,0xfc,0x85,
        0xc7,0x17,0x6a,0x70,0x3d,0x4d,0xd8,0x4f,0xba,0x3c,0x0b,0x76,0x0d,0x10,0x67,0x0f,
        0x2a,0x20,0x53,0xfa,0x2c,0x39,0xcc,0xc6,0x4e,0xc7,0xfd,0x77,0x92,0xac,0x03,0xfa,
    ];
    var idx: usize = 0;
    while idx < 9 {
        var pk: [byte: 32] = [0: 32];
        var i: usize = 0;
        while i < 32 {
            pk[i] = pts[idx * 32 + i];
            i = i + 1;
        }
        var p: Ge = Ge{};
        if ge_unpack(&p, &pk[0]) {
            // 能解码 → 必须是「小阶」并被验签层拒绝
            try assert_eq_i32(if ge_is_small_order(&p) { 1 } else { 0 }, 1);
        }
        // 无论能否解码，用它当公钥都不许验签通过（任意签名、任意消息）
        var zero_sig: [byte: 64] = [0: 64];
        var msg: [byte: 3] = [97, 98, 99];
        try assert_eq_i32(if ed25519_verify(&zero_sig[0], &msg[0], 3, &pk[0]) { 1 } else { 0 }, 0);
        idx = idx + 1;
    }
}
