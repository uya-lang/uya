// test_crypto_ed25519.uya — Ed25519 签名/验签向量（RFC 8032 §7.1）
//
// 前三条是 RFC 8032 §7.1 的 TEST 1/2/3 原文向量（空/1 字节/2 字节消息），期望的
// pk 与 sig 与 RFC 完全一致；后两条是同构的长消息用例（1023/1024 字节），覆盖多块
// SHA-512 路径，期望值由独立的 Python 参考实现算出。
//
// 每条都做三件事：公钥推导、签名逐字节比对、验签通过；另加篡改必须失败的否定用例。
//
// 注意：这里的常量全部写成 **byte 数组**而不是 &"hex"[0:n] 字面量切片。原因是
// split-C 后端对「字面量切片经函数参数传递后再下标」会算出错位基址（实测取到
// 字符串里相邻的错字节），写成数组可以完全绕开；数组是正常数据对象，行为可靠。

use std.crypto.ed25519;
use std.crypto.ed25519.Ge;
use std.crypto.ed25519.ge_is_small_order;
use std.testing.assert_eq_i32;

/// 断言两段字节相等。
fn eq_bytes(a: &const byte, b: &const byte, n: usize) !void {
    var i: usize = 0;
    while i < n {
        try assert_eq_i32(a[i] as i32, b[i] as i32);
        i = i + 1;
    }
}

test "ed25519_empty" {
    // RFC 8032 §7.1 TEST 1（空消息）
    var sk: [byte: 32] = [
        157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244,
        146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25,
        112, 59, 172, 3, 28, 174, 127, 96,
    ];

    var pk_want: [byte: 32] = [
        215, 90, 152, 1, 130, 177, 10, 183, 213, 75, 254, 211,
        201, 100, 7, 58, 14, 225, 114, 243, 218, 166, 35, 37,
        175, 2, 26, 104, 247, 7, 81, 26,
    ];

    var sig_want: [byte: 64] = [
        229, 86, 67, 0, 195, 96, 172, 114, 144, 134, 226, 204,
        128, 110, 130, 138, 132, 135, 127, 30, 184, 229, 217, 116,
        216, 115, 224, 101, 34, 73, 1, 85, 95, 184, 130, 21,
        144, 163, 59, 172, 198, 30, 57, 112, 28, 249, 180, 107,
        210, 91, 245, 240, 89, 91, 190, 36, 101, 81, 65, 67,
        142, 122, 16, 11,
    ];

    var msg: [byte: 1] = [0];
    var pk: [byte: 32] = [0: 32];
    ed25519_public_key(&pk[0], &sk[0]);
    try eq_bytes(&pk[0], &pk_want[0], 32);
    var sig: [byte: 64] = [0: 64];
    ed25519_sign(&sig[0], &msg[0], 0, &sk[0], &pk[0]);
    try eq_bytes(&sig[0], &sig_want[0], 64);
    try assert_eq_i32(if ed25519_verify(&sig[0], &msg[0], 0, &pk[0]) { 1 } else { 0 }, 1);
}

test "ed25519_one_byte" {
    // RFC 8032 §7.1 TEST 2（1 字节 0x72）
    var sk: [byte: 32] = [
        76, 205, 8, 155, 40, 255, 150, 218, 157, 182, 195, 70,
        236, 17, 78, 15, 91, 138, 49, 159, 53, 171, 166, 36,
        218, 140, 246, 237, 79, 184, 166, 251,
    ];

    var pk_want: [byte: 32] = [
        61, 64, 23, 195, 232, 67, 137, 90, 146, 183, 10, 167,
        77, 27, 126, 188, 156, 152, 44, 207, 46, 196, 150, 140,
        192, 205, 85, 241, 42, 244, 102, 12,
    ];

    var sig_want: [byte: 64] = [
        146, 160, 9, 169, 240, 212, 202, 184, 114, 14, 130, 11,
        95, 100, 37, 64, 162, 178, 123, 84, 22, 80, 63, 143,
        179, 118, 34, 35, 235, 219, 105, 218, 8, 90, 193, 228,
        62, 21, 153, 110, 69, 143, 54, 19, 208, 241, 29, 140,
        56, 123, 46, 174, 180, 48, 42, 238, 176, 13, 41, 22,
        18, 187, 12, 0,
    ];

    var msg: [byte: 1] = [
        114,
    ];

    var pk: [byte: 32] = [0: 32];
    ed25519_public_key(&pk[0], &sk[0]);
    try eq_bytes(&pk[0], &pk_want[0], 32);
    var sig: [byte: 64] = [0: 64];
    ed25519_sign(&sig[0], &msg[0], 1, &sk[0], &pk[0]);
    try eq_bytes(&sig[0], &sig_want[0], 64);
    try assert_eq_i32(if ed25519_verify(&sig[0], &msg[0], 1, &pk[0]) { 1 } else { 0 }, 1);
}

