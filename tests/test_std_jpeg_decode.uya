// tests/test_std_jpeg_decode.uya — std.image.jpeg_decode：基线 JPEG 解码
//
// 夹具来历（**可复现**，见下面每条命令；cjpeg/djpeg 来自 libjpeg-turbo 2.1.5）：
//   ① FX_420  —— 16x16 高频棋盘（2x2 像素块交替两色），quality 75、baseline、
//      4:2:0、**带重启间隔**（-restart 1B，每 1 个 MCU 一个 RSTn）：
//        printf 'P6\n16 16\n255\n' > a.ppm  （再按同一生成式填像素）
//        cjpeg -quality 75 -baseline -dct int -sample 2x2 -restart 1B \
//              -outfile a_420_restart.jpg a.ppm
//   ② FX_GRAY —— 16x16 横向灰度渐变，quality 75、-grayscale
//   ③ FX_444  —— 16x16 彩色渐变（R 随 x、G 随 y、B 随 x+y），quality 75、1x1
//   ④ FX_PROG —— 同③ 但 -progressive（**只用来断言「明确拒绝」**）
//   期望值 REF_* 是 **djpeg -dct int -nosmooth -dither none** 解出来的 RGB，
//   折算成 4x4 块的通道均值（每个 16x16 图有 16 个块；灰度只取一个通道）。
//   为什么用块均值而不是逐像素：本实现的色度上采样是**块重复**（与 djpeg 的
//   -nosmooth 一致），逐像素会受 IDCT 舍入差影响；块均值能抓住「通道接反、
//   采样因子算错、色度平面串位」这类真实错误，同时对 ±1 的舍入不敏感。
//
// 覆盖点：4:2:0 + 重启间隔、灰度单通道、4:4:4、渐进式拒绝、非 JPEG 拒绝、
//   截断拒绝、jpeg_decode_info 只读文件头（含渐进式也能给出宽高）。
use std.image.image.Image;
use std.image.image.image_free;
use std.image.image.IMAGE_GRAY;
use std.image.image.IMAGE_RGB;
use std.mem.allocator.get_allocator;
use std.mem.allocator.MallocAllocator;
use std.testing.assert_eq_i32;
use std.testing.assert_true;
use std.image.jpeg_decode.jpeg_decode;
use std.image.jpeg_decode.jpeg_decode_info;
use std.image.jpeg_decode.JpegInfo;
use std.image.jpeg_decode.jpeg_info_blank;

// 把 !bool 收成 bool（失败 = false）。
fn ok_of(r: !bool) bool {
    return r catch { false; };
}

// 空图（image_free 前不得读写像素）。
fn blank_image() Image {
    var z: Image = Image{ width: 0, height: 0, channels: 0,
        pixels: null, allocator: null };
    return z;
}

// 对照块均值：img 的每个 4x4 块均值与 ref（每块 3 项 R,G,B）比，容差 tol。
fn blocks_match(img: &const Image, ref: &const i32, tol: i32) bool {
    const bw: i32 = (img.width + 3) / 4;
    var by: i32 = 0;
    while by < (img.height + 3) / 4 {
        var bx: i32 = 0;
        while bx < bw {
            var sr: i32 = 0;
            var sg: i32 = 0;
            var sb: i32 = 0;
            var n: i32 = 0;
            var y: i32 = by * 4;
            while y < by * 4 + 4 && y < img.height {
                var x: i32 = bx * 4;
                while x < bx * 4 + 4 && x < img.width {
                    const o: usize = (((y as usize) * (img.width as usize)
                        + (x as usize)) * 3 as usize);
                    sr = sr + (img.pixels[o] as i32);
                    sg = sg + (img.pixels[o + 1] as i32);
                    sb = sb + (img.pixels[o + 2] as i32);
                    n = n + 1;
                    x = x + 1;
                }
                y = y + 1;
            }
            const idx: usize = (((by * bw + bx) as usize) * 3 as usize);
            var er: i32 = sr / n - ref[idx];
            var eg: i32 = sg / n - ref[idx + 1];
            var eb: i32 = sb / n - ref[idx + 2];
            if er < 0 { er = 0 - er; }
            if eg < 0 { eg = 0 - eg; }
            if eb < 0 { eb = 0 - eb; }
            if er > tol || eg > tol || eb > tol {
                return false;
            }
            bx = bx + 1;
        }
        by = by + 1;
    }
    return true;
}

// 灰度图：每个 4x4 块均值与 ref（每块 1 项）比。
fn gray_blocks_match(img: &const Image, ref: &const i32, tol: i32) bool {
    var by: i32 = 0;
    while by < 4 {
        var bx: i32 = 0;
        while bx < 4 {
            var s: i32 = 0;
            var y: i32 = by * 4;
            while y < by * 4 + 4 {
                var x: i32 = bx * 4;
                while x < bx * 4 + 4 {
                    const o: usize = ((y as usize) * 16 as usize
                        + (x as usize));
                    s = s + (img.pixels[o] as i32);
                    x = x + 1;
                }
                y = y + 1;
            }
            const bi: i32 = by * 4 + bx;
            const bref: i32 = ref[bi as usize];
            var d: i32 = s / 16 - bref;
            if d < 0 { d = 0 - d; }
            if d > tol {
                return false;
            }
            bx = bx + 1;
        }
        by = by + 1;
    }
    return true;
}

test "jpeg_decode_420_with_restart" {
    const alc: MallocAllocator = get_allocator()[0];
    var im: Image = blank_image();
    _ = try jpeg_decode(&FX_420[0], FX_420_N, alc, &im);
    defer { image_free(&im); }
    try assert_eq_i32(im.width, 16);
    try assert_eq_i32(im.height, 16);
    try assert_eq_i32(im.channels, IMAGE_RGB);
    // 4:2:0 + 每 MCU 一个 RSTn：块均值容差 12（色度下采样的固有损失）
    try assert_true(blocks_match(&im, &REF_420[0], 12));
}

test "jpeg_decode_gray" {
    const alc: MallocAllocator = get_allocator()[0];
    var im: Image = blank_image();
    _ = try jpeg_decode(&FX_GRAY[0], FX_GRAY_N, alc, &im);
    defer { image_free(&im); }
    try assert_eq_i32(im.width, 16);
    try assert_eq_i32(im.height, 16);
    try assert_eq_i32(im.channels, IMAGE_GRAY);
    try assert_true(gray_blocks_match(&im, &REF_GRAY[0], 4));
}

test "jpeg_decode_444" {
    const alc: MallocAllocator = get_allocator()[0];
    var im: Image = blank_image();
    _ = try jpeg_decode(&FX_444[0], FX_444_N, alc, &im);
    defer { image_free(&im); }
    try assert_eq_i32(im.channels, IMAGE_RGB);
    // 4:4:4 无色度下采样：容差可以更紧
    try assert_true(blocks_match(&im, &REF_444[0], 6));
}

test "jpeg_decode_rejects_progressive" {
    const alc: MallocAllocator = get_allocator()[0];
    var im: Image = blank_image();
    try assert_true(!ok_of(jpeg_decode(&FX_PROG[0], FX_PROG_N, alc, &im)));
}

test "jpeg_decode_rejects_not_jpeg" {
    const alc: MallocAllocator = get_allocator()[0];
    var junk: [u8: 16] = [0: 16];
    junk[0] = 1u8;
    junk[1] = 2u8;
    var im: Image = blank_image();
    try assert_true(!ok_of(jpeg_decode(&junk[0], 16 as usize, alc, &im)));
}

test "jpeg_decode_rejects_truncated" {
    const alc: MallocAllocator = get_allocator()[0];
    // SOI + DQT 标记就没有下文了
    var t: [u8: 4] = [0xFFu8, 0xD8u8, 0xFFu8, 0xDBu8];
    var im: Image = blank_image();
    try assert_true(!ok_of(jpeg_decode(&t[0], 4 as usize, alc, &im)));
}

test "jpeg_decode_rejects_truncated_entropy" {
    const alc: MallocAllocator = get_allocator()[0];
    // 只给前半张 4:2:0 图：段头齐了但熵段被砍断 -> 必须报错，不产半张图
    var im: Image = blank_image();
    const half: usize = 400 as usize;
    try assert_true(!ok_of(jpeg_decode(&FX_420[0], half, alc, &im)));
}

test "jpeg_decode_info_reads_header" {
    var info: JpegInfo = jpeg_info_blank();
    _ = try jpeg_decode_info(&FX_420[0], FX_420_N, &info);
    try assert_eq_i32(info.width, 16);
    try assert_eq_i32(info.height, 16);
    try assert_eq_i32(info.ncomp, 3);
    try assert_true(!info.progressive);
}

test "jpeg_decode_info_gray_ncomp" {
    var info: JpegInfo = jpeg_info_blank();
    _ = try jpeg_decode_info(&FX_GRAY[0], FX_GRAY_N, &info);
    try assert_eq_i32(info.ncomp, 1);
    try assert_eq_i32(info.width, 16);
}

test "jpeg_decode_info_progressive_reports_size" {
    // 渐进式：解不了，但**宽高要能报出来**（「先问尺寸再决定收不收」靠它）
    var info: JpegInfo = jpeg_info_blank();
    _ = try jpeg_decode_info(&FX_PROG[0], FX_PROG_N, &info);
    try assert_true(info.progressive);
    try assert_eq_i32(info.width, 16);
    try assert_eq_i32(info.height, 16);
}

