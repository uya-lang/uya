use std.process;
use std.testing.assert_eq_u64;
use libc.strcmp;

error PipelineExpectedStageFailure;

struct PipelinePassStage : PipelineStage {
    marker: byte,

    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        _ = self;
        var buffer: [byte: 16] = [];
        while true {
            const count: usize = try input.read(&buffer[0:16]);
            if count == 0usize { return; }
            try output.write_all(&buffer[0:count]);
        }
    }
}

struct PipelineBorrowedStage : PipelineStage {
    borrowed: &i32,

    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        _ = self;
        _ = input;
        _ = output;
    }
}

struct PipelineConstantStage : PipelineStage {
    marker: byte,

    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        _ = self;
        _ = input;
        try output.write_all("uya-stage\n");
    }
}

struct PipelineFailingStage : PipelineStage {
    marker: byte,

    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        _ = self;
        _ = input;
        _ = output;
        return error.PipelineExpectedStageFailure;
    }
}

struct PipelineKeepLineStage : PipelineStage {
    marker: byte,

    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        _ = self;
        var line: [byte: 64] = [];
        while true {
            const count: usize = try input.read_line(&line[0:64]);
            if count == 0usize { return; }
            if line[0] == 107 as byte { try output.write_all(&line[0:count]); }
        }
    }
}

struct PipelineUpperLineStage : PipelineStage {
    marker: byte,

    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        _ = self;
        var line: [byte: 64] = [];
        while true {
            const count: usize = try input.read_line(&line[0:64]);
            if count == 0usize { return; }
            var i: usize = 0usize;
            while i < count {
                if line[i] >= 97 as byte && line[i] <= 122 as byte {
                    line[i] = line[i] - 32 as byte;
                }
                i = i + 1usize;
            }
            try output.write_all(&line[0:count]);
        }
    }
}

test "pipeline_capability_generation_registry" {
    try pipeline_capability_self_test();
}

test "pipeline_stage_count_empty_is_read_only" {
    const p: Pipeline = pipeline();
    const before: usize = try stage_count(&p);
    const after: usize = try stage_count(&p);
    try assert_eq_u64(before as u64, 0);
    try assert_eq_u64(after as u64, 0);
}

test "pipeline_stage_transformer_owns_erased_stage_in_plan" {
    const planned: Pipeline = try stage<PipelinePassStage>(pipeline(),
        PipelinePassStage { marker: 7 as byte });
    try assert_eq_u64((try stage_count(&planned)) as u64, 1);
    pipeline_drop(planned);
}

test "pipeline_stage_transformer_rejects_borrowed_fields" {
    var local_value: i32 = 7;
    const planned: !Pipeline = stage<PipelineBorrowedStage>(pipeline(),
        PipelineBorrowedStage { borrowed: &local_value });
    _ = planned catch {};
    try assert_eq_u64(planned.error_id as u64, @error_id(error.InvalidPipeline) as u64);
}

test "pipeline_stage_executes_in_pipeline_topology" {
    const planned: Pipeline = try stage<PipelineConstantStage>(pipeline(),
        PipelineConstantStage { marker: 1 as byte });
    const with_stdin: Pipeline = try stdin_file(planned, "/dev/null");
    const captured: Pipeline = try stdout_capture(with_stdin);
    var statuses: [PipelineStageStatus: 1] = [];
    var stdout_buf: [byte: 32] = [];
    var stderr_buf: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    pipeline_allow_next_fork_stage_for_test();
    try capture_into(captured, &statuses[0:1], &stdout_buf[0:32], &stderr_buf[0:1], &result);
    try assert_eq_u64(result.stdout.byte_count as u64, 10);
    try assert_eq_u64(statuses[0].kind as u64, PipelineStageStatusKind.completed as u64);
}

test "pipeline_fork_stage_is_not_enabled_by_default" {
    const planned: Pipeline = try stage<PipelineConstantStage>(pipeline(),
        PipelineConstantStage { marker: 1 as byte });
    const with_stdin: Pipeline = try stdin_file(planned, "/dev/null");
    const captured: Pipeline = try stdout_capture(with_stdin);
    var statuses: [PipelineStageStatus: 1] = [];
    var stdout_buf: [byte: 32] = [];
    var stderr_buf: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    const executed: !void = capture_into(captured, &statuses[0:1],
        &stdout_buf[0:32], &stderr_buf[0:1], &result);
    _ = executed catch {};
    try assert_eq_u64(executed.error_id as u64, @error_id(error.InvalidPipeline) as u64);
}

test "pipeline_stage_error_is_preserved_by_observing_sink" {
    const planned: Pipeline = try stage<PipelineFailingStage>(pipeline(),
        PipelineFailingStage { marker: 1 as byte });
    const executable: Pipeline = try stdin_file(planned, "/dev/null");
    var statuses: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    pipeline_allow_next_fork_stage_for_test();
    try status_into(executable, &statuses[0:1], &result);
    try assert_eq_u64(statuses[0].kind as u64, PipelineStageStatusKind.stage_failed as u64);
    try assert_eq_u64(statuses[0].stage_index as u64, 0);
    try assert_eq_u64(strcmp(statuses[0].error_name, "PipelineExpectedStageFailure") as u64, 0);
}

test "pipeline_checked_sink_returns_pipeline_stage_failed" {
    const planned: Pipeline = try stage<PipelineFailingStage>(pipeline(),
        PipelineFailingStage { marker: 1 as byte });
    const executable: Pipeline = try stdin_file(planned, "/dev/null");
    var statuses: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    pipeline_allow_next_fork_stage_for_test();
    const checked: !void = check_into(executable, &statuses[0:1], &result);
    _ = checked catch {};
    try assert_eq_u64(checked.error_id as u64, @error_id(error.PipelineStageFailed) as u64);
    try assert_eq_u64(statuses[0].kind as u64, PipelineStageStatusKind.stage_failed as u64);
    try assert_eq_u64(strcmp(statuses[0].error_name, "PipelineExpectedStageFailure") as u64, 0);
}

test "pipeline_line_filter_runs_between_external_commands" {
    const printf_args: [&const byte: 1] = ["keep\nskip\nkeep-two\n"];
    const wc_args: [&const byte: 1] = ["-l"];
    const producer: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/printf", &printf_args[0:1]);
    const filtered: Pipeline = try stage<PipelineKeepLineStage>(producer,
        PipelineKeepLineStage { marker: 1 as byte });
    const counted: Pipeline = try cmd_path_argv(filtered, "/usr/bin/wc", &wc_args[0:1]);
    const captured: Pipeline = try stdout_capture(counted);
    var statuses: [PipelineStageStatus: 3] = [];
    var stdout_buf: [byte: 16] = [];
    var stderr_buf: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    pipeline_allow_next_fork_stage_for_test();
    try capture_into(captured, &statuses[0:3], &stdout_buf[0:16], &stderr_buf[0:1], &result);
    try assert_eq_u64(strcmp(&stdout_buf[0], "2\n") as u64, 0);
    try assert_eq_u64(statuses[1].kind as u64, PipelineStageStatusKind.completed as u64);
    try assert_eq_u64(statuses[1].stage_index as u64, 1);
}

test "pipeline_line_map_streams_to_capture" {
    const printf_args: [&const byte: 1] = ["hello\nworld\n"];
    const producer: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/printf", &printf_args[0:1]);
    const mapped: Pipeline = try stage<PipelineUpperLineStage>(producer,
        PipelineUpperLineStage { marker: 1 as byte });
    const captured: Pipeline = try stdout_capture(mapped);
    var statuses: [PipelineStageStatus: 2] = [];
    var stdout_buf: [byte: 32] = [];
    var stderr_buf: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    pipeline_allow_next_fork_stage_for_test();
    try capture_into(captured, &statuses[0:2], &stdout_buf[0:32], &stderr_buf[0:1], &result);
    try assert_eq_u64(strcmp(&stdout_buf[0], "HELLO\nWORLD\n") as u64, 0);
}

test "pipeline_stage_streams_large_input_without_full_buffering" {
    const head_args: [&const byte: 3] = ["-c", "200000", "/dev/zero"];
    const wc_args: [&const byte: 1] = ["-c"];
    const producer: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/head", &head_args[0:3]);
    const passed: Pipeline = try stage<PipelinePassStage>(producer,
        PipelinePassStage { marker: 1 as byte });
    const counted: Pipeline = try cmd_path_argv(passed, "/usr/bin/wc", &wc_args[0:1]);
    const captured: Pipeline = try stdout_capture(counted);
    var statuses: [PipelineStageStatus: 3] = [];
    var stdout_buf: [byte: 32] = [];
    var stderr_buf: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    pipeline_allow_next_fork_stage_for_test();
    try capture_into(captured, &statuses[0:3], &stdout_buf[0:32], &stderr_buf[0:1], &result);
    try assert_eq_u64(strcmp(&stdout_buf[0], "200000\n") as u64, 0);
}

test "pipeline_clone_owns_an_independent_deep_copy" {
    const args: [&const byte: 1] = ["clone-ok"];
    const with_command: Pipeline = try cmd_path_argv(pipeline(), "/bin/echo", &args[0:1]);
    const with_cwd: Pipeline = try cwd(with_command, ".");
    const original: Pipeline = try stdout_capture(with_cwd);
    const copied: Pipeline = try clone(&original);
    try assert_eq_u64((try stage_count(&original)) as u64, 1);
    try assert_eq_u64((try stage_count(&copied)) as u64, 1);
    pipeline_drop(original);
    try assert_eq_u64((try stage_count(&copied)) as u64, 1);
    var statuses: [PipelineStageStatus: 1] = [];
    var stdout_buf: [byte: 32] = [];
    var stderr_buf: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(copied, &statuses[0:1], &stdout_buf[0:32], &stderr_buf[0:1], &result);
    try assert_eq_u64(result.stdout.byte_count as u64, 9);
}

