    ec_p384_field_add(&out[0], &a[0], &b[0]);
    if !bytes_eq(&out[0], &s_exp[0], 48) { return 1; }
    ec_p384_field_sub(&out[0], &a[0], &b[0]);
    if !bytes_eq(&out[0], &d_exp[0], 48) { return 2; }
    ec_p384_field_mul(&out[0], &a[0], &b[0]);
    if !bytes_eq(&out[0], &m_exp[0], 48) { return 3; }
    return 0;
}

export fn main() i32 {
    const r0: i32 = case_0();
    if r0 != 0 { return 10 +| 0 *| 10 +| r0; }
    const r1: i32 = case_1();
    if r1 != 0 { return 10 +| 1 *| 10 +| r1; }
    const r2: i32 = case_2();
    if r2 != 0 { return 10 +| 2 *| 10 +| r2; }
    const r3: i32 = case_3();
    if r3 != 0 { return 10 +| 3 *| 10 +| r3; }
    const r4: i32 = case_4();
    if r4 != 0 { return 10 +| 4 *| 10 +| r4; }
    const r5: i32 = case_5();
    if r5 != 0 { return 10 +| 5 *| 10 +| r5; }
    return 0;
}
