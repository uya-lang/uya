use std.runtime.entry;
use tls.crypto.ec_p384;

fn bytes_eq(a: &const byte, b: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < n {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

