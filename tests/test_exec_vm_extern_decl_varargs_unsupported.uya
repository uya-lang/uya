// exec 边界负例：只有 extern 声明、没有 body、也不在宿主桥登记表里的 varargs
// 函数必须继续稳定拒绝（原因码 extern_abi），避免"看起来能跑但语义不对"。
// fcntl 是 C varargs，且不在 exec 的 hostcall 表里；C99 后端可以正常链接运行。
extern "libc" fn fcntl(fd: i32, cmd: i32, ...) i32;

export fn main() i32 {
    const flags: i32 = fcntl(1, 3);
    if flags < 0 {
        return 1;
    }
    return 0;
}
