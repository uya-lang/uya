test "scheduler_run_task_queue_marks_cancelled_slots" {
    var s: Scheduler = scheduler_new();
    var queue: TaskQueue<i32> = task_queue_new<i32>();
    const cancelled_future: Future<!i32> = CancelAwareFuture{};
    const cancelled_idx: i32 = try queue.push(cancelled_future);
    const ready_idx: i32 = try queue.push(ready(55));
    _ = queue.cancel(cancelled_idx);
    const loop: EventLoop = test_event_loop();
    const completed: i32 = try scheduler_run_task_queue_with_event_loop<i32>(&s, loop, &queue, 0);

    try assert_eq_i32(completed, 2);
    try assert_eq_i32(queue.is_done(cancelled_idx) as i32, 1);
    try assert_eq_i32(queue.is_cancelled(cancelled_idx) as i32, 1);
    try assert_eq_i32(queue.error_id(cancelled_idx) as i32, @error_id(error.Cancelled) as i32);
    try assert_eq_i32(queue.is_done(ready_idx) as i32, 1);
    try assert_eq_i32(queue.result(ready_idx), 55);

    const metrics: SchedulerMetrics = scheduler_metrics(&s);
    try assert_eq_i32(metrics.cancel_result_count as i32, 1);
    try assert_eq_i32(metrics.wake_cancel_count as i32, 1);
}

test "scheduler_run_task_queue_cleans_registered_cancelled_slot_resources" {
    var s: Scheduler = scheduler_new();
    var queue: TaskQueue_usize = task_queue_usize_new();
    var epoll_impl: LinuxEpoll = try linux_epoll_create(0);
    defer {
        _ = scheduler_test_sys_close(epoll_impl.epfd) catch {};
    }

    var blocked_fds: [i32: 2] = [0 - 1: 2];
    defer {
        _ = scheduler_test_sys_close(blocked_fds[0]) catch {};
        _ = scheduler_test_sys_close(blocked_fds[1]) catch {};
    }
    _ = try scheduler_test_sys_pipe2(&blocked_fds[0], TEST_SCHEDULER_O_NONBLOCK);

    var reader: AsyncFd = async_fd_new(blocked_fds[0]);
    var buf: [byte: 4] = [];
    var saw_registered_io: i32 = 0;
    var saw_registered_event: i32 = 0;
    const blocked_idx: i32 = try queue.push(reader.read_exact(&buf[0], 4));
    const cancel_signal: Future<!usize> = CancelRegisteredQueueSlotFuture{
        queue: &queue,
        target_idx: blocked_idx,
        saw_registered_io: &saw_registered_io,
        saw_registered_event: &saw_registered_event,
        cancelled: 0,
    };
    const cancel_signal_idx: i32 = try queue.push(cancel_signal);

    const loop: EventLoop = epoll_impl;
    const completed: i32 = try scheduler_run_task_queue_usize_with_event_loop(&s, loop, &queue, 0);

    try assert_eq_i32(completed, 2);
    try assert_eq_i32(queue.is_done(blocked_idx) as i32, 1);
    try assert_eq_i32(queue.is_cancelled(blocked_idx) as i32, 1);
    try assert_eq_i32(queue.error_id(blocked_idx) as i32, @error_id(error.Cancelled) as i32);
    try assert_eq_i32(queue.result(cancel_signal_idx) as i32, 1);
    try assert_eq_i32(queue.error_id(cancel_signal_idx) as i32, 0);
    try assert_eq_i32(saw_registered_io, 1);
    try assert_eq_i32(saw_registered_event, 1);
    try assert_eq_i32(queue.slots[blocked_idx as usize].io_epoll_fd, 0 - 1);
    try assert_eq_i32(queue.slots[blocked_idx as usize].event_epoll_fd, 0 - 1);
    try assert_eq_i32(linux_epoll_registered_count(&epoll_impl), 0);

    const metrics: AsyncRuntimeMetrics = async_runtime_metrics_linux_epoll(&s, &epoll_impl);
    try assert_eq_i32(metrics.cancel_result_count as i32, 1);
    try assert_eq_i32(metrics.wake_cancel_count as i32, 1);
    try assert_eq_i32(metrics.epoll_registered_fd_count, 0);
}

test "scheduler_run_with_event_loop_handles_external_eventfd_wake" {
    const map_result: !*void = sys_mmap(null as *void, @size_of(i32), PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, 0 - 1, 0);
    const shared_raw: *void = try map_result;
    const shared_flag: &i32 = shared_raw as &i32;
    shared_flag[0] = 0;
    var s: Scheduler = scheduler_new();
    var epoll_impl: LinuxEpoll = try linux_epoll_create(0);
    defer {
        _ = sys_close(epoll_impl.epfd) catch {};
        _ = sys_munmap(shared_raw, @size_of(i32)) catch {};
    }
    const loop: EventLoop = epoll_impl;
    var future_impl: ExternalWakeThenReady = ExternalWakeThenReady{ shared_flag: shared_flag, child_pid: 0, started: 0 };
    const future: Future<!i32> = future_impl;
    const result: i32 = try scheduler_run_with_event_loop<i32>(&s, loop, future, 1000);
    future.release();

    try assert_eq_i32(result, 321);
    try assert_eq_i32(shared_flag[0], 1);
}

test "async_runtime_metrics_report_timeout_and_wake_sources" {
    scheduler_timeout_wake_poll_count = 0;
    scheduler_timeout_wake_registered_count = 0;
    scheduler_timeout_wake_registered_wakers[0] = 0usize;
    scheduler_timeout_wake_registered_wakers[1] = 0usize;
    scheduler_timeout_wake_registered_wakers[2] = 0usize;
    scheduler_timeout_wake_registered_wakers[3] = 0usize;
    scheduler_loop_poll_count = 0;
    scheduler_wake_poll_count = 0;

    var s: Scheduler = scheduler_new();
    const timeout_loop: EventLoop = TimeoutThenWakeEventLoop{};
    const timeout_future: Future<!i32> = TimeoutThenReadyFuture{ fd: 808, value: 66 };
    const timeout_result: i32 = try scheduler_run_with_event_loop<i32>(&s, timeout_loop, timeout_future, 5);
    try assert_eq_i32(timeout_result, 66);

    const inline_loop: EventLoop = test_event_loop();
    const inline_future: Future<!i32> = wake_then_ready_future();
    const inline_result: i32 = try scheduler_run_with_event_loop<i32>(&s, inline_loop, inline_future, 0);
    try assert_eq_i32(inline_result, 123);

    const metrics: AsyncRuntimeMetrics = async_runtime_metrics_linux_epoll_with_thread_pool(&s, null as &LinuxEpoll, null as &ThreadPool);
    try assert_eq_i32(metrics.timeout_wait_count as i32, 1);
    try assert_eq_i32(metrics.timeout_result_count as i32, 0);
    try assert_eq_i32(metrics.cancel_result_count as i32, 0);
    try assert_eq_i32(metrics.wake_inline_count as i32, 1);
    try assert_eq_i32(metrics.wake_event_loop_count as i32, 1);
    try assert_eq_i32(metrics.wake_cancel_count as i32, 0);
}

test "scheduler_run_with_event_loop_reregisters_same_fd_when_interest_changes" {
    scheduler_interest_switch_poll_count = 0;
    scheduler_interest_switch_waker_count = 0;
    scheduler_interest_switch_seen_count = 0;
    scheduler_interest_switch_seen[0] = 0;
    scheduler_interest_switch_seen[1] = 0;
    scheduler_interest_switch_seen[2] = 0;
    scheduler_interest_switch_seen[3] = 0;

    var s: Scheduler = scheduler_new();
    const loop: EventLoop = InterestSwitchEventLoop{};
    var future_impl: ReadableThenWritableFuture = ReadableThenWritableFuture{ fd: 555, stage: 0 };
    const future: Future<!i32> = future_impl;
    const result: i32 = try scheduler_run_with_event_loop<i32>(&s, loop, future, 0);

    try assert_eq_i32(result, 77);
    try assert_eq_i32(scheduler_interest_switch_poll_count, 2);
    try assert_eq_i32(scheduler_interest_switch_seen_count, 2);
    try assert_eq_i32(scheduler_interest_switch_seen[0], 1);
    try assert_eq_i32(scheduler_interest_switch_seen[1], 2);
}
