test "block_on_event_loop_uses_runtime_default_inline_repoll_limit" {
    scheduler_inline_pending_poll_count = 0;
    scheduler_loop_poll_count = 0;

    const loop: EventLoop = test_event_loop();
    const result: i32 = try block_on_with_event_loop<i32>(loop, InlinePendingThenReady{ ready_after_pending: 2 }, 0);
    const expected_limit: i32 = scheduler_expected_default_inline_repoll_limit();

    try assert_eq_i32(result, 88);
    try assert_eq_i32(scheduler_inline_pending_poll_count, 2);
    if expected_limit < 2 {
        try assert_eq_i32(scheduler_loop_poll_count, 1);
        return;
    }
    try assert_eq_i32(scheduler_loop_poll_count, 0);
}

