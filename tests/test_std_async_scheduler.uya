test "task_queue_with_capacity_limits_pushes" {
    var queue: TaskQueue_i32 = task_queue_i32_new_with_capacity(2);
    const first_idx: i32 = try queue.push(ready(1));
    const second_idx: i32 = try queue.push(ready(2));
    const third_result: !i32 = queue.push(ready(3));

    try assert_eq_i32(first_idx, 0);
    try assert_eq_i32(second_idx, 1);
    try assert_eq_i32(third_result.error_id as i32, @error_id(error.TaskQueueFull) as i32);
}

test "task_queue_capacity_can_exceed_default_capacity" {
    var default_queue: TaskQueue_i32 = task_queue_i32_new();
    try assert_eq_i32(task_queue_i32_capacity(&default_queue), TASK_QUEUE_I32_CAPACITY);

    var queue: TaskQueue_i32 = task_queue_i32_new_with_capacity(96);
    try assert_eq_i32(task_queue_i32_capacity(&queue), 96);
    var i: i32 = 0;
    while i < 96 {
        const idx: i32 = try queue.push(ready(i));
        try assert_eq_i32(idx, i);
        i = i + 1;
    }
}

test "task_queue_default_capacity_grows_past_64" {
    var queue: TaskQueue_i32 = task_queue_i32_new();
    var i: i32 = 0;
    while i < TASK_QUEUE_I32_CAPACITY + 1 {
        const idx: i32 = try queue.push(ready(i));
        try assert_eq_i32(idx, i);
        i = i + 1;
    }
    try assert_eq_i32(task_queue_i32_capacity(&queue) > TASK_QUEUE_I32_CAPACITY, true);
}

