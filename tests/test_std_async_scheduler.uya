// test_std_async_scheduler.uya - 测试 std.async_scheduler.Scheduler

use std.async;
use std.async_event;
use std.async_frame.AsyncFramePool;
use std.async_frame.async_frame_pool_alloc_aligned;
use std.async_frame.async_frame_pool_free_aligned;
use std.async_scheduler;
use std.thread;
use std.testing.assert_eq_i32;
use libc.atoi;
use libc.getenv;
use libc.syscall;

const TEST_SCHEDULER_O_NONBLOCK: i32 = 0x800;

fn scheduler_test_sys_pipe2(pipefd: &i32, flags: i32) !i32 {
    return @syscall(SYS_pipe2, pipefd as i64, flags as i64) as! i32;
}

fn scheduler_test_sys_close(fd: i32) !i32 {
    return @syscall(SYS_close, fd as i64) as! i32;
}

fn ready(v: i32) Future<!i32> {
    const p: Poll<!i32> = Poll<!i32>.Ready(ok<i32>(v));
    return Future<!i32>{ state: p };
}

fn ready_u32(v: u32) Future<!u32> {
    const p: Poll<!u32> = Poll<!u32>.Ready(ok<u32>(v));
    return Future<!u32>{ state: p };
}

fn delayed_metric_add_one_i32(v: i32) i32 {
    const req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 50 * 1000 * 1000 };
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&req, &rem) catch {};
    return v + 1;
}

fn scheduler_metrics_sleep_wait_poll() void {
    const req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 1 * 1000 * 1000 };
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&req, &rem) catch {};
}

fn wait_thread_pool_pending_at_least(pool: &ThreadPool, target: i32) i32 {
    var i: i32 = 0;
    while i < 2000 {
        if thread_pool_pending_count(pool) >= target {
            return 1;
        }
        scheduler_metrics_sleep_wait_poll();
        i = i + 1;
    }
    return 0;
}

fn wait_thread_pool_running_workers_at_least(pool: &ThreadPool, target: i32) i32 {
    var i: i32 = 0;
    while i < 2000 {
        if thread_pool_metrics(pool).running_workers >= target {
            return 1;
        }
        scheduler_metrics_sleep_wait_poll();
        i = i + 1;
    }
    return 0;
}

struct SchedulerFutureHolder {
    future: Future<!i32>,
}

struct ImmediateReadyFuture : Future<!i32> {
    value: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = waker;
        return Poll<!i32>.Ready(ok<i32>(self.value));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

fn immediate_ready_future(v: i32) Future<!i32> {
    return ImmediateReadyFuture{ value: v };
}

fn scheduler_expected_default_frame_buffer_size() usize {
    const env: &byte = getenv("UYA_SCHEDULER_FRAME_BUFFER_BYTES");
    if env != null && env[0] != 0 as byte {
        const parsed: i32 = atoi(env as &const byte);
        if parsed > 0 {
            return parsed as usize;
        }
    }
    return 8192usize;
}

fn scheduler_expected_default_inline_repoll_limit() i32 {
    const env: &byte = getenv("UYA_SCHEDULER_INLINE_REPOLL_LIMIT");
    if env != null && env[0] != 0 as byte {
        const first: byte = env[0];
        if first == 43 as byte || first == 45 as byte || (first >= 48 as byte && first <= 57 as byte) {
            const parsed: i32 = atoi(env as &const byte);
            if parsed < 0 {
                return 0;
            }
            return parsed;
        }
    }
    return 1024;
}

@async_fn
fn add_async() Future<!i32> {
    const a: i32 = try @await ready(10);
    const b: i32 = try @await ready(20);
    return a + b;
}

test "scheduler_run" {
    var s: Scheduler = scheduler_new();
    const result: i32 = try scheduler_run<i32>(&s, add_async());
    try assert_eq_i32(result, 30);
}

test "scheduler_new_uses_stack_backed_frame_pool" {
    var s: Scheduler = scheduler_new();
    const pool: &AsyncFramePool = scheduler_frame_pool(&s);
    try assert_eq_i32(pool.buffer != null, true);
    try assert_eq_i32(pool.buffer_size > 0usize, true);
    try assert_eq_i32(pool.stack_limit > 0usize, true);
    try assert_eq_i32(scheduler_frame_buffer_size(&s) > 0usize, true);
}

test "scheduler_new_uses_runtime_default_frame_buffer_size" {
    var s: Scheduler = scheduler_new();
    const expected: usize = scheduler_expected_default_frame_buffer_size();
    const pool: &AsyncFramePool = scheduler_frame_pool(&s);
    try assert_eq_i32(pool.buffer_size == expected, true);
    try assert_eq_i32(scheduler_frame_buffer_size(&s) == expected, true);
}

test "scheduler_new_uses_runtime_default_inline_repoll_limit" {
    var s: Scheduler = scheduler_new();
    const expected: i32 = scheduler_expected_default_inline_repoll_limit();
    try assert_eq_i32(scheduler_inline_repoll_limit(&s), expected);
}

test "scheduler_new_with_config_sets_frame_buffer_and_inline_repoll" {
    var s: Scheduler = scheduler_new_with_config(16384usize, 3);
    const pool: &AsyncFramePool = scheduler_frame_pool(&s);
    try assert_eq_i32(pool.buffer != null, true);
    try assert_eq_i32(pool.buffer_size == 16384usize, true);
    try assert_eq_i32(scheduler_frame_buffer_size(&s) == 16384usize, true);
    try assert_eq_i32(scheduler_inline_repoll_limit(&s), 3);
}

test "scheduler_new_with_config_accepts_frame_buffer_above_default" {
    var s: Scheduler = scheduler_new_with_config(24576usize, 3);
    const pool: &AsyncFramePool = scheduler_frame_pool(&s);
    try assert_eq_i32(pool.buffer != null, true);
    try assert_eq_i32(pool.buffer_size == 24576usize, true);
    try assert_eq_i32(scheduler_frame_buffer_size(&s) == 24576usize, true);
}

test "scheduler_metrics_report_frame_alloc_and_free" {
    var s: Scheduler = scheduler_new_with_config(256usize, 3);
    const pool: &AsyncFramePool = scheduler_frame_pool(&s);
    const initial_metrics: SchedulerMetrics = scheduler_metrics(&s);
    try assert_eq_i32(initial_metrics.frame_alloc_count as i32, 0);
    try assert_eq_i32(initial_metrics.frame_free_count as i32, 0);
    try assert_eq_i32(initial_metrics.frame_full_count as i32, 0);
    try assert_eq_i32(initial_metrics.frame_heap_fallback_count as i32, 0);

    const ptr: &byte = async_frame_pool_alloc_aligned(pool, 32usize, 8usize);
    try assert_eq_i32(ptr != null, true);
    const after_alloc: SchedulerMetrics = scheduler_metrics(&s);
    try assert_eq_i32(after_alloc.frame_alloc_count as i32, 1);
    try assert_eq_i32(after_alloc.frame_free_count as i32, 0);
    try assert_eq_i32(after_alloc.frame_full_count as i32, 0);
    try assert_eq_i32(after_alloc.frame_heap_fallback_count as i32, 0);

    async_frame_pool_free_aligned(pool, ptr, 32usize, 8usize);
    const after_free: SchedulerMetrics = scheduler_metrics(&s);
    try assert_eq_i32(after_free.frame_alloc_count as i32, 1);
    try assert_eq_i32(after_free.frame_free_count as i32, 1);
    try assert_eq_i32(after_free.frame_full_count as i32, 0);
    try assert_eq_i32(after_free.frame_heap_fallback_count as i32, 0);
}

test "scheduler_metrics_report_frame_full_and_fallback" {
    var s: Scheduler = scheduler_new_with_config(256usize, 3);
    const pool: &AsyncFramePool = scheduler_frame_pool(&s);

    pool.max_buckets = 0;
    pool.debug_heap_fallback = 0;
    const full_ptr: &byte = async_frame_pool_alloc_aligned(pool, 16usize, 8usize);
    try assert_eq_i32(full_ptr == null, true);
    const after_full: SchedulerMetrics = scheduler_metrics(&s);
    try assert_eq_i32(after_full.frame_alloc_count as i32, 0);
    try assert_eq_i32(after_full.frame_free_count as i32, 0);
    try assert_eq_i32(after_full.frame_full_count as i32, 1);
    try assert_eq_i32(after_full.frame_heap_fallback_count as i32, 0);

    pool.debug_heap_fallback = 1;
    pool.stack_limit = 1usize;
    const fallback_ptr: &byte = async_frame_pool_alloc_aligned(pool, 16usize, 8usize);
    try assert_eq_i32(fallback_ptr != null, true);
    const after_fallback: SchedulerMetrics = scheduler_metrics(&s);
    try assert_eq_i32(after_fallback.frame_alloc_count as i32, 0);
    try assert_eq_i32(after_fallback.frame_free_count as i32, 0);
    try assert_eq_i32(after_fallback.frame_full_count as i32, 1);
    try assert_eq_i32(after_fallback.frame_heap_fallback_count as i32, 1);
    async_frame_pool_free_aligned(pool, fallback_ptr, 16usize, 8usize);
}

test "async_runtime_metrics_linux_epoll_report_registered_fd_and_resize_count" {
    var s: Scheduler = scheduler_new();
    var ep: LinuxEpoll = try linux_epoll_create_config(0, 2, 1);
    defer {
        _ = scheduler_test_sys_close(ep.epfd) catch {};
    }

    var fds1: [i32: 2] = [0 - 1: 2];
    var fds2: [i32: 2] = [0 - 1: 2];
    var fds3: [i32: 2] = [0 - 1: 2];
    defer {
        _ = scheduler_test_sys_close(fds1[0]) catch {};
        _ = scheduler_test_sys_close(fds1[1]) catch {};
        _ = scheduler_test_sys_close(fds2[0]) catch {};
        _ = scheduler_test_sys_close(fds2[1]) catch {};
        _ = scheduler_test_sys_close(fds3[0]) catch {};
        _ = scheduler_test_sys_close(fds3[1]) catch {};
    }

    _ = try scheduler_test_sys_pipe2(&fds1[0], TEST_SCHEDULER_O_NONBLOCK);
    _ = try scheduler_test_sys_pipe2(&fds2[0], TEST_SCHEDULER_O_NONBLOCK);
    _ = try scheduler_test_sys_pipe2(&fds3[0], TEST_SCHEDULER_O_NONBLOCK);

    var w1: Waker = Waker{};
    var w2: Waker = Waker{};
    var w3: Waker = Waker{};
    _ = try ep.register(fds1[0], EventKind.Readable({}), &w1);
    _ = try ep.register(fds2[0], EventKind.Readable({}), &w2);
    _ = try ep.register(fds3[0], EventKind.Readable({}), &w3);

    const metrics: AsyncRuntimeMetrics = async_runtime_metrics_linux_epoll(&s, &ep);
    try assert_eq_i32(metrics.frame_alloc_count as i32, 0);
    try assert_eq_i32(metrics.queue_depth, 0);
    try assert_eq_i32(metrics.epoll_registered_fd_count, 3);
    try assert_eq_i32(metrics.epoll_peak_registered_fd_count >= 3, true);
    try assert_eq_i32(metrics.epoll_resize_count >= 1, true);

    _ = ep.deregister(fds1[0]) catch {};
    _ = ep.deregister(fds2[0]) catch {};
    _ = ep.deregister(fds3[0]) catch {};

    const after_deregister: AsyncRuntimeMetrics = async_runtime_metrics_linux_epoll(&s, &ep);
    try assert_eq_i32(after_deregister.epoll_registered_fd_count, 0);
    try assert_eq_i32(after_deregister.epoll_peak_registered_fd_count >= 3, true);
    try assert_eq_i32(after_deregister.epoll_resize_count, metrics.epoll_resize_count);
}

test "async_runtime_metrics_linux_epoll_with_thread_pool_report_queue_depth_running_workers_and_saturation" {
    var s: Scheduler = scheduler_new();
    var ep: LinuxEpoll = try linux_epoll_create_config(0, 2, 1);
    var pool: ThreadPool = thread_pool_new_with_config(ThreadPoolConfig{
        worker_count: 1,
        pending_capacity: THREAD_POOL_MAX_PENDING + 4,
        task_slot_capacity: THREAD_POOL_MAX_PENDING + 4,
        submit_strategy: THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR,
    });
    defer {
        thread_pool_shutdown(&pool);
        _ = scheduler_test_sys_close(ep.epfd) catch {};
    }

    var first: Future<!i32> = async_compute<i32>(&pool, &delayed_metric_add_one_i32 as &void, 0);
    var second: Future<!i32> = async_compute<i32>(&pool, &delayed_metric_add_one_i32 as &void, 1);
    var first_waker: Waker = Waker{};
    var second_waker: Waker = Waker{};

    _ = first.poll(&first_waker);
    _ = second.poll(&second_waker);
    _ = first.poll(&first_waker);
    _ = second.poll(&second_waker);

    try assert_eq_i32(wait_thread_pool_pending_at_least(&pool, 1), 1);
    try assert_eq_i32(wait_thread_pool_running_workers_at_least(&pool, 1), 1);

    const metrics: AsyncRuntimeMetrics = async_runtime_metrics_linux_epoll_with_thread_pool(&s, &ep, &pool);
    try assert_eq_i32(metrics.thread_pool_queue_depth >= 1, true);
    try assert_eq_i32(metrics.thread_pool_running_workers, 1);
    try assert_eq_i32(metrics.thread_pool_saturation_count >= 1u64, true);

    try assert_eq_i32(try scheduler_run_i32(&s, first), 1);
    try assert_eq_i32(try scheduler_run_i32(&s, second), 2);

    const final_metrics: AsyncRuntimeMetrics = async_runtime_metrics_linux_epoll_with_thread_pool(&s, &ep, &pool);
    try assert_eq_i32(final_metrics.thread_pool_queue_depth, 0);
    try assert_eq_i32(final_metrics.thread_pool_running_workers, 0);
    try assert_eq_i32(final_metrics.thread_pool_saturation_count >= metrics.thread_pool_saturation_count, true);
}

test "scheduler_run_u32" {
    var s: Scheduler = scheduler_new();
    const result: u32 = try scheduler_run<u32>(&s, ready_u32(12 as u32));
    try assert_eq_i32(result as i32, 12);
}

test "interface_field_method_call_after_array_access" {
    var holders: [SchedulerFutureHolder: 1] = [
        SchedulerFutureHolder{ future: immediate_ready_future(77) },
    ];
    const w: Waker = Waker{};
    const p: Poll<!i32> = holders[0].future.poll(&w);
    var result: i32 = 0 - 3;
    match p {
        .Ready(v) => { result = v catch { 0 - 1; }; },
        .Pending(_) => { result = 0 - 2; },
    };
    try assert_eq_i32(result, 77);
}

var scheduler_loop_poll_count: i32 = 0;
var scheduler_wake_poll_count: i32 = 0;
var scheduler_pair_loop_poll_count: i32 = 0;
var scheduler_pair_register_count: i32 = 0;
var scheduler_pair_task_poll_count_a: i32 = 0;
var scheduler_pair_task_poll_count_b: i32 = 0;
var scheduler_pair_registered_wakers: [usize: 8] = [];
var scheduler_pair_registered_count: i32 = 0;
var scheduler_queue_loop_poll_count: i32 = 0;
var scheduler_queue_register_count: i32 = 0;
var scheduler_queue_task_poll_counts: [i32: 3] = [];
var scheduler_queue_registered_wakers: [usize: 8] = [];
var scheduler_queue_registered_count: i32 = 0;
var scheduler_metrics_queue_depth_seen: [i32: 2] = [];
var scheduler_metrics_peak_queue_depth_seen: [i32: 2] = [];
var scheduler_interest_switch_poll_count: i32 = 0;
var scheduler_interest_switch_waker_count: i32 = 0;
var scheduler_interest_switch_seen_count: i32 = 0;
var scheduler_interest_switch_seen: [i32: 4] = [];
var scheduler_inline_pending_poll_count: i32 = 0;
var scheduler_timeout_wake_poll_count: i32 = 0;
var scheduler_timeout_wake_registered_wakers: [usize: 4] = [];
var scheduler_timeout_wake_registered_count: i32 = 0;

struct TestEventLoop : EventLoop {
    fn register(self: &Self, fd: i32, interest: EventKind, waker: &Waker) !i32 {
        _ = self;
        _ = fd;
        _ = interest;
        _ = waker;
        return 0;
    }

    fn deregister(self: &Self, fd: i32) !i32 {
        _ = self;
        _ = fd;
        return 0;
    }

    fn poll(self: &Self, timeout_ms: i32) !i32 {
        _ = self;
        scheduler_loop_poll_count = scheduler_loop_poll_count + 1;
        return timeout_ms;
    }
}

struct ReadyAfterEventLoopPoll : Future<!i32> {
    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = self;
        _ = waker;
        if scheduler_loop_poll_count == 0 {
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(99));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct WakeThenReadyWithoutEventLoopPoll : Future<!i32> {
    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = self;
        if scheduler_wake_poll_count == 0 {
            scheduler_wake_poll_count = scheduler_wake_poll_count + 1;
            waker.wake();
            return Poll<!i32>.Pending({});
        }
        scheduler_wake_poll_count = scheduler_wake_poll_count + 1;
        return Poll<!i32>.Ready(ok<i32>(123));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

fn test_event_loop() EventLoop {
    return TestEventLoop{};
}

fn pending_then_ready_future() Future<!i32> {
    return ReadyAfterEventLoopPoll{};
}

fn wake_then_ready_future() Future<!i32> {
    return WakeThenReadyWithoutEventLoopPoll{};
}

struct PairEventLoop : EventLoop {
    fn register(self: &Self, fd: i32, interest: EventKind, waker: &Waker) !i32 {
        _ = self;
        _ = fd;
        _ = interest;
        scheduler_pair_register_count = scheduler_pair_register_count + 1;
        scheduler_pair_registered_wakers[scheduler_pair_registered_count as usize] = (waker as &void) as usize;
        scheduler_pair_registered_count = scheduler_pair_registered_count + 1;
        return 0;
    }

    fn deregister(self: &Self, fd: i32) !i32 {
        _ = self;
        _ = fd;
        return 0;
    }

    fn poll(self: &Self, timeout_ms: i32) !i32 {
        _ = self;
        _ = timeout_ms;
        scheduler_pair_loop_poll_count = scheduler_pair_loop_poll_count + 1;
        var i: i32 = 0;
        while i < scheduler_pair_registered_count {
            const w: &Waker = (scheduler_pair_registered_wakers[i as usize] as &void) as &Waker;
            w.wake();
            i = i + 1;
        }
        const woke_count: i32 = scheduler_pair_registered_count;
        scheduler_pair_registered_count = 0;
        return woke_count;
    }
}

struct PendingOnReadableThenReady : Future<!i32> {
    fd: i32,
    value: i32,
    task_id: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        if self.task_id == 0 {
            scheduler_pair_task_poll_count_a = scheduler_pair_task_poll_count_a + 1;
        } else {
            scheduler_pair_task_poll_count_b = scheduler_pair_task_poll_count_b + 1;
        }

        if scheduler_pair_loop_poll_count == 0 {
            waker.wait_readable(self.fd);
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(self.value));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

fn pair_event_loop() EventLoop {
    return PairEventLoop{};
}

fn pending_on_readable_then_ready(fd: i32, value: i32, task_id: i32) Future<!i32> {
    return PendingOnReadableThenReady{ fd: fd, value: value, task_id: task_id };
}

struct QueueEventLoop : EventLoop {
    fn register(self: &Self, fd: i32, interest: EventKind, waker: &Waker) !i32 {
        _ = self;
        _ = fd;
        _ = interest;
        scheduler_queue_register_count = scheduler_queue_register_count + 1;
        scheduler_queue_registered_wakers[scheduler_queue_registered_count as usize] = (waker as &void) as usize;
        scheduler_queue_registered_count = scheduler_queue_registered_count + 1;
        return 0;
    }

    fn deregister(self: &Self, fd: i32) !i32 {
        _ = self;
        _ = fd;
        return 0;
    }

    fn poll(self: &Self, timeout_ms: i32) !i32 {
        _ = self;
        _ = timeout_ms;
        scheduler_queue_loop_poll_count = scheduler_queue_loop_poll_count + 1;
        var i: i32 = 0;
        while i < scheduler_queue_registered_count {
            const w: &Waker = (scheduler_queue_registered_wakers[i as usize] as &void) as &Waker;
            w.wake();
            i = i + 1;
        }
        const woke_count: i32 = scheduler_queue_registered_count;
        scheduler_queue_registered_count = 0;
        return woke_count;
    }
}

struct QueuePendingOnReadableThenReady : Future<!i32> {
    fd: i32,
    value: i32,
    task_id: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        scheduler_queue_task_poll_counts[self.task_id as usize] = scheduler_queue_task_poll_counts[self.task_id as usize] + 1;
        if scheduler_queue_loop_poll_count == 0 {
            waker.wait_readable(self.fd);
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(self.value));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct QueuePendingOnReadableThenReadyU32 : Future<!u32> {
    fd: i32,
    value: u32,
    task_id: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!u32> {
        scheduler_queue_task_poll_counts[self.task_id as usize] = scheduler_queue_task_poll_counts[self.task_id as usize] + 1;
        if scheduler_queue_loop_poll_count == 0 {
            waker.wait_readable(self.fd);
            return Poll<!u32>.Pending({});
        }
        return Poll<!u32>.Ready(ok<u32>(self.value));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct QueueDepthMetricsRecorderFuture : Future<!i32> {
    scheduler: &Scheduler,
    slot: i32,
    value: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = waker;
        const metrics: SchedulerMetrics = scheduler_metrics(self.scheduler);
        scheduler_metrics_queue_depth_seen[self.slot as usize] = metrics.queue_depth;
        scheduler_metrics_peak_queue_depth_seen[self.slot as usize] = metrics.peak_queue_depth;
        return Poll<!i32>.Ready(ok<i32>(self.value));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct QueueInlinePendingThenReadable : Future<!i32> {
    fd: i32,
    stage: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        scheduler_queue_task_poll_counts[0] = scheduler_queue_task_poll_counts[0] + 1;
        if self.stage == 0 {
            self.stage = 1;
            return Poll<!i32>.Pending({});
        }
        if scheduler_queue_loop_poll_count == 0 {
            waker.wait_readable(self.fd);
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(41));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct CancelAwareFuture : Future<!i32> {
    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = self;
        if waker.is_cancelled() {
            return Poll<!i32>.Ready(error.Cancelled);
        }
        return Poll<!i32>.Pending({});
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct CancelRegisteredQueueSlotFuture : Future<!usize> {
    queue: &TaskQueue_usize,
    target_idx: i32,
    saw_registered_io: &i32,
    saw_registered_event: &i32,
    cancelled: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        if self.cancelled == 0 {
            const slot: &TaskQueueSlot_usize = &self.queue.slots[self.target_idx as usize];
            if slot.io_epoll_fd < 0 || slot.event_epoll_fd < 0 {
                waker.wake();
                return Poll<!usize>.Pending({});
            }
            self.saw_registered_io[0] = 1;
            self.saw_registered_event[0] = 1;
            _ = self.queue.cancel(self.target_idx);
            self.cancelled = 1;
        }
        return Poll<!usize>.Ready(ok<usize>(1usize));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct ExternalWakeThenReady : Future<!i32> {
    shared_flag: &i32,
    child_pid: i32,
    started: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        if self.shared_flag != null && self.shared_flag[0] != 0 {
            return Poll<!i32>.Ready(ok<i32>(321));
        }
        if self.started == 0 {
            self.started = 1;
            const fork_result: !i64 = sys_fork();
            const child_pid: i64 = fork_result catch {
                return Poll<!i32>.Ready(fork_result as! i32);
            };
            if child_pid == 0 {
                const req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 5 * 1000 * 1000 };
                var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
                _ = sys_nanosleep(&req, &rem) catch {};
                if self.shared_flag != null {
                    self.shared_flag[0] = 1;
                }
                waker.wake();
                sys_exit(0);
            }
            self.child_pid = child_pid as i32;
        }
        return Poll<!i32>.Pending({});
    }

    fn release(self: &Self) void {
        if self.child_pid > 0 {
            var status: i32 = 0;
            _ = sys_waitpid(self.child_pid, &status, 0) catch {};
            self.child_pid = 0;
        }
    }
}

struct InterestSwitchEventLoop : EventLoop {
    fn register(self: &Self, fd: i32, interest: EventKind, waker: &Waker) !i32 {
        _ = self;
        if fd == 555 && scheduler_interest_switch_seen_count < 4 {
            match interest {
                .Readable(_) => {
                    scheduler_interest_switch_seen[scheduler_interest_switch_seen_count as usize] = 1;
                    scheduler_interest_switch_seen_count = scheduler_interest_switch_seen_count + 1;
                },
                .Writable(_) => {
                    scheduler_interest_switch_seen[scheduler_interest_switch_seen_count as usize] = 2;
                    scheduler_interest_switch_seen_count = scheduler_interest_switch_seen_count + 1;
                },
                .ReadWrite(_) => {
                    scheduler_interest_switch_seen[scheduler_interest_switch_seen_count as usize] = 3;
                    scheduler_interest_switch_seen_count = scheduler_interest_switch_seen_count + 1;
                },
            };
        }
        scheduler_interest_switch_waker_count = scheduler_interest_switch_waker_count + 1;
        scheduler_pair_registered_wakers[(scheduler_interest_switch_waker_count - 1) as usize] = (waker as &void) as usize;
        return 0;
    }

    fn deregister(self: &Self, fd: i32) !i32 {
        _ = self;
        _ = fd;
        return 0;
    }

    fn poll(self: &Self, timeout_ms: i32) !i32 {
        _ = self;
        _ = timeout_ms;
        scheduler_interest_switch_poll_count = scheduler_interest_switch_poll_count + 1;
        var i: i32 = 0;
        while i < scheduler_interest_switch_waker_count {
            const w: &Waker = (scheduler_pair_registered_wakers[i as usize] as &void) as &Waker;
            w.wake();
            i = i + 1;
        }
        scheduler_interest_switch_waker_count = 0;
        return 1;
    }
}

struct TimeoutThenWakeEventLoop : EventLoop {
    fn register(self: &Self, fd: i32, interest: EventKind, waker: &Waker) !i32 {
        _ = self;
        _ = fd;
        _ = interest;
        scheduler_timeout_wake_registered_wakers[scheduler_timeout_wake_registered_count as usize] = (waker as &void) as usize;
        scheduler_timeout_wake_registered_count = scheduler_timeout_wake_registered_count + 1;
        return 0;
    }

    fn deregister(self: &Self, fd: i32) !i32 {
        _ = self;
        _ = fd;
        return 0;
    }

    fn poll(self: &Self, timeout_ms: i32) !i32 {
        _ = self;
        _ = timeout_ms;
        scheduler_timeout_wake_poll_count = scheduler_timeout_wake_poll_count + 1;
        if scheduler_timeout_wake_poll_count == 1 {
            return 0;
        }
        var i: i32 = 0;
        while i < scheduler_timeout_wake_registered_count {
            const w: &Waker = (scheduler_timeout_wake_registered_wakers[i as usize] as &void) as &Waker;
            w.wake_from_event_loop();
            i = i + 1;
        }
        const woke_count: i32 = scheduler_timeout_wake_registered_count;
        scheduler_timeout_wake_registered_count = 0;
        return woke_count;
    }
}

struct TimeoutThenReadyFuture : Future<!i32> {
    fd: i32,
    value: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        if scheduler_timeout_wake_poll_count < 2 {
            waker.wait_readable(self.fd);
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(self.value));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct ReadableThenWritableFuture : Future<!i32> {
    fd: i32,
    stage: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        if self.stage == 0 {
            self.stage = 1;
            waker.wait_readable(self.fd);
            return Poll<!i32>.Pending({});
        }
        if self.stage == 1 {
            self.stage = 2;
            waker.wait_writable(self.fd);
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(77));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

struct InlinePendingThenReady : Future<!i32> {
    ready_after_pending: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = waker;
        if scheduler_inline_pending_poll_count < self.ready_after_pending {
            scheduler_inline_pending_poll_count = scheduler_inline_pending_poll_count + 1;
            return Poll<!i32>.Pending({});
        }
        return Poll<!i32>.Ready(ok<i32>(88));
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

fn queue_event_loop() EventLoop {
    return QueueEventLoop{};
}

fn queue_pending_on_readable_then_ready(fd: i32, value: i32, task_id: i32) Future<!i32> {
    return QueuePendingOnReadableThenReady{ fd: fd, value: value, task_id: task_id };
}

fn queue_pending_on_readable_then_ready_u32(fd: i32, value: u32, task_id: i32) Future<!u32> {
    return QueuePendingOnReadableThenReadyU32{ fd: fd, value: value, task_id: task_id };
}

