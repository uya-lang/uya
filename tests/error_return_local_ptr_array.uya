// 预期编译失败：按值返回含指针元素的局部数组（跨函数内存安全证明 B1）
//
// 数组本身按值拷贝不会悬垂，但元素里的每个指针都是本函数局部存储的地址副本；
// 返回后调用方一旦解引用这些元素，就踩到已失效的栈帧（未定义行为）。
// 注意：纯标量数组 `[i32: 4]` 按值返回是安全的，必须放行 —— 判定只针对元素含指针的形态。
//
// 归属：docs/interprocedural_proof_plan.md §4.4 规则 1（return 判定点），
//       buglist P1 第一条复现 `fn mk() [i32: 4] { var buf: [i32: 4] = []; return buf; }`
//       的指针元素变体。

fn mk() [&i32: 4] {
    var buf: [i32: 4] = [1, 2, 3, 4];
    var out: [&i32: 4] = [];
    out[0] = &buf[0];
    return out;
}

fn main() i32 {
    return 0;
}
