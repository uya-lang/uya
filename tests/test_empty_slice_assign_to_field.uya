extern "libc" fn printf(fmt: *byte, ...) i32;

export struct Box {
    buf: &[byte],
    len: usize,
}

export fn main() i32 {
    var arr: [byte: 4] = [65, 66, 67, 68];
    var box: Box = Box{ buf: arr[0: 4], len: 4 };
    box.buf = (null as &byte)[0: 0];
    box.len = 0;
    if box.len != 0 {
        printf("empty slice assign failed\n" as *byte);
        return 1;
    }
    return 0;
}
