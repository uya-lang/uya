// 测试 @async_fn 和 @await 的类型验证
// TDD: 先写测试，再实现功能

use libc.printf;

// 测试 1：@async_fn 函数可以正常定义
@async_fn
fn async_return_value() i32 {
    return 42;
}

// 测试 2：@async_fn 函数中可以调用其他 async 函数（@await 语法测试）
@async_fn
fn async_call_async() i32 {
    // 注意：当前 @await 实现是临时的，这里测试的是语法解析
    const val: i32 = @await async_return_value();
    return val;
}

fn main() i32 {
    printf("测试 @async_fn 和 @await 类型验证\n" as *byte);
    const result: i32 = async_return_value();
    printf("async_return_value() = %d\n" as *byte, result);
    const result2: i32 = async_call_async();
    printf("async_call_async() = %d\n" as *byte, result2);
    if result == 42 && result2 == 42 {
        printf("所有测试通过\n" as *byte);
        return 0;
    }
    printf("测试失败\n" as *byte);
    return 1;
}
