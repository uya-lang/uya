// error_array_bounds_const_expr.uya - 常量表达式索引越界
//
// 规范 §14.3：常量折叠阶段的越界必须报错。既有负例用的是字面量下标，
// 这里用「常量折叠后才越界」的表达式，确认检查发生在折叠之后，
// 而不是只看语法上的字面量。
//
// 预期：编译失败，报告「数组索引越界：常量索引超出数组边界」

export fn main() i32 {
    const arr: [i32: 3] = [1, 2, 3];
    // 2 + 2 折叠为 4 >= 3
    const idx: i32 = 2 + 2;
    return arr[idx];
}
