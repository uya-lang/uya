// typed pipeline 单 process executor 基础回归。

use std.testing;
use std.process.Pipeline;
use std.process.PipelineResult;
use std.process.PipelineStageStatus;
use std.process.PipelineStageStatusKind;
use std.process.PipelineSpawnFailureKind;
use std.process.check;
use std.process.check_into;
use std.process.cmd_path_argv;
use std.process.cmd_argv;
use std.process.pipeline;
use std.process.status_into;
use std.process.stdout_file;
use std.process.cwd;
use std.process.PipelineCaptureResult;
use std.process.capture_into;
use std.process.capture_limit_into;
use libc.F_OK;
use libc.access;
use libc.unlink;

test "pipeline_single_exact_path_check_executes" {
    const values: [&const byte: 1] = [""];
    const args: &[&const byte] = &values[0:0];
    try check(try cmd_path_argv(pipeline(), "/bin/true", args));
}

test "pipeline_single_observing_status_reports_nonzero_exit" {
    const args_values: [&const byte: 2] = ["-c", "exit 7"];
    const args: &[&const byte] = &args_values[0:2];
    const p: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", args);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:1];
    var result: PipelineResult = PipelineResult { stage_count: 0usize };
    try status_into(p, statuses, &result);
    try assert_eq_i32(result.stage_count as i32, 1);
    try assert_eq_i32(statuses[0].kind as i32, PipelineStageStatusKind.exited as i32);
    try assert_eq_i32(statuses[0].exit_code as i32, 7);
}

test "pipeline_two_stage_printf_wc_executes_with_pipe_eof" {
    const printf_values: [&const byte: 1] = ["hello world"];
    const printf_args: &[&const byte] = &printf_values[0:1];
    const wc_values: [&const byte: 1] = ["-w"];
    const wc_args: &[&const byte] = &wc_values[0:1];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/printf", printf_args);
    const full: Pipeline = try cmd_path_argv(first, "/usr/bin/wc", wc_args);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:2];
    var result: PipelineResult = PipelineResult { stage_count: 0usize };
    try check_into(full, statuses, &result);
    try assert_eq_i32(result.stage_count as i32, 2);
    try assert_eq_i32(statuses[0].exit_code as i32, 0);
    try assert_eq_i32(statuses[1].exit_code as i32, 0);
}

test "pipeline_stdout_file_is_opened_once_before_spawn" {
    const output_path: &const byte = "/tmp/uya_typed_pipeline_executor_output.txt";
    _ = unlink(output_path);
    const args_values: [&const byte: 1] = ["written"];
    const args: &[&const byte] = &args_values[0:1];
    const p: Pipeline = try stdout_file(try cmd_path_argv(pipeline(), "/bin/echo", args), output_path);
    try check(p);
    try assert_eq_i32(access(output_path, F_OK), 0);
    _ = unlink(output_path);
}

test "pipeline_capture_drains_output_larger_than_pipe_buffer" {
    const args_values: [&const byte: 3] = ["-c", "100000", "/dev/zero"];
    const args: &[&const byte] = &args_values[0:3];
    const p: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/head", args);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:1];
    var stdout_storage: [byte: 100000] = [];
    const stdout_buf: &[byte] = &stdout_storage[0:100000];
    var stderr_storage: [byte: 1] = [];
    const stderr_buf: &[byte] = &stderr_storage[0:0];
    var result: PipelineCaptureResult = PipelineCaptureResult{};
    try capture_into(p, statuses, stdout_buf, stderr_buf, &result);
    try assert_eq_i32(result.stdout.byte_count as i32, 100000);
    try assert_eq_bool(result.stdout.complete, true);
}

test "pipeline_capture_limit_uses_one_byte_overflow_probe" {
    const args_values: [&const byte: 3] = ["-c", "11", "/dev/zero"];
    const args: &[&const byte] = &args_values[0:3];
    const p: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/head", args);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:1];
    var stdout_storage: [byte: 10] = [];
    const stdout_buf: &[byte] = &stdout_storage[0:10];
    var stderr_storage: [byte: 1] = [];
    const stderr_buf: &[byte] = &stderr_storage[0:0];
    var result: PipelineCaptureResult = PipelineCaptureResult{};
    const captured: !void = capture_limit_into(p, 10usize, statuses, stdout_buf, stderr_buf, &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.CaptureLimitExceeded) as i32);
    try assert_eq_i32(result.result.stage_count as i32, 0);
}

test "pipeline_path_preflight_failure_starts_no_child" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_preflight_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c", "touch /tmp/uya_typed_pipeline_preflight_marker"];
    const no_args_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    const full: Pipeline = try cmd_argv(first, "uya-command-that-does-not-exist", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:2], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineSpawnFailed) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
    try assert_eq_i32(statuses_storage[1].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
    try assert_eq_i32(statuses_storage[1].spawn_failure as i32,
        PipelineSpawnFailureKind.path_not_found as i32);
}

test "pipeline_cwd_preflight_failure_starts_no_child" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_cwd_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c", "touch /tmp/uya_typed_pipeline_cwd_marker"];
    const true_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    const second: Pipeline = try cmd_path_argv(first, "/bin/true", &true_values[0:0]);
    const full: Pipeline = try cwd(second, "/tmp/uya-directory-that-does-not-exist");
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:2], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineSpawnFailed) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
    try assert_eq_i32(statuses_storage[1].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
    try assert_eq_i32(statuses_storage[1].spawn_failure as i32,
        PipelineSpawnFailureKind.cwd_unavailable as i32);
}

test "pipeline_file_open_failure_is_infrastructure_error" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_file_open_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c", "touch /tmp/uya_typed_pipeline_file_open_marker"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    const full: Pipeline = try stdout_file(command, "/tmp/uya-missing-parent/output.txt");
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineIoError) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
}
