// typed pipeline 单 process executor 基础回归。

use std.testing;
use std.process.Pipeline;
use std.process.PipelineResult;
use std.process.PipelineStageStatus;
use std.process.PipelineStageStatusKind;
use std.process.PipelineSpawnFailureKind;
use std.process.check;
use std.process.check_into;
use std.process.cmd_path_argv;
use std.process.cmd_argv;
use std.process.pipeline;
use std.process.status_into;
use std.process.stdout_file;
use std.process.stderr_file;
use std.process.stderr_capture;
use std.process.stderr_to_stdout;
use std.process.stdin_file;
use std.process.cwd;
use std.process.env;
use std.process.pipeline_fail_next_fork_for_test;
use std.process.pipeline_reset_interrupt_direct_sends_for_test;
use std.process.pipeline_interrupt_direct_sends_for_test;
use std.process.PipelineCaptureResult;
use std.process.capture_into;
use std.process.capture_limit_into;
use libc.F_OK;
use libc.access;
use libc.unlink;
use libc.chdir;
use libc.getcwd;
use libc.SIGTERM;

test "pipeline_single_exact_path_check_executes" {
    const values: [&const byte: 1] = [""];
    const args: &[&const byte] = &values[0:0];
    try check(try cmd_path_argv(pipeline(), "/bin/true", args));
}

test "pipeline_single_observing_status_reports_nonzero_exit" {
    const args_values: [&const byte: 2] = ["-c", "exit 7"];
    const args: &[&const byte] = &args_values[0:2];
    const p: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", args);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:1];
    var result: PipelineResult = PipelineResult { stage_count: 0usize };
    try status_into(p, statuses, &result);
    try assert_eq_i32(result.stage_count as i32, 1);
    try assert_eq_i32(statuses[0].kind as i32, PipelineStageStatusKind.exited as i32);
    try assert_eq_i32(statuses[0].exit_code as i32, 7);
}

test "pipeline_two_stage_printf_wc_executes_with_pipe_eof" {
    const printf_values: [&const byte: 1] = ["hello world"];
    const printf_args: &[&const byte] = &printf_values[0:1];
    const wc_values: [&const byte: 1] = ["-w"];
    const wc_args: &[&const byte] = &wc_values[0:1];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/printf", printf_args);
    const full: Pipeline = try cmd_path_argv(first, "/usr/bin/wc", wc_args);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:2];
    var result: PipelineResult = PipelineResult { stage_count: 0usize };
    try check_into(full, statuses, &result);
    try assert_eq_i32(result.stage_count as i32, 2);
    try assert_eq_i32(statuses[0].exit_code as i32, 0);
    try assert_eq_i32(statuses[1].exit_code as i32, 0);
}

test "pipeline_three_stage_process_chain_completes" {
    const printf_values: [&const byte: 1] = ["alpha beta"];
    const empty_values: [&const byte: 1] = [""];
    const wc_values: [&const byte: 1] = ["-w"];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/printf", &printf_values[0:1]);
    const second: Pipeline = try cmd_path_argv(first, "/bin/cat", &empty_values[0:0]);
    const full: Pipeline = try cmd_path_argv(second, "/usr/bin/wc", &wc_values[0:1]);
    var statuses_storage: [PipelineStageStatus: 3] = [];
    var result: PipelineResult = PipelineResult {};
    try check_into(full, &statuses_storage[0:3], &result);
    try assert_eq_i32(result.stage_count as i32, 3);
    try assert_eq_i32(statuses_storage[0].exit_code as i32, 0);
    try assert_eq_i32(statuses_storage[1].exit_code as i32, 0);
    try assert_eq_i32(statuses_storage[2].exit_code as i32, 0);
}

test "pipeline_stdout_file_is_opened_once_before_spawn" {
    const output_path: &const byte = "/tmp/uya_typed_pipeline_executor_output.txt";
    _ = unlink(output_path);
    const args_values: [&const byte: 1] = ["written"];
    const args: &[&const byte] = &args_values[0:1];
    const p: Pipeline = try stdout_file(try cmd_path_argv(pipeline(), "/bin/echo", args), output_path);
    try check(p);
    try assert_eq_i32(access(output_path, F_OK), 0);
    _ = unlink(output_path);
}

test "pipeline_stderr_file_sink_redirects_group_stderr" {
    const output_path: &const byte = "/tmp/uya_typed_pipeline_stderr_output.txt";
    _ = unlink(output_path);
    const shell_values: [&const byte: 2] = ["-c", "printf stderr-data >&2"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    try check(try stderr_file(command, output_path));
    try assert_eq_i32(access(output_path, F_OK), 0);
    _ = unlink(output_path);
}

test "pipeline_group_stderr_file_is_opened_once_for_all_stages" {
    const output_path: &const byte = "/tmp/uya_typed_pipeline_group_stderr.txt";
    _ = unlink(output_path);
    const first_values: [&const byte: 2] = ["-c", "printf first >&2"];
    const second_values: [&const byte: 2] = ["-c", "printf second >&2"];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &first_values[0:2]);
    const full: Pipeline = try cmd_path_argv(first, "/bin/sh", &second_values[0:2]);
    try check(try stderr_file(full, output_path));

    const cat_values: [&const byte: 1] = [output_path];
    const cat_command: Pipeline = try cmd_path_argv(pipeline(), "/bin/cat", &cat_values[0:1]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(cat_command, &statuses_storage[0:1], &stdout_storage[0:16],
        &stderr_storage[0:0], &result);
    try assert_eq_i32(result.stdout.byte_count as i32, 11);
    try assert_eq_bool(result.stdout.complete, true);
    _ = unlink(output_path);
}

test "pipeline_stdout_file_conflicts_with_capture_sink_before_start" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_capture_conflict_marker";
    const output: &const byte = "/tmp/uya_typed_pipeline_capture_conflict_output";
    _ = unlink(marker);
    _ = unlink(output);
    const shell_values: [&const byte: 2] = ["-c",
        "touch /tmp/uya_typed_pipeline_capture_conflict_marker"];
    const command: Pipeline = try stdout_file(
        try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]), output);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 8] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    const captured: !void = capture_into(command, &statuses_storage[0:1],
        &stdout_storage[0:8], &stderr_storage[0:0], &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.InvalidPipeline) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    _ = unlink(output);
}

test "pipeline_stderr_capture_drains_separate_stream" {
    const shell_values: [&const byte: 2] = ["-c", "printf stderr-data >&2"];
    const command: Pipeline = try stderr_capture(
        try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]));
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 1] = [];
    var stderr_storage: [byte: 32] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(command, &statuses_storage[0:1], &stdout_storage[0:0],
        &stderr_storage[0:32], &result);
    try assert_eq_bool(result.stderr.captured, true);
    try assert_eq_i32(result.stderr.byte_count as i32, 11);
    try assert_eq_bool(result.stderr.complete, true);
}

test "pipeline_stderr_capture_conflicts_with_status_sink_before_start" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_status_conflict_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c",
        "touch /tmp/uya_typed_pipeline_status_conflict_marker"];
    const command: Pipeline = try stderr_capture(
        try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]));
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const observed: !void = status_into(command, &statuses_storage[0:1], &result);
    _ = observed catch {};
    try assert_eq_i32(observed.error_id as i32, @error_id(error.InvalidPipeline) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
}

test "pipeline_capture_rejects_overlapping_output_regions_before_start" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_overlap_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c",
        "touch /tmp/uya_typed_pipeline_overlap_marker; printf out; printf err >&2"];
    const command: Pipeline = try stderr_capture(
        try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]));
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var shared_output: [byte: 16] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    const captured: !void = capture_into(command, &statuses_storage[0:1],
        &shared_output[0:16], &shared_output[0:16], &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.InvalidPipeline) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
}

test "pipeline_stderr_to_stdout_merge_uses_stdout_policy" {
    const shell_values: [&const byte: 2] = ["-c", "printf out; printf err >&2"];
    const command: Pipeline = try stderr_to_stdout(
        try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]));
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(command, &statuses_storage[0:1], &stdout_storage[0:16],
        &stderr_storage[0:0], &result);
    try assert_eq_i32(result.stdout.byte_count as i32, 6);
    try assert_eq_bool(result.stdout.complete, true);
    try assert_eq_bool(result.stderr.captured, false);
}

test "pipeline_capture_drains_output_larger_than_pipe_buffer" {
    const args_values: [&const byte: 3] = ["-c", "100000", "/dev/zero"];
    const args: &[&const byte] = &args_values[0:3];
    const p: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/head", args);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:1];
    var stdout_storage: [byte: 100000] = [];
    const stdout_buf: &[byte] = &stdout_storage[0:100000];
    var stderr_storage: [byte: 1] = [];
    const stderr_buf: &[byte] = &stderr_storage[0:0];
    var result: PipelineCaptureResult = PipelineCaptureResult{};
    try capture_into(p, statuses, stdout_buf, stderr_buf, &result);
    try assert_eq_i32(result.stdout.byte_count as i32, 100000);
    try assert_eq_bool(result.stdout.complete, true);
}

test "pipeline_capture_limit_uses_one_byte_overflow_probe" {
    const args_values: [&const byte: 3] = ["-c", "11", "/dev/zero"];
    const args: &[&const byte] = &args_values[0:3];
    const p: Pipeline = try cmd_path_argv(pipeline(), "/usr/bin/head", args);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    const statuses: &[PipelineStageStatus] = &statuses_storage[0:1];
    var stdout_storage: [byte: 10] = [];
    const stdout_buf: &[byte] = &stdout_storage[0:10];
    var stderr_storage: [byte: 1] = [];
    const stderr_buf: &[byte] = &stderr_storage[0:0];
    var result: PipelineCaptureResult = PipelineCaptureResult{};
    const captured: !void = capture_limit_into(p, 10usize, statuses, stdout_buf, stderr_buf, &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.CaptureLimitExceeded) as i32);
    try assert_eq_i32(result.result.stage_count as i32, 0);
}

test "pipeline_capture_limit_kills_writer_that_ignores_sigpipe" {
    const shell_values: [&const byte: 2] = ["-c",
        "exec 2>/dev/null; trap '' PIPE; while :; do printf 0123456789abcdef; done"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    const captured: !void = capture_limit_into(command, 16usize,
        &statuses_storage[0:1], &stdout_storage[0:16], &stderr_storage[0:0], &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.CaptureLimitExceeded) as i32);
    try assert_eq_i32(result.result.stage_count as i32, 0);
}

test "pipeline_capture_limit_kills_direct_stage_after_setsid_escape" {
    const no_args_values: [&const byte: 1] = [""];
    const setsid_values: [&const byte: 3] = ["/bin/sh", "-c",
        "exec 2>/dev/null; while :; do printf escaped-stage; done"];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/true", &no_args_values[0:0]);
    const full: Pipeline = try cmd_path_argv(first, "/usr/bin/setsid", &setsid_values[0:3]);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    const captured: !void = capture_limit_into(full, 16usize,
        &statuses_storage[0:2], &stdout_storage[0:16], &stderr_storage[0:0], &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.CaptureLimitExceeded) as i32);
    try assert_eq_i32(result.result.stage_count as i32, 0);
}

test "pipeline_capture_cancel_does_not_wait_for_escaped_descendant_writer" {
    const shell_values: [&const byte: 2] = ["-c",
        "setsid /bin/sh -c 'sleep 3' & printf 0123456789abcdefX; wait"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    const captured: !void = capture_limit_into(command, 16usize,
        &statuses_storage[0:1], &stdout_storage[0:16], &stderr_storage[0:0], &result);
    _ = captured catch {};
    try assert_eq_i32(captured.error_id as i32, @error_id(error.CaptureLimitExceeded) as i32);
    try assert_eq_bool(result.stdout.complete, false);
}

test "pipeline_path_preflight_failure_starts_no_child" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_preflight_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c", "touch /tmp/uya_typed_pipeline_preflight_marker"];
    const no_args_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    const full: Pipeline = try cmd_argv(first, "uya-command-that-does-not-exist", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:2], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineSpawnFailed) as i32);
    try assert_eq_i32(result.stage_count as i32, 2);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
    try assert_eq_i32(statuses_storage[1].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
    try assert_eq_i32(statuses_storage[1].spawn_failure as i32,
        PipelineSpawnFailureKind.path_not_found as i32);
}

test "pipeline_cwd_preflight_failure_starts_no_child" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_cwd_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c", "touch /tmp/uya_typed_pipeline_cwd_marker"];
    const true_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    const second: Pipeline = try cmd_path_argv(first, "/bin/true", &true_values[0:0]);
    const full: Pipeline = try cwd(second, "/tmp/uya-directory-that-does-not-exist");
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:2], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineSpawnFailed) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
    try assert_eq_i32(statuses_storage[1].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
    try assert_eq_i32(statuses_storage[1].spawn_failure as i32,
        PipelineSpawnFailureKind.cwd_unavailable as i32);
}

test "pipeline_file_open_failure_is_infrastructure_error" {
    const marker: &const byte = "/tmp/uya_typed_pipeline_file_open_marker";
    _ = unlink(marker);
    const shell_values: [&const byte: 2] = ["-c", "touch /tmp/uya_typed_pipeline_file_open_marker"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    const full: Pipeline = try stdout_file(command, "/tmp/uya-missing-parent/output.txt");
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineIoError) as i32);
    try assert_eq_i32(access(marker, F_OK), 0 - 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
}

test "pipeline_redirect_open_order_has_nontransactional_side_effects" {
    const output: &const byte = "/tmp/uya_typed_pipeline_open_order.txt";
    _ = unlink(output);
    const no_args_values: [&const byte: 1] = [""];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/true", &no_args_values[0:0]);
    const with_stdin: Pipeline = try stdin_file(command, "/dev/null");
    const with_stdout: Pipeline = try stdout_file(with_stdin, output);
    const full: Pipeline = try stderr_file(with_stdout, "/tmp/uya-missing-parent/stderr.txt");
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineIoError) as i32);
    try assert_eq_i32(access(output, F_OK), 0);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.not_started as i32);
    _ = unlink(output);
}

test "pipeline_runtime_broker_interrupts_and_cancels_process_group" {
    const shell_values: [&const byte: 2] = ["-c", "kill -TERM $PPID; sleep 10"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    pipeline_reset_interrupt_direct_sends_for_test();
    const executed: !void = check_into(command, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.Interrupted) as i32);
    try assert_eq_i32(pipeline_interrupt_direct_sends_for_test(), 0);
}

test "pipeline_stopped_child_is_cancelled_without_hanging" {
    const shell_values: [&const byte: 2] = ["-c", "kill -STOP $$"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(command, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.Interrupted) as i32);
}

test "pipeline_child_exec_failure_reports_phase_and_platform_code" {
    const no_args_values: [&const byte: 1] = [""];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/tmp", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(command, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineSpawnFailed) as i32);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
    try assert_eq_i32(statuses_storage[0].spawn_failure as i32,
        PipelineSpawnFailureKind.exec_failed as i32);
    try assert_eq_bool(statuses_storage[0].platform_code > 0u32, true);
}

test "pipeline_capture_does_not_wait_for_descendant_writer_eof" {
    const shell_values: [&const byte: 2] = ["-c",
        "(sleep 1; printf late) & printf done; exit 0"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(command, &statuses_storage[0:1], &stdout_storage[0:16],
        &stderr_storage[0:0], &result);
    try assert_eq_i32(result.stdout.byte_count as i32, 4);
    try assert_eq_bool(result.stdout.complete, false);
}

test "pipeline_checked_sink_uses_all_stage_pipefail" {
    const no_args_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/false", &no_args_values[0:0]);
    const full: Pipeline = try cmd_path_argv(first, "/bin/true", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:2], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.ProcessFailed) as i32);
    try assert_eq_i32(result.stage_count as i32, 2);
    try assert_eq_i32(statuses_storage[0].exit_code as i32, 1);
    try assert_eq_i32(statuses_storage[1].exit_code as i32, 0);
}

test "pipeline_checked_sink_reports_last_stage_nonzero_exit" {
    const no_args_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/true", &no_args_values[0:0]);
    const full: Pipeline = try cmd_path_argv(first, "/bin/false", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(full, &statuses_storage[0:2], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.ProcessFailed) as i32);
    try assert_eq_i32(statuses_storage[0].exit_code as i32, 0);
    try assert_eq_i32(statuses_storage[1].exit_code as i32, 1);
}

test "pipeline_status_sink_observes_spawn_failure_without_error" {
    const no_args_values: [&const byte: 1] = [""];
    const command: Pipeline = try cmd_argv(pipeline(), "uya-observing-missing-command", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    try status_into(command, &statuses_storage[0:1], &result);
    try assert_eq_i32(result.stage_count as i32, 1);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
    try assert_eq_i32(statuses_storage[0].spawn_failure as i32,
        PipelineSpawnFailureKind.path_not_found as i32);
}

test "pipeline_status_sink_observes_signal_without_error" {
    const shell_values: [&const byte: 2] = ["-c", "kill -TERM $$"];
    const command: Pipeline = try cmd_path_argv(pipeline(), "/bin/sh", &shell_values[0:2]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    try status_into(command, &statuses_storage[0:1], &result);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.signaled as i32);
    try assert_eq_i32(statuses_storage[0].signal, SIGTERM);
}

test "pipeline_capture_sink_observes_spawn_failure_without_error" {
    const no_args_values: [&const byte: 1] = [""];
    const command: Pipeline = try cmd_argv(pipeline(), "uya-capture-missing-command", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var stdout_storage: [byte: 8] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(command, &statuses_storage[0:1], &stdout_storage[0:8],
        &stderr_storage[0:0], &result);
    try assert_eq_i32(result.result.stage_count as i32, 1);
    try assert_eq_bool(result.stdout.captured, true);
    try assert_eq_i32(result.stdout.byte_count as i32, 0);
    try assert_eq_bool(result.stdout.complete, false);
    try assert_eq_i32(statuses_storage[0].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
}

test "pipeline_capture_partial_startup_cancel_is_incomplete_without_observed_eof" {
    const first_values: [&const byte: 1] = ["10"];
    const no_args_values: [&const byte: 1] = [""];
    const first: Pipeline = try cmd_path_argv(pipeline(), "/bin/sleep", &first_values[0:1]);
    const full: Pipeline = try cmd_path_argv(first, "/tmp", &no_args_values[0:0]);
    var statuses_storage: [PipelineStageStatus: 2] = [];
    var stdout_storage: [byte: 16] = [];
    var stderr_storage: [byte: 1] = [];
    var result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_into(full, &statuses_storage[0:2], &stdout_storage[0:16],
        &stderr_storage[0:0], &result);
    try assert_eq_bool(result.stdout.captured, true);
    try assert_eq_bool(result.stdout.complete, false);
    try assert_eq_i32(statuses_storage[1].kind as i32, PipelineStageStatusKind.spawn_failed as i32);
}

test "pipeline_capture_probe_distinguishes_zero_exact_and_overflow" {
    const empty_values: [&const byte: 1] = [""];
    const below_values: [&const byte: 1] = ["abc"];
    const exact_values: [&const byte: 1] = ["abcd"];
    const overflow_values: [&const byte: 1] = ["abcde"];
    var empty_statuses: [PipelineStageStatus: 1] = [];
    var empty_stdout: [byte: 1] = [];
    var empty_stderr: [byte: 1] = [];
    var empty_result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_limit_into(try cmd_path_argv(pipeline(), "/bin/true", &empty_values[0:0]),
        0usize, &empty_statuses[0:1], &empty_stdout[0:0], &empty_stderr[0:0], &empty_result);
    try assert_eq_bool(empty_result.stdout.complete, true);
    var below_statuses: [PipelineStageStatus: 1] = [];
    var below_stdout: [byte: 4] = [];
    var below_result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_limit_into(try cmd_path_argv(pipeline(), "/usr/bin/printf", &below_values[0:1]),
        4usize, &below_statuses[0:1], &below_stdout[0:4], &empty_stderr[0:0], &below_result);
    try assert_eq_i32(below_result.stdout.byte_count as i32, 3);
    try assert_eq_bool(below_result.stdout.complete, true);
    var exact_statuses: [PipelineStageStatus: 1] = [];
    var exact_stdout: [byte: 4] = [];
    var exact_result: PipelineCaptureResult = PipelineCaptureResult {};
    try capture_limit_into(try cmd_path_argv(pipeline(), "/usr/bin/printf", &exact_values[0:1]),
        4usize, &exact_statuses[0:1], &exact_stdout[0:4], &empty_stderr[0:0], &exact_result);
    try assert_eq_i32(exact_result.stdout.byte_count as i32, 4);
    try assert_eq_bool(exact_result.stdout.complete, true);
    var overflow_statuses: [PipelineStageStatus: 1] = [];
    var overflow_stdout: [byte: 4] = [];
    var overflow_result: PipelineCaptureResult = PipelineCaptureResult {};
    const overflowed: !void = capture_limit_into(
        try cmd_path_argv(pipeline(), "/usr/bin/printf", &overflow_values[0:1]),
        4usize, &overflow_statuses[0:1], &overflow_stdout[0:4], &empty_stderr[0:0], &overflow_result);
    _ = overflowed catch {};
    try assert_eq_i32(overflowed.error_id as i32, @error_id(error.CaptureLimitExceeded) as i32);
    try assert_eq_i32(overflow_result.result.stage_count as i32, 0);
}

test "pipeline_path_permission_failure_has_stable_classification" {
    const no_args_values: [&const byte: 1] = [""];
    const command: Pipeline = try env(
        try cmd_argv(pipeline(), "passwd", &no_args_values[0:0]), "PATH", "/etc");
    var statuses_storage: [PipelineStageStatus: 1] = [];
    var result: PipelineResult = PipelineResult {};
    const executed: !void = check_into(command, &statuses_storage[0:1], &result);
    _ = executed catch {};
    try assert_eq_i32(executed.error_id as i32, @error_id(error.PipelineSpawnFailed) as i32);
    try assert_eq_i32(statuses_storage[0].spawn_failure as i32,
        PipelineSpawnFailureKind.permission_denied as i32);
}

