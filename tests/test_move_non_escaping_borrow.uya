// 移动语义 B5：指针只传给**非逃逸形参**时，被借用的变量仍然可以移动。
//
// 规范 §12.5.5 + docs/interprocedural_proof_plan.md 的 B5。判定条件（见
// src/checker/lifetime.uya 的 lifetime_pointer_is_dead）：
//   ① 指针的每一次使用都是「实参 → 被调方的非逃逸形参」；
//   ② 这些使用都早于移动点。
// 这里 `peek` 只解引用形参（不存字段/全局、不返回、不再外传），所以调用返回后
// `p` 已经是死指针，`a` 可以安全移动。

struct S {
    id: i32
}

fn peek(p: &S) i32 {
    return p[0].id;
}

fn take(v: S) i32 {
    return v.id;
}

export fn main() i32 {
    const a: S = S{ id: 42 };
    const p: &S = &a;
    const r: i32 = peek(p);
    const t: i32 = take(a);
    if r != 42 {
        return 1;
    }
    if t != 42 {
        return 2;
    }
    return 0;
}
