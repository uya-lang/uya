// error_array_eq_compare.uya
// 负例：数组不支持 == / != 比较（规范 §10「类型比较规则」）。
//
// 理由：Uya 的数组是左值对象，C99 后端直接发射 `a == b` 会退化成首元素指针比较，
// 语义不是「逐元素相等」，属于静默的错误代码。要比较内容请用 std.mem.mem_cmp
// 或显式逐元素循环。
//
// 判定规则是「编译失败即可」，不校验报错文案。

export fn main() i32 {
    var a: [i32: 3] = [1, 2, 3];
    var b: [i32: 3] = [1, 2, 3];

    if a == b {
        return 0;
    }

    if a != b {
        return 2;
    }

    return 1;
}
