// typed pipeline cmd_argv 基础 API 回归。

use std.testing;
use std.process.Pipeline;
use std.process.cmd_argv;
use std.process.cmd_path_argv;
use std.process.cwd;
use std.process.stdin_file;
use std.process.stdout_file;
use std.process.stderr_file;
use std.process.stdout_capture;
use std.process.stderr_capture;
use std.process.stderr_to_stdout;
use std.process.pipeline;
use std.process.stage_count;

test "pipeline_cmd_argv_appends_owned_process_stage" {
    const values: [&const byte: 2] = ["hello", "world"];
    const args: &[&const byte] = &values[0:2];
    const p: Pipeline = try cmd_argv(pipeline(), "printf", args);
    try assert_eq_i32((try stage_count(&p)) as i32, 1);
}

test "pipeline_cmd_argv_rejects_empty_or_path_command" {
    const no_args_values: [&const byte: 1] = [""];
    const no_args: &[&const byte] = &no_args_values[0:0];
    const empty_result: !Pipeline = cmd_argv(pipeline(), "", no_args);
    _ = empty_result catch { pipeline(); };
    const path_result: !Pipeline = cmd_argv(pipeline(), "dir/tool", no_args);
    _ = path_result catch { pipeline(); };
    try assert_eq_i32(empty_result.error_id as i32, @error_id(error.InvalidPipeline) as i32);
    try assert_eq_i32(path_result.error_id as i32, @error_id(error.InvalidPipeline) as i32);
}

test "pipeline_cmd_path_argv_accepts_relative_exact_path" {
    const no_args_values: [&const byte: 1] = [""];
    const no_args: &[&const byte] = &no_args_values[0:0];
    const p: Pipeline = try cwd(try cmd_path_argv(pipeline(), "tools/helper", no_args), "workspace");
    try assert_eq_i32((try stage_count(&p)) as i32, 1);
}

test "pipeline_file_stream_transformers_store_owned_paths" {
    const no_args_values: [&const byte: 1] = [""];
    const no_args: &[&const byte] = &no_args_values[0:0];
    const p0: Pipeline = try cmd_argv(pipeline(), "printf", no_args);
    const p1: Pipeline = try stdin_file(p0, "input.txt");
    const p2: Pipeline = try stdout_file(p1, "output.txt");
    const p3: Pipeline = try stderr_file(p2, "error.txt");
    try assert_eq_i32((try stage_count(&p3)) as i32, 1);
}

test "pipeline_capture_and_merge_transformers_configure_streams" {
    const no_args_values: [&const byte: 1] = [""];
    const no_args: &[&const byte] = &no_args_values[0:0];
    const captured: Pipeline = try stderr_capture(try stdout_capture(
        try cmd_argv(pipeline(), "printf", no_args)));
    try assert_eq_i32((try stage_count(&captured)) as i32, 1);
    const merged: Pipeline = try stderr_to_stdout(try cmd_argv(pipeline(), "printf", no_args));
    try assert_eq_i32((try stage_count(&merged)) as i32, 1);
}

test "pipeline_stream_transformers_reject_conflicts" {
    const no_args_values: [&const byte: 1] = [""];
    const no_args: &[&const byte] = &no_args_values[0:0];
    const configured: Pipeline = try stdout_file(try cmd_argv(pipeline(), "printf", no_args), "out.txt");
    const conflict: !Pipeline = stdout_capture(configured);
    _ = conflict catch { pipeline(); };
    try assert_eq_i32(conflict.error_id as i32, @error_id(error.InvalidPipeline) as i32);
}
