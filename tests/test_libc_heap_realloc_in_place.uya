use std.testing.expect;
use std.testing.assert;
use libc.malloc;
use libc.free;
use libc.realloc;
use libc.heap_flush_current_thread_cache;

const TEST_MALLOC_ALIGN: usize = 16usize;
const TEST_MIN_CHUNK_SIZE: usize = 32usize;
const TEST_CHUNK_OVERHEAD: usize = 24usize;
const TEST_BLOCK_A_SIZE: usize = 1000usize;
const TEST_BLOCK_B_SIZE: usize = 1800usize;
const TEST_GUARD_SIZE: usize = 32usize;
const TEST_GROWN_SIZE: usize = 2300usize;
const TEST_TAIL_DRAIN_SIZE: usize = 900usize;
const TEST_REMAINDER_REUSE_SIZE: usize = 400usize;
const TEST_MAX_ATTEMPTS: usize = 8usize;
const TEST_A_SENTINEL_SEED: usize = 37usize;
const TEST_GROWN_SENTINEL_SEED: usize = 89usize;
const TEST_GUARD_SENTINEL_SEED: usize = 113usize;
const TEST_REMAINDER_SENTINEL_SEED: usize = 173usize;

struct TestReallocLayout {
    block_a: &void,
    block_b: &void,
    guard: &void,
}

fn test_alloc_checked(size: usize) !&void {
    const ptr: &void = malloc(size);
    try expect(ptr != null);
    return ptr;
}

fn test_free_if_non_null(ptr: &void) void {
    if ptr != null {
        free(ptr);
    }
}

fn test_heap_align_up(size: usize) usize {
    if size == 0usize { return TEST_MALLOC_ALIGN; }
    var q: usize = size / TEST_MALLOC_ALIGN;
    var r: usize = size - q * TEST_MALLOC_ALIGN;
    if r == 0usize { return size; }
    return (q + 1usize) * TEST_MALLOC_ALIGN;
}

fn test_normalize_payload_size(size: usize) usize {
    var aligned: usize = test_heap_align_up(size);
    if aligned < TEST_MIN_CHUNK_SIZE { aligned = TEST_MIN_CHUNK_SIZE; }
    return aligned;
}

fn test_chunk_total_for_request(size: usize) usize {
    return test_heap_align_up(test_normalize_payload_size(size) + TEST_CHUNK_OVERHEAD);
}

fn test_sentinel_byte(seed: usize, index: usize) byte {
    return (((seed + index * 17usize) % 251usize) as byte);
}

fn test_write_pattern(ptr: &void, size: usize, seed: usize) void {
    const bytes: &byte = ptr as &byte;
    var i: usize = 0usize;
    while i < size {
        bytes[i] = test_sentinel_byte(seed, i);
        i = i + 1usize;
    }
}

fn test_assert_pattern(ptr: &void, size: usize, seed: usize, label: &const byte) !void {
    const bytes: &byte = ptr as &byte;
    var i: usize = 0usize;
    while i < size {
        try assert(bytes[i] == test_sentinel_byte(seed, i), label);
        i = i + 1usize;
    }
}

fn test_matches_ab_guard_layout(block_a: &void, block_b: &void, guard: &void) bool {
    const a_addr: usize = @usize_from_ptr(block_a);
    const b_addr: usize = @usize_from_ptr(block_b);
    const guard_addr: usize = @usize_from_ptr(guard);

    if b_addr != a_addr + test_chunk_total_for_request(TEST_BLOCK_A_SIZE) { return false; }
    if guard_addr != b_addr + test_chunk_total_for_request(TEST_BLOCK_B_SIZE) { return false; }
    return true;
}

fn test_carve_contiguous_ab_guard_layout() !TestReallocLayout {
    var blocks_a: [&void: TEST_MAX_ATTEMPTS] = [];
    var blocks_b: [&void: TEST_MAX_ATTEMPTS] = [];
    var guards: [&void: TEST_MAX_ATTEMPTS] = [];
    var found: bool = false;
    var found_index: usize = 0usize;

    heap_flush_current_thread_cache();

    var i: usize = 0usize;
    while i < TEST_MAX_ATTEMPTS {
        blocks_a[i] = try test_alloc_checked(TEST_BLOCK_A_SIZE);
        blocks_b[i] = try test_alloc_checked(TEST_BLOCK_B_SIZE);
        guards[i] = try test_alloc_checked(TEST_GUARD_SIZE);
        if test_matches_ab_guard_layout(blocks_a[i], blocks_b[i], guards[i]) {
            found = true;
            found_index = i;
            break;
        }
        i = i + 1usize;
    }

    try assert(found, "failed to carve contiguous A/B/guard layout");

    const layout: TestReallocLayout = TestReallocLayout{
        block_a: blocks_a[found_index],
        block_b: blocks_b[found_index],
        guard: guards[found_index],
    };

    i = 0usize;
    while i < TEST_MAX_ATTEMPTS {
        if i != found_index {
            test_free_if_non_null(guards[i]);
            test_free_if_non_null(blocks_b[i]);
            test_free_if_non_null(blocks_a[i]);
        }
        i = i + 1usize;
    }
    heap_flush_current_thread_cache();

    return layout;
}

test "heap_realloc_grows_in_place_preserves_a_and_keeps_guard_intact" {
    try assert(test_chunk_total_for_request(TEST_BLOCK_A_SIZE) + test_chunk_total_for_request(TEST_BLOCK_B_SIZE) >= test_chunk_total_for_request(TEST_GROWN_SIZE),
               "A+B merged chunk must satisfy the grown request");

    const layout: TestReallocLayout = try test_carve_contiguous_ab_guard_layout();
    test_write_pattern(layout.block_a, TEST_BLOCK_A_SIZE, TEST_A_SENTINEL_SEED);
    test_write_pattern(layout.guard, TEST_GUARD_SIZE, TEST_GUARD_SENTINEL_SEED);

    free(layout.block_b);

    const grown: &void = realloc(layout.block_a, TEST_GROWN_SIZE);
    try expect(grown != null);
    try assert(@usize_from_ptr(grown) == @usize_from_ptr(layout.block_a), "realloc should grow block A in place");
    try test_assert_pattern(grown, TEST_BLOCK_A_SIZE, TEST_A_SENTINEL_SEED, "block A sentinel data should survive realloc");
    try test_assert_pattern(layout.guard, TEST_GUARD_SIZE, TEST_GUARD_SENTINEL_SEED, "guard data should remain unchanged");

    free(layout.guard);
    free(grown);
    heap_flush_current_thread_cache();
}

test "heap_realloc_split_remainder_stays_reusable_after_in_place_growth" {
    const grown_total: usize = test_chunk_total_for_request(TEST_GROWN_SIZE);
    const merged_total: usize = test_chunk_total_for_request(TEST_BLOCK_A_SIZE) + test_chunk_total_for_request(TEST_BLOCK_B_SIZE);
    const remainder_total: usize = merged_total - grown_total;

    try assert(remainder_total >= test_chunk_total_for_request(TEST_REMAINDER_REUSE_SIZE),
               "split remainder must fit the follow-up reuse allocation");
    try assert(test_chunk_total_for_request(TEST_TAIL_DRAIN_SIZE) > remainder_total,
               "tail drainer must bypass the split remainder");

    const layout: TestReallocLayout = try test_carve_contiguous_ab_guard_layout();
    test_write_pattern(layout.guard, TEST_GUARD_SIZE, TEST_GUARD_SENTINEL_SEED);

    free(layout.block_b);

    const grown: &void = realloc(layout.block_a, TEST_GROWN_SIZE);
    try expect(grown != null);
    try assert(@usize_from_ptr(grown) == @usize_from_ptr(layout.block_a), "realloc should grow block A in place");
    test_write_pattern(grown, TEST_GROWN_SIZE, TEST_GROWN_SENTINEL_SEED);

    const expected_remainder_addr: usize = @usize_from_ptr(grown) + grown_total;
    const old_block_b_addr: usize = @usize_from_ptr(layout.block_b);

    const tail_only: &void = malloc(TEST_TAIL_DRAIN_SIZE);
    try expect(tail_only != null);
    const tail_only_addr: usize = @usize_from_ptr(tail_only);
    try assert(tail_only_addr != old_block_b_addr,
               "tail-only allocation must not reuse the swallowed next chunk");

    const remainder_first: &void = malloc(TEST_REMAINDER_REUSE_SIZE);
    try expect(remainder_first != null);
    const remainder_first_addr: usize = @usize_from_ptr(remainder_first);
    try assert(remainder_first_addr == expected_remainder_addr,
               "follow-up allocation should reuse the split remainder chunk");
    try assert(remainder_first_addr != old_block_b_addr,
               "swallowed next chunk must be removed from the free list");
    test_write_pattern(remainder_first, TEST_REMAINDER_REUSE_SIZE, TEST_REMAINDER_SENTINEL_SEED);

    free(remainder_first);
    heap_flush_current_thread_cache();

    const remainder_second: &void = malloc(TEST_REMAINDER_REUSE_SIZE);
    try expect(remainder_second != null);
    const remainder_second_addr: usize = @usize_from_ptr(remainder_second);
    try assert(remainder_second_addr == expected_remainder_addr,
               "freed split remainder should stay reusable");
    test_write_pattern(remainder_second, TEST_REMAINDER_REUSE_SIZE, TEST_REMAINDER_SENTINEL_SEED + 11usize);

    try test_assert_pattern(grown, TEST_GROWN_SIZE, TEST_GROWN_SENTINEL_SEED, "grown block should remain intact after remainder reuse");
    try test_assert_pattern(layout.guard, TEST_GUARD_SIZE, TEST_GUARD_SENTINEL_SEED, "guard block should remain intact after remainder reuse");

    free(remainder_second);
    free(tail_only);
    free(layout.guard);
    free(grown);
    heap_flush_current_thread_cache();
}
