// error_array_bounds_interval_wrap.uya - 加法/减法回绕出的反转区间不得放行越界下标
//
// 规范 §14.2：变量索引必须证明 `i >= 0 && i < len`，证明失败即编译错误。
// 本用例覆盖「区间分析」路径的非线性下标（`w + h`、`w - h`、`w + w` 提取不出
// 单变量线性表达式，只能走 verify_expr_bounds_interval）。用**赋值**形态触发，
// 因为赋值路径一直有这一步，读数路径的缺口是另一件事。
//
// 曾经的健全性漏洞（P0，2026-10-11 修复）：区间端点用 i32 原生运算，溢出
// **回绕**会产出反转区间（两个 [i32::MIN, i32::MAX] 相加得到 [0, -2]），而
// 「区间完全落在 [0, len) 内」的判据只比较两个端点（min >= 0 && max < len），
// [0, -2] 恰好满足 → 越界访问被当成「已证明安全」。
// 注意 `w * w` 本来就拒绝（回绕成 [-1, 1]，min 为负），所以负例必须用加减形态。
//
// 修复取向是「证明不成立就不放行」：端点反转的区间一律不构成证明。
// 合法的守卫写法仍然放行，见 test_bounds_interval_wrap.uya。
//
// 预期：编译失败，报告「数组索引需要安全证明」

// 两个形参相加：端点相加回绕成 [0, -2]
fn write_add(w: i32, h: i32) i32 {
    var a: [i32: 5] = [1, 2, 3, 4, 5];
    a[w + h] = 99;
    return a[0];
}

// 两个形参相减：端点相减同样回绕
fn write_sub(w: i32, h: i32) i32 {
    var a: [i32: 5] = [1, 2, 3, 4, 5];
    a[w - h] = 99;
    return a[0];
}

// 同一形参自加
fn write_self_add(w: i32) i32 {
    var a: [i32: 5] = [1, 2, 3, 4, 5];
    a[w + w] = 99;
    return a[0];
}

export fn main() i32 {
    return write_add(1, 2) + write_sub(1, 2) + write_self_add(2);
}
