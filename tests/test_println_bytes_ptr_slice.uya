// test_println_bytes_ptr_slice.uya - @println 对字节指针 / 切片按 C 字符串打印
//
// 语义口径：`*byte`、`&byte`、`&[byte]`、`&[const byte]`、`[byte: N]` 都应有 `%s` 语义。
// 此前 codegen 只对 `int8_t[N]` / `uint8_t[N]` 字面类型走 `%s`，指针与切片一律落进
// `%lld`（打印地址数值），本文件前三个用例因此写成「断言不等于 3」来固化错误行为。
// 现在这些形态统一走 `%s`，用例改为断言真实字符数。

use std.testing.assert_eq_i32;

test "println_const_byte_ptr_prints_as_string" {
    const s: &const byte = "Hi\0" as &const byte;
    const printed: i32 = @println(s);
    // "Hi" 长度 2，末尾换行 1，总计 3
    try assert_eq_i32(printed, 3);
}

test "println_const_byte_slice_prints_as_string" {
    // 切片覆盖到 '\0'，与 C %s 字符串语义一致
    const sl: &[const byte] = &"Hi\0"[0:3];
    const printed: i32 = @println(sl);
    // "Hi" 长度 2，末尾换行 1，总计 3
    try assert_eq_i32(printed, 3);
}

test "println_byte_slice_prints_as_string" {
    const sl: &[byte] = &"Hi\0"[0:3];
    const printed: i32 = @println(sl);
    // "Hi" 长度 2，末尾换行 1，总计 3
    try assert_eq_i32(printed, 3);
}

test "println_byte_array_prints_as_string" {
    // 对照：当表达式类型在 C 端表现为 `uint8_t[N]`/`int8_t[N]` 数组时，
    // gen_print_expr 会选择 %s 路径。
    const arr: [byte:3] = "Hi\0";
    const printed: i32 = @println(arr);
    // "Hi" 长度 2，末尾换行 1，总计 3
    try assert_eq_i32(printed, 3);
}

test "println_interp_const_byte_ptr_as_string" {
    const s: &const byte = "Hi\0" as &const byte;
    const printed: i32 = @println("x=${s}");
    // "x=" 长度 2 + "Hi" 长度 2 + 换行 1 = 5
    try assert_eq_i32(printed, 5);
}

test "println_interp_const_byte_slice_as_string" {
    const sl: &[const byte] = &"Hi\0"[0:3];
    const printed: i32 = @println("x=${sl}");
    // "x=" 长度 2 + "Hi" 长度 2 + 换行 1 = 5
    try assert_eq_i32(printed, 5);
}

// 回归：负整数的 @println / 插值都必须打出负号。
// 修复前 `%lld` 配 `int32_t` 实参是未定义行为，-7 会打成 4294967289。
test "println_negative_i32_prints_sign" {
    const x: i32 = 0 - 7;
    const printed: i32 = @println(x);
    // "-7" 长度 2 + 换行 1 = 3
    try assert_eq_i32(printed, 3);
}

test "interp_negative_i32_prints_sign" {
    const x: i32 = 0 - 300;
    const printed: i32 = @println("${x}");
    // "-300" 长度 4 + 换行 1 = 5
    try assert_eq_i32(printed, 5);
}

// 回归：浮点插值必须走浮点转换符，不能当整数格式化。
// 修复前 `"${pi}"` 打出 `-1963457608` 这类垃圾值。
test "interp_f64_prints_fraction" {
    const pi: f64 = 3.14159;
    const printed: i32 = @println("${pi}");
    // "3.14159" 长度 7 + 换行 1 = 8
    try assert_eq_i32(printed, 8);
}

test "println_f64_not_integer" {
    const v: f64 = 3.5;
    const printed: i32 = @println(v);
    // "3.5" 长度 3 + 换行 1 = 4
    try assert_eq_i32(printed, 4);
}
