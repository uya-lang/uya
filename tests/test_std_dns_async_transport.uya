test "dns_transport_direct_futures_time_out_on_silent_loopback_nameservers" {
    var udp_port: u16 = 0;
    const udp_fd: i32 = dns_bind_loopback_udp(&udp_port) catch {
        try assert_eq_i32(0, 1);
        return;
    };
    try dns_assert_direct_udp_timeout(udp_port);
    _ = sys_close(udp_fd) catch {};

    var tcp_port: u16 = 0;
    const tcp_fd: i32 = dns_listen_loopback_tcp(&tcp_port) catch {
        try assert_eq_i32(0, 1);
        return;
    };
    try dns_assert_direct_tcp_timeout(tcp_port);
    _ = sys_close(tcp_fd) catch {};
}

test "dns_transport_direct_futures_cancel_cleanly_in_shared_queue" {
    var udp_port: u16 = 0;
    const udp_fd: i32 = dns_bind_loopback_udp(&udp_port) catch {
        try assert_eq_i32(0, 1);
        return;
    };
    var tcp_port: u16 = 0;
    const tcp_fd: i32 = dns_listen_loopback_tcp(&tcp_port) catch {
        _ = sys_close(udp_fd) catch {};
        try assert_eq_i32(0, 1);
        return;
    };

    try dns_assert_transport_queue_cancel(udp_port, tcp_port);

    _ = sys_close(udp_fd) catch {};
    _ = sys_close(tcp_fd) catch {};
}
