    dns_serve_single_udp_a(udp_fd) catch {
        _ = sys_close(udp_fd) catch {};
        try assert_eq_i32(0, 1);
        return;
    };

    _ = sys_close(udp_fd) catch {};
    try wait_child_exit_ok(child_pid);
}

test "dns_query_a_tcp_future_loopback_success" {
