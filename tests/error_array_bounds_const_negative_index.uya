// error_array_bounds_const_negative_index.uya - 常量负下标必须报错
//
// 规范 §14.2：常量索引越界 → 编译错误。常量求值早先用返回值 -1 同时表示
// 「非常量表达式」与「常量 -1」，于是 `a[0 - 1]` 被当成变量索引送进证明器，
// 证明器对常量既提取不出线性表达式也拿不到区间，静默失败直接放行
// （见 tests/repros/bounds_const_negative_index.uya 的实测记录）。
//
// 修复后常量求值改为「成功标志 + 值」双返回，常量 -1 不再掉进变量分支。
// 本用例同时覆盖 -1 之外的负常量，确认不是只对 -1 打补丁。
//
// 预期：编译失败，报告「数组索引越界：索引不能为负数」

fn direct_neg_one() i32 {
    const a: [i32: 3] = [1, 2, 3];
    // 常量 -1：早先静默通过，生成 a[(-1)]
    return a[0 - 1];
}

fn other_negative() i32 {
    const a: [i32: 3] = [1, 2, 3];
    // 常量 -2：与 -1 走同一条常量分支
    return a[0 - 2];
}

fn unary_negative() i32 {
    const a: [i32: 3] = [1, 2, 3];
    // 一元负号形态
    return a[-1];
}

fn stored_in_const() i32 {
    const a: [i32: 3] = [1, 2, 3];
    const k: i32 = 0 - 1;
    // 经局部 const 传进来的负值
    return a[k];
}

export fn main() i32 {
    return direct_neg_one() + other_negative() + unary_negative() + stored_in_const();
}
