extern "libc" fn printf(fmt: *byte, ...) i32;

export struct Box {
    buf: &[byte],
    len: usize,
}

fn check(data: &[byte]) bool {
    return data.len == 2 && data.ptr[0] == 65 as byte && data.ptr[1] == 66 as byte;
}

export fn main() i32 {
    var arr: [byte: 4] = [65, 66, 67, 68];
    var box: Box = Box{ buf: arr[0: 4], len: 2 };
    if !check(box.buf[0: box.len]) {
        printf("slice field reslice failed\n" as *byte);
        return 1;
    }
    return 0;
}
