// test_async_fd_substrate_boundary.uya - AsyncFd 底座 wait primitive 边界回归

use std.string.strlen;
use std.testing.assert_eq_i32;
use libc.syscall;

error AsyncFdBoundarySourceOpenFailed;
error AsyncFdBoundarySourceReadFailed;

const ASYNC_SOURCE_PATH: &const byte = "lib/std/async.uya\0" as &const byte;
const ASYNC_SOURCE_MAX: usize = 131072;

fn bytes_equal_at(hay: &const byte, hay_len: usize, start: usize, needle: &const byte, needle_len: usize) bool {
    if start + needle_len > hay_len {
        return false;
    }
    var i: usize = 0;
    while i < needle_len {
        if hay[start + i] != needle[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn source_contains(hay: &const byte, hay_len: usize, needle: &const byte, needle_len: usize) bool {
    if needle_len == 0 {
        return true;
    }
    if hay_len < needle_len {
        return false;
    }
    var i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal_at(hay, hay_len, i, needle, needle_len) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn source_contains_cstr(hay: &const byte, hay_len: usize, needle: &const byte) bool {
    return source_contains(hay, hay_len, needle, strlen(needle));
}

fn find_marker(hay: &const byte, hay_len: usize, needle: &const byte, needle_len: usize) usize {
    if needle_len == 0 {
        return 0;
    }
    if hay_len < needle_len {
        return hay_len + 1;
    }
    var i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal_at(hay, hay_len, i, needle, needle_len) {
            return i;
        }
        i = i + 1;
    }
    return hay_len + 1;
}

fn source_section_contains_cstr(hay: &const byte, hay_len: usize, start_marker: &const byte, end_marker: &const byte, needle: &const byte) bool {
    const start_len: usize = strlen(start_marker);
    const end_len: usize = strlen(end_marker);
    const start: usize = find_marker(hay, hay_len, start_marker, start_len);
    if start > hay_len {
        return false;
    }
    const body_start: usize = start + start_len;
    var body_end: usize = hay_len;
    if end_len > 0 {
        const end_rel: usize = find_marker(
            @ptr_from_usize(@usize_from_ptr(hay as &void) + body_start) as &const byte,
            hay_len - body_start,
            end_marker,
            end_len,
        );
        if end_rel <= hay_len - body_start {
            body_end = body_start + end_rel;
        }
    }
    return source_contains_cstr(@ptr_from_usize(@usize_from_ptr(hay as &void) + body_start) as &const byte, body_end - body_start, needle);
}

fn source_section_marker_order_cstr(hay: &const byte, hay_len: usize, start_marker: &const byte, end_marker: &const byte, first: &const byte, second: &const byte) bool {
    const start_len: usize = strlen(start_marker);
    const end_len: usize = strlen(end_marker);
    const start: usize = find_marker(hay, hay_len, start_marker, start_len);
    if start > hay_len {
        return false;
    }
    const body_start: usize = start + start_len;
    var body_end: usize = hay_len;
    if end_len > 0 {
        const end_rel: usize = find_marker(
            @ptr_from_usize(@usize_from_ptr(hay as &void) + body_start) as &const byte,
            hay_len - body_start,
            end_marker,
            end_len,
        );
        if end_rel <= hay_len - body_start {
            body_end = body_start + end_rel;
        }
    }
    const body: &const byte = @ptr_from_usize(@usize_from_ptr(hay as &void) + body_start) as &const byte;
    const body_len: usize = body_end - body_start;
    const first_pos: usize = find_marker(body, body_len, first, strlen(first));
    const second_pos: usize = find_marker(body, body_len, second, strlen(second));
    return first_pos <= body_len && second_pos <= body_len && first_pos < second_pos;
}

fn read_async_source(buf: &byte, cap: usize) !usize {
    const fd: i32 = sys_open(ASYNC_SOURCE_PATH, O_RDONLY as i32, 0) catch {
        return error.AsyncFdBoundarySourceOpenFailed;
    };
    const n: isize = sys_read(fd, buf as *byte, cap) catch {
        _ = sys_close(fd) catch {};
        return error.AsyncFdBoundarySourceReadFailed;
    };
    _ = sys_close(fd) catch {};
    if n < 0 {
        return error.AsyncFdBoundarySourceReadFailed;
    }
    return (n as! usize).value;
}

test "async_fd_runtime_substrate_boundary_keeps_only_wait_primitives_handwritten" {
    var src: [byte: ASYNC_SOURCE_MAX] = [0: ASYNC_SOURCE_MAX];
    const len: usize = try read_async_source(&src[0], ASYNC_SOURCE_MAX);

    try assert_eq_i32(source_contains_cstr(&src[0], len, "export fn async_wait_readable(fd: i32, deadline_ms: u64) Future<!usize> {\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "export fn async_wait_writable(fd: i32, deadline_ms: u64) Future<!usize> {\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "export @async_fn fn async_fd_read_future(fd: i32, buf: &byte, count: usize) Future<!usize> {\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "export @async_fn fn async_fd_write_future(fd: i32, data: &const byte, count: usize) Future<!usize> {\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncFdReadFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncFdWriteFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncFdReadLeafFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncFdWriteLeafFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "return async_fd_write_future(self.fd, data, count);\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "return async_fd_read_future(self.fd, buf, count);\0" as &const byte) as i32, 1);
}

test "async_fd_read_write_try_syscall_before_readiness_wait" {
    var src: [byte: ASYNC_SOURCE_MAX] = [0: ASYNC_SOURCE_MAX];
    const len: usize = try read_async_source(&src[0], ASYNC_SOURCE_MAX);
    const read_start: &const byte = "export @async_fn fn async_fd_read_deadline_future(fd: i32, buf: &byte, count: usize, deadline_ms: u64) Future<!usize> {\0" as &const byte;
    const read_end: &const byte = "export @async_fn fn async_fd_read_future(fd: i32, buf: &byte, count: usize) Future<!usize> {\0" as &const byte;
    const write_start: &const byte = "export @async_fn fn async_fd_write_deadline_future(fd: i32, data: &const byte, count: usize, deadline_ms: u64) Future<!usize> {\0" as &const byte;
    const write_end: &const byte = "export @async_fn fn async_fd_write_future(fd: i32, data: &const byte, count: usize) Future<!usize> {\0" as &const byte;

    try assert_eq_i32(source_contains_cstr(&src[0], len, "fn async_fd_read_try_step(fd: i32, buf: &byte, count: usize, out_n: &isize) !i32 {\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "fn async_fd_write_try_step(fd: i32, data: &const byte, count: usize, out_n: &isize) !i32 {\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, read_start, read_end, "interest: ASYNC_WAIT_INTEREST_NONE,\0" as &const byte) as i32, 1);
    try assert_eq_i32(source_section_contains_cstr(&src[0], len, write_start, write_end, "interest: ASYNC_WAIT_INTEREST_NONE,\0" as &const byte) as i32, 1);
    try assert_eq_i32(
        source_section_marker_order_cstr(
            &src[0],
            len,
            read_start,
            read_end,
            "const step: i32 = try async_fd_read_try_step(fd, buf, count, &n);\0" as &const byte,
            "const wait_readable_leaf: AsyncWaitFdFuture = AsyncWaitFdFuture{\0" as &const byte,
        ) as i32,
        1,
    );
    try assert_eq_i32(
        source_section_marker_order_cstr(
            &src[0],
            len,
            write_start,
            write_end,
            "const step: i32 = try async_fd_write_try_step(fd, data, count, &n);\0" as &const byte,
            "const wait_writable_leaf: AsyncWaitFdFuture = AsyncWaitFdFuture{\0" as &const byte,
        ) as i32,
        1,
    );
}

test "async_writev_boundary_uses_async_fn_and_wait_substrate" {
    var src: [byte: ASYNC_SOURCE_MAX] = [0: ASYNC_SOURCE_MAX];
    const len: usize = try read_async_source(&src[0], ASYNC_SOURCE_MAX);
    const writev_start: &const byte = "export @async_fn fn async_writev(fd: i32, head: &const byte, head_len: usize, body: &const byte, body_len: usize) Future<!usize> {\0" as &const byte;
    const writev_end: &const byte = "export @async_fn fn async_sendfile(fd: i32, file_fd: i32, total_len: usize) Future<!usize> {\0" as &const byte;

    try assert_eq_i32(source_contains_cstr(&src[0], len, writev_start) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncWritevFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(
        source_section_contains_cstr(
            &src[0],
            len,
            writev_start,
            writev_end,
            "const wait_writable_result: !usize = @await async_wait_writable(fd, 0 as u64);\0" as &const byte,
        ) as i32,
        1,
    );
}

test "async_sendfile_boundary_uses_async_fn_and_wait_substrate" {
    var src: [byte: ASYNC_SOURCE_MAX] = [0: ASYNC_SOURCE_MAX];
    const len: usize = try read_async_source(&src[0], ASYNC_SOURCE_MAX);
    const sendfile_start: &const byte = "export @async_fn fn async_sendfile(fd: i32, file_fd: i32, total_len: usize) Future<!usize> {\0" as &const byte;
    const sendfile_end: &const byte = "export @async_fn fn async_connect(fd: i32, addr: &void, addr_len: u32, deadline_ms: u64) Future<!i32> {\0" as &const byte;

    try assert_eq_i32(source_contains_cstr(&src[0], len, sendfile_start) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncSendFileFuture : Future<!usize>\0" as &const byte) as i32, 0);
    try assert_eq_i32(
        source_section_contains_cstr(
            &src[0],
            len,
            sendfile_start,
            sendfile_end,
            "const wait_writable_result: !usize = @await async_wait_writable(fd, 0 as u64);\0" as &const byte,
        ) as i32,
        1,
    );
}

test "async_connect_boundary_uses_async_fn_and_wait_substrate" {
    var src: [byte: ASYNC_SOURCE_MAX] = [0: ASYNC_SOURCE_MAX];
    const len: usize = try read_async_source(&src[0], ASYNC_SOURCE_MAX);
    const connect_start: &const byte = "export @async_fn fn async_connect(fd: i32, addr: &void, addr_len: u32, deadline_ms: u64) Future<!i32> {\0" as &const byte;
    const connect_end: &const byte = "export fn async_accept(listen_fd: i32) Future<!i32> {\0" as &const byte;

    try assert_eq_i32(source_contains_cstr(&src[0], len, connect_start) as i32, 1);
    try assert_eq_i32(source_contains_cstr(&src[0], len, "struct AsyncConnectFuture : Future<!i32>\0" as &const byte) as i32, 0);
    try assert_eq_i32(
        source_section_contains_cstr(
            &src[0],
            len,
            connect_start,
            connect_end,
            "const wait_writable_result: !usize = @await async_wait_writable(fd, deadline_ms);\0" as &const byte,
        ) as i32,
        1,
    );
}

