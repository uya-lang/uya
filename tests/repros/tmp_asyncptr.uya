use std.async;
use std.testing.assert_eq_i32;

struct Big { a: [i32: 4], b: [i32: 4], n: i32 }

@async_fn fn writer(out: &Big, r: &MemAsyncReader, buf: &byte) Future<!i32> {
    @print("[IN] p=");
    @print(@usize_from_ptr(out as &void) as i32);
    @print("\n");
    out.n = 77;
    out.a[0] = 5;
    _ = try @await r.read(buf, 1);
    return 0;
}

@async_fn fn driver(b: &Big, r: &MemAsyncReader, buf: &byte) Future<!i32> {
    @print("[OUT] p=");
    @print(@usize_from_ptr(b as &void) as i32);
    @print("\n");
    _ = try @await writer(b, r, buf);
    return 0;
}

test "async fn pointer arg identity" {
    var b: Big = Big{ a: [0:4], b: [0:4], n: 0 };
    var src: [byte: 2] = [65, 0];
    var rd: MemAsyncReader = mem_async_reader_new(&src[0] as &byte, 2);
    var sink: [byte: 4] = [];
    const f: Future<!i32> = driver(&b, &rd, &sink[0] as &byte);
    const res: !i32 = block_on<i32>(f);
    const v: i32 = res catch { -1; };
    try assert_eq_i32(b.n, 77);
    try assert_eq_i32(b.a[0], 5);
}
