// 回归：exec VM 里，`@async_fn` 的「聚合结构体指针」实参在**真实挂起**之后
// 就与调用方不再是同一块内存，写进去的内容调用方看不到。
//
// 这是 `test_http_uyagin` 最后一个用例
// （`uyagin_serve_conn_releases_scheduler_frames_after_connection_close`）
// 返回 404 的根因最小复现：`uyagin_conn_read_parse_into_future` 把解析结果写进
// `out.request.path_len`，函数内部读是对的（5），但返回后调用方读到的还是 0，
// 于是路由匹配拿不到 `/ping`，走了 404 分支。
//
// 关键触发条件：**必须有一次真正让出的事件循环等待**。
// 用 `MemAsyncReader`（数据已就绪、同步完成）测不出来，用 pipe + epoll
// 让 future 真挂起一次就必现。
//
// 实测对照：
//     C99 : same=1  v=22            （指针相同，写入可见）
//     VM  : same=0  v=-1            （指针不同，写入丢失）
//
// 注意：本文件在 VM 下失败是**预期的**——它是哨兵，不参与 `make check`。
use std.async;
use std.async_scheduler;
use libc.sys_pipe2;
use libc.sys_write;
use libc.sys_close;
use libc.O_NONBLOCK;
use libc.O_CLOEXEC;
use std.testing.assert_eq_i32;

struct Req { path_len: i32, pad: [i64: 32] }
struct PR { request: Req, consumed: usize }
struct St {
    io_buf: [byte: 4096] = [],
    parse_result: PR,
    filled: usize = 0,
}

var g_in: usize = 0;
var g_out: usize = 0;

@async_fn fn read_parse(fd: i32, out: &PR, filled: &usize) Future<!i32> {
    var buf: [byte: 64] = [];
    const rd: usize = try @await async_fd_read_future(fd, &buf[0] as &byte, 64 as usize);
    *filled = rd;
    const q: &Req = &out.request;
    q.path_len = 5;
    out.consumed = rd;
    g_in = @usize_from_ptr(out as &void);
    return rd as i32;
}

@async_fn fn slot(st: &St, fd: i32) Future<!i32> {
    const n: i32 = try @await read_parse(fd, &st.parse_result, &st.filled);
    g_out = @usize_from_ptr(&st.parse_result as &void);
    return n;
}

@async_fn fn serve(fd: i32) Future<!i32> {
    var state: St = St{ io_buf: [0:4096], parse_result: PR{ request: Req{ path_len: 0, pad: [0:32] }, consumed: 0 }, filled: 0 };
    const n: i32 = try @await slot(&state, fd);
    if state.parse_result.request.path_len != 5 {
        return 0 - 1;
    }
    return n;
}

test "pipe driven parse into local aggregate" {
    var fds: [i32: 2] = [0 - 1, 0 - 1];
    _ = try sys_pipe2(&fds[0], O_NONBLOCK | O_CLOEXEC);
    const rd_fd: i32 = fds[0];
    const wr_fd: i32 = fds[1];
    const payload: &[const byte] = "GET /ping HTTP/1.1\r\n\r\n";
    _ = try sys_write(wr_fd, payload.ptr, payload.len);
    const scheduler: Scheduler = scheduler_new();
    const f: Future<!i32> = serve(rd_fd);
    const v: i32 = try scheduler_run<!i32>(&scheduler, f);
    _ = sys_close(rd_fd) catch {};
    _ = sys_close(wr_fd) catch {};
    const same: i32 = if g_in == g_out { 1 } else { 0 };
    @print("[P] same="); @print(same); @print(" v="); @print(v); @print("\n");
    try assert_eq_i32(same, 1);
    try assert_eq_i32(v, 22);
}
