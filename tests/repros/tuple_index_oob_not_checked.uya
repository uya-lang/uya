// 复现：元组下标（t.N）越界不做检查，落成引用不存在字段的 C 代码
//
// 状态（2026-10-12）：**已修复**。本文件现在在 checker 阶段报
// 「元组下标越界（.0/.1/... 必须在元组元素个数内）」，不再落到 C 编译器。
//
// 现象：checker 里存在「元组下标越界（.0/.1/... 必须在元组元素个数内）」
//       诊断（src/checker/check_call.uya:2679），但该分支在常量元组上不可达：
//
//   const t: (i32, i32, i32) = (1, 2, 3);
//   return t.2;    // 合法 ✓
//   return t.3;    // 越界，应报「元组下标越界」，修复前静默通过 ✗
//
// 后果（修复前）：生成的 C 是
//   struct { int32_t f0; int32_t f1; int32_t f2; } t = {...};
//   int32_t _uya_ret = t.f3;            // ← 编译 C 时 'struct <anonymous>' has no member named 'f3'
// 也就是错误被推迟到 C 编译器，诊断可读性差且位置失真（指向生成的 .c 而不是 .uya）。
//
// 根因：越界只出现在 `checker_check_member_access`（check_call.uya）里，
//       而 `return t.3` / `t.3 as i32` / 条件位置都只走 `infer_member_access`
//       （check_expr.uya），那里越界时静默返回 void。
//
// 修复：`infer_member_access` 的元组分支在越界处直接报同一条诊断
//      （重复报告由 checker_should_suppress_duplicate_error 去重）。
//
// 回归用例：tests/error_tuple_index_oob.uya（负例，含 return / cast / 条件三种位置）
//          以及 tests/test_return_expr_bounds.uya 的 `tuple ok`（正例，合法 .1 仍放行）
//
// 复现命令：
//   ./bin/uya build --safety-proof tests/repros/tuple_index_oob_not_checked.uya -o /tmp/tuple_oob
//   # 期望：checker 阶段报「元组下标越界」

export fn main() i32 {
    const triple: (i32, i32, i32) = (1, 2, 3);

    // 下标合法范围是 .0 / .1 / .2
    return triple.3;
}
