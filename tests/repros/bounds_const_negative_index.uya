// 复现：常量下标等于 -1 时边界检查整体失灵（-1 兼作「非常量」哨兵）
//
// 状态（2026-10-12）：**已修复**。本文件现在报
// 「数组索引越界：索引不能为负数」，不再静默生成 `a[(-1)]`。
//
// 根因：`checker_eval_const_expr()`（src/checker/proof.uya）用返回值 **-1**
//       同时表示「非常量表达式」与「常量 -1」。两个调用点
//       （src/checker/check_expr_extra.uya:80、src/checker/check_expr.uya:4051）
//       都写成 `if index_val >= 0 { 常量越界检查 } else { 变量证明 }`，
//       于是**常量 -1 掉进「变量」分支**：那里它既不是合法线性表达式、
//       也不是有效区间，证明静默失败但不报错，直接放行。
//
// 修复：常量求值改为「成功标志 + 值」双返回（`checker_eval_const_expr_ex`），
//       `-1` 不再兼作失败哨兵；数组下标（含指针的已知长度下标）、
//       `for` 范围端点、区间提取、codegen 的常量折叠等调用点全部改看成功标志。
//
// 影响范围不止数组下标（见同级其它 repro），因为 `-1` 是常量求值的通用
// 失败标记：只要常量折叠的中间结果等于 -1，该处检查就会跳过 ——
// 例如 `2147483647 - (0 - 1)`（减法上溢）同样静默通过，现在也会报
// 「常量表达式溢出: 减法结果超出 i32 范围」。
//
// 对照（同样的越界，值不是 -1 时一直正常报错）：
//   const a: [i32: 3] = [1,2,3];
//   a[3]     // 报「数组索引越界：常量索引超出数组边界」 ✓
//   a[-1]    // 修复前静默通过；修复后报「索引不能为负数」     ✓
//
// 复现命令：
//   ./bin/uya build --safety-proof tests/repros/bounds_const_negative_index.uya -o /tmp/neg_idx
//   # 期望：编译失败（修复前：编译通过并读到越界元素）
// 回归用例：
//   tests/error_array_bounds_const_negative_index.uya（负例）
//   tests/test_bounds_const_negative_index.uya（正例，防止收紧到误报）

export fn main() i32 {
    const a: [i32: 3] = [1, 2, 3];

    // 常量负下标：检查必须报「索引不能为负数」，实际静默通过
    return a[0 - 1];
}
