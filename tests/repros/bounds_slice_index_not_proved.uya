// 复现：切片（&[T]）下标完全不做边界证明，且切片范围越界不检查
//
// 状态（2026-10-11）：**未修复**。本文件在当前编译器下**编译通过**，
// 运行期越界读，是真实的 UB 漏检。
//
// 两处缺口：
//   1. `&[T]` 切片元素访问（`s[i]`）不走任何边界证明 ——
//      对照数组 `[T: N]` 的同形访问会报「数组索引安全证明失败」；
//   2. 切片范围表达式 `&a[start:len]` 的 `len` 不校验是否超出底层数组 ——
//      `&buf[0:99]`（底层只 4 个元素）静默通过。
//
// 源码依据：`checker_check_array_access` 的 TYPE_SLICE 分支
// （src/checker/check_expr_extra.uya:62）只做元素类型推断，
// 不进入 TYPE_ARRAY 分支里的证明逻辑。
//
// 对照（数组形态会正确报错）：
//   fn read_array_at(i: i32) i32 {
//       var a: [i32: 4] = [1, 2, 3, 4];
//       return a[i];                    // 报「数组索引安全证明失败」 ✓
//   }
//
// 复现命令：
//   ./bin/uya build --safety-proof tests/repros/bounds_slice_index_not_proved.uya -o /tmp/slice_oob
//   /tmp/slice_oob; echo $?    # 期望编译失败；实际编译通过并越界读

const OOB_INDEX: i32 = 99;

// 缺口 1：切片形参 + 未证明的下标
fn read_at(s: &[i32], i: i32) i32 {
    return s[i];
}

// 缺口 1 的写形态：切片元素赋值同样没有任何边界证明
fn write_at(s: &[i32], i: i32) i32 {
    s[i] = 42;
    return s[i];
}

export fn main() i32 {
    var buf: [i32: 4] = [7, 8, 9, 10];

    // 缺口 2：切片长度 99 超出底层数组的 4 个元素，应报错
    const wide: &[i32] = &buf[0:99];

    // 缺口 1：i 没有任何约束，切片读写都应报错
    const read_out: i32 = read_at(&buf[0:4], OOB_INDEX);
    const write_out: i32 = write_at(wide, OOB_INDEX);

    return read_out + write_out;
}
