use std.async;
use std.testing.assert_eq_i32;

struct Req {
    path: [byte: 1024],
    path_len: i32,
    method: i32,
    header_count: i32,
    body_off: i32,
}
struct PR { request: Req, consumed: usize }
struct Conn { io_buf: [byte: 4096], parse_result: PR, filled: usize, n: i32 }

@async_fn fn writer(out: &PR, r: &MemAsyncReader, buf: &byte) Future<!i32> {
    @print("[IN] outp=");
    @print(@usize_from_ptr(out as &void) as i32);
    @print(" reqp=");
    @print(@usize_from_ptr(&out.request as &void) as i32);
    @print("\n");
    out.request.path_len = 5;
    out.request.method = 3;
    out.consumed = 58 as usize;
    _ = try @await r.read(buf, 1);
    return 0;
}

@async_fn fn driver(cs: &Conn, r: &MemAsyncReader, buf: &byte) Future<!i32> {
    @print("[OUT] prp=");
    @print(@usize_from_ptr(&cs.parse_result as &void) as i32);
    @print(" reqp=");
    @print(@usize_from_ptr(&cs.parse_result.request as &void) as i32);
    @print("\n");
    _ = try @await writer(&cs.parse_result, r, buf);
    const bl: i32 = cs.parse_result.request.path_len;
    const bc: i32 = cs.parse_result.consumed as i32;
    @print("[BACK] plen=");
    @print(bl);
    @print(" consumed=");
    @print(bc);
    @print("\n");
    return 0;
}

test "large nested struct through async fn" {
    var cs: Conn = Conn{ io_buf: [0:4096], parse_result: PR{ request: Req{ path: [0:1024], path_len: 0, method: 0, header_count: 0, body_off: 0 }, consumed: 0 }, filled: 0, n: 0 };
    var src: [byte: 2] = [65, 0];
    var rd: MemAsyncReader = mem_async_reader_new(&src[0] as &byte, 2);
    var sink: [byte: 4] = [];
    const f: Future<!i32> = driver(&cs, &rd, &sink[0] as &byte);
    const res: !i32 = block_on<i32>(f);
    const v: i32 = res catch { -1; };
    try assert_eq_i32(cs.parse_result.request.path_len, 5);
    try assert_eq_i32(cs.parse_result.request.method, 3);
    try assert_eq_i32(cs.parse_result.consumed as i32, 58);
}
