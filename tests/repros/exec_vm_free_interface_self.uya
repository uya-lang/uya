// 在接口方法里 `free(self as &void)`：VM 把 `self`（接口接收者）的
// `ptr_value` 当作宿主堆地址交给 `free`，于是堆块头被写坏；之后的
// `malloc` 在 `lib/libc/heap.uya:221 get_size` 处报
// `LOAD_FIELD 字段越界(idx=1 kind=14 count=-1 pointee=16 ref=1 aux=65552 tgt=0 res=1)`。
//
// 这是 `test_typed_pipeline_capability` 的根因形态：
// `PipelineErasedStageBox.drop_erased` 里写着 `free(self as &void)`
//（先 `free(self.owned_value)`、再 `free(self)`），
// 而 `stage<T>` 会 `pipeline_drop` → `drop_erased()`。
// 实测「先 stage + drop、再 stage」必然失败；去掉 drop、或单独跑，都能通过。
//
// 本文件放在 tests/repros/ 下，不参与 `make check`。
use libc.malloc;
use libc.free;
use std.testing.assert_eq_i32;

interface Ops {
    fn kill(self: &Self) void;
}

struct Holder : Ops {
    fn kill(self: &Self) void {
        free(self as &void);
    }
}

test "free interface self keeps heap healthy" {
    const holder_raw: &void = malloc(64);
    if holder_raw == null {
        try assert_eq_i32(0, 1);
        return;
    }
    const holder: &Holder = holder_raw as &Holder;
    const ops: Ops = *holder;
    ops.kill();
    // 堆若被写坏，这一次 malloc 就会在 get_size 处崩
    const again: &void = malloc(32);
    if again == null {
        try assert_eq_i32(0, 2);
        return;
    }
    free(again);
    try assert_eq_i32(1, 1);
}
