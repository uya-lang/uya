// int_limit_i8_nested.uya - 最小复现：@max/@min 小整型与嵌套实参发射成 0（修复用）
//
// 见 buglist「编译器 bug」P2 条与 tests/test_int_limit_i8_nested.uya 头注释。
// 修复前（v0.10.4，2026-10-19 实测）：
//   ① `const a8: i8 = @max;` → 生成 C 是 `const int8_t a8 = 0;`，运行输出 0；
//   ② `id_int(id_int(@max))` → 内层 @max 发射成 0，运行输出 0。
// （直接实参 `id_int(@max)` 在 0.10.4 已正常 —— strict-overflow 门修它时顺带
//  解决；嵌套与小整型是漏网的两条。）
// 修复后：都输出正确极值（127 / 2147483647 / 2147483647）。
//
// 第三形态（随后补修）：三层及以上嵌套、以及 `if f(@max) != x` 这种只走
// checker_infer_type 的上下文，曾把最内层 @max 发射成字面 0
// （生成 C 是 `id_int(id_int(id_int(0)))`）。根因见 tests/test_int_limit_i8_nested.uya
// 头注释的「第三形态」一节。

fn id_int(a: i32) i32 { return a; }

fn main() i32 {
    const a8: i8 = @max;
    const d: i32 = id_int(id_int(@max));
    // 三层嵌套（修复前发射成 0）
    const t3: i32 = id_int(id_int(id_int(@max)));
    // 推断路径：if 条件里的调用（修复前连一层都发射成 0）
    var if_ok: i32 = 0;
    if id_int(id_int(id_int(@max))) == 2147483647 {
        if_ok = 1;
    }
    @println(a8 as i32);
    @println(d);
    @println(t3);
    @println(if_ok);
    return 0;
}
