// test_asm_memory_clobber_flag.uya - @asm 的 clobbers=["memory"] 必须被 checker 认可
//
// parser 把 "memory" 记进 asm_clobbers_memory 标志（src/parser/primary.uya），
// codegen 也读它（src/codegen/c99/expr.uya），但 checker 只在 asm_clobbers[]
// 列表里搜 "memory"（src/checker/check_expr.uya），has_memory_clobber 永远为 0
// —— 含 mfence/lfence/sfence 的块即使写了 clobbers = ["memory"] 仍报
// 「内存屏障指令需要声明 clobbers = ["memory"]」（buglist P2，2026-10-19 核对）。
//
// 修复：checker 同时读取 asm_clobbers_memory 标志（双侧口径一致）。
//
// 预期：编译成功、可运行，返回 0。
// 同族负例（对应 buglist「内存屏障必报错」的旧行为）见
// tests/repros/asm_memory_clobber_flag.uya —— 修复前的编译器在它上面报错。
//
// 屏障助记符按目标架构选：x86_64 用 mfence，arm64 用 dmb ish（checker 的
// requires_memory_barrier 同时认这两族）。硬写 mfence 会让 macOS arm64 的
// hosted 用例在 C 阶段被 clang 判成 unrecognized instruction mnemonic。
//
// 屏障指令本身不写 x，这里把 x 作为只读输入操作数 (x)，这样 x 的初值 0 会被
// 真正加载且 asm 之后仍是 0；若写成只写输出 (-> x)，编译器会认为 x 在 asm
// 之后才被定义，arm64 上该输出寄存器没有确定值，测试会误判为返回 1。

use std;

fn main() i32 {
    var x: i32 = 0;
    std.cfg(std.target_arch == .ta_arm64, {
        @asm {
            "dmb ish" (x);
        } clobbers = ["memory"];
    }, std.cfg(std.target_arch == .ta_x86_64, {
        @asm {
            "mfence" (x);
        } clobbers = ["memory"];
    }, {
        // 其余目标架构没有统一屏障助记符，只验证 clobbers=["memory"] 标志本身被接受。
        @asm {
            "nop" (x);
        } clobbers = ["memory"];
    }))
    if x == 0 {
        return 0;
    }
    return 1;
}
