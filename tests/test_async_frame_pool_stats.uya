// test_async_frame_pool_stats.uya
// 验证 AsyncFramePool 的统计字段在分配、释放、pool 满 fallback 时正确更新

use std.async_frame.AsyncFramePool;
use std.async_frame.AsyncFramePoolConfig;
use std.async_frame.async_frame_pool_init;
use std.async_frame.async_frame_pool_init_with_config;
use std.async_frame.async_frame_pool_init_with_buffer;
use std.async_frame.async_frame_pool_alloc_aligned;
use std.async_frame.async_frame_pool_free_aligned;
use std.async_frame.async_frame_pool_stats;
use std.async_frame.async_frame_pool_reset;
use std.testing.expect;
use std.testing.run_test;
use std.async;

@async_fn
fn dummy_async() Future<!i32> {
    return 1;
}

fn test_pool_stats() !void {
    // 强制生成 async frame descriptor 表
    const _f: Future<!i32> = dummy_async();
    _ = _f;

    var pool: AsyncFramePool = AsyncFramePool{};
    // 开启 debug heap fallback；动态 pool 不应再靠超过 4096 后 fallback 才能继续。
    async_frame_pool_init(&pool, 1, 65536);

    const alloc_count: i32 = 4096 + 3;  // 超过单桶容量 4096

    var i: i32 = 0;
    while i < alloc_count {
        const ptr: &byte = async_frame_pool_alloc_aligned(&pool, 64, 8);
        if ptr == null {
            break;
        }
        // 立即释放，避免数组存储带来的证明负担
        async_frame_pool_free_aligned(&pool, ptr, 64, 8);
        i = i + 1;
    }

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);

    // 超过旧单桶容量后仍应全部由 pool 计数，不触发 full 或 debug fallback。
    try expect(total_alloc == alloc_count);
    try expect(full_count == 0);
    try expect(heap_fallback == 0);
    // 释放次数应该等于分配次数（立即释放路径）
    try expect(total_free == total_alloc);
}

fn ptr_in_range(base: &byte, size: usize, ptr: &byte) bool {
    if base == null || ptr == null || size == 0 {
        return false;
    }
    const base_addr: usize = @usize_from_ptr(base as &void);
    const ptr_addr: usize = @usize_from_ptr(ptr as &void);
    return ptr_addr >= base_addr && ptr_addr < base_addr + size;
}

fn test_pool_buffer_prefers_stack_and_large_heap() !void {
    var storage: [byte: 256] = [];
    var pool: AsyncFramePool = AsyncFramePool{};
    async_frame_pool_init_with_buffer(&pool, &storage[0] as &byte, 256usize, 1, 64usize);

    const small_ptr: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);
    try expect(small_ptr != null);
    try expect(ptr_in_range(&storage[0] as &byte, 256usize, small_ptr));

    const large_ptr: &byte = async_frame_pool_alloc_aligned(&pool, 96usize, 8usize);
    try expect(large_ptr != null);
    try expect(!ptr_in_range(&storage[0] as &byte, 256usize, large_ptr));

    async_frame_pool_free_aligned(&pool, small_ptr, 32usize, 8usize);
    async_frame_pool_free_aligned(&pool, large_ptr, 96usize, 8usize);

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc >= 1);
    try expect(total_free >= 1);
    try expect(heap_fallback >= 1);
}

fn test_pool_config_initial_capacity_can_grow() !void {
    var storage: [byte: 256] = [];
    var pool: AsyncFramePool = AsyncFramePool{};
    var config: AsyncFramePoolConfig = AsyncFramePoolConfig{};
    config.max_buckets = 1;
    config.max_per_bucket = 2;
    config.debug_heap_fallback = 0;
    config.stack_limit = 65536usize;
    async_frame_pool_init_with_config(&pool, &config);
    pool.buffer = &storage[0] as &byte;
    pool.buffer_size = 256usize;
    pool.buffer_used = 0usize;

    const first: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);
    const second: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);
    const third: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);

    try expect(first != null);
    try expect(second != null);
    try expect(third != null);

    async_frame_pool_free_aligned(&pool, first, 32usize, 8usize);
    async_frame_pool_free_aligned(&pool, second, 32usize, 8usize);
    async_frame_pool_free_aligned(&pool, third, 32usize, 8usize);

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc == 3);
    try expect(total_free == 3);
    try expect(full_count == 0);
    try expect(heap_fallback == 0);
}

fn test_pool_config_allows_more_than_default_buckets() !void {
    var pool: AsyncFramePool = AsyncFramePool{};
    var config: AsyncFramePoolConfig = AsyncFramePoolConfig{};
    config.max_buckets = 130;
    config.max_per_bucket = 1;
    config.debug_heap_fallback = 1;
    config.stack_limit = 65536usize;
    async_frame_pool_init_with_config(&pool, &config);

    var i: i32 = 0;
    while i < 130 {
        const size: usize = (i as usize) + 1usize;
        const ptr: &byte = async_frame_pool_alloc_aligned(&pool, size, 8usize);
        try expect(ptr != null);
        async_frame_pool_free_aligned(&pool, ptr, size, 8usize);
        i = i + 1;
    }

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc == 130);
    try expect(total_free == 130);
    try expect(full_count == 0);
}

fn test_pool_config_allows_more_than_default_per_bucket() !void {
    var storage: [byte: 131072] = [];
    var pool: AsyncFramePool = AsyncFramePool{};
    var config: AsyncFramePoolConfig = AsyncFramePoolConfig{};
    config.max_buckets = 1;
    config.max_per_bucket = 4097;
    config.debug_heap_fallback = 0;
    config.stack_limit = 65536usize;
    async_frame_pool_init_with_config(&pool, &config);
    pool.buffer = &storage[0] as &byte;
    pool.buffer_size = 131072usize;
    pool.buffer_used = 0usize;

    var i: i32 = 0;
    while i < 4097 {
        const ptr: &byte = async_frame_pool_alloc_aligned(&pool, 1usize, 1usize);
        try expect(ptr != null);
        i = i + 1;
    }

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc == 4097);
    try expect(full_count == 0);
    try expect(heap_fallback == 0);
}

fn test_pool_reset_discards_old_caller_buffer_frame() !void {
    var storage: [byte: 128] = [];
    var pool: AsyncFramePool = AsyncFramePool{};
    async_frame_pool_init_with_buffer(&pool, &storage[0] as &byte, 128usize, 0, 65536usize);

    const ptr: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);
    try expect(ptr != null);

    async_frame_pool_reset(&pool);
    async_frame_pool_free_aligned(&pool, ptr, 32usize, 8usize);

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc == 0);
    try expect(total_free == 0);
    try expect(pool.buffer_used == 0usize);
    try expect(heap_fallback == 0);
}

fn test_pool_reset_discards_old_pool_heap_frame() !void {
    var pool: AsyncFramePool = AsyncFramePool{};
    async_frame_pool_init(&pool, 0, 65536usize);

    const ptr: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);
    try expect(ptr != null);

    async_frame_pool_reset(&pool);
    async_frame_pool_free_aligned(&pool, ptr, 32usize, 8usize);

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc == 0);
    try expect(total_free == 0);
    try expect(full_count == 0);
    try expect(heap_fallback == 0);
}

fn test_debug_heap_fallback_free_bypasses_pool_reuse() !void {
    var storage: [byte: 64] = [];
    var pool: AsyncFramePool = AsyncFramePool{};
    async_frame_pool_init_with_buffer(&pool, &storage[0] as &byte, 64usize, 1, 16usize);

    const ptr: &byte = async_frame_pool_alloc_aligned(&pool, 32usize, 8usize);
    try expect(ptr != null);

    async_frame_pool_free_aligned(&pool, ptr, 32usize, 8usize);

    var total_alloc: i32 = 0;
    var total_free: i32 = 0;
    var full_count: i32 = 0;
    var heap_fallback: i32 = 0;
    async_frame_pool_stats(&pool, &total_alloc, &total_free, &full_count, &heap_fallback);
    try expect(total_alloc == 0);
    try expect(total_free == 0);
    try expect(full_count == 0);
    try expect(heap_fallback == 1);
}

test "async_frame_pool_stats" {
    run_test("async_frame_pool_stats", test_pool_stats);
}

test "async_frame_pool_buffer_prefers_stack_and_large_heap" {
    run_test("async_frame_pool_buffer_prefers_stack_and_large_heap", test_pool_buffer_prefers_stack_and_large_heap);
}

test "async_frame_pool_config_initial_capacity_can_grow" {
    run_test("async_frame_pool_config_initial_capacity_can_grow", test_pool_config_initial_capacity_can_grow);
}

test "async_frame_pool_config_allows_more_than_default_buckets" {
    run_test("async_frame_pool_config_allows_more_than_default_buckets", test_pool_config_allows_more_than_default_buckets);
}

test "async_frame_pool_config_allows_more_than_default_per_bucket" {
    run_test("async_frame_pool_config_allows_more_than_default_per_bucket", test_pool_config_allows_more_than_default_per_bucket);
}

test "async_frame_pool_reset_discards_old_caller_buffer_frame" {
    run_test("async_frame_pool_reset_discards_old_caller_buffer_frame", test_pool_reset_discards_old_caller_buffer_frame);
}

test "async_frame_pool_reset_discards_old_pool_heap_frame" {
    run_test("async_frame_pool_reset_discards_old_pool_heap_frame", test_pool_reset_discards_old_pool_heap_frame);
}

test "async_frame_pool_debug_heap_fallback_free_bypasses_pool_reuse" {
    run_test("async_frame_pool_debug_heap_fallback_free_bypasses_pool_reuse", test_debug_heap_fallback_free_bypasses_pool_reuse);
}
