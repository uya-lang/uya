// test_crypto_sha512.uya — SHA-512 与 HMAC-SHA512 向量
//
// SHA-512 向量取自 FIPS 180-4 附录 C（含 896 位边界与 10^6 字节长消息）；
// HMAC 向量取自 RFC 4231 §4 全部 7 条（含超 128 字节密钥的"先哈希"路径）。

use std.crypto.sha512;
use std.crypto.sha512.Sha512Ctx;
use std.crypto.sha512.HmacSha512Ctx;
use std.testing.assert_eq_i32;

/// 把 64 字节摘要与 128 字符 hex 逐字节比对。
/// 参数：digest 为摘要，expect_ascii 为小写 hex 期望值。
/// 返回值：一致返回 true。
fn hex_eq(digest: &[byte], expect_ascii: &[byte]) bool {
    const hex: &[byte] = &"0123456789abcdef"[0: 16];
    var i: usize = 0;
    while i < 64 {
        const hi: usize = (digest.ptr[i] >> 4) as usize;
        const lo: usize = (digest.ptr[i] & 15) as usize;
        if expect_ascii.ptr[i * 2] != hex.ptr[hi] {
            return false;
        }
        if expect_ascii.ptr[i * 2 + 1] != hex.ptr[lo] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

test "sha512_empty" {
    var d: [byte: 64] = [];
    const empty: &[byte] = &""[0: 0];
    sha512_digest(empty, d[0: 64]);
    const exp: &[byte] = &"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"[0: 128];
    if !hex_eq(d[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "sha512_abc" {
    var d: [byte: 64] = [];
    const data: &[byte] = &"abc"[0: 3];
    sha512_digest(data, d[0: 64]);
    const exp: &[byte] = &"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"[0: 128];
    if !hex_eq(d[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "sha512_fips_c1_two_block" {
    // FIPS 180-4 C.1：112 字节，恰好落在 128 字节块的填充边界前
    var d: [byte: 64] = [];
    const data: &[byte] = &"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"[0: 112];
    sha512_digest(data, d[0: 64]);
    const exp: &[byte] = &"8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"[0: 128];
    if !hex_eq(d[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "sha512_fips_c2_million_a" {
    // FIPS 180-4 C.2：10^6 个 'a'，覆盖多块流式更新
    var d: [byte: 64] = [];
    var block: [byte: 1000] = [];
    var i: usize = 0;
    while i < 1000 {
        block[i] = 97 as byte;
        i = i + 1;
    }
    var ctx: Sha512Ctx = Sha512Ctx{};
    ctx.init();
    var n: usize = 0;
    while n < 1000 {
        ctx.update(block[0: 1000]);
        n = n + 1;
    }
    ctx.final(d[0: 64]);
    const exp: &[byte] = &"e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b"[0: 128];
    if !hex_eq(d[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

/// 用流式接口逐字节喂入，验证与一次性结果一致（覆盖 buf 拼接与跨块边界）。
/// 参数：n 为消息长度（内容全为 'a'），expect_hex 为期望摘要。
/// 返回值：无。
fn check_bytewise(n: usize, expect_hex: &[byte]) !void {
    var d: [byte: 64] = [];
    var ctx: Sha512Ctx = Sha512Ctx{};
    ctx.init();
    var one: [byte: 1] = [97];
    var i: usize = 0;
    while i < n {
        ctx.update(one[0: 1]);
        i = i + 1;
    }
    ctx.final(d[0: 64]);
    if !hex_eq(d[0: 64], expect_hex) {
        try assert_eq_i32(0, 1);
    }
}

test "sha512_padding_boundaries_bytewise" {
    _ = check_bytewise(111, &"fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2"[0: 128]);
    _ = check_bytewise(112, &"c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca"[0: 128]);
    _ = check_bytewise(127, &"828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502"[0: 128]);
    _ = check_bytewise(128, &"b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321"[0: 128]);
}

test "sha512_split_update_matches_oneshot" {
    // 同一消息分三段喂入（跨 128 字节块边界），结果须与一次性一致
    var whole: [byte: 300] = [];
    var i: usize = 0;
    while i < 300 {
        whole[i] = ((i % (251 as usize)) as byte);
        i = i + 1;
    }
    var a: [byte: 64] = [];
    sha512_digest(whole[0: 300], a[0: 64]);
    var b: [byte: 64] = [];
    var ctx: Sha512Ctx = Sha512Ctx{};
    ctx.init();
    ctx.update(whole[0: 7]);
    ctx.update(whole[7: 123]);
    ctx.update(whole[130: 170]);
    ctx.final(b[0: 64]);
    var k: usize = 0;
    while k < 64 {
        try assert_eq_i32(a[k] as i32, b[k] as i32);
        k = k + 1;
    }
}

test "hmac_sha512_rfc4231_1_20byte_key" {
    var out: [byte: 64] = [];
    var key: [byte: 20] = [];
    var i: usize = 0;
    while i < 20 {
        key[i] = 0x0b as byte;
        i = i + 1;
    }
    const msg: &[byte] = &"Hi There"[0: 8];
    hmac_sha512(key[0: 20], msg, out[0: 64]);
    const exp: &[byte] = &"87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"[0: 128];
    if !hex_eq(out[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "hmac_sha512_rfc4231_2_short_key" {
    var out: [byte: 64] = [];
    const key: &[byte] = &"Jefe"[0: 4];
    const msg: &[byte] = &"what do ya want for nothing?"[0: 28];
    hmac_sha512(key, msg, out[0: 64]);
    const exp: &[byte] = &"164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"[0: 128];
    if !hex_eq(out[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "hmac_sha512_rfc4231_3_100byte_msg" {
    var out: [byte: 64] = [];
    var key: [byte: 20] = [];
    var msg: [byte: 50] = [];
    var i: usize = 0;
    while i < 20 {
        key[i] = 0xaa as byte;
        i = i + 1;
    }
    i = 0;
    while i < 50 {
        msg[i] = 0xdd as byte;
        i = i + 1;
    }
    hmac_sha512(key[0: 20], msg[0: 50], out[0: 64]);
    const exp: &[byte] = &"fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb"[0: 128];
    if !hex_eq(out[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "hmac_sha512_rfc4231_4_incremental_key" {
    var out: [byte: 64] = [];
    var key: [byte: 25] = [];
    var i: usize = 0;
    while i < 25 {
        key[i] = (i + 1) as byte;
        i = i + 1;
    }
    var msg: [byte: 50] = [];
    i = 0;
    while i < 50 {
        msg[i] = 0xcd as byte;
        i = i + 1;
    }
    hmac_sha512(key[0: 25], msg[0: 50], out[0: 64]);
    const exp: &[byte] = &"b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd"[0: 128];
    if !hex_eq(out[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "hmac_sha512_rfc4231_6_long_key" {
    // 131 字节密钥 > 128 字节块，必须先哈希（RFC 4231 用例 6）
    var out: [byte: 64] = [];
    var key: [byte: 131] = [];
    var i: usize = 0;
    while i < 131 {
        key[i] = 0xaa as byte;
        i = i + 1;
    }
    const msg: &[byte] = &"Test Using Larger Than Block-Size Key - Hash Key First"[0: 54];
    hmac_sha512(key[0: 131], msg, out[0: 64]);
    const exp: &[byte] = &"80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598"[0: 128];
    if !hex_eq(out[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "hmac_sha512_rfc4231_7_long_key_long_msg_incremental" {
    var out: [byte: 64] = [];
    var key: [byte: 131] = [];
    var i: usize = 0;
    while i < 131 {
        key[i] = 0xaa as byte;
        i = i + 1;
    }
    const msg: &[byte] = &"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."[0: 152];
    var ctx: HmacSha512Ctx = HmacSha512Ctx{};
    ctx.init(key[0: 131]);
    // 分段喂入，覆盖增量路径
    ctx.update(msg[0: 17]);
    ctx.update(msg[17: 83]);
    ctx.update(msg[100: 52]);
    ctx.final(out[0: 64]);
    const exp: &[byte] = &"e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58"[0: 128];
    if !hex_eq(out[0: 64], exp) {
        try assert_eq_i32(0, 1);
    }
}

test "hmac_sha512_incremental_matches_oneshot" {
    var a: [byte: 64] = [];
    var b: [byte: 64] = [];
    const key: &[byte] = &"k"[0: 1];
    const msg: &[byte] = &"the quick brown fox jumps over the lazy dog"[0: 43];
    hmac_sha512(key, msg, a[0: 64]);
    var ctx: HmacSha512Ctx = HmacSha512Ctx{};
    ctx.init(key);
    ctx.update(msg[0: 4]);
    ctx.update(msg[4: 39]);
    ctx.final(b[0: 64]);
    var i: usize = 0;
    while i < 64 {
        try assert_eq_i32(a[i] as i32, b[i] as i32);
        i = i + 1;
    }
}
