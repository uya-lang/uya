// test_async_fd.uya - 测试 std.async.AsyncFd（fd 上的 AsyncWriter/AsyncReader）

use std.async;
use std.async_event;
use std.async_scheduler;
use std.http.server;
use std.testing.assert_eq_i32;
use libc.syscall;

error UnexpectedPending;
error ExpectedPending;
error AsyncFdFailed;
error PipeCreateFailed;
error PipeReadFailed;
error PipeWriteFailed;
error ChildSpawnFailed;
error EventLoopRegisterFailed;
error EventLoopWritableFailed;

const TEST_SYS_WRITE: i64 = 1;
const TEST_SYS_CLOSE: i64 = 3;
const TEST_SYS_PIPE2: i64 = 293;
const TEST_O_NONBLOCK: i32 = 0x800;

fn test_sys_write(fd: i32, buf: &const byte, count: usize) !isize {
    return @syscall(TEST_SYS_WRITE, fd as i64, buf as i64, count as i64) as! isize;
}

fn test_sys_close(fd: i32) !i32 {
    return @syscall(TEST_SYS_CLOSE, fd as i64) as! i32;
}

fn test_sys_pipe2(pipefd: &i32, flags: i32) !i32 {
    return @syscall(TEST_SYS_PIPE2, pipefd as i64, flags as i64) as! i32;
}

fn async_fd_deadline_after_ms(timeout_ms: u32) !u64 {
    var tv: TimeVal = TimeVal{ tv_sec: 0, tv_usec: 0 };
    _ = try sys_gettimeofday(&tv, null as &void);
    return (tv.tv_sec as u64) * (1000 as u64) + ((tv.tv_usec as u64) / (1000 as u64)) + (timeout_ms as u64);
}

fn async_fd_spawn_delayed_writer(write_fd: i32, a: byte, b: byte, c: byte, d: byte, delay_ns: i64) !i32 {
    const fork_result: !i64 = sys_fork();
    const child_pid: i64 = fork_result catch {
        return error.ChildSpawnFailed;
    };
    if child_pid == 0 {
        const req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: delay_ns };
        var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
        _ = sys_nanosleep(&req, &rem) catch {};
        var src: [byte: 4] = [ a, b, c, d ];
        _ = sys_write(write_fd, &src[0] as *const byte, 4) catch {};
        _ = sys_close(write_fd) catch {};
        sys_exit(0);
    }
    return child_pid as i32;
}

fn async_fd_wait_child(child_pid: i32) void {
    if child_pid > 0 {
        var status: i32 = 0;
        _ = sys_waitpid(child_pid, &status, 0) catch {};
    }
}

var async_fd_mock_registered_fd: i32 = 0 - 1;
var async_fd_mock_write_fd: i32 = 0 - 1;
var async_fd_mock_register_count: i32 = 0;
var async_fd_mock_poll_count: i32 = 0;
var async_fd_mock_waker: &Waker = null;

struct AsyncFdWakeLoop : EventLoop {
    fn register(self: &Self, fd: i32, interest: EventKind, waker: &Waker) !i32 {
        _ = self;
        match interest {
            .Readable(_) => { },
            .Writable(_) => { return error.EventLoopRegisterFailed; },
            .ReadWrite(_) => { return error.EventLoopRegisterFailed; },
        };
        async_fd_mock_registered_fd = fd;
        async_fd_mock_register_count = async_fd_mock_register_count + 1;
        async_fd_mock_waker = waker;
        return 0;
    }

    fn deregister(self: &Self, fd: i32) !i32 {
        _ = self;
        _ = fd;
        return 0;
    }

    fn poll(self: &Self, timeout_ms: i32) !i32 {
        _ = self;
        _ = timeout_ms;
        async_fd_mock_poll_count = async_fd_mock_poll_count + 1;
        var src: [byte: 4] = [ 10, 20, 30, 40 ];
        const written: isize = test_sys_write(async_fd_mock_write_fd, &src[0] as &const byte, 4) catch {
            return error.EventLoopWritableFailed;
        };
        if written != 4 {
            return error.EventLoopWritableFailed;
        }
        async_fd_mock_waker.wake();
        return 1;
    }
}

fn assert_cancelled_poll_i32(p: Poll<!i32>) !void {
    match p {
        .Ready(value) => {
            try assert_eq_i32(value.error_id as i32, @error_id(error.Cancelled) as i32);
        },
        .Pending(_) => {
            try assert_eq_i32(0, 1);
        },
    };
}

fn assert_cancelled_poll_usize(p: Poll<!usize>) !void {
    match p {
        .Ready(value) => {
            try assert_eq_i32(value.error_id as i32, @error_id(error.Cancelled) as i32);
        },
        .Pending(_) => {
            try assert_eq_i32(0, 1);
        },
    };
}

fn assert_cancelled_poll_parse_result(p: Poll<!ParseResult>) !void {
    match p {
        .Ready(value) => {
            try assert_eq_i32(value.error_id as i32, @error_id(error.Cancelled) as i32);
        },
        .Pending(_) => {
            try assert_eq_i32(0, 1);
        },
    };
}

fn assert_fd_still_blocking(fd: i32) !void {
    const flags: i32 = try sys_fcntl(fd, F_GETFL, 0);
    try assert_eq_i32(flags & O_NONBLOCK, 0);
}

fn expect_pending_usize_interest(p: Poll<!usize>, w: &Waker, fd: i32, interest: i32) !void {
    match p {
        .Ready(_) => { return error.ExpectedPending; },
        .Pending(_) => { },
    };
    try assert_eq_i32(w.has_io_interest() as i32, 1);
    try assert_eq_i32(w.io_fd(), fd);
    try assert_eq_i32(w.io_interest_code(), interest);
}

fn expect_pending_i32_interest(p: Poll<!i32>, w: &Waker, fd: i32, interest: i32) !void {
    match p {
        .Ready(_) => { return error.ExpectedPending; },
        .Pending(_) => { },
    };
    try assert_eq_i32(w.has_io_interest() as i32, 1);
    try assert_eq_i32(w.io_fd(), fd);
    try assert_eq_i32(w.io_interest_code(), interest);
}

fn test_async_pending_readable_usize_helper_sets_interest() !void {
    var wk: Waker = Waker{ _io_fd: 0 - 1, _event_fd: 0 - 1 };
    wk.wait_writable(77);
    const p: Poll<!usize> = async_poll_pending_readable_usize(&wk, 42);
    try expect_pending_usize_interest(p, &wk, 42, 1);
}

fn test_async_pending_writable_usize_helper_sets_interest() !void {
    var wk: Waker = Waker{ _io_fd: 0 - 1, _event_fd: 0 - 1 };
    wk.wait_readable(55);
    const p: Poll<!usize> = async_poll_pending_writable_usize(&wk, 99);
    try expect_pending_usize_interest(p, &wk, 99, 2);
}

fn test_async_pending_writable_i32_helper_sets_interest() !void {
    var wk: Waker = Waker{ _io_fd: 0 - 1, _event_fd: 0 - 1 };
    wk.wait_readable(11);
    const p: Poll<!i32> = async_poll_pending_writable_i32(&wk, 123);
    try expect_pending_i32_interest(p, &wk, 123, 2);
}

fn empty_parse_result(body_buf: &byte) ParseResult {
    return ParseResult{
        request: Request{
            method: Method.GET,
            http11: true,
            path: [],
            path_len: 0,
            path_params: [],
            path_param_count: 0,
            query: [],
            query_count: 0,
            headers: [],
            header_count: 0,
            body: body_buf[0: 0],
        },
        consumed: 0,
    };
}

fn test_async_fd_read_cancelled_returns_cancelled() !void {
    var fds: [i32: 2] = [];
    _ = test_sys_pipe2(&fds[0], 0) catch {
        return error.PipeCreateFailed;
    };
    const read_fd: i32 = fds[0];
    const write_fd: i32 = fds[1];
    defer {
        _ = sys_close(read_fd) catch {};
        _ = sys_close(write_fd) catch {};
    }

    var af: AsyncFd = async_fd_new(read_fd);
    var buf: [byte: 8] = [];
    const f: Future<!usize> = af.read(&buf[0], 4);
    var wk: Waker = Waker{};
    wk.cancel();
    try assert_cancelled_poll_usize(f.poll(&wk));
    try assert_fd_still_blocking(read_fd);
}

