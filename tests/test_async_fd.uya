    var src: [byte: 4] = [ 1, 2, 3, 4 ];
    const f: Future<!usize> = async_socket_send(fd, &src[0] as &const byte, 4, 0 as u64);
    var wk: Waker = Waker{};
    wk.cancel();
    try assert_cancelled_poll_usize(f.poll(&wk));
    try assert_fd_still_blocking(fd);
}

