fn test_async_sendfile_cancelled_returns_cancelled() !void {
    const file_path: &[const byte] = "/tmp/uya_async_sendfile_cancelled.txt";
    _ = sys_unlink(file_path.ptr) catch {};
    const write_file_fd: i32 = try sys_open(file_path.ptr, (O_CREAT | O_TRUNC | O_WRONLY) as i32, 0o600);
    defer {
        _ = sys_unlink(file_path.ptr) catch {};
    }
    var file_body: [byte: 4] = [ 'c' as byte, 'a' as byte, 'n' as byte, 'x' as byte ];
    _ = try sys_write(write_file_fd, &file_body[0] as *const byte, 4);
    _ = try sys_close(write_file_fd);

    const read_file_fd: i32 = try sys_open(file_path.ptr, O_RDONLY as i32, 0);
    defer {
        _ = sys_close(read_file_fd) catch {};
    }

    var fds: [i32: 2] = [];
    _ = test_sys_pipe2(&fds[0], 0) catch {
        return error.PipeCreateFailed;
    };
    const read_fd: i32 = fds[0];
    const write_fd: i32 = fds[1];
    defer {
        _ = sys_close(read_fd) catch {};
        _ = sys_close(write_fd) catch {};
    }

    const f: Future<!usize> = async_sendfile(write_fd, read_file_fd, 4);
    var wk: Waker = Waker{};
    wk.cancel();
    try assert_cancelled_poll_usize(f.poll(&wk));
    try assert_fd_still_blocking(write_fd);
}

