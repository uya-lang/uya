fn test_async_connect_cancelled_returns_cancelled() !void {
    const client_fd: i32 = try sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    defer {
        _ = sys_close(client_fd) catch {};
    }

    var connect_addr: [byte: 16] = [];
    fill_sockaddr_loopback_16(9 as u16, &connect_addr[0] as &byte);

    const f: Future<!i32> = async_connect(client_fd, &connect_addr[0] as &void, 16 as u32, 0 as u64);
    var wk: Waker = Waker{};
    wk.cancel();
    try assert_cancelled_poll_i32(f.poll(&wk));
    try assert_fd_still_blocking(client_fd);
}

fn test_async_accept_cancelled_returns_cancelled() !void {
    const listen_fd: i32 = try sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    defer {
        _ = sys_close(listen_fd) catch {};
    }
    var one: i32 = 1;
    _ = try sys_setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32);
    var listen_addr: [byte: 16] = [];
    fill_sockaddr_loopback_16(0, &listen_addr[0] as &byte);
    _ = try sys_bind(listen_fd, &listen_addr[0] as &void, 16 as u32);
    _ = try sys_listen(listen_fd, 128);

    const f: Future<!i32> = async_accept(listen_fd);
    var wk: Waker = Waker{};
    wk.cancel();
    try assert_cancelled_poll_i32(f.poll(&wk));
    try assert_fd_still_blocking(listen_fd);
}

