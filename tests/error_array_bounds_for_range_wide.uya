// error_array_bounds_for_range_wide.uya - for 范围循环上界超出数组长度
//
// 规范 §14.5.2：`for 0..@len(arr)` 的迭代变量范围由编译器自动推导，无需显式
// 检查。反过来说，当范围上界**大于**数组长度时，推导出的区间不再落在数组内，
// 必须报错——这正是自动推导正确性的负向证据。
//
// 与 tests/test_ub_safety_guards.uya 的 `bounds for range auto` 正例配对。
//
// 预期：编译失败，报告「数组索引安全证明失败」

export fn main() i32 {
    var arr: [i32: 5] = [0, 0, 0, 0, 0];
    // 循环范围 0..9 超出数组长度 5
    for 0..9 |i| {
        arr[i] = i;
    }
    return 0;
}
