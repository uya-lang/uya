// test_typed_pipeline_try_forward_lowering.uya
// lowering 正向测试：验证最左侧为 !Pipeline 时以和普通 try 一致的方式 try-forward。

use std.process;
use std.testing.assert_eq_u64;
use std.testing.assert_eq_i32;

fn inc(p: Pipeline) Pipeline {
    return Pipeline { handle: p.handle + 1, generation: 0 };
}

fn value_u64(p: Pipeline) u64 {
    return p.handle as u64;
}

fn value_i32(p: Pipeline) i32 {
    return p.handle as i32;
}

fn make_ok_pipeline() !Pipeline {
    return pipeline();
}

fn make_fail_pipeline() !Pipeline {
    return error.Fail;
}

fn sink_i32(p: Pipeline) i32 {
    return value_i32(p);
}

// 成功路径：!Pipeline 载荷被提取并继续链式调用。
fn run_try_forward_success() !u64 {
    return make_ok_pipeline() |> inc() |> value_u64();
}

// 错误路径：!Pipeline 错误沿函数返回传播，不进入后续 stage。
fn run_try_forward_error() !u64 {
    return make_fail_pipeline() |> inc() |> value_u64();
}

// !Pipeline 通过返回 !i32 的 sink：结果类型保持 !i32。
fn run_try_forward_sink_error_union() !i32 {
    return make_ok_pipeline() |> sink_i32();
}

// 变量形式的 !Pipeline 最左侧同样支持 try-forward。
fn run_try_forward_variable() !u64 {
    const p: !Pipeline = make_ok_pipeline();
    return p |> inc() |> value_u64();
}

fn run_try_forward_variable_error() !u64 {
    const p: !Pipeline = make_fail_pipeline();
    return p |> inc() |> value_u64();
}

// 表达式位置：!Pipeline |> 普通 sink 的结果可直接作为 !R 使用。
fn run_try_forward_as_error_union_value() !u64 {
    const r: !u64 = make_ok_pipeline() |> inc() |> value_u64();
    return r;
}

fn run_try_forward_as_error_union_error() !u64 {
    const r: !u64 = make_fail_pipeline() |> inc() |> value_u64();
    return r;
}

test "pipeline_try_forward_success" {
    const v: u64 = run_try_forward_success() catch { 65535u64; };
    try assert_eq_u64(v, 1);
}

test "pipeline_try_forward_error" {
    const v: u64 = run_try_forward_error() catch { 43690u64; };
    try assert_eq_u64(v, 43690);
}

test "pipeline_try_forward_sink_error_union" {
    const v: i32 = run_try_forward_sink_error_union() catch { 0 - 1; };
    try assert_eq_i32(v, 0);
}

test "pipeline_try_forward_variable" {
    const v: u64 = run_try_forward_variable() catch { 65535u64; };
    try assert_eq_u64(v, 1);
}

test "pipeline_try_forward_variable_error" {
    const v: u64 = run_try_forward_variable_error() catch { 48059u64; };
    try assert_eq_u64(v, 48059);
}

test "pipeline_try_forward_as_error_union_value" {
    const v: u64 = run_try_forward_as_error_union_value() catch { 65535u64; };
    try assert_eq_u64(v, 1);
}

test "pipeline_try_forward_as_error_union_error" {
    const v: u64 = run_try_forward_as_error_union_error() catch { 52428u64; };
    try assert_eq_u64(v, 52428);
}
