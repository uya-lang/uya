// test_crypto_curve25519.uya — Curve25519（RFC 7748）向量
//
// 向量取自 RFC 7748 §5.2（两条原始标量乘）与 §6.1（Alice/Bob 公钥 + 共享密钥），
// 共 5 条，覆盖：任意 u 坐标、基点 u=9、双方互算共享密钥。
// 这些向量同时是「快路径是否正确」的判据——lib/tls/crypto/x25519.uya 的
// x25519_pure_uya 就是在这三条 §5.2/§6.1 向量上全错的。

use std.crypto.curve25519;
use std.crypto.curve25519.Gf;
use std.testing.assert_eq_i32;

/// 断言 32 字节相等。
fn eq32(a: &const byte, b: &const byte) !void {
    var i: usize = 0;
    while i < 32 {
        try assert_eq_i32(a[i] as i32, b[i] as i32);
        i = i + 1;
    }
}

test "curve25519_rfc7748_5_2_vector1" {
    var k: [byte: 32] = [165, 70, 227, 107, 240, 82, 124, 157, 59, 22, 21, 75, 130, 70, 94, 221, 98, 20, 76, 10, 193, 252, 90, 24, 80, 106, 34, 68, 186, 68, 154, 196];

    var u: [byte: 32] = [230, 219, 104, 103, 88, 48, 48, 219, 53, 148, 193, 164, 36, 177, 95, 124, 114, 102, 36, 236, 38, 179, 53, 59, 16, 169, 3, 166, 208, 171, 28, 76];

    var w: [byte: 32] = [195, 218, 85, 55, 157, 233, 198, 144, 142, 148, 234, 77, 242, 141, 8, 79, 50, 236, 207, 3, 73, 28, 113, 247, 84, 180, 7, 85, 119, 162, 133, 82];

    var got: [byte: 32] = [0:32];
    x25519_scalarmult(&got[0], &k[0], &u[0]);
    try eq32(&got[0], &w[0]);
}

test "curve25519_rfc7748_5_2_vector2" {
    var k: [byte: 32] = [75, 102, 233, 212, 209, 180, 103, 60, 90, 210, 38, 145, 149, 125, 106, 245, 193, 27, 100, 33, 224, 234, 1, 212, 44, 164, 22, 158, 121, 24, 186, 13];

    var u: [byte: 32] = [229, 33, 15, 18, 120, 104, 17, 211, 244, 183, 149, 157, 5, 56, 174, 44, 49, 219, 231, 16, 111, 192, 60, 62, 252, 76, 213, 73, 199, 21, 164, 147];

    var w: [byte: 32] = [149, 203, 222, 148, 118, 232, 144, 125, 122, 173, 228, 92, 180, 184, 115, 248, 139, 89, 90, 104, 121, 159, 161, 82, 230, 248, 247, 100, 122, 172, 121, 87];

    var got: [byte: 32] = [0:32];
    x25519_scalarmult(&got[0], &k[0], &u[0]);
    try eq32(&got[0], &w[0]);
}

test "curve25519_rfc7748_6_1_alice_public" {
    var k: [byte: 32] = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42];

    var w: [byte: 32] = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220, 180, 62, 247, 90, 13, 191, 58, 13, 38, 56, 26, 244, 235, 164, 169, 142, 170, 155, 78, 106];

    var got: [byte: 32] = [0:32];
    x25519_base(&got[0], &k[0]);
    try eq32(&got[0], &w[0]);
}

test "curve25519_rfc7748_6_1_bob_public" {
    var k: [byte: 32] = [93, 171, 8, 126, 98, 74, 138, 75, 121, 225, 127, 139, 131, 128, 14, 230, 111, 59, 177, 41, 38, 24, 182, 253, 28, 47, 139, 39, 255, 136, 224, 235];

    var w: [byte: 32] = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79];

    var got: [byte: 32] = [0:32];
    x25519_base(&got[0], &k[0]);
    try eq32(&got[0], &w[0]);
}

test "curve25519_rfc7748_6_1_shared_secret" {
    var k: [byte: 32] = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42];

    var u: [byte: 32] = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79];

    var w: [byte: 32] = [74, 93, 157, 91, 164, 206, 45, 225, 114, 142, 59, 244, 128, 53, 15, 37, 224, 126, 33, 201, 71, 209, 158, 51, 118, 240, 155, 60, 30, 22, 23, 66];

    var got: [byte: 32] = [0:32];
    x25519_scalarmult(&got[0], &k[0], &u[0]);
    try eq32(&got[0], &w[0]);
}

test "curve25519_shared_secret_symmetric" {
    // 双向一致：Alice(priv)·Bob(pub) == Bob(priv)·Alice(pub)
    var ka: [byte: 32] = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42];

    var pa: [byte: 32] = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220, 180, 62, 247, 90, 13, 191, 58, 13, 38, 56, 26, 244, 235, 164, 169, 142, 170, 155, 78, 106];

    var kb: [byte: 32] = [93, 171, 8, 126, 98, 74, 138, 75, 121, 225, 127, 139, 131, 128, 14, 230, 111, 59, 177, 41, 38, 24, 182, 253, 28, 47, 139, 39, 255, 136, 224, 235];

    var pb: [byte: 32] = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79];

    var s1: [byte: 32] = [0:32];
    var s2: [byte: 32] = [0:32];
    x25519_scalarmult(&s1[0], &ka[0], &pb[0]);
    x25519_scalarmult(&s2[0], &kb[0], &pa[0]);
    try eq32(&s1[0], &s2[0]);
}

test "curve25519_clamp_matches_rfc" {
    // RFC 7748 §5：k[0] &= 248; k[31] &= 127; k[31] |= 64
    var k: [byte: 32] = [0:32];
    var i: usize = 0;
    while i < 32 {
        k[i] = 255 as byte;
        i = i + 1;
    }
    x25519_clamp(&k[0]);
    try assert_eq_i32(k[0] as i32, 248);
    try assert_eq_i32(k[31] as i32, 127);
    var z: [byte: 32] = [0:32];
    x25519_clamp(&z[0]);
    try assert_eq_i32(z[0] as i32, 0);
    try assert_eq_i32(z[31] as i32, 64);
}

test "curve25519_field_identities" {
    // 域运算的身份：p ≡ 0、1+1=2、2·3=6、inv(2)·2=1、2^16·2^16=2^32
    var a: Gf = Gf{};
    var b: Gf = Gf{};
    var r: Gf = Gf{};
    var bytes: [byte: 32] = [0:32];
    gf_one(&a);
    gf_one(&b);
    gf_add(&r, &a, &b);
    gf_pack(&bytes[0], &r);
    try assert_eq_i32(bytes[0] as i32, 2);
    var two: Gf = Gf{};
    var three: Gf = Gf{};
    gf_zero(&two);
    gf_zero(&three);
    two.v[0] = 2 as i64;
    three.v[0] = 3 as i64;
    gf_mul(&r, &two, &three);
    gf_pack(&bytes[0], &r);
    try assert_eq_i32(bytes[0] as i32, 6);
    // p = 2^255−19 的 limb 表示应为 0
    var pm: Gf = Gf{};
    var i: usize = 0;
    while i < 16 {
        pm.v[i] = 65535 as i64;
        i = i + 1;
    }
    pm.v[0] = 65517 as i64;
    pm.v[15] = 32767 as i64;
    gf_pack(&bytes[0], &pm);
    i = 0;
    while i < 32 {
        try assert_eq_i32(bytes[i] as i32, 0);
        i = i + 1;
    }
    // inv(2)·2 = 1
    var inv2: Gf = Gf{};
    gf_inv(&inv2, &two);
    gf_mul(&r, &inv2, &two);
    gf_pack(&bytes[0], &r);
    try assert_eq_i32(bytes[0] as i32, 1);
}
