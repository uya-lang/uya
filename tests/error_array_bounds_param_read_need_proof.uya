// error_array_bounds_param_read_need_proof.uya - 函数参数下标读取缺少边界证明
//
// 规范 §14.2：变量索引必须证明 `i >= 0 && i < len`，证明失败即编译错误。
// 既有负例 error_bounds_need_proof.uya 覆盖的是「局部变量 + 写访问」，
// 这里补齐「函数参数（完全未知区间）+ 读访问」这条常见路径：参数没有任何
// 约束可用，必须报错，不能因为不知道值就默认放行。
//
// 预期：编译失败，报告「数组索引安全证明失败」

fn pick(i: i32) i32 {
    var arr: [i32: 4] = [1, 2, 3, 4];
    // i 是参数，区间完全未知，无法证明 0 <= i < 4
    return arr[i];
}

export fn main() i32 {
    return pick(1);
}
