use opaque_fixture.box;

fn exercise_opaque() i32 {
    reset_box_drop_count();
    {
        const value: OpaqueBox = make_box(42);
        if box_value(&value) != 42 {
            return 10;
        }
    }
    return box_drop_count();
}

export fn main() i32 {
    const result: i32 = exercise_opaque();
    @println(result);
    if result != 1 {
        return 1;
    }
    return 0;
}
