// mem.mem - mem 层内存操作
// 纯内存操作，无系统调用依赖
// 版本：v0.2.0
// 说明：使用内部命名（mem_xxx），避免与 libc 层冲突

// ============================================================
// 内存操作函数
// ============================================================

// mem_copy - 复制内存区域
export fn mem_copy(dest: &byte, src: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        dest[i] = src[i];
        i = i + 1;
    }
}

// mem_copy_backward - 向后复制内存区域（处理重叠区域）
export fn mem_copy_backward(dest: &byte, src: &const byte, n: usize) void {
    var i: usize = n;
    while i > 0 {
        i = i - 1;
        dest[i] = src[i];
    }
}

// mem_set - 设置内存区域的值
export fn mem_set(s: &byte, c: i32, n: usize) void {
    var i: usize = 0;
    while i < n {
        s[i] = c as byte;
        i = i + 1;
    }
}

// mem_zero - 将内存区域清零
export fn mem_zero(s: &byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        s[i] = 0;
        i = i + 1;
    }
}

// mem_compare - 比较两个内存区域
export fn mem_compare(s1: &const byte, s2: &const byte, n: usize) i32 {
    var i: usize = 0;
    while i < n {
        if s1[i] != s2[i] {
            return (s1[i] as i32) - (s2[i] as i32);
        }
        i = i + 1;
    }
    return 0;
}

// mem_find - 在内存区域中查找字节
export fn mem_find(s: &const byte, c: i32, n: usize) &const byte {
    var i: usize = 0;
    while i < n {
        if s[i] == (c as byte) {
            return &s[i];
        }
        i = i + 1;
    }
    return null;
}

// ============================================================
// 字符串操作函数（纯内存）
// ============================================================

// str_len - 计算字符串长度
export fn str_len(s: &const byte) usize {
    var len: usize = 0;
    while s[len] != 0 {
        len = len + 1;
    }
    return len;
}

// str_nlen - 计算字符串长度（限制最大长度）
export fn str_nlen(s: &const byte, maxlen: usize) usize {
    var len: usize = 0;
    while len < maxlen && s[len] != 0 {
        len = len + 1;
    }
    return len;
}

// str_cmp - 比较两个字符串
export fn str_cmp(s1: &const byte, s2: &const byte) i32 {
    var i: usize = 0;
    while s1[i] != 0 && s2[i] != 0 {
        if s1[i] != s2[i] {
            return (s1[i] as i32) - (s2[i] as i32);
        }
        i = i + 1;
    }
    return (s1[i] as i32) - (s2[i] as i32);
}

// str_ncmp - 比较两个字符串（限制长度）
export fn str_ncmp(s1: &const byte, s2: &const byte, n: usize) i32 {
    var i: usize = 0;
    while i < n && s1[i] != 0 && s2[i] != 0 {
        if s1[i] != s2[i] {
            return (s1[i] as i32) - (s2[i] as i32);
        }
        i = i + 1;
    }
    if i == n {
        return 0;
    }
    return (s1[i] as i32) - (s2[i] as i32);
}

// str_cpy - 复制字符串
export fn str_cpy(dest: &byte, src: &const byte) &byte {
    var i: usize = 0;
    while src[i] != 0 {
        dest[i] = src[i];
        i = i + 1;
    }
    dest[i] = 0;
    return dest;
}

// str_ncpy - 复制字符串（限制长度）
export fn str_ncpy(dest: &byte, src: &const byte, n: usize) &byte {
    var i: usize = 0;
    while i < n && src[i] != 0 {
        dest[i] = src[i];
        i = i + 1;
    }
    while i < n {
        dest[i] = 0;
        i = i + 1;
    }
    return dest;
}

// str_cat - 连接字符串
export fn str_cat(dest: &byte, src: &const byte) &byte {
    var dest_len: usize = str_len(dest);
    var i: usize = 0;
    while src[i] != 0 {
        dest[dest_len + i] = src[i];
        i = i + 1;
    }
    dest[dest_len + i] = 0;
    return dest;
}

// str_ncat - 连接字符串（限制长度）
export fn str_ncat(dest: &byte, src: &const byte, n: usize) &byte {
    var dest_len: usize = str_len(dest);
    var i: usize = 0;
    while i < n && src[i] != 0 {
        dest[dest_len + i] = src[i];
        i = i + 1;
    }
    dest[dest_len + i] = 0;
    return dest;
}

// str_chr - 在字符串中查找字符
export fn str_chr(s: &const byte, c: i32) &const byte {
    var i: usize = 0;
    while s[i] != 0 {
        if s[i] == (c as byte) {
            return &s[i];
        }
        i = i + 1;
    }
    if c == 0 {
        return &s[i];
    }
    return null;
}

// str_rchr - 在字符串中查找字符（从后向前）
export fn str_rchr(s: &const byte, c: i32) &const byte {
    var result: &const byte = null;
    var i: usize = 0;
    while s[i] != 0 {
        if s[i] == (c as byte) {
            result = &s[i];
        }
        i = i + 1;
    }
    if c == 0 {
        return &s[i];
    }
    return result;
}
