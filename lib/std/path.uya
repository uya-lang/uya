// std.path - 可移植路径工具模块

use std.string.strlen;

fn path_is_separator(ch: byte) bool {
    return ch == 47 as byte || ch == 92 as byte;
}

fn path_is_drive_letter(ch: byte) bool {
    if ch >= 65 as byte && ch <= 90 as byte {
        return true;
    }
    if ch >= 97 as byte && ch <= 122 as byte {
        return true;
    }
    return false;
}

fn path_is_absolute(path: &const byte) bool {
    if path == null || path[0] == 0 as byte {
        return false;
    }
    if path_is_separator(path[0]) {
        return true;
    }
    if path_is_drive_letter(path[0]) && path[1] == 58 as byte &&
        (path[2] == 0 as byte || path_is_separator(path[2])) {
        return true;
    }
    return false;
}

fn path_choose_join_separator(base: &const byte, base_len: usize) byte {
    if base_len >= 2usize && path_is_drive_letter(base[0]) && base[1] == 58 as byte {
        return 92 as byte;
    }
    var i: usize = base_len;
    while i > 0usize {
        const ch: byte = base[i - 1usize];
        if path_is_separator(ch) {
            return ch;
        }
        i = i - 1usize;
    }
    return 47 as byte;
}

fn path_copy_cstring(src: &const byte, out: &byte, out_cap: usize) i32 {
    if src == null || out == null || out_cap == 0usize {
        return 1;
    }
    const len: usize = strlen(src);
    if len + 1usize > out_cap {
        return 1;
    }
    var i: usize = 0;
    while i < len {
        out[i] = src[i];
        i = i + 1usize;
    }
    out[len] = 0 as byte;
    return 0;
}

fn path_copy_prefix(src: &const byte, prefix_len: usize, out: &byte, out_cap: usize) i32 {
    if src == null || out == null {
        return 1;
    }
    if prefix_len + 1usize > out_cap {
        return 1;
    }
    var i: usize = 0;
    while i < prefix_len {
        out[i] = src[i];
        i = i + 1usize;
    }
    out[prefix_len] = 0 as byte;
    return 0;
}

fn path_copy_range(src: &const byte, start: usize, end: usize, out: &byte, out_cap: usize) i32 {
    if src == null || out == null || end < start {
        return 1;
    }
    const len: usize = end - start;
    if len + 1usize > out_cap {
        return 1;
    }

    var i: usize = 0;
    while i < len {
        out[i] = src[start + i];
        i = i + 1usize;
    }
    out[len] = 0 as byte;
    return 0;
}

fn path_root_prefix_len(path: &const byte) usize {
    if path == null || path[0] == 0 as byte {
        return 0usize;
    }
    if path_is_separator(path[0]) {
        return 1usize;
    }
    if path_is_drive_letter(path[0]) && path[1] == 58 as byte {
        if path[2] == 0 as byte {
            return 2usize;
        }
        if path_is_separator(path[2]) {
            return 3usize;
        }
    }
    return 0usize;
}

fn path_trim_trailing_separators(path: &const byte, end: usize, root_len: usize) usize {
    var trimmed: usize = end;
    while trimmed > root_len {
        if !path_is_separator(path[trimmed - 1usize]) {
            break;
        }
        trimmed = trimmed - 1usize;
    }
    return trimmed;
}

fn path_trim_duplicate_separators(path: &const byte, end: usize, root_len: usize) usize {
    var trimmed: usize = end;
    while trimmed > root_len {
        if !path_is_separator(path[trimmed - 1usize]) {
            break;
        }
        trimmed = trimmed - 1usize;
    }
    return trimmed;
}

fn path_component_start(path: &const byte, end: usize, root_len: usize) usize {
    var start: usize = end;
    while start > root_len {
        if path_is_separator(path[start - 1usize]) {
            break;
        }
        start = start - 1usize;
    }
    return start;
}

fn path_stem_end(path: &const byte, start: usize, end: usize) usize {
    var i: usize = end;
    while i > start {
        i = i - 1usize;
        if path[i] != 46 as byte {
            continue;
        }

        var has_non_dot_prefix: bool = false;
        var j: usize = start;
        while j < i {
            if path[j] != 46 as byte {
                has_non_dot_prefix = true;
                break;
            }
            j = j + 1usize;
        }
        if has_non_dot_prefix {
            return i;
        }
        return end;
    }
    return end;
}

/// 标记 `std.path` 模块已可导入。
///
/// 参数说明：无。
/// 返回值：常量值始终为 `true`。
export const PATH_MODULE_PRESENT: bool = true;

/// 返回路径的最后一个组件。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的 basename；失败返回 `1`。
export fn basename(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        if root_len == 0usize {
            return path_copy_cstring("." as &const byte, out, out_cap);
        }
        return path_copy_prefix(path, root_len, out, out_cap);
    }

    const start: usize = path_component_start(path, end, root_len);
    return path_copy_range(path, start, end, out, out_cap);
}

/// 返回路径最后一个组件去掉最后扩展名后的部分。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的 stem；失败返回 `1`。
export fn stem(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        if root_len == 0usize {
            return path_copy_cstring("." as &const byte, out, out_cap);
        }
        return path_copy_prefix(path, root_len, out, out_cap);
    }

    const start: usize = path_component_start(path, end, root_len);
    const stem_end: usize = path_stem_end(path, start, end);
    return path_copy_range(path, start, stem_end, out, out_cap);
}

/// 返回路径最后一个组件的最后扩展名。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的扩展名（包含前导 `.`，若不存在则写入空串）；失败返回 `1`。
export fn extension(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("" as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        return path_copy_cstring("" as &const byte, out, out_cap);
    }

    const start: usize = path_component_start(path, end, root_len);
    const stem_end: usize = path_stem_end(path, start, end);
    if stem_end == end {
        return path_copy_cstring("" as &const byte, out, out_cap);
    }
    return path_copy_range(path, stem_end, end, out, out_cap);
}

/// 返回路径的父目录部分。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的目录名；失败返回 `1`。
export fn dirname(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        if root_len == 0usize {
            return path_copy_cstring("." as &const byte, out, out_cap);
        }
        return path_copy_prefix(path, root_len, out, out_cap);
    }

    var sep_idx: usize = end;
    while sep_idx > root_len {
        sep_idx = sep_idx - 1usize;
        if path_is_separator(path[sep_idx]) {
            const prefix_len: usize = path_trim_duplicate_separators(path, sep_idx, root_len);
            if prefix_len == 0usize {
                return path_copy_cstring("." as &const byte, out, out_cap);
            }
            return path_copy_prefix(path, prefix_len, out, out_cap);
        }
    }

    if root_len != 0usize {
        return path_copy_prefix(path, root_len, out, out_cap);
    }
    return path_copy_cstring("." as &const byte, out, out_cap);
}

/// 拼接两个路径片段并写入输出缓冲区。
///
/// 参数说明：`base` 为前缀路径；`child` 为要追加的路径片段，若其本身是绝对路径则直接原样返回；
/// `out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的结果；失败返回 `1`。
export fn join(base: &const byte, child: &const byte, out: &byte, out_cap: usize) i32 {
    if base == null || child == null || out == null || out_cap == 0usize {
        return 1;
    }
    if path_is_absolute(child) {
        return path_copy_cstring(child, out, out_cap);
    }

    const base_len: usize = strlen(base);
    if base_len == 0usize {
        return path_copy_cstring(child, out, out_cap);
    }

    const child_len: usize = strlen(child);
    if child_len == 0usize {
        return path_copy_cstring(base, out, out_cap);
    }

    var need_separator: bool = true;
    if path_is_separator(base[base_len - 1usize]) {
        need_separator = false;
    }

    var total_len: usize = base_len + child_len + 1usize;
    if need_separator {
        total_len = total_len + 1usize;
    }
    if total_len > out_cap {
        return 1;
    }

    var out_pos: usize = 0;
    while out_pos < base_len {
        out[out_pos] = base[out_pos];
        out_pos = out_pos + 1usize;
    }
    if need_separator {
        out[out_pos] = path_choose_join_separator(base, base_len);
        out_pos = out_pos + 1usize;
    }

    var child_pos: usize = 0;
    while child_pos < child_len {
        out[out_pos] = child[child_pos];
        out_pos = out_pos + 1usize;
        child_pos = child_pos + 1usize;
    }
    out[out_pos] = 0 as byte;
    return 0;
}
