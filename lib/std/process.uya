// std.process - 进程与类型化管道抽象
// 模块路径：lib/std/process.uya → use std.process;

use std.env.EnvBlockBuilder;
use std.env.env_block_builder_new;
use std.mem.allocator.IAllocator;
use std.mem.allocator.MallocAllocator;
use std.mem.allocator.get_allocator;

export error InvalidPipeline;

/// Pipeline stage 的稳定执行状态类别。
export enum PipelineStageStatusKind {
    not_started,
    spawn_failed,
    cancelled,
    exited,
    signaled,
    completed,
    stage_failed,
}

/// Process stage 启动失败的稳定跨平台分类。
export enum PipelineSpawnFailureKind {
    none,
    path_not_found,
    cwd_unavailable,
    permission_denied,
    process_create_failed,
    execution_domain_failed,
    stdio_setup_failed,
    exec_failed,
    platform_error,
}

/// 单个完整 pipeline stage 的执行状态。
export struct PipelineStageStatus {
    stage_index: usize,
    kind: PipelineStageStatusKind,
    exit_code: u32,
    signal: i32,
    spawn_failure: PipelineSpawnFailureKind,
    platform_code: u32,
    error_name: &const byte,
}

/// Pipeline 执行结果摘要；不保存 caller statuses 缓冲区借用。
export struct PipelineResult {
    stage_count: usize,
}

/// 单路 capture 的长度与完整性摘要。
export struct CaptureStreamResult {
    captured: bool,
    byte_count: usize,
    complete: bool,
}

/// Pipeline capture 摘要；不保存 stdout/stderr caller buffer 借用。
export struct PipelineCaptureResult {
    result: PipelineResult,
    stdout: CaptureStreamResult,
    stderr: CaptureStreamResult,
}

extern "libc" fn __atomic_compare_exchange_n(ptr: &i32, expected: &i32, desired: i32, weak: i32, success_mem: i32, failure_mem: i32) i32;
extern fn malloc(size: usize) &void;
extern fn free(ptr: &void) void;
extern fn memcpy(dest: &void, src: &const void, count: usize) &void;

const PIPELINE_REGISTRY_CAPACITY: usize = 1024usize;
const PIPELINE_MAX_STAGES: usize = 32usize;
const PIPELINE_STAGE_STORAGE_CAPACITY: usize = 32768usize;
const PIPELINE_ATOMIC_SEQ_CST: i32 = 5;

struct PipelineSlot {
    generation: usize,
    live: i32,
    stage_count: usize,
}

struct PipelineProcessStage {
    active: i32,
    command_kind: i32,
    argv: &&byte,
    argv_count: usize,
    cwd: &byte,
    env_ops: &PipelineEnvOp,
    env_op_count: usize,
}

struct PipelineEnvOp {
    key: &byte,
    value: &byte,
    remove: i32,
}

struct PipelineExecutionStage {
    exec_path: &byte,
}

struct PipelineEnvAllocator : IAllocator {
    inner: &MallocAllocator,

    fn alloc(self: &Self, size: usize) !&byte {
        return self.inner.alloc(size);
    },

    fn dealloc(self: &Self, ptr: &byte) void {
        self.inner.dealloc(ptr);
    },

    fn realloc(self: &Self, ptr: &byte, new_size: usize) !&byte {
        return self.inner.realloc(ptr, new_size);
    },
}

var _pipeline_registry_lock: atomic i32 = 0;
var _pipeline_registry: [PipelineSlot: 1024] = [];
var _pipeline_process_stages: [PipelineProcessStage: 32768] = [];

fn pipeline_registry_lock() void {
    while true {
        var expected: i32 = 0;
        if __atomic_compare_exchange_n((&_pipeline_registry_lock) as &i32, &expected, 1, 0,
            PIPELINE_ATOMIC_SEQ_CST, PIPELINE_ATOMIC_SEQ_CST) != 0 {
            return;
        }
    }
}

fn pipeline_registry_unlock() void {
    _pipeline_registry_lock = 0;
}

fn pipeline_next_generation(current: usize) usize {
    var next: usize = current +% 1usize;
    if next == 0usize {
        next = 1usize;
    }
    return next;
}

fn pipeline_registry_allocate() Pipeline {
    pipeline_registry_lock();
    var i: usize = 0usize;
    while i < PIPELINE_REGISTRY_CAPACITY {
        if _pipeline_registry[i].live == 0 {
            const generation: usize = pipeline_next_generation(_pipeline_registry[i].generation);
            _pipeline_registry[i].generation = generation;
            _pipeline_registry[i].live = 1;
            _pipeline_registry[i].stage_count = 0usize;
            pipeline_registry_unlock();
            return Pipeline { handle: i + 1usize, generation: generation };
        }
        i = i + 1usize;
    }
    pipeline_registry_unlock();
    return Pipeline { handle: 0usize, generation: 0usize };
}

fn pipeline_registry_slot_index(input: &Pipeline) !usize {
    if input == null || input.handle == 0usize || input.handle > PIPELINE_REGISTRY_CAPACITY {
        return error.InvalidPipeline;
    }
    return input.handle - 1usize;
}

fn pipeline_registry_stage_count(input: &Pipeline) !usize {
    const idx: usize = try pipeline_registry_slot_index(input);
    if idx >= PIPELINE_REGISTRY_CAPACITY {
        return error.InvalidPipeline;
    }
    pipeline_registry_lock();
    if _pipeline_registry[idx].live == 0 ||
        _pipeline_registry[idx].generation != input.generation {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    }
    const count: usize = _pipeline_registry[idx].stage_count;
    pipeline_registry_unlock();
    return count;
}

fn pipeline_stage_storage_index(slot_idx: usize, stage_idx: usize) !usize {
    if slot_idx >= PIPELINE_REGISTRY_CAPACITY || stage_idx >= PIPELINE_MAX_STAGES {
        return error.InvalidPipeline;
    }
    const index: usize = slot_idx * PIPELINE_MAX_STAGES + stage_idx;
    if index >= PIPELINE_STAGE_STORAGE_CAPACITY {
        return error.InvalidPipeline;
    }
    return index;
}

fn pipeline_registry_append_process_stage(input: &Pipeline, command_kind: i32) !void {
    const slot_idx: usize = try pipeline_registry_slot_index(input);
    if slot_idx >= PIPELINE_REGISTRY_CAPACITY {
        return error.InvalidPipeline;
    }
    pipeline_registry_lock();
    if _pipeline_registry[slot_idx].live == 0 ||
        _pipeline_registry[slot_idx].generation != input.generation ||
        _pipeline_registry[slot_idx].stage_count >= PIPELINE_MAX_STAGES {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    }
    const stage_idx: usize = _pipeline_registry[slot_idx].stage_count;
    const storage_result: !usize = pipeline_stage_storage_index(slot_idx, stage_idx);
    const storage_idx: usize = storage_result catch {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    };
    if storage_idx >= PIPELINE_STAGE_STORAGE_CAPACITY {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    }
    _pipeline_process_stages[storage_idx].active = 1;
    _pipeline_process_stages[storage_idx].command_kind = command_kind;
    _pipeline_process_stages[storage_idx].argv = null as &&byte;
    _pipeline_process_stages[storage_idx].argv_count = 0usize;
    _pipeline_process_stages[storage_idx].cwd = null as &byte;
    _pipeline_process_stages[storage_idx].env_ops = null as &PipelineEnvOp;
    _pipeline_process_stages[storage_idx].env_op_count = 0usize;
    _pipeline_registry[slot_idx].stage_count = stage_idx + 1usize;
    pipeline_registry_unlock();
    return;
}

fn pipeline_owned_c_string(value: &const byte) !&byte {
    if value == null {
        return error.InvalidPipeline;
    }
    var len: usize = 0usize;
    while value[len] != 0 as byte {
        len = len + 1usize;
    }
    const raw: &void = malloc(len + 1usize);
    if raw == null {
        return error.InvalidPipeline;
    }
    const out: &byte = raw as &byte;
    _ = memcpy(out as &void, value as &const void, len + 1usize);
    return out;
}

fn pipeline_c_string_equals(left: &const byte, right: &const byte) i32 {
    if left == null || right == null {
        return 0;
    }
    var i: usize = 0usize;
    while left[i] != 0 as byte && right[i] != 0 as byte {
        if left[i] != right[i] {
            return 0;
        }
        i = i + 1usize;
    }
    if left[i] != right[i] {
        return 0;
    }
    return 1;
}

fn pipeline_execution_stage_init(exec_path: &const byte) !PipelineExecutionStage {
    return PipelineExecutionStage { exec_path: try pipeline_owned_c_string(exec_path) };
}

fn pipeline_execution_stage_deinit(stage: &PipelineExecutionStage) void {
    if stage == null || stage.exec_path == null {
        return;
    }
    free(stage.exec_path as &void);
    stage.exec_path = null as &byte;
}

fn pipeline_free_stage_argv(stage: &PipelineProcessStage) void {
    if stage == null || stage.argv == null {
        return;
    }
    var i: usize = 0usize;
    while i < stage.argv_count {
        if stage.argv[i] != null {
            free(stage.argv[i] as &void);
            stage.argv[i] = null as &byte;
        }
        i = i + 1usize;
    }
    free(stage.argv as &void);
    stage.argv = null as &&byte;
    stage.argv_count = 0usize;
}

fn pipeline_registry_set_last_stage_argv(input: &Pipeline, program: &const byte, args: &&const byte, args_len: usize) !void {
    const slot_idx: usize = try pipeline_registry_slot_index(input);
    if slot_idx >= PIPELINE_REGISTRY_CAPACITY {
        return error.InvalidPipeline;
    }
    pipeline_registry_lock();
    const count: usize = _pipeline_registry[slot_idx].stage_count;
    if _pipeline_registry[slot_idx].live == 0 ||
        _pipeline_registry[slot_idx].generation != input.generation || count == 0usize {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    }
    const storage_result: !usize = pipeline_stage_storage_index(slot_idx, count - 1usize);
    const storage_idx: usize = storage_result catch {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    };
    if storage_idx >= PIPELINE_STAGE_STORAGE_CAPACITY {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    }
    const argv_count: usize = args_len + 1usize;
    const argv_raw: &void = malloc(argv_count * @size_of(&byte));
    if argv_raw == null {
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    }
    const owned_argv: &&byte = argv_raw as &&byte;
    var initialized: usize = 0usize;
    const owned_program_result: !&byte = pipeline_owned_c_string(program);
    const owned_program: &byte = owned_program_result catch {
        free(argv_raw);
        pipeline_registry_unlock();
        return error.InvalidPipeline;
    };
    owned_argv[0] = owned_program;
    initialized = 1usize;
    var i: usize = 0usize;
    while i < args_len {
        const argument: &const byte = args[i];
        const owned_arg_result: !&byte = pipeline_owned_c_string(argument);
        const owned_arg: &byte = owned_arg_result catch {
            var j: usize = 0usize;
            while j < initialized {
                free(owned_argv[j] as &void);
                j = j + 1usize;
            }
            free(argv_raw);
            pipeline_registry_unlock();
            return error.InvalidPipeline;
        };
        owned_argv[i + 1usize] = owned_arg;
        initialized = initialized + 1usize;
        i = i + 1usize;
    }
    pipeline_free_stage_argv(&_pipeline_process_stages[storage_idx]);
    _pipeline_process_stages[storage_idx].argv = owned_argv;
    _pipeline_process_stages[storage_idx].argv_count = argv_count;
    pipeline_registry_unlock();
    return;
}

fn pipeline_registry_set_last_stage_cwd(input: &Pipeline, cwd: &const byte) !void {
    const slot_idx: usize = try pipeline_registry_slot_index(input);
    if slot_idx >= PIPELINE_REGISTRY_CAPACITY {
        return error.InvalidPipeline;
    }
    const owned_cwd: &byte = try pipeline_owned_c_string(cwd);
    pipeline_registry_lock();
    const count: usize = _pipeline_registry[slot_idx].stage_count;
    if _pipeline_registry[slot_idx].live == 0 ||
        _pipeline_registry[slot_idx].generation != input.generation || count == 0usize {
        pipeline_registry_unlock();
        free(owned_cwd as &void);
        return error.InvalidPipeline;
    }
    const storage_result: !usize = pipeline_stage_storage_index(slot_idx, count - 1usize);
    const storage_idx: usize = storage_result catch {
        pipeline_registry_unlock();
        free(owned_cwd as &void);
        return error.InvalidPipeline;
    };
    if storage_idx >= PIPELINE_STAGE_STORAGE_CAPACITY {
        pipeline_registry_unlock();
        free(owned_cwd as &void);
        return error.InvalidPipeline;
    }
    if _pipeline_process_stages[storage_idx].cwd != null {
        free(_pipeline_process_stages[storage_idx].cwd as &void);
    }
    _pipeline_process_stages[storage_idx].cwd = owned_cwd;
    pipeline_registry_unlock();
    return;
}

fn pipeline_free_env_ops(stage: &PipelineProcessStage) void {
    if stage == null || stage.env_ops == null {
        return;
    }
    var i: usize = 0usize;
    while i < stage.env_op_count {
        if stage.env_ops[i].key != null {
            free(stage.env_ops[i].key as &void);
        }
        if stage.env_ops[i].value != null {
            free(stage.env_ops[i].value as &void);
        }
        i = i + 1usize;
    }
    free(stage.env_ops as &void);
    stage.env_ops = null as &PipelineEnvOp;
    stage.env_op_count = 0usize;
}

fn pipeline_registry_append_last_stage_env(input: &Pipeline, key: &const byte, value: &const byte, remove: i32) !void {
    const slot_idx: usize = try pipeline_registry_slot_index(input);
    if slot_idx >= PIPELINE_REGISTRY_CAPACITY || key == null || (remove == 0 && value == null) {
        return error.InvalidPipeline;
    }
    const owned_key: &byte = try pipeline_owned_c_string(key);
    var owned_value: &byte = null as &byte;
    if remove == 0 {
        const value_result: !&byte = pipeline_owned_c_string(value);
        owned_value = value_result catch {
            free(owned_key as &void);
            return error.InvalidPipeline;
        };
    }
    pipeline_registry_lock();
    const count: usize = _pipeline_registry[slot_idx].stage_count;
    if _pipeline_registry[slot_idx].live == 0 ||
        _pipeline_registry[slot_idx].generation != input.generation || count == 0usize {
        pipeline_registry_unlock();
        free(owned_key as &void);
        if owned_value != null { free(owned_value as &void); }
        return error.InvalidPipeline;
    }
    const storage_result: !usize = pipeline_stage_storage_index(slot_idx, count - 1usize);
    const storage_idx: usize = storage_result catch {
        pipeline_registry_unlock();
        free(owned_key as &void);
        if owned_value != null { free(owned_value as &void); }
        return error.InvalidPipeline;
    };
    if storage_idx >= PIPELINE_STAGE_STORAGE_CAPACITY {
        pipeline_registry_unlock();
        free(owned_key as &void);
        if owned_value != null { free(owned_value as &void); }
        return error.InvalidPipeline;
    }
    const old_count: usize = _pipeline_process_stages[storage_idx].env_op_count;
    const raw: &void = malloc((old_count + 1usize) * @size_of(PipelineEnvOp));
    if raw == null {
        pipeline_registry_unlock();
        free(owned_key as &void);
        if owned_value != null { free(owned_value as &void); }
        return error.InvalidPipeline;
    }
    const ops: &PipelineEnvOp = raw as &PipelineEnvOp;
    if old_count > 0usize {
        _ = memcpy(raw, _pipeline_process_stages[storage_idx].env_ops as &const void,
            old_count * @size_of(PipelineEnvOp));
        free(_pipeline_process_stages[storage_idx].env_ops as &void);
    }
    ops[old_count] = PipelineEnvOp { key: owned_key, value: owned_value, remove: remove };
    _pipeline_process_stages[storage_idx].env_ops = ops;
    _pipeline_process_stages[storage_idx].env_op_count = old_count + 1usize;
    pipeline_registry_unlock();
    return;
}

fn pipeline_apply_stage_env(stage: &PipelineProcessStage, builder: &EnvBlockBuilder) !void {
    if stage == null || builder == null {
        return error.InvalidPipeline;
    }
    var i: usize = 0usize;
    while i < stage.env_op_count {
        if stage.env_ops[i].remove != 0 {
            try builder.without(stage.env_ops[i].key);
        } else {
            try builder.with(stage.env_ops[i].key, stage.env_ops[i].value);
        }
        i = i + 1usize;
    }
}

fn pipeline_path_env(builder: &EnvBlockBuilder) &(&const byte) {
    return builder.envp();
}

fn pipeline_spawn_env(builder: &EnvBlockBuilder) &(&const byte) {
    return builder.envp();
}

fn pipeline_registry_clear_stages(slot_idx: usize, count: usize) void {
    var i: usize = 0usize;
    while i < count && i < PIPELINE_MAX_STAGES {
        const storage_result: !usize = pipeline_stage_storage_index(slot_idx, i);
        const storage_idx: usize = storage_result catch { return; };
        if storage_idx >= PIPELINE_STAGE_STORAGE_CAPACITY {
            return;
        }
        pipeline_free_stage_argv(&_pipeline_process_stages[storage_idx]);
        if _pipeline_process_stages[storage_idx].cwd != null {
            free(_pipeline_process_stages[storage_idx].cwd as &void);
            _pipeline_process_stages[storage_idx].cwd = null as &byte;
        }
        pipeline_free_env_ops(&_pipeline_process_stages[storage_idx]);
        _pipeline_process_stages[storage_idx].active = 0;
        _pipeline_process_stages[storage_idx].command_kind = 0;
        i = i + 1usize;
    }
}

fn pipeline_registry_release(input: &Pipeline) i32 {
    const idx_result: !usize = pipeline_registry_slot_index(input);
    const idx: usize = idx_result catch { return 0; };
    if idx >= PIPELINE_REGISTRY_CAPACITY {
        return 0;
    }
    pipeline_registry_lock();
    if _pipeline_registry[idx].live == 0 ||
        _pipeline_registry[idx].generation != input.generation {
        pipeline_registry_unlock();
        return 0;
    }
    const old_stage_count: usize = _pipeline_registry[idx].stage_count;
    pipeline_registry_clear_stages(idx, old_stage_count);
    _pipeline_registry[idx].live = 0;
    _pipeline_registry[idx].stage_count = 0usize;
    pipeline_registry_unlock();
    return 1;
}

fn pipeline_empty_stage_status(index: usize) PipelineStageStatus {
    return PipelineStageStatus {
        stage_index: index,
        kind: PipelineStageStatusKind.not_started,
        exit_code: 0u32,
        signal: 0,
        spawn_failure: PipelineSpawnFailureKind.none,
        platform_code: 0u32,
        error_name: "",
    };
}

fn pipeline_reset_result(result: &PipelineResult) void {
    if result != null {
        result.stage_count = 0usize;
    }
}

fn pipeline_reset_capture_result(result: &PipelineCaptureResult) void {
    if result == null {
        return;
    }
    result.result.stage_count = 0usize;
    result.stdout.captured = false;
    result.stdout.byte_count = 0usize;
    result.stdout.complete = false;
    result.stderr.captured = false;
    result.stderr.byte_count = 0usize;
    result.stderr.complete = false;
}

fn pipeline_prepare_status_buffer(input: &Pipeline, statuses: &[PipelineStageStatus], result: &PipelineResult) !usize {
    pipeline_reset_result(result);
    const count: usize = try pipeline_registry_stage_count(input);
    if statuses.len < count {
        return error.InvalidPipeline;
    }
    var i: usize = 0usize;
    while i < count {
        statuses[i] = pipeline_empty_stage_status(i);
        i = i + 1usize;
    }
    result.stage_count = count;
    return count;
}

fn pipeline_copy_capture_bytes(output: &[byte], input: &[const byte], count: usize) !usize {
    if count > output.len || count > input.len {
        return error.InvalidPipeline;
    }
    var i: usize = 0usize;
    while i < count {
        output[i] = input[i];
        i = i + 1usize;
    }
    return count;
}

/// 进程管道的不透明、不可复制执行计划。
/// 字段仅 std.process 声明模块可见；调用方只能通过公开 transformer/sink 移动它。
export opaque struct Pipeline {
    handle: usize,
    generation: usize,

    fn drop(self: Pipeline) void {
        if pipeline_registry_release(&self) != 0 {
            _pipeline_drop_count = _pipeline_drop_count + 1;
        }
    }
}

// bring-up 计数器用于验证 lowering 与自动 drop；Pipeline executor 落地后由实际
// plan 资源释放取代计数器主体。
var _pipeline_drop_count: u64 = 0;

/// 返回 pipeline_drop 被调用的次数（interim 测试钩子）。
export fn pipeline_drop_count() u64 {
    return _pipeline_drop_count;
}

/// 重置 pipeline_drop 计数器（interim 测试钩子）。
export fn reset_pipeline_drop_count() void {
    _pipeline_drop_count = 0;
}

/// 释放 lowering 错误路径已经消费的 pipeline 计划。
export fn pipeline_drop(input: Pipeline) void {
    if pipeline_registry_release(&input) != 0 {
        _pipeline_drop_count = _pipeline_drop_count + 1;
    }
}

/// 创建一个空的 pipeline 计划。
export fn pipeline() Pipeline {
    return pipeline_registry_allocate();
}

/// 返回计划中的完整可执行 stage 数量，不消费或执行计划。
export fn stage_count(input: &Pipeline) !usize {
    return pipeline_registry_stage_count(input);
}

/// 运行 capability registry 的内部 bring-up 自检；仅供编译器回归测试。
export fn pipeline_capability_self_test() !void {
    const first: Pipeline = pipeline_registry_allocate();
    const stale: Pipeline = Pipeline { handle: first.handle, generation: first.generation };
    if try pipeline_registry_stage_count(&first) != 0usize {
        return error.InvalidPipeline;
    }
    try pipeline_registry_append_process_stage(&first, 1);
    try pipeline_registry_append_process_stage(&first, 2);
    if try pipeline_registry_stage_count(&first) != 2usize {
        return error.InvalidPipeline;
    }
    const argv_input: [&const byte: 2] = ["alpha", "beta"];
    try pipeline_registry_set_last_stage_argv(&first, "tool", &argv_input[0], 2usize);
    const first_slot: usize = try pipeline_registry_slot_index(&first);
    const owned_stage_idx: usize = try pipeline_stage_storage_index(first_slot, 1usize);
    if owned_stage_idx >= PIPELINE_STAGE_STORAGE_CAPACITY ||
        _pipeline_process_stages[owned_stage_idx].argv_count != 3usize ||
        _pipeline_process_stages[owned_stage_idx].argv == null ||
        _pipeline_process_stages[owned_stage_idx].argv[0] == ("tool" as &byte) ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].argv[0], "tool") == 0 ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].argv[1], "alpha") == 0 ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].argv[2], "beta") == 0 {
        return error.InvalidPipeline;
    }
    var execution_stage: PipelineExecutionStage = try pipeline_execution_stage_init("/bin/tool");
    if execution_stage.exec_path == null ||
        execution_stage.exec_path == ("/bin/tool" as &byte) ||
        pipeline_c_string_equals(execution_stage.exec_path, "/bin/tool") == 0 ||
        _pipeline_process_stages[owned_stage_idx].argv[0] == execution_stage.exec_path {
        pipeline_execution_stage_deinit(&execution_stage);
        return error.InvalidPipeline;
    }
    pipeline_execution_stage_deinit(&execution_stage);
    if execution_stage.exec_path != null {
        return error.InvalidPipeline;
    }
    try pipeline_registry_set_last_stage_cwd(&first, "build/work");
    if _pipeline_process_stages[owned_stage_idx].cwd == null ||
        _pipeline_process_stages[owned_stage_idx].cwd == ("build/work" as &byte) ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].cwd, "build/work") == 0 {
        return error.InvalidPipeline;
    }
    try pipeline_registry_append_last_stage_env(&first, "MODE", "debug", 0);
    try pipeline_registry_append_last_stage_env(&first, "OLD_MODE", null, 1);
    if _pipeline_process_stages[owned_stage_idx].env_op_count != 2usize ||
        _pipeline_process_stages[owned_stage_idx].env_ops == null ||
        _pipeline_process_stages[owned_stage_idx].env_ops[0].remove != 0 ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].env_ops[0].key, "MODE") == 0 ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].env_ops[0].value, "debug") == 0 ||
        _pipeline_process_stages[owned_stage_idx].env_ops[1].remove == 0 ||
        pipeline_c_string_equals(_pipeline_process_stages[owned_stage_idx].env_ops[1].key, "OLD_MODE") == 0 ||
        _pipeline_process_stages[owned_stage_idx].env_ops[1].value != null {
        return error.InvalidPipeline;
    }
    var env_allocator: PipelineEnvAllocator = PipelineEnvAllocator { inner: get_allocator() };
    var env_builder: EnvBlockBuilder = env_block_builder_new(env_allocator);
    env_builder.inherit_current();
    try pipeline_apply_stage_env(&_pipeline_process_stages[owned_stage_idx], &env_builder);
    try env_builder.build();
    const path_env: &(&const byte) = pipeline_path_env(&env_builder);
    const spawn_env: &(&const byte) = pipeline_spawn_env(&env_builder);
    if path_env == null || spawn_env != path_env {
        return error.InvalidPipeline;
    }
    if pipeline_registry_release(&first) == 0 {
        return error.InvalidPipeline;
    }
    const stale_result: !usize = pipeline_registry_stage_count(&stale);
    _ = stale_result catch { 0usize; };
    if stale_result.error_id == 0 {
        return error.InvalidPipeline;
    }

    const second: Pipeline = pipeline_registry_allocate();
    if second.handle == stale.handle && second.generation == stale.generation {
        return error.InvalidPipeline;
    }
    if pipeline_registry_release(&second) == 0 {
        return error.InvalidPipeline;
    }
    if pipeline_registry_release(&second) != 0 {
        return error.InvalidPipeline;
    }

    const forged: Pipeline = Pipeline { handle: PIPELINE_REGISTRY_CAPACITY + 1usize, generation: 1usize };
    const forged_result: !usize = pipeline_registry_stage_count(&forged);
    _ = forged_result catch { 0usize; };
    if forged_result.error_id == 0 {
        return error.InvalidPipeline;
    }
    return;
}

/// 验证 caller-provided statuses/capture buffer 协议；仅供编译器回归测试。
export fn pipeline_buffer_self_test(statuses: &[PipelineStageStatus], stdout_buf: &[byte], result: &PipelineCaptureResult) !void {
    pipeline_reset_capture_result(result);
    const p: Pipeline = pipeline_registry_allocate();
    try pipeline_registry_append_process_stage(&p, 1);
    try pipeline_registry_append_process_stage(&p, 1);
    const count: usize = try pipeline_prepare_status_buffer(&p, statuses, &result.result);
    if count != 2usize {
        return error.InvalidPipeline;
    }
    const sample: &[const byte] = &"ok"[0:2];
    const copied: usize = try pipeline_copy_capture_bytes(stdout_buf, sample, 2usize);
    result.stdout.captured = true;
    result.stdout.byte_count = copied;
    result.stdout.complete = true;
    if pipeline_registry_release(&p) == 0 {
        return error.InvalidPipeline;
    }
    return;
}
