// 平台枚举：各枚举变体名在 C 中须全局唯一（同一 .c 内多 enum 时枚举常量共享外层作用域）
export enum HostOS {
    hos_linux,
    hos_macos,
    hos_windows,
    hos_unknown,
}

export enum HostArch {
    ha_x86_64,
    ha_arm64,
    ha_riscv64,
    ha_unknown,
}

export enum TargetOS {
    tos_linux,
    tos_macos,
    tos_windows,
    tos_unknown,
}

// 编译后端：C99 生成（原生机器码）与 exec VM 解释执行。
// 只给 `std.cfg(std.backend == …)` 用：少数"只在原生机器码下才有意义"的用例
// （裸函数里的 @asm 读硬件栈指针、原生 trampoline 回跳、真切栈）用它自我排除。
export enum Backend {
    be_native,
    be_exec_vm,
}

export enum TargetArch {
    ta_x86_64,
    ta_arm,
    ta_arm64,
    ta_riscv64,
    ta_unknown,
}
