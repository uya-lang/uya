// lib/std/net/socket.uya - socket fd 基础操作
// 模块路径：use std.net.socket

use libc.syscall;

fn net_socket_enable_flag(fd: i32, get_cmd: i32, set_cmd: i32, flag: i32) !void {
    const current_flags: i32 = try sys_fcntl(fd, get_cmd, 0);
    if (current_flags & flag) != 0 {
        return;
    }
    _ = try sys_fcntl(fd, set_cmd, current_flags | flag);
}

/// 把 socket fd 设置为非阻塞模式。
/// 参数说明：`fd` 为已打开且有效的 socket 文件描述符。
/// 返回值说明：成功时返回空值；若 `fcntl(2)` 失败则返回对应系统错误。
export fn net_socket_set_nonblocking(fd: i32) !void {
    try net_socket_enable_flag(fd, F_GETFL, F_SETFL, O_NONBLOCK);
}

/// 把 socket fd 设置为 close-on-exec 模式。
/// 参数说明：`fd` 为已打开且有效的 socket 文件描述符。
/// 返回值说明：成功时返回空值；若 `fcntl(2)` 失败则返回对应系统错误。
export fn net_socket_set_cloexec(fd: i32) !void {
    try net_socket_enable_flag(fd, F_GETFD, F_SETFD, FD_CLOEXEC);
}
