// driver/path_list.uya - 编译器输入文件表（可增长，无固定上限）
//
// 背景：编译器处理输入文件用的几张表原先都是**定长数组**，长度 MAX_INPUT_FILES（512）。
// 表满之后的行为分两种，都不是好行为：
//   * `main()` 里 `input_file_indices` 曾写死 `[i32: 64]`，而 `parse_args` 的上限守卫用的是
//     MAX_INPUT_FILES ⇒ 第 65 个输入文件的下标被写到数组之外，读回来是栈上相邻变量的垃圾值，
//     报「无法获取输入文件路径（索引 1886221359）」或「收集模块依赖失败: <编译器路径>」
//     —— 报错说的位置（编译器自身路径 / 文件路径）与真实原因（数组比守卫小）完全无关；
//   * 依赖收集里 `while ... && current_size < max_files` 这类循环在表满时**静默停手**，
//     少掉的依赖文件不会进编译，错误在很久之后的链接期才冒出来。
//
// 本文件把「路径表」与「下标表」收成两个可增长结构，容量按 2 倍增长（同
// `checker/dyn_table.uya` 的容量策略），只受内存限制。
//
// ---- 为什么表用 `&(&byte)` 而不是 `[&byte: N]` ----
// `&byte` 元素就是 C 的 `char *`，`&(&byte)` 就是 `char **`。表在堆上，增长 =
// malloc 新块 + 搬运 + free 旧块。元素是指针 ⇒ 搬运不打断任何**指针身份**
// （调用方拿到的 `&byte` 与表里存的是同一个指针值）。
//
// 生命周期：`*_init` 只清零，`*_free` 只复位（**不归还内存**），表本身是值结构体（可放栈上）。
// 两块索引数组与 `path_list_push_strdup` 复制的字符串都从本文件自己的**竞技场**分配
// （`path_arena()`），所以「释放」只是断开引用：这些表的寿命就是本次编译。
//
// 为什么改（2026-11-17，`docs/unsafe_audit_plan.md` §2 降债）：原先这里是
// 3 处 malloc + 6 处 free（含 `path_list_free_all` 逐条 free 字符串），
// 构成 9 处手工所有权点。这些表的寿命本来就是「进程结束」，而竞技场只初始化一次、
// 全仓库没有任何地方 `compiler_arena_reset`，两者寿命完全一致。
// 改完之后 `free` 路径全部消失，只剩「活到进程结束」这一种语义上的可能。

use libc;

// 驱动层专用竞技场：只服务输入文件表 / 下标表（总量是 MB 级以下，
// 64 KB 固定段 + 不够时由 arena 自己 mmap/malloc 新 chunk）。
const PATH_ARENA_BYTES: usize = 65536 as usize;
var g_path_arena_buffer: [byte: 65536] = [];
var g_path_arena_ready: i32 = 0;
var g_path_arena: CompilerArena = CompilerArena {
    buffer: null,
    size: 0 as usize,
    offset: 0 as usize,
    first_chunk: null,
    current_chunk: null,
    total_allocated: 0 as usize,
};

/// 取驱动层竞技场（首次调用时初始化）。
fn path_arena() &CompilerArena {
    if g_path_arena_ready == 0 {
        compiler_arena_init(&g_path_arena, &g_path_arena_buffer[0], PATH_ARENA_BYTES);
        g_path_arena_ready = 1;
    }
    return &g_path_arena;
}

// 可增长的路径表：items[0..count) 是有效的 C 字符串指针，容量 = capacity。
struct PathList {
    items: &(&byte),   // 堆上的指针数组（malloc；空表时为 null）
    count: i32,        // 有效条目数
    capacity: i32,     // 当前容量（0 = 还没分配）
}

// 可增长的 i32 表（命令行输入文件在 argv 中的下标）。
struct IntList {
    items: &i32,       // 堆上的 i32 数组（malloc；空表时为 null）
    count: i32,
    capacity: i32,
}

// 空表的最小容量：避免前几次 push 每次都 malloc。
const PATH_LIST_MIN_CAPACITY: i32 = 16;

// 空路径表（供 `var l: PathList = path_list_empty();` 用，等价于手工清零）。
fn path_list_empty() PathList {
    return PathList { items: null, count: 0, capacity: 0 };
}

// 初始化（清零）。表可以反复 init/free。
fn path_list_init(l: &PathList) void {
    if l == null {
        return;
    }
    l.items = null;
    l.count = 0;
    l.capacity = 0;
}

// 把表复位（断开索引数组引用）。数组在竞技场里，**不归还**。
// 对 null/空表安全。
fn path_list_free(l: &PathList) void {
    if l == null {
        return;
    }
    l.items = null;
    l.count = 0;
    l.capacity = 0;
}

// 把表复位。`path_list_push_strdup` 复制的字符串也在同一个竞技场里，
// 与索引数组一起活到进程结束，所以这里**逐条不 free**（原先每条 free 一次）。
fn path_list_free_all(l: &PathList) void {
    path_list_free(l);
}

// 确保容量 ≥ want。成功 0；分配失败或容量溢出 -1。
// 增长策略：至少 PATH_LIST_MIN_CAPACITY，之后 2 倍，直到够用。
fn path_list_reserve(l: &PathList, want: i32) i32 {
    if l == null {
        return -1;
    }
    if want <= l.capacity {
        return 0;
    }
    var nc: i32 = l.capacity;
    if nc < PATH_LIST_MIN_CAPACITY {
        nc = PATH_LIST_MIN_CAPACITY;
    }
    while nc < want {
        nc = nc *| 2;
        if nc <= 0 {
            return -1;   // i32 溢出（病态输入）
        }
    }
    const nu: usize = (nc as! usize) catch { return -1; };
    const raw: &byte = compiler_arena_alloc(path_arena(), nu * @size_of(&byte));
    if raw == null {
        return -1;
    }
    const np: &(&byte) = raw as &(&byte);
    // 搬旧内容；空槽补 null（与「空槽判据是 null」的既有调用方约定一致）
    var i: i32 = 0;
    while i < l.count {
        np[i] = l.items[i];
        i = i + 1;
    }
    while i < nc {
        np[i] = null;
        i = i + 1;
    }
    // 旧数组留在竞技场里不再归还（扩容单调向上，读的都是新数组）。
    l.items = np;
    l.capacity = nc;
    return 0;
}

// 追加一个路径指针。成功 0；失败 -1（此时表不变）。
fn path_list_push(l: &PathList, p: &byte) i32 {
    if l == null {
        return -1;
    }
    if path_list_reserve(l, l.count + 1) != 0 {
        return -1;
    }
    l.items[l.count] = p;
    l.count = l.count +| 1;
    return 0;
}

// 复制 src（C 串）到堆上再追加。成功 0；失败 -1。
// 用它的表必须用 `path_list_free_all` 释放。
fn path_list_push_strdup(l: &PathList, src: &byte) i32 {
    if l == null || src == null {
        return -1;
    }
    const n: usize = strlen(src as *byte) + 1usize;
    const mem: &byte = compiler_arena_alloc(path_arena(), n);
    if mem == null {
        return -1;
    }
    strcpy(mem as *byte, src as *byte);
    if path_list_push(l, mem) != 0 {
        return -1;
    }
    return 0;
}

// 取第 idx 项；越界返回 null（调用方按「空槽」处理）。
fn path_list_at(l: &PathList, idx: i32) &byte {
    if l == null || idx < 0 || idx >= l.count {
        return null;
    }
    return l.items[idx];
}

// 表内容里是否已有该路径（按 paths_equal 的「考虑路径格式差异」口径）。
// 命中返回 1，否则 0。
fn path_list_contains(l: &PathList, p: &const byte) i32 {
    if l == null || p == null {
        return 0;
    }
    var i: i32 = 0;
    while i < l.count {
        if l.items[i] != null && paths_equal(l.items[i], p) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// 初始化（清零）。
fn int_list_init(l: &IntList) void {
    if l == null {
        return;
    }
    l.items = null;
    l.count = 0;
    l.capacity = 0;
}

// 复位（断开引用，不归还内存 —— 见文件头）。对 null/空表安全。
fn int_list_free(l: &IntList) void {
    if l == null {
        return;
    }
    l.items = null;
    l.count = 0;
    l.capacity = 0;
}

// 确保容量 ≥ want。成功 0；分配失败/溢出 -1。
fn int_list_reserve(l: &IntList, want: i32) i32 {
    if l == null {
        return -1;
    }
    if want <= l.capacity {
        return 0;
    }
    var nc: i32 = l.capacity;
    if nc < PATH_LIST_MIN_CAPACITY {
        nc = PATH_LIST_MIN_CAPACITY;
    }
    while nc < want {
        nc = nc *| 2;
        if nc <= 0 {
            return -1;
        }
    }
    const nu: usize = (nc as! usize) catch { return -1; };
    const raw: &byte = compiler_arena_alloc(path_arena(), nu * @size_of(i32));
    if raw == null {
        return -1;
    }
    const np: &i32 = raw as &i32;
    var i: i32 = 0;
    while i < l.count {
        np[i] = l.items[i];
        i = i + 1;
    }
    while i < nc {
        np[i] = 0;
        i = i + 1;
    }
    l.items = np;
    l.capacity = nc;
    return 0;
}

// 追加一个值。成功 0；失败 -1（表不变）。
fn int_list_push(l: &IntList, v: i32) i32 {
    if l == null {
        return -1;
    }
    if int_list_reserve(l, l.count + 1) != 0 {
        return -1;
    }
    l.items[l.count] = v;
    l.count = l.count +| 1;
    return 0;
}
