        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call_inst: MirInst = MirInst{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_CALL,
        type_id: i32_type_id,
        result_value_id: value_id,
        operand_start: operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: target_decl_index,
    };
    var cond_inst: MirInst = MirInst{
        inst_id: cond_inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: cond_value_id,
        operand_start: cond_operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: compare_value,
    };
    var then_inst: MirInst = MirInst{
        inst_id: then_inst_id,
        function_id: function_id,
        block_id: then_block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: then_value_id,
        operand_start: 0,
        operand_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: then_value,
    };
    var final_inst: MirInst = MirInst{
        inst_id: final_inst_id,
        function_id: function_id,
        block_id: final_block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: final_value_id,
        operand_start: 0,
        operand_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: final_value,
    };
    var call_operand: MirOperand = MirOperand{
        operand_id: operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: signature_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: target_function_id,
        flags: 0,
    };
    var cond_operand: MirOperand = MirOperand{
        operand_id: cond_operand_id,
        kind: 0,
        value_id: value_id,
        local_id: local_id,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: compare_value,
        flags: 0,
    };
    var cond_term_operand: MirOperand = MirOperand{
        operand_id: cond_term_operand_id,
        kind: 0,
        value_id: cond_value_id,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: 0,
        flags: 0,
