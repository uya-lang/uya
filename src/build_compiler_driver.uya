        checker) != 0 {
        return 1;
    }
    if native_build_hosted_decl_can_materialize_lexical_drop_body(program,
        decl, checker) != 0 {
        return 1;
    }
    if native_build_hosted_decl_can_materialize_interface_method_body(program,
        decl, checker) != 0 {
        return 1;
    }
    if native_build_hosted_decl_can_materialize_atomic_i32_body(decl, checker) != 0 {
        return 1;
    }
    if native_build_hosted_decl_can_materialize_simd_vector_mask_body(decl, checker) != 0 {
        return 1;
    }
    if decl.fn_decl_body.block_stmt_count == 1 && decl.fn_decl_body.block_stmts != null {
        const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
        if stmt != null && stmt.type == ASTNodeType.AST_RETURN_STMT && stmt.return_stmt_expr == null {
            return 1;
        }
    }
    var const_value: i32 = 0;
    const const_expr: &ASTNode = native_build_hosted_return_i32_const_expr(decl,
        &const_value);
    if const_expr != null && checker != null {
        var type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        if native_build_hosted_ensure_expr_type_id(checker, const_expr, &type_id) == 0 {
            return 1;
        }
    }
    const call_expr: &ASTNode = native_build_hosted_return_call_expr(decl);
    if native_build_decl_is_noarg_i32_fn(decl) != 0 && call_expr != null && checker != null {
        var call_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        var target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
        var target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
        if native_build_hosted_return_call_target(program, call_expr, &target_function_id,
            &target_decl_index) != 0 &&
           native_build_hosted_ensure_expr_type_id(checker, call_expr, &call_type_id) == 0 {
            return 1;
        }
    }
    var left_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var left_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var right_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var right_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    const add_expr: &ASTNode = native_build_hosted_return_add_zero_arg_calls_expr(program,
        decl, &left_function_id, &left_decl_index, &right_function_id,
        &right_decl_index);
    if native_build_decl_is_noarg_i32_fn(decl) != 0 && add_expr != null &&
       checker != null {
        var add_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        var left_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        var right_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        if native_build_hosted_ensure_expr_type_id(checker, add_expr,
            &add_type_id) == 0 &&
           native_build_hosted_ensure_expr_type_id(checker, add_expr.binary_expr_left,
            &left_type_id) == 0 &&
           native_build_hosted_ensure_expr_type_id(checker, add_expr.binary_expr_right,
            &right_type_id) == 0 {
            return 1;
        }
    }
    var extern_target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var extern_target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var extern_arg0: i32 = 0;
    var extern_arg1: i32 = 0;
    const extern_call_expr: &ASTNode = native_build_hosted_return_extern_const2_call_expr(program,
        decl, &extern_target_function_id, &extern_target_decl_index, &extern_arg0, &extern_arg1);
    if extern_call_expr != null && checker != null && extern_call_expr.call_expr_args != null {
        var extern_call_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        var extern_arg0_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        var extern_arg1_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        if native_build_hosted_ensure_expr_type_id(checker, extern_call_expr,
            &extern_call_type_id) == 0 &&
           native_build_hosted_ensure_expr_type_id(checker, extern_call_expr.call_expr_args[0],
            &extern_arg0_type_id) == 0 &&
           native_build_hosted_ensure_expr_type_id(checker, extern_call_expr.call_expr_args[1],
            &extern_arg1_type_id) == 0 {
            return 1;
        }
    }
    return 0;
}

