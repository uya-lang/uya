       lowered_program_append_core_stmt(lowered, &local_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &if_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &ok_return_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &fallback_return_stmt) != 0 {
        return -1;
    }
    return 0;
}

fn native_build_hosted_coreir_append_defer_local_assign_body(lowered: &LoweredProgram,
    checker: &TypeChecker, function_id: i32, decl_index: i32,
    decl: &ASTNode) i32 {
    if lowered == null || checker == null || decl == null {
        return -1;
    }
    var shape: NativeBuildDeferLocalAssignShape = native_build_defer_local_assign_shape_empty();
    if native_build_decl_defer_local_assign_shape(decl, &shape) == 0 ||
       shape.local_decl == null || shape.local_decl.var_decl_init == null ||
       shape.assign_stmt == null || shape.assign_stmt.assign_src == null ||
       shape.return_stmt == null || shape.return_stmt.return_stmt_expr == null {
