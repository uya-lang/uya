fn native_build_hosted_mir_append_program_safe_bodies(module: &PortableMirModule,
    checker: &TypeChecker, program: &ASTNode, out_mir_body_function_count: &i32) i32 {
    if out_mir_body_function_count != null {
        *out_mir_body_function_count = 0;
    }
    if module == null || checker == null || program == null ||
       program.type != ASTNodeType.AST_PROGRAM || program.program_decls == null ||
       out_mir_body_function_count == null {
        return -1;
    }
    var i: i32 = 0;
    var lowered_function_id: i32 = 0;
    var source_core_body_id: i32 = 0;
    var body_function_count: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            const has_prefix_body: i32 = native_build_hosted_decl_can_materialize_main_prefix_body(program, decl, checker);
            const has_entry_prefix_body: i32 =
                native_build_hosted_decl_can_materialize_build_driver_run_entry_prefix_body(program, decl, checker);
            const has_safe_core_body: i32 = native_build_hosted_decl_can_materialize_safe_core_body(program, decl, checker);
            if has_prefix_body != 0 || has_entry_prefix_body != 0 ||
               has_safe_core_body != 0 {
                if has_prefix_body != 0 {
                    if native_build_hosted_mir_append_main_prefix_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if has_entry_prefix_body != 0 {
                    if native_build_hosted_mir_append_build_driver_run_entry_prefix_body_function(
                        module, checker, program, lowered_function_id, i, source_core_body_id,
                        decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_void_mir_body(decl) != 0 {
                    if native_build_hosted_mir_append_void_body_function(module,
                        lowered_function_id, i, source_core_body_id) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_int_literal_mir_body(decl) != 0 {
                    if native_build_hosted_mir_append_int_literal_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_call_mir_body(program, decl) != 0 {
                    if native_build_hosted_mir_append_call_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_add_zero_arg_calls_mir_body(program,
                    decl) != 0 {
                    if native_build_hosted_mir_append_add_zero_arg_calls_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_extern_const2_call_mir_body(program,
                    decl) != 0 {
                    if native_build_hosted_mir_append_extern_const2_call_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_local_array_index_mir_body(decl,
                    checker) != 0 {
                    if native_build_hosted_mir_append_local_array_index_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_const_slice_index_sum_mir_body(decl,
                    checker) != 0 {
                    if native_build_hosted_mir_append_const_slice_index_sum_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_const_catch_sum_mir_body(program,
                    decl, checker) != 0 {
                    if native_build_hosted_mir_append_const_catch_sum_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_dynamic_catch_mir_body(program,
                    decl, checker) != 0 {
                    if native_build_hosted_mir_append_dynamic_catch_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_defer_local_assign_mir_body(decl,
                    checker) != 0 {
                    if native_build_hosted_mir_append_defer_local_assign_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_lexical_drop_mir_body(program,
                    decl, checker) != 0 {
                    if native_build_hosted_mir_append_lexical_drop_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_interface_method_mir_body(program,
                    decl, checker) != 0 {
                    if native_build_hosted_mir_append_interface_method_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_atomic_i32_mir_body(decl,
                    checker) != 0 {
                    if native_build_hosted_mir_append_atomic_i32_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_simd_vector_mask_mir_body(decl,
                    checker) != 0 {
                    if native_build_hosted_mir_append_simd_vector_mask_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_main_local_if_mir_body(program,
                    decl, checker) != 0 {
                    if native_build_hosted_mir_append_main_local_if_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                }
                source_core_body_id = source_core_body_id + 1;
            }
            lowered_function_id = lowered_function_id + 1;
        }
        i = i + 1;
    }
    *out_mir_body_function_count = body_function_count;
    return 0;
}

fn native_build_hosted_link_plan_add_program_externs(plan: &NativeHostedLinkPlan,
    program: &ASTNode, out_extern_symbol_count: &i32) i32 {
    if out_extern_symbol_count != null {
        *out_extern_symbol_count = 0;
    }
    if plan == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_extern_symbol_count == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_extern != 0 {
            if native_hosted_link_plan_add_extern_symbol(plan, i) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    *out_extern_symbol_count = plan.extern_symbol_count;
    return 0;
}

fn native_build_hosted_portable_mir_preflight(arena: &CompilerArena, checker: &TypeChecker,
    program: &ASTNode, c_import_count: i32, result: &NativeHostedMirPreflightResult) i32 {
    native_build_hosted_preflight_result_reset(result);
    if arena == null || checker == null || program == null || result == null || c_import_count < 0 {
        return -1;
    }
    if native_build_hosted_coreir_preflight(arena, checker, program, result) != 0 {
        return -1;
    }
    var module: PortableMirModule = native_build_empty_portable_mir_module();
    portable_mir_module_init(&module, arena);
    if native_build_hosted_mir_append_program_externs(&module, program,
        &result.mir_extern_function_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    if native_build_hosted_mir_append_program_safe_bodies(&module, checker, program,
        &result.mir_body_function_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    result.mir_type_count = module.type_count as i32;
    var verifier: MirVerifierResult = MirVerifierResult{
        error_code: -1,
        function_id: MIR_FUNCTION_INVALID_ID,
        block_id: MIR_BLOCK_INVALID_ID,
        inst_id: MIR_INST_INVALID_ID,
        value_id: MIR_VALUE_INVALID_ID,
        type_id: MIR_TYPE_INVALID_ID,
        operand_id: -1,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
    };
    portable_mir_verifier_result_init(&verifier);
    if portable_mir_verify_module(&module, &verifier) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var request: MirTargetBackendRequest = native_build_empty_mir_backend_request();
    if portable_mir_backend_request_init(&request, &module, &verifier,
        MIR_TARGET_BACKEND_MACHINE) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var plan: NativeHostedLinkPlan = native_hosted_link_plan_empty();
    if native_hosted_link_plan_init(&plan, &request) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    if native_build_hosted_link_plan_add_program_externs(&plan, program,
        &result.extern_symbol_count) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var imported: i32 = 0;
    while imported < c_import_count {
        if native_hosted_link_plan_add_c_import_object(&plan) != 0 {
            result.verifier_error = verifier.error_code;
            portable_mir_module_release(&module);
            return -1;
        }
        imported = imported + 1;
    }
    result.verifier_error = verifier.error_code;
    result.object_count = plan.object_count;
    portable_mir_module_release(&module);
    return 0;
}

fn native_build_hosted_mir_function_for_decl(module: &PortableMirModule,
    decl_id: i32) &MirFunction {
    if module == null || decl_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < module.functions.count {
        const function: &MirFunction = semantic_vector_item_ptr(&module.functions,
            i) as &MirFunction;
        if function != null && function.decl_id == decl_id &&
           (function.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 {
            return function;
        }
        i = i + 1usize;
    }
    return null;
}

fn native_build_hosted_mir_block_ptr(module: &PortableMirModule,
    block_id: i32) &MirBlock {
    if module == null || block_id < 0 ||
       (block_id as usize) >= module.blocks.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.blocks, block_id as usize) as &MirBlock;
}

fn native_build_hosted_mir_inst_ptr(module: &PortableMirModule,
    inst_id: i32) &MirInst {
    if module == null || inst_id < 0 ||
       (inst_id as usize) >= module.insts.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.insts, inst_id as usize) as &MirInst;
}

fn native_build_hosted_mir_value_ptr(module: &PortableMirModule,
    value_id: i32) &MirValue {
    if module == null || value_id < 0 ||
       (value_id as usize) >= module.values.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.values, value_id as usize) as &MirValue;
}

fn native_build_hosted_mir_operand_ptr(module: &PortableMirModule,
    operand_id: i32) &MirOperand {
    if module == null || operand_id < 0 ||
       (operand_id as usize) >= module.operands.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.operands, operand_id as usize) as &MirOperand;
}

fn native_build_hosted_mir_terminator_ptr(module: &PortableMirModule,
    terminator_id: i32) &MirTerminator {
    if module == null || terminator_id < 0 ||
       (terminator_id as usize) >= module.terminators.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.terminators,
        terminator_id as usize) as &MirTerminator;
}

fn native_build_hosted_mir_successor_ptr(module: &PortableMirModule,
    successor_id: i32) &MirSuccessor {
    if module == null || successor_id < 0 ||
       (successor_id as usize) >= module.successors.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.successors,
        successor_id as usize) as &MirSuccessor;
}

fn native_build_hosted_mir_function_by_id(module: &PortableMirModule,
    function_id: i32) &MirFunction {
    if module == null || function_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < module.functions.count {
        const function: &MirFunction = semantic_vector_item_ptr(&module.functions,
            i) as &MirFunction;
        if function != null && function.function_id == function_id {
            return function;
        }
        i = i + 1usize;
    }
    return null;
}

fn native_build_hosted_mir_return_value_id(module: &PortableMirModule,
    function: &MirFunction, out_value_id: &i32) i32 {
    if out_value_id != null {
        *out_value_id = MIR_VALUE_INVALID_ID;
    }
    if module == null || function == null || out_value_id == null ||
       function.block_count != 1 {
        return 0;
    }
    const block: &MirBlock = native_build_hosted_mir_block_ptr(module,
        function.block_start);
    if block == null || block.terminator_id < 0 ||
       (block.terminator_id as usize) >= module.terminators.count {
        return 0;
    }
    const terminator: &MirTerminator = semantic_vector_item_ptr(&module.terminators,
        block.terminator_id as usize) as &MirTerminator;
    if terminator == null || terminator.kind != MIR_TERMINATOR_KIND_RETURN ||
       terminator.operand_count != 1 {
        return 0;
    }
    const operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        terminator.operand_start);
    if operand == null || operand.value_id == MIR_VALUE_INVALID_ID {
        return 0;
    }
    *out_value_id = operand.value_id;
    return 1;
}

fn native_build_hosted_mir_eval_value_i32(module: &PortableMirModule,
    value_id: i32, depth: i32, out_value: &i32) i32 {
    if out_value != null {
        *out_value = 0;
    }
    if module == null || out_value == null || value_id == MIR_VALUE_INVALID_ID ||
       depth > 16 {
        return 0;
    }
    const value: &MirValue = native_build_hosted_mir_value_ptr(module, value_id);
    if value == null || value.defining_inst_id == MIR_INST_INVALID_ID {
        return 0;
    }
    const inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        value.defining_inst_id);
    if inst == null || inst.result_value_id != value_id {
        return 0;
    }
    if inst.op == MIR_INST_OP_NOP {
        if inst.flags < 0 || inst.flags > 255 {
            return 0;
        }
        *out_value = inst.flags;
        return 1;
    }
    if inst.op == MIR_INST_OP_LOAD {
        if inst.flags < 0 || inst.flags > 255 {
            return 0;
        }
        *out_value = inst.flags;
        return 1;
    }
    if inst.op == MIR_INST_OP_CALL && inst.operand_count >= 1 {
        if inst.flags >= 0 {
            const callee_by_decl: &MirFunction = native_build_hosted_mir_function_for_decl(module,
                inst.flags);
            if callee_by_decl != null {
                return native_build_hosted_mir_eval_function_exit_code(module,
                    callee_by_decl, depth + 1, out_value);
            }
        }
        const call_target: &MirOperand = native_build_hosted_mir_operand_ptr(module,
            inst.operand_start);
        if call_target == null {
            return 0;
        }
        const callee: &MirFunction = native_build_hosted_mir_function_by_id(module,
            call_target.immediate_i32);
        return native_build_hosted_mir_eval_function_exit_code(module, callee,
            depth + 1, out_value);
    }
    if inst.op == MIR_INST_OP_I32_ADD && inst.operand_count == 2 {
        const left_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
            inst.operand_start);
        const right_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
            inst.operand_start + 1);
        if left_operand == null || right_operand == null ||
           left_operand.value_id == MIR_VALUE_INVALID_ID ||
           right_operand.value_id == MIR_VALUE_INVALID_ID {
            return 0;
        }
        var left_value: i32 = 0;
        var right_value: i32 = 0;
        if native_build_hosted_mir_eval_value_i32(module, left_operand.value_id,
            depth + 1, &left_value) == 0 ||
           native_build_hosted_mir_eval_value_i32(module, right_operand.value_id,
            depth + 1, &right_value) == 0 {
            return 0;
        }
        const sum: i32 = left_value + right_value;
        if sum < 0 || sum > 255 {
            return 0;
        }
        *out_value = sum;
        return 1;
    }
    return 0;
}

fn native_build_hosted_mir_eval_function_exit_code(module: &PortableMirModule,
    function: &MirFunction, depth: i32, out_code: &i32) i32 {
    if out_code != null {
        *out_code = 0;
    }
    if module == null || function == null || out_code == null || depth > 16 {
        return 0;
    }
    var value_id: i32 = MIR_VALUE_INVALID_ID;
    if native_build_hosted_mir_return_value_id(module, function, &value_id) == 0 {
        return 0;
    }
    return native_build_hosted_mir_eval_value_i32(module, value_id, depth, out_code);
}

fn native_build_hosted_mir_block_return_const(module: &PortableMirModule,
    block_id: i32, out_value: &i32) i32 {
    if out_value != null {
        *out_value = 0;
    }
    if module == null || out_value == null {
        return 0;
    }
    const block: &MirBlock = native_build_hosted_mir_block_ptr(module, block_id);
    if block == null || block.inst_count != 1 {
        return 0;
    }
    const inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        block.inst_start);
    if inst == null || inst.op != MIR_INST_OP_NOP ||
       inst.result_value_id == MIR_VALUE_INVALID_ID ||
       inst.flags < 0 || inst.flags > 255 {
        return 0;
    }
    const terminator: &MirTerminator = native_build_hosted_mir_terminator_ptr(module,
        block.terminator_id);
    if terminator == null || terminator.kind != MIR_TERMINATOR_KIND_RETURN ||
       terminator.operand_count != 1 {
        return 0;
    }
    const operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        terminator.operand_start);
    if operand == null || operand.value_id != inst.result_value_id {
        return 0;
    }
    *out_value = inst.flags;
    return 1;
}

fn native_build_hosted_mir_dynamic_catch_function_shape(module: &PortableMirModule,
    function: &MirFunction, shape: &NativeBuildDynamicCatchShape) i32 {
    if module == null || function == null || shape == null ||
       function.block_count != 3 {
        return 0;
    }
    const entry_block: &MirBlock = native_build_hosted_mir_block_ptr(module,
        function.entry_block_id);
    if entry_block == null || entry_block.inst_count != 2 {
        return 0;
    }
    const call_inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        entry_block.inst_start);
    const cond_inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        entry_block.inst_start + 1);
    if call_inst == null || cond_inst == null ||
       call_inst.op != MIR_INST_OP_CALL ||
       cond_inst.op != MIR_INST_OP_NOP ||
       call_inst.result_value_id == MIR_VALUE_INVALID_ID ||
       cond_inst.result_value_id == MIR_VALUE_INVALID_ID ||
       cond_inst.operand_count != 1 ||
       cond_inst.flags != shape.compare_value {
        return 0;
    }
    const cond_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        cond_inst.operand_start);
    if cond_operand == null || cond_operand.value_id != call_inst.result_value_id ||
       cond_operand.local_id == MIR_LOCAL_INVALID_ID ||
       cond_operand.immediate_i32 != shape.compare_value {
        return 0;
    }
    const entry_terminator: &MirTerminator = native_build_hosted_mir_terminator_ptr(module,
        entry_block.terminator_id);
    if entry_terminator == null ||
       entry_terminator.kind != MIR_TERMINATOR_KIND_COND_BR ||
       entry_terminator.operand_count != 1 ||
       entry_terminator.successor_count != 2 {
        return 0;
    }
    const cond_term_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        entry_terminator.operand_start);
    if cond_term_operand == null ||
       cond_term_operand.value_id != cond_inst.result_value_id {
        return 0;
    }
    const ok_successor: &MirSuccessor = native_build_hosted_mir_successor_ptr(module,
        entry_terminator.successor_start);
    const fallback_successor: &MirSuccessor = native_build_hosted_mir_successor_ptr(module,
        entry_terminator.successor_start + 1);
    if ok_successor == null || fallback_successor == null {
        return 0;
    }
    var ok_value: i32 = 0;
    var fallback_value: i32 = 0;
    if native_build_hosted_mir_block_return_const(module, ok_successor.block_id,
        &ok_value) == 0 ||
       native_build_hosted_mir_block_return_const(module, fallback_successor.block_id,
        &fallback_value) == 0 ||
       ok_value != shape.ok_value || fallback_value != shape.fallback_value {
        return 0;
    }
    return 1;
}

fn native_build_hosted_mir_local_array_index_return_value(module: &PortableMirModule,
    function: &MirFunction, out_value: &i32) i32 {
    if out_value != null {
        *out_value = 0;
    }
    if module == null || function == null || out_value == null ||
       function.block_count != 1 {
        return 0;
    }
    const block: &MirBlock = native_build_hosted_mir_block_ptr(module,
        function.block_start);
    if block == null || block.inst_count != 3 {
        return 0;
    }
    const index_inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        block.inst_start);
    const addr_inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        block.inst_start + 1);
    const load_inst: &MirInst = native_build_hosted_mir_inst_ptr(module,
        block.inst_start + 2);
    if index_inst == null || addr_inst == null || load_inst == null ||
       index_inst.op != MIR_INST_OP_NOP ||
       addr_inst.op != MIR_INST_OP_INDEX_ADDR ||
       load_inst.op != MIR_INST_OP_LOAD ||
       addr_inst.operand_count != 2 ||
       load_inst.operand_count != 1 ||
       load_inst.result_value_id == MIR_VALUE_INVALID_ID {
        return 0;
    }
    const index_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        addr_inst.operand_start + 1);
    const load_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        load_inst.operand_start);
    if index_operand == null || load_operand == null ||
       index_operand.value_id != index_inst.result_value_id ||
       load_operand.value_id != addr_inst.result_value_id {
        return 0;
    }
    if block.terminator_id < 0 ||
       (block.terminator_id as usize) >= module.terminators.count {
        return 0;
    }
    const terminator: &MirTerminator = semantic_vector_item_ptr(&module.terminators,
        block.terminator_id as usize) as &MirTerminator;
    if terminator == null || terminator.kind != MIR_TERMINATOR_KIND_RETURN ||
       terminator.operand_count != 1 {
        return 0;
    }
    const return_operand: &MirOperand = native_build_hosted_mir_operand_ptr(module,
        terminator.operand_start);
    if return_operand == null || return_operand.value_id != load_inst.result_value_id ||
       load_inst.flags < 0 || load_inst.flags > 255 {
        return 0;
    }
    *out_value = load_inst.flags;
    return 1;
}

fn native_build_hosted_verified_mir_local_array_index_return_value(arena: &CompilerArena,
    checker: &TypeChecker, program: &ASTNode, out_value: &i32) i32 {
    if out_value != null {
        *out_value = 0;
    }
    if arena == null || checker == null || program == null || out_value == null {
        return -1;
    }
    const main_decl_index: i32 = native_build_find_function_decl_index(program,
        "main" as &byte);
    if main_decl_index < 0 {
        return 0;
    }
    var module: PortableMirModule = native_build_empty_portable_mir_module();
    portable_mir_module_init(&module, arena);
    var extern_count: i32 = 0;
    if native_build_hosted_mir_append_program_externs(&module, program,
        &extern_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var body_count: i32 = 0;
    if native_build_hosted_mir_append_program_safe_bodies(&module, checker,
        program, &body_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    if body_count <= 0 {
        portable_mir_module_release(&module);
        return 0;
    }
    var verifier: MirVerifierResult = MirVerifierResult{
        error_code: -1,
        function_id: MIR_FUNCTION_INVALID_ID,
        block_id: MIR_BLOCK_INVALID_ID,
        inst_id: MIR_INST_INVALID_ID,
        value_id: MIR_VALUE_INVALID_ID,
        type_id: MIR_TYPE_INVALID_ID,
        operand_id: -1,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
    };
    portable_mir_verifier_result_init(&verifier);
    if portable_mir_verify_module(&module, &verifier) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var request: MirTargetBackendRequest = native_build_empty_mir_backend_request();
    if portable_mir_backend_request_init(&request, &module, &verifier,
        MIR_TARGET_BACKEND_MACHINE) != 0 ||
       portable_mir_backend_request_is_verified(&request) == 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    const function: &MirFunction = native_build_hosted_mir_function_for_decl(&module,
        main_decl_index);
    const ok: i32 = native_build_hosted_mir_local_array_index_return_value(&module,
        function, out_value);
    portable_mir_module_release(&module);
    return ok;
}

fn native_build_hosted_verified_mir_main_exit_code(arena: &CompilerArena,
    checker: &TypeChecker, program: &ASTNode, out_code: &i32) i32 {
    if out_code != null {
        *out_code = 0;
    }
    if arena == null || checker == null || program == null || out_code == null {
        return -1;
    }
    const main_decl_index: i32 = native_build_find_function_decl_index(program,
        "main" as &byte);
    if main_decl_index < 0 {
        return 0;
    }
    var module: PortableMirModule = native_build_empty_portable_mir_module();
    portable_mir_module_init(&module, arena);
    var extern_count: i32 = 0;
    if native_build_hosted_mir_append_program_externs(&module, program,
        &extern_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var body_count: i32 = 0;
    if native_build_hosted_mir_append_program_safe_bodies(&module, checker,
        program, &body_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    if body_count <= 0 {
        portable_mir_module_release(&module);
        return 0;
    }
    var verifier: MirVerifierResult = MirVerifierResult{
        error_code: -1,
        function_id: MIR_FUNCTION_INVALID_ID,
        block_id: MIR_BLOCK_INVALID_ID,
        inst_id: MIR_INST_INVALID_ID,
        value_id: MIR_VALUE_INVALID_ID,
        type_id: MIR_TYPE_INVALID_ID,
        operand_id: -1,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
    };
    portable_mir_verifier_result_init(&verifier);
    if portable_mir_verify_module(&module, &verifier) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var request: MirTargetBackendRequest = native_build_empty_mir_backend_request();
    if portable_mir_backend_request_init(&request, &module, &verifier,
        MIR_TARGET_BACKEND_MACHINE) != 0 ||
       portable_mir_backend_request_is_verified(&request) == 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var plan: NativeHostedLinkPlan = native_hosted_link_plan_empty();
    if native_hosted_link_plan_init(&plan, &request) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    const main_function: &MirFunction = native_build_hosted_mir_function_for_decl(&module,
        main_decl_index);
    const ok: i32 = native_build_hosted_mir_eval_function_exit_code(&module,
        main_function, 0, out_code);
    portable_mir_module_release(&module);
    return ok;
}

fn native_build_hosted_verified_mir_dynamic_catch_shape(arena: &CompilerArena,
    checker: &TypeChecker, program: &ASTNode,
    out_shape: &NativeBuildDynamicCatchShape) i32 {
    if out_shape != null {
        *out_shape = native_build_dynamic_catch_shape_empty();
    }
    if arena == null || checker == null || program == null || out_shape == null {
        return -1;
    }
    const main_decl_index: i32 = native_build_find_function_decl_index(program,
        "main" as &byte);
    if main_decl_index < 0 || program.program_decls == null {
        return 0;
    }
    const main_decl: &ASTNode = program.program_decls[main_decl_index];
    var shape: NativeBuildDynamicCatchShape = native_build_dynamic_catch_shape_empty();
    if native_build_decl_dynamic_catch_argc_shape(program, main_decl, &shape) == 0 {
        return 0;
    }
    var module: PortableMirModule = native_build_empty_portable_mir_module();
    portable_mir_module_init(&module, arena);
    var extern_count: i32 = 0;
    if native_build_hosted_mir_append_program_externs(&module, program,
        &extern_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var body_count: i32 = 0;
    if native_build_hosted_mir_append_program_safe_bodies(&module, checker,
        program, &body_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    if body_count <= 0 {
        portable_mir_module_release(&module);
        return 0;
    }
    var verifier: MirVerifierResult = MirVerifierResult{
        error_code: -1,
        function_id: MIR_FUNCTION_INVALID_ID,
        block_id: MIR_BLOCK_INVALID_ID,
        inst_id: MIR_INST_INVALID_ID,
        value_id: MIR_VALUE_INVALID_ID,
        type_id: MIR_TYPE_INVALID_ID,
        operand_id: -1,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
    };
    portable_mir_verifier_result_init(&verifier);
    if portable_mir_verify_module(&module, &verifier) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    var request: MirTargetBackendRequest = native_build_empty_mir_backend_request();
    if portable_mir_backend_request_init(&request, &module, &verifier,
        MIR_TARGET_BACKEND_MACHINE) != 0 ||
       portable_mir_backend_request_is_verified(&request) == 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    const main_function: &MirFunction = native_build_hosted_mir_function_for_decl(&module,
        main_decl_index);
    const ok: i32 = native_build_hosted_mir_dynamic_catch_function_shape(&module,
        main_function, &shape);
    if ok != 0 {
        *out_shape = shape;
    }
    portable_mir_module_release(&module);
    return ok;
}

fn native_build_print_hosted_preflight_summary(c_import_count: i32, preflight_status: i32,
    result: &NativeHostedMirPreflightResult) void {
    if result == null {
        return;
    }
    fprintf(libc.stderr,
        "native_hosted_coreir_preflight: status=%d verifier_error=%d functions=%d core_bodies=%d pending_bodies=%d\n" as *byte,
        preflight_status, result.core_verifier_error, result.core_function_count,
        result.core_body_count, result.core_pending_body_count);
    fprintf(libc.stderr,
        "native_hosted_preflight: status=%d verifier_error=%d mir_extern_functions=%d mir_body_functions=%d mir_types=%d extern_symbols=%d c_import_objects=%d hosted_link_objects=%d\n" as *byte,
        preflight_status, result.verifier_error, result.mir_extern_function_count,
        result.mir_body_function_count, result.mir_type_count, result.extern_symbol_count,
        c_import_count, result.object_count);
    if result.entry_wrapper_covered != 0 || result.entry_pending_callee_name != null {
        var pending_callee: &byte = "(none)" as &byte;
        if result.entry_pending_callee_name != null {
            pending_callee = result.entry_pending_callee_name;
        }
        var next_kind: &byte = "<none>" as &byte;
        if result.entry_pending_callee_next_stmt_kind != null {
            next_kind = result.entry_pending_callee_next_stmt_kind;
        }
        fprintf(libc.stderr,
            "native_hosted_entry_frontier: wrapper_covered=%d first_pending_callee=%s first_pending_callee_prefix=%d first_pending_callee_prefix_stmts=%d first_pending_callee_next_stmt=%d first_pending_callee_next_kind=%s\n" as *byte,
            result.entry_wrapper_covered, pending_callee as *byte,
            result.entry_pending_callee_prefix_covered,
            result.entry_pending_callee_prefix_stmt_count,
            result.entry_pending_callee_next_stmt_index, next_kind as *byte);
    }
}

fn native_build_print_hosted_portable_mir_lowering_missing(c_import_count: i32, preflight_status: i32,
    result: &NativeHostedMirPreflightResult) void {
    if result == null {
        return;
    }
    native_build_print_hosted_preflight_summary(c_import_count, preflight_status, result);
    if preflight_status != 0 || result.core_verifier_error != 0 || result.verifier_error != 0 {
        fprintf(libc.stderr,
            "native_unsupported_hosted_path: reason=native_hosted_portable_mir_preflight_failed required=verifier-clean CoreBody+PortableMIR self-build coverage\n" as *byte);
        fprintf(libc.stderr,
            "native_hosted_portable_mir_frontier: preflight_status=%d core_verifier_error=%d mir_verifier_error=%d core_bodies=%d pending_bodies=%d\n" as *byte,
            preflight_status, result.core_verifier_error, result.verifier_error,
            result.core_body_count, result.core_pending_body_count);
        if result.core_verifier_error == COREIR_VERIFY_ERR_INVALID_BODY_RANGE {
            fprintf(libc.stderr,
                "native_hosted_portable_mir_frontier: coreir_error=COREIR_VERIFY_ERR_INVALID_BODY_RANGE\n" as *byte);
        }
        fprintf(libc.stderr,
            "错误: hosted native backend 已进入 CoreBody/PortableMIR preflight，但 CoreIR/MIR 尚未 verifier-clean；不能静默回落 C99，也不能使用 build-seed LoweredProgram helper\n" as *byte);
        return;
    }
    if result.core_pending_body_count > 0 {
        var entry_coverage: &byte = "not_verified" as &byte;
        if result.entry_pending_callee_prefix_covered != 0 {
            entry_coverage = "partial_prefix" as &byte;
        }
        fprintf(libc.stderr,
            "native_hosted_handoff_frontier: reason=pending_core_bodies mir_body_functions=%d extern_symbols=%d pending_bodies=%d entry_callee_coverage=%s\n" as *byte,
            result.mir_body_function_count, result.extern_symbol_count,
            result.core_pending_body_count, entry_coverage as *byte);
    }
    fprintf(libc.stderr,
        "native_unsupported_hosted_path: reason=native_hosted_portable_mir_lowering_missing required=CoreBody+PortableMIR function-body lowering\n" as *byte);
    fprintf(libc.stderr,
        "错误: hosted native backend 已完成 PortableMIR/NativeHostedLinkPlan preflight，但尚未接入函数体 MIR lowering；build-seed LoweredProgram helper 仅限 --nostdlib freestanding 子集\n" as *byte);
}

fn native_build_find_extern_two_i32_param_function(program: &ASTNode, name: &byte) &ASTNode {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return null;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if native_build_decl_is_extern_two_i32_param_fn(decl) != 0 &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name as *byte, name as *byte) != 0 {
            return decl;
        }
        i = i + 1;
    }
    return null;
}

fn native_build_hosted_main_return_extern_const2_call(program: &ASTNode,
    out_extern_name: & & byte, out_arg0: &i32, out_arg1: &i32) i32 {
    if out_extern_name != null {
        *out_extern_name = null;
    }
    if out_arg0 != null {
        *out_arg0 = 0;
    }
    if out_arg1 != null {
        *out_arg1 = 0;
    }
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_extern_name == null ||
       out_arg0 == null || out_arg1 == null {
        return 0;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if native_build_decl_is_noarg_i32_fn(decl) != 0 &&
           decl.fn_decl_name != null &&
           str_equals(decl.fn_decl_name as *byte, "main" as *byte) != 0 &&
           decl.fn_decl_body != null && decl.fn_decl_body.type == ASTNodeType.AST_BLOCK &&
           decl.fn_decl_body.block_stmt_count == 1 && decl.fn_decl_body.block_stmts != null {
            const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
            if stmt != null && stmt.type == ASTNodeType.AST_RETURN_STMT &&
               stmt.return_stmt_expr != null && stmt.return_stmt_expr.type == ASTNodeType.AST_CALL_EXPR {
                const call: &ASTNode = stmt.return_stmt_expr;
                if native_build_hosted_const2_extern_call_args(program, call,
                    out_extern_name, out_arg0, out_arg1) != 0 {
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn native_build_hosted_const2_extern_call_args(program: &ASTNode, call: &ASTNode,
    out_extern_name: & & byte, out_arg0: &i32, out_arg1: &i32) i32 {
    if call == null || call.type != ASTNodeType.AST_CALL_EXPR ||
       call.call_expr_arg_count != 2 || call.call_expr_type_arg_count != 0 ||
       call.call_expr_callee == null ||
       call.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER ||
       call.call_expr_callee.identifier_name == null ||
       call.call_expr_args == null {
        return 0;
    }
    const arg0_node: &ASTNode = call.call_expr_args[0];
    const arg1_node: &ASTNode = call.call_expr_args[1];
    if arg0_node == null || arg1_node == null ||
       arg0_node.type != ASTNodeType.AST_NUMBER ||
       arg1_node.type != ASTNodeType.AST_NUMBER {
        return 0;
    }
    if native_build_find_extern_two_i32_param_function(program,
        call.call_expr_callee.identifier_name) == null {
        return 0;
    }
    const arg0_result: !i32 = arg0_node.number_value_i64 as! i32;
    const arg1_result: !i32 = arg1_node.number_value_i64 as! i32;
    *out_arg0 = arg0_result catch {
        return 0;
    };
    *out_arg1 = arg1_result catch {
        return 0;
    };
    *out_extern_name = call.call_expr_callee.identifier_name;
    return 1;
}

fn native_build_hosted_fill_asm_path(buf: &byte, cap: usize) i32 {
    return host_fill_temp_path(buf, cap, "uya_hosted_native" as &byte, ".s" as &byte, -1);
}

fn native_build_hosted_fill_object_path(buf: &byte, cap: usize) i32 {
    return host_fill_temp_path(buf, cap, "uya_hosted_native" as &byte, ".o" as &byte, -1);
}

fn native_build_hosted_fill_c_import_object_path(buf: &byte, cap: usize, index: i32) i32 {
    return host_fill_temp_path(buf, cap, "uya_hosted_cimport" as &byte, ".o" as &byte, index);
}

fn native_build_hosted_write_extern_const2_asm(path: &byte, extern_name: &byte,
    arg0: i32, arg1: i32) i32 {
    if path == null || extern_name == null {
        return -1;
    }
    const file: &void = fopen(path as *byte, "w" as *byte) as &void;
    if file == null {
        return -1;
    }
    fputs(".text\n" as *byte, file as *void);
    fprintf(file as *void, ".extern %s\n" as *byte, extern_name as *byte);
    fputs(".globl main\n" as *byte, file as *void);
    fputs(".type main, @function\n" as *byte, file as *void);
    fputs("main:\n" as *byte, file as *void);
    fputs("    pushq %rbp\n" as *byte, file as *void);
    fputs("    movq %rsp, %rbp\n" as *byte, file as *void);
    fprintf(file as *void, "    movl $%d, %%edi\n" as *byte, arg0);
    fprintf(file as *void, "    movl $%d, %%esi\n" as *byte, arg1);
    fprintf(file as *void, "    call %s\n" as *byte, extern_name as *byte);
    fputs("    popq %rbp\n" as *byte, file as *void);
    fputs("    ret\n" as *byte, file as *void);
    fputs(".size main, .-main\n" as *byte, file as *void);
    fputs(".section .note.GNU-stack,\"\",@progbits\n" as *byte, file as *void);
    fclose(file as *void);
    return 0;
}

fn native_build_hosted_write_const_return_asm(path: &byte, return_value: i32) i32 {
    if path == null {
        return -1;
    }
    const file: &void = fopen(path as *byte, "w" as *byte) as &void;
    if file == null {
        return -1;
    }
    fputs(".text\n" as *byte, file as *void);
    fputs(".globl main\n" as *byte, file as *void);
    fputs(".type main, @function\n" as *byte, file as *void);
    fputs("main:\n" as *byte, file as *void);
    fprintf(file as *void, "    movl $%d, %%eax\n" as *byte, return_value);
    fputs("    ret\n" as *byte, file as *void);
    fputs(".size main, .-main\n" as *byte, file as *void);
    fputs(".section .note.GNU-stack,\"\",@progbits\n" as *byte, file as *void);
    fclose(file as *void);
    return 0;
}

fn native_build_hosted_write_dynamic_catch_asm(path: &byte,
    compare_value: i32, fallback_value: i32, ok_value: i32) i32 {
    if path == null {
        return -1;
    }
    const file: &void = fopen(path as *byte, "w" as *byte) as &void;
    if file == null {
        return -1;
    }
    fputs(".text\n" as *byte, file as *void);
    fputs(".globl main\n" as *byte, file as *void);
    fputs(".type main, @function\n" as *byte, file as *void);
    fputs("main:\n" as *byte, file as *void);
    fprintf(file as *void, "    cmpl $%d, %%edi\n" as *byte, compare_value);
    fputs("    je .Luya_dynamic_catch_fallback\n" as *byte, file as *void);
    fprintf(file as *void, "    movl $%d, %%eax\n" as *byte, ok_value);
    fputs("    ret\n" as *byte, file as *void);
    fputs(".Luya_dynamic_catch_fallback:\n" as *byte, file as *void);
    fprintf(file as *void, "    movl $%d, %%eax\n" as *byte, fallback_value);
    fputs("    ret\n" as *byte, file as *void);
    fputs(".size main, .-main\n" as *byte, file as *void);
    fputs(".section .note.GNU-stack,\"\",@progbits\n" as *byte, file as *void);
    fclose(file as *void);
    return 0;
}

fn native_build_hosted_compile_asm_to_object(cc_driver: &byte, target_flags: &byte,
    asm_path: &byte, object_path: &byte) i32 {
    if cc_driver == null || asm_path == null || object_path == null {
        return 1;
    }
    var cmd: [byte: 32768] = [];
    var cmd_len: i32 = 0;
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, cc_driver) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, target_flags) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-c" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, asm_path) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-o" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, object_path) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native assembly 编译命令失败\n" as *byte);
        return 1;
    }
    fprintf(libc.stderr, "信息：编译 hosted native assembly：%s\n" as *byte, &cmd[0] as *byte);
    if system(&cmd[0] as *byte) != 0 {
        fprintf(libc.stderr, "错误：hosted native assembly 编译失败: %s\n" as *byte, asm_path as *byte);
        return 1;
    }
    return 0;
}

fn native_build_hosted_link_single_object(cc_driver: &byte, target_flags: &byte,
    native_obj: &byte, output_file: &byte) i32 {
    if cc_driver == null || native_obj == null || output_file == null {
        return 1;
    }
    c99_mkdir_p_for_file(output_file);
    var cmd: [byte: 32768] = [];
    var cmd_len: i32 = 0;
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, cc_driver) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, target_flags) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, native_obj) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-o" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, output_file) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    const ldflags: &byte = get_env_or_default("LDFLAGS" as *byte, "" as *byte);
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, ldflags) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    fprintf(libc.stderr, "信息：调用 hosted native linker：%s\n" as *byte, &cmd[0] as *byte);
    if system(&cmd[0] as *byte) != 0 {
        fprintf(libc.stderr, "错误：hosted native 链接失败\n" as *byte);
        return 1;
    }
    return 0;
}

fn native_build_hosted_cleanup_c_import_objects(count: i32) void {
    var i: i32 = 0;
    while i < count {
        var item_obj: [byte: PATH_MAX] = [];
        if native_build_hosted_fill_c_import_object_path(&item_obj[0] as &byte,
            PATH_MAX, i) == 0 {
            unlink(&item_obj[0] as *byte);
        }
        i = i + 1;
    }
}

fn native_build_hosted_link_objects(cc_driver: &byte, target_flags: &byte,
    native_obj: &byte, output_file: &byte, plan: &CImportPlan) i32 {
    if cc_driver == null || native_obj == null || output_file == null ||
       plan == null {
        return 1;
    }
    c99_mkdir_p_for_file(output_file);
    var cmd: [byte: 32768] = [];
    var cmd_len: i32 = 0;
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, cc_driver) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, target_flags) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, native_obj) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    var i: i32 = 0;
    while i < plan.item_count {
        var item_obj: [byte: PATH_MAX] = [];
        if native_build_hosted_fill_c_import_object_path(&item_obj[0] as &byte,
            PATH_MAX, i) != 0 ||
           shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len,
               &item_obj[0] as &byte) != 0 {
            fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
            return 1;
        }
        i = i + 1;
    }
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-o" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, output_file) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    const ldflags: &byte = get_env_or_default("LDFLAGS" as *byte, "" as *byte);
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, ldflags) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    i = 0;
    while i < plan.aggregated_ldflags_token_count {
        if plan.aggregated_ldflags_tokens != null && plan.aggregated_ldflags_tokens[i] != null {
            if shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len,
                plan.aggregated_ldflags_tokens[i]) != 0 {
                fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
                return 1;
            }
        }
        i = i + 1;
    }
    fprintf(libc.stderr, "信息：调用 hosted native linker：%s\n" as *byte, &cmd[0] as *byte);
    if system(&cmd[0] as *byte) != 0 {
        fprintf(libc.stderr, "错误：hosted native 链接失败\n" as *byte);
        return 1;
    }
    return 0;
}

fn native_build_hosted_output_size(path: &byte) usize {
    if path == null {
        return 0usize;
    }
    var st: Stat = Stat { st_dev: 0, st_ino: 0, st_nlink: 0, st_mode: 0, st_uid: 0, st_gid: 0, _pad0: 0, st_rdev: 0, st_size: 0, st_blksize: 0, st_blocks: 0, st_atime: 0, st_atime_nsec: 0, st_mtime: 0, st_mtime_nsec: 0, st_ctime: 0, st_ctime_nsec: 0, _unused0: 0, _unused1: 0, _unused2: 0 };
    if stat(path as *byte, &st) != 0 || st.st_size < 0 {
        return 0usize;
    }
    return st.st_size as usize;
}

fn native_build_hosted_compile_c_import_objects(cc_driver: &byte, target_flags: &byte,
    cflags: &byte, plan: &CImportPlan) i32 {
    if cc_driver == null || plan == null {
        return 1;
    }
    var i: i32 = 0;
    while i < plan.item_count {
        var item_obj: [byte: PATH_MAX] = [];
        if native_build_hosted_fill_c_import_object_path(&item_obj[0] as &byte,
            PATH_MAX, i) != 0 {
            fprintf(libc.stderr, "错误：无法生成 hosted native @c_import 对象路径\n" as *byte);
            return 1;
        }
        const item: CImportItem = plan.items[i];
        if compile_c_source_to_object(cc_driver, target_flags, cflags, item.resolved_path,
            &item_obj[0] as &byte, item.cflags_tokens, item.cflags_token_count,
            item.resolved_path) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn native_build_hosted_emit_extern_const2_linked_exe(output_file: &byte,
    extern_name: &byte, arg0: i32, arg1: i32, plan: &CImportPlan) i32 {
    var asm_path: [byte: PATH_MAX] = [];
    var native_obj: [byte: PATH_MAX] = [];
    if native_build_hosted_fill_asm_path(&asm_path[0] as &byte, PATH_MAX) != 0 ||
       native_build_hosted_fill_object_path(&native_obj[0] as &byte, PATH_MAX) != 0 {
        fprintf(libc.stderr, "错误：无法生成 hosted native 临时路径\n" as *byte);
        return 1;
    }
    var cc_driver_buffer: [byte: PATH_MAX] = [];
    const cc_driver: &byte = resolve_cc_driver(&cc_driver_buffer[0] as &byte, PATH_MAX);
    const cflags_env: &byte = get_env_or_default("CFLAGS" as *byte,
        "-std=c99 -O0 -g -fno-builtin" as *byte);
    var cflags_clang_buf: [byte: 2048] = [];
    var cflags_buf: [byte: 2048] = [];
    var cflags: &byte = hosted_cflags_add_clang_compat(cflags_env, cc_driver,
        &cflags_clang_buf[0] as &byte, 2048);
    if cc_driver_is_clang_like(cc_driver) == 0 &&
       hosted_cflags_need_no_small_inline(cflags_env) != 0 &&
       hosted_cflags_has_no_small_inline(cflags_env) == 0 {
        const wcf: i32 = snprintf(&cflags_buf[0] as *byte, 2048,
            "%s -fno-inline-small-functions" as *byte, cflags as *byte);
        if wcf > 0 && wcf < 2048 {
            cflags = &cflags_buf[0] as &byte;
        }
    }
    const target_triple: &byte = get_env_or_default("TARGET_TRIPLE" as *byte, "" as *byte);
    var target_flags: &byte = get_env_or_default("CC_TARGET_FLAGS" as *byte, "" as *byte);
    var target_flags_buffer: [byte: 256] = [];
    if target_flags[0] == 0 && target_triple[0] != 0 {
        const target_flags_len: i32 = snprintf(&target_flags_buffer[0], 256,
            "-target %s" as *byte, target_triple as *byte);
        if target_flags_len > 0 && target_flags_len < 256 {
            target_flags = &target_flags_buffer[0] as &byte;
        }
    }
    if native_build_hosted_write_extern_const2_asm(&asm_path[0] as &byte,
        extern_name, arg0, arg1) != 0 ||
       native_build_hosted_compile_asm_to_object(cc_driver, target_flags,
        &asm_path[0] as &byte, &native_obj[0] as &byte) != 0 ||
       native_build_hosted_compile_c_import_objects(cc_driver, target_flags,
        cflags, plan) != 0 ||
       native_build_hosted_link_objects(cc_driver, target_flags,
        &native_obj[0] as &byte, output_file, plan) != 0 {
        unlink(&asm_path[0] as *byte);
        unlink(&native_obj[0] as *byte);
        native_build_hosted_cleanup_c_import_objects(plan.item_count);
        return 1;
    }
    unlink(&asm_path[0] as *byte);
    unlink(&native_obj[0] as *byte);
    native_build_hosted_cleanup_c_import_objects(plan.item_count);
    return 0;
}

fn native_build_hosted_emit_const_return_linked_exe(output_file: &byte,
    return_value: i32) i32 {
    var asm_path: [byte: PATH_MAX] = [];
    var native_obj: [byte: PATH_MAX] = [];
    if native_build_hosted_fill_asm_path(&asm_path[0] as &byte, PATH_MAX) != 0 ||
       native_build_hosted_fill_object_path(&native_obj[0] as &byte, PATH_MAX) != 0 {
        fprintf(libc.stderr, "错误：无法生成 hosted native 临时路径\n" as *byte);
        return 1;
    }
    var cc_driver_buffer: [byte: PATH_MAX] = [];
    const cc_driver: &byte = resolve_cc_driver(&cc_driver_buffer[0] as &byte, PATH_MAX);
    const target_triple: &byte = get_env_or_default("TARGET_TRIPLE" as *byte, "" as *byte);
    var target_flags: &byte = get_env_or_default("CC_TARGET_FLAGS" as *byte, "" as *byte);
    var target_flags_buffer: [byte: 256] = [];
    if target_flags[0] == 0 && target_triple[0] != 0 {
        const target_flags_len: i32 = snprintf(&target_flags_buffer[0], 256,
            "-target %s" as *byte, target_triple as *byte);
        if target_flags_len > 0 && target_flags_len < 256 {
            target_flags = &target_flags_buffer[0] as &byte;
        }
    }
    if native_build_hosted_write_const_return_asm(&asm_path[0] as &byte,
        return_value) != 0 ||
       native_build_hosted_compile_asm_to_object(cc_driver, target_flags,
        &asm_path[0] as &byte, &native_obj[0] as &byte) != 0 ||
       native_build_hosted_link_single_object(cc_driver, target_flags,
        &native_obj[0] as &byte, output_file) != 0 {
        unlink(&asm_path[0] as *byte);
        unlink(&native_obj[0] as *byte);
        return 1;
    }
    unlink(&asm_path[0] as *byte);
    unlink(&native_obj[0] as *byte);
    return 0;
}

