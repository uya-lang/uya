    var entry_terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_COND_BR,
        operand_start: cond_term_operand_id,
        operand_count: 1,
        successor_start: successor_id,
