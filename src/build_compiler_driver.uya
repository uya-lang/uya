    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32,
    decl: &ASTNode, program: &ASTNode) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 || decl == null || program == null {
        return -1;
    }
    const call_expr: &ASTNode = native_build_hosted_return_call_expr(decl);
    if call_expr == null {
        return -1;
    }
    var target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
