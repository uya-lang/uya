    }
    return 0;
}

fn native_build_hosted_mir_append_main_prefix_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32,
    decl: &ASTNode, program: &ASTNode) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 || decl == null || program == null ||
       decl.fn_decl_body == null || decl.fn_decl_body.block_stmts == null ||
       decl.fn_decl_body.block_stmt_count < 3 {
