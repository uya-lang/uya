       portable_mir_append_value(module, &left_index_value_mir) != 0 ||
       portable_mir_append_value(module, &left_addr_value) != 0 ||
       portable_mir_append_value(module, &left_load_value) != 0 ||
       portable_mir_append_value(module, &right_index_value_mir) != 0 ||
       portable_mir_append_value(module, &right_addr_value) != 0 ||
       portable_mir_append_value(module, &right_load_value) != 0 ||
       portable_mir_append_value(module, &add_value) != 0 ||
       portable_mir_append_inst(module, &left_index_inst) != 0 ||
       portable_mir_append_inst(module, &left_addr_inst) != 0 ||
       portable_mir_append_inst(module, &left_load_inst) != 0 ||
       portable_mir_append_inst(module, &right_index_inst) != 0 ||
       portable_mir_append_inst(module, &right_addr_inst) != 0 ||
       portable_mir_append_inst(module, &right_load_inst) != 0 ||
       portable_mir_append_inst(module, &add_inst) != 0 ||
