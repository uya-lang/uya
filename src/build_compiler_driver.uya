           decl.fn_decl_name != null && str_equals(decl.fn_decl_name, name as *byte) != 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn native_build_find_const1_i32_function_decl_index(program: &ASTNode, name: &byte,
    explicit_i32_type_arg: i32) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name, name as *byte) != 0 {
            if explicit_i32_type_arg != 0 {
                if native_build_decl_is_identity_generic_i32_fn(decl) != 0 {
                    return i;
                }
                return -1;
            }
            if native_build_decl_is_one_i32_param_fn(decl) != 0 {
                return i;
            }
            return -1;
        }
        i = i + 1;
    }
    return -1;
}

