       lowered_program_append_core_place(lowered, &place) != 0 ||
       lowered_program_append_core_expr(lowered, &call_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &local_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &compare_expr) != 0 ||
