fn native_build_hosted_mir_append_extern_function(module: &PortableMirModule,
    decl_index: i32) i32 {
    if module == null || decl_index < 0 {
        return -1;
    }
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: function_id,
        decl_id: decl_index,
        source_core_body_id: CORE_BODY_INVALID_ID,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: 0,
        local_count: 0,
        block_start: 0,
        block_count: 0,
        entry_block_id: MIR_BLOCK_INVALID_ID,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_C,
        runtime_capability_mask: MIR_RUNTIME_CAP_C_EXTERN,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: MIR_FUNCTION_FLAG_EXTERN,
    };
    return portable_mir_append_function(module, &function);
}

fn native_build_hosted_mir_append_program_externs(module: &PortableMirModule,
    program: &ASTNode, out_mir_extern_function_count: &i32) i32 {
    if out_mir_extern_function_count != null {
        *out_mir_extern_function_count = 0;
    }
    if module == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_mir_extern_function_count == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_extern != 0 {
            if native_build_hosted_mir_append_extern_function(module, i) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    *out_mir_extern_function_count = module.function_count as i32;
    return 0;
}

fn native_build_hosted_mir_append_build_driver_run_entry_prefix_body_function(
    module: &PortableMirModule, checker: &TypeChecker, program: &ASTNode, lowered_function_id: i32,
    decl_index: i32, source_core_body_id: i32, decl: &ASTNode) i32 {
    if module == null || checker == null || program == null || lowered_function_id < 0 ||
       decl_index < 0 || source_core_body_id < 0 || decl == null {
        return -1;
    }
    var prefix_count: i32 =
        native_build_hosted_build_driver_run_user_output_path_prefix_stmt_count(
            decl, checker, program);
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_output_path_prefix_stmt_count(
            decl, checker, program);
    }
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_split_env_prefix_stmt_count(
            decl, checker, program);
    }
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_stack_limit_prefix_stmt_count(
            decl, checker, program);
    }
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_stack_guard_prefix_stmt_count(
            decl, checker, program);
    }
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_stack_init_prefix_stmt_count(
            decl, checker, program);
    }
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_parse_prefix_stmt_count(
            decl, checker, program);
    }
    if prefix_count == 0 {
        prefix_count = native_build_hosted_build_driver_run_prefix_stmt_count(decl,
            checker);
    }
    if prefix_count != NATIVE_BUILD_DRIVER_RUN_SIMPLE_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_PARSE_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_STACK_INIT_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_STACK_GUARD_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_STACK_LIMIT_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT &&
       prefix_count != NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT {
        return -1;
    }
    var mir_local_count: i32 = prefix_count;
    var mir_block_count: i32 = 1;
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_PARSE_PREFIX_STMT_COUNT {
        mir_local_count = 13;
        mir_block_count = 5;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_INIT_PREFIX_STMT_COUNT {
        mir_local_count = 14;
        mir_block_count = 5;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_GUARD_PREFIX_STMT_COUNT {
        mir_local_count = 14;
        mir_block_count = 7;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_LIMIT_PREFIX_STMT_COUNT {
        mir_local_count = 14;
        mir_block_count = 7;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT {
        mir_local_count = 15;
        mir_block_count = 9;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT {
        mir_local_count = 15;
        mir_block_count = 11;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT {
        mir_local_count = 16;
        mir_block_count = 11;
    }
    const array_decl: &ASTNode = native_build_hosted_build_driver_run_prefix_stmt(decl, 0);
    const path_decl: &ASTNode = native_build_hosted_build_driver_run_prefix_stmt(decl, 10);
    if array_decl == null || array_decl.var_decl_init == null ||
       path_decl == null || path_decl.var_decl_init == null {
        return -1;
    }
    var array_source_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var path_source_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_ensure_expr_type_id(checker, array_decl.var_decl_init,
        &array_source_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, path_decl.var_decl_init,
        &path_source_type_id) != 0 {
        return -1;
    }
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    var i32_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_i32_type(module, &i32_type_id) != 0 {
        return -1;
    }
    var array_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_append_stack_i32_array64_type(module, array_source_type_id,
        &array_type_id) != 0 {
        return -1;
    }
    var path_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_append_stack_byte_path_max_array_type(module,
        path_source_type_id, &path_type_id) != 0 {
        return -1;
    }
    var env_split_type_id: i32 = i32_type_id;
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT ||
       (prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT || prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT) {
        env_split_type_id = module.type_count as i32;
        var env_split_type: MirType =
            native_build_hosted_mir_i32_pointer_type(env_split_type_id, i32_type_id);
        if portable_mir_append_type(module, &env_split_type) != 0 {
            return -1;
        }
    }
    const function_id: i32 = module.function_count as i32;
    const local_id: i32 = module.local_count as i32;
    const block_id: i32 = module.block_count as i32;
    const terminator_id: i32 = module.terminator_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: local_id,
        local_count: mir_local_count,
        block_start: block_id,
        block_count: mir_block_count,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: MIR_FUNCTION_FLAG_PARTIAL_BODY,
    };
    var terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_UNREACHABLE,
        operand_start: 0,
        operand_count: 0,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: 0,
        inst_count: 0,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 {
        return -1;
    }
    var local_index: i32 = 0;
    while local_index < mir_local_count {
        var local_type_id: i32 = i32_type_id;
        var local_alignment: usize = 4usize;
        var local_flags: i32 = 0;
        if local_index == 0 {
            local_type_id = array_type_id;
            local_alignment = 4usize;
            local_flags = MIR_LOCAL_FLAG_ADDRESS_TAKEN;
        } else if local_index == 10 {
            local_type_id = path_type_id;
            local_alignment = 1usize;
            local_flags = MIR_LOCAL_FLAG_ADDRESS_TAKEN;
        } else if local_index == 14 {
            local_type_id = env_split_type_id;
            local_alignment = 8usize;
        } else if local_index == 15 {
            local_type_id = env_split_type_id;
            local_alignment = 8usize;
        }
        var local: MirLocal = MirLocal{
            local_id: local_id + local_index,
            function_id: function_id,
            type_id: local_type_id,
            source_symbol_id: TYPED_PROGRAM_INVALID_ID,
            address_space: MIR_ADDRESS_SPACE_GENERIC,
            alignment: local_alignment,
            debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
            flags: local_flags,
        };
        if portable_mir_append_local(module, &local) != 0 {
            return -1;
        }
        local_index = local_index + 1;
    }
    if prefix_count == NATIVE_BUILD_DRIVER_RUN_PARSE_PREFIX_STMT_COUNT ||
       prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_INIT_PREFIX_STMT_COUNT ||
       prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_GUARD_PREFIX_STMT_COUNT ||
       prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_LIMIT_PREFIX_STMT_COUNT ||
       prefix_count == NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT ||
       (prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT || prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT) {
        var include_stack_guard: i32 = 0;
        var include_stack_limit_call: i32 = 0;
        var include_split_env: i32 = 0;
        var include_output_path: i32 = 0;
        if prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_GUARD_PREFIX_STMT_COUNT ||
           prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_LIMIT_PREFIX_STMT_COUNT ||
           prefix_count == NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT ||
           (prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT || prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT) {
            include_stack_guard = 1;
        }
        if prefix_count == NATIVE_BUILD_DRIVER_RUN_STACK_LIMIT_PREFIX_STMT_COUNT ||
           prefix_count == NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT ||
           (prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT || prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT) {
            include_stack_limit_call = 1;
        }
        if prefix_count == NATIVE_BUILD_DRIVER_RUN_SPLIT_ENV_PREFIX_STMT_COUNT ||
           (prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT || prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT) {
            include_split_env = 1;
        }
        if (prefix_count == NATIVE_BUILD_DRIVER_RUN_OUTPUT_PATH_PREFIX_STMT_COUNT || prefix_count == NATIVE_BUILD_DRIVER_RUN_USER_OUTPUT_PATH_PREFIX_STMT_COUNT) {
            include_output_path = 1;
        }
        return native_build_hosted_mir_append_build_driver_run_parse_prefix_control(
            module, program, decl, function_id, local_id, block_id, i32_type_id,
            array_type_id, env_split_type_id, signature_type_id, include_stack_guard,
            include_stack_limit_call, include_split_env, include_output_path);
    }
    if portable_mir_append_terminator(module, &terminator) != 0 ||
       portable_mir_append_block(module, &block) != 0 {
        return -1;
    }
    return 0;
}

fn native_build_hosted_mir_parse_arg_local_index(arg_index: i32) i32 {
    if arg_index == 0 {
        return 0;
    }
    if arg_index == 1 {
        return 11;
    }
    if arg_index >= 2 && arg_index < 11 {
        return arg_index - 1;
    }
    return -1;
}

fn native_build_hosted_mir_append_build_driver_run_parse_call_operands(
    module: &PortableMirModule, local_id: i32, operand_id: i32,
    target_function_id: i32, signature_type_id: i32, i32_type_id: i32,
    array_type_id: i32) i32 {
    if module == null || local_id < 0 || operand_id < 0 {
        return -1;
    }
    var target_operand: MirOperand = MirOperand{
        operand_id: operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: signature_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: target_function_id,
        flags: 0,
    };
    if portable_mir_append_operand(module, &target_operand) != 0 {
        return -1;
    }
    var arg_index: i32 = 0;
    while arg_index < 11 {
        const local_offset: i32 = native_build_hosted_mir_parse_arg_local_index(arg_index);
        if local_offset < 0 {
            return -1;
        }
        var arg_type_id: i32 = i32_type_id;
        if arg_index == 0 {
            arg_type_id = array_type_id;
        }
        var arg_operand: MirOperand = MirOperand{
            operand_id: operand_id + 1 + arg_index,
            kind: 0,
            value_id: MIR_VALUE_INVALID_ID,
            local_id: local_id + local_offset,
            type_id: arg_type_id,
            capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
            immediate_i32: 0,
            flags: 0,
        };
        if portable_mir_append_operand(module, &arg_operand) != 0 {
            return -1;
        }
        arg_index = arg_index + 1;
    }
    return 0;
}

