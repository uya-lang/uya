fn native_build_hosted_mir_append_void_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 {
        return -1;
    }
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    const block_id: i32 = module.block_count as i32;
    const terminator_id: i32 = module.terminator_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: 0,
        local_count: 0,
        block_start: block_id,
        block_count: 1,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_RETURN,
        operand_start: 0,
        operand_count: 0,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: 0,
        inst_count: 0,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 {
        return -1;
    }
    if portable_mir_append_terminator(module, &terminator) != 0 {
        return -1;
    }
    return portable_mir_append_block(module, &block);
}

fn native_build_hosted_mir_append_int_literal_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32,
    decl: &ASTNode) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 || decl == null {
        return -1;
    }
    const number_expr: &ASTNode = native_build_hosted_return_number_expr(decl);
    if number_expr == null {
        return -1;
    }
    const value_result: !i32 = number_expr.number_value_i64 as! i32;
    const return_value: i32 = value_result catch {
        return -1;
    };
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    var i32_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_i32_type(module, &i32_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    const block_id: i32 = module.block_count as i32;
    const inst_id: i32 = module.inst_count as i32;
    const value_id: i32 = module.value_count as i32;
    const operand_id: i32 = module.operand_count as i32;
    const terminator_id: i32 = module.terminator_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: 0,
        local_count: 0,
        block_start: block_id,
        block_count: 1,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var value: MirValue = MirValue{
        value_id: value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: number_expr.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var inst: MirInst = MirInst{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: value_id,
        operand_start: 0,
        operand_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: return_value,
    };
    var operand: MirOperand = MirOperand{
        operand_id: operand_id,
        kind: 0,
        value_id: value_id,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: return_value,
        flags: 0,
    };
    var terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_RETURN,
        operand_start: operand_id,
        operand_count: 1,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: inst_id,
        inst_count: 1,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 {
        return -1;
    }
    if portable_mir_append_value(module, &value) != 0 {
        return -1;
    }
    if portable_mir_append_inst(module, &inst) != 0 {
        return -1;
    }
    if portable_mir_append_operand(module, &operand) != 0 {
        return -1;
    }
    if portable_mir_append_terminator(module, &terminator) != 0 {
        return -1;
    }
    return portable_mir_append_block(module, &block);
}

