fn native_build_assign_reachable_function(program: &ASTNode,
    reach: &NativeBuildReachability, decl_index: i32) i32 {
    if program == null || reach == null || reach.decl_to_function_index == null ||
       reach.function_decl_indices == null || decl_index < 0 ||
       decl_index >= program.program_decl_count || decl_index >= reach.capacity {
        return -1;
    }
    const existing: i32 = reach.decl_to_function_index[decl_index];
    if existing >= 0 {
        return existing;
    }
    if reach.assigned_count < 0 || reach.assigned_count >= reach.capacity {
        return -1;
    }
    const decl: &ASTNode = program.program_decls[decl_index];
    if native_build_decl_is_supported_i32_fn(decl) == 0 {
        return -1;
    }
    const function_index: i32 = reach.assigned_count;
    reach.decl_to_function_index[decl_index] = function_index;
    reach.function_decl_indices[function_index] = decl_index;
    reach.assigned_count = reach.assigned_count + 1;
    return function_index;
}

fn native_build_resolve_reachable_zero_arg_call(program: &ASTNode, expr: &ASTNode,
    reach: &NativeBuildReachability, out_target: &i32) i32 {
    if out_target != null {
        *out_target = -1;
    }
    if program == null || expr == null || reach == null || out_target == null {
        return 0;
    }
    if expr.type != ASTNodeType.AST_CALL_EXPR || expr.call_expr_arg_count != 0 ||
       expr.call_expr_type_arg_count != 0 || expr.call_expr_callee == null ||
       expr.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER {
        return 0;
    }
    const target_decl: i32 = native_build_find_function_decl_index(program, expr.call_expr_callee.identifier_name);
    if target_decl < 0 {
        fprintf(libc.stderr, "native_unsupported_call_target: name=%s args=%d type_args=%d\n" as *byte,
            expr.call_expr_callee.identifier_name, expr.call_expr_arg_count, expr.call_expr_type_arg_count);
        return 0;
    }
    const target: i32 = native_build_assign_reachable_function(program, reach, target_decl);
    if target < 0 {
        fprintf(libc.stderr, "native_unsupported_call_target: name=%s decl=%d\n" as *byte,
            expr.call_expr_callee.identifier_name, target_decl);
        return 0;
    }
    *out_target = target;
    return 1;
}

fn native_build_print_unsupported_call_expr(expr: &ASTNode, reason: &byte) void {
    if expr == null || expr.type != ASTNodeType.AST_CALL_EXPR || expr.call_expr_callee == null {
        return;
    }
    var callee_name: &byte = "<non_identifier>" as &byte;
    if expr.call_expr_callee.type == ASTNodeType.AST_IDENTIFIER &&
       expr.call_expr_callee.identifier_name != null {
        callee_name = expr.call_expr_callee.identifier_name;
    }
    fprintf(libc.stderr,
        "native_unsupported_call_expr: name=%s reason=%s args=%d type_args=%d\n" as *byte,
        callee_name, reason, expr.call_expr_arg_count, expr.call_expr_type_arg_count);
}

fn native_build_expr_is_get_argc_call(expr: &ASTNode) i32 {
    if expr == null || expr.type != ASTNodeType.AST_CALL_EXPR ||
       expr.call_expr_arg_count != 0 || expr.call_expr_type_arg_count != 0 ||
       expr.call_expr_callee == null ||
       expr.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER ||
       expr.call_expr_callee.identifier_name == null {
        return 0;
    }
    if str_equals(expr.call_expr_callee.identifier_name as *byte, "get_argc" as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_expr_get_argv_const_index(expr: &ASTNode, out_index: &i32) i32 {
    if out_index != null {
        *out_index = -1;
    }
    if expr == null || out_index == null || expr.type != ASTNodeType.AST_CALL_EXPR ||
       expr.call_expr_arg_count != 1 || expr.call_expr_type_arg_count != 0 ||
       expr.call_expr_callee == null ||
       expr.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER ||
       expr.call_expr_callee.identifier_name == null ||
       expr.call_expr_args == null {
        return 0;
    }
    if str_equals(expr.call_expr_callee.identifier_name as *byte, "get_argv" as *byte) == 0 {
        return 0;
    }
    const arg0: &ASTNode = expr.call_expr_args[0];
    if arg0 == null || arg0.type != ASTNodeType.AST_NUMBER ||
       arg0.number_value_i64 < 0i64 || arg0.number_value_i64 > 15i64 {
        return 0;
    }
    const index_result: !i32 = arg0.number_value_i64 as! i32;
    *out_index = index_result catch {
        return 0;
    };
    return 1;
}

fn native_build_resolve_reachable_const1_i32_call(program: &ASTNode, expr: &ASTNode,
    reach: &NativeBuildReachability, out_target: &i32, out_arg0: &i32) i32 {
    if out_target != null {
        *out_target = -1;
    }
    if out_arg0 != null {
        *out_arg0 = 0;
    }
    if program == null || expr == null || reach == null || out_target == null || out_arg0 == null {
        return 0;
    }
    if expr.type != ASTNodeType.AST_CALL_EXPR || expr.call_expr_arg_count != 1 ||
       expr.call_expr_type_arg_count > 1 || expr.call_expr_callee == null ||
       expr.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER || expr.call_expr_args == null {
        return 0;
    }
    var explicit_i32_type_arg: i32 = 0;
    if expr.call_expr_type_arg_count == 1 {
        if expr.call_expr_type_args == null || native_build_type_is_i32(expr.call_expr_type_args[0]) == 0 {
            return 0;
        }
        explicit_i32_type_arg = 1;
    }
    const arg0: &ASTNode = expr.call_expr_args[0];
    if arg0 == null || arg0.type != ASTNodeType.AST_NUMBER {
        return 0;
    }
    const arg0_result: !i32 = arg0.number_value_i64 as! i32;
    const arg0_value: i32 = arg0_result catch {
