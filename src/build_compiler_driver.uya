fn native_build_hosted_core_function_from_decl(function_id: i32,
    decl_index: i32, decl: &ASTNode) ConcreteFunction {
    return ConcreteFunction{
        function_id: function_id,
        decl_id: decl_index,
        mono_instance_id: TYPED_PROGRAM_INVALID_ID,
        body_start: 0,
        body_count: 0,
        flags: native_build_core_function_flags_from_decl(decl),
    };
}

fn native_build_hosted_return_number_expr(decl: &ASTNode) &ASTNode {
    if decl == null || decl.fn_decl_body == null || decl.fn_decl_body.type != ASTNodeType.AST_BLOCK ||
       decl.fn_decl_body.block_stmt_count != 1 || decl.fn_decl_body.block_stmts == null {
        return null;
    }
    const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
    if stmt == null || stmt.type != ASTNodeType.AST_RETURN_STMT ||
       stmt.return_stmt_expr == null || stmt.return_stmt_expr.type != ASTNodeType.AST_NUMBER {
        return null;
    }
    return stmt.return_stmt_expr;
}

fn native_build_hosted_return_call_expr(decl: &ASTNode) &ASTNode {
    if decl == null || decl.fn_decl_body == null || decl.fn_decl_body.type != ASTNodeType.AST_BLOCK ||
       decl.fn_decl_body.block_stmt_count != 1 || decl.fn_decl_body.block_stmts == null {
