fn native_build_expr_to_return_plan(program: &ASTNode, expr: &ASTNode, plan: &NativeBuildFunctionPlan) i32 {
    if program == null || expr == null || plan == null {
        return 0;
    }
    plan.return_kind = 0;
    plan.return_value = 0;
    plan.call_target = -1;
    plan.call_target_right = -1;
    plan.call_arg0_value = 0;
    plan.call_arg1_value = 0;
    if expr.type == ASTNodeType.AST_NUMBER &&
       expr.number_value_i64 >= 0i64 && expr.number_value_i64 <= 255i64 {
        plan.return_kind = NATIVE_BUILD_RETURN_CONST_I32;
        plan.return_value = expr.number_value_i64 as i32;
        return 1;
    }
    var target: i32 = -1;
    if native_build_expr_zero_arg_call_target(program, expr, &target) != 0 {
        plan.return_kind = NATIVE_BUILD_RETURN_CALL;
        plan.call_target = target;
        return 1;
    }
    if expr.type == ASTNodeType.AST_BINARY_EXPR && expr.binary_expr_left != null &&
       expr.binary_expr_right != null {
        const op_tmp: !TokenType = expr.binary_expr_op as! TokenType;
        const op: TokenType = op_tmp catch {
            return 0;
        };
        if op != TokenType.TOKEN_PLUS {
            return 0;
        }
        var left_target: i32 = -1;
        var right_target: i32 = -1;
        if native_build_expr_zero_arg_call_target(program, expr.binary_expr_left, &left_target) != 0 &&
           native_build_expr_zero_arg_call_target(program, expr.binary_expr_right, &right_target) != 0 {
            plan.return_kind = NATIVE_BUILD_RETURN_ADD_CALLS;
            plan.call_target = left_target;
            plan.call_target_right = right_target;
            return 1;
        }
    }
    return 0;
}

