fn native_build_hosted_find_noarg_i32_function(program: &ASTNode, name: &byte,
    out_function_id: &i32, out_decl_index: &i32) i32 {
    if out_function_id != null {
        *out_function_id = TYPED_PROGRAM_INVALID_ID;
    }
    if out_decl_index != null {
        *out_decl_index = TYPED_PROGRAM_INVALID_ID;
    }
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null ||
       out_function_id == null || out_decl_index == null {
        return 0;
    }
    var i: i32 = 0;
    var function_id: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            if decl.fn_decl_name != null &&
               str_equals(decl.fn_decl_name as *byte, name as *byte) != 0 {
                if native_build_decl_is_noarg_i32_fn(decl) == 0 {
                    return 0;
                }
                *out_function_id = function_id;
                *out_decl_index = i;
                return 1;
            }
            function_id = function_id + 1;
        }
        i = i + 1;
    }
    return 0;
}

