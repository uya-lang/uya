fn native_build_hosted_if_local_ne_number(stmt: &ASTNode, local_name: &byte,
    out_local_expr: & & ASTNode, out_number_expr: & & ASTNode) i32 {
    if out_local_expr != null {
        *out_local_expr = null;
    }
    if out_number_expr != null {
        *out_number_expr = null;
    }
    if stmt == null || stmt.type != ASTNodeType.AST_IF_STMT ||
       stmt.if_stmt_condition == null || local_name == null ||
       out_local_expr == null || out_number_expr == null {
        return 0;
    }
    const cond: &ASTNode = stmt.if_stmt_condition;
    if cond.type != ASTNodeType.AST_BINARY_EXPR ||
       cond.binary_expr_left == null || cond.binary_expr_right == null {
        return 0;
    }
    const op_tmp: !TokenType = cond.binary_expr_op as! TokenType;
    const op: TokenType = op_tmp catch {
        return 0;
    };
    if op != TokenType.TOKEN_NOT_EQUAL {
        return 0;
    }
    if cond.binary_expr_left.type == ASTNodeType.AST_IDENTIFIER &&
       cond.binary_expr_left.identifier_name != null &&
       str_equals(cond.binary_expr_left.identifier_name as *byte, local_name as *byte) != 0 &&
       cond.binary_expr_right.type == ASTNodeType.AST_NUMBER {
        *out_local_expr = cond.binary_expr_left;
        *out_number_expr = cond.binary_expr_right;
        return 1;
    }
    return 0;
}

fn native_build_hosted_ensure_expr_type_id(checker: &TypeChecker, expr: &ASTNode,
    out_type_id: &TypeId) i32 {
    if checker == null || expr == null || out_type_id == null {
        return -1;
    }
    _ = checker_typed_backend_type_for_codegen(checker, expr);
    if typed_program_get_expr_type(&checker.typed_program, expr.expr_id, out_type_id) == 0 ||
       out_type_id[0] == TYPED_PROGRAM_INVALID_ID {
        return -1;
    }
    return 0;
}

fn native_build_hosted_decl_can_materialize_main_local_if_body(program: &ASTNode,
    decl: &ASTNode, checker: &TypeChecker) i32 {
    if program == null || decl == null || checker == null ||
       native_build_decl_is_noarg_i32_fn(decl) == 0 ||
