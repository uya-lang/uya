fn native_build_try_emit_hosted_c_import_extern_link_subset(output_file: &byte,
    program: &ASTNode, plan: &CImportPlan) i32 {
    if output_file == null || program == null || plan == null || plan.item_count != 1 {
        return 0;
    }
    if strcmp(main_get_target_os_name() as *byte, "linux" as *byte) != 0 ||
       strcmp(main_get_target_arch_name() as *byte, "x86_64" as *byte) != 0 {
        return 0;
    }
    var extern_name: &byte = null;
    var arg0: i32 = 0;
    var arg1: i32 = 0;
    if native_build_hosted_main_return_extern_const2_call(program,
        &extern_name, &arg0, &arg1) == 0 {
        return 0;
    }
    if native_build_hosted_emit_extern_const2_linked_exe(output_file,
        extern_name, arg0, arg1, plan) != 0 {
        return -1;
    }
    fprintf(libc.stderr, "native_hosted_subset: c_import_extern_link_path=1\n" as *byte);
    fprintf(libc.stderr,
        "native_hosted_linker_handoff: extern=%s c_import_objects=%d linked_objects=%d\n" as *byte,
        extern_name as *byte, plan.item_count, plan.item_count + 1);
    fprintf(libc.stderr, "native_output_bytes: %zu\n" as *byte,
        native_build_hosted_output_size(output_file));
    return 1;
}

fn native_build_try_emit_hosted_core_mir_local_array_index_subset(output_file: &byte,
    program: &ASTNode, arena: &CompilerArena, checker: &TypeChecker,
    c_import_count: i32, preflight_status: i32, preflight: &NativeHostedMirPreflightResult) i32 {
    if output_file == null || program == null || arena == null || checker == null ||
       c_import_count != 0 || preflight_status != 0 || preflight == null ||
       preflight.core_verifier_error != 0 || preflight.verifier_error != 0 ||
       preflight.core_body_count <= 0 || preflight.mir_body_function_count <= 0 {
        return 0;
    }
    if strcmp(main_get_target_os_name() as *byte, "linux" as *byte) != 0 ||
       strcmp(main_get_target_arch_name() as *byte, "x86_64" as *byte) != 0 {
        return 0;
    }
    var return_value: i32 = 0;
    if native_build_hosted_verified_mir_local_array_index_return_value(arena,
        checker, program,
        &return_value) == 0 ||
       return_value < 0 || return_value > 255 {
        return 0;
    }
    if native_build_hosted_emit_const_return_linked_exe(output_file,
        return_value) != 0 {
        return -1;
    }
    fprintf(libc.stderr,
        "native_hosted_subset: core_mir_local_array_index_path=1\n" as *byte);
    fprintf(libc.stderr, "native_exit_code: %d\n" as *byte, return_value);
    fprintf(libc.stderr, "native_output_bytes: %zu\n" as *byte,
        native_build_hosted_output_size(output_file));
    return 1;
}

fn native_build_try_emit_hosted_no_deps_subset(output_file: &byte, program: &ASTNode,
    arena: &CompilerArena, checker: &TypeChecker, c_import_count: i32) i32 {
    if output_file == null || program == null || arena == null || checker == null ||
       c_import_count != 0 {
        return 0;
    }
    var return_value: i32 = 0;
    const exit_status: i32 = native_build_hosted_verified_mir_main_exit_code(arena,
        checker, program, &return_value);
    if exit_status < 0 {
        return -1;
    }
    if exit_status != 0 {
        if native_build_hosted_emit_const_return_linked_exe(output_file,
            return_value) != 0 {
            fprintf(libc.stderr, "错误: hosted native executable 输出失败: %s\n" as *byte, output_file);
            return -1;
        }
        fprintf(libc.stderr, "native_hosted_subset: no_deps_portable_mir_path=1\n" as *byte);
        fprintf(libc.stderr, "native_exit_code: %d\n" as *byte, return_value);
        fprintf(libc.stderr, "native_output_bytes: %zu\n" as *byte,
            native_build_hosted_output_size(output_file));
        return 1;
    }
    var dynamic_shape: NativeBuildDynamicCatchShape = native_build_dynamic_catch_shape_empty();
    const dynamic_status: i32 = native_build_hosted_verified_mir_dynamic_catch_shape(arena,
        checker, program, &dynamic_shape);
    if dynamic_status < 0 {
        return -1;
    }
    if dynamic_status == 0 {
        return 0;
    }
    if native_build_hosted_emit_dynamic_catch_linked_exe(output_file,
        &dynamic_shape) != 0 {
        fprintf(libc.stderr, "错误: hosted native executable 输出失败: %s\n" as *byte, output_file);
        return -1;
    }
    fprintf(libc.stderr, "native_hosted_subset: no_deps_portable_mir_path=1\n" as *byte);
    fprintf(libc.stderr, "native_hosted_subset: dynamic_catch_portable_mir_path=1\n" as *byte);
    fprintf(libc.stderr,
        "native_dynamic_catch: compare=%d fallback=%d ok=%d\n" as *byte,
        dynamic_shape.compare_value, dynamic_shape.fallback_value,
        dynamic_shape.ok_value);
    fprintf(libc.stderr, "native_output_bytes: %zu\n" as *byte,
        native_build_hosted_output_size(output_file));
    return 1;
}

fn native_build_core_function_flags_from_decl(decl: &ASTNode) i32 {
    var flags: i32 = 0;
    if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_naked != 0 {
        flags = flags | CORE_FUNCTION_FLAG_NAKED;
    }
    return flags;
}

fn native_build_find_function_index(program: &ASTNode, name: &byte) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return -1;
    }
    var i: i32 = 0;
    var function_index: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name, name as *byte) != 0 {
            if native_build_decl_is_noarg_i32_fn(decl) != 0 {
                return function_index;
            }
            native_build_print_unsupported_decl(decl, i);
            return -1;
        }
        if native_build_decl_is_noarg_i32_fn(decl) != 0 {
            function_index = function_index + 1;
        }
        i = i + 1;
    }
    return -1;
}

