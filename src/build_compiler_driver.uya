        body_id: body_id,
        source_expr_id: shape.assign_stmt.assign_src.expr_id,
        type_id: deferred_type_id,
        literal_i64: shape.deferred_value as i64,
        lhs_expr_id: CORE_EXPR_INVALID_ID,
        rhs_expr_id: CORE_EXPR_INVALID_ID,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: shape.assign_stmt.assign_src.line,
        flags: 0,
    };
    var local_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start,
        kind: CORE_STMT_KIND_LOCAL_DECL,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start,
        place_id: place_start,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: shape.local_decl.line,
        cleanup_scope_id: 0,
        flags: CORE_STMT_FLAG_LOCAL_STACK_SLOT,
    };
    var defer_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start + 1,
        kind: CORE_STMT_KIND_DEFER,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start + 2,
        place_id: place_start,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: shape.defer_stmt.line,
        cleanup_scope_id: 0,
        flags: CORE_STMT_FLAG_CLEANUP,
    };
    var return_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start + 2,
        kind: CORE_STMT_KIND_RETURN,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start + 1,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: cleanup_start,
        cleanup_edge_count: 1,
        source_span_id: shape.return_stmt.line,
        cleanup_scope_id: 0,
        flags: CORE_STMT_FLAG_CLEANUP,
    };
    var cleanup_edge: CoreCleanupEdge = CoreCleanupEdge{
        edge_id: cleanup_start,
        kind: CORE_CLEANUP_EDGE_KIND_RETURN,
        body_id: body_id,
        from_stmt_id: stmt_start + 2,
        to_stmt_id: CORE_STMT_INVALID_ID,
        cleanup_scope_id: 0,
        drop_defer_plan_id: 0,
        payload_expr_id: expr_start + 1,
        source_span_id: shape.return_stmt.line,
        flags: 0,
    };
    var cleanup_fact: CoreSemanticFact = native_build_core_semantic_fact_empty(fact_start,
        body_id, CORE_SEMANTIC_FACT_CLEANUP);
    cleanup_fact.stmt_id = stmt_start + 2;
    cleanup_fact.expr_id = expr_start + 1;
    cleanup_fact.source_expr_id = shape.return_stmt.return_stmt_expr.expr_id;
    cleanup_fact.cleanup_edge_id = cleanup_start;
    cleanup_fact.source_span_id = shape.return_stmt.line;
    cleanup_fact.drop_defer_plan_id = 0;
    cleanup_fact.cleanup_scope_id = 0;
    if lowered_program_append_core_body(lowered, &body) != 0 ||
       lowered_program_append_core_place(lowered, &place) != 0 ||
       lowered_program_append_core_expr(lowered, &initial_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &return_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &deferred_expr) != 0 ||
       lowered_program_append_core_stmt(lowered, &local_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &defer_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &return_stmt) != 0 ||
       lowered_program_append_core_cleanup_edge(lowered, &cleanup_edge) != 0 ||
       lowered_program_append_core_semantic_fact(lowered, &cleanup_fact) != 0 {
        return -1;
    }
