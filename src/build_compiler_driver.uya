    const then_branch: &ASTNode = stmt.if_stmt_then_branch;
    if then_branch.type != ASTNodeType.AST_BLOCK || then_branch.block_stmts == null ||
       then_branch.block_stmt_count != 1 {
        return 0;
    }
    var return_value: i32 = 0;
    if native_build_return_stmt_const_value(then_branch.block_stmts[0], locals, &return_value) == 0 {
        return 0;
    }
    if op == TokenType.TOKEN_EQUAL {
        out_op.opcode = LOWERED_BODY_OP_IF_LOCAL_EQ_CONST_RETURN_I32;
    } else {
        out_op.opcode = LOWERED_BODY_OP_IF_LOCAL_NE_CONST_RETURN_I32;
    }
    out_op.dst = 0;
    out_op.src0 = slot;
    out_op.src1 = compare_value;
    out_op.target_id = -1;
    out_op.imm = return_value as i64;
    out_op.flags = 0;
    return 1;
}

