        result_value_id: then_value_id,
        operand_start: 0,
        operand_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: then_value,
    };
    var final_inst: MirInst = MirInst{
        inst_id: final_inst_id,
        function_id: function_id,
        block_id: final_block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: final_value_id,
        operand_start: 0,
        operand_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
