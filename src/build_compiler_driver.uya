const NATIVE_BUILD_DRIVER_RUN_STACK_GUARD_CORE_STMT_COUNT: i32 = 20;
const NATIVE_BUILD_DRIVER_RUN_STACK_GUARD_CORE_EXPR_COUNT: i32 = 21;
