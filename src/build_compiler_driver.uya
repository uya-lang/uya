        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call0_value: MirValue = MirValue{
        value_id: call0_value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: call0_inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
