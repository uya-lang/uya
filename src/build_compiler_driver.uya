}

fn native_build_decl_is_parse11_i32_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 11 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param0: &ASTNode = decl.fn_decl_params[0];
    const param1: &ASTNode = decl.fn_decl_params[1];
    if param0 == null || param1 == null ||
       param0.type != ASTNodeType.AST_VAR_DECL || param1.type != ASTNodeType.AST_VAR_DECL ||
       native_build_type_is_i32_ptr(param0.var_decl_type) == 0 ||
       native_build_type_is_i32(param1.var_decl_type) == 0 {
        return 0;
    }
    var i: i32 = 2;
    while i < decl.fn_decl_param_count {
        const param: &ASTNode = decl.fn_decl_params[i];
        if param == null || param.type != ASTNodeType.AST_VAR_DECL ||
           native_build_type_is_i32_like_ptr(param.var_decl_type) == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn native_build_decl_is_supported_i32_fn(decl: &ASTNode) i32 {
    if native_build_decl_is_noarg_i32_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_one_i32_param_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_identity_generic_i32_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_two_i32_param_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_one_i32_ptr_param_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_two_i32_ptr_param_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_parse11_i32_fn(decl) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_decl_is_ignorable_top_level(decl: &ASTNode) i32 {
    if decl == null {
        return 0;
    }
    if decl.type == ASTNodeType.AST_USE_STMT {
        return 1;
    }
    return 0;
}

fn native_build_ast_kind_name(kind: ASTNodeType) &byte {
    if kind == ASTNodeType.AST_FN_DECL {
        return "fn" as &byte;
    }
    if kind == ASTNodeType.AST_STRUCT_DECL {
        return "struct" as &byte;
    }
    if kind == ASTNodeType.AST_ENUM_DECL {
        return "enum" as &byte;
    }
    if kind == ASTNodeType.AST_UNION_DECL {
        return "union" as &byte;
    }
    if kind == ASTNodeType.AST_INTERFACE_DECL {
        return "interface" as &byte;
    }
    if kind == ASTNodeType.AST_METHOD_BLOCK {
        return "method_block" as &byte;
    }
    if kind == ASTNodeType.AST_TYPE_ALIAS {
        return "type_alias" as &byte;
    }
    if kind == ASTNodeType.AST_EXTERN_VAR_DECL {
        return "extern_var" as &byte;
    }
    if kind == ASTNodeType.AST_VAR_DECL {
        return "var" as &byte;
    }
    if kind == ASTNodeType.AST_ERROR_DECL {
        return "error" as &byte;
    }
    if kind == ASTNodeType.AST_MACRO_DECL {
        return "macro" as &byte;
    }
    if kind == ASTNodeType.AST_USE_STMT {
        return "use" as &byte;
    }
    if kind == ASTNodeType.AST_DESTRUCTURE_DECL {
        return "destructure" as &byte;
    }
    if kind == ASTNodeType.AST_C_IMPORT_DECL {
        return "c_import" as &byte;
    }
    if kind == ASTNodeType.AST_IF_STMT {
        return "if" as &byte;
    }
    if kind == ASTNodeType.AST_WHILE_STMT {
        return "while" as &byte;
    }
    if kind == ASTNodeType.AST_FOR_STMT {
        return "for" as &byte;
    }
    if kind == ASTNodeType.AST_BREAK_STMT {
        return "break" as &byte;
    }
    if kind == ASTNodeType.AST_CONTINUE_STMT {
        return "continue" as &byte;
    }
    if kind == ASTNodeType.AST_RETURN_STMT {
        return "return" as &byte;
    }
    if kind == ASTNodeType.AST_DEFER_STMT {
        return "defer" as &byte;
    }
    if kind == ASTNodeType.AST_ERRDEFER_STMT {
        return "errdefer" as &byte;
    }
    if kind == ASTNodeType.AST_TEST_STMT {
        return "test" as &byte;
    }
    if kind == ASTNodeType.AST_ASSIGN {
        return "assign" as &byte;
    }
    if kind == ASTNodeType.AST_EXPR_STMT {
        return "expr_stmt" as &byte;
    }
    if kind == ASTNodeType.AST_BLOCK {
        return "block" as &byte;
    }
    if kind == ASTNodeType.AST_BINARY_EXPR {
        return "binary_expr" as &byte;
    }
    if kind == ASTNodeType.AST_UNARY_EXPR {
        return "unary_expr" as &byte;
    }
    if kind == ASTNodeType.AST_CALL_EXPR {
        return "call_expr" as &byte;
    }
    if kind == ASTNodeType.AST_IDENTIFIER {
        return "identifier" as &byte;
    }
    if kind == ASTNodeType.AST_NUMBER {
        return "number" as &byte;
    }
    if kind == ASTNodeType.AST_STRING {
        return "string" as &byte;
    }
    if kind == ASTNodeType.AST_FLOAT {
        return "float" as &byte;
    }
    if kind == ASTNodeType.AST_BOOL {
        return "bool" as &byte;
    }
    if kind == ASTNodeType.AST_CHAR {
        return "char" as &byte;
    }
    if kind == ASTNodeType.AST_MEMBER_ACCESS {
        return "member_access" as &byte;
    }
    if kind == ASTNodeType.AST_ARRAY_LITERAL {
        return "array_literal" as &byte;
    }
    if kind == ASTNodeType.AST_SIZEOF {
        return "sizeof" as &byte;
    }
    if kind == ASTNodeType.AST_LEN {
        return "len" as &byte;
    }
    if kind == ASTNodeType.AST_ALIGNOF {
        return "alignof" as &byte;
    }
    if kind == ASTNodeType.AST_CAST_EXPR {
        return "cast_expr" as &byte;
    }
    return "other" as &byte;
}

fn native_build_decl_name_for_diagnostic(decl: &ASTNode) &byte {
    if decl == null {
        return "<null>" as &byte;
    }
    if decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null {
        return decl.fn_decl_name;
    }
    if decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_name != null {
        return decl.struct_decl_name;
    }
    if decl.type == ASTNodeType.AST_ENUM_DECL && decl.enum_decl_name != null {
        return decl.enum_decl_name;
    }
    if decl.type == ASTNodeType.AST_UNION_DECL && decl.union_decl_name != null {
        return decl.union_decl_name;
    }
    if decl.type == ASTNodeType.AST_INTERFACE_DECL && decl.interface_decl_name != null {
        return decl.interface_decl_name;
    }
    if decl.type == ASTNodeType.AST_TYPE_ALIAS && decl.type_alias_name != null {
        return decl.type_alias_name;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL && decl.extern_var_decl_name != null {
        return decl.extern_var_decl_name;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL && decl.var_decl_name != null {
        return decl.var_decl_name;
    }
    if decl.type == ASTNodeType.AST_ERROR_DECL && decl.error_decl_name != null {
        return decl.error_decl_name;
    }
    if decl.type == ASTNodeType.AST_MACRO_DECL && decl.macro_decl_name != null {
        return decl.macro_decl_name;
    }
    if decl.type == ASTNodeType.AST_METHOD_BLOCK {
        if decl.method_block_struct_name != null {
            return decl.method_block_struct_name;
        }
        if decl.method_block_union_name != null {
            return decl.method_block_union_name;
        }
    }
    return "<anonymous>" as &byte;
}

fn native_build_print_unsupported_decl(decl: &ASTNode, index: i32) void {
    if decl == null {
        fprintf(libc.stderr, "native_unsupported_decl: index=%d kind=null name=<null>\n" as *byte, index);
        return;
    }
    fprintf(libc.stderr, "native_unsupported_decl: index=%d kind=%s name=%s file=%s line=%d\n" as *byte,
        index, native_build_ast_kind_name(decl.type), native_build_decl_name_for_diagnostic(decl),
        decl.filename, decl.line);
    if decl.type == ASTNodeType.AST_FN_DECL {
        var body_stmts: i32 = -1;
        if decl.fn_decl_body != null && decl.fn_decl_body.type == ASTNodeType.AST_BLOCK {
            body_stmts = decl.fn_decl_body.block_stmt_count;
        }
        fprintf(libc.stderr,
            "native_unsupported_fn_shape: params=%d extern=%d async=%d naked=%d varargs=%d body_stmts=%d\n" as *byte,
            decl.fn_decl_param_count, decl.fn_decl_is_extern, decl.fn_decl_is_async,
            decl.fn_decl_is_naked, decl.fn_decl_is_varargs, body_stmts);
    }
}

fn native_build_print_unsupported_function_body(decl: &ASTNode, decl_index: i32,
    reason: &byte, stmt: &ASTNode, stmt_index: i32) void {
    var stmt_kind: &byte = "<null>" as &byte;
    var stmt_file: &byte = "<null>" as &byte;
    var stmt_line: i32 = 0;
    if stmt != null {
        stmt_kind = native_build_ast_kind_name(stmt.type);
        stmt_file = stmt.filename;
        stmt_line = stmt.line;
    }
    fprintf(libc.stderr,
        "native_unsupported_fn_body: decl=%d name=%s reason=%s stmt_index=%d stmt_kind=%s stmt_file=%s stmt_line=%d\n" as *byte,
        decl_index, native_build_decl_name_for_diagnostic(decl), reason,
        stmt_index, stmt_kind, stmt_file, stmt_line);
}

fn native_build_empty_portable_mir_module() PortableMirModule {
    return PortableMirModule{
        arena: null,
        lifecycle_state: PORTABLE_MIR_LIFECYCLE_UNINITIALIZED,
        target_profile: MirTargetProfile{
            profile_id: 0,
            pointer_size: 0,
            endianness: 0,
            default_address_space: MIR_ADDRESS_SPACE_GENERIC,
            runtime_mode: MIR_RUNTIME_MODE_HOSTED,
            supported_address_spaces: MIR_ADDRESS_SPACE_GENERIC + MIR_ADDRESS_SPACE_HOST,
            supported_calling_conventions: 3,
            runtime_capability_mask: 3,
            feature_flags: 0,
        },
        function_count: 0usize,
        block_count: 0usize,
        value_count: 0usize,
        type_count: 0usize,
        local_count: 0usize,
        inst_count: 0usize,
        terminator_count: 0usize,
        operand_count: 0usize,
        block_param_count: 0usize,
        successor_count: 0usize,
        debug_loc_count: 0usize,
        capability_req_count: 0usize,
        functions: native_build_empty_vector(),
        blocks: native_build_empty_vector(),
        values: native_build_empty_vector(),
        types: native_build_empty_vector(),
        locals: native_build_empty_vector(),
        insts: native_build_empty_vector(),
        terminators: native_build_empty_vector(),
        operands: native_build_empty_vector(),
        block_params: native_build_empty_vector(),
        successors: native_build_empty_vector(),
        debug_locs: native_build_empty_vector(),
        capability_reqs: native_build_empty_vector(),
    };
}

fn native_build_empty_mir_backend_request() MirTargetBackendRequest {
    return MirTargetBackendRequest{
        module: null,
        backend_kind: 0,
        target_profile_id: 0,
        verifier_error_code: -1,
        flags: 0,
    };
}

fn native_build_hosted_preflight_result_reset(result: &NativeHostedMirPreflightResult) void {
    if result == null {
        return;
    }
    result.core_verifier_error = -1;
    result.core_function_count = 0;
    result.core_body_count = 0;
    result.core_pending_body_count = 0;
    result.verifier_error = -1;
    result.object_count = 0;
    result.extern_symbol_count = 0;
    result.mir_extern_function_count = 0;
    result.mir_body_function_count = 0;
    result.mir_type_count = 0;
}

fn native_build_empty_core_verifier_result() CoreVerifierResult {
    return CoreVerifierResult{
        ok: 0,
        error_code: -1,
        body_id: CORE_BODY_INVALID_ID,
        stmt_id: CORE_STMT_INVALID_ID,
        expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_id: CORE_CLEANUP_EDGE_INVALID_ID,
        fact_id: CORE_SEMANTIC_FACT_INVALID_ID,
        source_span_id: TYPED_PROGRAM_INVALID_ID,
    };
}

fn native_build_hosted_core_function_from_decl(function_id: i32,
    decl_index: i32, decl: &ASTNode) ConcreteFunction {
    return ConcreteFunction{
        function_id: function_id,
        decl_id: decl_index,
        mono_instance_id: TYPED_PROGRAM_INVALID_ID,
        body_start: 0,
        body_count: 0,
        flags: native_build_core_function_flags_from_decl(decl),
    };
}

fn native_build_hosted_return_number_expr(decl: &ASTNode) &ASTNode {
    if decl == null || decl.fn_decl_body == null || decl.fn_decl_body.type != ASTNodeType.AST_BLOCK ||
       decl.fn_decl_body.block_stmt_count != 1 || decl.fn_decl_body.block_stmts == null {
        return null;
    }
    const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
    if stmt == null || stmt.type != ASTNodeType.AST_RETURN_STMT ||
       stmt.return_stmt_expr == null || stmt.return_stmt_expr.type != ASTNodeType.AST_NUMBER {
        return null;
    }
    return stmt.return_stmt_expr;
}

fn native_build_hosted_ensure_expr_type_id(checker: &TypeChecker, expr: &ASTNode,
    out_type_id: &TypeId) i32 {
    if checker == null || expr == null || out_type_id == null {
        return -1;
    }
    _ = checker_typed_backend_type_for_codegen(checker, expr);
    if typed_program_get_expr_type(&checker.typed_program, expr.expr_id, out_type_id) == 0 ||
       out_type_id[0] == TYPED_PROGRAM_INVALID_ID {
        return -1;
    }
    return 0;
}

fn native_build_hosted_decl_can_materialize_safe_core_body(decl: &ASTNode,
    checker: &TypeChecker) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_body == null || decl.fn_decl_body.type != ASTNodeType.AST_BLOCK {
        return 0;
    }
    if decl.fn_decl_body.block_stmt_count == 0 {
        return 1;
    }
    if decl.fn_decl_body.block_stmt_count == 1 && decl.fn_decl_body.block_stmts != null {
        const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
        if stmt != null && stmt.type == ASTNodeType.AST_RETURN_STMT && stmt.return_stmt_expr == null {
            return 1;
        }
    }
    const number_expr: &ASTNode = native_build_hosted_return_number_expr(decl);
    if number_expr != null && checker != null {
        var type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
        if native_build_hosted_ensure_expr_type_id(checker, number_expr, &type_id) == 0 {
            return 1;
        }
    }
    return 0;
}

fn native_build_hosted_coreir_append_return_stmt(lowered: &LoweredProgram,
    body_id: i32, stmt_node: &ASTNode, expr_id: CoreExprId) i32 {
    if lowered == null || stmt_node == null {
        return -1;
    }
    const stmt_id: i32 = lowered.core_stmt_count as i32;
    var stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_id,
        kind: CORE_STMT_KIND_RETURN,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_id,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: stmt_node.line,
        cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
        flags: 0,
    };
    return lowered_program_append_core_stmt(lowered, &stmt);
}

fn native_build_hosted_coreir_append_int_literal_expr(lowered: &LoweredProgram,
    body_id: i32, expr_node: &ASTNode, type_id: TypeId) i32 {
    if lowered == null || expr_node == null || expr_node.type != ASTNodeType.AST_NUMBER ||
       type_id == TYPED_PROGRAM_INVALID_ID {
        return -1;
    }
    const expr_id: i32 = lowered.core_expr_count as i32;
    var expr: CoreExpr = CoreExpr{
        expr_id: expr_id,
        kind: CORE_EXPR_KIND_INT_LITERAL,
        body_id: body_id,
        source_expr_id: expr_node.expr_id,
        type_id: type_id,
        literal_i64: expr_node.number_value_i64,
        lhs_expr_id: CORE_EXPR_INVALID_ID,
        rhs_expr_id: CORE_EXPR_INVALID_ID,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: expr_node.line,
        flags: 0,
    };
    return lowered_program_append_core_expr(lowered, &expr);
}

fn native_build_hosted_coreir_append_safe_core_body(lowered: &LoweredProgram,
    checker: &TypeChecker, function_id: i32, decl_index: i32, decl: &ASTNode) i32 {
    if lowered == null || decl == null || decl.fn_decl_body == null ||
       decl.fn_decl_body.type != ASTNodeType.AST_BLOCK {
        return -1;
    }
    const body_id: i32 = lowered.core_body_count as i32;
    var root_stmt_start: i32 = CORE_STMT_INVALID_ID;
    var root_stmt_count: i32 = 0;
    var stmt_node: &ASTNode = null;
    var expr_start: i32 = CORE_EXPR_INVALID_ID;
    var expr_count: i32 = 0;
    var stmt_expr_id: CoreExprId = CORE_EXPR_INVALID_ID;
    var return_number_expr: &ASTNode = null;
    var return_number_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    if decl.fn_decl_body.block_stmt_count == 1 {
        root_stmt_start = lowered.core_stmt_count as i32;
        root_stmt_count = 1;
        stmt_node = decl.fn_decl_body.block_stmts[0];
        return_number_expr = native_build_hosted_return_number_expr(decl);
        if return_number_expr != null {
            if native_build_hosted_ensure_expr_type_id(checker, return_number_expr,
                &return_number_type_id) != 0 {
                return -1;
            }
            expr_start = lowered.core_expr_count as i32;
            expr_count = 1;
            stmt_expr_id = expr_start;
        }
    }
    var body: CoreBody = CoreBody{
        body_id: body_id,
        function_id: function_id,
        decl_id: decl_index,
        root_stmt_start: root_stmt_start,
        root_stmt_count: root_stmt_count,
        expr_start: expr_start,
        expr_count: expr_count,
        place_start: CORE_PLACE_INVALID_ID,
        place_count: 0,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        semantic_fact_start: CORE_SEMANTIC_FACT_INVALID_ID,
        semantic_fact_count: 0,
        source_span_id: decl.line,
        flags: CORE_BODY_FLAG_SOURCE_BODY,
    };
    if lowered_program_append_core_body(lowered, &body) != 0 {
        return -1;
    }
    if root_stmt_count == 1 {
        if native_build_hosted_coreir_append_return_stmt(lowered, body_id, stmt_node,
            stmt_expr_id) != 0 {
            return -1;
        }
        if return_number_expr != null {
            return native_build_hosted_coreir_append_int_literal_expr(lowered, body_id,
                return_number_expr, return_number_type_id);
        }
    }
    return 0;
}

fn native_build_hosted_coreir_append_program_functions(lowered: &LoweredProgram,
    checker: &TypeChecker, program: &ASTNode, result: &NativeHostedMirPreflightResult) i32 {
    if lowered == null || checker == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || result == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            const function_id: i32 = lowered.function_count as i32;
            const materialize_safe_body: i32 = native_build_hosted_decl_can_materialize_safe_core_body(decl, checker);
            var function: ConcreteFunction = native_build_hosted_core_function_from_decl(function_id, i, decl);
            if materialize_safe_body != 0 {
                function.body_start = lowered.core_body_count as i32;
                function.body_count = 1;
            }
            if lowered_program_append_function(lowered, &function) != 0 {
                return -1;
            }
            if materialize_safe_body != 0 {
                if native_build_hosted_coreir_append_safe_core_body(lowered, checker, function_id, i, decl) != 0 {
                    return -1;
                }
            } else if decl.fn_decl_is_extern == 0 && decl.fn_decl_body != null {
                result.core_pending_body_count = result.core_pending_body_count + 1;
            }
        }
        i = i + 1;
    }
    result.core_function_count = lowered.function_count as i32;
    result.core_body_count = lowered.core_body_count as i32;
    return 0;
}

fn native_build_hosted_coreir_preflight(arena: &CompilerArena, checker: &TypeChecker,
    program: &ASTNode, result: &NativeHostedMirPreflightResult) i32 {
    if arena == null || checker == null || program == null || result == null {
        return -1;
    }
    var lowered_plan: NativeBuildLoweredPlan = native_build_lowered_plan_empty();
    lowered_program_init(&lowered_plan.lowered, arena);
    if native_build_hosted_coreir_append_program_functions(&lowered_plan.lowered,
        checker, program, result) != 0 {
        lowered_program_release(&lowered_plan.lowered);
        return -1;
    }
    var core_result: CoreVerifierResult = native_build_empty_core_verifier_result();
    if lowered_program_verify_coreir_result(&lowered_plan.lowered, &core_result) != 0 {
        result.core_verifier_error = core_result.error_code;
        lowered_program_release(&lowered_plan.lowered);
        return -1;
    }
    result.core_verifier_error = core_result.error_code;
    lowered_program_release(&lowered_plan.lowered);
    return 0;
}

fn native_build_hosted_mir_signature_placeholder_type(type_id: i32) MirType {
    return MirType{
        type_id: type_id,
        kind: MIR_TYPE_KIND_VOID,
        source_type_id: -1,
        size_bytes: 0usize,
        align_bytes: 0usize,
        layout_id: -1,
        tag_offset_bytes: 0usize,
        payload_offset_bytes: 0usize,
        atomic_align_bytes: 0usize,
        element_type_id: MIR_TYPE_INVALID_ID,
        pointee_type_id: MIR_TYPE_INVALID_ID,
        field_start: 0,
        field_count: 0,
        lane_count: 0,
        lane_stride_bytes: 0usize,
        mask_representation: 0,
        abi_class: MIR_ABI_CLASS_DIRECT,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        flags: 0,
    };
}

fn native_build_hosted_mir_ensure_signature_type(module: &PortableMirModule,
    out_signature_type_id: &i32) i32 {
    if out_signature_type_id != null {
        *out_signature_type_id = MIR_TYPE_INVALID_ID;
    }
    if module == null || out_signature_type_id == null {
        return -1;
    }
    if module.type_count > 0usize {
        *out_signature_type_id = 0;
        return 0;
    }
    const type_id: i32 = module.type_count as i32;
    var typ: MirType = native_build_hosted_mir_signature_placeholder_type(type_id);
    if portable_mir_append_type(module, &typ) != 0 {
        return -1;
    }
    *out_signature_type_id = type_id;
    return 0;
}

fn native_build_hosted_mir_append_extern_function(module: &PortableMirModule,
    decl_index: i32) i32 {
    if module == null || decl_index < 0 {
        return -1;
    }
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: function_id,
        decl_id: decl_index,
        source_core_body_id: CORE_BODY_INVALID_ID,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: 0,
        local_count: 0,
        block_start: 0,
        block_count: 0,
        entry_block_id: MIR_BLOCK_INVALID_ID,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_C,
        runtime_capability_mask: MIR_RUNTIME_CAP_C_EXTERN,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: MIR_FUNCTION_FLAG_EXTERN,
    };
    return portable_mir_append_function(module, &function);
}

fn native_build_hosted_mir_append_program_externs(module: &PortableMirModule,
    program: &ASTNode, out_mir_extern_function_count: &i32) i32 {
    if out_mir_extern_function_count != null {
        *out_mir_extern_function_count = 0;
    }
    if module == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_mir_extern_function_count == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_extern != 0 {
            if native_build_hosted_mir_append_extern_function(module, i) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    *out_mir_extern_function_count = module.function_count as i32;
    return 0;
}

fn native_build_hosted_decl_can_lower_void_mir_body(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_body == null ||
       decl.fn_decl_body.type != ASTNodeType.AST_BLOCK || decl.fn_decl_param_count != 0 ||
       decl.fn_decl_is_extern != 0 || decl.fn_decl_is_async != 0 ||
       decl.fn_decl_is_naked != 0 || decl.fn_decl_is_varargs != 0 ||
       native_build_type_named_equals(decl.fn_decl_return_type, "void" as &byte) == 0 {
        return 0;
    }
    if decl.fn_decl_body.block_stmt_count == 0 {
        return 1;
    }
    if decl.fn_decl_body.block_stmt_count == 1 && decl.fn_decl_body.block_stmts != null {
        const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
        if stmt != null && stmt.type == ASTNodeType.AST_RETURN_STMT &&
           stmt.return_stmt_expr == null {
            return 1;
        }
    }
    return 0;
}

fn native_build_hosted_mir_append_void_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 {
        return -1;
    }
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    const block_id: i32 = module.block_count as i32;
    const terminator_id: i32 = module.terminator_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: 0,
        local_count: 0,
        block_start: block_id,
        block_count: 1,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_RETURN,
        operand_start: 0,
        operand_count: 0,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: 0,
        inst_count: 0,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 {
        return -1;
    }
    if portable_mir_append_terminator(module, &terminator) != 0 {
        return -1;
    }
    return portable_mir_append_block(module, &block);
}

fn native_build_hosted_mir_append_program_void_bodies(module: &PortableMirModule,
    checker: &TypeChecker, program: &ASTNode, out_mir_body_function_count: &i32) i32 {
    if out_mir_body_function_count != null {
        *out_mir_body_function_count = 0;
    }
    if module == null || checker == null || program == null ||
       program.type != ASTNodeType.AST_PROGRAM || program.program_decls == null ||
       out_mir_body_function_count == null {
        return -1;
    }
    var i: i32 = 0;
    var lowered_function_id: i32 = 0;
    var source_core_body_id: i32 = 0;
    var body_function_count: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            const has_safe_core_body: i32 = native_build_hosted_decl_can_materialize_safe_core_body(decl, checker);
            if has_safe_core_body != 0 {
                if native_build_hosted_decl_can_lower_void_mir_body(decl) != 0 {
                    if native_build_hosted_mir_append_void_body_function(module,
                        lowered_function_id, i, source_core_body_id) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                }
                source_core_body_id = source_core_body_id + 1;
            }
            lowered_function_id = lowered_function_id + 1;
        }
        i = i + 1;
    }
    *out_mir_body_function_count = body_function_count;
    return 0;
}

fn native_build_hosted_link_plan_add_program_externs(plan: &NativeHostedLinkPlan,
    program: &ASTNode, out_extern_symbol_count: &i32) i32 {
    if out_extern_symbol_count != null {
        *out_extern_symbol_count = 0;
    }
    if plan == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_extern_symbol_count == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_extern != 0 {
            if native_hosted_link_plan_add_extern_symbol(plan, i) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    *out_extern_symbol_count = plan.extern_symbol_count;
    return 0;
}

fn native_build_hosted_portable_mir_preflight(arena: &CompilerArena, checker: &TypeChecker,
    program: &ASTNode, c_import_count: i32, result: &NativeHostedMirPreflightResult) i32 {
    native_build_hosted_preflight_result_reset(result);
    if arena == null || checker == null || program == null || result == null || c_import_count < 0 {
        return -1;
    }
    if native_build_hosted_coreir_preflight(arena, checker, program, result) != 0 {
        return -1;
    }
    var module: PortableMirModule = native_build_empty_portable_mir_module();
    portable_mir_module_init(&module, arena);
    if native_build_hosted_mir_append_program_externs(&module, program,
        &result.mir_extern_function_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    if native_build_hosted_mir_append_program_void_bodies(&module, checker, program,
        &result.mir_body_function_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    result.mir_type_count = module.type_count as i32;
    var verifier: MirVerifierResult = MirVerifierResult{
        error_code: -1,
        function_id: MIR_FUNCTION_INVALID_ID,
        block_id: MIR_BLOCK_INVALID_ID,
        inst_id: MIR_INST_INVALID_ID,
        value_id: MIR_VALUE_INVALID_ID,
        type_id: MIR_TYPE_INVALID_ID,
        operand_id: -1,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
    };
    portable_mir_verifier_result_init(&verifier);
    if portable_mir_verify_module(&module, &verifier) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var request: MirTargetBackendRequest = native_build_empty_mir_backend_request();
    if portable_mir_backend_request_init(&request, &module, &verifier,
        MIR_TARGET_BACKEND_MACHINE) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var plan: NativeHostedLinkPlan = native_hosted_link_plan_empty();
    if native_hosted_link_plan_init(&plan, &request) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    if native_build_hosted_link_plan_add_program_externs(&plan, program,
        &result.extern_symbol_count) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var imported: i32 = 0;
    while imported < c_import_count {
        if native_hosted_link_plan_add_c_import_object(&plan) != 0 {
            result.verifier_error = verifier.error_code;
            portable_mir_module_release(&module);
            return -1;
        }
        imported = imported + 1;
    }
    result.verifier_error = verifier.error_code;
    result.object_count = plan.object_count;
    portable_mir_module_release(&module);
    return 0;
}

fn native_build_print_hosted_portable_mir_lowering_missing(c_import_count: i32, preflight_status: i32,
    result: &NativeHostedMirPreflightResult) void {
    if result == null {
        return;
    }
    fprintf(libc.stderr,
        "native_hosted_coreir_preflight: status=%d verifier_error=%d functions=%d core_bodies=%d pending_bodies=%d\n" as *byte,
        preflight_status, result.core_verifier_error, result.core_function_count,
        result.core_body_count, result.core_pending_body_count);
    fprintf(libc.stderr,
        "native_hosted_preflight: status=%d verifier_error=%d mir_extern_functions=%d mir_body_functions=%d mir_types=%d extern_symbols=%d c_import_objects=%d hosted_link_objects=%d\n" as *byte,
        preflight_status, result.verifier_error, result.mir_extern_function_count,
        result.mir_body_function_count, result.mir_type_count, result.extern_symbol_count,
        c_import_count, result.object_count);
    fprintf(libc.stderr,
        "native_unsupported_hosted_path: reason=native_hosted_portable_mir_lowering_missing required=CoreBody+PortableMIR function-body lowering\n" as *byte);
    fprintf(libc.stderr,
        "错误: hosted native backend 已完成 PortableMIR/NativeHostedLinkPlan preflight，但尚未接入函数体 MIR lowering；build-seed LoweredProgram helper 仅限 --nostdlib freestanding 子集\n" as *byte);
}

fn native_build_core_function_flags_from_decl(decl: &ASTNode) i32 {
    var flags: i32 = 0;
    if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_naked != 0 {
        flags = flags | CORE_FUNCTION_FLAG_NAKED;
    }
    return flags;
}

fn native_build_find_function_index(program: &ASTNode, name: &byte) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return -1;
    }
    var i: i32 = 0;
    var function_index: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name, name as *byte) != 0 {
            if native_build_decl_is_noarg_i32_fn(decl) != 0 {
                return function_index;
            }
            native_build_print_unsupported_decl(decl, i);
            return -1;
        }
        if native_build_decl_is_noarg_i32_fn(decl) != 0 {
            function_index = function_index + 1;
        }
        i = i + 1;
    }
    return -1;
}

fn native_build_find_function_decl_index(program: &ASTNode, name: &byte) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if native_build_decl_is_noarg_i32_fn(decl) != 0 &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name, name as *byte) != 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

