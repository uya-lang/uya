// build_compiler_driver.uya - build-only compiler CLI driver
// Uya 自举编译器
// 架构：export fn main 编译为 main_main，由 std.runtime.entry 的 C main 调用
// 命令行参数通过 get_argc/get_argv 获取

// ===== 模块导入（按依赖顺序）=====
// build_compiler_driver 只保留 C99 build/link 所需依赖，作为 Phase 8 build seed 根。
use arena;
use ast;
use lexer;
use extern_decls;
use str_utils;
use std_cfg;
use parser;
use semantic;
use typed;
use checker_build;  // build seed 专用 checker，裁掉 microapp/container-only 静态字符串
use driver;
use lower.core;
use lower.mir;
use lower.mir_contract;
use lower.mir_verifier;
use lower.mir_backend;
// C99 build seed 专用代码生成（子目录，整体导入该目录模块）
use codegen.c99_build;
use codegen.native.hosted_link;
use codegen.native_build;
use std;
// C 程序入口由编译器自动注入 std.runtime.entry；此处仅导入堆栈上限设置（避免与局部名 entry 冲突）
use std.runtime.entry.set_process_stack_limit_bytes;
use libc;
use libc.stdlib;  // clock, CLOCKS_PER_SEC
use libc.unistd;  // system

// ===== 计时函数 =====
// 暂时禁用精确计时，使用简单计数器

// 编译统计结构体
struct CompileStats {
    parse_time_ms: i64,      // 解析阶段耗时（毫秒）
    merge_time_ms: i64,      // AST 合并耗时
    check_time_ms: i64,      // 类型检查耗时
    opt_time_ms: i64,        // 优化阶段耗时（v0.7.3 新增）
    codegen_time_ms: i64,    // 代码生成耗时
    total_time_ms: i64,      // 总耗时
    file_count: i32,         // 编译文件数
    ast_nodes: i32,          // AST 节点数（近似）
    arena_peak_bytes: usize, // 所有编译器 arena 峰值合计（driver+ast+check+emit）
    ast_arena_peak_bytes: usize,   // parser AST / lexer / merge 专用 arena 峰值
    check_arena_peak_bytes: usize, // checker 工作内存专用 arena 峰值
    emit_arena_peak_bytes: usize,  // C99 emitter 专用 arena 峰值
    c99_output_buffer_peak_bytes: usize, // C99 输出 FILE 缓冲峰值
    typed_program_bytes: usize,
    typed_program_peak_bytes: usize,
    typed_program_released_bytes: usize,
    table_items: usize,          // 所有编译器动态表实际项数之和
    table_capacity: usize,       // 所有编译器动态表容量项数之和
    table_used_bytes: usize,     // 所有编译器动态表实际占用字节之和
    table_capacity_bytes: usize, // 所有编译器动态表容量字节之和
    table_realloc_count: i32,    // 所有编译器动态表重分配次数之和
}

struct CImportItem {
    resolved_path: &byte,
    relative_path: &byte,
    cflags_tokens: & & byte,
    cflags_token_count: i32,
    filename: &byte,
    line: i32,
    column: i32,
}

struct CImportPlan {
    items: &CImportItem,
    item_count: i32,
    aggregated_ldflags_tokens: & & byte,
    aggregated_ldflags_token_count: i32,
}

struct CompileArtifacts {
    generated_c_path: &byte,
    c_import_plan: CImportPlan,
    c_import_sidecar_path: &byte,
}

struct NativeHostedMirPreflightResult {
    core_verifier_error: i32,
    core_function_count: i32,
    core_body_count: i32,
    core_pending_body_count: i32,
    verifier_error: i32,
    object_count: i32,
    extern_symbol_count: i32,
    mir_extern_function_count: i32,
    mir_body_function_count: i32,
    mir_type_count: i32,
}

fn compile_stats_record_and_release_typed_program(stats: &CompileStats, checker: &TypeChecker) void {
    if stats == null {
        return;
    }
    stats.typed_program_bytes = 0usize;
    stats.typed_program_peak_bytes = 0usize;
    stats.typed_program_released_bytes = 0usize;
    if checker == null {
        return;
    }
    stats.typed_program_bytes = typed_program_current_bytes(&checker.typed_program);
    stats.typed_program_peak_bytes = typed_program_peak_bytes(&checker.typed_program);
    // 在释放 TypedProgram 之前，聚合所有编译器动态表（SemanticDb + TypedProgram）的
    // 项数/容量/字节/重分配次数，供 benchmark 输出 table_* 字段（L391）。
    // 注：C99/checker 固定表仍为 C99_MAX_*/*_SIZE 静态容量，尚未迁为动态表，不计入此聚合。
    var table_agg: SemanticTableAgg = semantic_table_agg_init();
    semantic_db_accumulate_table_stats(&checker.semantic_db, &table_agg);
    typed_program_accumulate_table_stats(&checker.typed_program, &table_agg);
    stats.table_items = table_agg.items;
    stats.table_capacity = table_agg.capacity;
    stats.table_used_bytes = table_agg.used_bytes;
    stats.table_capacity_bytes = table_agg.capacity_bytes;
    stats.table_realloc_count = table_agg.realloc_count;
    typed_program_release(&checker.typed_program);
    semantic_vector_release(&checker.typed_type_records);
    stats.typed_program_released_bytes = typed_program_current_bytes(&checker.typed_program);
}

fn compiler_should_profile_diagnostics() i32 {
    const value: *byte = getenv("UYA_PROFILE_DIAGNOSTICS" as *byte);
    if value == null || value[0] == 0 as byte {
        return 0;
    }
    if strcmp(value, "0" as *byte) == 0 ||
       strcmp(value, "false" as *byte) == 0 ||
       strcmp(value, "no" as *byte) == 0 ||
       strcmp(value, "off" as *byte) == 0 {
        return 0;
    }
    return 1;
}

fn compiler_print_diagnostic_profile(checker: &TypeChecker) void {
    if compiler_should_profile_diagnostics() == 0 || libc.stderr == null {
        return;
    }
    var count: i32 = 0;
    if checker != null {
        count = checker.diagnostic_format_count;
    }
    fprintf(libc.stderr, "diagnostic_format_count: %d\n" as *byte, count);
}

// Host-side reserve constants for older bootstrap compilers whose generated C
// layout may lag the current Uya struct layout.
const HOST_SIZE_PTR_BYTES: usize = 8usize;
const HOST_SIZE_LEXER_BYTES: usize = 1052744usize;
// Host-side reserve for TypeChecker. The async metadata tables live near the
// end of this structure in generated C, so keep slack for bootstrap layout
// drift when rebuilding from an older compiler.
const HOST_SIZE_TYPECHECKER_BYTES: usize = 8388608usize;
// Host-side reserve for C99CodeGenerator. The generated C layout can change as
// backend caches grow; keep this above the exact current sizeof to avoid arena
// overlap when bootstrapping from an older compiler.
const HOST_SIZE_C99_CODEGENERATOR_BYTES: usize = 2097152usize;
const HOST_SIZE_CIMPORT_ITEM_BYTES: usize = 48usize;

// 后端类型
enum BackendType {
    BACKEND_LLVM,
    BACKEND_C99,
    BACKEND_NATIVE
}

struct NativeBuildAstPlan {
    plans: &NativeBuildFunctionPlan,
    function_count: i32,
    entry_index: i32,
}

struct NativeBuildLoweredPlan {
    lowered: LoweredProgram,
    entry_index: i32,
}

struct NativeBuildReachability {
    decl_to_function_index: &i32,
    function_decl_indices: &i32,
    assigned_count: i32,
    capacity: i32,
}

struct NativeBuildLocalTable {
    names: & & byte,
    call_targets: &i32,
    kinds: &i32,
    init_values: &i32,
    static_knowns: &i32,
    lengths: &i32,
    count: i32,
    capacity: i32,
}

const NATIVE_BUILD_LOCAL_KIND_CALL_I32: i32 = 1;
const NATIVE_BUILD_LOCAL_KIND_SCALAR_I32: i32 = 2;
const NATIVE_BUILD_LOCAL_KIND_ARGV_PTR: i32 = 3;

fn native_build_ast_plan_empty() NativeBuildAstPlan {
    return NativeBuildAstPlan{
        plans: null,
        function_count: 0,
        entry_index: -1,
    };
}

fn native_build_empty_vector() SemanticVector {
    return SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
}

