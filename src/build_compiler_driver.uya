        source_span_id: compare_number_expr.line,
        flags: 0,
    };
    var cond_expr: CoreExpr = CoreExpr{
        expr_id: expr_start + 3,
        kind: CORE_EXPR_KIND_I32_NE,
        body_id: body_id,
        source_expr_id: if_stmt.if_stmt_condition.expr_id,
        type_id: condition_type_id,
        literal_i64: 0i64,
        lhs_expr_id: expr_start + 1,
        rhs_expr_id: expr_start + 2,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: if_stmt.if_stmt_condition.line,
        flags: 0,
    };
    var then_expr: CoreExpr = CoreExpr{
        expr_id: expr_start + 4,
        kind: CORE_EXPR_KIND_INT_LITERAL,
        body_id: body_id,
        source_expr_id: then_return_expr.expr_id,
        type_id: then_return_type_id,
        literal_i64: then_return_expr.number_value_i64,
        lhs_expr_id: CORE_EXPR_INVALID_ID,
        rhs_expr_id: CORE_EXPR_INVALID_ID,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: then_return_expr.line,
        flags: 0,
    };
    var final_expr: CoreExpr = CoreExpr{
        expr_id: expr_start + 5,
        kind: CORE_EXPR_KIND_INT_LITERAL,
        body_id: body_id,
        source_expr_id: final_return_expr.expr_id,
        type_id: final_return_type_id,
        literal_i64: final_return_expr.number_value_i64,
        lhs_expr_id: CORE_EXPR_INVALID_ID,
        rhs_expr_id: CORE_EXPR_INVALID_ID,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: final_return_expr.line,
        flags: 0,
    };
    var local_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start,
        kind: CORE_STMT_KIND_LOCAL_DECL,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start,
        place_id: place_start,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: local_decl.line,
        cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
        flags: 0,
    };
    var if_core_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start + 1,
        kind: CORE_STMT_KIND_IF,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: stmt_start + 2,
        child_stmt_count: 1,
        expr_id: expr_start + 3,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: if_stmt.line,
        cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
        flags: 0,
    };
    var then_return_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start + 2,
        kind: CORE_STMT_KIND_RETURN,
        body_id: body_id,
        parent_stmt_id: stmt_start + 1,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start + 4,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: then_return_expr.line,
        cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
        flags: 0,
    };
    var final_return_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start + 3,
        kind: CORE_STMT_KIND_RETURN,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start + 5,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: final_return_expr.line,
        cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
        flags: 0,
    };
    if lowered_program_append_core_body(lowered, &body) != 0 {
        return -1;
    }
    if lowered_program_append_core_place(lowered, &place) != 0 {
        return -1;
    }
    if lowered_program_append_core_expr(lowered, &call_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &local_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &compare_number) != 0 ||
       lowered_program_append_core_expr(lowered, &cond_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &then_expr) != 0 ||
       lowered_program_append_core_expr(lowered, &final_expr) != 0 {
        return -1;
    }
    if lowered_program_append_core_stmt(lowered, &local_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &if_core_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &then_return_stmt) != 0 ||
       lowered_program_append_core_stmt(lowered, &final_return_stmt) != 0 {
        return -1;
    }
    return 0;
}

fn native_build_hosted_coreir_append_main_prefix_body(lowered: &LoweredProgram,
    checker: &TypeChecker, program: &ASTNode, function_id: i32, decl_index: i32,
    decl: &ASTNode) i32 {
    if lowered == null || checker == null || program == null || decl == null ||
       decl.fn_decl_body == null || decl.fn_decl_body.block_stmts == null ||
       decl.fn_decl_body.block_stmt_count < 3 {
        return -1;
    }
    const local0: &ASTNode = decl.fn_decl_body.block_stmts[0];
    const local1: &ASTNode = decl.fn_decl_body.block_stmts[1];
    const if_stmt: &ASTNode = decl.fn_decl_body.block_stmts[2];
    if local0 == null || local1 == null || if_stmt == null ||
       local0.var_decl_init == null || local1.var_decl_init == null {
        return -1;
    }
    var local_ref_expr: &ASTNode = null;
    var compare_number_expr: &ASTNode = null;
    if native_build_hosted_if_local_ne_number(if_stmt, local0.var_decl_name,
        &local_ref_expr, &compare_number_expr) == 0 {
        return -1;
    }
    const then_return_expr: &ASTNode = native_build_hosted_if_then_number_return_expr(if_stmt);
    if then_return_expr == null {
        return -1;
    }
    var call0_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var call1_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var local_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var compare_number_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var condition_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var then_return_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_ensure_expr_type_id(checker, local0.var_decl_init,
        &call0_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, local1.var_decl_init,
        &call1_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, local_ref_expr,
        &local_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, compare_number_expr,
        &compare_number_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, if_stmt.if_stmt_condition,
        &condition_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, then_return_expr,
        &then_return_type_id) != 0 {
        return -1;
    }
    var call0_target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var call0_target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var call1_target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var call1_target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_return_call_target(program, local0.var_decl_init,
        &call0_target_function_id, &call0_target_decl_index) == 0 ||
       native_build_hosted_return_call_target(program, local1.var_decl_init,
        &call1_target_function_id, &call1_target_decl_index) == 0 {
        return -1;
    }
    const body_id: i32 = lowered.core_body_count as i32;
    const stmt_start: i32 = lowered.core_stmt_count as i32;
    const expr_start: i32 = lowered.core_expr_count as i32;
    const place_start: i32 = lowered.core_place_count as i32;
    var body: CoreBody = CoreBody{
        body_id: body_id,
        function_id: function_id,
        decl_id: decl_index,
        root_stmt_start: stmt_start,
        root_stmt_count: 4,
        expr_start: expr_start,
        expr_count: 6,
        place_start: place_start,
        place_count: 2,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        semantic_fact_start: CORE_SEMANTIC_FACT_INVALID_ID,
        semantic_fact_count: 0,
        source_span_id: decl.line,
        flags: CORE_BODY_FLAG_SOURCE_BODY | CORE_BODY_FLAG_PARTIAL,
    };
    var place0: CorePlace = CorePlace{
        place_id: place_start,
        kind: CORE_PLACE_KIND_LOCAL,
        body_id: body_id,
        source_expr_id: local0.var_decl_init.expr_id,
        type_id: call0_type_id,
        base_place_id: CORE_PLACE_INVALID_ID,
        index_expr_id: CORE_EXPR_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        symbol_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: local0.line,
        flags: 0,
    };
    var place1: CorePlace = CorePlace{
        place_id: place_start + 1,
        kind: CORE_PLACE_KIND_LOCAL,
        body_id: body_id,
        source_expr_id: local1.var_decl_init.expr_id,
        type_id: call1_type_id,
        base_place_id: CORE_PLACE_INVALID_ID,
        index_expr_id: CORE_EXPR_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
