fn native_build_hosted_return_extern_const2_call_expr(program: &ASTNode,
    decl: &ASTNode, out_function_id: &i32, out_decl_index: &i32,
    out_arg0: &i32, out_arg1: &i32) &ASTNode {
    if out_function_id != null {
        *out_function_id = TYPED_PROGRAM_INVALID_ID;
    }
    if out_decl_index != null {
        *out_decl_index = TYPED_PROGRAM_INVALID_ID;
    }
    if out_arg0 != null {
        *out_arg0 = 0;
    }
    if out_arg1 != null {
        *out_arg1 = 0;
    }
    if program == null || native_build_decl_is_noarg_i32_fn(decl) == 0 ||
       decl.fn_decl_name == null ||
       str_equals(decl.fn_decl_name as *byte, "main" as *byte) == 0 ||
       decl.fn_decl_body == null || decl.fn_decl_body.type != ASTNodeType.AST_BLOCK ||
       decl.fn_decl_body.block_stmt_count != 1 || decl.fn_decl_body.block_stmts == null ||
       out_function_id == null || out_decl_index == null ||
       out_arg0 == null || out_arg1 == null {
        return null;
    }
    const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
    if stmt == null || stmt.type != ASTNodeType.AST_RETURN_STMT ||
       stmt.return_stmt_expr == null ||
       stmt.return_stmt_expr.type != ASTNodeType.AST_CALL_EXPR {
        return null;
    }
    var extern_name: &byte = null;
    if native_build_hosted_const2_extern_call_args(program, stmt.return_stmt_expr,
        &extern_name, out_arg0, out_arg1) == 0 {
        return null;
    }
    if native_build_hosted_find_extern_two_i32_function(program, extern_name,
        out_function_id, out_decl_index) == 0 {
        return null;
    }
    return stmt.return_stmt_expr;
}

