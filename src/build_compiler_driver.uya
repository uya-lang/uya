    var expr_start: i32 = CORE_EXPR_INVALID_ID;
    var expr_count: i32 = 0;
    var stmt_expr_id: CoreExprId = CORE_EXPR_INVALID_ID;
    var return_const_expr: &ASTNode = null;
    var return_const_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var return_const_value: i32 = 0;
    var return_call_expr: &ASTNode = null;
    var return_call_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var return_call_target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var return_call_target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var body_flags: i32 = CORE_BODY_FLAG_SOURCE_BODY;
    if decl.fn_decl_body.block_stmt_count == 0 {
        root_stmt_start = lowered.core_stmt_count as i32;
        root_stmt_count = 1;
        body_flags = body_flags | CORE_BODY_FLAG_IMPLICIT_RETURN;
    } else if decl.fn_decl_body.block_stmt_count == 1 {
        root_stmt_start = lowered.core_stmt_count as i32;
        root_stmt_count = 1;
        stmt_node = decl.fn_decl_body.block_stmts[0];
        return_const_expr = native_build_hosted_return_i32_const_expr(decl,
            &return_const_value);
        if return_const_expr != null {
            if native_build_hosted_ensure_expr_type_id(checker, return_const_expr,
                &return_const_type_id) != 0 {
                return -1;
            }
            expr_start = lowered.core_expr_count as i32;
            expr_count = 1;
            stmt_expr_id = expr_start;
        } else {
            return_call_expr = native_build_hosted_return_call_expr(decl);
            if return_call_expr != null {
                if native_build_hosted_return_call_target(program, return_call_expr,
                    &return_call_target_function_id, &return_call_target_decl_index) == 0 {
                    return -1;
                }
                if native_build_hosted_ensure_expr_type_id(checker, return_call_expr,
                    &return_call_type_id) != 0 {
                    return -1;
                }
                expr_start = lowered.core_expr_count as i32;
                expr_count = 1;
                stmt_expr_id = expr_start;
            }
        }
    }
    var body: CoreBody = CoreBody{
        body_id: body_id,
        function_id: function_id,
        decl_id: decl_index,
        root_stmt_start: root_stmt_start,
        root_stmt_count: root_stmt_count,
        expr_start: expr_start,
        expr_count: expr_count,
        place_start: CORE_PLACE_INVALID_ID,
        place_count: 0,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        semantic_fact_start: CORE_SEMANTIC_FACT_INVALID_ID,
        semantic_fact_count: 0,
        source_span_id: decl.line,
        flags: body_flags,
    };
    if lowered_program_append_core_body(lowered, &body) != 0 {
        return -1;
    }
    if decl.fn_decl_body.block_stmt_count == 0 {
        var implicit_return_stmt: CoreStmt = CoreStmt{
            stmt_id: root_stmt_start,
            kind: CORE_STMT_KIND_RETURN,
            body_id: body_id,
            parent_stmt_id: CORE_STMT_INVALID_ID,
            first_child_stmt: CORE_STMT_INVALID_ID,
            child_stmt_count: 0,
            expr_id: CORE_EXPR_INVALID_ID,
            place_id: CORE_PLACE_INVALID_ID,
            cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
            cleanup_edge_count: 0,
            source_span_id: decl.line,
            cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
            flags: CORE_STMT_FLAG_IMPLICIT_RETURN,
        };
        return lowered_program_append_core_stmt(lowered, &implicit_return_stmt);
    }
    if root_stmt_count == 1 {
        if native_build_hosted_coreir_append_return_stmt(lowered, body_id, stmt_node,
            stmt_expr_id) != 0 {
            return -1;
        }
        if return_const_expr != null {
            return native_build_hosted_coreir_append_i32_const_expr(lowered, body_id,
                return_const_expr, return_const_type_id, return_const_value);
        }
        if return_call_expr != null {
            return native_build_hosted_coreir_append_call_expr(lowered, body_id,
                return_call_expr, return_call_type_id, return_call_target_function_id,
                return_call_target_decl_index);
        }
    }
    return 0;
}

fn native_build_hosted_coreir_append_program_functions(lowered: &LoweredProgram,
    checker: &TypeChecker, program: &ASTNode, result: &NativeHostedMirPreflightResult) i32 {
    if lowered == null || checker == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || result == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            const function_id: i32 = lowered.function_count as i32;
            const materialize_prefix_body: i32 = native_build_hosted_decl_can_materialize_main_prefix_body(program, decl, checker);
            const materialize_entry_prefix_body: i32 =
                native_build_hosted_decl_can_materialize_build_driver_run_entry_prefix_body(program, decl, checker);
            const materialize_safe_body: i32 = native_build_hosted_decl_can_materialize_safe_core_body(program, decl, checker);
            var function: ConcreteFunction = native_build_hosted_core_function_from_decl(function_id, i, decl);
            if materialize_prefix_body != 0 || materialize_entry_prefix_body != 0 ||
               materialize_safe_body != 0 {
                function.body_start = lowered.core_body_count as i32;
                function.body_count = 1;
            }
            if lowered_program_append_function(lowered, &function) != 0 {
                return -1;
            }
            if materialize_prefix_body != 0 {
                if native_build_hosted_coreir_append_main_prefix_body(lowered, checker, program,
                    function_id, i, decl) != 0 {
                    return -1;
                }
                result.core_pending_body_count = result.core_pending_body_count + 1;
            } else if materialize_entry_prefix_body != 0 {
                if native_build_hosted_coreir_append_build_driver_run_entry_prefix_body(
                    lowered, checker, program, function_id, i, decl) != 0 {
                    return -1;
                }
                result.core_pending_body_count = result.core_pending_body_count + 1;
            } else if materialize_safe_body != 0 {
                if native_build_hosted_coreir_append_safe_core_body(lowered, checker, program,
                    function_id, i, decl) != 0 {
                    return -1;
                }
            } else if decl.fn_decl_is_extern == 0 && decl.fn_decl_body != null {
                result.core_pending_body_count = result.core_pending_body_count + 1;
            }
        }
        i = i + 1;
    }
    result.core_function_count = lowered.function_count as i32;
    result.core_body_count = lowered.core_body_count as i32;
    native_build_hosted_record_entry_chain_frontier(program, checker, result);
    return 0;
}

fn native_build_hosted_record_entry_chain_frontier(program: &ASTNode, checker: &TypeChecker,
    result: &NativeHostedMirPreflightResult) void {
    if program == null || checker == null || result == null ||
       program.type != ASTNodeType.AST_PROGRAM || program.program_decls == null {
        return;
    }
    const main_decl: &ASTNode = native_build_find_fn_decl_by_name(program, "main" as &byte);
    if main_decl == null {
        return;
    }
    const main_call: &ASTNode = native_build_hosted_return_call_expr(main_decl);
    if main_call == null {
        return;
    }
    var wrapper_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var wrapper_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_return_call_target(program, main_call, &wrapper_function_id,
        &wrapper_decl_index) == 0 || wrapper_decl_index < 0 {
        return;
    }
    const wrapper_decl: &ASTNode = program.program_decls[wrapper_decl_index];
    if wrapper_decl == null || wrapper_decl.type != ASTNodeType.AST_FN_DECL {
        return;
    }
    if native_build_hosted_decl_can_materialize_safe_core_body(program,
        wrapper_decl, checker) == 0 {
        result.entry_pending_callee_name = native_build_decl_name_for_diagnostic(wrapper_decl);
        return;
    }
    result.entry_wrapper_covered = 1;
    const wrapper_call: &ASTNode = native_build_hosted_return_call_expr(wrapper_decl);
    if wrapper_call == null {
        return;
    }
    var pending_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var pending_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_return_call_target(program, wrapper_call, &pending_function_id,
        &pending_decl_index) == 0 || pending_decl_index < 0 {
        return;
    }
    const pending_decl: &ASTNode = program.program_decls[pending_decl_index];
    if pending_decl == null || pending_decl.type != ASTNodeType.AST_FN_DECL {
        return;
    }
    var pending_prefix_stmt_count: i32 =
        native_build_hosted_build_driver_run_user_output_path_prefix_stmt_count(pending_decl,
            checker, program);
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_output_path_prefix_stmt_count(pending_decl,
                checker, program);
    }
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_split_env_prefix_stmt_count(pending_decl,
                checker, program);
    }
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_stack_limit_prefix_stmt_count(pending_decl,
                checker, program);
    }
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_stack_guard_prefix_stmt_count(pending_decl,
                checker, program);
    }
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_stack_init_prefix_stmt_count(pending_decl,
                checker, program);
    }
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_parse_prefix_stmt_count(pending_decl,
                checker, program);
    }
    if pending_prefix_stmt_count == 0 {
        pending_prefix_stmt_count =
            native_build_hosted_build_driver_run_prefix_stmt_count(pending_decl,
                checker);
    }
    if pending_prefix_stmt_count > 0 {
        result.entry_pending_callee_name = native_build_decl_name_for_diagnostic(pending_decl);
        result.entry_pending_callee_prefix_covered = 1;
        result.entry_pending_callee_prefix_stmt_count = pending_prefix_stmt_count;
        if pending_decl.fn_decl_body != null &&
           pending_decl.fn_decl_body.type == ASTNodeType.AST_BLOCK &&
           pending_decl.fn_decl_body.block_stmts != null &&
           pending_decl.fn_decl_body.block_stmt_count > pending_prefix_stmt_count {
            const next_stmt: &ASTNode = pending_decl.fn_decl_body.block_stmts[pending_prefix_stmt_count];
            if next_stmt != null {
                result.entry_pending_callee_next_stmt_index = pending_prefix_stmt_count;
                result.entry_pending_callee_next_stmt_kind =
                    native_build_ast_kind_name(next_stmt.type);
            }
        }
        return;
    }
    if native_build_hosted_decl_can_materialize_safe_core_body(program,
        pending_decl, checker) == 0 {
        result.entry_pending_callee_name = native_build_decl_name_for_diagnostic(pending_decl);
    }
}

fn native_build_hosted_coreir_preflight(arena: &CompilerArena, checker: &TypeChecker,
    program: &ASTNode, result: &NativeHostedMirPreflightResult) i32 {
    if arena == null || checker == null || program == null || result == null {
        return -1;
    }
    var lowered_plan: NativeBuildLoweredPlan = native_build_lowered_plan_empty();
    lowered_program_init(&lowered_plan.lowered, arena);
    if native_build_hosted_coreir_append_program_functions(&lowered_plan.lowered,
        checker, program, result) != 0 {
        lowered_program_release(&lowered_plan.lowered);
        return -1;
    }
    var core_result: CoreVerifierResult = native_build_empty_core_verifier_result();
    if lowered_program_verify_coreir_result(&lowered_plan.lowered, &core_result) != 0 {
        result.core_verifier_error = core_result.error_code;
        lowered_program_release(&lowered_plan.lowered);
        return -1;
    }
    result.core_verifier_error = core_result.error_code;
    lowered_program_release(&lowered_plan.lowered);
    return 0;
}

