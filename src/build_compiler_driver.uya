        if expr.type == ASTNodeType.AST_SIZEOF {
            return native_build_expr_is_side_effect_free_placeholder(expr.sizeof_expr_target);
        }
        return native_build_expr_is_side_effect_free_placeholder(expr.alignof_expr_target);
    }
    if expr.type == ASTNodeType.AST_LEN {
        return native_build_expr_is_side_effect_free_placeholder(expr.len_expr_array);
    }
    if expr.type == ASTNodeType.AST_ARRAY_LITERAL {
        if native_build_expr_is_side_effect_free_placeholder(expr.array_literal_repeat_count_expr) == 0 {
            return 0;
        }
        var i: i32 = 0;
        while i < expr.array_literal_element_count {
            if expr.array_literal_elements == null {
                return 0;
            }
            if native_build_expr_is_side_effect_free_placeholder(expr.array_literal_elements[i]) == 0 {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
    if expr.type == ASTNodeType.AST_STRUCT_INIT {
        if expr.struct_init_field_count > 0 && expr.struct_init_field_values == null {
