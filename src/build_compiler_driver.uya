fn native_build_program_to_function_plan(program: &ASTNode, arena: &CompilerArena) NativeBuildAstPlan {
    if program == null || program.type != ASTNodeType.AST_PROGRAM || program.program_decls == null ||
       program.program_decl_count <= 0 || arena == null {
        return native_build_ast_plan_empty();
    }
    const bytes: usize = @size_of(NativeBuildFunctionPlan) * (program.program_decl_count as usize);
    const plans: &NativeBuildFunctionPlan = compiler_arena_alloc(arena, bytes) as &NativeBuildFunctionPlan;
    if plans == null {
        return native_build_ast_plan_empty();
    }
    var entry_index: i32 = -1;
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if native_build_decl_to_function_plan(program, decl, &plans[i]) == 0 {
            return native_build_ast_plan_empty();
        }
        if decl.fn_decl_name != null && str_equals(decl.fn_decl_name, "main" as *byte) != 0 {
            entry_index = i;
        }
        i = i + 1;
    }
    if entry_index < 0 {
        return native_build_ast_plan_empty();
    }
    return NativeBuildAstPlan{
        plans: plans,
        function_count: program.program_decl_count,
        entry_index: entry_index,
    };
}

