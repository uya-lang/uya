       stmt.type != ASTNodeType.AST_IF_STMT || stmt.if_stmt_else_branch != null ||
       stmt.if_stmt_condition == null || stmt.if_stmt_then_branch == null ||
       stmt.if_stmt_condition.type != ASTNodeType.AST_BINARY_EXPR {
        return 0;
    }
    const cond: &ASTNode = stmt.if_stmt_condition;
    if cond.binary_expr_left == null || cond.binary_expr_right == null {
        return 0;
    }
    const op_tmp: !TokenType = cond.binary_expr_op as! TokenType;
    const op: TokenType = op_tmp catch {
        return 0;
    };
    if op != TokenType.TOKEN_EQUAL && op != TokenType.TOKEN_NOT_EQUAL {
        return 0;
    }

    var local_name: &byte = null;
    var compare_value: i32 = 0;
    if cond.binary_expr_left.type == ASTNodeType.AST_IDENTIFIER &&
       cond.binary_expr_left.identifier_name != null &&
       native_build_expr_scalar_const_value(cond.binary_expr_right, locals, &compare_value) != 0 {
        local_name = cond.binary_expr_left.identifier_name;
    } else if cond.binary_expr_right.type == ASTNodeType.AST_IDENTIFIER &&
       cond.binary_expr_right.identifier_name != null &&
       native_build_expr_scalar_const_value(cond.binary_expr_left, locals, &compare_value) != 0 {
        local_name = cond.binary_expr_right.identifier_name;
