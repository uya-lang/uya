        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var value: MirValue = MirValue{
        value_id: value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: call_expr.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var inst: MirInst = MirInst{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_CALL,
        type_id: i32_type_id,
        result_value_id: value_id,
        operand_start: call_operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: target_decl_index,
    };
    var call_operand: MirOperand = MirOperand{
        operand_id: call_operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: signature_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: target_function_id,
        flags: 0,
    };
    var return_operand: MirOperand = MirOperand{
        operand_id: return_operand_id,
        kind: 0,
        value_id: value_id,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: 0,
        flags: 0,
    };
    var terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_RETURN,
        operand_start: return_operand_id,
        operand_count: 1,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: inst_id,
        inst_count: 1,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 {
        return -1;
    }
    if portable_mir_append_value(module, &value) != 0 {
        return -1;
    }
    if portable_mir_append_inst(module, &inst) != 0 {
        return -1;
    }
    if portable_mir_append_operand(module, &call_operand) != 0 {
        return -1;
    }
    if portable_mir_append_operand(module, &return_operand) != 0 {
        return -1;
    }
    if portable_mir_append_terminator(module, &terminator) != 0 {
        return -1;
    }
    return portable_mir_append_block(module, &block);
}

fn native_build_hosted_mir_append_extern_const2_call_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32,
    decl: &ASTNode, program: &ASTNode) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 || decl == null || program == null {
        return -1;
    }
    var target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var arg0: i32 = 0;
    var arg1: i32 = 0;
    const call_expr: &ASTNode = native_build_hosted_return_extern_const2_call_expr(program,
        decl, &target_function_id, &target_decl_index, &arg0, &arg1);
    if call_expr == null {
        return -1;
    }
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    var i32_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_i32_type(module, &i32_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    const block_id: i32 = module.block_count as i32;
    const inst_id: i32 = module.inst_count as i32;
    const value_id: i32 = module.value_count as i32;
    const call_operand_id: i32 = module.operand_count as i32;
    const arg0_operand_id: i32 = call_operand_id + 1;
    const arg1_operand_id: i32 = call_operand_id + 2;
    const return_operand_id: i32 = call_operand_id + 3;
    const terminator_id: i32 = module.terminator_count as i32;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: 0,
        local_count: 0,
        block_start: block_id,
        block_count: 1,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC + MIR_RUNTIME_CAP_C_EXTERN,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var value: MirValue = MirValue{
        value_id: value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: call_expr.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var inst: MirInst = MirInst{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_CALL,
        type_id: i32_type_id,
        result_value_id: value_id,
        operand_start: call_operand_id,
        operand_count: 3,
        calling_convention: MIR_CALL_CONV_C,
        runtime_capability_mask: MIR_RUNTIME_CAP_C_EXTERN,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: target_decl_index,
    };
    var call_operand: MirOperand = MirOperand{
        operand_id: call_operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: signature_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: target_function_id,
        flags: 0,
    };
    var arg0_operand: MirOperand = MirOperand{
        operand_id: arg0_operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: arg0,
        flags: 0,
    };
    var arg1_operand: MirOperand = MirOperand{
        operand_id: arg1_operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: arg1,
        flags: 0,
    };
    var return_operand: MirOperand = MirOperand{
        operand_id: return_operand_id,
        kind: 0,
        value_id: value_id,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: 0,
        flags: 0,
    };
    var terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_RETURN,
        operand_start: return_operand_id,
        operand_count: 1,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: inst_id,
        inst_count: 1,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 ||
       portable_mir_append_value(module, &value) != 0 ||
       portable_mir_append_inst(module, &inst) != 0 ||
       portable_mir_append_operand(module, &call_operand) != 0 ||
       portable_mir_append_operand(module, &arg0_operand) != 0 ||
       portable_mir_append_operand(module, &arg1_operand) != 0 ||
       portable_mir_append_operand(module, &return_operand) != 0 ||
       portable_mir_append_terminator(module, &terminator) != 0 ||
       portable_mir_append_block(module, &block) != 0 {
        return -1;
    }
    return 0;
}

fn native_build_hosted_mir_append_main_local_if_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32,
    decl: &ASTNode, program: &ASTNode) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 || decl == null || program == null ||
       decl.fn_decl_body == null || decl.fn_decl_body.block_stmts == null ||
       decl.fn_decl_body.block_stmt_count != 3 {
        return -1;
    }
    const local_decl: &ASTNode = decl.fn_decl_body.block_stmts[0];
    const if_stmt: &ASTNode = decl.fn_decl_body.block_stmts[1];
    const final_return: &ASTNode = decl.fn_decl_body.block_stmts[2];
    if local_decl == null || if_stmt == null || final_return == null ||
       local_decl.var_decl_init == null {
        return -1;
    }
    var local_ref_expr: &ASTNode = null;
    var compare_number_expr: &ASTNode = null;
    if native_build_hosted_if_local_ne_number(if_stmt, local_decl.var_decl_name,
        &local_ref_expr, &compare_number_expr) == 0 {
        return -1;
    }
    const then_return_expr: &ASTNode = native_build_hosted_if_then_number_return_expr(if_stmt);
    const final_return_expr: &ASTNode = native_build_hosted_stmt_number_return_expr(final_return);
    if then_return_expr == null || final_return_expr == null {
        return -1;
    }
    var target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_return_call_target(program, local_decl.var_decl_init,
        &target_function_id, &target_decl_index) == 0 {
        return -1;
    }
    const compare_value_result: !i32 = compare_number_expr.number_value_i64 as! i32;
    const compare_value: i32 = compare_value_result catch {
        return -1;
    };
    const then_value_result: !i32 = then_return_expr.number_value_i64 as! i32;
    const then_value: i32 = then_value_result catch {
        return -1;
    };
    const final_value_result: !i32 = final_return_expr.number_value_i64 as! i32;
    const final_value: i32 = final_value_result catch {
        return -1;
    };
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    var i32_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_i32_type(module, &i32_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    const local_id: i32 = module.local_count as i32;
    const block_id: i32 = module.block_count as i32;
    const then_block_id: i32 = block_id + 1;
    const final_block_id: i32 = block_id + 2;
    const value_id: i32 = module.value_count as i32;
    const cond_value_id: i32 = value_id + 1;
    const then_value_id: i32 = value_id + 2;
    const final_value_id: i32 = value_id + 3;
    const inst_id: i32 = module.inst_count as i32;
    const cond_inst_id: i32 = inst_id + 1;
    const then_inst_id: i32 = inst_id + 2;
    const final_inst_id: i32 = inst_id + 3;
    const operand_id: i32 = module.operand_count as i32;
    const cond_operand_id: i32 = operand_id + 1;
    const cond_term_operand_id: i32 = operand_id + 2;
    const then_return_operand_id: i32 = operand_id + 3;
    const final_return_operand_id: i32 = operand_id + 4;
    const successor_id: i32 = module.successor_count as i32;
    const terminator_id: i32 = module.terminator_count as i32;
    const then_terminator_id: i32 = terminator_id + 1;
    const final_terminator_id: i32 = terminator_id + 2;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: local_id,
        local_count: 1,
        block_start: block_id,
        block_count: 3,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var local: MirLocal = MirLocal{
        local_id: local_id,
        function_id: function_id,
        type_id: i32_type_id,
        source_symbol_id: TYPED_PROGRAM_INVALID_ID,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        alignment: 4usize,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call_value: MirValue = MirValue{
        value_id: value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: inst_id,
        local_id: local_id,
        param_index: -1,
        source_expr_id: local_decl.var_decl_init.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var cond_value: MirValue = MirValue{
        value_id: cond_value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: cond_inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: if_stmt.if_stmt_condition.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var then_result_value: MirValue = MirValue{
        value_id: then_value_id,
        function_id: function_id,
        block_id: then_block_id,
        type_id: i32_type_id,
        defining_inst_id: then_inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: then_return_expr.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var final_result_value: MirValue = MirValue{
        value_id: final_value_id,
        function_id: function_id,
        block_id: final_block_id,
        type_id: i32_type_id,
        defining_inst_id: final_inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: final_return_expr.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call_inst: MirInst = MirInst{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_CALL,
        type_id: i32_type_id,
        result_value_id: value_id,
        operand_start: operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: target_decl_index,
    };
    var cond_inst: MirInst = MirInst{
        inst_id: cond_inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: cond_value_id,
        operand_start: cond_operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
