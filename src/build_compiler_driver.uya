    var left_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var right_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var right_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
