       add_expr.binary_expr_right == null {
        return -1;
    }
    var left_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var right_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var add_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_ensure_expr_type_id(checker, add_expr.binary_expr_left,
        &left_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, add_expr.binary_expr_right,
        &right_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker, add_expr, &add_type_id) != 0 {
        return -1;
    }
    const body_id: i32 = lowered.core_body_count as i32;
    const stmt_start: i32 = lowered.core_stmt_count as i32;
    const expr_start: i32 = lowered.core_expr_count as i32;
    const stmt_node: &ASTNode = decl.fn_decl_body.block_stmts[0];
    var body: CoreBody = CoreBody{
        body_id: body_id,
        function_id: function_id,
        decl_id: decl_index,
        root_stmt_start: stmt_start,
        root_stmt_count: 1,
        expr_start: expr_start,
        expr_count: 3,
        place_start: CORE_PLACE_INVALID_ID,
        place_count: 0,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        semantic_fact_start: CORE_SEMANTIC_FACT_INVALID_ID,
        semantic_fact_count: 0,
        source_span_id: decl.line,
        flags: CORE_BODY_FLAG_SOURCE_BODY,
    };
    if lowered_program_append_core_body(lowered, &body) != 0 ||
       native_build_hosted_coreir_append_return_stmt(lowered, body_id, stmt_node,
        expr_start + 2) != 0 ||
       native_build_hosted_coreir_append_call_expr(lowered, body_id,
        add_expr.binary_expr_left, left_type_id, left_function_id,
        left_decl_index) != 0 ||
       native_build_hosted_coreir_append_call_expr(lowered, body_id,
        add_expr.binary_expr_right, right_type_id, right_function_id,
        right_decl_index) != 0 ||
       native_build_hosted_coreir_append_i32_add_expr(lowered, body_id,
        add_expr, add_type_id, expr_start, expr_start + 1) != 0 {
