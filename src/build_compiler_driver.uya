    if op == TokenType.TOKEN_GREATER {
        if left_value > right_value {
            *out_truth = 1;
        }
        return 1;
    }
    if op == TokenType.TOKEN_EQUAL {
        if left_value == right_value {
            *out_truth = 1;
        }
        return 1;
    }
    return 0;
}

