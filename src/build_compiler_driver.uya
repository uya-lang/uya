fn native_build_reachability_empty() NativeBuildReachability {
    return NativeBuildReachability{
        decl_to_function_index: null,
        function_decl_indices: null,
        assigned_count: 0,
        capacity: 0,
    };
}

fn native_build_local_table_empty() NativeBuildLocalTable {
    return NativeBuildLocalTable{
        names: null,
        call_targets: null,
        kinds: null,
        init_values: null,
        static_knowns: null,
        lengths: null,
        count: 0,
        capacity: 0,
    };
}

fn native_build_local_table_init(arena: &CompilerArena, capacity: i32) NativeBuildLocalTable {
    var locals: NativeBuildLocalTable = native_build_local_table_empty();
    if arena == null || capacity <= 0 {
        return locals;
    }
    const cap_usize_result: !usize = capacity as! usize;
    const cap_usize: usize = cap_usize_result catch {
        return locals;
    };
    locals.names = compiler_arena_alloc(arena, @size_of(&byte) * cap_usize) as & & byte;
    locals.call_targets = compiler_arena_alloc(arena, @size_of(i32) * cap_usize) as &i32;
    locals.kinds = compiler_arena_alloc(arena, @size_of(i32) * cap_usize) as &i32;
    locals.init_values = compiler_arena_alloc(arena, @size_of(i32) * cap_usize) as &i32;
    locals.static_knowns = compiler_arena_alloc(arena, @size_of(i32) * cap_usize) as &i32;
    locals.lengths = compiler_arena_alloc(arena, @size_of(i32) * cap_usize) as &i32;
    if locals.names == null || locals.call_targets == null ||
       locals.kinds == null || locals.init_values == null ||
       locals.static_knowns == null || locals.lengths == null {
        return native_build_local_table_empty();
    }
    locals.capacity = capacity;
    var i: i32 = 0;
    while i < capacity {
        locals.names[i] = null;
        locals.call_targets[i] = -1;
        locals.kinds[i] = 0;
        locals.init_values[i] = 0;
        locals.static_knowns[i] = 0;
        locals.lengths[i] = 0;
        i = i + 1;
    }
    return locals;
}

fn native_build_reachability_init(arena: &CompilerArena, decl_count: i32) NativeBuildReachability {
    var reach: NativeBuildReachability = native_build_reachability_empty();
    if arena == null || decl_count <= 0 {
        return reach;
    }
    const count_usize_result: !usize = decl_count as! usize;
    const count_usize: usize = count_usize_result catch {
        return reach;
    };
    const bytes: usize = @size_of(i32) * count_usize;
    reach.decl_to_function_index = compiler_arena_alloc(arena, bytes) as &i32;
    reach.function_decl_indices = compiler_arena_alloc(arena, bytes) as &i32;
    if reach.decl_to_function_index == null || reach.function_decl_indices == null {
        return native_build_reachability_empty();
    }
    reach.capacity = decl_count;
    var i: i32 = 0;
    while i < decl_count {
        reach.decl_to_function_index[i] = -1;
        reach.function_decl_indices[i] = -1;
        i = i + 1;
    }
    return reach;
}

fn native_build_type_is_i32(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_NAMED || type_node.type_named_name == null {
        return 0;
    }
    if str_equals(type_node.type_named_name, "i32" as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_type_named_equals(type_node: &ASTNode, name: &byte) i32 {
    if type_node == null || name == null ||
       type_node.type != ASTNodeType.AST_TYPE_NAMED || type_node.type_named_name == null {
        return 0;
    }
    if str_equals(type_node.type_named_name as *byte, name as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_decl_returns_param_directly(decl: &ASTNode, param_name: &byte) i32 {
    if decl == null || param_name == null || decl.fn_decl_body == null ||
       decl.fn_decl_body.type != ASTNodeType.AST_BLOCK ||
       decl.fn_decl_body.block_stmts == null ||
       decl.fn_decl_body.block_stmt_count != 1 {
        return 0;
    }
    const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
    if stmt == null || stmt.type != ASTNodeType.AST_RETURN_STMT ||
       stmt.return_stmt_expr == null ||
       stmt.return_stmt_expr.type != ASTNodeType.AST_IDENTIFIER ||
       stmt.return_stmt_expr.identifier_name == null {
        return 0;
    }
    if str_equals(stmt.return_stmt_expr.identifier_name as *byte, param_name as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_type_is_backend_type(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_NAMED || type_node.type_named_name == null {
        return 0;
    }
    if str_equals(type_node.type_named_name, "BackendType" as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_type_is_i32_like_scalar(type_node: &ASTNode) i32 {
    if native_build_type_is_i32(type_node) != 0 {
        return 1;
    }
    return native_build_type_is_backend_type(type_node);
}

fn native_build_type_is_byte(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_NAMED || type_node.type_named_name == null {
        return 0;
    }
    if str_equals(type_node.type_named_name, "byte" as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn native_build_type_is_byte_ptr(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_POINTER {
        return 0;
    }
    return native_build_type_is_byte(type_node.type_pointer_pointed_type);
}

fn native_build_type_is_i32_ptr(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_POINTER ||
       type_node.type_pointer_is_ffi_pointer != 0 || type_node.type_pointer_is_const != 0 {
        return 0;
    }
    return native_build_type_is_i32(type_node.type_pointer_pointed_type);
}

fn native_build_type_is_i32_like_ptr(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_POINTER ||
       type_node.type_pointer_is_ffi_pointer != 0 || type_node.type_pointer_is_const != 0 {
        return 0;
    }
    return native_build_type_is_i32_like_scalar(type_node.type_pointer_pointed_type);
}

fn native_build_type_is_i32_array(type_node: &ASTNode) i32 {
    if type_node == null || type_node.type != ASTNodeType.AST_TYPE_ARRAY ||
       native_build_type_is_i32(type_node.type_array_element_type) == 0 ||
       type_node.type_array_size_expr == null ||
       type_node.type_array_size_expr.type != ASTNodeType.AST_NUMBER ||
       type_node.type_array_size_expr.number_value_i64 <= 0i64 {
        return 0;
    }
    return 1;
}

fn native_build_decl_is_noarg_i32_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 0 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 {
        return 0;
    }
    return native_build_type_is_i32(decl.fn_decl_return_type);
}

fn native_build_decl_is_one_i32_param_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 1 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param: &ASTNode = decl.fn_decl_params[0];
    if param == null || param.type != ASTNodeType.AST_VAR_DECL {
        return 0;
    }
    return native_build_type_is_i32(param.var_decl_type);
}

fn native_build_decl_is_identity_generic_i32_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null ||
       decl.fn_decl_type_params == null || decl.fn_decl_type_param_count != 1 {
        return 0;
    }
    if decl.fn_decl_param_count != 1 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || decl.fn_decl_params == null {
        return 0;
    }
    const type_param_name: &byte = decl.fn_decl_type_params[0].name;
    if type_param_name == null {
        return 0;
    }
    const param: &ASTNode = decl.fn_decl_params[0];
    if param == null || param.type != ASTNodeType.AST_VAR_DECL || param.var_decl_name == null {
        return 0;
    }
    if native_build_type_named_equals(param.var_decl_type, type_param_name) == 0 {
        return 0;
    }
    if native_build_type_named_equals(decl.fn_decl_return_type, type_param_name) == 0 {
        return 0;
    }
    return native_build_decl_returns_param_directly(decl, param.var_decl_name);
}

fn native_build_decl_is_two_i32_param_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 2 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param0: &ASTNode = decl.fn_decl_params[0];
    const param1: &ASTNode = decl.fn_decl_params[1];
    if param0 == null || param1 == null ||
       param0.type != ASTNodeType.AST_VAR_DECL || param1.type != ASTNodeType.AST_VAR_DECL {
        return 0;
    }
    if native_build_type_is_i32(param0.var_decl_type) == 0 {
        return 0;
    }
    return native_build_type_is_i32(param1.var_decl_type);
}

fn native_build_decl_is_extern_two_i32_param_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 2 || decl.fn_decl_is_extern == 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param0: &ASTNode = decl.fn_decl_params[0];
    const param1: &ASTNode = decl.fn_decl_params[1];
    if param0 == null || param1 == null ||
       param0.type != ASTNodeType.AST_VAR_DECL || param1.type != ASTNodeType.AST_VAR_DECL {
        return 0;
    }
    if native_build_type_is_i32(param0.var_decl_type) == 0 {
        return 0;
    }
    return native_build_type_is_i32(param1.var_decl_type);
}

fn native_build_decl_is_one_i32_ptr_param_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 1 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param: &ASTNode = decl.fn_decl_params[0];
    if param == null || param.type != ASTNodeType.AST_VAR_DECL {
        return 0;
    }
    return native_build_type_is_i32_ptr(param.var_decl_type);
}

fn native_build_decl_is_two_i32_ptr_param_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 2 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param0: &ASTNode = decl.fn_decl_params[0];
    const param1: &ASTNode = decl.fn_decl_params[1];
    if param0 == null || param1 == null ||
       param0.type != ASTNodeType.AST_VAR_DECL || param1.type != ASTNodeType.AST_VAR_DECL {
        return 0;
    }
    if native_build_type_is_i32_ptr(param0.var_decl_type) == 0 {
        return 0;
    }
    return native_build_type_is_i32_ptr(param1.var_decl_type);
}

fn native_build_decl_is_parse11_i32_fn(decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return 0;
    }
    if decl.fn_decl_param_count != 11 || decl.fn_decl_is_extern != 0 ||
       decl.fn_decl_is_async != 0 || decl.fn_decl_is_naked != 0 ||
       decl.fn_decl_is_varargs != 0 || native_build_type_is_i32(decl.fn_decl_return_type) == 0 ||
       decl.fn_decl_params == null {
        return 0;
    }
    const param0: &ASTNode = decl.fn_decl_params[0];
    const param1: &ASTNode = decl.fn_decl_params[1];
    if param0 == null || param1 == null ||
       param0.type != ASTNodeType.AST_VAR_DECL || param1.type != ASTNodeType.AST_VAR_DECL ||
       native_build_type_is_i32_ptr(param0.var_decl_type) == 0 ||
       native_build_type_is_i32(param1.var_decl_type) == 0 {
        return 0;
    }
    var i: i32 = 2;
    while i < decl.fn_decl_param_count {
        const param: &ASTNode = decl.fn_decl_params[i];
        if param == null || param.type != ASTNodeType.AST_VAR_DECL ||
           native_build_type_is_i32_like_ptr(param.var_decl_type) == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn native_build_decl_is_supported_i32_fn(decl: &ASTNode) i32 {
    if native_build_decl_is_noarg_i32_fn(decl) != 0 {
        return 1;
    }
    if native_build_decl_is_one_i32_param_fn(decl) != 0 {
        return 1;
