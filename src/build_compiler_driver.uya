        if native_build_resolve_reachable_zero_arg_call(program, expr.binary_expr_left, reach, &left_target) != 0 &&
           native_build_resolve_reachable_zero_arg_call(program, expr.binary_expr_right, reach, &right_target) != 0 {
            out_op.opcode = LOWERED_BODY_OP_ADD_I32;
            out_op.src0 = left_target;
            out_op.src1 = right_target;
