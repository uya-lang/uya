        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start + 5,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
