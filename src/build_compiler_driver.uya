fn native_build_expr_is_side_effect_free_placeholder(expr: &ASTNode) i32 {
    if expr == null {
        return 1;
    }
    if expr.type == ASTNodeType.AST_NUMBER || expr.type == ASTNodeType.AST_FLOAT ||
       expr.type == ASTNodeType.AST_BOOL || expr.type == ASTNodeType.AST_CHAR ||
       expr.type == ASTNodeType.AST_STRING || expr.type == ASTNodeType.AST_IDENTIFIER ||
       expr.type == ASTNodeType.AST_INT_LIMIT {
        return 1;
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        return native_build_expr_is_side_effect_free_placeholder(expr.unary_expr_operand);
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        return native_build_expr_is_side_effect_free_placeholder(expr.member_access_object);
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        return native_build_expr_is_side_effect_free_placeholder(expr.cast_expr_expr);
    }
    if expr.type == ASTNodeType.AST_SIZEOF || expr.type == ASTNodeType.AST_ALIGNOF {
        if expr.sizeof_expr_is_type != 0 || expr.alignof_expr_is_type != 0 {
            return 1;
        }
        if expr.type == ASTNodeType.AST_SIZEOF {
            return native_build_expr_is_side_effect_free_placeholder(expr.sizeof_expr_target);
        }
        return native_build_expr_is_side_effect_free_placeholder(expr.alignof_expr_target);
    }
    if expr.type == ASTNodeType.AST_LEN {
        return native_build_expr_is_side_effect_free_placeholder(expr.len_expr_array);
    }
    if expr.type == ASTNodeType.AST_ARRAY_LITERAL {
        if native_build_expr_is_side_effect_free_placeholder(expr.array_literal_repeat_count_expr) == 0 {
            return 0;
        }
        var i: i32 = 0;
        while i < expr.array_literal_element_count {
            if expr.array_literal_elements == null {
                return 0;
            }
            if native_build_expr_is_side_effect_free_placeholder(expr.array_literal_elements[i]) == 0 {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
    if expr.type == ASTNodeType.AST_STRUCT_INIT {
        if expr.struct_init_field_count > 0 && expr.struct_init_field_values == null {
            return 0;
        }
        var si: i32 = 0;
        while si < expr.struct_init_field_count {
            if native_build_expr_is_side_effect_free_placeholder(expr.struct_init_field_values[si]) == 0 {
                return 0;
            }
            si = si + 1;
        }
        return 1;
    }
    return 0;
}

