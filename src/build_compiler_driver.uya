       stmt.if_stmt_then_branch == null || stmt.if_stmt_else_branch != null {
        return null;
    }
    const block: &ASTNode = stmt.if_stmt_then_branch;
    if block.type != ASTNodeType.AST_BLOCK || block.block_stmts == null ||
       block.block_stmt_count != 1 {
