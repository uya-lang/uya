        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: final_inst_id,
        inst_count: 1,
        terminator_id: final_terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 ||
       portable_mir_append_local(module, &local) != 0 ||
       portable_mir_append_value(module, &call_value) != 0 ||
       portable_mir_append_value(module, &cond_value) != 0 ||
       portable_mir_append_value(module, &then_result_value) != 0 ||
       portable_mir_append_value(module, &final_result_value) != 0 ||
       portable_mir_append_inst(module, &call_inst) != 0 ||
       portable_mir_append_inst(module, &cond_inst) != 0 ||
       portable_mir_append_inst(module, &then_inst) != 0 ||
       portable_mir_append_inst(module, &final_inst) != 0 ||
       portable_mir_append_operand(module, &call_operand) != 0 ||
       portable_mir_append_operand(module, &cond_operand) != 0 ||
       portable_mir_append_operand(module, &cond_term_operand) != 0 ||
       portable_mir_append_operand(module, &then_return_operand) != 0 ||
       portable_mir_append_operand(module, &final_return_operand) != 0 ||
       portable_mir_append_successor(module, &then_successor) != 0 ||
       portable_mir_append_successor(module, &final_successor) != 0 ||
       portable_mir_append_terminator(module, &entry_terminator) != 0 ||
       portable_mir_append_terminator(module, &then_terminator) != 0 ||
       portable_mir_append_terminator(module, &final_terminator) != 0 ||
       portable_mir_append_block(module, &entry_block) != 0 ||
       portable_mir_append_block(module, &then_block) != 0 ||
       portable_mir_append_block(module, &final_block) != 0 {
        return -1;
    }
    return 0;
}

fn native_build_hosted_mir_append_main_prefix_body_function(module: &PortableMirModule,
    lowered_function_id: i32, decl_index: i32, source_core_body_id: i32,
    decl: &ASTNode, program: &ASTNode) i32 {
    if module == null || lowered_function_id < 0 || decl_index < 0 ||
       source_core_body_id < 0 || decl == null || program == null ||
       decl.fn_decl_body == null || decl.fn_decl_body.block_stmts == null ||
       decl.fn_decl_body.block_stmt_count < 3 {
        return -1;
    }
    const local0: &ASTNode = decl.fn_decl_body.block_stmts[0];
    const local1: &ASTNode = decl.fn_decl_body.block_stmts[1];
    const if_stmt: &ASTNode = decl.fn_decl_body.block_stmts[2];
    if local0 == null || local1 == null || if_stmt == null ||
       local0.var_decl_init == null || local1.var_decl_init == null {
        return -1;
    }
    var local_ref_expr: &ASTNode = null;
    var compare_number_expr: &ASTNode = null;
    if native_build_hosted_if_local_ne_number(if_stmt, local0.var_decl_name,
        &local_ref_expr, &compare_number_expr) == 0 {
        return -1;
    }
    const then_return_expr: &ASTNode = native_build_hosted_if_then_number_return_expr(if_stmt);
    if then_return_expr == null {
        return -1;
    }
    var call0_target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var call0_target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    var call1_target_function_id: i32 = TYPED_PROGRAM_INVALID_ID;
    var call1_target_decl_index: i32 = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_return_call_target(program, local0.var_decl_init,
        &call0_target_function_id, &call0_target_decl_index) == 0 ||
       native_build_hosted_return_call_target(program, local1.var_decl_init,
        &call1_target_function_id, &call1_target_decl_index) == 0 {
        return -1;
    }
    const compare_value_result: !i32 = compare_number_expr.number_value_i64 as! i32;
    const compare_value: i32 = compare_value_result catch {
        return -1;
    };
    const then_value_result: !i32 = then_return_expr.number_value_i64 as! i32;
    const then_value: i32 = then_value_result catch {
        return -1;
    };
    var signature_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_signature_type(module, &signature_type_id) != 0 {
        return -1;
    }
    var i32_type_id: i32 = MIR_TYPE_INVALID_ID;
    if native_build_hosted_mir_ensure_i32_type(module, &i32_type_id) != 0 {
        return -1;
    }
    const function_id: i32 = module.function_count as i32;
    const local_id: i32 = module.local_count as i32;
    const local1_id: i32 = local_id + 1;
    const block_id: i32 = module.block_count as i32;
    const then_block_id: i32 = block_id + 1;
    const pending_block_id: i32 = block_id + 2;
    const value_id: i32 = module.value_count as i32;
    const call1_value_id: i32 = value_id + 1;
    const cond_value_id: i32 = value_id + 2;
    const then_value_id: i32 = value_id + 3;
    const inst_id: i32 = module.inst_count as i32;
    const call1_inst_id: i32 = inst_id + 1;
    const cond_inst_id: i32 = inst_id + 2;
    const then_inst_id: i32 = inst_id + 3;
    const operand_id: i32 = module.operand_count as i32;
    const call1_operand_id: i32 = operand_id + 1;
    const cond_operand_id: i32 = operand_id + 2;
    const cond_term_operand_id: i32 = operand_id + 3;
    const then_return_operand_id: i32 = operand_id + 4;
    const successor_id: i32 = module.successor_count as i32;
    const terminator_id: i32 = module.terminator_count as i32;
    const then_terminator_id: i32 = terminator_id + 1;
    const pending_terminator_id: i32 = terminator_id + 2;
    var function: MirFunction = MirFunction{
        function_id: function_id,
        lowered_function_id: lowered_function_id,
        decl_id: decl_index,
        source_core_body_id: source_core_body_id,
        symbol_id: decl_index,
        signature_type_id: signature_type_id,
        param_start: 0,
        param_count: 0,
        local_start: local_id,
        local_count: 2,
        block_start: block_id,
        block_count: 3,
        entry_block_id: block_id,
        cleanup_model: 0,
        capability_req_start: 0,
        capability_req_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: MIR_RUNTIME_CAP_HOSTED_LIBC,
        required_address_space_mask: MIR_ADDRESS_SPACE_GENERIC,
        body_kind: MIR_FUNCTION_BODY_KIND_NORMAL,
        naked_asm_inst_start: -1,
        naked_asm_inst_count: 0,
        naked_forbidden_lowering_mask: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: MIR_FUNCTION_FLAG_PARTIAL_BODY,
    };
    var mir_local0: MirLocal = MirLocal{
        local_id: local_id,
        function_id: function_id,
        type_id: i32_type_id,
        source_symbol_id: TYPED_PROGRAM_INVALID_ID,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        alignment: 4usize,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var mir_local1: MirLocal = MirLocal{
        local_id: local1_id,
        function_id: function_id,
        type_id: i32_type_id,
        source_symbol_id: TYPED_PROGRAM_INVALID_ID,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        alignment: 4usize,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call0_value: MirValue = MirValue{
        value_id: value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: inst_id,
        local_id: local_id,
        param_index: -1,
        source_expr_id: local0.var_decl_init.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call1_value: MirValue = MirValue{
        value_id: call1_value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: call1_inst_id,
        local_id: local1_id,
        param_index: -1,
        source_expr_id: local1.var_decl_init.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var cond_value: MirValue = MirValue{
        value_id: cond_value_id,
        function_id: function_id,
        block_id: block_id,
        type_id: i32_type_id,
        defining_inst_id: cond_inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: if_stmt.if_stmt_condition.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var then_result_value: MirValue = MirValue{
        value_id: then_value_id,
        function_id: function_id,
        block_id: then_block_id,
        type_id: i32_type_id,
        defining_inst_id: then_inst_id,
        local_id: MIR_LOCAL_INVALID_ID,
        param_index: -1,
        source_expr_id: then_return_expr.expr_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var call0_inst: MirInst = MirInst{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_CALL,
        type_id: i32_type_id,
        result_value_id: value_id,
        operand_start: operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: call0_target_decl_index,
    };
    var call1_inst: MirInst = MirInst{
        inst_id: call1_inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_CALL,
        type_id: i32_type_id,
        result_value_id: call1_value_id,
        operand_start: call1_operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: call1_target_decl_index,
    };
    var cond_inst: MirInst = MirInst{
        inst_id: cond_inst_id,
        function_id: function_id,
        block_id: block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: cond_value_id,
        operand_start: cond_operand_id,
        operand_count: 1,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: compare_value,
    };
    var then_inst: MirInst = MirInst{
        inst_id: then_inst_id,
        function_id: function_id,
        block_id: then_block_id,
        op: MIR_INST_OP_NOP,
        type_id: i32_type_id,
        result_value_id: then_value_id,
        operand_start: 0,
        operand_count: 0,
        calling_convention: MIR_CALL_CONV_UYA,
        runtime_capability_mask: 0,
        address_space: MIR_ADDRESS_SPACE_GENERIC,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: then_value,
    };
    var call0_operand: MirOperand = MirOperand{
        operand_id: operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: signature_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: call0_target_function_id,
        flags: 0,
    };
    var call1_operand: MirOperand = MirOperand{
        operand_id: call1_operand_id,
        kind: 0,
        value_id: MIR_VALUE_INVALID_ID,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: signature_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: call1_target_function_id,
        flags: 0,
    };
    var cond_operand: MirOperand = MirOperand{
        operand_id: cond_operand_id,
        kind: 0,
        value_id: value_id,
        local_id: local_id,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: compare_value,
        flags: 0,
    };
    var cond_term_operand: MirOperand = MirOperand{
        operand_id: cond_term_operand_id,
        kind: 0,
        value_id: cond_value_id,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: 0,
        flags: 0,
    };
    var then_return_operand: MirOperand = MirOperand{
        operand_id: then_return_operand_id,
        kind: 0,
        value_id: then_value_id,
        local_id: MIR_LOCAL_INVALID_ID,
        type_id: i32_type_id,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        immediate_i32: then_value,
        flags: 0,
    };
    var then_successor: MirSuccessor = MirSuccessor{
        successor_id: successor_id,
        block_id: then_block_id,
        arg_start: 0,
        arg_count: 0,
        flags: 0,
    };
    var pending_successor: MirSuccessor = MirSuccessor{
        successor_id: successor_id + 1,
        block_id: pending_block_id,
        arg_start: 0,
        arg_count: 0,
        flags: 0,
    };
    var entry_terminator: MirTerminator = MirTerminator{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: MIR_TERMINATOR_KIND_COND_BR,
        operand_start: cond_term_operand_id,
        operand_count: 1,
        successor_start: successor_id,
        successor_count: 2,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var then_terminator: MirTerminator = MirTerminator{
        terminator_id: then_terminator_id,
        function_id: function_id,
        block_id: then_block_id,
        kind: MIR_TERMINATOR_KIND_RETURN,
        operand_start: then_return_operand_id,
        operand_count: 1,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var pending_terminator: MirTerminator = MirTerminator{
        terminator_id: pending_terminator_id,
        function_id: function_id,
        block_id: pending_block_id,
        kind: MIR_TERMINATOR_KIND_UNREACHABLE,
        operand_start: 0,
        operand_count: 0,
        successor_start: 0,
        successor_count: 0,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var entry_block: MirBlock = MirBlock{
        block_id: block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: inst_id,
        inst_count: 3,
        terminator_id: terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var then_block: MirBlock = MirBlock{
        block_id: then_block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: then_inst_id,
        inst_count: 1,
        terminator_id: then_terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    var pending_block: MirBlock = MirBlock{
        block_id: pending_block_id,
        function_id: function_id,
        param_start: 0,
        param_count: 0,
        inst_start: 0,
        inst_count: 0,
        terminator_id: pending_terminator_id,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
        flags: 0,
    };
    if portable_mir_append_function(module, &function) != 0 ||
       portable_mir_append_local(module, &mir_local0) != 0 ||
       portable_mir_append_local(module, &mir_local1) != 0 ||
       portable_mir_append_value(module, &call0_value) != 0 ||
       portable_mir_append_value(module, &call1_value) != 0 ||
       portable_mir_append_value(module, &cond_value) != 0 ||
       portable_mir_append_value(module, &then_result_value) != 0 ||
       portable_mir_append_inst(module, &call0_inst) != 0 ||
       portable_mir_append_inst(module, &call1_inst) != 0 ||
       portable_mir_append_inst(module, &cond_inst) != 0 ||
       portable_mir_append_inst(module, &then_inst) != 0 ||
       portable_mir_append_operand(module, &call0_operand) != 0 ||
       portable_mir_append_operand(module, &call1_operand) != 0 ||
       portable_mir_append_operand(module, &cond_operand) != 0 ||
       portable_mir_append_operand(module, &cond_term_operand) != 0 ||
       portable_mir_append_operand(module, &then_return_operand) != 0 ||
       portable_mir_append_successor(module, &then_successor) != 0 ||
       portable_mir_append_successor(module, &pending_successor) != 0 ||
       portable_mir_append_terminator(module, &entry_terminator) != 0 ||
       portable_mir_append_terminator(module, &then_terminator) != 0 ||
       portable_mir_append_terminator(module, &pending_terminator) != 0 ||
       portable_mir_append_block(module, &entry_block) != 0 ||
       portable_mir_append_block(module, &then_block) != 0 ||
       portable_mir_append_block(module, &pending_block) != 0 {
        return -1;
    }
    return 0;
}

fn native_build_hosted_mir_append_program_safe_bodies(module: &PortableMirModule,
    checker: &TypeChecker, program: &ASTNode, out_mir_body_function_count: &i32) i32 {
    if out_mir_body_function_count != null {
        *out_mir_body_function_count = 0;
    }
    if module == null || checker == null || program == null ||
       program.type != ASTNodeType.AST_PROGRAM || program.program_decls == null ||
       out_mir_body_function_count == null {
        return -1;
    }
    var i: i32 = 0;
    var lowered_function_id: i32 = 0;
    var source_core_body_id: i32 = 0;
    var body_function_count: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            const has_prefix_body: i32 = native_build_hosted_decl_can_materialize_main_prefix_body(program, decl, checker);
            const has_safe_core_body: i32 = native_build_hosted_decl_can_materialize_safe_core_body(program, decl, checker);
            if has_prefix_body != 0 || has_safe_core_body != 0 {
                if has_prefix_body != 0 {
                    if native_build_hosted_mir_append_main_prefix_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_void_mir_body(decl) != 0 {
                    if native_build_hosted_mir_append_void_body_function(module,
                        lowered_function_id, i, source_core_body_id) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_int_literal_mir_body(decl) != 0 {
                    if native_build_hosted_mir_append_int_literal_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_call_mir_body(program, decl) != 0 {
                    if native_build_hosted_mir_append_call_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_extern_const2_call_mir_body(program,
                    decl) != 0 {
                    if native_build_hosted_mir_append_extern_const2_call_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                } else if native_build_hosted_decl_can_lower_main_local_if_mir_body(program,
                    decl, checker) != 0 {
                    if native_build_hosted_mir_append_main_local_if_body_function(module,
                        lowered_function_id, i, source_core_body_id, decl, program) != 0 {
                        return -1;
                    }
                    body_function_count = body_function_count + 1;
                }
                source_core_body_id = source_core_body_id + 1;
            }
            lowered_function_id = lowered_function_id + 1;
        }
        i = i + 1;
    }
    *out_mir_body_function_count = body_function_count;
    return 0;
}

fn native_build_hosted_link_plan_add_program_externs(plan: &NativeHostedLinkPlan,
    program: &ASTNode, out_extern_symbol_count: &i32) i32 {
    if out_extern_symbol_count != null {
        *out_extern_symbol_count = 0;
    }
    if plan == null || program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_extern_symbol_count == null {
        return -1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_extern != 0 {
            if native_hosted_link_plan_add_extern_symbol(plan, i) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    *out_extern_symbol_count = plan.extern_symbol_count;
    return 0;
}

fn native_build_hosted_portable_mir_preflight(arena: &CompilerArena, checker: &TypeChecker,
    program: &ASTNode, c_import_count: i32, result: &NativeHostedMirPreflightResult) i32 {
    native_build_hosted_preflight_result_reset(result);
    if arena == null || checker == null || program == null || result == null || c_import_count < 0 {
        return -1;
    }
    if native_build_hosted_coreir_preflight(arena, checker, program, result) != 0 {
        return -1;
    }
    var module: PortableMirModule = native_build_empty_portable_mir_module();
    portable_mir_module_init(&module, arena);
    if native_build_hosted_mir_append_program_externs(&module, program,
        &result.mir_extern_function_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    if native_build_hosted_mir_append_program_safe_bodies(&module, checker, program,
        &result.mir_body_function_count) != 0 {
        portable_mir_module_release(&module);
        return -1;
    }
    result.mir_type_count = module.type_count as i32;
    var verifier: MirVerifierResult = MirVerifierResult{
        error_code: -1,
        function_id: MIR_FUNCTION_INVALID_ID,
        block_id: MIR_BLOCK_INVALID_ID,
        inst_id: MIR_INST_INVALID_ID,
        value_id: MIR_VALUE_INVALID_ID,
        type_id: MIR_TYPE_INVALID_ID,
        operand_id: -1,
        capability_req_id: MIR_CAPABILITY_REQ_INVALID_ID,
        debug_loc_id: MIR_DEBUG_LOC_INVALID_ID,
    };
    portable_mir_verifier_result_init(&verifier);
    if portable_mir_verify_module(&module, &verifier) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var request: MirTargetBackendRequest = native_build_empty_mir_backend_request();
    if portable_mir_backend_request_init(&request, &module, &verifier,
        MIR_TARGET_BACKEND_MACHINE) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var plan: NativeHostedLinkPlan = native_hosted_link_plan_empty();
    if native_hosted_link_plan_init(&plan, &request) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    if native_build_hosted_link_plan_add_program_externs(&plan, program,
        &result.extern_symbol_count) != 0 {
        result.verifier_error = verifier.error_code;
        portable_mir_module_release(&module);
        return -1;
    }
    var imported: i32 = 0;
    while imported < c_import_count {
        if native_hosted_link_plan_add_c_import_object(&plan) != 0 {
            result.verifier_error = verifier.error_code;
            portable_mir_module_release(&module);
            return -1;
        }
        imported = imported + 1;
    }
    result.verifier_error = verifier.error_code;
    result.object_count = plan.object_count;
    portable_mir_module_release(&module);
    return 0;
}

fn native_build_print_hosted_preflight_summary(c_import_count: i32, preflight_status: i32,
    result: &NativeHostedMirPreflightResult) void {
    if result == null {
        return;
    }
    fprintf(libc.stderr,
        "native_hosted_coreir_preflight: status=%d verifier_error=%d functions=%d core_bodies=%d pending_bodies=%d\n" as *byte,
        preflight_status, result.core_verifier_error, result.core_function_count,
        result.core_body_count, result.core_pending_body_count);
    fprintf(libc.stderr,
        "native_hosted_preflight: status=%d verifier_error=%d mir_extern_functions=%d mir_body_functions=%d mir_types=%d extern_symbols=%d c_import_objects=%d hosted_link_objects=%d\n" as *byte,
        preflight_status, result.verifier_error, result.mir_extern_function_count,
        result.mir_body_function_count, result.mir_type_count, result.extern_symbol_count,
        c_import_count, result.object_count);
}

fn native_build_print_hosted_portable_mir_lowering_missing(c_import_count: i32, preflight_status: i32,
    result: &NativeHostedMirPreflightResult) void {
    if result == null {
        return;
    }
    native_build_print_hosted_preflight_summary(c_import_count, preflight_status, result);
    fprintf(libc.stderr,
        "native_unsupported_hosted_path: reason=native_hosted_portable_mir_lowering_missing required=CoreBody+PortableMIR function-body lowering\n" as *byte);
    fprintf(libc.stderr,
        "错误: hosted native backend 已完成 PortableMIR/NativeHostedLinkPlan preflight，但尚未接入函数体 MIR lowering；build-seed LoweredProgram helper 仅限 --nostdlib freestanding 子集\n" as *byte);
}

fn native_build_find_extern_two_i32_param_function(program: &ASTNode, name: &byte) &ASTNode {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return null;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if native_build_decl_is_extern_two_i32_param_fn(decl) != 0 &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name as *byte, name as *byte) != 0 {
            return decl;
        }
        i = i + 1;
    }
    return null;
}

fn native_build_hosted_main_return_extern_const2_call(program: &ASTNode,
    out_extern_name: & & byte, out_arg0: &i32, out_arg1: &i32) i32 {
    if out_extern_name != null {
        *out_extern_name = null;
    }
    if out_arg0 != null {
        *out_arg0 = 0;
    }
    if out_arg1 != null {
        *out_arg1 = 0;
    }
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || out_extern_name == null ||
       out_arg0 == null || out_arg1 == null {
        return 0;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if native_build_decl_is_noarg_i32_fn(decl) != 0 &&
           decl.fn_decl_name != null &&
           str_equals(decl.fn_decl_name as *byte, "main" as *byte) != 0 &&
           decl.fn_decl_body != null && decl.fn_decl_body.type == ASTNodeType.AST_BLOCK &&
           decl.fn_decl_body.block_stmt_count == 1 && decl.fn_decl_body.block_stmts != null {
            const stmt: &ASTNode = decl.fn_decl_body.block_stmts[0];
            if stmt != null && stmt.type == ASTNodeType.AST_RETURN_STMT &&
               stmt.return_stmt_expr != null && stmt.return_stmt_expr.type == ASTNodeType.AST_CALL_EXPR {
                const call: &ASTNode = stmt.return_stmt_expr;
                if native_build_hosted_const2_extern_call_args(program, call,
                    out_extern_name, out_arg0, out_arg1) != 0 {
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn native_build_hosted_const2_extern_call_args(program: &ASTNode, call: &ASTNode,
    out_extern_name: & & byte, out_arg0: &i32, out_arg1: &i32) i32 {
    if call == null || call.type != ASTNodeType.AST_CALL_EXPR ||
       call.call_expr_arg_count != 2 || call.call_expr_type_arg_count != 0 ||
       call.call_expr_callee == null ||
       call.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER ||
       call.call_expr_callee.identifier_name == null ||
       call.call_expr_args == null {
        return 0;
    }
    const arg0_node: &ASTNode = call.call_expr_args[0];
    const arg1_node: &ASTNode = call.call_expr_args[1];
    if arg0_node == null || arg1_node == null ||
       arg0_node.type != ASTNodeType.AST_NUMBER ||
       arg1_node.type != ASTNodeType.AST_NUMBER {
        return 0;
    }
    if native_build_find_extern_two_i32_param_function(program,
        call.call_expr_callee.identifier_name) == null {
        return 0;
    }
    const arg0_result: !i32 = arg0_node.number_value_i64 as! i32;
    const arg1_result: !i32 = arg1_node.number_value_i64 as! i32;
    *out_arg0 = arg0_result catch {
        return 0;
    };
    *out_arg1 = arg1_result catch {
        return 0;
    };
    *out_extern_name = call.call_expr_callee.identifier_name;
    return 1;
}

fn native_build_hosted_fill_asm_path(buf: &byte, cap: usize) i32 {
    return host_fill_temp_path(buf, cap, "uya_hosted_native" as &byte, ".s" as &byte, -1);
}

fn native_build_hosted_fill_object_path(buf: &byte, cap: usize) i32 {
    return host_fill_temp_path(buf, cap, "uya_hosted_native" as &byte, ".o" as &byte, -1);
}

fn native_build_hosted_fill_c_import_object_path(buf: &byte, cap: usize, index: i32) i32 {
    return host_fill_temp_path(buf, cap, "uya_hosted_cimport" as &byte, ".o" as &byte, index);
}

fn native_build_hosted_write_extern_const2_asm(path: &byte, extern_name: &byte,
    arg0: i32, arg1: i32) i32 {
    if path == null || extern_name == null {
        return -1;
    }
    const file: &void = fopen(path as *byte, "w" as *byte) as &void;
    if file == null {
        return -1;
    }
    fputs(".text\n" as *byte, file as *void);
    fprintf(file as *void, ".extern %s\n" as *byte, extern_name as *byte);
    fputs(".globl main\n" as *byte, file as *void);
    fputs(".type main, @function\n" as *byte, file as *void);
    fputs("main:\n" as *byte, file as *void);
    fputs("    pushq %rbp\n" as *byte, file as *void);
    fputs("    movq %rsp, %rbp\n" as *byte, file as *void);
    fprintf(file as *void, "    movl $%d, %%edi\n" as *byte, arg0);
    fprintf(file as *void, "    movl $%d, %%esi\n" as *byte, arg1);
    fprintf(file as *void, "    call %s\n" as *byte, extern_name as *byte);
    fputs("    popq %rbp\n" as *byte, file as *void);
    fputs("    ret\n" as *byte, file as *void);
    fputs(".size main, .-main\n" as *byte, file as *void);
    fputs(".section .note.GNU-stack,\"\",@progbits\n" as *byte, file as *void);
    fclose(file as *void);
    return 0;
}

fn native_build_hosted_compile_asm_to_object(cc_driver: &byte, target_flags: &byte,
    asm_path: &byte, object_path: &byte) i32 {
    if cc_driver == null || asm_path == null || object_path == null {
        return 1;
    }
    var cmd: [byte: 32768] = [];
    var cmd_len: i32 = 0;
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, cc_driver) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, target_flags) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-c" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, asm_path) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-o" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, object_path) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native assembly 编译命令失败\n" as *byte);
        return 1;
    }
    fprintf(libc.stderr, "信息：编译 hosted native assembly：%s\n" as *byte, &cmd[0] as *byte);
    if system(&cmd[0] as *byte) != 0 {
        fprintf(libc.stderr, "错误：hosted native assembly 编译失败: %s\n" as *byte, asm_path as *byte);
        return 1;
    }
    return 0;
}

fn native_build_hosted_cleanup_c_import_objects(count: i32) void {
    var i: i32 = 0;
    while i < count {
        var item_obj: [byte: PATH_MAX] = [];
        if native_build_hosted_fill_c_import_object_path(&item_obj[0] as &byte,
            PATH_MAX, i) == 0 {
            unlink(&item_obj[0] as *byte);
        }
        i = i + 1;
    }
}

fn native_build_hosted_link_objects(cc_driver: &byte, target_flags: &byte,
    native_obj: &byte, output_file: &byte, plan: &CImportPlan) i32 {
    if cc_driver == null || native_obj == null || output_file == null ||
       plan == null {
        return 1;
    }
    c99_mkdir_p_for_file(output_file);
    var cmd: [byte: 32768] = [];
    var cmd_len: i32 = 0;
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, cc_driver) != 0 ||
       shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, target_flags) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, native_obj) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    var i: i32 = 0;
    while i < plan.item_count {
        var item_obj: [byte: PATH_MAX] = [];
        if native_build_hosted_fill_c_import_object_path(&item_obj[0] as &byte,
            PATH_MAX, i) != 0 ||
           shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len,
               &item_obj[0] as &byte) != 0 {
            fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
            return 1;
        }
        i = i + 1;
    }
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, "-o" as &byte) != 0 ||
       shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len, output_file) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    const ldflags: &byte = get_env_or_default("LDFLAGS" as *byte, "" as *byte);
    if shell_cmd_append_raw(&cmd[0] as &byte, 32768, &cmd_len, ldflags) != 0 {
        fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
        return 1;
    }
    i = 0;
    while i < plan.aggregated_ldflags_token_count {
        if plan.aggregated_ldflags_tokens != null && plan.aggregated_ldflags_tokens[i] != null {
            if shell_cmd_append_quoted_word(&cmd[0] as &byte, 32768, &cmd_len,
                plan.aggregated_ldflags_tokens[i]) != 0 {
                fprintf(libc.stderr, "错误：构建 hosted native 链接命令失败\n" as *byte);
                return 1;
            }
        }
        i = i + 1;
    }
    fprintf(libc.stderr, "信息：调用 hosted native linker：%s\n" as *byte, &cmd[0] as *byte);
    if system(&cmd[0] as *byte) != 0 {
        fprintf(libc.stderr, "错误：hosted native 链接失败\n" as *byte);
        return 1;
    }
    return 0;
}

fn native_build_hosted_output_size(path: &byte) usize {
    if path == null {
        return 0usize;
    }
    var st: Stat = Stat { st_dev: 0, st_ino: 0, st_nlink: 0, st_mode: 0, st_uid: 0, st_gid: 0, _pad0: 0, st_rdev: 0, st_size: 0, st_blksize: 0, st_blocks: 0, st_atime: 0, st_atime_nsec: 0, st_mtime: 0, st_mtime_nsec: 0, st_ctime: 0, st_ctime_nsec: 0, _unused0: 0, _unused1: 0, _unused2: 0 };
    if stat(path as *byte, &st) != 0 || st.st_size < 0 {
        return 0usize;
    }
    return st.st_size as usize;
}

fn native_build_hosted_compile_c_import_objects(cc_driver: &byte, target_flags: &byte,
    cflags: &byte, plan: &CImportPlan) i32 {
    if cc_driver == null || plan == null {
        return 1;
    }
    var i: i32 = 0;
    while i < plan.item_count {
        var item_obj: [byte: PATH_MAX] = [];
        if native_build_hosted_fill_c_import_object_path(&item_obj[0] as &byte,
            PATH_MAX, i) != 0 {
            fprintf(libc.stderr, "错误：无法生成 hosted native @c_import 对象路径\n" as *byte);
            return 1;
        }
        const item: CImportItem = plan.items[i];
        if compile_c_source_to_object(cc_driver, target_flags, cflags, item.resolved_path,
            &item_obj[0] as &byte, item.cflags_tokens, item.cflags_token_count,
            item.resolved_path) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn native_build_hosted_emit_extern_const2_linked_exe(output_file: &byte,
    extern_name: &byte, arg0: i32, arg1: i32, plan: &CImportPlan) i32 {
    var asm_path: [byte: PATH_MAX] = [];
    var native_obj: [byte: PATH_MAX] = [];
    if native_build_hosted_fill_asm_path(&asm_path[0] as &byte, PATH_MAX) != 0 ||
       native_build_hosted_fill_object_path(&native_obj[0] as &byte, PATH_MAX) != 0 {
        fprintf(libc.stderr, "错误：无法生成 hosted native 临时路径\n" as *byte);
        return 1;
    }
    var cc_driver_buffer: [byte: PATH_MAX] = [];
    const cc_driver: &byte = resolve_cc_driver(&cc_driver_buffer[0] as &byte, PATH_MAX);
    const cflags_env: &byte = get_env_or_default("CFLAGS" as *byte,
        "-std=c99 -O0 -g -fno-builtin" as *byte);
    var cflags_clang_buf: [byte: 2048] = [];
    var cflags_buf: [byte: 2048] = [];
    var cflags: &byte = hosted_cflags_add_clang_compat(cflags_env, cc_driver,
        &cflags_clang_buf[0] as &byte, 2048);
    if cc_driver_is_clang_like(cc_driver) == 0 &&
       hosted_cflags_need_no_small_inline(cflags_env) != 0 &&
       hosted_cflags_has_no_small_inline(cflags_env) == 0 {
        const wcf: i32 = snprintf(&cflags_buf[0] as *byte, 2048,
            "%s -fno-inline-small-functions" as *byte, cflags as *byte);
        if wcf > 0 && wcf < 2048 {
            cflags = &cflags_buf[0] as &byte;
        }
    }
    const target_triple: &byte = get_env_or_default("TARGET_TRIPLE" as *byte, "" as *byte);
    var target_flags: &byte = get_env_or_default("CC_TARGET_FLAGS" as *byte, "" as *byte);
    var target_flags_buffer: [byte: 256] = [];
    if target_flags[0] == 0 && target_triple[0] != 0 {
        const target_flags_len: i32 = snprintf(&target_flags_buffer[0], 256,
            "-target %s" as *byte, target_triple as *byte);
        if target_flags_len > 0 && target_flags_len < 256 {
            target_flags = &target_flags_buffer[0] as &byte;
        }
    }
    if native_build_hosted_write_extern_const2_asm(&asm_path[0] as &byte,
        extern_name, arg0, arg1) != 0 ||
       native_build_hosted_compile_asm_to_object(cc_driver, target_flags,
        &asm_path[0] as &byte, &native_obj[0] as &byte) != 0 ||
       native_build_hosted_compile_c_import_objects(cc_driver, target_flags,
        cflags, plan) != 0 ||
       native_build_hosted_link_objects(cc_driver, target_flags,
        &native_obj[0] as &byte, output_file, plan) != 0 {
        unlink(&asm_path[0] as *byte);
        unlink(&native_obj[0] as *byte);
        native_build_hosted_cleanup_c_import_objects(plan.item_count);
        return 1;
    }
    unlink(&asm_path[0] as *byte);
    unlink(&native_obj[0] as *byte);
    native_build_hosted_cleanup_c_import_objects(plan.item_count);
    return 0;
}

fn native_build_try_emit_hosted_c_import_extern_link_subset(output_file: &byte,
    program: &ASTNode, plan: &CImportPlan) i32 {
    if output_file == null || program == null || plan == null || plan.item_count != 1 {
        return 0;
    }
    if strcmp(main_get_target_os_name() as *byte, "linux" as *byte) != 0 ||
       strcmp(main_get_target_arch_name() as *byte, "x86_64" as *byte) != 0 {
        return 0;
    }
    var extern_name: &byte = null;
    var arg0: i32 = 0;
    var arg1: i32 = 0;
    if native_build_hosted_main_return_extern_const2_call(program,
        &extern_name, &arg0, &arg1) == 0 {
        return 0;
    }
    if native_build_hosted_emit_extern_const2_linked_exe(output_file,
        extern_name, arg0, arg1, plan) != 0 {
        return -1;
    }
    fprintf(libc.stderr, "native_hosted_subset: c_import_extern_link_path=1\n" as *byte);
    fprintf(libc.stderr,
        "native_hosted_linker_handoff: extern=%s c_import_objects=%d linked_objects=%d\n" as *byte,
        extern_name as *byte, plan.item_count, plan.item_count + 1);
    fprintf(libc.stderr, "native_output_bytes: %zu\n" as *byte,
        native_build_hosted_output_size(output_file));
    return 1;
}

fn native_build_try_emit_hosted_no_deps_subset(output_file: &byte, program: &ASTNode,
    arena: &CompilerArena, c_import_count: i32) i32 {
    if output_file == null || program == null || arena == null || c_import_count != 0 {
        return 0;
    }
    var native_plan: NativeBuildLoweredPlan = native_build_program_to_lowered_plan(program, arena);
    if native_plan.lowered.lifecycle_state != LOWERED_PROGRAM_LIFECYCLE_ACTIVE {
        return 0;
    }
    const native_result: NativeBuildEmitResult = native_build_emit_lowered_program_file(output_file,
        &native_plan.lowered, native_plan.entry_index);
    if native_result.status != NATIVE_BUILD_EMIT_STATUS_OK {
        fprintf(libc.stderr, "错误: hosted native executable 输出失败: %s\n" as *byte, output_file);
        lowered_program_release(&native_plan.lowered);
        return -1;
    }
    var native_exit_code: i32 = -1;
    fprintf(libc.stderr, "native_hosted_subset: no_deps_lowered_program_path=1\n" as *byte);
    if native_build_lowered_main_const_exit_code(&native_plan, &native_exit_code) != 0 {
        fprintf(libc.stderr, "native_exit_code: %d\n" as *byte, native_exit_code);
    }
    fprintf(libc.stderr, "native_function_count: %zu\n" as *byte, native_plan.lowered.function_count);
    fprintf(libc.stderr, "native_lowered_body_ops: %zu\n" as *byte, native_plan.lowered.body_op_count);
    fprintf(libc.stderr, "native_machine_function_count: %zu\n" as *byte, native_result.machine_function_count);
    fprintf(libc.stderr, "native_machine_inst_count: %zu\n" as *byte, native_result.machine_inst_count);
    fprintf(libc.stderr, "native_machine_peak_bytes: %zu\n" as *byte, native_result.machine_peak_bytes);
    fprintf(libc.stderr, "native_entry_index: %d\n" as *byte, native_plan.entry_index);
    fprintf(libc.stderr, "native_output_bytes: %zu\n" as *byte, native_result.output_bytes);
    fprintf(libc.stderr, "native_code_bytes: %zu\n" as *byte, native_result.code_bytes);
    fprintf(libc.stderr, "native_temp_peak_bytes: %zu\n" as *byte, native_result.temp_peak_bytes);
    lowered_program_release(&native_plan.lowered);
    return 1;
}

fn native_build_core_function_flags_from_decl(decl: &ASTNode) i32 {
    var flags: i32 = 0;
    if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_is_naked != 0 {
        flags = flags | CORE_FUNCTION_FLAG_NAKED;
    }
    return flags;
}

fn native_build_find_function_index(program: &ASTNode, name: &byte) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM ||
       program.program_decls == null || name == null {
        return -1;
    }
    var i: i32 = 0;
    var function_index: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL &&
           decl.fn_decl_name != null && str_equals(decl.fn_decl_name, name as *byte) != 0 {
            if native_build_decl_is_noarg_i32_fn(decl) != 0 {
                return function_index;
            }
            native_build_print_unsupported_decl(decl, i);
            return -1;
        }
