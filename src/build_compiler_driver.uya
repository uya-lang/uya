fn native_build_hosted_coreir_append_lexical_drop_body(lowered: &LoweredProgram,
    checker: &TypeChecker, program: &ASTNode, function_id: i32,
    decl_index: i32, decl: &ASTNode) i32 {
    if lowered == null || checker == null || program == null || decl == null {
        return -1;
    }
    var shape: NativeBuildLexicalDropShape = native_build_lexical_drop_shape_empty();
    if native_build_decl_lexical_drop_shape(program, decl, &shape) == 0 ||
       shape.drop_block == null ||
       shape.dropped_decl == null || shape.dropped_decl.var_decl_init == null ||
       shape.dropped_decl.var_decl_init.struct_init_field_values == null ||
       shape.return_stmt == null || shape.return_stmt.return_stmt_expr == null {
        return -1;
    }
    var drop_value_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    var return_type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    if native_build_hosted_ensure_expr_type_id(checker,
        shape.dropped_decl.var_decl_init.struct_init_field_values[0],
        &drop_value_type_id) != 0 ||
       native_build_hosted_ensure_expr_type_id(checker,
        shape.return_stmt.return_stmt_expr, &return_type_id) != 0 {
        return -1;
    }
    const body_id: i32 = lowered.core_body_count as i32;
    const stmt_start: i32 = lowered.core_stmt_count as i32;
    const expr_start: i32 = lowered.core_expr_count as i32;
    const cleanup_start: i32 = lowered.core_cleanup_edge_count as i32;
    const fact_start: i32 = lowered.core_semantic_fact_count as i32;
    var body: CoreBody = CoreBody{
        body_id: body_id,
        function_id: function_id,
        decl_id: decl_index,
        root_stmt_start: stmt_start,
        root_stmt_count: 2,
        expr_start: expr_start,
        expr_count: 2,
        place_start: CORE_PLACE_INVALID_ID,
        place_count: 0,
        cleanup_edge_start: cleanup_start,
        cleanup_edge_count: 1,
        semantic_fact_start: fact_start,
        semantic_fact_count: 1,
        source_span_id: decl.line,
        flags: CORE_BODY_FLAG_SOURCE_BODY | CORE_BODY_FLAG_DROP | CORE_BODY_FLAG_CLEANUP,
    };
    var drop_expr: CoreExpr = CoreExpr{
        expr_id: expr_start,
        kind: CORE_EXPR_KIND_INT_LITERAL,
        body_id: body_id,
        source_expr_id: shape.dropped_decl.var_decl_init.struct_init_field_values[0].expr_id,
        type_id: drop_value_type_id,
        literal_i64: shape.field_value as i64,
        lhs_expr_id: CORE_EXPR_INVALID_ID,
        rhs_expr_id: CORE_EXPR_INVALID_ID,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: shape.dropped_decl.line,
        flags: 0,
    };
    var return_expr: CoreExpr = CoreExpr{
        expr_id: expr_start + 1,
        kind: CORE_EXPR_KIND_INT_LITERAL,
        body_id: body_id,
        source_expr_id: shape.return_stmt.return_stmt_expr.expr_id,
        type_id: return_type_id,
        literal_i64: shape.return_value as i64,
        lhs_expr_id: CORE_EXPR_INVALID_ID,
        rhs_expr_id: CORE_EXPR_INVALID_ID,
        callee_expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: shape.return_stmt.return_stmt_expr.line,
        flags: 0,
    };
    var drop_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start,
        kind: CORE_STMT_KIND_DROP,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: CORE_CLEANUP_EDGE_INVALID_ID,
        cleanup_edge_count: 0,
        source_span_id: shape.drop_block.line,
        cleanup_scope_id: 0,
        flags: CORE_STMT_FLAG_DROP | CORE_STMT_FLAG_CLEANUP,
    };
    var return_stmt: CoreStmt = CoreStmt{
        stmt_id: stmt_start + 1,
        kind: CORE_STMT_KIND_RETURN,
        body_id: body_id,
        parent_stmt_id: CORE_STMT_INVALID_ID,
        first_child_stmt: CORE_STMT_INVALID_ID,
        child_stmt_count: 0,
        expr_id: expr_start + 1,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_start: cleanup_start,
        cleanup_edge_count: 1,
        source_span_id: shape.return_stmt.line,
        cleanup_scope_id: 0,
        flags: CORE_STMT_FLAG_CLEANUP,
    };
    var cleanup_edge: CoreCleanupEdge = CoreCleanupEdge{
        edge_id: cleanup_start,
        kind: CORE_CLEANUP_EDGE_KIND_RETURN,
        body_id: body_id,
        from_stmt_id: stmt_start + 1,
        to_stmt_id: CORE_STMT_INVALID_ID,
        cleanup_scope_id: 0,
        drop_defer_plan_id: 0,
        payload_expr_id: expr_start + 1,
        source_span_id: shape.return_stmt.line,
        flags: CORE_STMT_FLAG_DROP,
    };
    var cleanup_fact: CoreSemanticFact = native_build_core_semantic_fact_empty(fact_start,
        body_id, CORE_SEMANTIC_FACT_CLEANUP);
    cleanup_fact.stmt_id = stmt_start + 1;
    cleanup_fact.expr_id = expr_start + 1;
    cleanup_fact.source_expr_id = shape.return_stmt.return_stmt_expr.expr_id;
    cleanup_fact.cleanup_edge_id = cleanup_start;
    cleanup_fact.source_span_id = shape.return_stmt.line;
    cleanup_fact.drop_defer_plan_id = 0;
