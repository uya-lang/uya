// fmt_tool.uya - Uya 代码格式化工具
// 职责：格式化 Uya 源代码文件
//
// 用法：uya-fmt <文件|目录> [选项]
// 选项：
//   -c, --check      检查模式（不修改文件）
//   -r, --recursive  递归处理子目录
//   -o, --output     输出到指定文件

use fmt.config;
use fmt.formatter;
use libc;
use libc.stdio;
use libc.stdlib;
use libc.string;
use libc.dirent;
use libc.syscall;
use libc.sys;  // for Stat

const PATH_MAX: usize = 4096;
const MAX_FILES: i32 = 1024;
const BUFFER_SIZE: usize = 1024 * 1024;  // 1MB

// 格式化模式
enum FmtMode {
    FMT_MODE_WRITE,   // 覆盖原文件
    FMT_MODE_CHECK,   // 检查模式
}

// 格式化统计
struct FmtStats {
    total: i32,
    formatted: i32,
    changed: i32,
    errors: i32,
}

// 全局缓冲区
var file_buffer: [byte: BUFFER_SIZE] = [];
var output_buffer: [byte: BUFFER_SIZE] = [];
var g_stat_data: [byte: 256] = [0: 256];

// 打印使用说明
fn print_usage(program_name: &byte) void {
    var name: &byte = program_name;
    if name == null { name = "uya-fmt" as *byte; }
    
    fprintf(libc.stderr, "Uya 代码格式化工具\n" as *byte);
    fprintf(libc.stderr, "\n用法:\n" as *byte);
    fprintf(libc.stderr, "  %s <文件>           格式化单个文件\n" as *byte, name as *byte);
    fprintf(libc.stderr, "  %s <目录>           格式化目录下所有 .uya 文件\n" as *byte, name as *byte);
    fprintf(libc.stderr, "  %s -r <目录>        递归格式化子目录\n" as *byte, name as *byte);
    fprintf(libc.stderr, "\n选项:\n" as *byte);
    fprintf(libc.stderr, "  -r, --recursive     递归处理子目录\n" as *byte);
    fprintf(libc.stderr, "  -c, --check         检查模式（不修改文件）\n" as *byte);
    fprintf(libc.stderr, "  -o, --output <文件> 输出到指定文件\n" as *byte);
    fprintf(libc.stderr, "  -h, --help          显示帮助\n" as *byte);
}

// 全局 Stat 缓冲区（避免栈上初始化问题）
extern g_stat_data: [byte: 256];

// 检查路径是否为目录
fn is_directory(path: &byte) i32 {
    var st: &Stat = (g_stat_data as &Stat);
    st.st_dev = 0; st.st_ino = 0; st.st_nlink = 0; st.st_mode = 0;
    st.st_uid = 0; st.st_gid = 0; st._pad0 = 0; st.st_rdev = 0;
    st.st_size = 0; st.st_blksize = 0; st.st_blocks = 0;
    st.st_atime = 0; st.st_atime_nsec = 0;
    st.st_mtime = 0; st.st_mtime_nsec = 0;
    st.st_ctime = 0; st.st_ctime_nsec = 0;
    st._unused0 = 0; st._unused1 = 0; st._unused2 = 0;
    
    if stat(path as *byte, st) == 0 {
        if ((st.st_mode as u32) & S_IFMT) == S_IFDIR {
            return 1;
        }
    }
    return 0;
}

// 检查是否为 .uya 文件
fn is_uya_file(path: &byte) i32 {
    const len: usize = strlen(path as *byte);
    if len > 4 {
        const ext: &byte = path + (len - 4);
        if strcmp(ext as *byte, ".uya" as *byte) == 0 {
            return 1;
        }
    }
    return 0;
}

// 收集目录下的 .uya 文件
fn collect_uya_files(
    dir_path: &byte,
    files: &(&byte),
    max_files: i32,
    file_count: &i32,
    recursive: i32,
    file_buffer: &byte,
    buffer_offset: &usize
) i32 {
    const dir: *DIR = opendir(dir_path as *byte);
    if dir == null {
        return -1;
    }

    var entry: *Dirent = readdir(dir);
    while entry != null && file_count[0] < max_files {
        const name: *byte = dirent_get_name(entry as &byte) as *byte;
        const name_len: usize = strlen(name);

        // 跳过 . 和 ..
        if strcmp(name, "." as *byte) == 0 || strcmp(name, ".." as *byte) == 0 {
            entry = readdir(dir);
            continue;
        }

        // 构建完整路径
        var full_path: [byte: PATH_MAX] = [];
        snprintf(&full_path[0], PATH_MAX, "%s/%s" as *byte, dir_path as *byte, name);

        if is_directory(&full_path[0] as &byte) != 0 {
            // 递归处理子目录
            if recursive != 0 {
                collect_uya_files(
                    &full_path[0] as &byte,
                    files,
                    max_files,
                    file_count,
                    recursive,
                    file_buffer,
                    buffer_offset
                );
            }
        } else if is_uya_file(&full_path[0] as &byte) != 0 {
            // 添加 .uya 文件到列表
            if file_count[0] < max_files {
                const offset: usize = buffer_offset[0];
                if offset + name_len + 1 < BUFFER_SIZE {
                    strcpy(file_buffer + offset, &full_path[0]);
                    files[file_count[0]] = file_buffer + offset;
                    buffer_offset[0] = offset + strlen(&full_path[0]) + 1;
                    file_count[0] = file_count[0] + 1;
                }
            }
        }

        entry = readdir(dir);
    }

    closedir(dir);
    return 0;
}

// 格式化单个文件
fn format_single_file(
    filepath: &byte,
    mode: FmtMode,
    output_file: &byte,
    stats: &FmtStats
) i32 {
    stats.total = stats.total + 1;

    // 读取文件
    const file: *void = fopen(filepath as *byte, "rb" as *byte);
    if file == null {
        fprintf(libc.stderr, "错误：无法读取 '%s'\n" as *byte, filepath as *byte);
        stats.errors = stats.errors + 1;
        return -1;
    }

    const bytes_read: usize = fread(&file_buffer[0], 1, BUFFER_SIZE - 1, file);
    file_buffer[bytes_read] = 0 as byte;
    fclose(file);

    if bytes_read == 0 {
        fprintf(libc.stderr, "警告：空文件 '%s'\n" as *byte, filepath as *byte);
        stats.formatted = stats.formatted + 1;
        return 0;
    }

    // 格式化
    const result: FormatResult = format_code(
        &file_buffer[0],
        bytes_read,
        &output_buffer[0],
        BUFFER_SIZE
    );

    if result.success == 0 {
        fprintf(libc.stderr, "错误：格式化失败 '%s': %s\n" as *byte,
                filepath as *byte, result.error_message as *byte);
        stats.errors = stats.errors + 1;
        return -1;
    }

    output_buffer[result.output_len] = 0 as byte;

    // 根据模式处理
    if mode == FmtMode.FMT_MODE_CHECK {
        // 检查模式：比较是否相同
        var changed: i32 = 0;
        if bytes_read != result.output_len {
            changed = 1;
        } else {
            var i: usize = 0;
            while i < bytes_read {
                if file_buffer[i] != output_buffer[i] {
                    changed = 1;
                    break;
                }
                i = i + 1;
            }
        }
        
        if changed == 0 {
            fprintf(libc.stderr, "  ✓ %s\n" as *byte, filepath as *byte);
            stats.formatted = stats.formatted + 1;
        } else {
            fprintf(libc.stderr, "  ✗ %s (需要格式化)\n" as *byte, filepath as *byte);
            stats.changed = stats.changed + 1;
        }
    } else {
        // 写入模式
        var changed: i32 = 0;
        if bytes_read != result.output_len {
            changed = 1;
        } else {
            var i: usize = 0;
            while i < bytes_read {
                if file_buffer[i] != output_buffer[i] {
                    changed = 1;
                    break;
                }
                i = i + 1;
            }
        }

        if changed != 0 || output_file != null {
            var out_path: &byte = filepath;
            if output_file != null {
                out_path = output_file;
            }
            
            const out_file: *void = fopen(out_path as *byte, "wb" as *byte);
            if out_file == null {
                fprintf(libc.stderr, "错误：无法写入 '%s'\n" as *byte, out_path as *byte);
                stats.errors = stats.errors + 1;
                return -1;
            }
            fwrite(&output_buffer[0], 1, result.output_len, out_file);
            fclose(out_file);

            if changed != 0 {
                stats.changed = stats.changed + 1;
                fprintf(libc.stderr, "  已格式化：%s\n" as *byte, filepath as *byte);
            } else {
                stats.formatted = stats.formatted + 1;
            }
        } else {
            stats.formatted = stats.formatted + 1;
        }
    }

    return 0;
}

// 主函数
export fn main() i32 {
    const argc: i32 = get_argc();

    if argc < 2 {
        var name: &byte = "uya-fmt" as *byte;
        const argv0: *byte = get_argv(0);
        if argv0 != null {
            name = argv0 as &byte;
        }
        print_usage(name);
        return 1;
    }

    const first_arg: *byte = get_argv(1);
    if first_arg == null {
        fprintf(libc.stderr, "错误：无法获取参数\n" as *byte);
        return 1;
    }

    // 检查帮助
    if strcmp(first_arg, "-h" as *byte) == 0 ||
       strcmp(first_arg, "--help" as *byte) == 0 {
        var name: &byte = "uya-fmt" as *byte;
        const argv0: *byte = get_argv(0);
        if argv0 != null {
            name = argv0 as &byte;
        }
        print_usage(name);
        return 0;
    }

    // 解析参数
    var mode: FmtMode = FmtMode.FMT_MODE_WRITE;
    var recursive: i32 = 0;
    var output_file: &byte = null;
    var input_paths: [&byte: 64] = [];
    var input_count: i32 = 0;

    var i: i32 = 1;
    while i < argc {
        const arg: *byte = get_argv(i);
        if arg == null { break; }

        if strcmp(arg, "-h" as *byte) == 0 || strcmp(arg, "--help" as *byte) == 0 {
            var name: &byte = "uya-fmt" as *byte;
            const argv0: *byte = get_argv(0);
            if argv0 != null {
                name = argv0 as &byte;
            }
            print_usage(name);
            return 0;
        } else if strcmp(arg, "-r" as *byte) == 0 || strcmp(arg, "--recursive" as *byte) == 0 {
            recursive = 1;
        } else if strcmp(arg, "-c" as *byte) == 0 || strcmp(arg, "--check" as *byte) == 0 {
            mode = FmtMode.FMT_MODE_CHECK;
        } else if strcmp(arg, "-o" as *byte) == 0 || strcmp(arg, "--output" as *byte) == 0 {
            if i + 1 < argc {
                output_file = get_argv(i + 1);
                i = i + 1;
            }
        } else if arg[0] != 45 {  // 不是 '-' 开头
            if input_count < 64 {
                input_paths[input_count] = arg as &byte;
                input_count = input_count + 1;
            }
        }
        i = i + 1;
    }

    if input_count == 0 {
        fprintf(libc.stderr, "错误：未指定输入文件或目录\n" as *byte);
        return 1;
    }

    // 统计
    var stats: FmtStats = FmtStats { total = 0, formatted = 0, changed = 0, errors = 0 };

    // 处理输入路径
    i = 0;
    while i < input_count {
        const path: &byte = input_paths[i];

        if is_directory(path as &byte) != 0 {
            // 目录：收集所有 .uya 文件
            var files: [&byte: MAX_FILES] = [];
            var file_count: i32 = 0;
            var buffer_offset: usize = 0;

            collect_uya_files(
                path as &byte,
                &files[0],
                MAX_FILES,
                &file_count,
                recursive,
                &file_buffer[0],
                &buffer_offset
            );

            // 格式化每个文件
            var j: i32 = 0;
            while j < file_count {
                format_single_file(files[j], mode, output_file, &stats);
                j = j + 1;
            }
        } else {
            // 单个文件
            format_single_file(path as &byte, mode, output_file, &stats);
        }
        i = i + 1;
    }

    // 输出统计
    fprintf(libc.stderr, "\n=== 格式化统计 ===\n" as *byte);
    fprintf(libc.stderr, "总文件数：%d\n" as *byte, stats.total);
    fprintf(libc.stderr, "已格式化：%d\n" as *byte, stats.formatted);
    fprintf(libc.stderr, "有变化：%d\n" as *byte, stats.changed);
    fprintf(libc.stderr, "错误：%d\n" as *byte, stats.errors);

    // 检查模式返回码
    if mode == FmtMode.FMT_MODE_CHECK {
        if stats.changed > 0 { return 1; }
        return 0;
    }

    if stats.errors > 0 { return 1; }
    return 0;
}
