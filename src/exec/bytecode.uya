// exec/bytecode.uya - Exec backend bytecode definitions

enum BCOpcode {
    BC_LOAD_CONST,
    BC_LOAD_LOCAL,
    BC_MOV,
    BC_ADDR_LOCAL,
    BC_ADDR_GLOBAL,
    BC_ADDR_FIELD,
    BC_ADDR_INDEX,
    BC_BOX_VALUE,
    BC_LOAD_GLOBAL,
    BC_STORE_LOCAL,
    BC_STORE_GLOBAL,
    BC_ADD,
    BC_SUB,
    BC_MUL,
    // 饱和加/减/乘：结果超出目标整数类型时钳到该类型的极值
    BC_ADD_SAT,
    BC_SUB_SAT,
    BC_MUL_SAT,
    BC_DIV,
    BC_REM,
    // 溢出受检算术：结果写入错误联合槽位，正常时携带运算结果，
    // 溢出/除零时携带错误 id（供 `(a + b) catch` 就地处理）。
    BC_ADD_CHECK,
    BC_SUB_CHECK,
    BC_MUL_CHECK,
    BC_DIV_CHECK,
    BC_REM_CHECK,
    BC_BIT_AND,
    BC_BIT_OR,
    BC_BIT_XOR,
    BC_SHL,
    BC_SHR,
    BC_NEG,
    BC_NOT,
    BC_LOAD_LEN,
    BC_LOAD_SLICE_PTR,
    BC_CAST,
    BC_MAKE_STRUCT,
    BC_MAKE_ARRAY,
    BC_MAKE_ARRAY_REPEAT,
    BC_MAKE_TUPLE,
    BC_MAKE_UNION,
    BC_MAKE_SLICE,
    BC_LOAD_FIELD,
    BC_STORE_FIELD,
    BC_LOAD_INDEX,
    BC_STORE_INDEX,
    BC_LOAD_UNION_TAG,
    BC_LOAD_UNION_PAYLOAD,
    // 错误联合 match 分发：标签（ok=0，err=error_id）与成功分支载荷
    BC_LOAD_ERROR_TAG,
    BC_LOAD_ERROR_PAYLOAD,
    BC_CMP_EQ,
    BC_CMP_NE,
    BC_CMP_LT,
    BC_CMP_LE,
    BC_CMP_GT,
    BC_CMP_GE,
    BC_MAKE_OK,
    BC_MAKE_ERR,
    BC_IS_ERR,
    BC_UNWRAP_OK,
    BC_UNWRAP_ERR,
    BC_JMP,
    BC_JMP_IF_TRUE,
    BC_JMP_IF_FALSE,
    BC_CALL,
    BC_CALL_INDIRECT,
    BC_HOSTCALL,
    BC_SYSCALL,
    BC_VA_START,
    BC_VA_END,
    BC_VA_ARG,
    BC_VA_COPY,
    BC_RET,
    BC_PRINT,
    BC_PRINTLN,
    BC_ERROR_ID,
    BC_ERROR_NAME,
}

struct BCErrorNameEntry {
    error_id: i32,
    name: &byte,
}

struct BCHostCallSite {
    id: ExecHostCallId,
    name: &byte,
    arg_count: i32,
}

struct BCConstPool {
    values: &ExecValue,
    count: i32,
}

struct BCSourceMap {
    line: i32,
    column: i32,
    filename: &byte,
}

struct BCInstr {
    opcode: BCOpcode,
    a: i32,
    b: i32,
    c: i32,
    imm: i64,
    text: &byte,
    source: BCSourceMap,
}

struct BCFunction {
    name: &byte,
    decl: &ASTNode,
    instrs: &BCInstr,
    instr_count: i32,
    slot_count: i32,
    param_count: i32,
    is_varargs: i32,
    return_type: Type,
}

struct BCProgram {
    functions: &BCFunction,
    function_count: i32,
    entry_function_index: i32,
    global_init_function_index: i32,
    const_pool: BCConstPool,
    host_calls: &BCHostCallSite,
    host_call_count: i32,
    error_names: &BCErrorNameEntry,
    error_name_count: i32,
    globals: &ExecValue,
    global_count: i32,
    // 顶层 test "..." 块在函数表中的下标与描述串（VM 入口负责逐个执行并统计）
    test_function_indices: &i32,
    test_descriptions: & & byte,
    test_count: i32,
    has_user_main: i32,
    // std.testing 的 _test_passed 全局槽位；未导入时为 -1
    test_passed_global_index: i32,
}
