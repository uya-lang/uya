// exec/hir.uya - Exec backend HIR definitions

const EXEC_MAX_CALL_ARGS: i32 = 128;

enum ExecHostCallId {
    EXEC_HOST_CALL_NONE,
    EXEC_HOST_CALL_PUTS,
    EXEC_HOST_CALL_ATOI,
    EXEC_HOST_CALL_ATOLL,
    EXEC_HOST_CALL_ISQRT,
    EXEC_HOST_CALL_STRCMP,
    EXEC_HOST_CALL_LLABS,
    EXEC_HOST_CALL_MKDIR,
    EXEC_HOST_CALL_RMDIR,
    EXEC_HOST_CALL_FPRINTF_FIXED,
    EXEC_HOST_CALL_PRINTF_FIXED,
    EXEC_HOST_CALL_SPRINTF_FIXED,
    // `sscanf(str, fmt, &a, &b, ...)`：把解析结果写回调用方的 VM 槽位。
    EXEC_HOST_CALL_SSCANF_FIXED,
    EXEC_HOST_CALL_SNPRINTF_FIXED,
    EXEC_HOST_CALL_ATOMIC_COMPARE_EXCHANGE,
    EXEC_HOST_CALL_MEMCPY,
    EXEC_HOST_CALL_MEMMOVE,
    EXEC_HOST_CALL_MEMSET,
    EXEC_HOST_CALL_MEMCMP,
    EXEC_HOST_CALL_STRLEN,
    EXEC_HOST_CALL_MALLOC,
    EXEC_HOST_CALL_FREE,
    EXEC_HOST_CALL_CALLOC,
    EXEC_HOST_CALL_REALLOC,
    EXEC_HOST_CALL_ATOMIC_LOAD_N,
    EXEC_HOST_CALL_ATOMIC_STORE_N,
    EXEC_HOST_CALL_ATOMIC_EXCHANGE_N,
    EXEC_HOST_CALL_ATOMIC_ADD_FETCH,
    EXEC_HOST_CALL_ATOMIC_FETCH_ADD,
    EXEC_HOST_CALL_ATOMIC_FETCH_SUB,
    EXEC_HOST_CALL_ATOMIC_FENCE,
    EXEC_HOST_CALL_PTHREAD_SIGMASK,
    EXEC_HOST_CALL_SIGWAIT,
    EXEC_HOST_CALL_INTERFACE_GET_VTABLE,
    EXEC_HOST_CALL_SYNTH_ZERO,
    EXEC_HOST_CALL_IMAGE_ANCHOR,
    EXEC_HOST_CALL_ISATTY,
    EXEC_HOST_CALL_SETPGID,
    EXEC_HOST_CALL_GETPGID,
    EXEC_HOST_CALL_GETPGRP,
    EXEC_HOST_CALL_SETSID,
    EXEC_HOST_CALL_KILL,
    // `fcntl(fd, cmd, ...)`：C varargs，解释器里按 fcntl 系统调用实现。
    EXEC_HOST_CALL_FCNTL,
    // 信号三件套：解释器不真发信号，`signal`/`raise`/`sigprocmask` 按
    // 「登记处理器 + 掩码 + 挂起补投递」模拟（同步、可重入地调用 Uya 处理器）。
    EXEC_HOST_CALL_SIGNAL_REGISTER,
    EXEC_HOST_CALL_RAISE,
    EXEC_HOST_CALL_SIGPROCMASK_SIM,
    // @c_import 导入的 C 函数：调用点名字在运行期用 dlsym 解析。
    EXEC_HOST_CALL_C_IMPORT_DYNAMIC,
    EXEC_HOST_CALL_EXIT,
    EXEC_HOST_CALL_MEMCHR,
    EXEC_HOST_CALL_PTHREAD_CREATE,
    EXEC_HOST_CALL_PTHREAD_JOIN,
    EXEC_HOST_CALL_PTHREAD_DETACH,
    EXEC_HOST_CALL_PTHREAD_SELF,
    EXEC_HOST_CALL_PTHREAD_EQUAL,
    EXEC_HOST_CALL_PTHREAD_ONCE,
    EXEC_HOST_CALL_PTHREAD_EXIT,
    EXEC_HOST_CALL_PTHREAD_CANCEL,
    EXEC_HOST_CALL_PTHREAD_ATTR_INIT,
    EXEC_HOST_CALL_PTHREAD_ATTR_GETSTACKSIZE,
    EXEC_HOST_CALL_PTHREAD_ATTR_SETSTACKSIZE,
    EXEC_HOST_CALL_PTHREAD_ATTR_GETDETACHSTATE,
    EXEC_HOST_CALL_PTHREAD_ATTR_SETDETACHSTATE,
    EXEC_HOST_CALL_PTHREAD_COND_TIMEDWAIT,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_INIT,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_SETTYPE,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_GETTYPE,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_DESTROY,
    EXEC_HOST_CALL_PTHREAD_MUTEX_INIT,
    EXEC_HOST_CALL_PTHREAD_MUTEX_DESTROY,
    EXEC_HOST_CALL_PTHREAD_MUTEX_LOCK,
    EXEC_HOST_CALL_PTHREAD_MUTEX_TRYLOCK,
    EXEC_HOST_CALL_PTHREAD_MUTEX_UNLOCK,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_INIT,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_GETCLOCK,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_SETCLOCK,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_DESTROY,
    EXEC_HOST_CALL_PTHREAD_SETCANCELSTATE,
    EXEC_HOST_CALL_PTHREAD_SETCANCELTYPE,
    EXEC_HOST_CALL_PTHREAD_BARRIER_INIT,
    EXEC_HOST_CALL_PTHREAD_BARRIER_WAIT,
    EXEC_HOST_CALL_PTHREAD_BARRIER_DESTROY,
    EXEC_HOST_CALL_SETJMP,
    EXEC_HOST_CALL_SIGSETJMP,
    EXEC_HOST_CALL_PTHREAD_KEY_CREATE,
    EXEC_HOST_CALL_PTHREAD_KEY_DELETE,
    EXEC_HOST_CALL_PTHREAD_SETSPECIFIC,
    EXEC_HOST_CALL_PTHREAD_GETSPECIFIC,
    // libm 一/二元函数（`extern "libc" fn exp(x: f64) f64;` 这类没有 Uya 实现体的
    // 声明）：具体函数名放在 hostcall 站点的 `name` 里，VM 按名字分派。
    EXEC_HOST_CALL_LIBM1,
    EXEC_HOST_CALL_LIBM2,
    // `@frame(fn)` 的 `start(...)` / `poll(&waker)`：VM 侧同步执行子函数并把
    // 结果存回帧对象本身（见 `exec_vm_frame_start` / `exec_vm_frame_poll`）。
    EXEC_HOST_CALL_FRAME_START,
    EXEC_HOST_CALL_FRAME_POLL,
    // `uya_thread_call_<T>(fn, arg)`：C99 前导里的 static inline 就是
    // `((T (*)(T))fn)(arg)`。VM 里没有真实函数指针，改为按名字直接调 Uya 函数
    // 并把返回值按调用点的静态类型还原（非 i32 类型此前一律拿到 0）。
    EXEC_HOST_CALL_THREAD_CALL,
    // `uya_call0_i32(fn)` / `uya_call0_i32_stack(fn, stack_top)`：C99 前导里是
    // `((int32_t (*)(void))fn)()`。
    //
    // VM 里 `&some_fn as &void` 得到的是函数引用编码（`EXEC_VM_FN_REF_BASE + 下标`，
    // 例如 `0x40000001`），不是可执行地址。`lib/kernel/sim.uya` 的 call gate
    // trampoline 会把 `entry_ptr` 原样写进 `movabs rax, imm64`，于是原生侧跳过去
    // 就是一次非法地址跳转——VM 里表现为静默返回 0。
    //
    // 这里改为：从 trampoline 机器码里读出目标立即数，若是函数引用编码就转成
    // VM 内部调用，于是「call gate 桩 + 目标函数」这条链在解释器里也能跑通。
    EXEC_HOST_CALL_CALL0_I32,
    EXEC_HOST_CALL_CALL0_I32_STACK,
}

enum HIRStmtKind {
    HIR_STMT_SCOPE_ENTER,
    HIR_STMT_SCOPE_EXIT,
    HIR_STMT_BLOCK,
    HIR_STMT_VAR_INIT,
    HIR_STMT_ASSIGN,
    HIR_STMT_EXPR,
    HIR_STMT_DEFER,
    HIR_STMT_ERRDEFER,
    HIR_STMT_IF,
    HIR_STMT_LOOP,
    HIR_STMT_BREAK,
    HIR_STMT_CONTINUE,
    HIR_STMT_RETURN,
}

enum HIRExprKind {
    HIR_EXPR_CONST,
    HIR_EXPR_ZERO,
    HIR_EXPR_LOCAL,
    HIR_EXPR_GLOBAL,
    HIR_EXPR_ADDR,
    HIR_EXPR_UNARY,
    HIR_EXPR_BINARY,
    HIR_EXPR_CALL,
    HIR_EXPR_IMETHOD_CALL,
    HIR_EXPR_LEN,
    HIR_EXPR_SLICE_PTR,
    // `@embed_dir(...)`：编译期就把所有条目的路径与内容都读好了，
    // builder 里直接拼出 `&[EmbedDirEntry]` 常量（无需运行时 IO）。
    HIR_EXPR_EMBED_DIR,
    HIR_EXPR_STRUCT_INIT,
    HIR_EXPR_INTERFACE_BOX,
    HIR_EXPR_ARRAY_INIT,
    HIR_EXPR_TUPLE_INIT,
    HIR_EXPR_UNION_INIT,
    HIR_EXPR_FIELD,
    HIR_EXPR_INDEX,
    HIR_EXPR_SLICE,
    HIR_EXPR_CAST,
    HIR_EXPR_ASSIGN,
    HIR_EXPR_IF,
    HIR_EXPR_MAKE_OK,
    HIR_EXPR_TRY,
    HIR_EXPR_CATCH,
    HIR_EXPR_MATCH,
    HIR_EXPR_PRINT,
    HIR_EXPR_PRINTLN,
    // 字符串插值：string_value 是格式串，items 是实参。
    HIR_EXPR_STRING_INTERP,
    HIR_EXPR_VECTOR_OP,
    HIR_EXPR_ERROR_ID,
    HIR_EXPR_ERROR_NAME,
    HIR_EXPR_SYSCALL,
    HIR_EXPR_VA_START,
    HIR_EXPR_VA_END,
    HIR_EXPR_VA_ARG,
    HIR_EXPR_VA_COPY,
    // 把错误值包装进错误联合（err 分支）；int_value 携带 error id。
    HIR_EXPR_MAKE_ERR,
    // 溢出受检的整数二元运算：left/right 是操作数，binary_op 是运算符，
    // type_ref 是**结果值类型**（不是错误联合）。溢出时跳到最近的 CHECKED_CATCH。
    HIR_EXPR_CHECKED_ARITH,
    // `(a + b) catch { ... }`：left 是受检算术树，block/right 是 catch 分支。
    // 与 HIR_EXPR_CATCH 的区别是错误来源不是错误联合值，而是算术溢出。
    HIR_EXPR_CHECKED_CATCH,
    // `{ ... }` 用作表达式（宏展开产物）：block 是前导语句，extra 是尾表达式的值。
    HIR_EXPR_BLOCK,
    // `@await f`：left 是 Future 值；结果是 Ready 里的载荷。
    HIR_EXPR_AWAIT,
    // `x.value`（x 是错误联合）：**读字段**语义。
    //
    // 与 `HIR_EXPR_TRY`（`try x`：err 就清理并提前返回）严格区分开：
    // C99 后端把 `.value` 编译成普通的错误联合字段读取，err 分支下读到
    // 未初始化的零值、**照常继续执行**。旧实现让 `.value` 复用 TRY，
    // 于是任何在 err 分支上取一次载荷的代码整条失败
    //（`lib/tls/https.uya` 的 `HttpsWriteAllFuture.poll` 在 catch 里写
    //  `(@error_id(err) as! i32).value`，导致 test_tls_async_runtime_io
    //  首轮 poll 就失败）。
    //
    // 必须是**独立节点**：在 TRY 上打补丁会残留它那条「清理 + BC_RET」
    // 跳转指令，实测会生成 `imm=0` 的悬挂跳转（死循环）。
    HIR_EXPR_ERROR_PAYLOAD,
    // `x as! T`（x 是**错误联合**）：对齐 C99 的 as! 语义 ——
    //   err 分支：错误 id 原样透传，载荷写零值；
    //   ok 分支：错误 id 归零，载荷用转换后的值。
    // left 是「已经转换到载荷类型的裸值」，int_value 携带源错误联合的错误 id 无关信息。
    //
    // 不能像旧实现那样无条件 `MAKE_OK`：那会把 err 分支也标成成功，
    // 之后任何 `IS_ERR`/`.value` 判断都失真
    //（`(w as! isize).value` 因此得 1 而 C99 得 0，见第 590 轮）。
    HIR_EXPR_FORCE_CAST_KEEP_ERR,
}

struct HIRMatchArm {
    kind: MatchPatternKind,
    int_value: i64,
    bool_value: i32,
    bind_local_slot: i32,
    result_block: &HIRBlock,
    result_expr: &HIRExpr,
}

struct HIRTypeRef {
    type: Type,
}

struct HIRLocalSlot {
    name: &byte,
    decl: &ASTNode,
    slot: i32,
    scope_id: i32,
    type_ref: HIRTypeRef,
    is_param: i32,
    needs_drop: i32,
    drop_decl: &ASTNode,
    // 字段级 drop：lowering 阶段就已按实例化类型实参选好单态 drop 声明，
    // 构建期没法再做特化（`Vec<byte>` 的 `drop` ≠ 泛型 `Vec<T>.drop`）。
    field_drop_indices: [i32: 4],
    field_drop_decls: [&ASTNode: 4],
    field_drop_count: i32,
}

struct HIRGlobalSlot {
    name: &byte,
    decl: &ASTNode,
    slot: i32,
    type_ref: HIRTypeRef,
    is_const: i32,
    init_expr: &HIRExpr,
}

struct HIRExpr {
    kind: HIRExprKind,
    ast_node: &ASTNode,
    type_ref: HIRTypeRef,
    local_slot: i32,
    global_slot: i32,
    unary_op: i32,
    binary_op: i32,
    int_value: i64,
    float_value: f64,
    bool_value: i32,
    string_value: &byte,
    left: &HIRExpr,
    right: &HIRExpr,
    callee_name: &byte,
    callee_decl: &ASTNode,
    call_host_id: ExecHostCallId,
    call_args: & & HIRExpr,
    call_arg_count: i32,
    dispatch_decls: & & ASTNode,
    dispatch_decl_count: i32,
    items: & & HIRExpr,
    item_count: i32,
    block: &HIRBlock,
    extra: &HIRExpr,
    match_arms: &HIRMatchArm,
    match_arm_count: i32,
}

struct HIRStmt {
    kind: HIRStmtKind,
    ast_node: &ASTNode,
    scope_id: i32,
    local_slot: i32,
    expr: &HIRExpr,
    assign_target: &HIRExpr,
    assign_expr: &HIRExpr,
    then_block: &HIRBlock,
    else_block: &HIRBlock,
    loop_body: &HIRBlock,
    cleanup_block: &HIRBlock,
    int_value: i64,
}

struct HIRBlock {
    scope_id: i32,
    stmts: & & HIRStmt,
    stmt_count: i32,
}

struct HIRFunction {
    name: &byte,
    decl: &ASTNode,
    return_type: HIRTypeRef,
    locals: &HIRLocalSlot,
    local_count: i32,
    param_count: i32,
    is_varargs: i32,
    body: &HIRBlock,
}

struct HIRModule {
    functions: & & HIRFunction,
    function_count: i32,
    entry_function: &HIRFunction,
    globals: &HIRGlobalSlot,
    global_count: i32,
    global_init_function: &HIRFunction,
    // 顶层 test "..." 块：每个测试一个 !void HIR 函数，描述串用于 runner 输出
    tests: & & HIRFunction,
    test_descriptions: & & byte,
    test_count: i32,
    // 程序是否自带用户 main（决定 runner 是否打印汇总并以其失败数作为退出码）
    has_user_main: i32,
}
