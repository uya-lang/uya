// exec/hir.uya - Exec backend HIR definitions

const EXEC_MAX_CALL_ARGS: i32 = 128;

enum ExecHostCallId {
    EXEC_HOST_CALL_NONE,
    EXEC_HOST_CALL_PUTS,
    EXEC_HOST_CALL_ATOI,
    EXEC_HOST_CALL_ATOLL,
    EXEC_HOST_CALL_ISQRT,
    EXEC_HOST_CALL_STRCMP,
    EXEC_HOST_CALL_LLABS,
    EXEC_HOST_CALL_MKDIR,
    EXEC_HOST_CALL_RMDIR,
    EXEC_HOST_CALL_FPRINTF_FIXED,
    EXEC_HOST_CALL_PRINTF_FIXED,
    EXEC_HOST_CALL_SPRINTF_FIXED,
    EXEC_HOST_CALL_SNPRINTF_FIXED,
    EXEC_HOST_CALL_ATOMIC_COMPARE_EXCHANGE,
    EXEC_HOST_CALL_MEMCPY,
    EXEC_HOST_CALL_MEMMOVE,
    EXEC_HOST_CALL_MEMSET,
    EXEC_HOST_CALL_MEMCMP,
    EXEC_HOST_CALL_STRLEN,
    EXEC_HOST_CALL_MALLOC,
    EXEC_HOST_CALL_FREE,
    EXEC_HOST_CALL_CALLOC,
    EXEC_HOST_CALL_REALLOC,
    EXEC_HOST_CALL_ATOMIC_LOAD_N,
    EXEC_HOST_CALL_ATOMIC_STORE_N,
    EXEC_HOST_CALL_ATOMIC_EXCHANGE_N,
    EXEC_HOST_CALL_ATOMIC_ADD_FETCH,
    EXEC_HOST_CALL_ATOMIC_FETCH_ADD,
    EXEC_HOST_CALL_ATOMIC_FETCH_SUB,
    EXEC_HOST_CALL_ATOMIC_FENCE,
    EXEC_HOST_CALL_PTHREAD_SIGMASK,
    EXEC_HOST_CALL_INTERFACE_GET_VTABLE,
    EXEC_HOST_CALL_SYNTH_ZERO,
    EXEC_HOST_CALL_IMAGE_ANCHOR,
    EXEC_HOST_CALL_ISATTY,
    EXEC_HOST_CALL_EXIT,
    EXEC_HOST_CALL_MEMCHR,
    EXEC_HOST_CALL_PTHREAD_CREATE,
    EXEC_HOST_CALL_PTHREAD_JOIN,
    EXEC_HOST_CALL_PTHREAD_DETACH,
    EXEC_HOST_CALL_PTHREAD_SELF,
    EXEC_HOST_CALL_PTHREAD_EQUAL,
    EXEC_HOST_CALL_PTHREAD_ONCE,
    EXEC_HOST_CALL_PTHREAD_EXIT,
    EXEC_HOST_CALL_PTHREAD_ATTR_INIT,
    EXEC_HOST_CALL_PTHREAD_ATTR_GETSTACKSIZE,
    EXEC_HOST_CALL_PTHREAD_ATTR_SETSTACKSIZE,
    EXEC_HOST_CALL_PTHREAD_ATTR_GETDETACHSTATE,
    EXEC_HOST_CALL_PTHREAD_ATTR_SETDETACHSTATE,
    EXEC_HOST_CALL_PTHREAD_COND_TIMEDWAIT,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_INIT,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_SETTYPE,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_GETTYPE,
    EXEC_HOST_CALL_PTHREAD_MUTEXATTR_DESTROY,
    EXEC_HOST_CALL_PTHREAD_MUTEX_INIT,
    EXEC_HOST_CALL_PTHREAD_MUTEX_DESTROY,
    EXEC_HOST_CALL_PTHREAD_MUTEX_LOCK,
    EXEC_HOST_CALL_PTHREAD_MUTEX_TRYLOCK,
    EXEC_HOST_CALL_PTHREAD_MUTEX_UNLOCK,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_INIT,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_GETCLOCK,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_SETCLOCK,
    EXEC_HOST_CALL_PTHREAD_CONDATTR_DESTROY,
    EXEC_HOST_CALL_PTHREAD_SETCANCELSTATE,
    EXEC_HOST_CALL_PTHREAD_SETCANCELTYPE,
    EXEC_HOST_CALL_PTHREAD_BARRIER_INIT,
    EXEC_HOST_CALL_PTHREAD_BARRIER_WAIT,
    EXEC_HOST_CALL_PTHREAD_BARRIER_DESTROY,
    EXEC_HOST_CALL_SETJMP,
    EXEC_HOST_CALL_SIGSETJMP,
    EXEC_HOST_CALL_PTHREAD_KEY_CREATE,
    EXEC_HOST_CALL_PTHREAD_KEY_DELETE,
    EXEC_HOST_CALL_PTHREAD_SETSPECIFIC,
    EXEC_HOST_CALL_PTHREAD_GETSPECIFIC,
}

enum HIRStmtKind {
    HIR_STMT_SCOPE_ENTER,
    HIR_STMT_SCOPE_EXIT,
    HIR_STMT_BLOCK,
    HIR_STMT_VAR_INIT,
    HIR_STMT_ASSIGN,
    HIR_STMT_EXPR,
    HIR_STMT_DEFER,
    HIR_STMT_ERRDEFER,
    HIR_STMT_IF,
    HIR_STMT_LOOP,
    HIR_STMT_BREAK,
    HIR_STMT_CONTINUE,
    HIR_STMT_RETURN,
}

enum HIRExprKind {
    HIR_EXPR_CONST,
    HIR_EXPR_ZERO,
    HIR_EXPR_LOCAL,
    HIR_EXPR_GLOBAL,
    HIR_EXPR_ADDR,
    HIR_EXPR_UNARY,
    HIR_EXPR_BINARY,
    HIR_EXPR_CALL,
    HIR_EXPR_IMETHOD_CALL,
    HIR_EXPR_LEN,
    HIR_EXPR_SLICE_PTR,
    HIR_EXPR_STRUCT_INIT,
    HIR_EXPR_INTERFACE_BOX,
    HIR_EXPR_ARRAY_INIT,
    HIR_EXPR_TUPLE_INIT,
    HIR_EXPR_UNION_INIT,
    HIR_EXPR_FIELD,
    HIR_EXPR_INDEX,
    HIR_EXPR_SLICE,
    HIR_EXPR_CAST,
    HIR_EXPR_ASSIGN,
    HIR_EXPR_IF,
    HIR_EXPR_MAKE_OK,
    HIR_EXPR_TRY,
    HIR_EXPR_CATCH,
    HIR_EXPR_MATCH,
    HIR_EXPR_PRINT,
    HIR_EXPR_PRINTLN,
    // 字符串插值：string_value 是格式串，items 是实参。
    HIR_EXPR_STRING_INTERP,
    HIR_EXPR_VECTOR_OP,
    HIR_EXPR_ERROR_ID,
    HIR_EXPR_ERROR_NAME,
    HIR_EXPR_SYSCALL,
    HIR_EXPR_VA_START,
    HIR_EXPR_VA_END,
    HIR_EXPR_VA_ARG,
    HIR_EXPR_VA_COPY,
    // 把错误值包装进错误联合（err 分支）；int_value 携带 error id。
    HIR_EXPR_MAKE_ERR,
    // 溢出受检的整数二元运算：left/right 是操作数，binary_op 是运算符，
    // type_ref 是**结果值类型**（不是错误联合）。溢出时跳到最近的 CHECKED_CATCH。
    HIR_EXPR_CHECKED_ARITH,
    // `(a + b) catch { ... }`：left 是受检算术树，block/right 是 catch 分支。
    // 与 HIR_EXPR_CATCH 的区别是错误来源不是错误联合值，而是算术溢出。
    HIR_EXPR_CHECKED_CATCH,
    // `{ ... }` 用作表达式（宏展开产物）：block 是前导语句，extra 是尾表达式的值。
    HIR_EXPR_BLOCK,
    // `@await f`：left 是 Future 值；结果是 Ready 里的载荷。
    HIR_EXPR_AWAIT,
}

struct HIRMatchArm {
    kind: MatchPatternKind,
    int_value: i64,
    bool_value: i32,
    bind_local_slot: i32,
    result_block: &HIRBlock,
    result_expr: &HIRExpr,
}

struct HIRTypeRef {
    type: Type,
}

struct HIRLocalSlot {
    name: &byte,
    decl: &ASTNode,
    slot: i32,
    scope_id: i32,
    type_ref: HIRTypeRef,
    is_param: i32,
    needs_drop: i32,
    drop_decl: &ASTNode,
    // 字段级 drop：lowering 阶段就已按实例化类型实参选好单态 drop 声明，
    // 构建期没法再做特化（`Vec<byte>` 的 `drop` ≠ 泛型 `Vec<T>.drop`）。
    field_drop_indices: [i32: 4],
    field_drop_decls: [&ASTNode: 4],
    field_drop_count: i32,
}

struct HIRGlobalSlot {
    name: &byte,
    decl: &ASTNode,
    slot: i32,
    type_ref: HIRTypeRef,
    is_const: i32,
    init_expr: &HIRExpr,
}

struct HIRExpr {
    kind: HIRExprKind,
    ast_node: &ASTNode,
    type_ref: HIRTypeRef,
    local_slot: i32,
    global_slot: i32,
    unary_op: i32,
    binary_op: i32,
    int_value: i64,
    float_value: f64,
    bool_value: i32,
    string_value: &byte,
    left: &HIRExpr,
    right: &HIRExpr,
    callee_name: &byte,
    callee_decl: &ASTNode,
    call_host_id: ExecHostCallId,
    call_args: & & HIRExpr,
    call_arg_count: i32,
    dispatch_decls: & & ASTNode,
    dispatch_decl_count: i32,
    items: & & HIRExpr,
    item_count: i32,
    block: &HIRBlock,
    extra: &HIRExpr,
    match_arms: &HIRMatchArm,
    match_arm_count: i32,
}

struct HIRStmt {
    kind: HIRStmtKind,
    ast_node: &ASTNode,
    scope_id: i32,
    local_slot: i32,
    expr: &HIRExpr,
    assign_target: &HIRExpr,
    assign_expr: &HIRExpr,
    then_block: &HIRBlock,
    else_block: &HIRBlock,
    loop_body: &HIRBlock,
    cleanup_block: &HIRBlock,
    int_value: i64,
}

struct HIRBlock {
    scope_id: i32,
    stmts: & & HIRStmt,
    stmt_count: i32,
}

struct HIRFunction {
    name: &byte,
    decl: &ASTNode,
    return_type: HIRTypeRef,
    locals: &HIRLocalSlot,
    local_count: i32,
    param_count: i32,
    is_varargs: i32,
    body: &HIRBlock,
}

struct HIRModule {
    functions: & & HIRFunction,
    function_count: i32,
    entry_function: &HIRFunction,
    globals: &HIRGlobalSlot,
    global_count: i32,
    global_init_function: &HIRFunction,
    // 顶层 test "..." 块：每个测试一个 !void HIR 函数，描述串用于 runner 输出
    tests: & & HIRFunction,
    test_descriptions: & & byte,
    test_count: i32,
    // 程序是否自带用户 main（决定 runner 是否打印汇总并以其失败数作为退出码）
    has_user_main: i32,
}
