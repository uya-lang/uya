            }
        }
        g_exec_vm_thread_exit_requested = 1;
        out_value[0] = exec_make_i32(0);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_SIGMASK {
        // 这里必须**真的**把信号屏蔽字设上，不能只做占位：管道写已关闭的对端时，
        // SIGPIPE 没被屏蔽会直接把解释器打死（退出码 141），Uya 代码里精心写的
        // `errno == EPIPE` 分支永远跑不到。
        //
        // Uya 的 `sigset_t` 只有一个 `val: u64`，而内核的 `rt_sigprocmask`
        // 要求的 sigsetsize 正好是 8，直接按 8 字节传即可。
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: pthread_sigmask 参数数量非法" as *byte, 0);
            return -1;
        }
        const how_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const set_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const old_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        var how_value: i32 = 0;
        if how_slot != null {
            how_value = exec_vm_numeric_to_i64(how_slot[0]) as i32;
        }
        var mask_new: i64 = 0;
        const set_target: &ExecValue = exec_vm_ref_target_value(set_slot);
        if set_target != null {
            const set_agg: &ExecAggregate = exec_value_as_aggregate(set_target);
            if set_agg != null && set_agg.values != null && set_agg.count > 0 {
                mask_new = exec_vm_numeric_to_i64(set_agg.values[0]);
            }
        }
        var mask_old: i64 = 0;
        const sig_rc: i64 = exec_vm_rt_sigprocmask(how_value, mask_new, &mask_old,
            set_target != null);
        const old_target: &ExecValue = exec_vm_ref_target_value(old_slot);
        if old_target != null {
            const old_agg: &ExecAggregate = exec_value_as_aggregate(old_target);
            if old_agg != null && old_agg.values != null && old_agg.count > 0 {
                old_agg.values[0] = exec_make_u64(mask_old as u64);
            }
