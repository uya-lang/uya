                    const create_attr: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
                    if create_attr != null && exec_vm_pointer_is_internal_ref(create_attr) != 0 {
                        const create_attr_detached: &ExecValue = exec_vm_field_ref(create_attr, 1);
