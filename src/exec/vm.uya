use libc.atoi;
use libc.atoll;
use libc.isqrt;
use libc.strcmp;
use libc.llabs;
use libc.mkdir;
use libc.rmdir;
use libc.fprintf;
use libc.clock;
use std.runtime.saved_envp;
use libc.printf;
use libc.sys_poll;
use libc.PollFd;
use libc.POLLIN;
use libc.POLLOUT;
use libc.sprintf;
use libc.snprintf;
use libc.write;
use libc.read_bytes_fd;
use libc.strlen;
use libc.fflush;
use libc.fopen;
use libc.fgets;
use libc.fclose;
use libc.malloc;
use libc.calloc;
use libc.realloc;
use libc.free;
use libc.exit;
use libc.fflush;
use libc.sys_setpgid;
use libc.sys_getpgid;
use libc.sys_getpgrp;
use libc.sys_setsid;
use libc.sys_kill;
use libc.sys_clone;
