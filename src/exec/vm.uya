        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_GETTYPE ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_DESTROY ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_INIT ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_DESTROY ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_LOCK ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_TRYLOCK ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_UNLOCK ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_INIT ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_GETCLOCK ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_SETCLOCK ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_DESTROY {
        // 互斥量/条件变量属性：单线程解释器里只维护对象内的状态字段，
        // 语义按 C 侧的返回值约定（EINVAL=22 / EBUSY=16）对齐。
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_INIT {
            const ma_type: &ExecValue = exec_vm_field_ref_store(exec_vm_slot_ref(frame, arg_base), 0);
            if ma_type != null {
                exec_vm_store_slot(ma_type, exec_make_i32(0));
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_SETTYPE {
            const ma_in: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
            if ma_in == null || ma_in.i64_value < 0 || ma_in.i64_value > 2 {
                out_value[0] = exec_make_i32(22);
                return 0;
            }
            const ma_type2: &ExecValue = exec_vm_field_ref_store(exec_vm_slot_ref(frame, arg_base), 0);
            if ma_type2 != null {
                exec_vm_store_slot(ma_type2, exec_make_i32(ma_in.i64_value as i32));
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_GETTYPE {
            const ma_out: &ExecValue = exec_vm_ref_target_value(exec_vm_slot_ref(frame, arg_base +| 1));
            const ma_type3: &ExecValue = exec_vm_field_ref(exec_vm_slot_ref(frame, arg_base), 0);
            if ma_out != null && ma_type3 != null {
                exec_vm_store_slot(ma_out, exec_make_i32(ma_type3.i64_value as i32));
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_DESTROY ||
            site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_DESTROY ||
            site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_DESTROY {
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_INIT {
            // 字段：0=state，1=owner（递归深度），2=type
            const mutex_value: &ExecValue = exec_vm_slot_ref(frame, arg_base);
            const mutex_state0: &ExecValue = exec_vm_field_ref_store(mutex_value, 0);
            if mutex_state0 != null {
                exec_vm_store_slot(mutex_state0, exec_make_i32(0));
            }
            const mutex_owner0: &ExecValue = exec_vm_field_ref_store(mutex_value, 1);
            if mutex_owner0 != null {
                exec_vm_store_slot(mutex_owner0, exec_make_i32(0));
            }
            var mutex_type_value: i64 = 0;
            const mutex_attr: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
            if mutex_attr != null && exec_vm_pointer_is_internal_ref(mutex_attr) != 0 {
                const mutex_attr_type: &ExecValue = exec_vm_field_ref(mutex_attr, 0);
                if mutex_attr_type != null {
                    mutex_type_value = mutex_attr_type.i64_value;
                }
            }
            const mutex_type0: &ExecValue = exec_vm_field_ref_store(mutex_value, 2);
            if mutex_type0 != null {
                exec_vm_store_slot(mutex_type0, exec_make_i32(mutex_type_value as i32));
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_TRYLOCK {
            const mutex_value2: &ExecValue = exec_vm_slot_ref(frame, arg_base);
            const mutex_state2: &ExecValue = exec_vm_field_ref_store(mutex_value2, 0);
            var mutex_busy: i64 = 0;
            if mutex_state2 != null {
                mutex_busy = mutex_state2.i64_value;
            }
            if mutex_busy != 0 {
                out_value[0] = exec_make_i32(16);
                return 0;
            }
            if mutex_state2 != null {
                exec_vm_store_slot(mutex_state2, exec_make_i32(1));
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_LOCK {
            const mutex_value3: &ExecValue = exec_vm_slot_ref(frame, arg_base);
            const mutex_state3: &ExecValue = exec_vm_field_ref_store(mutex_value3, 0);
            if mutex_state3 != null {
