            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_GETCLOCK {
            const ca_out: &ExecValue = exec_vm_ref_target_value(exec_vm_slot_ref(frame, arg_base +| 1));
            const ca_clock2: &ExecValue = exec_vm_field_ref(exec_vm_slot_ref(frame, arg_base), 0);
