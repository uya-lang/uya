        const sat_kind: i32 = exec_value_vector_elem_kind(slot_b);
        const sat_ldata: &byte = exec_value_vector_data(slot_b);
        const sat_r_is_vec: i32 = (slot_c.kind == ExecValueKind.EXEC_VALUE_VECTOR) as i32;
        const sat_rdata: &byte = exec_value_vector_data(slot_c);
        const sat_scalar: i64 = slot_c.i64_value;
        const sat_signed: i32 = exec_vector_elem_is_signed(sat_kind);
        var sat_out: ExecValue = exec_make_vector(sat_kind, sat_lanes);
        const sat_odata: &byte = exec_value_vector_data(&sat_out);
