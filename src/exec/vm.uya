            exec_vm_native_agg_rebase(realloc_old_addr, @usize_from_ptr(realloc_block as &void));
        }
        out_value[0] = exec_make_pointer_with_kind(@usize_from_ptr(realloc_block as &void), TypeKind.TYPE_VOID as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_FREE {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: free 参数数量非法" as *byte, 0);
            return -1;
        }
        const free_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if free_arg == null {
            exec_backend_set_error(function.decl, "exec: free 参数槽位非法" as *byte, 0);
            return -1;
        }
        if free_arg.ptr_value != null &&
            exec_vm_alloc_untrack(@usize_from_ptr(free_arg.ptr_value as &void)) != 0 {
            exec_vm_native_agg_forget(@usize_from_ptr(free_arg.ptr_value as &void));
            free(free_arg.ptr_value as &void);
        }
        out_value[0] = exec_make_void();
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MEMCMP {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: memcmp 参数数量非法" as *byte, 0);
            return -1;
        }
        const cmp_a: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const cmp_b: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const cmp_n: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if cmp_a == null || cmp_b == null || cmp_n == null {
            exec_backend_set_error(function.decl, "exec: memcmp 参数槽位非法" as *byte, 0);
            return -1;
        }
        const cmp_count: usize = cmp_n.i64_value as usize;
        const cmp_ap: &byte = cmp_a.ptr_value;
        const cmp_bp: &byte = cmp_b.ptr_value;
        var cmp_result: i32 = 0;
        var ci: usize = 0;
        while ci < cmp_count && cmp_result == 0 && cmp_ap != null && cmp_bp != null {
            const cmp_lb: byte = cmp_ap[ci];
            const cmp_rb: byte = cmp_bp[ci];
            if cmp_lb < cmp_rb {
                cmp_result = -1;
            } else if cmp_lb > cmp_rb {
                cmp_result = 1;
            }
            ci = ci + 1;
        }
        out_value[0] = exec_make_i32(cmp_result);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MEMCHR {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: memchr 参数数量非法" as *byte, 0);
            return -1;
        }
        const mch_a: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const mch_byte: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const mch_n: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if mch_a == null || mch_byte == null || mch_n == null {
            exec_backend_set_error(function.decl, "exec: memchr 参数槽位非法" as *byte, 0);
            return -1;
        }
        const mch_count: usize = mch_n.i64_value as usize;
        const mch_target: byte = mch_byte.i64_value as byte;
        const mch_base: &byte = mch_a.ptr_value;
        var mch_hit: &byte = null;
        if mch_base != null {
            var mchi: usize = 0;
            while mchi < mch_count {
                if mch_base[mchi] == mch_target {
                    mch_hit = mch_base + mchi;
                    mchi = mch_count;
                } else {
                    mchi = mchi + 1;
                }
            }
        }
        out_value[0] = exec_make_pointer_with_kind(mch_hit as usize, TypeKind.TYPE_BYTE as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_STRLEN {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: strlen 参数数量非法" as *byte, 0);
            return -1;
        }
        const len_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if len_arg == null {
            exec_backend_set_error(function.decl, "exec: strlen 参数槽位非法" as *byte, 0);
            return -1;
        }
        const len_ptr: &byte = len_arg.ptr_value;
        var len_count: usize = 0;
        while len_ptr != null && len_ptr[len_count] != 0 as byte {
            len_count = len_count + 1;
        }
        out_value[0] = exec_make_usize(len_count);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MKDIR {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: mkdir 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if arg0 == null || arg1 == null {
            exec_backend_set_error(function.decl, "exec: mkdir 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(mkdir(arg0.ptr_value as &const byte, arg1.i64_value as i32));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_RMDIR {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: rmdir 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: rmdir 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(rmdir(arg0.ptr_value as &const byte));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_COMPARE_EXCHANGE {
        if arg_count != 6 {
            exec_backend_set_error(function.decl, "exec: atomic compare_exchange 参数数量非法" as *byte, 0);
            return -1;
        }
        const ptr_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const expected_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const desired_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if ptr_arg == null || expected_arg == null || desired_arg == null {
            exec_backend_set_error(function.decl, "exec: atomic compare_exchange 参数槽位非法" as *byte, 0);
            return -1;
        }
        var current_value: ExecValue = exec_make_void();
        var expected_value: ExecValue = exec_make_void();
        if exec_vm_pointer_load_value(function, ptr_arg, &current_value) != 0 {
            return -1;
        }
        if exec_vm_pointer_load_value(function, expected_arg, &expected_value) != 0 {
            return -1;
        }
        if exec_vm_compare_values(current_value, expected_value) == 0 {
            const pointee_kind: i32 = exec_value_pointer_pointee_kind(&ptr_arg[0]);
            const cast_desired: ExecValue = exec_vm_cast_value(desired_arg[0], pointee_kind, 0);
            if exec_vm_pointer_store_value(function, ptr_arg, cast_desired) != 0 {
                return -1;
            }
            out_value[0] = exec_make_i32(1);
            return 0;
        }
        if exec_vm_pointer_store_value(function, expected_arg, current_value) != 0 {
            return -1;
        }
        out_value[0] = exec_make_i32(0);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_FPRINTF_FIXED {
        if arg_count < 2 {
            exec_backend_set_error(function.decl, "exec: fprintf 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if arg0 == null || arg1 == null {
            exec_backend_set_error(function.decl, "exec: fprintf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        const vm_fd: i32 = exec_vm_file_fd_from_value(arg0);
        var written: i32 = -1;
        if vm_fd >= 0 {
            written = exec_format_printf_like(EXEC_FORMAT_TARGET_FD, vm_fd, null, null, 0,
                arg1.ptr_value as &const byte, rest, arg_count -| 2);
        } else {
            written = exec_format_printf_like(EXEC_FORMAT_TARGET_FILE, -1, arg0.ptr_value as &FILE,
                null, 0, arg1.ptr_value as &const byte, rest, arg_count -| 2);
        }
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: fprintf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PRINTF_FIXED {
        if arg_count < 1 {
            exec_backend_set_error(function.decl, "exec: printf 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: printf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        // 与 @print 保持一致：写 libc.stdout（Uya stdio 实现，带行缓冲），
        // 避免宿主 fd 写入与缓冲输出交错导致与 C99 后端顺序不一致。
        const written: i32 = exec_format_printf_like(EXEC_FORMAT_TARGET_FILE, -1, libc.stdout, null, 0,
            arg0.ptr_value as &const byte, rest, arg_count -| 1);
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: printf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_SSCANF_FIXED {
        // `sscanf(str, fmt, &a, &b, ...)`：变参无法直接转发给宿主（要构造
        // C 的 va_list），这里按格式串逐个解析，把结果写回调用方给的 VM 槽位。
        // 目前覆盖 `%d` / `%i` / `%u`（含可选宽度与 `*` 抑制），够 tests 里的
        // 全部用法；遇到别的转换符就按「不匹配」处理，与 C 的返回值语义一致。
        if arg_count < 2 {
            exec_backend_set_error(function.decl, "exec: sscanf 参数数量非法" as *byte, 0);
            return -1;
        }
        const ss_arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const ss_arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if ss_arg0 == null || ss_arg1 == null {
            exec_backend_set_error(function.decl, "exec: sscanf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const ss_count: i32 = exec_vm_do_sscanf(frame, arg_base, arg_count,
            ss_arg0.ptr_value as &const byte, ss_arg1.ptr_value as &const byte);
        if ss_count < 0 {
            exec_backend_set_error(function.decl, "exec: sscanf 解析失败" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(ss_count);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_SPRINTF_FIXED {
        if arg_count < 2 {
            exec_backend_set_error(function.decl, "exec: sprintf 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if arg0 == null || arg1 == null {
            exec_backend_set_error(function.decl, "exec: sprintf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        const written: i32 = exec_format_printf_like(EXEC_FORMAT_TARGET_BUF, -1, null,
            arg0.ptr_value, 0, arg1.ptr_value as &const byte, rest, arg_count -| 2);
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: sprintf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_SNPRINTF_FIXED {
        if arg_count < 3 {
            exec_backend_set_error(function.decl, "exec: snprintf 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const arg2: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if arg0 == null || arg1 == null || arg2 == null {
            exec_backend_set_error(function.decl, "exec: snprintf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 3);
        const written: i32 = exec_format_printf_like(EXEC_FORMAT_TARGET_BUF_LIMIT, -1, null,
            arg0.ptr_value, arg1.i64_value as usize, arg2.ptr_value as &const byte, rest, arg_count -| 3);
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: snprintf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    exec_backend_set_error(function.decl, "exec: hostcall 目标非法" as *byte, 0);
    return -1;
}

fn vm_step(program: &BCProgram, frame: &ExecFrame, trace_vm: i32, out_value: &ExecValue) i32 {
    if program == null || frame == null || frame.function == null || out_value == null {
        exec_backend_set_error(null, "exec: vm_step 输入无效" as *byte, 0);
        return -1;
    }
    const function: &BCFunction = frame.function;
    if frame.ip < 0 || frame.ip >= function.instr_count {
        exec_backend_set_error(function.decl, "exec: vm_step 指令指针越界" as *byte, 0);
        return -1;
    }
    const instr: &BCInstr = function.instrs + frame.ip;
    exec_vm_trace(trace_vm, function.name, frame.ip, instr);
    const slot_a: &ExecValue = exec_vm_slot_ref(frame, instr.a);
    const slot_b: &ExecValue = exec_vm_slot_ref(frame, instr.b);
    const slot_c: &ExecValue = exec_vm_slot_ref(frame, instr.c);
    if instr.opcode == BCOpcode.BC_LOAD_CONST {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: LOAD_CONST 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_load_const(program, function, instr.imm as i32, slot_a) != 0 {
            return -1;
        }
    } else if instr.opcode == BCOpcode.BC_LOAD_LOCAL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: LOAD_LOCAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot_shallow(slot_a, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_LOAD_GLOBAL {
        const global_slot: &ExecValue = exec_vm_global_ref(program, instr.b);
        if slot_a == null || global_slot == null {
            exec_backend_set_error(function.decl, "exec: LOAD_GLOBAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot_shallow(slot_a, global_slot[0]);
    } else if instr.opcode == BCOpcode.BC_STORE_LOCAL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: STORE_LOCAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_STORE_GLOBAL {
        const global_slot2: &ExecValue = exec_vm_global_ref(program, instr.a);
        if global_slot2 == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: STORE_GLOBAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(global_slot2, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_MOV {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: MOV 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_ADDR_LOCAL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ADDR_LOCAL 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_vm_make_value_ref(slot_b, instr.c);
    } else if instr.opcode == BCOpcode.BC_ADDR_GLOBAL {
        const global_slot3: &ExecValue = exec_vm_global_ref(program, instr.b);
        if slot_a == null || global_slot3 == null {
            exec_backend_set_error(function.decl, "exec: ADDR_GLOBAL 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_vm_make_value_ref(global_slot3, instr.c);
    } else if instr.opcode == BCOpcode.BC_ADDR_FIELD {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ADDR_FIELD 槽位越界" as *byte, 0);
            return -1;
        }
        const addr_native_kind: i32 = (instr.c >> 8) & 0xFF;
        const addr_native_base: usize = exec_vm_field_native_base(slot_b);
        if addr_native_kind > 0 && addr_native_base != 0 as usize {
            const addr_offset: usize = ((instr.imm >> 32) as i32) as usize;
            // 定长数组字段在 C 里按下标访问时退化成「指向元素」：编译期把元素 kind
            // 放在 c 的 16..23 位，这里**只在基址确实是原生内存时**才覆盖 pointee。
            // VM 聚合结构（局部变量）走不到这里，语义不受影响。
            var addr_pointee_kind: i32 = instr.c & 0xFF;
            const addr_elem_kind: i32 = (instr.c >> 16) & 0xFF;
            if addr_elem_kind > 0 && (addr_native_kind - 1 == TypeKind.TYPE_ARRAY as i32 ||
                addr_native_kind - 1 == TypeKind.TYPE_SLICE as i32) {
                addr_pointee_kind = addr_elem_kind;
            }
            slot_a[0] = exec_make_pointer_with_kind(addr_native_base +| addr_offset, addr_pointee_kind);
            frame.ip = frame.ip + 1;
            return 0;
        }
        const field_ref: &ExecValue = exec_vm_field_ref(slot_b, instr.imm as i32);
        if field_ref == null {
            exec_backend_set_error(function.decl, "exec: ADDR_FIELD 字段越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_vm_make_value_ref(field_ref, instr.c & 0xFF);
    } else if instr.opcode == BCOpcode.BC_ADDR_INDEX {
        if slot_a == null || slot_b == null || slot_c == null {
            exec_backend_set_error(function.decl, "exec: ADDR_INDEX 槽位越界" as *byte, 0);
            return -1;
        }
        var handled_raw_addr: i32 = 0;
        if exec_value_is_raw_array(slot_b) != 0 {
            const raw_ptr_value: ExecValue = exec_vm_raw_array_element_ptr(slot_b, slot_c.i64_value as i32);
            if raw_ptr_value.kind != ExecValueKind.EXEC_VALUE_POINTER {
                exec_backend_set_error(function.decl, "exec: ADDR_INDEX 越界" as *byte, 0);
                return -1;
            }
            slot_a[0] = raw_ptr_value;
            handled_raw_addr = 1;
        } else if exec_value_is_raw_slice(slot_b) != 0 {
            const raw_slice_ptr_value: ExecValue = exec_vm_raw_slice_element_ptr(slot_b, slot_c.i64_value as i32, 0);
            if raw_slice_ptr_value.kind != ExecValueKind.EXEC_VALUE_POINTER {
                exec_backend_set_error(function.decl, "exec: ADDR_INDEX 越界" as *byte, 0);
                return -1;
            }
            slot_a[0] = raw_slice_ptr_value;
            handled_raw_addr = 1;
        } else if slot_b.kind == ExecValueKind.EXEC_VALUE_STRING {
            // `&"abc"[i]` / `&GREETING[i]`：字符串常量的数据指针在 i64_value 里。
            const str_base: usize = slot_b.i64_value as usize;
            const str_index: i64 = slot_c.i64_value;
            if str_base != 0 && str_index >= 0 {
                slot_a[0] = exec_make_pointer_with_kind(str_base +| (str_index as usize), TypeKind.TYPE_BYTE as i32);
                handled_raw_addr = 1;
            }
        } else if slot_b.kind == ExecValueKind.EXEC_VALUE_POINTER &&
            exec_vm_pointer_is_internal_ref(slot_b) == 0 {
            // 原生指针算术：`&p[i]` 就是 `p + i * elem_size`（`slice.ptr` / `@ptr_from_usize` 来的指针）。
            const plain_elem_ptr: ExecValue = exec_vm_pointer_element_ptr(function, slot_b[0], slot_c.i64_value,
                (instr.imm >> 32) as usize);
            if plain_elem_ptr.kind == ExecValueKind.EXEC_VALUE_POINTER {
                slot_a[0] = plain_elem_ptr;
                handled_raw_addr = 1;
            }
        } else if exec_vm_pointer_is_internal_ref(slot_b) != 0 {
            const base_target: &ExecValue = exec_vm_ref_target_value(slot_b);
            if exec_value_is_raw_array(base_target) != 0 {
                const raw_ptr_value2: ExecValue = exec_vm_raw_array_element_ptr(base_target, slot_c.i64_value as i32);
                if raw_ptr_value2.kind != ExecValueKind.EXEC_VALUE_POINTER {
                    exec_backend_set_error(function.decl, "exec: ADDR_INDEX 越界" as *byte, 0);
                    return -1;
                }
                slot_a[0] = raw_ptr_value2;
                handled_raw_addr = 1;
            } else if exec_value_is_raw_slice(base_target) != 0 {
                const raw_slice_ptr_value2: ExecValue = exec_vm_raw_slice_element_ptr(base_target, slot_c.i64_value as i32, 0);
                if raw_slice_ptr_value2.kind != ExecValueKind.EXEC_VALUE_POINTER {
                    exec_backend_set_error(function.decl, "exec: ADDR_INDEX 越界" as *byte, 0);
                    return -1;
                }
                slot_a[0] = raw_slice_ptr_value2;
                handled_raw_addr = 1;
            } else if exec_value_is_pointer_like(base_target[0]) != 0 {
                const ptr_index_value: ExecValue = exec_vm_pointer_element_ptr(function, base_target[0], slot_c.i64_value,
                    (instr.imm >> 32) as usize);
                if ptr_index_value.kind != ExecValueKind.EXEC_VALUE_POINTER {
                    return -1;
                }
                slot_a[0] = ptr_index_value;
                handled_raw_addr = 1;
            }
        }
        if handled_raw_addr == 0 {
