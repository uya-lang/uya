        const sw_set: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const sw_sig: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        var sw_mask: i64 = 0;
        const sw_set_target: &ExecValue = exec_vm_ref_target_value(sw_set);
        if sw_set_target != null {
            const sw_set_agg: &ExecAggregate = exec_value_as_aggregate(sw_set_target);
            if sw_set_agg != null && sw_set_agg.values != null && sw_set_agg.count > 0 {
                sw_mask = exec_vm_numeric_to_i64(sw_set_agg.values[0]);
            }
        }
        var sw_buf: [i64: 1] = [sw_mask];
        var sw_wait: [i64: 2] = [0i64, 0i64];
