            const set_agg: &ExecAggregate = exec_value_as_aggregate(set_target);
            if set_agg != null && set_agg.values != null && set_agg.count > 0 {
                mask_new = exec_vm_numeric_to_i64(set_agg.values[0]);
            }
        }
        var mask_old: i64 = 0;
        const sig_rc: i64 = exec_vm_rt_sigprocmask(how_value, mask_new, &mask_old,
            set_target != null);
        const old_target: &ExecValue = exec_vm_ref_target_value(old_slot);
        if old_target != null {
            const old_agg: &ExecAggregate = exec_value_as_aggregate(old_target);
            if old_agg != null && old_agg.values != null && old_agg.count > 0 {
                old_agg.values[0] = exec_make_u64(mask_old as u64);
            }
        }
        out_value[0] = exec_make_i32(sig_rc as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_SIGWAIT {
        // `sigwait(set, &signo)`：从挂起信号里取一个并消费掉。
        //
        // 用 `rt_sigtimedwait`（128 号）加全零 timeout 实现：调用点已经先
        // `sigpending` + `sigismember` 确认过目标信号是挂起的，所以这里不会
        // 阻塞；万一没挂起也只是返回 EAGAIN，绝不会把解释器卡死。
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: sigwait 参数数量非法" as *byte, 0);
            return -1;
        }
        const sw_set: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const sw_sig: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        var sw_mask: i64 = 0;
        const sw_set_target: &ExecValue = exec_vm_ref_target_value(sw_set);
        if sw_set_target != null {
            const sw_set_agg: &ExecAggregate = exec_value_as_aggregate(sw_set_target);
            if sw_set_agg != null && sw_set_agg.values != null && sw_set_agg.count > 0 {
                sw_mask = exec_vm_numeric_to_i64(sw_set_agg.values[0]);
            }
        }
        var sw_buf: [i64: 1] = [sw_mask];
        var sw_wait: [i64: 2] = [0i64, 0i64];
        const sw_raw: !i64 = @syscall(128i64,
            @usize_from_ptr(&sw_buf[0] as &void) as i64, 0i64,
            @usize_from_ptr(&sw_wait[0] as &void) as i64, 8i64);
        const sw_rc: i64 = sw_raw catch { return -1; };
        if sw_rc > 0i64 {
            const sw_out_target: &ExecValue = exec_vm_ref_target_value(sw_sig);
            if sw_out_target != null {
                const sw_out_agg: &ExecAggregate = exec_value_as_aggregate(sw_out_target);
                if sw_out_agg != null && sw_out_agg.values != null && sw_out_agg.count > 0 {
                    sw_out_agg.values[0] = exec_make_i32(sw_rc as i32);
                } else {
                    sw_out_target[0] = exec_make_i32(sw_rc as i32);
                }
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        out_value[0] = exec_make_i32(sw_rc as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_INTERFACE_GET_VTABLE {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: uya_interface_get_vtable 参数数量非法" as *byte, 0);
            return -1;
        }
        const iface_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if iface_arg == null {
            exec_backend_set_error(function.decl, "exec: uya_interface_get_vtable 参数槽位非法" as *byte, 0);
            return -1;
        }
        var vtable_addr: usize = 0 as usize;
        if iface_arg.kind == ExecValueKind.EXEC_VALUE_STRUCT {
            const iface_agg: &ExecAggregate = exec_value_as_aggregate(&iface_arg[0]);
            if iface_agg != null && iface_agg.values != null && iface_agg.count > 0 {
                vtable_addr = @usize_from_ptr(&iface_agg.values[0] as &void);
            }
        }
        out_value[0] = exec_make_pointer_with_kind(vtable_addr, TypeKind.TYPE_VOID as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_LOAD_N {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: __atomic_load_n 参数数量非法" as *byte, 0);
            return -1;
        }
        return exec_vm_atomic_update(function, frame, arg_base, 0, 0, out_value);
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_EXCHANGE_N {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: __atomic_exchange_n 参数数量非法" as *byte, 0);
            return -1;
        }
        return exec_vm_atomic_update(function, frame, arg_base, 3, 0, out_value);
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_ADD_FETCH {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: __atomic_add_fetch 参数数量非法" as *byte, 0);
            return -1;
        }
        return exec_vm_atomic_update(function, frame, arg_base, 1, 1, out_value);
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FETCH_ADD {
        return exec_vm_atomic_update(function, frame, arg_base, 1, 0, out_value);
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FETCH_SUB {
        return exec_vm_atomic_update(function, frame, arg_base, 2, 0, out_value);
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_STORE_N {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: __atomic_store_n 参数数量非法" as *byte, 0);
            return -1;
        }
        const store_ptr: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const store_val: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if store_ptr == null || store_val == null {
            exec_backend_set_error(function.decl, "exec: __atomic_store_n 参数槽位非法" as *byte, 0);
            return -1;
        }
        const store_kind: i32 = exec_value_pointer_pointee_kind(&store_ptr[0]);
        const store_cast: ExecValue = exec_vm_cast_value(store_val[0], store_kind, 0);
        if exec_vm_pointer_store_value(function, store_ptr, store_cast) != 0 {
            return -1;
        }
        out_value[0] = exec_make_void();
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FENCE {
        // 解释器单线程执行，栅栏只需占位。
        out_value[0] = exec_make_void();
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MALLOC || site.id == ExecHostCallId.EXEC_HOST_CALL_CALLOC {
        const want_one_arg: i32 = (site.id == ExecHostCallId.EXEC_HOST_CALL_MALLOC) as i32;
        if arg_count != 1 && want_one_arg != 0 {
            exec_backend_set_error(function.decl, "exec: malloc 参数数量非法" as *byte, 0);
            return -1;
        }
        if arg_count != 2 && want_one_arg == 0 {
            exec_backend_set_error(function.decl, "exec: calloc 参数数量非法" as *byte, 0);
            return -1;
        }
        const alloc_first: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if alloc_first == null {
            exec_backend_set_error(function.decl, "exec: 分配参数槽位非法" as *byte, 0);
            return -1;
        }
        var alloc_total: usize = alloc_first.i64_value as usize;
        if want_one_arg == 0 {
            const alloc_second: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
            if alloc_second == null {
                exec_backend_set_error(function.decl, "exec: calloc 参数槽位非法" as *byte, 0);
                return -1;
            }
            const alloc_count: usize = alloc_second.i64_value as usize;
            if alloc_count > 0 as usize && alloc_total > 0 as usize &&
                alloc_total < (1073741824 as usize) / alloc_count {
                alloc_total = alloc_total * alloc_count;
            } else {
                alloc_total = 0 as usize;
            }
        }
        var alloc_block: &byte = null;
        if alloc_total > 0 as usize {
            if want_one_arg == 0 {
                alloc_block = calloc(alloc_total, 1 as usize) as &byte;
            } else {
                alloc_block = malloc(alloc_total) as &byte;
            }
        }
        exec_vm_alloc_track(frame.vm, @usize_from_ptr(alloc_block as &void), alloc_total);
        out_value[0] = exec_make_pointer_with_kind(@usize_from_ptr(alloc_block as &void), TypeKind.TYPE_VOID as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_REALLOC {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: realloc 参数数量非法" as *byte, 0);
            return -1;
        }
        const realloc_ptr: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const realloc_size: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if realloc_ptr == null || realloc_size == null {
            exec_backend_set_error(function.decl, "exec: realloc 参数槽位非法" as *byte, 0);
            return -1;
        }
        const realloc_bytes: usize = realloc_size.i64_value as usize;
        // 只 realloc 解释器分配过的块；别人的地址原样忽略（返回 null），
        // 否则宿主堆会被 realloc 的原地搬移写坏。
        var realloc_block: &byte = null;
        if exec_vm_alloc_untrack(frame.vm, @usize_from_ptr(realloc_ptr.ptr_value as &void)) != 0 {
            const realloc_old_addr: usize = @usize_from_ptr(realloc_ptr.ptr_value as &void);
            realloc_block = realloc(realloc_ptr.ptr_value as &void, realloc_bytes) as &byte;
            exec_vm_alloc_track(frame.vm, @usize_from_ptr(realloc_block as &void), realloc_bytes);
            exec_vm_native_agg_rebase(frame.vm, realloc_old_addr, @usize_from_ptr(realloc_block as &void));
        }
        out_value[0] = exec_make_pointer_with_kind(@usize_from_ptr(realloc_block as &void), TypeKind.TYPE_VOID as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_FREE {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: free 参数数量非法" as *byte, 0);
            return -1;
        }
        const free_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if free_arg == null {
            exec_backend_set_error(function.decl, "exec: free 参数槽位非法" as *byte, 0);
            return -1;
        }
        if free_arg.ptr_value != null &&
            exec_vm_alloc_untrack(frame.vm, @usize_from_ptr(free_arg.ptr_value as &void)) != 0 {
            exec_vm_native_agg_forget(frame.vm, @usize_from_ptr(free_arg.ptr_value as &void));
            free(free_arg.ptr_value as &void);
        }
        out_value[0] = exec_make_void();
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MEMCMP {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: memcmp 参数数量非法" as *byte, 0);
            return -1;
        }
        const cmp_a: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const cmp_b: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const cmp_n: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if cmp_a == null || cmp_b == null || cmp_n == null {
            exec_backend_set_error(function.decl, "exec: memcmp 参数槽位非法" as *byte, 0);
            return -1;
        }
        const cmp_count: usize = cmp_n.i64_value as usize;
        const cmp_ap: &byte = cmp_a.ptr_value;
        const cmp_bp: &byte = cmp_b.ptr_value;
        var cmp_result: i32 = 0;
        var ci: usize = 0;
        while ci < cmp_count && cmp_result == 0 && cmp_ap != null && cmp_bp != null {
            const cmp_lb: byte = cmp_ap[ci];
            const cmp_rb: byte = cmp_bp[ci];
            if cmp_lb < cmp_rb {
                cmp_result = -1;
            } else if cmp_lb > cmp_rb {
                cmp_result = 1;
            }
            ci = ci + 1;
        }
        out_value[0] = exec_make_i32(cmp_result);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MEMCHR {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: memchr 参数数量非法" as *byte, 0);
            return -1;
        }
        const mch_a: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const mch_byte: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const mch_n: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if mch_a == null || mch_byte == null || mch_n == null {
            exec_backend_set_error(function.decl, "exec: memchr 参数槽位非法" as *byte, 0);
            return -1;
        }
        const mch_count: usize = mch_n.i64_value as usize;
        const mch_target: byte = mch_byte.i64_value as byte;
        const mch_base: &byte = mch_a.ptr_value;
        var mch_hit: &byte = null;
        if mch_base != null {
            var mchi: usize = 0;
            while mchi < mch_count {
                if mch_base[mchi] == mch_target {
                    mch_hit = mch_base + mchi;
                    mchi = mch_count;
                } else {
                    mchi = mchi + 1;
                }
            }
        }
        out_value[0] = exec_make_pointer_with_kind(mch_hit as usize, TypeKind.TYPE_BYTE as i32);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_STRLEN {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: strlen 参数数量非法" as *byte, 0);
            return -1;
        }
        const len_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if len_arg == null {
            exec_backend_set_error(function.decl, "exec: strlen 参数槽位非法" as *byte, 0);
            return -1;
        }
        const len_ptr: &byte = len_arg.ptr_value;
        var len_count: usize = 0;
        while len_ptr != null && len_ptr[len_count] != 0 as byte {
            len_count = len_count + 1;
