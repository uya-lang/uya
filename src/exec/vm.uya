    } else if instr.opcode == BCOpcode.BC_MAKE_OK {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: MAKE_OK 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_error_union_ok(slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_MAKE_ERR {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: MAKE_ERR 槽位越界" as *byte, 0);
            return -1;
        }
        var make_err_id: i64 = instr.imm;
        if make_err_id == 0 && slot_b != null {
            // `catch |err| { return err; }` 这类转发在编译期拿不到错误 id，
            // 只能取运行时错误值自带的 id；否则上游 catch 会看到 id=0。
            make_err_id = exec_vm_error_id_from_value(slot_b[0]);
        }
        slot_a[0] = exec_make_error_union_err(make_err_id as i32);
    } else if instr.opcode == BCOpcode.BC_IS_ERR {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: IS_ERR 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_bool(exec_value_is_error_union_err(slot_b[0]));
    } else if instr.opcode == BCOpcode.BC_UNWRAP_OK {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: UNWRAP_OK 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_is_error_union_err(slot_b[0]) != 0 {
            exec_backend_set_error(function.decl, "exec: UNWRAP_OK 遇到错误值" as *byte, 0);
            return -1;
        }
        // 不是错误联合的值本身就是载荷（宏展开体的 try 操作数可能直接是裸值）。
        if slot_b[0].kind == ExecValueKind.EXEC_VALUE_ERROR_UNION {
            slot_a[0] = exec_value_unwrap_ok(slot_b[0]);
        } else {
            slot_a[0] = slot_b[0];
        }
    } else if instr.opcode == BCOpcode.BC_UNWRAP_ERR {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: UNWRAP_ERR 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_is_error_union_err(slot_b[0]) == 0 {
            exec_backend_set_error(function.decl, "exec: UNWRAP_ERR 遇到成功值" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_value_unwrap_err(slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_ERROR_ID {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ERROR_ID 槽位越界" as *byte, 0);
            return -1;
        }
        // `@error_id` 的类型是 u32：必须零扩展，否则高位为 1 的错误 id
        // （如 error.NamedFailure = 3096688242）会变成负数，和常量比较恒不相等。
        slot_a[0] = exec_make_u32(exec_value_error_id(slot_b[0]) as u32);
    } else if instr.opcode == BCOpcode.BC_ERROR_NAME {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ERROR_NAME 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_string(exec_vm_lookup_error_name(program, exec_value_error_id(slot_b[0])));
    } else if instr.opcode == BCOpcode.BC_AWAIT {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: AWAIT 槽位越界" as *byte, 0);
            return -1;
        }
        // `@await f`：Future 只有 `state: Poll<T>` 一个字段；Poll 的 Ready 变体下标是 1
        // （`union Poll<T> { Pending: void, Ready: T }`）。
        // VM 里 async 函数同步执行到完成，所以这里只会见到 Ready。
        const poll_data: &ExecUnionData = exec_vm_await_find_poll(slot_b, 0);
        if poll_data != null && poll_data.tag == 1 {
            slot_a[0] = exec_value_clone(&poll_data.payload);
        } else if poll_data != null && poll_data.tag == 0 {
            // `state` 字段是 Pending。它可能只是**尚未 poll**：用户自己实现 poll 的
            // Future 常把 `state` 初始化成 Pending，真正的推进要靠它自己的 poll。
            // 对齐 C99（`await_fut.vtable->poll(await_fut.data, waker)`）：
            // 先真的 poll 一次；poll 不可用（不是接口形态）时才维持原来的挂起行为。
            var pending_awaited: ExecValue = exec_make_void();
            const pending_poll_rc: i32 = exec_vm_await_poll_interface_once(program, slot_b, &pending_awaited);
            if pending_poll_rc == 0 {
                slot_a[0] = pending_awaited;
                return 0;
            }
            if exec_vm_await_pass_through_pending(program, function, frame.slots, function.slot_count, slot_b, out_value) != 0 {
                return exec_vm_cont_suspend(program, function, frame, instr, out_value);
            }
            exec_backend_set_error(function.decl,
                "exec: @await 操作数始终 Pending，且当前函数不返回 Future" as *byte, 0);
            return -1;
        } else {
            // 自己实现 poll 的 Future：**先只 poll 一次**。
            // async 帧里 Pending 就是「挂起」，由调用方下次 poll 再推进；
            // 不在 async 帧里（没有 Future 可返回）才退回忙等，保持旧行为。
            var awaited: ExecValue = exec_make_void();
            var poll_rc: i32 = -1;
            if frame.vm.frame_resumed == 0 {
                // 状态机语义：**初次**走到这个 await 只挂起、不 poll。
                // （C99 后端把「构造 future」和「poll 它」分成两遍；
                //   测试里 p1 看到 Pending、p2 才看到 Ready 就是这个原因。）
                if exec_vm_await_pass_through_pending(program, function, frame.slots,
                        function.slot_count, slot_b, out_value) != 0 {
                    return exec_vm_cont_suspend(program, function, frame, instr, out_value);
                }
            } else {
                poll_rc = exec_vm_await_poll_interface_once(program, slot_b, &awaited);
            }
            if poll_rc == 1 &&
                exec_vm_await_pass_through_pending(program, function, frame.slots,
                    function.slot_count, slot_b, out_value) != 0 {
                return exec_vm_cont_suspend(program, function, frame, instr, out_value);
            }
            if poll_rc == 1 {
                poll_rc = exec_vm_await_poll_interface(program, slot_b, &awaited);
            }
            if poll_rc == 1 {
                // 忙等窗口内一直 Pending：同样挂起成续体。
                if exec_vm_await_pass_through_pending(program, function, frame.slots, function.slot_count, slot_b, out_value) != 0 {
                    return exec_vm_cont_suspend(program, function, frame, instr, out_value);
                }
                exec_backend_set_error(function.decl,
                    "exec: @await 操作数始终 Pending，且当前函数不返回 Future" as *byte, 0);
                return -1;
            }
            if poll_rc < 0 {
                // 内层（真正的 poll 调用）已经设过错误信息，别覆盖掉，
                // 否则这里只会看到「不是 Future」，查不到真实原因。
                return -1;
            }
            if poll_rc != 0 {
                exec_backend_set_error(function.decl,
                    "exec: @await 操作数不是 Future" as *byte, 0);
                return -1;
            }
            slot_a[0] = awaited;
        }
    } else if instr.opcode == BCOpcode.BC_JMP {
        exec_vm_trace_jump(trace_vm, function.name, frame.ip, instr.imm as i32, "jmp" as *byte);
        frame.ip = instr.imm as i32;
        return 0;
    } else if instr.opcode == BCOpcode.BC_JMP_IF_TRUE {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: JMP_IF_TRUE 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_truthy(slot_a[0]) != 0 {
            exec_vm_trace_jump(trace_vm, function.name, frame.ip, instr.imm as i32, "cond-true" as *byte);
            frame.ip = instr.imm as i32;
            return 0;
        }
    } else if instr.opcode == BCOpcode.BC_JMP_IF_FALSE {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: JMP_IF_FALSE 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_truthy(slot_a[0]) == 0 {
            exec_vm_trace_jump(trace_vm, function.name, frame.ip, instr.imm as i32, "cond-false" as *byte);
            frame.ip = instr.imm as i32;
            return 0;
        }
    } else if instr.opcode == BCOpcode.BC_CALL {
        const callee_idx: i32 = instr.imm as i32;
        if callee_idx < 0 || callee_idx >= program.function_count {
            exec_backend_set_error(function.decl, "exec: 无法找到被调用函数" as *byte, 0);
            return -1;
        }
        var call_args: [ExecValue: EXEC_MAX_CALL_ARGS] = [];
        var ai: i32 = 0;
        while ai < instr.c && ai < EXEC_MAX_CALL_ARGS {
            const arg_slot: &ExecValue = exec_vm_slot_ref(frame, instr.b + ai);
            if arg_slot == null {
                exec_backend_set_error(function.decl, "exec: CALL 参数槽位越界" as *byte, 0);
                return -1;
            }
            // 实参只借用（不深拷贝）：被调帧的槽位本来也是浅拷贝接收
            // （`frame.slots[si] = args[si]`），克隆一份纯属重复分配。
            call_args[ai] = exec_value_borrow_copy(arg_slot);
            ai = ai + 1;
        }
        var call_result: ExecValue = exec_make_void();
        if exec_vm_call_function(frame.vm, program, callee_idx, &call_args[0], instr.c, trace_vm, &call_result) < 0 {
            return -1;
        }
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: CALL 返回槽位越界" as *byte, 0);
            return -1;
        }
        // 调用的返回值只活在 `call_result` 这个临时里，直接移动进目标槽位。
        exec_vm_store_slot_move(slot_a, call_result);
    } else if instr.opcode == BCOpcode.BC_CALL_INDIRECT {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: CALL_INDIRECT 槽位越界" as *byte, 0);
            return -1;
        }
        const callee_idx2: i32 = slot_b.i64_value as i32;
        // 接口方法表里的负下标是「VM 续体处理」哨兵（见 EXEC_VM_CONT_POLL_INDEX）。
        var callee_is_cont: i32 = 0;
        if callee_idx2 == EXEC_VM_CONT_POLL_INDEX || callee_idx2 == EXEC_VM_CONT_RELEASE_INDEX {
            callee_is_cont = 1;
        }
        if callee_is_cont == 0 && (callee_idx2 < 0 || callee_idx2 >= program.function_count) {
            exec_backend_set_error(function.decl, "exec: CALL_INDIRECT 目标非法" as *byte, 0);
            return -1;
        }
        var call_args3: [ExecValue: EXEC_MAX_CALL_ARGS] = [];
        var ai3: i32 = 0;
        while ai3 < instr.imm as i32 && ai3 < EXEC_MAX_CALL_ARGS {
            const arg_slot3: &ExecValue = exec_vm_slot_ref(frame, instr.c + ai3);
            if arg_slot3 == null {
                exec_backend_set_error(function.decl, "exec: CALL_INDIRECT 参数槽位越界" as *byte, 0);
                return -1;
            }
            call_args3[ai3] = exec_value_borrow_copy(arg_slot3);
            ai3 = ai3 + 1;
        }
        var indirect_result: ExecValue = exec_make_void();
        if exec_vm_call_function(frame.vm, program, callee_idx2, &call_args3[0], instr.imm as i32, trace_vm, &indirect_result) < 0 {
            return -1;
        }
        exec_vm_store_slot(slot_a, indirect_result);
    } else if instr.opcode == BCOpcode.BC_HOSTCALL {
        const host_site: &BCHostCallSite = exec_vm_host_call_site_ref(program, instr.imm as i32);
        if host_site == null {
            exec_backend_set_error(function.decl, "exec: HOSTCALL 目标非法" as *byte, 0);
            return -1;
        }
        var host_result: ExecValue = exec_make_void();
        exec_vm_native_agg_lock_acquire();
        const host_rc: i32 = exec_vm_call_host(program, function, host_site, frame, instr.b, instr.c, &host_result);
        exec_vm_native_agg_lock_release();
        if host_rc != 0 {
            return -1;
        }
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: HOSTCALL 返回槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, host_result);
    } else if instr.opcode == BCOpcode.BC_SYSCALL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: SYSCALL 槽位越界" as *byte, 0);
            return -1;
        }
        var syscall_result: ExecValue = exec_make_void();
        if exec_vm_exec_syscall(function, frame, slot_b, instr.imm, &syscall_result) != 0 {
            return -1;
        }
        exec_vm_store_slot(slot_a, syscall_result);
    } else if instr.opcode == BCOpcode.BC_VA_START {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: VA_START 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_start(function, frame, slot_b) != 0 {
            return -1;
        }
        slot_a[0] = exec_make_void();
    } else if instr.opcode == BCOpcode.BC_VA_END {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: VA_END 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_end(function, slot_b) != 0 {
            return -1;
        }
        slot_a[0] = exec_make_void();
    } else if instr.opcode == BCOpcode.BC_VA_ARG {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: VA_ARG 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_arg(function, slot_b, instr.imm as i32, instr.c, slot_a) != 0 {
            return -1;
        }
    } else if instr.opcode == BCOpcode.BC_VA_COPY {
        if slot_a == null || slot_b == null || slot_c == null {
            exec_backend_set_error(function.decl, "exec: VA_COPY 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_copy(function, slot_b, slot_c) != 0 {
            return -1;
        }
        slot_a[0] = exec_make_void();
    } else if instr.opcode == BCOpcode.BC_PRINT {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: PRINT 槽位越界" as *byte, 0);
            return -1;
        }
        // `@print`/`@println` 的返回值是实际写出的字节数（含换行），
        // 和 C 的 printf 一致；写进 a 槽（临时槽）。
        slot_a[0] = exec_make_i32(exec_vm_print_value(slot_b[0], 0) as i32);
    } else if instr.opcode == BCOpcode.BC_STRING_INTERP {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 槽位越界" as *byte, 0);
            return -1;
        }
        const interp_count: i32 = instr.c;
        if interp_count < 0 || interp_count > 16 {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 实参数量非法" as *byte, 0);
            return -1;
        }
        var interp_args: [ExecValue: 16] = [];
        var interp_i: i32 = 0;
        while interp_i < interp_count {
            const interp_arg_ref: &ExecValue = exec_vm_slot_ref(frame, instr.b + interp_i);
            if interp_arg_ref == null {
                exec_backend_set_error(function.decl, "exec: STRING_INTERP 实参槽位越界" as *byte, 0);
                return -1;
            }
            interp_args[interp_i] = exec_vm_interp_string_arg(interp_arg_ref[0]);
            interp_i = interp_i + 1;
        }
        var interp_buf: ExecFormatBuffer = ExecFormatBuffer {
            data: null,
            len: 0 as usize,
            cap: 0 as usize,
        };
        if exec_format_buffer_init(&interp_buf) == 0 {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 缓冲分配失败" as *byte, 0);
            return -1;
        }
        if exec_format_render(instr.text, &interp_args[0], interp_count, &interp_buf) == 0 {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 渲染失败" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_string(interp_buf.data);
    } else if instr.opcode == BCOpcode.BC_PRINTLN {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: PRINTLN 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_i32(exec_vm_print_value(slot_b[0], 1) as i32);
    } else if instr.opcode == BCOpcode.BC_RET {
        if instr.a >= 0 {
            if slot_a == null {
                exec_backend_set_error(function.decl, "exec: RET 槽位越界" as *byte, 0);
                return -1;
            }
            // 返回值直接**移动**：返回后本帧就作废了，槽位里的聚合内存不会再有
            // 第二个持有者。原来这里深拷贝一次，是自举时最大的一处聚合垃圾源
            // （BC_RET 占聚合分配次数的 43%）。
            // 返回值**移动**（第 745 轮）：返回后本帧作废，槽位里的聚合内存
            // 不会再有第二个持有者。注意：这与「帧出栈回收聚合」是互斥的两套
            // 优化 —— 回收默认关（见 `exec_agg_gc_enabled`），所以这里保留移动。
            const ret_value: ExecValue = slot_a[0];
            // 所有权移交后清空源槽位，避免将来开回收时重复计数。
            slot_a[0] = exec_make_void();
            out_value[0] = exec_vm_relocate_escaped_box(program, frame.slots,
                function.slot_count, ret_value);
        } else {
            out_value[0] = exec_make_void();
        }
        return 1;
    } else {
        exec_backend_set_error(function.decl, "exec: 未知 bytecode opcode" as *byte, 0);
        return -1;
    }
    frame.ip = frame.ip + 1;
    return 0;
}

/// 挂起续体在接口方法表里的哨兵下标。
///
/// 接口值在 VM 里是 `[方法入口下标…, 数据]`，方法调用走 `BC_CALL_INDIRECT`，
/// 被调下标直接取自第 0 格。真实函数下标恒为非负，所以负值可以安全地征用成
/// 「VM 续体处理」的入口，不需要伪造 `BCFunction`。
const EXEC_VM_CONT_POLL_INDEX: i32 = -100000;
const EXEC_VM_CONT_RELEASE_INDEX: i32 = -100001;
/// 同时存活的续体上限（超了就报错，不静默退化）。







/// 当前正在执行的帧是不是「续体恢复」进来的。
///
/// `@await` 用它区分状态机语义：**初始进入的一遍不 poll**，只挂起；
/// 恢复的那一遍才对这个 await poll 一次（Ready 后在同一次 pass 里继续下一个 await）。
/// `run_frame` 进出时保存/恢复，保证嵌套调用各自独立。

/// 当前续体 poll 拿到的 waker 指针（`Waker` 的地址），供 `@await` 往下转发。
///
/// 不转发的话每层 await 都会新建一个空 waker：下层 leaf future 把 IO 兴趣
/// 注册在那个空 waker 上，调用方手里的 waker 永远看不到
/// （`wk.has_io_interest()` 恒为 0、取消也传不下来）。



/// 把值里「指向 `[from_base, from_limit)`」的内部引用按同一偏移搬到 `to_base`。
///
/// 帧挂起时槽位要整段拷到堆上，槽位之间互相取址（`&self.field`、`&local`）
/// 必须跟着改基址，否则恢复后就是悬垂引用。恢复时反向再用一次。
///
/// 参数：`value` 待改写的值（就地）；`from_base`/`from_limit` 旧的槽段区间；
///       `to_base` 新的槽段基址。
/// 返回值：无。
fn exec_vm_cont_remap_refs(value: &ExecValue, from_base: usize, from_limit: usize, to_base: usize) void {
    if value == null {
        return;
    }
    if exec_vm_pointer_is_internal_ref(value) != 0 {
        const addr: usize = exec_vm_pointer_address(value);
        if addr >= from_base && addr < from_limit {
            const offset: usize = addr -| from_base;
            value[0] = exec_make_pointer_with_kind(to_base +| offset, value.aux_i64_value as i32);
        }
        return;
    }
    const agg: &ExecAggregate = exec_value_as_aggregate(value);
    if agg != null && agg.values != null && agg.count > 0 {
        var i: i32 = 0;
        while i < agg.count {
            exec_vm_cont_remap_refs(&agg.values[i], from_base, from_limit, to_base);
            i = i +| 1;
        }
        return;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_UNION {
        const union_data: &ExecUnionData = exec_value_as_union(value);
        if union_data != null {
            exec_vm_cont_remap_refs(&union_data.payload, from_base, from_limit, to_base);
        }
    }
}

/// 把**其它**活跃续体槽位里指向 `[from_base, from_limit)` 的内部引用改指到 `to_base`。
///
/// 快照/恢复时本帧槽段会换地址（快照后原槽段立即释放），别的续体手里指向它的
/// 内部引用必须先跟着搬，否则恢复后就是悬垂引用 —— 那块内存会被后来的续体盒子
/// （3 字段聚合）复用，表现为 `LOAD_FIELD 字段越界(... count=3 ...)`。
fn exec_vm_cont_remap_blocks(skip_block: &ExecValue, from_base: usize, from_limit: usize,
        to_base: usize) void {
    var h: i32 = 0;
    while h < EXEC_VM_CONT_MAX {
        const other: &ExecValue = exec_vm_main_vm().cont_slots[h];
        if other != null && other != skip_block && exec_vm_main_vm().cont_used[h] != 0 {
            var si: i32 = 0;
            const cnt: i32 = exec_vm_main_vm().cont_slot_count[h];
            while si < cnt {
                exec_vm_cont_remap_refs(&other[si], from_base, from_limit, to_base);
                si = si + 1;
            }
        }
        h = h + 1;
    }
}

/// 分配一个续体下标；表满返回 -1。
/// 返回值：续体下标；失败返回 -1。
fn exec_vm_cont_alloc() i32 {
    var i: i32 = 0;
    while i < EXEC_VM_CONT_MAX {
        if exec_vm_main_vm().cont_used[i] == 0 {
            exec_vm_main_vm().cont_used[i] = 1;
            exec_vm_main_vm().cont_slots[i] = null;
            exec_vm_main_vm().cont_slot_count[i] = 0;
            // 复用槽位时必须清掉上一个续体留下的完成态和结果，否则新续体
            // 会被误判成「已完成」并交回别人的结果。
            if exec_vm_main_vm().cont_done[i] != 0 {
                exec_vm_main_vm().cont_result[i] = exec_make_void();
                exec_vm_main_vm().cont_done[i] = 0;
            }
            return i;
        }
        i = i +| 1;
    }
    return -1;
}

/// 释放续体（连同它的槽位快照）。
/// 参数：`handle` 续体下标（越界时静默返回）。
/// 返回值：无。
fn exec_vm_cont_release(handle: i32) void {
    if handle < 0 || handle >= EXEC_VM_CONT_MAX {
        return;
    }
    const old_slots: &ExecValue = exec_vm_main_vm().cont_slots[handle];
    if old_slots != null {
        free(old_slots as &void);
        exec_vm_main_vm().cont_slots[handle] = null;
    }
    exec_vm_main_vm().cont_used[handle] = 0;
    exec_vm_main_vm().cont_slot_count[handle] = 0;
    exec_vm_main_vm().cont_fn[handle] = -1;
    exec_vm_main_vm().cont_ip[handle] = 0;
    exec_vm_main_vm().cont_dest[handle] = -1;
}

/// 按指针相等找出 `function` 在程序函数表里的下标。
/// 参数：`program` 程序；`function` 函数指针。
/// 返回值：下标；找不到返回 -1。
fn exec_vm_function_index_of(program: &BCProgram, function: &BCFunction) i32 {
    if program == null || function == null {
        return -1;
    }
    const want: usize = @usize_from_ptr(function as &void);
    var i: i32 = 0;
    while i < program.function_count {
        const cur: usize = @usize_from_ptr((program.functions + i) as &void);
        if cur == want {
            return i;
        }
        i = i +| 1;
    }
    return -1;
}

/// 把当前帧整段快照进续体 `handle`。
///
/// 参数：`program` 程序；`function` 当前函数；`frame` 当前帧；
///       `resume_ip` 恢复后从哪条指令开始（`@await` 的操作数求值起点）；
///       `dest_slot` 等待结果写回的槽位；`handle` 目标续体。
/// 返回值：0 成功；-1 失败（函数表里找不到 / 槽位数非法 / 内存不足）。
fn exec_vm_cont_snapshot(program: &BCProgram, function: &BCFunction, frame: &ExecFrame,
    resume_ip: i32, dest_slot: i32, handle: i32) i32 {
    if program == null || function == null || frame == null || frame.slots == null {
        return -1;
    }
    if handle < 0 || handle >= EXEC_VM_CONT_MAX {
        return -1;
    }
    const fn_index: i32 = exec_vm_function_index_of(program, function);
    if fn_index < 0 {
        exec_backend_set_error(function.decl, "exec: 续体找不到所属函数" as *byte, 0);
        return -1;
    }
    const count: i32 = function.slot_count;
    if count <= 0 || count > EXEC_MAX_FRAME_SLOTS || resume_ip < 0 {
        return -1;
    }
    const old_slots: &ExecValue = frame.vm.cont_slots[handle];
    if old_slots != null {
        free(old_slots as &void);
        frame.vm.cont_slots[handle] = null;
    }
    const block: &ExecValue = malloc(@size_of(ExecValue) as usize * count as usize) as &ExecValue;
    if block == null {
        exec_backend_set_error(function.decl, "exec: 续体槽位快照分配失败" as *byte, 0);
        return -1;
    }
    var i: i32 = 0;
    while i < count {
        if exec_value_is_raw_array(&frame.slots[i]) != 0 {
            block[i] = frame.slots[i];
        } else {
            block[i] = exec_value_clone(&frame.slots[i]);
        }
        i = i +| 1;
    }
    const from_base: usize = @usize_from_ptr(frame.slots as &void);
    const from_limit: usize = from_base +| (@size_of(ExecValue) as usize * count as usize);
    const to_base: usize = @usize_from_ptr(block as &void);
    i = 0;
    while i < count {
        exec_vm_cont_remap_refs(&block[i], from_base, from_limit, to_base);
        i = i +| 1;
    }
    exec_vm_cont_remap_blocks(block, from_base, from_limit, to_base);
    frame.vm.cont_slots[handle] = block;
    frame.vm.cont_slot_count[handle] = count;
    frame.vm.cont_fn[handle] = fn_index;
    frame.vm.cont_ip[handle] = resume_ip;
    frame.vm.cont_dest[handle] = dest_slot;
    frame.vm.cont_used[handle] = 1;
    return 0;
}

/// 构造续体接口值 `[poll 入口, release 入口, handle]`。
/// 参数：`handle` 续体下标。
/// 返回值：接口形态的聚合值。
fn exec_vm_make_cont_box(handle: i32) ExecValue {
    const box: ExecValue = exec_value_make_aggregate(ExecValueKind.EXEC_VALUE_STRUCT, 3);
    const agg: &ExecAggregate = exec_value_as_aggregate(&box);
    if agg == null || agg.values == null {
        return exec_make_void();
    }
    agg.values[0] = exec_make_i32(EXEC_VM_CONT_POLL_INDEX);
    agg.values[1] = exec_make_i32(EXEC_VM_CONT_RELEASE_INDEX);
    agg.values[2] = exec_make_i32(handle);
    return box;
}

/// 从续体接口值里取 handle。
/// 参数：`box` 续体接口值。
/// 返回值：handle；形态不对返回 -1。
fn exec_vm_cont_handle_of(box: &ExecValue) i32 {
    if box == null {
        return -1;
    }
    // 接口方法分派把**数据格**当 `self` 传进来：我们的 box 数据格就是 handle。
    if exec_vm_value_kind_is_integer(box.kind) != 0 {
        return box.i64_value as i32;
    }
    if box.kind == ExecValueKind.EXEC_VALUE_POINTER && box.ptr_value != null {
        const target: &ExecValue = box.ptr_value as &ExecValue;
        if target != null && exec_vm_value_kind_is_integer(target.kind) != 0 {
            return target.i64_value as i32;
        }
    }
    const agg: &ExecAggregate = exec_value_as_aggregate(box);
    if agg == null || agg.values == null || agg.count < 1 {
        return -1;
    }
    return exec_vm_cont_handle_of(&agg.values[agg.count - 1]);
}

/// 把 `from` 续体的状态搬到 `to` 上，让调用方手里的旧 box 继续有效。
///
/// 恢复执行时可能在中途又挂起一次，那时 `vm_step` 分配的是**新** handle；
/// 但外部持有的是旧 box，所以这里做一次状态迁移。
///
/// 参数：`from` 新续体下标；`to` 旧续体下标。
/// 返回值：无。
fn exec_vm_cont_migrate(from: i32, to: i32) void {
    if from < 0 || to < 0 || from >= EXEC_VM_CONT_MAX || to >= EXEC_VM_CONT_MAX || from == to {
        return;
    }
    const old_slots: &ExecValue = exec_vm_main_vm().cont_slots[to];
    if old_slots != null {
        free(old_slots as &void);
    }
    exec_vm_main_vm().cont_fn[to] = exec_vm_main_vm().cont_fn[from];
    exec_vm_main_vm().cont_ip[to] = exec_vm_main_vm().cont_ip[from];
    exec_vm_main_vm().cont_dest[to] = exec_vm_main_vm().cont_dest[from];
    exec_vm_main_vm().cont_slot_count[to] = exec_vm_main_vm().cont_slot_count[from];
    exec_vm_main_vm().cont_slots[to] = exec_vm_main_vm().cont_slots[from];
    exec_vm_main_vm().cont_used[to] = 1;
    // `from` 的内存所有权已经转移，只把表项清空，不能再 free。
    exec_vm_main_vm().cont_slots[from] = null;
    exec_vm_main_vm().cont_slot_count[from] = 0;
    exec_vm_main_vm().cont_used[from] = 0;
}

/// `@await` 命中 Pending：把当前帧快照成续体，作为「函数返回值」交回调用方。
///
/// 参数：`program` 程序；`function` 当前函数；`frame` 当前帧；
///       `instr` 触发挂起的 `BC_AWAIT`（`imm` 是操作数求值起点）；
///       `out_value` 承载续体 box 的返回值槽。
/// 返回值：1 表示帧已挂起（调用方应按「返回值」处理）。
fn exec_vm_cont_suspend(program: &BCProgram, function: &BCFunction, frame: &ExecFrame,
    instr: &BCInstr, out_value: &ExecValue) i32 {
    if program == null || function == null || frame == null || instr == null || out_value == null {
        return -1;
    }
    const handle: i32 = exec_vm_cont_alloc();
    if handle < 0 {
        exec_backend_set_error(function.decl, "exec: async 续体表已满" as *byte, 0);
        return -1;
    }
    // 恢复点就是这条 `BC_AWAIT` 自己：恢复后重新 poll 同一个 Future 对象
    // （对象状态存在帧槽位里，快照已经把槽位连引用一起搬过去了）。
    // 这正是 C99 后端的分段状态机语义 —— `FlipPending{polled:0}` 这类
    // 「靠自身状态翻转」的 Future 只有重 poll 同一个对象才会推进。
    if exec_vm_cont_snapshot(program, function, frame, frame.ip, instr.a, handle) != 0 {
        exec_vm_cont_release(handle);
        return -1;
    }
    out_value[0] = exec_vm_make_cont_box(handle);
    // 2 = 「已挂起」：`vm_step` 的调用方据此区分「正常返回（1）」与「挂起」。
    return 2;
}

/// 续体 `poll`：恢复挂起的 async 帧，跑到「返回」或「再次挂起」。
///
/// 恢复点是 `BC_AWAIT` 记录的操作数求值起点，所以每次 poll 都会**重跑**
/// `@await expr` 的 `expr` —— 这正是 C99 后端分段状态机的语义
/// （`@await flip_pending()` 这种「每次调用返回新对象」的写法只有这样才能推进）。
///
/// 参数：`program` 程序；`args` 调用实参（`args[0]` 的数据格是续体 handle）；
///       `arg_count` 实参个数；`out_value` 承载 `Poll<T>`。
/// 返回值：0 成功（Ready 或 Pending 都算成功）；-1 运行时错误。
fn exec_vm_cont_poll(program: &BCProgram, args: &ExecValue, arg_count: i32,
    out_value: &ExecValue) i32 {
    if program == null || out_value == null {
        return -1;
    }
    var handle: i32 = -1;
    if args != null && arg_count >= 1 {
        handle = exec_vm_cont_handle_of(&args[0]);
    }
    if handle < 0 || handle >= EXEC_VM_CONT_MAX || exec_vm_main_vm().cont_used[handle] == 0 {
        // 已经完成过的续体：重复 poll 必须返回同一个 Ready。
        // 接口契约里 poll 是幂等的，C99 侧（把 future 存在状态机字段里、
        // 每次都走 vtable poll）天然满足；VM 侧续体在完成时会被 release，
        // 若不在这里把结果留下，第二次 poll 就会错误地返回 Pending，
        // 导致「明明 Ready 过的 future 永远不再 Ready」。
        if handle >= 0 && handle < EXEC_VM_CONT_MAX && exec_vm_main_vm().cont_done[handle] != 0 {
            out_value[0] = exec_make_union(1, exec_value_clone(&exec_vm_main_vm().cont_result[handle]));
            return 0;
        }
        out_value[0] = exec_make_union(0, exec_make_void());
        return 0;
    }
    const fn_index: i32 = exec_vm_main_vm().cont_fn[handle];
    if fn_index < 0 || fn_index >= program.function_count {
        exec_backend_set_error(null, "exec: 续体函数下标非法" as *byte, 0);
        return -1;
    }
    const function: &BCFunction = program.functions + fn_index;
    const snapshot: &ExecValue = exec_vm_main_vm().cont_slots[handle];
    if snapshot == null {
        out_value[0] = exec_make_union(0, exec_make_void());
        return 0;
    }
    const base: i32 = exec_vm_slot_pool_push(exec_vm_main_vm(), function.slot_count);
    if base < 0 {
        exec_backend_set_error(function.decl, "exec: 续体恢复时槽位栈不足" as *byte, 0);
        return -1;
    }
    var resumed: ExecValue = exec_make_void();
    // 把本次 poll 的 waker 记下来，`@await` 往下转发时用它。
    const saved_waker_addr: usize = exec_vm_main_vm().await_waker_addr;
    const saved_waker_kind: i32 = exec_vm_main_vm().await_waker_kind;
    if args != null && arg_count >= 2 && args[1].kind == ExecValueKind.EXEC_VALUE_POINTER {
        exec_vm_main_vm().await_waker_addr = exec_vm_pointer_address(&args[1]);
        exec_vm_main_vm().await_waker_kind = args[1].aux_i64_value as i32;
    } else {
        exec_vm_main_vm().await_waker_addr = 0 as usize;
        exec_vm_main_vm().await_waker_kind = 0;
    }
    const rc: i32 = exec_vm_run_frame(exec_vm_main_vm(), program, function, null as &ExecValue, 0, 0, &resumed, base,
        snapshot, exec_vm_main_vm().cont_ip[handle]);
    exec_vm_main_vm().await_waker_addr = saved_waker_addr;
    exec_vm_main_vm().await_waker_kind = saved_waker_kind;
    exec_vm_slot_pool_pop(exec_vm_main_vm(), base);
    if rc < 0 {
        return -1;
    }
    if rc == 1 {
        // 中途又挂起：把新续体的状态搬到旧 handle 上，调用方手里的 box 继续有效。
        const new_handle: i32 = exec_vm_cont_handle_of(&resumed);
        exec_vm_cont_migrate(new_handle, handle);
        out_value[0] = exec_make_union(0, exec_make_void());
        return 0;
    }
    // 恢复执行到 `BC_RET` 之后拿到的是整个 `Future{state: Poll<T>}`：
    // 接口 `poll` 要交回的是里面的载荷，不能把 Future 再包一层。
    var final_payload: ExecValue = exec_value_clone(&resumed);
    const done_poll: &ExecUnionData = exec_vm_await_find_poll(&resumed, 0);
    if done_poll != null && done_poll.tag == 1 {
        final_payload = exec_value_clone(&done_poll.payload);
    }
    // 先把完成态和结果留在 handle 上，再 release —— 这样即使续体表项被回收，
    // 后续重复 poll 也能从这里取回同一个 Ready（见上面的无效-handle 分支）。
    if handle >= 0 && handle < EXEC_VM_CONT_MAX {
        exec_vm_main_vm().cont_done[handle] = 1;
        exec_vm_main_vm().cont_result[handle] = exec_value_clone(&final_payload);
    }
    exec_vm_cont_release(handle);
    out_value[0] = exec_make_union(1, final_payload);
    return 0;
}

fn exec_vm_call_function(vm: &ExecVmState, program: &BCProgram, function_index: i32, args: &ExecValue, arg_count: i32, trace_vm: i32, out_value: &ExecValue) i32 {
    if program == null || out_value == null {
        exec_backend_set_error(null, "exec: VM 调用参数无效" as *byte, 0);
        return -1;
    }
    // 续体哨兵：接口方法表里放的是负下标，这里转给续体处理。
    if function_index == EXEC_VM_CONT_POLL_INDEX {
        return exec_vm_cont_poll(program, args, arg_count, out_value);
    }
    if function_index == EXEC_VM_CONT_RELEASE_INDEX {
        if args != null && arg_count >= 1 {
            exec_vm_cont_release(exec_vm_cont_handle_of(&args[0]));
        }
        out_value[0] = exec_make_void();
        return 0;
    }
    if function_index < 0 || function_index >= program.function_count {
        exec_backend_set_error(null, "exec: VM 调用参数无效" as *byte, 0);
        return -1;
    }
    const function: &BCFunction = program.functions + function_index;
    if function.slot_count > EXEC_MAX_FRAME_SLOTS {
        exec_backend_set_error(function.decl, "exec: VM frame slot 超限" as *byte, 0);
        return -1;
    }
    const base: i32 = exec_vm_slot_pool_push(vm, function.slot_count);
    if base < 0 {
        exec_backend_set_error(function.decl, "exec: VM frame slot 超限" as *byte, 0);
        return -1;
    }
    const rc: i32 = exec_vm_run_frame(vm, program, function, args, arg_count, trace_vm, out_value, base,
        null as &ExecValue, 0);
    exec_vm_slot_pool_pop(vm, base);
    return rc;
}

/// 在已经切好的槽位栈段上执行一个函数体（配对 `exec_vm_call_function`）。
/// 参数：`base` 槽位栈起始下标。
/// 返回值：0 表示执行完成，-1 表示运行时错误。
fn exec_vm_run_frame(vm: &ExecVmState, program: &BCProgram, function: &BCFunction, args: &ExecValue, arg_count: i32,
    trace_vm: i32, out_value: &ExecValue, base: i32,
    resume_slots: &ExecValue, resume_ip: i32) i32 {
    var slots_ptr: &ExecValue = exec_vm_slot_pool_base(vm, base);
    if slots_ptr == null {
        // 拿不到自己的槽段时绝不能退回 pool[0]：那会和最深层的帧重叠，
        // 表现为「参数刚拷进去是对的，一次内层调用回来就变了别的类型」。
        exec_backend_set_error(function.decl, "exec: 调用帧槽位段无效" as *byte, 0);
        return -1;
    }
    var frame: ExecFrame = ExecFrame {
        function: function,
        ip: 0,
        slots: slots_ptr,
        varargs: [],
        vararg_count: 0,
        vm: vm,
    };
    g_exec_dbg_cur_fn = function.name;
    exec_vm_trace_call_enter(trace_vm, function.name, arg_count);
    const saved_resumed: i32 = vm.frame_resumed;
    if resume_slots != null {
        vm.frame_resumed = 1;
    } else {
        vm.frame_resumed = 0;
    }
    var si: i32 = 0;
    if resume_slots != null {
        // 续体恢复：整段槽位从快照拷回来，并把快照里的内部引用按偏移改到新槽段。
        const snap_base: usize = @usize_from_ptr(resume_slots as &void);
        const snap_limit: usize = snap_base +| (@size_of(ExecValue) as usize * function.slot_count as usize);
        const frame_base: usize = @usize_from_ptr(frame.slots as &void);
        while si < function.slot_count {
            // 裸数组**保持底层块指针**（与 `exec_vm_cont_snapshot` 同一规则）。
            // 这里若再 clone 一次，裸数组又换一块：调用方在挂起前交给下层的
            // `&arr[0]` 仍指旧块，恢复后 `arr` 指新块，两边从此对不上
            // （`tests/repros/async_await_raw_array_write_lost.uya`：
            //  `@await` 之后的 `buf[10] = 99` 写到旧块，`rx[10]` 从新块读回 0）。
            if exec_value_is_raw_array(&resume_slots[si]) != 0 {
                frame.slots[si] = resume_slots[si];
            } else {
                frame.slots[si] = exec_value_clone(&resume_slots[si]);
            }
            si = si + 1;
        }
        si = 0;
        while si < function.slot_count {
            exec_vm_cont_remap_refs(&frame.slots[si], snap_base, snap_limit, frame_base);
            si = si + 1;
        }
        exec_vm_cont_remap_blocks(resume_slots, snap_base, snap_limit, frame_base);
        frame.ip = resume_ip;
    } else {
        while si < function.slot_count {
            frame.slots[si] = exec_make_void();
            si = si + 1;
        }
        si = 0;
        while si < arg_count && si < function.param_count {
            exec_value_retain(&args[si]);
            frame.slots[si] = args[si];
            si = si + 1;
        }
    }
    if function.is_varargs != 0 {
        var vi: i32 = 0;
        while function.param_count + vi < arg_count && vi < EXEC_MAX_CALL_ARGS {
            frame.varargs[vi] = exec_vm_promote_vararg_value(args[function.param_count + vi]);
            vi = vi + 1;
        }
        frame.vararg_count = vi;
    }

    while frame.ip < function.instr_count {
        if vm != null && vm.is_host_thread != 0 && vm.cancel_pending != 0 {
            // 真宿主线程被 pthread_cancel 打断：让当前帧正常返回、逐层退栈。
            // 不能用 sys_exit —— 那是进程级退出，会把整个程序杀掉；
            // 外层帧同样带同一个 vm，每轮循环都会命中这里，于是整条调用链退干净。
            out_value[0] = exec_make_pointer_with_kind(0 as usize, TypeKind.TYPE_VOID as i32);
            return 0;
        }
        if g_exec_vm_thread_body_budget > 0i64 {
            g_exec_vm_thread_body_budget = g_exec_vm_thread_body_budget -| 1i64;
            if g_exec_vm_thread_body_budget == 0i64 {
                exec_backend_set_error(function.decl, "exec: 线程体超出指令预算（解释器无并发，自旋会死锁）" as *byte, 0);
                vm.frame_resumed = saved_resumed;
                return -1;
            }
        }
        const step_result: i32 = vm_step(program, &frame, trace_vm, out_value);
        if step_result < 0 {
            vm.frame_resumed = saved_resumed;
            return -1;
        }
        // `pthread_exit(v)` 必须在 `BC_RET` 之前判定：解释器里做完 host call 后，
        // 线程体还会继续跑到自己的 `BC_RET`，那次返回会把 out_value 覆盖成普通返回值，
        // join 就拿不到 pthread_exit 的 retval（`PTHREAD_CANCELED` 会丢）。
        if g_exec_vm_thread_exit_requested != 0 {
            g_exec_vm_thread_exit_requested = 0;
            exec_vm_store_slot(out_value, exec_value_clone(&g_exec_vm_thread_exit_value));
            vm.frame_resumed = saved_resumed;
            return 0;
        }
        if step_result > 0 {
            // `BC_RET` 给 1（正常返回），`@await` 挂起给 2（帧已快照成续体）。
            vm.frame_resumed = saved_resumed;
            return step_result -| 1;
        }
    }
    out_value[0] = exec_make_void();
    vm.frame_resumed = saved_resumed;
    return 0;
}

/// 运行已经构建好的 bytecode 程序。
/// 参数：`program` 为 exec backend 构建产物；`trace_vm` 控制是否打印逐条 VM trace。
/// 返回值：成功时返回程序 `main` 的退出码；失败时返回非 0，并通过 exec backend 错误状态说明原因。
/// `exit()` 在解释器里的「提前收工」标记与退出码。
var g_exec_vm_exit_requested: i32 = 0;
var g_exec_vm_exit_code: i32 = 0;

/// `exit()` 是否已经被调用过（用于区分「程序正常结束」和「运行时错误」）。
export fn vm_exit_requested() i32 {
    return g_exec_vm_exit_requested;
}

export fn vm_run_program(program: &BCProgram, trace_vm: i32) i32 {
    if program == null {
        exec_backend_set_error(null, "exec: VM 程序为空" as *byte, 0);
        return 1;
    }
    g_exec_vm_globals_base = @usize_from_ptr(program.globals as &void);
    g_exec_vm_globals_end = g_exec_vm_globals_base +| ((@size_of(ExecValue) as usize) * (program.global_count as usize));
    var gi: i32 = 0;
    while gi < program.global_count {
        program.globals[gi] = exec_make_void();
        gi = gi + 1;
    }
    if program.global_init_function_index >= 0 {
        var init_result: ExecValue = exec_make_void();
        if exec_vm_call_function(exec_vm_main_vm(), program, program.global_init_function_index, null, 0, trace_vm, &init_result) < 0 {
            if g_exec_vm_exit_requested != 0 {
                return g_exec_vm_exit_code;
            }
            return 1;
        }
    }
    // VM 没有 C 运行时的 `uya_rt_init(argc, argv)`：由宿主（编译器入口）把
    // `run`/`test` 的 `--` 之后那段参数注入 `std.runtime.saved_argc` / `saved_argv`，
    // 让 `get_argc`/`get_argv` 在 VM 里与 C99 语义一致（之前只把 argc 补成 1
    // 且不设 argv，被解释的 uya 编译器因此看不到任何命令行参数）。
    var vm_argc: i32 = 1;
    if program.host_argc > 0 {
        vm_argc = program.host_argc;
    }
    if program.saved_argc_global_index >= 0 && program.saved_argc_global_index < program.global_count {
        program.globals[program.saved_argc_global_index] = exec_make_i32(vm_argc);
    }
    if program.saved_argv_global_index >= 0 && program.saved_argv_global_index < program.global_count &&
        program.host_argv != null {
        program.globals[program.saved_argv_global_index] = exec_make_pointer_with_kind(
            @usize_from_ptr(program.host_argv as &void), TypeKind.TYPE_POINTER as i32);
    }
    // `saved_envp: &&byte` 指向**编译器进程自己的**环境表（`std.runtime.saved_envp`
    // 由编译器入口填好）。解释器与 C99 子进程继承同一份环境，语义一致。
    if program.saved_envp_global_index >= 0 && program.saved_envp_global_index < program.global_count &&
        saved_envp != null {
        program.globals[program.saved_envp_global_index] = exec_make_pointer_with_kind(
            @usize_from_ptr(saved_envp as &void), TypeKind.TYPE_POINTER as i32);
    }
    // 顶层 test "..." 块：与 C99 侧 uya_run_tests() 的输出格式保持一致。
    // - 没有用户 main 时（测试文件），先打印 "=== Running N tests ==="，最后打印汇总并
    //   以失败用例数作为退出码；
    // - 有用户 main 时，测试在 main 之前执行（对齐 C99 在 main 开头注入 uya_run_tests），
    //   退出码仍取 main 的返回值。
    if program.test_count > 0 {
        if program.has_user_main == 0 {
            printf("\n=== Running %d tests ===\n" as *byte, program.test_count);
        }
        var passed_cases: i32 = 0;
        var failed_cases: i32 = 0;
        var test_i: i32 = 0;
        while test_i < program.test_count {
            var test_desc: &const byte = null;
            if program.test_descriptions != null && program.test_descriptions[test_i] != null {
                test_desc = program.test_descriptions[test_i] as &const byte;
            }
            printf("  TEST: %s ... " as *byte, test_desc);
            _ = fflush(libc.stdout);
            var test_result: ExecValue = exec_make_void();
            if exec_vm_call_function(exec_vm_main_vm(), program, program.test_function_indices[test_i], null, 0, trace_vm, &test_result) < 0 {
                if g_exec_vm_exit_requested != 0 {
                    return g_exec_vm_exit_code;
                }
                return 1;
            }
            if exec_value_is_error_union_err(test_result) != 0 {
                printf("ERROR\n" as *byte);
                failed_cases = failed_cases +| 1;
            } else {
                passed_cases = passed_cases +| 1;
                printf("OK\n" as *byte);
            }
            test_i = test_i + 1;
        }
        if program.has_user_main == 0 {
            var assertion_count: i32 = 0;
            if program.test_passed_global_index >= 0 && program.test_passed_global_index < program.global_count {
                assertion_count = program.globals[program.test_passed_global_index].i64_value as i32;
            }
            printf("\n=== Results ===\n" as *byte);
            printf("  Tests Passed:       %d\n" as *byte, passed_cases);
            printf("  Tests Failed:       %d\n" as *byte, failed_cases);
            printf("  Assertions Passed:  %d\n" as *byte, assertion_count);
            return failed_cases;
        }
    }
    var result: ExecValue = exec_make_void();
    if exec_vm_call_function(exec_vm_main_vm(), program, program.entry_function_index, null, 0, trace_vm, &result) < 0 {
        if g_exec_vm_exit_requested != 0 {
            return g_exec_vm_exit_code;
        }
        return 1;
    }
    if g_exec_vm_exit_requested != 0 {
        return g_exec_vm_exit_code;
    }
    if result.kind == ExecValueKind.EXEC_VALUE_I32 ||
        result.kind == ExecValueKind.EXEC_VALUE_I8 ||
        result.kind == ExecValueKind.EXEC_VALUE_I16 ||
        result.kind == ExecValueKind.EXEC_VALUE_ISIZE ||
        result.kind == ExecValueKind.EXEC_VALUE_U8 ||
        result.kind == ExecValueKind.EXEC_VALUE_U16 ||
        result.kind == ExecValueKind.EXEC_VALUE_U32 ||
        result.kind == ExecValueKind.EXEC_VALUE_USIZE ||
        result.kind == ExecValueKind.EXEC_VALUE_BYTE ||
        result.kind == ExecValueKind.EXEC_VALUE_BOOL {
        return result.i64_value as i32;
    }
    return 0;
}
