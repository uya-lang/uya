        const attr_value: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_INIT {
            const attr_stack: &ExecValue = exec_vm_field_ref_store(attr_value, 0);
