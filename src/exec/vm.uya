// exec/vm.uya - Minimal bytecode VM

use libc;
use libc.puts;
use libc.atoi;
use libc.atoll;
use libc.isqrt;
use libc.strcmp;
use libc.llabs;
use libc.mkdir;
use libc.rmdir;
use libc.fprintf;
use libc.clock;
use std.runtime.saved_envp;
use libc.printf;
use libc.sprintf;
use libc.snprintf;
use libc.write;
use libc.strlen;
use libc.fflush;
use libc.malloc;
use libc.calloc;
use libc.realloc;
use libc.free;
use libc.exit;
use libc.fflush;

const EXEC_VM_REF_KIND_BASE: i32 = 65536;
const EXEC_VM_REF_KIND_INDEX_BASE: i32 = 131072;

// 调用帧槽位的共享栈（LIFO）。
//
// 早先每个调用都在 C 栈上放一个 `[ExecValue: 8192]`（约 393KB）并逐槽清零：
// 一次普通函数调用要几十万条初始化指令，纯计算型用例（大数模幂、SHA-384）
// 因此慢到几十分钟。改为按 function.slot_count 从共享栈里切一段，调用返回时
// 回退栈顶；递归按 LIFO 自然正确。
// 池按需增长（初始 `EXEC_VM_SLOT_POOL_INITIAL`，不够就翻倍）。
// 固定容量有两个麻烦：小则深调用链撞墙，大则白占内存且必须把容量抄到
// 每一处判界的地方（历史上就是因为把单函数帧上限 8192 当成了池容量，
// 导致 base ≥ 8192 的帧拿不到自己的槽段、退回 pool[0] 与别的帧重叠）。
var g_exec_vm_slot_pool: &ExecValue = null;
var g_exec_vm_slot_pool_capacity: i32 = 0;
var g_exec_vm_slot_top: i32 = 0;

const EXEC_VM_SLOT_POOL_INITIAL: i32 = 8192;
// 池的容量上限。`ExecValue` 是 56 字节，所以槽数直接决定内存：`1 << 18`
//（26 万槽 ≈ 14.7MB）已经比任何真实调用链都宽裕得多。不要往上调 ——
// census 会用 `ulimit -v 1024`（1GB 地址空间）跑每个用例，上限设成
// `1 << 24` 时一旦真的扩到那儿就是 940MB，直接把用例打死。
const EXEC_VM_SLOT_POOL_MAX: i32 = 1 << 18;

/// 确保池至少有 `want` 个槽位，不够就翻倍扩容。
///
/// 参数：`want` 需要的槽位数。
/// 返回值：0 成功；-1 分配失败或超出上限。
fn exec_vm_slot_pool_reserve(want: i32) i32 {
    if want <= 0 {
        return 0;
    }
    if want > EXEC_VM_SLOT_POOL_MAX {
        return -1;
    }
    if g_exec_vm_slot_pool != null && want <= g_exec_vm_slot_pool_capacity {
        return 0;
    }
    var next: i32 = g_exec_vm_slot_pool_capacity;
    if next < EXEC_VM_SLOT_POOL_INITIAL {
        next = EXEC_VM_SLOT_POOL_INITIAL;
    }
    while next < want && next < EXEC_VM_SLOT_POOL_MAX {
        next = next *| 2;
    }
    if next < want {
        next = want;
    }
    const bytes: usize = (@size_of(ExecValue) as usize) * (next as usize);
    const fresh: &ExecValue = exec_value_alloc_bytes(bytes) as &ExecValue;
    if fresh == null {
        return -1;
    }
    // 只在**没有活跃帧**时才搬移：`ExecFrame.slots` 是指向池内的裸指针，
    // 搬到新块会让栈上所有 frame 悬挂。调用栈为空（top==0）时没有指针，
    // 换块是安全的 —— 需要扩容的场景（更深的调用链、跨测试复用）都能落在
    // 这里：一次调用结束后 top 归零，下一次进入前再扩容即可。
    if g_exec_vm_slot_top > 0 && g_exec_vm_slot_pool != null {
        return -1;
    }
    g_exec_vm_slot_pool = fresh;
    g_exec_vm_slot_pool_capacity = next;
    return 0;
}

/// 池的内存区间 `[base, base+size)`，供地址归属判定使用。
///
/// 参数：`out_base` 池起始地址；`out_size` 池字节数。
/// 返回值：无。池未分配时 `out_base` 为 0。
fn exec_vm_slot_pool_range(out_base: &usize, out_size: &usize) void {
    if out_base != null {
        if g_exec_vm_slot_pool == null {
            out_base[0] = 0 as usize;
        } else {
            out_base[0] = @usize_from_ptr(g_exec_vm_slot_pool as &void);
        }
    }
    if out_size != null {
        out_size[0] = (@size_of(ExecValue) as usize) * (g_exec_vm_slot_pool_capacity as usize);
    }
}

/// 从共享槽位栈里切一段给新调用帧。
/// 参数：`slot_count` 本次调用需要的槽位数。
/// 返回值：切出的起始下标；空间不足返回 -1。
fn exec_vm_slot_pool_push(slot_count: i32) i32 {
    if slot_count < 0 || g_exec_vm_slot_top < 0 {
        return -1;
    }
    const base: i32 = g_exec_vm_slot_top;
    const need: i32 = base +| slot_count;
    if need < 0 {
        return -1;
    }
    if exec_vm_slot_pool_reserve(need) != 0 {
        return -1;
    }
    g_exec_vm_slot_top = need;
    return base;
}

/// 取共享槽位栈里某段起始位置的值指针。
/// 参数：`base` push 返回的起始下标。
/// 返回值：指向该槽位的指针；下标越界返回 null。
fn exec_vm_slot_pool_base(base: i32) &ExecValue {
    if g_exec_vm_slot_pool == null {
        return null;
    }
    if base < 0 || base >= g_exec_vm_slot_pool_capacity {
        return null;
    }
    return &g_exec_vm_slot_pool[base];
}

/// 归还一段槽位（必须与 push 一一配对）。
/// 参数：`base` push 返回的起始下标。
fn exec_vm_slot_pool_pop(base: i32) void {
    if base >= 0 && base <= g_exec_vm_slot_top {
        g_exec_vm_slot_top = base;
    }
}

fn exec_vm_slot_ref(frame: &ExecFrame, idx: i32) &ExecValue {
    if frame == null || idx < 0 || idx >= EXEC_MAX_FRAME_SLOTS {
        return null;
    }
    if idx >= 0 && idx < EXEC_MAX_FRAME_SLOTS {
        return &frame.slots[idx];
    }
    return null;
}

/// 判断某个值是否「自己拥有」它的聚合内存（可以原地复用）。
///
/// `error_id` 对聚合/原始数组没有其它含义：0 表示这块内存是当前槽位独占的
/// （`exec_value_clone` / 构造时新建），非 0 表示它是从别的槽位浅拷贝借来的
/// （`exec_vm_store_slot_shallow`），不能原地写，否则会改到别人。
fn exec_vm_value_owns_buffer(value: &ExecValue) i32 {
    if value == null {
        return 0;
    }
    if value.kind != ExecValueKind.EXEC_VALUE_ARRAY &&
        value.kind != ExecValueKind.EXEC_VALUE_STRUCT &&
        value.kind != ExecValueKind.EXEC_VALUE_TUPLE {
        return 0;
    }
    return (value.error_id == 0) as i32;
}

/// 尝试把 `src` 逐元素写进 `dst` 已有的聚合缓冲区（不重新分配）。
///
/// 参数：`dst` 目标槽位值；`src` 源值。
/// 返回值：1 表示已就地完成（值语义与深拷贝一致）；0 表示需要走深拷贝。
fn exec_vm_store_aggregate_in_place(dst: &ExecValue, src: &ExecValue) i32 {
    if dst == null || src == null || exec_vm_value_owns_buffer(dst) == 0 {
        return 0;
    }
    if dst.kind != src.kind {
        return 0;
    }
    if exec_value_is_raw_array(src) != 0 {
        if exec_value_is_raw_array(dst) == 0 || dst.i64_value != src.i64_value {
            return 0;
        }
        if dst.aux_i64_value != src.aux_i64_value || dst.ptr_value == src.ptr_value {
            return 0;
        }
        if dst.ptr_value == null || src.ptr_value == null {
            return 0;
        }
        const elem_size: usize = exec_vm_type_kind_size(src.aux_i64_value as i32);
        if elem_size == 0 as usize {
            return 0;
        }
        _ = memcpy(dst.ptr_value as *void, src.ptr_value as *const void,
            elem_size * (src.i64_value as usize));
        return 1;
    }
    const dst_agg: &ExecAggregate = exec_value_as_aggregate(dst);
    const src_agg: &ExecAggregate = exec_value_as_aggregate(src);
    if dst_agg == null || src_agg == null || dst_agg.count != src_agg.count {
        return 0;
    }
    if dst_agg.values == src_agg.values {
        return 1;
    }
    var i: i32 = 0;
    while i < dst_agg.count {
        exec_vm_store_slot(&dst_agg.values[i], src_agg.values[i]);
        i = i + 1;
    }
    dst.i64_value = src.i64_value;
    return 1;
}

fn exec_vm_store_slot(slot: &ExecValue, value: ExecValue) void {
    if slot == null {
        return;
    }
    // 目标槽位已经持有同形聚合时逐元素覆盖：循环里反复赋值 `[u64: N]` / 结构体
    // 时不再每次都向 arena 申请整块内存（curve25519 这类纯计算用例原本会按
    // 每秒几十 MB 一路上涨）。
    const before_kind: i32 = slot[0].kind as i32;
    if exec_vm_store_aggregate_in_place(&slot[0], &value) != 0 {
        return;
    }
    const cloned: ExecValue = exec_value_clone(&value);
    if before_kind != -1 && value.kind == ExecValueKind.EXEC_VALUE_ERROR_UNION {
        const cl_agg: &ExecAggregate = exec_value_as_aggregate(&cloned);
    }
    slot[0] = cloned;
}

/// 把值原样写进槽位（不深拷贝）。
///
/// 表达式求值读局部/全局变量时用这个：`exec_value_clone` 对聚合数组是逐元素
/// 深拷贝，而聚合内存来自只增不减的 arena —— `acc[i]` 这种下标读每执行一次就
/// 复制整个数组，循环里直接把内存吃到 GB 级（test_crypto_bigint 的 7GB 就是这么
/// 来的）。读出来的临时值不会被写回，浅拷贝即可；真正的赋值（BC_MOV /
/// BC_STORE_LOCAL / 字段与下标写）仍然走深拷贝，值语义不变。
fn exec_vm_store_slot_shallow(slot: &ExecValue, value: ExecValue) void {
    if slot == null {
        return;
    }
    slot[0] = value;
    // 标记为「借来的」聚合内存：后续若要往这个槽位写，必须另做深拷贝，
    // 不能原地覆盖（那块内存还属于别人）。
    if slot[0].kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        slot[0].kind == ExecValueKind.EXEC_VALUE_STRUCT ||
        slot[0].kind == ExecValueKind.EXEC_VALUE_TUPLE {
        slot[0].error_id = 1;
    }
}

// 解释器通过宿主 malloc/calloc/realloc 借出去的内存登记表。
//
// 程序里的 `use libc.malloc` / `free` 会直接落到宿主 malloc/free 上。而解释器
// 自己也会把「VM 内部的假地址」（内部引用、旁路表地址、原生聚合元素地址）
// 当成指针交给程序，程序一旦 free 这类地址，宿主堆就被写坏 —— 之后的任意一次
// malloc 都可能段错误（实测 test_typed_pipeline_capability 崩在 tcache_count）。
// 所以 free/realloc 前先按表核对：只有本解释器亲手分配过的地址才真正交还宿主。
const EXEC_ALLOC_TRACK_MAX: i32 = 8192;

var g_exec_alloc_keys: [usize: EXEC_ALLOC_TRACK_MAX] = [];
var g_exec_alloc_sizes: [usize: EXEC_ALLOC_TRACK_MAX] = [];
var g_exec_alloc_used: i32 = 0;

fn exec_vm_alloc_hash(addr: usize) i32 {
    var h: usize = addr >> 4;
    h = h ^ (h >> 17);
    return (h & ((EXEC_ALLOC_TRACK_MAX as usize) - 1 as usize)) as i32;
}

/// 登记一块解释器分配的宿主内存。
/// 参数：`addr` 起始地址；`size` 字节数。
/// 返回值：无。
fn exec_vm_alloc_track(addr: usize, size: usize) void {
    if addr == 0 as usize || g_exec_alloc_used >= EXEC_ALLOC_TRACK_MAX {
        return;
    }
    var probe: i32 = 0;
    while probe < EXEC_ALLOC_TRACK_MAX {
        const idx: i32 = (exec_vm_alloc_hash(addr) +| probe) & (EXEC_ALLOC_TRACK_MAX -| 1);
        if idx < 0 || idx >= EXEC_ALLOC_TRACK_MAX {
            return;
        }
        if g_exec_alloc_keys[idx] == 0 as usize {
            g_exec_alloc_keys[idx] = addr;
            g_exec_alloc_sizes[idx] = size;
            g_exec_alloc_used = g_exec_alloc_used +| 1;
            return;
        }
        probe = probe +| 1;
    }
}

/// 注销一块解释器分配过的宿主内存。
/// 参数：`addr` 起始地址。
/// 返回值：1 表示登记过（调用方可以真正释放）；0 表示不是解释器分配的。
fn exec_vm_alloc_untrack(addr: usize) i32 {
    if addr == 0 as usize {
        return 0;
    }
    var probe: i32 = 0;
    while probe < EXEC_ALLOC_TRACK_MAX {
        const idx: i32 = (exec_vm_alloc_hash(addr) +| probe) & (EXEC_ALLOC_TRACK_MAX -| 1);
        if idx < 0 || idx >= EXEC_ALLOC_TRACK_MAX {
            return 0;
        }
        if g_exec_alloc_keys[idx] == addr {
            g_exec_alloc_keys[idx] = 0 as usize;
            g_exec_alloc_sizes[idx] = 0 as usize;
            if g_exec_alloc_used > 0 {
                g_exec_alloc_used = g_exec_alloc_used -| 1;
            }
            return 1;
        }
        if g_exec_alloc_keys[idx] == 0 as usize {
            return 0;
        }
        probe = probe +| 1;
    }
    return 0;
}

fn exec_vm_global_ref(program: &BCProgram, idx: i32) &ExecValue {
    if program == null || idx < 0 || idx >= program.global_count || program.globals == null {
        return null;
    }
    return &program.globals[idx];
}

fn exec_vm_value_kind_is_unsigned(kind: ExecValueKind) i32 {
    if kind == ExecValueKind.EXEC_VALUE_U8 ||
        kind == ExecValueKind.EXEC_VALUE_U16 ||
        kind == ExecValueKind.EXEC_VALUE_U32 ||
        kind == ExecValueKind.EXEC_VALUE_U64 ||
        kind == ExecValueKind.EXEC_VALUE_USIZE ||
        kind == ExecValueKind.EXEC_VALUE_BYTE ||
        kind == ExecValueKind.EXEC_VALUE_POINTER ||
        kind == ExecValueKind.EXEC_VALUE_STRING {
        return 1;
    }
    return 0;
}

// 按目标整数类型求饱和边界（有符号）
fn exec_vm_sat_bounds_signed(kind: ExecValueKind, out_min: &i64, out_max: &i64) void {
    out_min[0] = -2147483647 - 1;
    out_max[0] = 2147483647;
    if kind == ExecValueKind.EXEC_VALUE_I8 {
        out_min[0] = -128;  out_max[0] = 127;
    } else if kind == ExecValueKind.EXEC_VALUE_I16 {
        out_min[0] = -32768; out_max[0] = 32767;
    } else if kind == ExecValueKind.EXEC_VALUE_I64 || kind == ExecValueKind.EXEC_VALUE_ISIZE {
        out_min[0] = @min; out_max[0] = @max;
    }
}

// 按目标整数类型求饱和边界（无符号）
fn exec_vm_sat_bounds_unsigned(kind: ExecValueKind, out_max: &u64) void {
    out_max[0] = 4294967295u64;
    if kind == ExecValueKind.EXEC_VALUE_U8 {
        out_max[0] = 255u64;
    } else if kind == ExecValueKind.EXEC_VALUE_U16 {
        out_max[0] = 65535u64;
    } else if kind == ExecValueKind.EXEC_VALUE_U64 || kind == ExecValueKind.EXEC_VALUE_USIZE {
        out_max[0] = @max;
    } else if kind == ExecValueKind.EXEC_VALUE_BYTE {
        out_max[0] = 255u64;
    }
}

// 饱和加法：结果超出目标类型时钳到极值
fn exec_vm_sat_add(kind: ExecValueKind, a_signed: i64, a_unsigned: u64, b_signed: i64, b_unsigned: u64) ExecValue {
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        var umax: [u64: 1] = [0u64];
        exec_vm_sat_bounds_unsigned(kind, &umax[0]);
        const sum: u64 = a_unsigned + b_unsigned;
        if sum < a_unsigned {
            return exec_vm_make_integer_by_kind(kind, 0, umax[0]);
        }
        if sum > umax[0] {
            return exec_vm_make_integer_by_kind(kind, 0, umax[0]);
        }
        return exec_vm_make_integer_by_kind(kind, 0, sum);
    }
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    var sum2: i64 = a_signed +| b_signed;
    if b_signed > 0 && a_signed > hi[0] -| b_signed {
        sum2 = hi[0];
    } else if b_signed < 0 && a_signed < lo[0] -| b_signed {
        sum2 = lo[0];
    }
    return exec_vm_make_integer_by_kind(kind, sum2, 0);
}

// 饱和减法
fn exec_vm_sat_sub(kind: ExecValueKind, a_signed: i64, a_unsigned: u64, b_signed: i64, b_unsigned: u64) ExecValue {
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        if b_unsigned > a_unsigned {
            return exec_vm_make_integer_by_kind(kind, 0, 0u64);
        }
        return exec_vm_make_integer_by_kind(kind, 0, a_unsigned - b_unsigned);
    }
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    var diff: i64 = a_signed -| b_signed;
    if b_signed < 0 && a_signed > hi[0] +| b_signed {
        diff = hi[0];
    } else if b_signed > 0 && a_signed < lo[0] +| b_signed {
        diff = lo[0];
    }
    return exec_vm_make_integer_by_kind(kind, diff, 0);
}

// 饱和乘法
fn exec_vm_sat_mul(kind: ExecValueKind, a_signed: i64, a_unsigned: u64, b_signed: i64, b_unsigned: u64) ExecValue {
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        var umax: [u64: 1] = [0u64];
        exec_vm_sat_bounds_unsigned(kind, &umax[0]);
        if a_unsigned != 0u64 && b_unsigned > umax[0] / a_unsigned {
            return exec_vm_make_integer_by_kind(kind, 0, umax[0]);
        }
        return exec_vm_make_integer_by_kind(kind, 0, a_unsigned * b_unsigned);
    }
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    const prod: i64 = a_signed *| b_signed;
    // 用除法回验是否溢出（避免依赖未定义的乘法溢出）
    if a_signed != 0 && (prod / a_signed != b_signed) {
        if (a_signed > 0 && b_signed > 0) || (a_signed < 0 && b_signed < 0) {
            return exec_vm_make_integer_by_kind(kind, hi[0], 0);
        }
        return exec_vm_make_integer_by_kind(kind, lo[0], 0);
    }
    if prod > hi[0] {
        return exec_vm_make_integer_by_kind(kind, hi[0], 0);
    }
    if prod < lo[0] {
        return exec_vm_make_integer_by_kind(kind, lo[0], 0);
    }
    return exec_vm_make_integer_by_kind(kind, prod, 0);
}

// 溢出受检算术（`(a + b) catch` 的语义）：结果封装成错误联合，
// 正常时携带运算结果，溢出/除零时携带 err_id（来自指令 imm 高位，
// 与 checker 注册的 error.Overflow / error.DivisionByZero 一致）。

/// 判断整数 kind 的取值是否落在该类型范围内。
/// 参数：kind 目标整数类型；value 待检查的十进制值。
/// 返回值：1 表示在范围内，0 表示溢出。
fn exec_vm_checked_arith_in_range(kind: ExecValueKind, value: i64) i32 {
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    if value < lo[0] || value > hi[0] {
        return 0;
    }
    return 1;
}

/// 判断无符号 kind 的取值是否落在该类型范围内。
/// 参数：kind 目标整数类型；value 待检查的无符号值。
/// 返回值：1 表示在范围内，0 表示越界。
fn exec_vm_checked_arith_in_unsigned_range(kind: ExecValueKind, value: u64) i32 {
    var umax: [u64: 1] = [0u64];
    exec_vm_sat_bounds_unsigned(kind, &umax[0]);
    if value > umax[0] {
        return 0;
    }
    return 1;
}

/// `error.Overflow` 的错误 id。
///
/// 必须与 `src/checker/symbols.uya` 的 `hash_error_name`（djb2：h=5381，h*33+c）
/// 完全一致 —— catch 分支拿这个 id 和程序里的 `error.Overflow` 比较。
/// 参数：无。
/// 返回值：Overflow 的 id。
fn exec_vm_error_id_of_overflow() i32 {
    var h: u32 = 5381;
    var i: i32 = 0;
    const name: &byte = "Overflow" as &byte;
    while name[i] != 0 {
        h = ((h * 32) + h) + ((name[i] as byte) as u32);
        i = i + 1;
    }
    if h == 0 {
        return 1;
    }
    return h as i32;
}

/// 执行一个溢出受检的整数二元运算。
/// 参数：opcode 受检运算 opcode；type_code 结果类型的 TypeKind 编码；
///       left/right 左右操作数。
/// 返回值：错误联合值；正常分支携带运算结果，错误分支携带溢出/除零 id。
fn exec_vm_checked_arith(opcode: BCOpcode, type_code: i32, err_id: i32, left: ExecValue, right: ExecValue) ExecValue {
    const kind: ExecValueKind = exec_vm_value_kind_from_type_code(type_code, left.kind);
    const is_div: i32 = (opcode == BCOpcode.BC_DIV_CHECK || opcode == BCOpcode.BC_REM_CHECK) as i32;
    if is_div != 0 && right.i64_value == 0 {
        return exec_make_error_union_err(err_id);
    }
    if exec_vm_value_kind_is_float(kind) != 0 {
        // 浮点没有整数溢出语义，退化为普通运算。
        if opcode == BCOpcode.BC_ADD_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) + exec_value_as_f64(&right)));
        }
        if opcode == BCOpcode.BC_SUB_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) - exec_value_as_f64(&right)));
        }
        if opcode == BCOpcode.BC_MUL_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) * exec_value_as_f64(&right)));
        }
        if opcode == BCOpcode.BC_DIV_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) / exec_value_as_f64(&right)));
        }
        return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left)));
    }
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        // 无符号 checked 算术：算出结果后按目标类型上界判定是否越界。
        const lhs_u: u64 = left.i64_value as u64;
        const rhs_u: u64 = right.i64_value as u64;
        var value_u: u64 = 0;
        var overflow_u: i32 = 0;
        if opcode == BCOpcode.BC_ADD_CHECK {
            value_u = lhs_u +% rhs_u;
            if (lhs_u +| rhs_u) != value_u {
                overflow_u = 1;
            }
        } else if opcode == BCOpcode.BC_SUB_CHECK {
            if rhs_u > lhs_u {
                overflow_u = 1;
                value_u = 0u64;
            } else {
                value_u = lhs_u - rhs_u;
            }
        } else if opcode == BCOpcode.BC_MUL_CHECK {
            value_u = lhs_u *% rhs_u;
            if (lhs_u *| rhs_u) != value_u {
                overflow_u = 1;
            }
        } else if opcode == BCOpcode.BC_DIV_CHECK {
            value_u = lhs_u / rhs_u;
        } else {
            value_u = lhs_u % rhs_u;
        }
        if overflow_u == 0 && exec_vm_checked_arith_in_unsigned_range(kind, value_u) == 0 {
            overflow_u = 1;
        }
        if overflow_u != 0 {
            return exec_make_error_union_err(err_id);
        }
        return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, 0, value_u));
    }
    const lhs: i64 = left.i64_value;
    const rhs: i64 = right.i64_value;
    if is_div != 0 {
        var lo_div: [i64: 1] = [0i64];
        var hi_div: [i64: 1] = [0i64];
        exec_vm_sat_bounds_signed(kind, &lo_div[0], &hi_div[0]);
        // `MIN / -1` 与 `MIN % -1` 都是溢出：C 里二者都属于未定义行为，Uya 的
        // 受检算术统一报 error.Overflow（C99 后端同样在两种运算上都进 catch）。
        // 错误 id 不能复用检查指令里带的除零 id —— 它是名字的 djb2 哈希，
        // 这里按同一算法现算，和 checker 的 get_or_add_error_id("Overflow") 一致。
        if rhs == (0 - 1) && lhs == lo_div[0] {
            return exec_make_error_union_err(exec_vm_error_id_of_overflow());
        }
        var value_d: i64 = 0;
        if opcode == BCOpcode.BC_DIV_CHECK {
            value_d = lhs / rhs;
        } else {
            value_d = lhs % rhs;
        }
        return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, value_d, 0));
    }
    // 加减乘：包装结果与饱和结果不一致即 i64 溢出；窄类型再用范围判定。
    var wrapped: i64 = 0;
    var saturated: i64 = 0;
    if opcode == BCOpcode.BC_ADD_CHECK {
        wrapped = lhs +% rhs;
        saturated = lhs +| rhs;
    } else if opcode == BCOpcode.BC_SUB_CHECK {
        wrapped = lhs -% rhs;
        saturated = lhs -| rhs;
    } else {
        wrapped = lhs *% rhs;
        saturated = lhs *| rhs;
    }
    if saturated != wrapped {
        return exec_make_error_union_err(err_id);
    }
    if exec_vm_checked_arith_in_range(kind, wrapped) == 0 {
        return exec_make_error_union_err(err_id);
    }
    return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, wrapped, 0));
}

fn exec_vm_make_integer_by_kind(kind: ExecValueKind, signed_value: i64, unsigned_value: u64) ExecValue {
    if kind == ExecValueKind.EXEC_VALUE_I8 {
        return exec_make_i8(signed_value as i8);
    }
    if kind == ExecValueKind.EXEC_VALUE_I16 {
        return exec_make_i16(signed_value as i16);
    }
    if kind == ExecValueKind.EXEC_VALUE_I64 {
        return exec_make_i64(signed_value);
    }
    if kind == ExecValueKind.EXEC_VALUE_ISIZE {
        return exec_make_isize(signed_value as isize);
    }
    if kind == ExecValueKind.EXEC_VALUE_U8 {
        return exec_make_u8(unsigned_value as u8);
    }
    if kind == ExecValueKind.EXEC_VALUE_U16 {
        return exec_make_u16(unsigned_value as u16);
    }
    if kind == ExecValueKind.EXEC_VALUE_U32 {
        return exec_make_u32(unsigned_value as u32);
    }
    if kind == ExecValueKind.EXEC_VALUE_U64 {
        return exec_make_u64(unsigned_value);
    }
    if kind == ExecValueKind.EXEC_VALUE_USIZE {
        return exec_make_usize(unsigned_value as usize);
    }
    if kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f32(signed_value as f32);
    }
    if kind == ExecValueKind.EXEC_VALUE_F64 {
        return exec_make_f64(signed_value as f64);
    }
    if kind == ExecValueKind.EXEC_VALUE_BYTE {
        return exec_make_byte(unsigned_value as i32);
    }
    return exec_make_i32(signed_value as i32);
}

fn exec_vm_value_kind_from_type_code(kind_code: i32, fallback: ExecValueKind) ExecValueKind {
    if kind_code == TypeKind.TYPE_I8 as i32 {
        return ExecValueKind.EXEC_VALUE_I8;
    }
    if kind_code == TypeKind.TYPE_I16 as i32 {
        return ExecValueKind.EXEC_VALUE_I16;
    }
    if kind_code == TypeKind.TYPE_I64 as i32 {
        return ExecValueKind.EXEC_VALUE_I64;
    }
    if kind_code == TypeKind.TYPE_U8 as i32 {
        return ExecValueKind.EXEC_VALUE_U8;
    }
    if kind_code == TypeKind.TYPE_U16 as i32 {
        return ExecValueKind.EXEC_VALUE_U16;
    }
    if kind_code == TypeKind.TYPE_U32 as i32 {
        return ExecValueKind.EXEC_VALUE_U32;
    }
    if kind_code == TypeKind.TYPE_U64 as i32 {
        return ExecValueKind.EXEC_VALUE_U64;
    }
    if kind_code == TypeKind.TYPE_USIZE as i32 {
        return ExecValueKind.EXEC_VALUE_USIZE;
    }
    if kind_code == TypeKind.TYPE_F32 as i32 {
        return ExecValueKind.EXEC_VALUE_F32;
    }
    if kind_code == TypeKind.TYPE_F64 as i32 {
        return ExecValueKind.EXEC_VALUE_F64;
    }
    if kind_code == TypeKind.TYPE_BYTE as i32 {
        return ExecValueKind.EXEC_VALUE_BYTE;
    }
    if kind_code == TypeKind.TYPE_BOOL as i32 {
        return ExecValueKind.EXEC_VALUE_BOOL;
    }
    if kind_code == TypeKind.TYPE_ENUM as i32 {
        return ExecValueKind.EXEC_VALUE_I32;
    }
    if kind_code == TypeKind.TYPE_POINTER as i32 {
        return ExecValueKind.EXEC_VALUE_POINTER;
    }
    if kind_code == TypeKind.TYPE_VA_LIST as i32 {
        return ExecValueKind.EXEC_VALUE_VA_LIST;
    }
    return fallback;
}

fn exec_vm_value_kind_is_float(kind: ExecValueKind) i32 {
    return exec_value_is_float_kind(kind);
}

/// 值类型的 kind 是否是整数族（写回 syscall 出参结构体时用）。
fn exec_vm_value_kind_is_integer(kind: ExecValueKind) i32 {
    if kind == ExecValueKind.EXEC_VALUE_I8 || kind == ExecValueKind.EXEC_VALUE_I16 ||
        kind == ExecValueKind.EXEC_VALUE_I32 || kind == ExecValueKind.EXEC_VALUE_I64 ||
        kind == ExecValueKind.EXEC_VALUE_ISIZE || kind == ExecValueKind.EXEC_VALUE_U8 ||
        kind == ExecValueKind.EXEC_VALUE_U16 || kind == ExecValueKind.EXEC_VALUE_U32 ||
        kind == ExecValueKind.EXEC_VALUE_U64 || kind == ExecValueKind.EXEC_VALUE_USIZE ||
        kind == ExecValueKind.EXEC_VALUE_BOOL || kind == ExecValueKind.EXEC_VALUE_BYTE ||
        kind == ExecValueKind.EXEC_VALUE_POINTER {
        return 1;
    }
    return 0;
}

fn exec_vm_make_float_by_kind(kind: ExecValueKind, value: f64) ExecValue {
    if kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f32(value as f32);
    }
    return exec_make_f64(value);
}

fn exec_vm_numeric_to_i64(value: ExecValue) i64 {
    if exec_vm_value_kind_is_float(value.kind) != 0 {
        return exec_value_as_f64(&value) as i64;
    }
    return value.i64_value;
}

/// 把「指向聚合的内部引用」换算成可当字节地址用的整数。
/// `&buf` 在 C 里与 `&buf[0]` 取值相同；VM 里裸数组的数据在 ptr_value，
/// 直接取引用地址会得到 ExecValue 自身的地址（memset/memcpy 会写坏值）。
/// 参数：value 待换算的值。
/// 返回值：可当字节地址使用的无符号整数。
fn exec_vm_value_bytes_address(value: ExecValue) u64 {
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER && exec_vm_pointer_is_internal_ref(&value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(&value);
        if target != null && exec_value_is_raw_array(target) != 0 {
            return target.ptr_value as u64;
        }
    }
    // 裸数组值直接取数据区：`args as &(&byte)`、`buf as &byte` 这类转换在 C 里
    // 就是 `&buf[0]`，而数组的 `i64_value` 存的是元素个数（转成地址等于 0x4）。
    if exec_value_is_raw_array(&value) != 0 {
        return value.ptr_value as u64;
    }
    return exec_vm_numeric_to_u64(value);
}

fn exec_vm_numeric_to_u64(value: ExecValue) u64 {
    if exec_vm_value_kind_is_float(value.kind) != 0 {
        return exec_value_as_f64(&value) as u64;
    }
    return value.i64_value as u64;
}

fn exec_vm_promote_vararg_value(value: ExecValue) ExecValue {
    if value.kind == ExecValueKind.EXEC_VALUE_I8 || value.kind == ExecValueKind.EXEC_VALUE_I16 {
        return exec_make_i32(value.i64_value as i32);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U8 ||
        value.kind == ExecValueKind.EXEC_VALUE_U16 ||
        value.kind == ExecValueKind.EXEC_VALUE_BYTE ||
        value.kind == ExecValueKind.EXEC_VALUE_BOOL {
        return exec_make_i32(value.i64_value as i32);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f64(exec_value_as_f32(&value) as f64);
    }
    return exec_value_clone(&value);
}

fn exec_vm_resolve_va_target(slot: &ExecValue) &ExecValue {
    if slot == null {
        return null;
    }
    if exec_vm_pointer_is_internal_ref(slot) != 0 {
        return exec_vm_ref_target_value(slot);
    }
    return slot;
}

fn exec_vm_decode_syscall_arg_base(meta: i64) i32 {
    return (meta & 65535) as i32;
}

fn exec_vm_decode_syscall_arg_count(meta: i64) i32 {
    return ((meta >> 16) & 255) as i32;
}

fn exec_vm_decode_syscall_target_kind(meta: i64) i32 {
    return ((meta >> 24) & 65535) as i32;
}

fn exec_vm_decode_syscall_target_pointee_kind(meta: i64) i32 {
    return ((meta >> 40) & 65535) as i32;
}

fn exec_vm_decode_syscall_out_mask(meta: i64) i32 {
    return ((meta >> 56) & 127) as i32;
}

/// 给出参结构体准备原生缓冲区：VM 的聚合值每个字段都是 ExecValue，
/// 内核却按 `{ i64, i64 }` 这类原生布局写入，直接传引用地址会把
/// ExecValue 头部写成垃圾（`sys_gettimeofday(&tv, …)` 之后的 `tv.tv_sec` 就会崩）。
/// 参数：target - 出参聚合值；out_count - 输出字段数。
/// 返回：原生缓冲区（每字段 8 字节），不是聚合值时返回 null。
fn exec_vm_syscall_out_struct_prepare(target: &ExecValue, out_count: &i32) &i64 {
    if target == null || out_count == null {
        return null;
    }
    if target.kind != ExecValueKind.EXEC_VALUE_STRUCT &&
        target.kind != ExecValueKind.EXEC_VALUE_ARRAY &&
        target.kind != ExecValueKind.EXEC_VALUE_TUPLE {
        return null;
    }
    const aggregate: &ExecAggregate = target.ptr_value as &ExecAggregate;
    if aggregate == null || aggregate.values == null {
        return null;
    }
    const field_count: i32 = aggregate.count;
    if field_count <= 0 || field_count > 64 {
        return null;
    }
    // 内核按原生布局写整块（struct stat 是 144 字节），缓冲区至少留 256 字节，
    // 否则字段数少但结构体大的会越界。
    var buffer_bytes: usize = (@size_of(i64) as usize) * (field_count as usize);
    if buffer_bytes < 256 as usize {
        buffer_bytes = 256 as usize;
    }
    const buffer: &i64 = exec_value_alloc_bytes(buffer_bytes) as &i64;
    if buffer == null {
        return null;
    }
    var i: i32 = 0;
    while i < field_count {
        buffer[i] = exec_vm_numeric_to_i64(aggregate.values[i]);
        i = i + 1;
    }
    out_count[0] = field_count;
    return buffer;
}

/// 把原生缓冲区写回出参聚合值（只覆盖整数字段，其余字段保持原值）。
fn exec_vm_syscall_out_struct_apply(target: &ExecValue, buffer: &i64, field_count: i32) void {
    if target == null || buffer == null {
        return;
    }
    const aggregate: &ExecAggregate = target.ptr_value as &ExecAggregate;
    if aggregate == null || aggregate.values == null {
        return;
    }
    var i: i32 = 0;
    while i < aggregate.count && i < field_count {
        if exec_vm_value_kind_is_integer(aggregate.values[i].kind) != 0 {
            aggregate.values[i].i64_value = buffer[i];
        }
        i = i + 1;
    }
}

/// `epoll_wait` 家族的事件解包。
///
/// 内核按 C 的 packed 布局写事件：`events` u32 @0、`data_lo` u32 @4、
/// `data_hi` u32 @8，每条 **12 字节**。而 VM 的聚合值是「一字段一个 i64」，
/// 通用 `exec_vm_syscall_out_struct_apply` 按 8 字节步长回填，会把
/// `events` 和 `data_lo` 粘进同一个 i64（实测 `0x00000005_00000001`），
/// 于是 `epoll_event_fd` 读到 0、监听事件永远认不出来
/// （test_epoll_server 的 accept 全部落空）。
///
/// 参数：`target` 出参聚合（单个 EpollEvent，或 EpollEvent 数组）；
///       `buffer` 内核写过的原生缓冲区；`count` 内核返回的事件数。
fn exec_vm_unpack_epoll_events(target: &ExecValue, buffer: &i64, count: i32) void {
    if target == null || buffer == null || count <= 0 {
        return;
    }
    const outer: &ExecAggregate = if target.kind == ExecValueKind.EXEC_VALUE_ARRAY {
        target.ptr_value as &ExecAggregate
    } else {
        null
    };
    const src_base: usize = @usize_from_ptr(buffer as &void);
    var k: i32 = 0;
    while k < count && k < 64 {
        var elem: &ExecValue = target;
        if outer != null {
            if outer.values == null || k >= outer.count {
                return;
            }
            elem = &outer.values[k];
        } else if k > 0 {
            return;
        }
        if elem.kind != ExecValueKind.EXEC_VALUE_STRUCT && elem.kind != ExecValueKind.EXEC_VALUE_TUPLE {
            return;
        }
        const rec: &ExecAggregate = elem.ptr_value as &ExecAggregate;
        if rec == null || rec.values == null || rec.count < 2 {
            return;
        }
        const rec_addr: usize = src_base +| (k as usize) * (12 as usize);
        const words: &u32 = @ptr_from_usize(rec_addr) as &u32;
        rec.values[0].i64_value = words[0] as i64;
        rec.values[1].i64_value = words[1] as i64;
        if rec.count > 2 {
            rec.values[2].i64_value = words[2] as i64;
        }
        k = k + 1;
    }
}

/// 定位 syscall 出参结构体（参数值可能是指针、内部引用或裸地址）。
fn exec_vm_syscall_out_struct_target(arg_slot: &ExecValue, raw_address: i64) &ExecValue {
    const resolved: &ExecValue = exec_vm_resolve_va_target(arg_slot);
    if resolved != null && (resolved.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
            resolved.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
            resolved.kind == ExecValueKind.EXEC_VALUE_TUPLE) {
        return resolved;
    }
    if raw_address <= 0 {
        return null;
    }
    var probe: &ExecValue = raw_address as &ExecValue;
    var by_address: &ExecValue = probe;
    if by_address.kind != ExecValueKind.EXEC_VALUE_STRUCT &&
        by_address.kind != ExecValueKind.EXEC_VALUE_ARRAY &&
        by_address.kind != ExecValueKind.EXEC_VALUE_TUPLE {
        // 地址可能落在共享槽池里但**没有对齐到槽起始**：lowering 阶段生成的
        // `&slot` 经 `CAST` 到 `&const void` 时，地址偶尔带 `@size_of(i64)` 的
        // 偏移（实测 `rt_sigaction` 的 `&old_action` 是 `slots[5] + 8`）。直接用
        // 这个错位地址读 `kind` 得到垃圾值，出参结构体就判不出来，裸地址被原样
        // 交给内核 —— 内核按原生 `struct sigaction` 布局写 32 字节，把 ExecValue
        // 的头（kind）覆盖成 0，之后 `LOAD_FIELD` 全部报「字段越界」。
        const realigned: &ExecValue = exec_vm_realign_to_slot(raw_address as usize);
        if realigned != null {
            by_address = realigned;
        }
    }
    if by_address.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
        by_address.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        by_address.kind == ExecValueKind.EXEC_VALUE_TUPLE {
        return by_address;
    }
    return null;
}

/// 把落在共享槽池里的地址按 `@size_of(ExecValue)` 向下对齐到槽起始。
///
/// 参数：`addr` 待对齐地址。
/// 返回值：对齐后的槽地址；不在槽池范围内返回 null。
fn exec_vm_realign_to_slot(addr: usize) &ExecValue {
    if addr == 0 as usize {
        return null;
    }
    var base: usize = 0 as usize;
    var total: usize = 0 as usize;
    exec_vm_slot_pool_range(&base, &total);
    const slot_bytes: usize = @size_of(ExecValue) as usize;
    if slot_bytes == 0 as usize || base == 0 as usize || total == 0 as usize {
        return null;
    }
    if addr < base || addr >= (base +| total) {
        return null;
    }
    const delta: usize = addr -| base;
    const aligned: usize = base +| ((delta / slot_bytes) *| slot_bytes);
    return @ptr_from_usize(aligned) as &ExecValue;
}

/// 在 `@await` 的操作数里找出 `state: Poll<T>` 那个联合值。
///
/// 操作数可能是：裸的 `Future` 结构体值、装箱成接口的 `Future`
/// （`[方法入口下标…, 数据]`）、或者指向上面这些的引用，所以按「联合值在
/// 哪一层」递归找，找到即返回。
/// 参数：`value` 当前层的值；`depth` 递归深度（上限 4）。
/// 返回值：找到的联合值数据；没找到返回 null。
/// `@await` 忙等真实 Future 的 CPU 时间上限（`clock()` 单位，1e6 = 1 秒）。
const EXEC_AWAIT_BUSY_CLOCKS: i64 = 1500000;
/// `@await` 忙等时给 `Waker` 参数用的占位聚合字段数（够覆盖 Waker 的全部字段）。
const EXEC_AWAIT_WAKER_FIELDS: i32 = 64;

/// `@await` 命中「始终 Pending」时的向上传播。
///
/// VM 同步执行到完成，没有挂起点，所以没法真正保存「外层函数执行到一半」的
/// 状态。这里采用**穿透**：把被 await 的那个 Future 原样当作当前函数的返回值。
/// 因为 Pending 没有载荷，`Future<A>{Pending}` 和 `Future<B>{Pending}` 在运行期
/// 完全同形（都是「一个 box / 一个 {state} 结构体，state 是 Pending」），
/// 调用方拿到后再 poll 仍然得到 Pending —— 与 C99 状态机「本轮推不动」的
/// 可观测结果一致，而这正是 `test_async_await` 之类用例所断言的语义。
///
/// 仅在当前函数返回 Future（interface/struct）时生效；其它返回类型保持报错，
/// 避免把写错的 `@await` 静默吞掉。
///
/// 返回值：1 已把穿透值写入 `out_value`；0 不适用。
fn exec_vm_await_pass_through_pending(function: &BCFunction, value: &ExecValue, out_value: &ExecValue) i32 {
    if function == null || value == null || out_value == null {
        return 0;
    }
    const ret_kind: i32 = function.return_type.kind as i32;
    if ret_kind != (TypeKind.TYPE_INTERFACE as i32) && ret_kind != (TypeKind.TYPE_STRUCT as i32) {
        return 0;
    }
    out_value[0] = exec_value_clone(&value[0]);
    return 1;
}

fn exec_vm_await_find_poll(value: &ExecValue, depth: i32) &ExecUnionData {
    if value == null || depth > 4 {
        return null;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_UNION {
        return exec_value_as_union(value);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_ERROR_UNION && value.i64_value == 0 {
        // `!Future<T>`：ok 分支的载荷就存在 aux 三元组里，拆出来继续找。
        const inner: ExecValue = exec_value_unwrap_ok(value[0]);
        return exec_vm_await_find_poll(&inner, depth +| 1);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRUCT || value.kind == ExecValueKind.EXEC_VALUE_TUPLE {
        const aggregate: &ExecAggregate = value.ptr_value as &ExecAggregate;
        if aggregate == null || aggregate.values == null {
            return null;
        }
        var i: i32 = 0;
        while i < aggregate.count {
            const found: &ExecUnionData = exec_vm_await_find_poll(&aggregate.values[i], depth +| 1);
            if found != null {
                return found;
            }
            i = i +| 1;
        }
        return null;
    }
    if exec_value_is_pointer_like(value[0]) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(value);
        if target != null && target != value {
            return exec_vm_await_find_poll(target, depth +| 1);
        }
        const addr: usize = exec_vm_pointer_address(value);
        if addr != 0 as usize && exec_vm_address_is_vm_resident(addr) {
            return exec_vm_await_find_poll(@ptr_from_usize(addr) as &ExecValue, depth +| 1);
        }
    }
    return null;
}

/// 轮询一个「真实」Future（自己实现 poll、可能返回 Pending）。
///
/// VM 不能挂起，所以这里同步忙等：反复调用接口方法表里的 `poll`，直到不再是
/// Pending（或达到次数上限）。接口值布局是 `[方法入口下标…, 数据]`，
/// `interface Future<T>` 的方法顺序是 `poll` / `release`，所以 poll 在下标 0。
/// 参数：`program` 正在运行的程序；`value` `@await` 的操作数；`out_value` 结果载荷。
/// 返回值：0 成功，-1 失败/尚未就绪。
fn exec_vm_await_poll_interface(program: &BCProgram, value: &ExecValue, out_value: &ExecValue) i32 {
    if program == null || value == null || out_value == null {
        return -1;
    }
    if value.kind != ExecValueKind.EXEC_VALUE_STRUCT && value.kind != ExecValueKind.EXEC_VALUE_TUPLE {
        return -1;
    }
    const aggregate: &ExecAggregate = value.ptr_value as &ExecAggregate;
    if aggregate == null || aggregate.values == null || aggregate.count < 2 {
        return -1;
    }
    const poll_slot_index: i32 = aggregate.count - 1;
    const poll_fn_value: ExecValue = aggregate.values[0];
    if exec_vm_value_kind_is_integer(poll_fn_value.kind) == 0 {
        return -1;
    }
    const poll_fn_index: i32 = poll_fn_value.i64_value as i32;
    var args: [ExecValue: 2] = [];
    args[0] = aggregate.values[poll_slot_index];
    // waker 参数给一块「全是 void 字段」的聚合占位：忙等期间事件循环注册
    // 会往 `Waker` 的字段里写，字段数按上限给足，传 null 会让
    // `w.clear_cancelled()` 之类的调用在解释器里直接越界。
    var waker_addr: usize = 0 as usize;
    const waker_cell: &ExecValue = exec_value_alloc_bytes(@size_of(ExecValue)) as &ExecValue;
    if waker_cell != null {
        waker_cell[0] = exec_value_make_aggregate(ExecValueKind.EXEC_VALUE_STRUCT, EXEC_AWAIT_WAKER_FIELDS);
        waker_addr = waker_cell as usize;
    }
    args[1] = exec_make_pointer_with_kind(waker_addr, TypeKind.TYPE_STRUCT as i32);
    // 忙等要按**真实时间**收敛：像「deadline 到期」这种 Future 只有等到
    // 时钟越过 deadline 才会返回 Ready，纯计次循环可能在毫秒内就放弃。
    // `clock()` 给的是 CPU 时间（CLOCKS_PER_SEC = 1e6），忙等时同样在走。
    const wait_clocks: i64 = EXEC_AWAIT_BUSY_CLOCKS;
    const start_clocks: i64 = clock();
    while clock() - start_clocks < wait_clocks {
        const rc: i32 = exec_vm_call_function(program, poll_fn_index, &args[0], 2, 0, out_value);
        if rc < 0 {
            return -1;
        }
        const poll_data: &ExecUnionData = exec_value_as_union(out_value);
        if poll_data != null {
            if poll_data.tag != 0 {
                out_value[0] = exec_value_clone(&poll_data.payload);
                return 0;
            }
        } else {
            return -1;
        }
    }
    // 忙等窗口内一直是 Pending：和「根本不是 Future」区分开，
    // 交给调用方决定是报错还是向上传播（见 BC_AWAIT）。
    return 1;
}

fn exec_vm_syscall_arg_to_i64(value: ExecValue) i64 {
    if exec_value_is_pointer_like(value) != 0 {
        // 指针参数一律以 `ptr_value` 为准：`i64_value` 在某些数值转换路径上
        // 会被截成 32 位，把半截地址交给内核等于让内核往野地址里写
        // （epoll_ctl/epoll_wait 就是这样「注册成功但永远等不到事件」的）。
        const raw_addr: usize = @usize_from_ptr(value.ptr_value as &void);
        if raw_addr != 0 as usize {
            return raw_addr as i64;
        }
        return value.i64_value;
    }
    // 裸数组直接当参数（`execve(path, args, envp)` 的 `args`）：C 语义是
    // 数据区首地址，而 `i64_value` 存的是元素个数，绝不能拿来当地址。
    if exec_value_is_raw_array(&value) != 0 {
        const raw_array_addr: usize = @usize_from_ptr(value.ptr_value as &void);
        if raw_array_addr != 0 as usize {
            return raw_array_addr as i64;
        }
    }
    return exec_vm_numeric_to_i64(value);
}


/// 向量值的元素类型（TypeKind 编码，存放在 i64_value）。
fn exec_value_vector_elem_kind(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_VECTOR {
        return TypeKind.TYPE_VOID as i32;
    }
    return value.i64_value as i32;
}

/// 向量 / 掩码的通道数（存放在 aux_i64_value）。
fn exec_value_vector_lanes(value: &ExecValue) i32 {
    if value == null {
        return 0;
    }
    if value.kind != ExecValueKind.EXEC_VALUE_VECTOR && value.kind != ExecValueKind.EXEC_VALUE_MASK {
        return 0;
    }
    return value.aux_i64_value as i32;
}

/// 向量的数据缓冲（元素紧密排列，无对齐假设）。
fn exec_value_vector_data(value: &ExecValue) &byte {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_VECTOR {
        return null;
    }
    return value.ptr_value;
}

fn exec_make_vector(elem_type_kind: i32, lane_count: i32) ExecValue {
    const elem_size: usize = exec_vm_type_kind_size(elem_type_kind);
    if lane_count <= 0 || elem_size == 0 as usize {
        return exec_make_void();
    }
    const total: usize = elem_size * (lane_count as usize);
    const buf: &byte = exec_value_alloc_bytes(total);
    if buf == null {
        return exec_make_void();
    }
    var vi: usize = 0;
    while vi < total {
        buf[vi] = 0 as byte;
        vi = vi + 1;
    }
    return ExecValue {
        kind: ExecValueKind.EXEC_VALUE_VECTOR,
        i64_value: elem_type_kind as i64,
        ptr_value: buf,
        aux_kind: ExecValueKind.EXEC_VALUE_VOID,
        aux_i64_value: lane_count as i64,
        aux_ptr_value: null,
        error_id: 0,
    };
}

fn exec_make_mask_value(lane_count: i32) ExecValue {
    return ExecValue {
        kind: ExecValueKind.EXEC_VALUE_MASK,
        i64_value: 0,
        ptr_value: null,
        aux_kind: ExecValueKind.EXEC_VALUE_VOID,
        aux_i64_value: lane_count as i64,
        aux_ptr_value: null,
        error_id: 0,
    };
}

/// 取某个通道的原始比特（小端拼装，避免对齐/别名假设）。
fn exec_vector_lane_bits(data: &byte, elem_type_kind: i32, index: i32) i64 {
    const elem_size: usize = exec_vm_type_kind_size(elem_type_kind);
    if data == null || index < 0 || elem_size == 0 as usize {
        return 0;
    }
    const base: usize = elem_size * (index as usize);
    var bits: u64 = 0 as u64;
    var bi: usize = 0;
    while bi < elem_size {
        const byte_value: u64 = (data[base +| bi] as byte) as u64;
        bits = bits | (byte_value << ((bi as i32) * 8));
        bi = bi + 1;
    }
    return bits as i64;
}

fn exec_vector_set_lane_bits(data: &byte, elem_type_kind: i32, index: i32, bits: i64) void {
    const elem_size: usize = exec_vm_type_kind_size(elem_type_kind);
    if data == null || index < 0 || elem_size == 0 as usize {
        return;
    }
    const base: usize = elem_size * (index as usize);
    var bi: usize = 0;
    while bi < elem_size {
        const shifted: u64 = (bits as u64) >> ((bi as i32) * 8);
        data[base +| bi] = (shifted & 0xFFu64) as byte;
        bi = bi + 1;
    }
}

/// 向量逐通道比较，结果写进掩码（低位为通道 0）。
/// 有符号元素类型按自身宽度做符号扩展（通道值以小端拼接成 i64）。
fn exec_vector_elem_is_signed(elem_type_kind: i32) i32 {
    if elem_type_kind == TypeKind.TYPE_I8 as i32 ||
        elem_type_kind == TypeKind.TYPE_I16 as i32 ||
        elem_type_kind == TypeKind.TYPE_I32 as i32 ||
        elem_type_kind == TypeKind.TYPE_I64 as i32 ||
        elem_type_kind == TypeKind.TYPE_ENUM as i32 {
        return 1;
    }
    return 0;
}

fn exec_vector_lane_signed(bits: i64, elem_type_kind: i32) i64 {
    if elem_type_kind == TypeKind.TYPE_I8 as i32 {
        return (bits as i8) as i64;
    }
    if elem_type_kind == TypeKind.TYPE_I16 as i32 {
        return (bits as i16) as i64;
    }
    if elem_type_kind == TypeKind.TYPE_I32 as i32 || elem_type_kind == TypeKind.TYPE_ENUM as i32 {
        return (bits as i32) as i64;
    }
    return bits;
}

/// 把通道值钳到元素类型的取值范围内（向量饱和运算用）。
fn exec_vector_clamp_lane(value: i64, elem_type_kind: i32) i64 {
    if elem_type_kind == TypeKind.TYPE_I8 as i32 {
        if value > 127 as i64 { return 127 as i64; }
        if value < -128 as i64 { return -128 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_I16 as i32 {
        if value > 32767 as i64 { return 32767 as i64; }
        if value < -32768 as i64 { return -32768 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_I32 as i32 || elem_type_kind == TypeKind.TYPE_ENUM as i32 {
        if value > 2147483647 as i64 { return 2147483647 as i64; }
        if value < (-2147483647 as i64) - 1 as i64 { return (-2147483647 as i64) - 1 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_U8 as i32 || elem_type_kind == TypeKind.TYPE_BYTE as i32 {
        if value > 255 as i64 { return 255 as i64; }
        if value < 0 as i64 { return 0 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_U16 as i32 {
        if value > 65535 as i64 { return 65535 as i64; }
        if value < 0 as i64 { return 0 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_U32 as i32 {
        if value > 4294967295 as i64 { return 4294967295 as i64; }
        if value < 0 as i64 { return 0 as i64; }
        return value;
    }
    return value;
}

fn exec_vm_vector_compare(opcode_code: i32, left: ExecValue, right: ExecValue) ExecValue {
    const lanes: i32 = exec_value_vector_lanes(&left);
    const elem_kind: i32 = exec_value_vector_elem_kind(&left);
    const ldata: &byte = exec_value_vector_data(&left);
    const rdata: &byte = exec_value_vector_data(&right);
    const right_is_vector: i32 = (right.kind == ExecValueKind.EXEC_VALUE_VECTOR) as i32;
    const right_scalar_bits: i64 = right.i64_value;
    const signed_elem: i32 = exec_vector_elem_is_signed(elem_kind);
    if lanes <= 0 || lanes > 64 || ldata == null {
        return exec_make_void();
    }
    const is_f32: i32 = (elem_kind == TypeKind.TYPE_F32 as i32) as i32;
    const is_f64: i32 = (elem_kind == TypeKind.TYPE_F64 as i32) as i32;
    var mask_bits: i64 = 0;
    var li: i32 = 0;
    while li < lanes {
        var lb: i64 = exec_vector_lane_bits(ldata, elem_kind, li);
        var rb: i64 = right_scalar_bits;
        if right_is_vector != 0 {
            rb = exec_vector_lane_bits(rdata, elem_kind, li);
        }
        if signed_elem != 0 {
            lb = exec_vector_lane_signed(lb, elem_kind);
            rb = exec_vector_lane_signed(rb, elem_kind);
        }
        var lane_true: i32 = 0;
        if is_f32 != 0 || is_f64 != 0 {
            var lf: f64 = 0.0;
            var rf: f64 = 0.0;
            if is_f32 != 0 {
                lf = exec_f32_from_bits(lb as u32) as f64;
                rf = exec_f32_from_bits(rb as u32) as f64;
            } else {
                lf = exec_f64_from_bits(lb as u64);
                rf = exec_f64_from_bits(rb as u64);
            }
            if opcode_code == BCOpcode.BC_CMP_EQ as i32 { lane_true = (lf == rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_NE as i32 { lane_true = (lf != rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LT as i32 { lane_true = (lf < rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LE as i32 { lane_true = (lf <= rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_GT as i32 { lane_true = (lf > rf) as i32;
            } else { lane_true = (lf >= rf) as i32; }
        } else {
            if opcode_code == BCOpcode.BC_CMP_EQ as i32 { lane_true = (lb == rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_NE as i32 { lane_true = (lb != rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LT as i32 { lane_true = (lb < rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LE as i32 { lane_true = (lb <= rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_GT as i32 { lane_true = (lb > rb) as i32;
            } else { lane_true = (lb >= rb) as i32; }
        }
        if lane_true != 0 {
            mask_bits = mask_bits | ((1 as i64) << li);
        }
        li = li + 1;
    }
    var mask_result: ExecValue = exec_make_mask_value(lanes);
    mask_result.i64_value = mask_bits;
    return mask_result;
}

/// 向量逐通道算术；浮点元素按 f32/f64 位模式换算。
fn exec_vm_vector_binary(opcode_code: i32, left: ExecValue, right: ExecValue) ExecValue {
    const lanes: i32 = exec_value_vector_lanes(&left);
    const elem_kind: i32 = exec_value_vector_elem_kind(&left);
    const ldata: &byte = exec_value_vector_data(&left);
    const rdata: &byte = exec_value_vector_data(&right);
    const right_is_vector2: i32 = (right.kind == ExecValueKind.EXEC_VALUE_VECTOR) as i32;
    const right_scalar_bits2: i64 = right.i64_value;
    const signed_elem2: i32 = exec_vector_elem_is_signed(elem_kind);
    if lanes <= 0 || ldata == null {
        return exec_make_void();
    }
    const is_f32_elem: i32 = (elem_kind == TypeKind.TYPE_F32 as i32) as i32;
    const is_float_elem: i32 = (is_f32_elem != 0 || elem_kind == TypeKind.TYPE_F64 as i32) as i32;
    var out: ExecValue = exec_make_vector(elem_kind, lanes);
    const odata: &byte = exec_value_vector_data(&out);
    if odata == null {
        return exec_make_void();
    }
    var li: i32 = 0;
    while li < lanes {
        var lb: i64 = exec_vector_lane_bits(ldata, elem_kind, li);
        var rb: i64 = right_scalar_bits2;
        if right_is_vector2 != 0 {
            rb = exec_vector_lane_bits(rdata, elem_kind, li);
        }
        if signed_elem2 != 0 {
            lb = exec_vector_lane_signed(lb, elem_kind);
            rb = exec_vector_lane_signed(rb, elem_kind);
        }
        var res: i64 = 0;
        if is_float_elem != 0 {
            var lf: f64 = 0.0;
            var rf: f64 = 0.0;
            if is_f32_elem != 0 {
                lf = exec_f32_from_bits(lb as u32) as f64;
                rf = exec_f32_from_bits(rb as u32) as f64;
            } else {
                lf = exec_f64_from_bits(lb as u64);
                rf = exec_f64_from_bits(rb as u64);
            }
            var fr: f64 = 0.0;
            if opcode_code == BCOpcode.BC_ADD as i32 {
                fr = lf + rf;
            } else if opcode_code == BCOpcode.BC_SUB as i32 {
                fr = lf - rf;
            } else if opcode_code == BCOpcode.BC_MUL as i32 {
                fr = lf * rf;
            } else if rf != 0.0 {
                fr = lf / rf;
            }
            if is_f32_elem != 0 {
                res = exec_f32_to_bits(fr as f32) as i64;
            } else {
                res = exec_f64_to_bits(fr) as i64;
            }
        } else if opcode_code == BCOpcode.BC_ADD as i32 {
            res = lb +| rb;
        } else if opcode_code == BCOpcode.BC_SUB as i32 {
            res = lb -| rb;
        } else if opcode_code == BCOpcode.BC_MUL as i32 {
            res = lb *| rb;
        } else if opcode_code == BCOpcode.BC_DIV as i32 {
            if rb != 0 { res = lb / rb; }
        } else if opcode_code == BCOpcode.BC_REM as i32 {
            if rb != 0 { res = lb % rb; }
        } else if opcode_code == BCOpcode.BC_BIT_AND as i32 {
            res = lb & rb;
        } else if opcode_code == BCOpcode.BC_BIT_OR as i32 {
            res = lb | rb;
        } else {
            res = lb ^ rb;
        }
        exec_vector_set_lane_bits(odata, elem_kind, li, res);
        li = li + 1;
    }
    return out;
}

/// 判断值是否需要按聚合语义（逐元素）比较。
///
/// 参数：`value` 待判断的值。
/// 返回值：是聚合值返回 1，否则返回 0。
fn exec_vm_value_is_aggregate(value: &ExecValue) i32 {
    if value == null {
        return 0;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRUCT || value.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        value.kind == ExecValueKind.EXEC_VALUE_TUPLE || value.kind == ExecValueKind.EXEC_VALUE_SLICE ||
        value.kind == ExecValueKind.EXEC_VALUE_UNION {
        return 1;
    }
    return exec_value_is_raw_array(value);
}

/// 按值语义比较两个聚合值：元素个数相同且逐元素相等才算相等。
///
/// 结构体比较只看 `i64_value` 会永远得到 0（相等），`!=` 因此恒为假。
///
/// 参数：`left`/`right` 待比较的值。
/// 返回值：-1 表示左小，0 表示相等，1 表示左大。
fn exec_vm_compare_aggregates(left: ExecValue, right: ExecValue) i32 {
    if left.kind != right.kind {
        if (left.kind as i32) < (right.kind as i32) {
            return -1;
        }
        return 1;
    }
    if left.kind == ExecValueKind.EXEC_VALUE_UNION {
        if left.i64_value < right.i64_value { return -1; }
        if left.i64_value > right.i64_value { return 1; }
        return 0;
    }
    const left_ref: &ExecValue = &left;
    const right_ref: &ExecValue = &right;
    const left_count: i32 = exec_value_count(left_ref);
    const right_count: i32 = exec_value_count(right_ref);
    if left_count < right_count { return -1; }
    if left_count > right_count { return 1; }
    var i: i32 = 0;
    while i < left_count {
        const left_item: ExecValue = exec_value_get_index(left_ref, i);
        const right_item: ExecValue = exec_value_get_index(right_ref, i);
        const item_cmp: i32 = exec_vm_compare_values(exec_value_clone(&left_item), exec_value_clone(&right_item));
        if item_cmp != 0 {
            return item_cmp;
        }
        i = i + 1;
    }
    return 0;
}

fn exec_vm_compare_values(left: ExecValue, right: ExecValue) i32 {
    if exec_vm_value_is_aggregate(&left) != 0 || exec_vm_value_is_aggregate(&right) != 0 {
        return exec_vm_compare_aggregates(left, right);
    }
    if exec_value_is_pointer_like(left) != 0 || exec_value_is_pointer_like(right) != 0 {
        const left_u: u64 = left.i64_value as u64;
        const right_u: u64 = right.i64_value as u64;
        if left_u < right_u { return -1; }
        if left_u > right_u { return 1; }
        return 0;
    }
    if exec_vm_value_kind_is_unsigned(left.kind) != 0 {
        const left_u2: u64 = left.i64_value as u64;
        const right_u2: u64 = right.i64_value as u64;
        if left_u2 < right_u2 { return -1; }
        if left_u2 > right_u2 { return 1; }
        return 0;
    }
    if left.i64_value < right.i64_value { return -1; }
    if left.i64_value > right.i64_value { return 1; }
    return 0;
}

fn exec_vm_type_kind_size(kind_code: i32) usize {
    if kind_code == TypeKind.TYPE_BOOL as i32 ||
        kind_code == TypeKind.TYPE_BYTE as i32 ||
        kind_code == TypeKind.TYPE_I8 as i32 ||
        kind_code == TypeKind.TYPE_U8 as i32 {
        return 1 as usize;
    }
    if kind_code == TypeKind.TYPE_I16 as i32 || kind_code == TypeKind.TYPE_U16 as i32 {
        return 2 as usize;
    }
    if kind_code == TypeKind.TYPE_I32 as i32 || kind_code == TypeKind.TYPE_U32 as i32 {
        return 4 as usize;
    }
    if kind_code == TypeKind.TYPE_F32 as i32 {
        return 4 as usize;
    }
    if kind_code == TypeKind.TYPE_ENUM as i32 {
        return 4 as usize;
    }
    if kind_code == TypeKind.TYPE_I64 as i32 || kind_code == TypeKind.TYPE_U64 as i32 ||
        kind_code == TypeKind.TYPE_USIZE as i32 ||
        kind_code == TypeKind.TYPE_F64 as i32 ||
        kind_code == TypeKind.TYPE_POINTER as i32 {
        return @size_of(usize) as usize;
    }
    return 0 as usize;
}

/// 标量值参与「字节视图」时使用的位宽；非标量返回 0。
/// 参数：`value` 目标值。
/// 返回值：该值在 C 布局里的字节数（1/2/4/8），无法按字节访问时返回 0。
fn exec_vm_scalar_view_width(value: &ExecValue) usize {
    if value == null {
        return 0 as usize;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I8 || value.kind == ExecValueKind.EXEC_VALUE_U8 ||
        value.kind == ExecValueKind.EXEC_VALUE_BYTE || value.kind == ExecValueKind.EXEC_VALUE_BOOL {
        return 1 as usize;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I16 || value.kind == ExecValueKind.EXEC_VALUE_U16 {
        return 2 as usize;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I32 || value.kind == ExecValueKind.EXEC_VALUE_U32 ||
        value.kind == ExecValueKind.EXEC_VALUE_F32 {
        return 4 as usize;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I64 || value.kind == ExecValueKind.EXEC_VALUE_U64 ||
        value.kind == ExecValueKind.EXEC_VALUE_ISIZE || value.kind == ExecValueKind.EXEC_VALUE_USIZE ||
        value.kind == ExecValueKind.EXEC_VALUE_F64 || value.kind == ExecValueKind.EXEC_VALUE_POINTER {
        return 8 as usize;
    }
    return 0 as usize;
}

/// 标量值的原始位（低字节在前），用于字节视图读写。
/// 参数：`value` 目标值。
/// 返回值：按 kind 宽度的原始位；非标量返回 0。
fn exec_vm_scalar_view_bits(value: &ExecValue) u64 {
    if value == null {
        return 0 as u64;
    }
    const width: usize = exec_vm_scalar_view_width(value);
    if width == 0 as usize {
        return 0 as u64;
    }
    if width >= 8 as usize {
        return value.i64_value as u64;
    }
    const mask_shift: i32 = (width as i32) *| 8;
    const mask: u64 = (1u64 << mask_shift) -| 1u64;
    return (value.i64_value as u64) & mask;
}

/// 把标量值按「替换某个字节」的方式重建成同 kind 的值。
/// 参数：`value` 原值；`byte_index` 字节下标；`byte_value` 新字节。
/// 返回值：重建后的值（kind/aux 保持不变）。
fn exec_vm_scalar_view_with_byte(value: &ExecValue, byte_index: i64, byte_value: byte) ExecValue {
    var out: ExecValue = value[0];
    const shift: i32 = (byte_index as i32) *| 8;
    const mask: u64 = (255u64 << shift);
    var bits: u64 = (value.i64_value as u64) & ~mask;
    bits = bits | (((byte_value as u64) & 255u64) << shift);
    out.i64_value = bits as i64;
    return out;
}

/// 内部引用能否按字节视图索引：目标必须是 VM 里的标量值本身。
/// 参数：`target` 引用目标值。
/// 返回值：1 表示可以按字节访问，0 表示不可以（聚合/切片/非标量）。
fn exec_vm_scalar_view_supported(target: &ExecValue) i32 {
    if target == null {
        return 0;
    }
    if exec_vm_scalar_view_width(target) == 0 as usize {
        return 0;
    }
    return 1;
}

/// 尝试把「内部引用 + 字节视图」的下标读解释成对 VM 槽内标量的按字节读取。
/// 参数：`function` 当前函数；`base` 引用值；`index_value` 字节下标；`out_value` 输出槽。
/// 返回值：1 已处理；0 不是字节视图（调用方继续原逻辑）；-1 越界错误。
fn exec_vm_try_load_scalar_byte_view(function: &BCFunction, base: &ExecValue,
    index_value: i64, out_value: &ExecValue) i32 {
    if function == null || base == null || out_value == null {
        return 0;
    }
    const ref_kind: i32 = exec_vm_decode_ref_kind(base.aux_i64_value as i32);
    if exec_vm_scalar_view_pointee_is_byte(ref_kind) == 0 {
        return 0;
    }
    const target: &ExecValue = exec_vm_ref_target_value(base);
    if exec_vm_scalar_view_supported(target) == 0 || exec_vm_scalar_view_width(target) <= 1 as usize {
        return 0;
    }
    // 字节视图（`memcpy(&u64, &f64, 8)` 这类位重解释）：内部引用指向的是
    // VM 槽里的标量本身，按字节拆它的原始位，而不是按 ExecValue 步进。
    if exec_vm_scalar_view_index_out_of_range(target, index_value) != 0 {
        exec_backend_set_error(function.decl, "exec: LOAD_INDEX 字节视图越界" as *byte, 0);
        return -1;
    }
    const byte_bits: u64 = exec_vm_scalar_view_bits(target);
    const byte_shift: i32 = (index_value as i32) *| 8;
    const byte_at: u64 = (byte_bits >> byte_shift) & 255u64;
    if ref_kind == TypeKind.TYPE_I8 as i32 {
        out_value[0] = exec_make_i8(byte_at as i8);
    } else if ref_kind == TypeKind.TYPE_U8 as i32 {
        out_value[0] = exec_make_u8(byte_at as u8);
    } else {
        out_value[0] = exec_make_byte(byte_at as i32);
    }
    return 1;
}

/// 尝试把「内部引用 + 字节视图」的下标写解释成对 VM 槽内标量的按字节写入。
/// 参数：`function` 当前函数；`base` 引用值；`index_value` 字节下标；`src_value` 源字节。
/// 返回值：1 已处理；0 不是字节视图；-1 越界错误。
fn exec_vm_try_store_scalar_byte_view(function: &BCFunction, base: &ExecValue,
    index_value: i64, src_value: &ExecValue) i32 {
    if function == null || base == null {
        return 0;
    }
    const ref_kind: i32 = exec_vm_decode_ref_kind(base.aux_i64_value as i32);
    if exec_vm_scalar_view_pointee_is_byte(ref_kind) == 0 {
        return 0;
    }
    const target: &ExecValue = exec_vm_ref_target_value(base);
    if exec_vm_scalar_view_supported(target) == 0 || exec_vm_scalar_view_width(target) <= 1 as usize {
        return 0;
    }
    if exec_vm_scalar_view_index_out_of_range(target, index_value) != 0 {
        exec_backend_set_error(function.decl, "exec: STORE_INDEX 字节视图越界" as *byte, 0);
        return -1;
    }
    const patched: ExecValue = exec_vm_scalar_view_with_byte(target, index_value, src_value[0].i64_value as byte);
    exec_vm_store_slot_shallow(target, patched);
    return 1;
}

/// 引用 pointee kind 是否属于「按字节看」的一类。
/// 参数：`ref_kind` 引用编码里解出的 pointee TypeKind。
/// 返回值：1 表示 BYTE/U8/I8/VOID，0 表示其他。
fn exec_vm_scalar_view_pointee_is_byte(ref_kind: i32) i32 {
    if ref_kind == TypeKind.TYPE_BYTE as i32 || ref_kind == TypeKind.TYPE_U8 as i32 ||
        ref_kind == TypeKind.TYPE_I8 as i32 || ref_kind == TypeKind.TYPE_VOID as i32 {
        return 1;
    }
    return 0;
}

/// 内部引用的字节视图下标是否越界。
/// 参数：`target` 引用目标值；`index_value` 字节下标。
/// 返回值：1 表示越界。
fn exec_vm_scalar_view_index_out_of_range(target: &ExecValue, index_value: i64) i32 {
    if index_value < 0 {
        return 1;
    }
    if (index_value as usize) >= exec_vm_scalar_view_width(target) {
        return 1;
    }
    return 0;
}

fn exec_vm_pointer_address(value: &ExecValue) usize {
    if value == null {
        return 0 as usize;
    }
    return value.i64_value as usize;
}

fn exec_vm_encode_ref_kind(pointee_kind: i32) i32 {
    return EXEC_VM_REF_KIND_BASE +| pointee_kind;
}

fn exec_vm_encode_index_ref_kind(pointee_kind: i32) i32 {
    return EXEC_VM_REF_KIND_INDEX_BASE +| pointee_kind;
}

fn exec_vm_decode_ref_kind(encoded_kind: i32) i32 {
    if encoded_kind >= EXEC_VM_REF_KIND_INDEX_BASE {
        return encoded_kind - EXEC_VM_REF_KIND_INDEX_BASE;
    }
    if encoded_kind >= EXEC_VM_REF_KIND_BASE {
        return encoded_kind - EXEC_VM_REF_KIND_BASE;
    }
    return TypeKind.TYPE_VOID as i32;
}

fn exec_vm_pointer_is_internal_ref(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_POINTER {
        return 0;
    }
    return (value.aux_i64_value as i32 >= EXEC_VM_REF_KIND_BASE) as i32;
}

fn exec_vm_pointer_is_index_base_ref(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_POINTER {
        return 0;
    }
    return (value.aux_i64_value as i32 >= EXEC_VM_REF_KIND_INDEX_BASE) as i32;
}

fn exec_vm_make_value_ref(target: &ExecValue, pointee_kind: i32) ExecValue {
    if target == null {
        return exec_make_pointer_with_kind(0 as usize, exec_vm_encode_ref_kind(pointee_kind));
    }
    const target_addr: usize = @usize_from_ptr(target as &void);
    return exec_make_pointer_with_kind(target_addr, exec_vm_encode_ref_kind(pointee_kind));
}

fn exec_vm_make_index_ref_from_addr(addr: usize, pointee_kind: i32) ExecValue {
    return exec_make_pointer_with_kind(addr, exec_vm_encode_index_ref_kind(pointee_kind));
}

fn exec_vm_make_index_value_ref(target: &ExecValue, pointee_kind: i32) ExecValue {
    if target == null {
        return exec_make_pointer_with_kind(0 as usize, exec_vm_encode_index_ref_kind(pointee_kind));
    }
    const target_addr: usize = @usize_from_ptr(target as &void);
    return exec_make_pointer_with_kind(target_addr, exec_vm_encode_index_ref_kind(pointee_kind));
}

fn exec_vm_ref_target_value(value: &ExecValue) &ExecValue {
    if exec_vm_pointer_is_internal_ref(value) == 0 {
        return null;
    }
    const target_addr: usize = exec_vm_pointer_address(value);
    if target_addr == 0 as usize {
        return null;
    }
    return @ptr_from_usize(target_addr) as &ExecValue;
}

// INDEX 基引用指向 aggregate.values 数组里的 ExecValue，元素步长固定为 sizeof(ExecValue)。
// 参数：base - INDEX 基引用；index_value - 元素序号。返回：目标元素地址。
fn exec_vm_index_ref_element_addr(base: &ExecValue, index_value: i64) usize {
    const base_addr: usize = base.i64_value as usize;
    return base_addr + (@size_of(ExecValue) as usize) * (index_value as usize);
}

fn exec_vm_box_value_ref(value: ExecValue, pointee_kind: i32) ExecValue {
    const boxed: &ExecValue = exec_value_alloc_bytes(@size_of(ExecValue)) as &ExecValue;
    if boxed == null {
        return exec_make_pointer_with_kind(0 as usize, exec_vm_encode_ref_kind(pointee_kind));
    }
    boxed[0] = exec_value_clone(&value);
    exec_value_register_boxed(@usize_from_ptr(boxed as &void));
    return exec_vm_make_value_ref(boxed, pointee_kind);
}

fn exec_vm_aggregate_ref_from_value(value: &ExecValue) &ExecAggregate {
    if value == null {
        return null;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
        value.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        value.kind == ExecValueKind.EXEC_VALUE_TUPLE {
        return exec_value_as_aggregate(value);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER && exec_vm_pointer_is_internal_ref(value) == 0 {
        // 裸指针指向聚合：`p.field` 等价于旁路表第 0 个元素。
        const pointee_kind_code: i32 = exec_value_pointer_pointee_kind(value);
        if exec_vm_type_kind_size(pointee_kind_code) == 0 as usize {
            const elem: &ExecValue = exec_vm_native_agg_slot(exec_vm_pointer_address(value), 0);
            if elem != null {
                return exec_value_as_aggregate(elem);
            }
        }
        return null;
    }
    if exec_vm_pointer_is_internal_ref(value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(value);
        if target == null {
            return null;
        }
        const direct_aggregate: &ExecAggregate = exec_value_as_aggregate(target);
        if direct_aggregate != null {
            return direct_aggregate;
        }
        if exec_value_is_pointer_like(target[0]) != 0 && exec_vm_pointer_is_internal_ref(target) != 0 {
            const nested_target: &ExecValue = exec_vm_ref_target_value(target);
            if nested_target != null {
                return exec_value_as_aggregate(nested_target);
            }
        }
    }
    return null;
}

/// STORE_FIELD 的字段引用：允许把未初始化的槽位就地长成一个结构体。
/// 原生指针上的聚合元素只能按需落地，第一次写字段时给它一个足够大的容量，
/// 之后所有字段写入都只是改 ExecValue 元素，不再越界。
/// 参数：value 目标对象；field_idx 字段下标。
/// 返回值：字段槽位；无法建立返回 null。
fn exec_vm_field_ref_store(value: &ExecValue, field_idx: i32) &ExecValue {
    if value == null || field_idx < 0 || field_idx >= 64 {
        return null;
    }
    const object: &ExecValue = exec_vm_field_object(value);
    if object == null {
        return null;
    }
    if object.kind == ExecValueKind.EXEC_VALUE_VOID {
        object[0] = exec_value_make_aggregate(ExecValueKind.EXEC_VALUE_STRUCT, 64);
    }
    const aggregate: &ExecAggregate = exec_vm_aggregate_ref_from_value(object);
    if aggregate == null || field_idx >= aggregate.count {
        return null;
    }
    return &aggregate.values[field_idx];
}

/// 取字段访问真正要读写的对象：沿引用/裸指针自动解引用到聚合为止。
/// 参数：value 字段访问的基值。
/// 返回值：聚合对象的 ExecValue；无法解析返回 null。
/// 插值实参里 `%s` 需要 C 字符串：切片先取首字节指针再当字符串用。
/// 参数：value 实参值。
/// 返回值：可直接给 exec_format_render 的值。
fn exec_vm_interp_string_arg(value: ExecValue) ExecValue {
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(&value);
        if slice_data != null && slice_data.raw_ptr != null {
            return exec_make_string(slice_data.raw_ptr);
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER && exec_vm_pointer_is_internal_ref(&value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(&value);
        if target != null && target.kind == ExecValueKind.EXEC_VALUE_STRING {
            return exec_make_string(target.ptr_value);
        }
    }
    return value;
}

fn exec_vm_field_object(value: &ExecValue) &ExecValue {
    if value == null {
        return null;
    }
    var object: &ExecValue = value;
    var depth: i32 = 0;
    while depth < 4 {
        if object.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
            object.kind == ExecValueKind.EXEC_VALUE_TUPLE ||
            object.kind == ExecValueKind.EXEC_VALUE_UNION {
            return object;
        }
        if object.kind == ExecValueKind.EXEC_VALUE_POINTER {
            if exec_vm_pointer_is_internal_ref(object) != 0 {
                const target: &ExecValue = exec_vm_ref_target_value(object);
                if target == null {
                    return null;
                }
                object = target;
            } else {
                // 指针地址落在 VM 内存里（没带内部引用编码的裸地址）：直接把它
                // 当成指向 ExecValue 的指针。`&struct` 经强制转换/取下标拿到的
                // 指针常常丢掉引用编码，不兜住就会退化成「字段越界」。
                const raw_field_addr: usize = exec_vm_pointer_address(object);
                if exec_vm_address_is_vm_resident(raw_field_addr) {
                    const direct: &ExecValue = @ptr_from_usize(raw_field_addr) as &ExecValue;
                    if direct != null && (direct.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
                            direct.kind == ExecValueKind.EXEC_VALUE_TUPLE ||
                            direct.kind == ExecValueKind.EXEC_VALUE_UNION) {
                        object = direct;
                        depth = depth + 1;
                        continue;
                    }
                }
                const pointee_kind_code: i32 = exec_value_pointer_pointee_kind(object);
                if exec_vm_type_kind_size(pointee_kind_code) != 0 as usize {
                    return null;
                }
                const elem: &ExecValue = exec_vm_native_agg_slot(raw_field_addr, 0);
                if elem == null {
                    return null;
                }
                object = elem;
            }
            depth = depth + 1;
            continue;
        }
        return object;
    }
    return null;
}

/// 解码 LOAD_FIELD/STORE_FIELD 里打包的原生字段信息。
/// 参数：`imm` 指令立即数；`shift` 打包位偏移（32 kind、40 pointee）。
/// 返回值：`kind+1` 编码值，未打包返回 0。
fn exec_vm_field_imm_kind(imm: i64, shift: i32) i32 {
    var bits: i64 = imm >> shift;
    bits = bits & (0xFF as i64);
    return bits as i32;
}

/// 解码原生数组字段的元素个数（打包的是 `个数-1`，占高 16 位）。
/// 参数：`imm` 指令立即数。
/// 返回值：元素个数（未打包时返回 1）。
fn exec_vm_field_imm_count(imm: i64) i32 {
    var bits: i64 = imm >> 48;
    bits = bits & (0xFFFF as i64);
    return (bits as i32) +| 1;
}

/// 沿引用链找「原生结构体基址」。
/// `&local`（local 是 `&T`）会产出「指向指针槽的引用」，沿引用解到最后一个指针值
/// 就能拿到真正的宿主地址。地址落在 VM 值竞技场里说明它其实是 VM 值（走聚合语义），
/// 只有落在竞技场之外才是 `malloc`/`mmap` 回来的原生结构体。
/// 参数：`object` 字段访问的基值。
/// 返回值：宿主基址；不是原生结构体访问返回 0。
// VM 值驻留区的额外范围：全局槽数组（值竞技场由 value.uya 自己判断）。
var g_exec_vm_globals_base: usize = 0;
var g_exec_vm_globals_end: usize = 0;

/// 判断地址是否属于「VM 值驻留区」：值竞技场、帧槽位池、全局槽数组、原生聚合旁路表。
/// 原生结构体字段访问只在地址**不**驻留于 VM 时才启用；这个判据必须完整，
/// 漏掉任何一个范围都会让「引用指向 VM 自己的内存」被误判成原生内存。
/// 参数：`addr` 绝对地址。
/// 返回值：true 表示这是 VM 自己的内存。
fn exec_vm_address_is_vm_resident(addr: usize) bool {
    if addr == 0 as usize {
        return false;
    }
    if exec_vm_address_is_value(addr) {
        return true;
    }
    var pool_base: usize = 0 as usize;
    var pool_size: usize = 0 as usize;
    exec_vm_slot_pool_range(&pool_base, &pool_size);
    if pool_base != 0 as usize && addr >= pool_base && addr < pool_base +| pool_size {
        return true;
    }
    if g_exec_vm_globals_base != 0 && addr >= g_exec_vm_globals_base && addr < g_exec_vm_globals_end {
        return true;
    }
    return false;
}

/// 地址是否指向一个确实存放 ExecValue 的元素槽。
///
/// 与 `exec_vm_address_is_vm_resident` 的区别：不含原生聚合旁路表
/// 旁路表，并且竞技场内部还要再查聚合元素登记表 —— 竞技场里同时住着
/// ExecValue 数组和裸字节缓冲（源码文本、捕获缓冲），只看「在竞技场里」
/// 会把缓冲字节当成 kind/count 解出来（fmt/json/yaml 系列因此崩溃）。
///
/// 参数：`addr` 待判定地址。
/// 返回值：true 表示可以安全地 `@ptr_from_usize(addr) as &ExecValue`。
fn exec_vm_address_is_exec_value_storage(addr: usize) bool {
    if addr == 0 as usize {
        return false;
    }
    // 竞技场：必须是登记过的聚合元素数组中的元素地址。
    if exec_vm_address_is_value(addr) {
        return exec_value_address_is_array_element(addr);
    }
    var pool_base: usize = 0 as usize;
    var pool_size: usize = 0 as usize;
    exec_vm_slot_pool_range(&pool_base, &pool_size);
    if pool_base != 0 as usize && addr >= pool_base && addr < pool_base +| pool_size {
        return (addr -| pool_base) % (@size_of(ExecValue) as usize) == 0 as usize;
    }
    if g_exec_vm_globals_base != 0 && addr >= g_exec_vm_globals_base && addr < g_exec_vm_globals_end {
        return (addr -| g_exec_vm_globals_base) % (@size_of(ExecValue) as usize) == 0 as usize;
    }
    // 独立分配的单个 ExecValue（`exec_vm_box_value_ref` 之类）：借用登记表
    // 的「单元素数组」形态不可得，这里用旁路表之外的最小判据 —— 只接受
    // 由 `exec_vm_box_value_ref` 记录过的地址。
    return exec_value_address_is_boxed(addr);
}

/// `exec_vm_field_native_base` 的宽松版：只要求「非内部引用指针 + 非零地址」，
/// 不再排除落在 VM 驻留区里的地址。
///
/// async 帧池这类分配器给出的字节块地址**可能**正好落在值 arena 的地址范围
/// 里，但内容是按原生布局排的（不是 `ExecValue`）。严格版把这类地址当成 VM
/// 值而拒绝，`STORE_FIELD` / `LOAD_FIELD` 于是报「字段越界」
/// （`test_async_frame_align_pool` 就是这么挂的）。
///
/// 只在「按 VM 值取字段确实失败」之后才退到这里，所以不会把真正的 ExecValue
/// 聚合误判成原生内存。
fn exec_vm_field_native_base_relaxed(object: &ExecValue) usize {
    if object == null || object.kind != ExecValueKind.EXEC_VALUE_POINTER {
        return 0 as usize;
    }
    if exec_vm_pointer_is_internal_ref(object) != 0 {
        return 0 as usize;
    }
    return exec_vm_pointer_address(object);
}

fn exec_vm_field_native_base(object: &ExecValue) usize {
    var cursor: &ExecValue = object;
    var depth: i32 = 0;
    while cursor != null && depth < 8 {
        if cursor.kind != ExecValueKind.EXEC_VALUE_POINTER {
            return 0 as usize;
        }
        const addr: usize = exec_vm_pointer_address(cursor);
        if addr == 0 as usize {
            return 0 as usize;
        }
        if exec_vm_pointer_is_internal_ref(cursor) == 0 {
            if exec_vm_address_is_vm_resident(addr) {
                return 0 as usize;
            }
            return addr;
        }
        const target: &ExecValue = exec_vm_ref_target_value(cursor);
        if target == null {
            return 0 as usize;
        }
        if exec_vm_address_is_vm_resident(addr) {
            // 引用目标是 VM 值：只有「指向指针槽」时才继续沿链。
            if target.kind != ExecValueKind.EXEC_VALUE_POINTER {
                return 0 as usize;
            }
            cursor = target;
            depth = depth + 1;
            continue;
        }
        // 引用目标不在 VM 驻留区里：这块内存是原生的，直接当基址。
        return addr;
    }
    return 0 as usize;
}

/// 按 C99 字段类型从原生内存读出一个 VM 值。
/// 参数：`kind_code` 字段 TypeKind；`pointee_kind_code` 指针字段的 pointee TypeKind（<=0 未知）；
/// `addr` 字段绝对地址。
/// 返回值：字段值；kind 不支持返回 VOID。
fn exec_vm_native_field_load(kind_code: i32, pointee_kind_code: i32, elem_count: i32, addr: usize) ExecValue {
    if addr == 0 as usize {
        return exec_make_void();
    }
    if kind_code == TypeKind.TYPE_ARRAY as i32 {
        // 原生结构体里的定长数组字段：给出指向数据区的数组视图（不拷贝）。
        // 只对**标量元素**生成视图：指针元素的 VM 值可能带引用编码，写进原生槽位
        // 再读回来就是野指针（实测会段错误），那类字段继续走 VM 聚合语义。
        if pointee_kind_code > 0 && elem_count > 0 &&
            exec_value_is_raw_array_element_type(pointee_kind_code) != 0 {
            return exec_value_make_raw_array_view(elem_count, pointee_kind_code,
                @ptr_from_usize(addr) as &byte);
        }
        return exec_make_void();
    }
    if kind_code == TypeKind.TYPE_I8 as i32 {
        const p8: *i8 = @ptr_from_usize(addr) as *i8;
        return exec_make_i8(p8[0]);
    }
    if kind_code == TypeKind.TYPE_I16 as i32 {
        const p16: *i16 = @ptr_from_usize(addr) as *i16;
        return exec_make_i16(p16[0]);
    }
    if kind_code == TypeKind.TYPE_I32 as i32 || kind_code == TypeKind.TYPE_ENUM as i32 {
        const p32: *i32 = @ptr_from_usize(addr) as *i32;
        return exec_make_i32(p32[0]);
    }
    if kind_code == TypeKind.TYPE_I64 as i32 {
        const p64: *i64 = @ptr_from_usize(addr) as *i64;
        return exec_make_i64(p64[0]);
    }
    if kind_code == TypeKind.TYPE_BYTE as i32 {
        const pb: *u8 = @ptr_from_usize(addr) as *u8;
        return exec_make_byte(pb[0] as i32);
    }
    if kind_code == TypeKind.TYPE_BOOL as i32 {
        const pbl: *u8 = @ptr_from_usize(addr) as *u8;
        return exec_make_bool((pbl[0] != 0) as i32);
    }
    if kind_code == TypeKind.TYPE_U8 as i32 {
        const pu8: *u8 = @ptr_from_usize(addr) as *u8;
        return exec_make_u8(pu8[0]);
    }
    if kind_code == TypeKind.TYPE_U16 as i32 {
        const pu16: *u16 = @ptr_from_usize(addr) as *u16;
        return exec_make_u16(pu16[0]);
    }
    if kind_code == TypeKind.TYPE_U32 as i32 {
        const pu32: *u32 = @ptr_from_usize(addr) as *u32;
        return exec_make_u32(pu32[0]);
    }
    if kind_code == TypeKind.TYPE_USIZE as i32 {
        const pus: *usize = @ptr_from_usize(addr) as *usize;
        return exec_make_usize(pus[0]);
    }
    if kind_code == TypeKind.TYPE_U64 as i32 {
        const pu64: *u64 = @ptr_from_usize(addr) as *u64;
        return exec_make_u64(pu64[0]);
    }
    if kind_code == TypeKind.TYPE_F32 as i32 {
        const pf32: *u32 = @ptr_from_usize(addr) as *u32;
        return exec_make_f32_bits(pf32[0]);
    }
    if kind_code == TypeKind.TYPE_F64 as i32 {
        const pf64: *u64 = @ptr_from_usize(addr) as *u64;
        return exec_make_f64_bits(pf64[0]);
    }
    if kind_code == TypeKind.TYPE_STRUCT as i32 || kind_code == TypeKind.TYPE_UNION as i32 ||
        kind_code == TypeKind.TYPE_TUPLE as i32 {
        // 原生结构体里的**按值嵌套结构体**字段：给出指向字段内存的指针视图。
        // 以前这里返回 VOID，于是 `chunk.header.size` 这种链式字段访问在 VM 里
        // 直接报 `LOAD_FIELD 字段越界`（libc 堆的 `&chunk.header` 全是这个形态）。
        return exec_make_pointer_with_kind(addr, kind_code);
    }
    if kind_code == TypeKind.TYPE_POINTER as i32 {
        const pp: *usize = @ptr_from_usize(addr) as *usize;
        const target_addr: usize = pp[0];
        if pointee_kind_code <= 0 {
            return exec_make_pointer_with_kind(target_addr, TypeKind.TYPE_VOID as i32);
        }
        return exec_make_pointer_with_kind(target_addr, pointee_kind_code);
    }
    return exec_make_void();
}

/// 把 VM 值按 C99 字段类型写回原生内存。
/// 参数：`kind_code` 字段 TypeKind；`addr` 字段绝对地址；`value` 待写入的值。
/// 返回值：1 写入成功；0 kind 不支持。
fn exec_vm_native_field_store(kind_code: i32, addr: usize, value: ExecValue) i32 {
    if addr == 0 as usize {
        return 0;
    }
    if kind_code == TypeKind.TYPE_I8 as i32 || kind_code == TypeKind.TYPE_U8 as i32 ||
        kind_code == TypeKind.TYPE_BYTE as i32 || kind_code == TypeKind.TYPE_BOOL as i32 {
        const pu8s: *u8 = @ptr_from_usize(addr) as *u8;
        pu8s[0] = (value.i64_value & (0xFF as i64)) as u8;
        return 1;
    }
    if kind_code == TypeKind.TYPE_I16 as i32 || kind_code == TypeKind.TYPE_U16 as i32 {
        const pu16s: *u16 = @ptr_from_usize(addr) as *u16;
        pu16s[0] = (value.i64_value & (0xFFFF as i64)) as u16;
        return 1;
    }
    if kind_code == TypeKind.TYPE_I32 as i32 || kind_code == TypeKind.TYPE_U32 as i32 ||
        kind_code == TypeKind.TYPE_ENUM as i32 || kind_code == TypeKind.TYPE_F32 as i32 {
        const pu32s: *u32 = @ptr_from_usize(addr) as *u32;
        pu32s[0] = (value.i64_value & (0xFFFFFFFF as i64)) as u32;
        return 1;
    }
    if kind_code == TypeKind.TYPE_USIZE as i32 || kind_code == TypeKind.TYPE_U64 as i32 ||
        kind_code == TypeKind.TYPE_I64 as i32 || kind_code == TypeKind.TYPE_POINTER as i32 ||
        kind_code == TypeKind.TYPE_F64 as i32 {
        const pu64s: *u64 = @ptr_from_usize(addr) as *u64;
        pu64s[0] = value.i64_value as u64;
        return 1;
    }
    return 0;
}

fn exec_vm_field_ref(value: &ExecValue, field_idx: i32) &ExecValue {
    const object: &ExecValue = exec_vm_field_object(value);
    if object == null {
        return null;
    }
    const aggregate: &ExecAggregate = exec_vm_aggregate_ref_from_value(object);
    if aggregate == null || field_idx < 0 || field_idx >= aggregate.count {
        return null;
    }
    return &aggregate.values[field_idx];
}

fn exec_vm_file_fd_from_value(value: &ExecValue) i32 {
    if value == null {
        return -1;
    }
    if exec_vm_pointer_is_internal_ref(value) == 0 {
        return -1;
    }
    const file_value: &ExecValue = exec_vm_ref_target_value(value);
    if file_value == null {
        return -1;
    }
    const fd_field: &ExecValue = exec_vm_field_ref(file_value, 0);
    if fd_field == null {
        return -1;
    }
    return fd_field.i64_value as i32;
}

fn exec_vm_raw_array_element_ptr(value: &ExecValue, index_value: i32) ExecValue {
    if value == null || exec_value_is_raw_array(value) == 0 || index_value < 0 {
        return exec_make_void();
    }
    const count: i32 = value.i64_value as i32;
    const elem_kind: i32 = exec_value_raw_array_element_kind(value);
    const elem_size: usize = exec_vm_type_kind_size(elem_kind);
    if index_value >= count || elem_size == 0 as usize {
        return exec_make_void();
    }
    const base_ptr: &byte = exec_value_raw_array_ptr(value);
    if base_ptr == null {
        return exec_make_void();
    }
    const addr: usize = @usize_from_ptr(base_ptr as &void) + elem_size * (index_value as usize);
    return exec_make_pointer_with_kind(addr, elem_kind);
}

fn exec_vm_raw_array_slice_ptr(value: &ExecValue, index_value: i32) ExecValue {
    if value == null || exec_value_is_raw_array(value) == 0 || index_value < 0 {
        return exec_make_void();
    }
    const count: i32 = value.i64_value as i32;
    const elem_kind: i32 = exec_value_raw_array_element_kind(value);
    const elem_size: usize = exec_vm_type_kind_size(elem_kind);
    if index_value > count || elem_size == 0 as usize {
        return exec_make_void();
    }
    const base_ptr: &byte = exec_value_raw_array_ptr(value);
    if base_ptr == null {
        if index_value == 0 && count == 0 {
            return exec_make_pointer_with_kind(0 as usize, elem_kind);
        }
        return exec_make_void();
    }
    const addr: usize = @usize_from_ptr(base_ptr as &void) + elem_size * (index_value as usize);
    return exec_make_pointer_with_kind(addr, elem_kind);
}

// 指针算术：`ptr ± n` 按 pointee 元素大小缩放，`ptr - ptr` 返回元素个数。
// 参数：function - 当前函数（错误定位）；base - 指针操作数；offset - 偏移量或另一指针；
// subtract - 1 表示减法。返回：结果值；非法元素类型时返回 void 并设置错误。
fn exec_vm_pointer_add(function: &BCFunction, base: &ExecValue, offset: &ExecValue, subtract: i32) ExecValue {
    if base == null || offset == null {
        return exec_make_void();
    }
    const pointee_kind: i32 = exec_value_pointer_pointee_kind(base);
    var elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    var eff_pointee: i32 = pointee_kind;
    if elem_size == 0 as usize && pointee_kind == TypeKind.TYPE_VOID as i32 {
        // `&byte` / `&void` 的字节指针：pointee 编码可能是 VOID（字段读取路径
        // 只带宽度不带元素类型）。与 `exec_vm_load_pointer_index` /
        // `exec_vm_store_pointer_index` 保持一致，按 1 字节步进，而不是直接报错。
        eff_pointee = TypeKind.TYPE_BYTE as i32;
        elem_size = 1 as usize;
    }
    if elem_size == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 指针算术不支持该元素类型" as *byte, 0);
        return exec_make_void();
    }
    var effective_sub: i32 = (subtract != 0) as i32;
    if effective_sub != 0 && offset.kind == ExecValueKind.EXEC_VALUE_POINTER {
        return exec_make_i64((base.i64_value -| offset.i64_value) / (elem_size as i64));
    }
    var magnitude: usize = offset.i64_value as usize;
    if offset.i64_value < 0 {
        var neg_value: i64 = 0 as i64 -| offset.i64_value;
        magnitude = neg_value as usize;
        if effective_sub != 0 {
            effective_sub = 0;
        } else {
            effective_sub = 1;
        }
    }
    const scaled: usize = elem_size * magnitude;
    if effective_sub != 0 {
        return exec_make_pointer_with_kind((base.i64_value as usize) -| scaled, eff_pointee);
    }
    return exec_make_pointer_with_kind((base.i64_value as usize) +| scaled, eff_pointee);
}

fn exec_vm_raw_slice_element_ptr(value: &ExecValue, index_value: i32, allow_end: i32) ExecValue {
    if value == null || exec_value_is_raw_slice(value) == 0 || index_value < 0 {
        return exec_make_void();
    }
    const count: i32 = exec_value_count(value);
    const elem_kind: i32 = exec_value_slice_element_kind(value);
    const elem_size: usize = exec_vm_type_kind_size(elem_kind);
    if elem_size == 0 as usize {
        return exec_make_void();
    }
    if index_value > count || (allow_end == 0 && index_value >= count) {
        return exec_make_void();
    }
    const base_ptr: &byte = exec_value_slice_raw_ptr(value);
    if base_ptr == null {
        if index_value == 0 && count == 0 {
            return exec_make_pointer_with_kind(0 as usize, elem_kind);
        }
        return exec_make_void();
    }
    const addr: usize = @usize_from_ptr(base_ptr as &void) + elem_size * (index_value as usize);
    return exec_make_pointer_with_kind(addr, elem_kind);
}

fn exec_vm_slice_ptr_value(value: &ExecValue, pointee_kind: i32) ExecValue {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_SLICE {
        return exec_make_void();
    }
    if exec_value_is_raw_slice(value) != 0 {
        const raw_ptr: &byte = exec_value_slice_raw_ptr(value);
        if raw_ptr == null {
            return exec_make_pointer_with_kind(0 as usize, pointee_kind);
        }
        return exec_make_pointer_with_kind(@usize_from_ptr(raw_ptr as &void), pointee_kind);
    }
    const slice_data: &ExecSliceData = exec_value_as_slice(value);
    if slice_data == null || slice_data.aggregate == null || slice_data.aggregate.values == null {
        return exec_make_pointer_with_kind(0 as usize, pointee_kind);
    }
    if slice_data.start < 0 || slice_data.start >= slice_data.aggregate.count {
        return exec_make_pointer_with_kind(0 as usize, pointee_kind);
    }
    return exec_vm_make_index_value_ref(&slice_data.aggregate.values[slice_data.start], pointee_kind);
}

// 原生指针上的聚合元素旁路表。
// `arena_alloc` 之类返回的是原生内存，里面放不下 ExecValue；
// 以「基地址 → ExecValue 数组」的旁路表承接 `ptr[i].field` 的读写。
const EXEC_NATIVE_AGG_MAX_BASES: i32 = 256;
// 每基址元素上限现在是「按需增长」的上界，不再是静态数组维度：
// 动态扩容的 epoll 用例会往同一个原生数组里写到 1025 个元素，静态 512 会
// 直接判越界（`exec: 当前不支持该指针元素类型`）。
const EXEC_NATIVE_AGG_MAX_ELEMS: i32 = 65536;

var g_native_agg_base: [usize: 256] = [];
var g_native_agg_count: [i32: 256] = [];
var g_native_agg_caps: [i32: 256] = [];
var g_native_agg_storage: [&ExecValue: 256] = [];
var g_native_agg_handles: [ExecAggregate: 256] = [];
var g_native_agg_used: i32 = 0;

/// 保证某条旁路表基址至少能容纳 `need` 个元素（倍增扩容，旧内容整体搬过去）。
/// 参数：`slot` 基址条目下标；`need` 需要的元素个数。
/// 返回值：0 成功，-1 无法分配。
fn exec_vm_native_agg_ensure(slot: i32, need: i32) i32 {
    if slot < 0 || slot >= EXEC_NATIVE_AGG_MAX_BASES || need <= 0 {
        return -1;
    }
    var want: i32 = need;
    if want > EXEC_NATIVE_AGG_MAX_ELEMS {
        want = EXEC_NATIVE_AGG_MAX_ELEMS;
    }
    const old_cap: i32 = g_native_agg_caps[slot];
    if old_cap >= want {
        return 0;
    }
    var cap: i32 = old_cap;
    if cap <= 0 {
        cap = 16;
    }
    while cap < want && cap < EXEC_NATIVE_AGG_MAX_ELEMS {
        cap = cap *| 2;
    }
    if cap > EXEC_NATIVE_AGG_MAX_ELEMS {
        cap = EXEC_NATIVE_AGG_MAX_ELEMS;
    }
    const bytes: usize = (@size_of(ExecValue) as usize) * (cap as usize);
    const mem: &ExecValue = exec_value_alloc_bytes(bytes) as &ExecValue;
    if mem == null {
        return -1;
    }
    // 新槽位一律先清零（kind=VOID）：越界读永远走不到这里，但扩容时未初始化
    // 的字节一旦被当成 ExecValue 解出来就是随机 kind，必须抹掉。
    _ = memset(mem as *void, 0, bytes);
    const old_mem: &ExecValue = g_native_agg_storage[slot];
    if old_mem != null {
        var i: i32 = 0;
        while i < old_cap {
            mem[i] = old_mem[i];
            i = i + 1;
        }
    }
    g_native_agg_storage[slot] = mem;
    g_native_agg_caps[slot] = cap;
    g_native_agg_handles[slot].values = mem;
    return 0;
}

/// 查找或建立原生指针聚合元素旁路表的条目。
/// 参数：base 指针地址。
/// 返回值：条目下标；无法建立返回 -1。
fn exec_vm_native_agg_slot_index(base: usize) i32 {
    if base == 0 as usize {
        return -1;
    }
    var slot: i32 = -1;
    var i: i32 = 0;
    while i < g_native_agg_used {
        if g_native_agg_base[i] == base {
            slot = i;
            break;
        }
        i = i + 1;
    }
    if slot >= 0 {
        return slot;
    }
    if g_native_agg_used < 0 || g_native_agg_used >= EXEC_NATIVE_AGG_MAX_BASES {
        return -1;
    }
    slot = g_native_agg_used;
    g_native_agg_base[slot] = base;
    g_native_agg_count[slot] = 0;
    g_native_agg_handles[slot].count = 0;
    g_native_agg_caps[slot] = 0;
    g_native_agg_storage[slot] = null;
    g_native_agg_used = slot + 1;
    return slot;
}

/// realloc 把块搬到新地址时，同步搬旁路表的基址键。
/// 参数：`old_base` 旧基址；`new_base` 新基址。
/// 返回值：无。
/// 旁路表按基址**线性**查找（`exec_vm_native_agg_slot_index`），改键不影响
/// 任何顺序不变量；但漏搬就会让扩容前写进去的元素读不回来
/// （`env_ops[0]` 在追加第二项后变成 VOID，接着 `.remove` 就 LOAD_FIELD 越界）。
fn exec_vm_native_agg_rebase(old_base: usize, new_base: usize) void {
    if old_base == 0 as usize || new_base == 0 as usize || old_base == new_base {
        return;
    }
    var i: i32 = 0;
    while i < g_native_agg_used {
        if g_native_agg_base[i] == old_base {
            g_native_agg_base[i] = new_base;
        }
        i = i + 1;
    }
}

/// 把旁路表里 `src_base` 名下的元素整体搬到 `dst_base` 名下。
/// 参数：`src_base` 源原生基址；`dst_base` 目标原生基址。
/// 返回值：无。
/// `malloc + memcpy + free` 这种「每追加一项就换块」的写法（`process.uya` 的
/// `env_ops`）里，结构体元素只活在旁路表，原生字节是空的：memcpy 抄过去的是
/// 没写过的内存，之后按新基址读自然全是 VOID。搬键就是把语义上的值一起搬。
fn exec_vm_native_agg_carry(src_base: usize, dst_base: usize) void {
    if src_base == 0 as usize || dst_base == 0 as usize || src_base == dst_base {
        return;
    }
    var i: i64 = 0;
    while i < (EXEC_NATIVE_AGG_MAX_ELEMS as i64) {
        const src_elem: &ExecValue = exec_vm_native_agg_peek(src_base, i);
        if src_elem == null {
            return;
        }
        const dst_elem: &ExecValue = exec_vm_native_agg_slot(dst_base, i);
        if dst_elem == null {
            return;
        }
        dst_elem[0] = exec_value_clone(src_elem);
        i = i + 1;
    }
}

/// 释放原生块时丢掉它名下的旁路表条目。
/// 参数：`base` 即将释放的原生基址。
/// 返回值：无。不丢的话，地址被后续 `malloc` 复用时会把上一位使用者的
/// 元素值「复活」（读到本不该存在的数据）。
fn exec_vm_native_agg_forget(base: usize) void {
    if base == 0 as usize {
        return;
    }
    var i: i32 = 0;
    while i < g_native_agg_used {
        if g_native_agg_base[i] == base {
            g_native_agg_base[i] = 0 as usize;
            g_native_agg_count[i] = 0;
            g_native_agg_handles[i].count = 0;
            g_native_agg_storage[i] = null;
            return;
        }
        i = i + 1;
    }
}

/// 查找原生指针第 index 个聚合元素的**已登记**旁路槽位（不建表）。
///
/// `STORE_INDEX` 往原生结构体数组写元素时，元素是 VM 聚合，无法落进 C 布局，
/// 只能存进旁路表。`LOAD_INDEX` 若还按 `elem_size_hint` 返回「指向原生缓冲区」
/// 的指针，读到的就是从未被写过的原始字节（`Vec<SomeStruct>` 的 `push`/`get`
/// 因此恒得零值）。读侧必须先来这里对一次账。
///
/// 参数：`base` 原生基址；`index` 元素下标。
/// 返回值：已写入的旁路槽位；未登记或未写到该下标返回 null。
fn exec_vm_native_agg_peek(base: usize, index: i64) &ExecValue {
    if base == 0 as usize || index < 0 || index >= (EXEC_NATIVE_AGG_MAX_ELEMS as i64) {
        return null;
    }
    var i: i32 = 0;
    while i < g_native_agg_used {
        if g_native_agg_base[i] == base {
            if (index as i32) < g_native_agg_count[i] {
                const storage: &ExecValue = g_native_agg_storage[i];
                if storage == null {
                    return null;
                }
                return &storage[index as i32];
            }
            return null;
        }
        i = i + 1;
    }
    return null;
}

/// 把一条原生聚合旁路表里的元素整体迁到另一条基址（`memcpy` 用）。
///
/// 原生结构体数组的元素是 VM 聚合，真实内容在原生聚合旁路表里，
/// 原生缓冲区上只有从未写过的原始字节。`memcpy` 若只搬字节，目标基址的旁路表
/// 就是空的 —— 之后 `dst[i]` 读到 null，字段访问直接 `LOAD_FIELD 字段越界`。
///
/// 参数：`dst_base` 目标基址；`src_base` 源基址。
/// 返回值：迁移的元素个数；源没有登记返回 0。
fn exec_vm_native_agg_migrate(dst_base: usize, src_base: usize) i32 {
    if dst_base == 0 as usize || src_base == 0 as usize || dst_base == src_base {
        return 0;
    }
    var src_slot: i32 = -1;
    var i: i32 = 0;
    while i < g_native_agg_used {
        if g_native_agg_base[i] == src_base {
            src_slot = i;
            break;
        }
        i = i + 1;
    }
    if src_slot < 0 || src_slot >= EXEC_NATIVE_AGG_MAX_BASES {
        return 0;
    }
    if g_native_agg_count[src_slot] <= 0 {
        return 0;
    }
    const count: i32 = g_native_agg_count[src_slot];
    var j: i32 = 0;
    while j < count && j < EXEC_NATIVE_AGG_MAX_ELEMS {
        const dst_elem: &ExecValue = exec_vm_native_agg_slot(dst_base, j as i64);
        if dst_elem == null {
            break;
        }
        const src_storage: &ExecValue = g_native_agg_storage[src_slot];
        if src_storage == null {
            break;
        }
        dst_elem[0] = exec_value_clone(&src_storage[j]);
        j = j + 1;
    }
    return j;
}

/// 取原生指针第 index 个聚合元素对应的 ExecValue 槽位（按需建表）。
/// 参数：base 指针地址；index 元素下标。
/// 返回值：指向该元素 ExecValue 的指针；越界或表满返回 null。
fn exec_vm_native_agg_slot(base: usize, index: i64) &ExecValue {
    if index < 0 || index >= (EXEC_NATIVE_AGG_MAX_ELEMS as i64) {
        return null;
    }
    const slot: i32 = exec_vm_native_agg_slot_index(base);
    if slot < 0 || slot >= EXEC_NATIVE_AGG_MAX_BASES {
        return null;
    }
    const idx: i32 = index as i32;
    if idx < 0 || idx >= EXEC_NATIVE_AGG_MAX_ELEMS {
        return null;
    }
    if exec_vm_native_agg_ensure(slot, idx + 1) != 0 {
        return null;
    }
    if idx >= g_native_agg_count[slot] {
        g_native_agg_count[slot] = idx + 1;
        g_native_agg_handles[slot].count = idx + 1;
    }
    return &g_native_agg_storage[slot][idx];
}

/// 取原生指针聚合元素旁路表的聚合视图（按需建表）。
/// `&Token` 这类裸指针切片的元素是 ExecValue，只能落在旁路表里。
/// 参数：base 指针地址。
/// 返回值：覆盖该表的聚合句柄；无法建立返回 null。
fn exec_vm_native_agg_handle(base: usize) &ExecAggregate {
    const slot: i32 = exec_vm_native_agg_slot_index(base);
    if slot < 0 || slot >= EXEC_NATIVE_AGG_MAX_BASES {
        return null;
    }
    return &g_native_agg_handles[slot];
}

/// 内存函数（memset/memcpy/memmove）目标/源的三态视图。
///
/// 解释器的内部引用（`&local`、`&global`、`&agg.field`）指向的是**宿主里的
/// ExecValue 本体**，不是程序看到的那块数据。直接把内部引用当字节指针做
/// `memset`/`memcpy`，会按程序的字节数覆盖到 ExecValue 之外，写坏编译器自己的
/// 堆（实测 test_typed_pipeline_capability 崩在 tcache：tcache 指针被写成 0x16）。
const EXEC_MEM_VIEW_HOST: i32 = 0;  // 普通宿主指针，按字节访问
const EXEC_MEM_VIEW_VALUE: i32 = 1;  // 指向 VM 值本体，只能整体替换/清零
const EXEC_MEM_VIEW_DATA: i32 = 2;   // 内部引用/切片，已还原成数据区起始地址

/// 把源值按位「重新解释」成目标 kind（`memcpy(&u64, &f64, 8)` 这类位转换）。
/// 参数：`src` 源值；`dst_kind` 目标 ExecValueKind。
/// 返回值：kind 换成目标的同位数副本。
fn exec_vm_bitcast_value(src: &ExecValue, dst_kind: ExecValueKind) ExecValue {
    if src == null {
        return exec_make_void();
    }
    if dst_kind == ExecValueKind.EXEC_VALUE_F64 {
        return exec_make_f64_bits(src.i64_value as u64);
    }
    if dst_kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f32_bits(src.i64_value as u32);
    }
    if dst_kind == ExecValueKind.EXEC_VALUE_POINTER {
        return exec_make_pointer_with_kind(src.i64_value as usize, src.aux_i64_value as i32);
    }
    var out: ExecValue = src[0];
    out.kind = dst_kind;
    out.aux_kind = ExecValueKind.EXEC_VALUE_VOID;
    out.aux_ptr_value = null;
    out.error_id = 0;
    return out;
}

/// 求一个指针值按字节访问时的起始地址与容量。
/// 参数：`value` 指针值；`out_capacity` 输出可写字节数（0 表示未知）；`out_view` 输出视图类别。
/// 返回值：起始地址；无法解析返回 null。
fn exec_vm_mem_view(value: &ExecValue, out_capacity: &usize, out_view: &i32) &byte {
    if out_capacity != null {
        out_capacity[0] = 0 as usize;
    }
    if out_view != null {
        out_view[0] = EXEC_MEM_VIEW_HOST;
    }
    if value == null {
        return null;
    }
    if exec_vm_pointer_is_internal_ref(value) == 0 {
        if out_view != null {
            out_view[0] = EXEC_MEM_VIEW_HOST;
        }
        return value.ptr_value;
    }
    const target: &ExecValue = exec_vm_ref_target_value(value);
    if target == null {
        return null;
    }
    var data: &byte = null;
    if exec_value_is_raw_array(target) != 0 && target.ptr_value != null {
        data = target.ptr_value;
        if out_capacity != null {
            out_capacity[0] = exec_vm_type_kind_size(target.aux_i64_value as i32) * (target.i64_value as usize);
        }
    } else if target.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(target);
        if slice_data != null && slice_data.raw_ptr != null {
            data = slice_data.raw_ptr;
            if out_capacity != null && slice_data.len > 0 {
                out_capacity[0] = slice_data.len as usize;
            }
        }
    }
    if data != null {
        if out_view != null {
            out_view[0] = EXEC_MEM_VIEW_DATA;
        }
        return data;
    }
    if out_view != null {
        out_view[0] = EXEC_MEM_VIEW_VALUE;
    }
    return null;
}

/// 从原生字节缓冲区读出一个标量 VM 值（`memcpy(&scalar, raw_bytes, n)` 用）。
///
/// 只处理标量 kind：整数/浮点/布尔/指针。聚合类型（结构体/数组/切片）按字节
/// 复制没有意义，交回调用方报错。
///
/// 参数：`kind` 目标值的 ExecValueKind；`src` 源字节；`count` 字节数；
///       `out_target` 就地的目标值。
/// 返回值：0 成功；-1 该 kind 不支持。
/// 把一个标量 VM 值展开成原生字节（小端），供 `memcpy(&buf[off], &scalar, n)` 用。
///
/// 参数：`value` 源标量；`out` 输出缓冲区；`capacity` 缓冲区字节数。
/// 返回值：实际写入的字节数；0 表示该 kind 不是可展开的标量。
fn exec_vm_scalar_to_bytes(value: ExecValue, out: &byte, capacity: usize) usize {
    if out == null || capacity == 0 as usize {
        return 0 as usize;
    }
    var width: usize = 0 as usize;
    const kind: ExecValueKind = value.kind;
    if kind == ExecValueKind.EXEC_VALUE_BYTE || kind == ExecValueKind.EXEC_VALUE_U8 ||
        kind == ExecValueKind.EXEC_VALUE_I8 || kind == ExecValueKind.EXEC_VALUE_BOOL {
        width = 1 as usize;
    } else if kind == ExecValueKind.EXEC_VALUE_U16 || kind == ExecValueKind.EXEC_VALUE_I16 {
        width = 2 as usize;
    } else if kind == ExecValueKind.EXEC_VALUE_U32 || kind == ExecValueKind.EXEC_VALUE_I32 ||
        kind == ExecValueKind.EXEC_VALUE_F32 {
        width = 4 as usize;
    } else if kind == ExecValueKind.EXEC_VALUE_U64 || kind == ExecValueKind.EXEC_VALUE_I64 ||
        kind == ExecValueKind.EXEC_VALUE_USIZE || kind == ExecValueKind.EXEC_VALUE_ISIZE ||
        kind == ExecValueKind.EXEC_VALUE_F64 || kind == ExecValueKind.EXEC_VALUE_POINTER {
        width = 8 as usize;
    }
    if width == 0 as usize {
        return 0 as usize;
    }
    if width > capacity {
        width = capacity;
    }
    const bits: u64 = value.i64_value as u64;
    var i: usize = 0;
    while i < width {
        const shift_bits: i32 = (i * 8 as usize) as i32;
        out[i] = ((bits >> shift_bits) & 0xFF as u64) as byte;
        i = i + 1;
    }
    return width;
}

fn exec_vm_scalar_from_bytes(kind: ExecValueKind, src: &byte, count: usize, out_target: &ExecValue) i32 {
    if src == null || out_target == null {
        return -1;
    }
    var raw: [byte: 8] = [0: 8];
    const width: usize = exec_vm_scalar_width_bytes(kind);
    if width == 0 as usize {
        return -1;
    }
    const copy_len: usize = if count < width { count } else { width };
    var i: usize = 0;
    while i < copy_len {
        raw[i] = src[i];
        i = i + 1;
    }
    var bits: i64 = 0;
    var bi: usize = 0;
    while bi < 8 as usize {
        bits = bits | ((raw[bi] as i64) << ((bi as i32) * 8));
        bi = bi + 1;
    }
    if kind == ExecValueKind.EXEC_VALUE_F32 {
        out_target[0] = exec_make_f32_bits(bits as u32);
        return 0;
    }
    if kind == ExecValueKind.EXEC_VALUE_F64 {
        out_target[0] = exec_make_f64_bits(bits as u64);
        return 0;
    }
    if kind == ExecValueKind.EXEC_VALUE_BOOL {
        out_target[0] = exec_make_bool(bits != 0);
        return 0;
    }
    if exec_vm_kind_is_signed_int(kind) != 0 {
        out_target[0] = exec_make_i64(bits);
        out_target[0].kind = kind;
        return 0;
    }
    out_target[0] = exec_make_i64(bits);
    out_target[0].kind = kind;
    return 0;
}

/// 把 `src` 的位按 `count` 字节搬进 `dst`（两者都已是 VM 值本体）。
///
/// `memcpy(&dst, &src, n)` 在两个操作数都被判成单元素 VM 视图时用：语义就是
/// 「按字节复制」，所以只要双方宽度容得下 `count`，搬位即可。目标宽度大于源宽度
/// 时高位补零；窄于源时截断。
///
/// 参数：`src` 源值；`dst` 目标值（就地修改）；`count` 字节数。
/// 返回值：0 成功；-1 不适用（非标量）。
fn exec_vm_copy_value_bits(src: &ExecValue, dst: &ExecValue, count: usize) i32 {
    if src == null || dst == null {
        return -1;
    }
    const dst_width: usize = exec_vm_scalar_width_bytes(dst.kind);
    if dst_width == 0 as usize {
        return -1;
    }
    const src_width: usize = exec_vm_scalar_width_bytes(src.kind);
    if src_width == 0 as usize {
        return -1;
    }
    var raw: [byte: 8] = [0: 8];
    var wi: usize = 0;
    while wi < src_width {
        raw[wi] = exec_vm_scalar_byte_at(src, wi);
        wi = wi + 1;
    }
    var bits: i64 = 0;
    var bi: usize = 0;
    const take: usize = if count < dst_width { count } else { dst_width };
    while bi < take {
        bits = bits | ((raw[bi] as i64) << ((bi as i32) *| 8));
        bi = bi + 1;
    }
    if dst.kind == ExecValueKind.EXEC_VALUE_F32 {
        dst[0] = exec_make_f32_bits(bits as u32);
        dst[0].kind = dst.kind;
        return 0;
    }
    if dst.kind == ExecValueKind.EXEC_VALUE_F64 {
        dst[0] = exec_make_f64_bits(bits as u64);
        dst[0].kind = dst.kind;
        return 0;
    }
    if dst.kind == ExecValueKind.EXEC_VALUE_BOOL {
        dst[0] = exec_make_bool(bits != 0);
        return 0;
    }
    dst[0] = exec_make_i64(bits);
    dst[0].kind = dst.kind;
    return 0;
}

/// 取一个标量 VM 值的第 `idx` 个字节（小端）。
///
/// 参数：`v` 标量值；`idx` 字节下标。
/// 返回值：该字节。
fn exec_vm_scalar_byte_at(v: &ExecValue, idx: usize) byte {
    if v == null {
        return 0 as byte;
    }
    var bits: i64 = v.i64_value;
    if v.kind == ExecValueKind.EXEC_VALUE_F32 {
        bits = v.i64_value;
    } else if v.kind == ExecValueKind.EXEC_VALUE_F64 {
        bits = v.i64_value;
    } else if v.kind == ExecValueKind.EXEC_VALUE_POINTER {
        bits = v.ptr_value as i64;
    }
    const shift: i32 = (idx as i32) *| 8;
    return ((bits >> shift) & 0xFF) as byte;
}

/// 标量 kind 的字节宽度；聚合/非标量返回 0。
///
/// 参数：`kind` ExecValueKind。
/// 返回值：字节数。
fn exec_vm_scalar_width_bytes(kind: ExecValueKind) usize {
    if kind == ExecValueKind.EXEC_VALUE_I8 || kind == ExecValueKind.EXEC_VALUE_U8 ||
        kind == ExecValueKind.EXEC_VALUE_BOOL || kind == ExecValueKind.EXEC_VALUE_BYTE {
        return 1 as usize;
    }
    if kind == ExecValueKind.EXEC_VALUE_I16 || kind == ExecValueKind.EXEC_VALUE_U16 {
        return 2 as usize;
    }
    if kind == ExecValueKind.EXEC_VALUE_I32 || kind == ExecValueKind.EXEC_VALUE_U32 ||
        kind == ExecValueKind.EXEC_VALUE_F32 {
        return 4 as usize;
    }
    if kind == ExecValueKind.EXEC_VALUE_I64 || kind == ExecValueKind.EXEC_VALUE_U64 ||
        kind == ExecValueKind.EXEC_VALUE_F64 || kind == ExecValueKind.EXEC_VALUE_ISIZE ||
        kind == ExecValueKind.EXEC_VALUE_USIZE || kind == ExecValueKind.EXEC_VALUE_POINTER {
        return 8 as usize;
    }
    return 0 as usize;
}

/// 该 kind 是否为有符号整数（决定从字节还原时是否需要符号扩展）。
///
/// 参数：`kind` ExecValueKind。
/// 返回值：1 有符号；0 无符号/非整数。
fn exec_vm_kind_is_signed_int(kind: ExecValueKind) i32 {
    if kind == ExecValueKind.EXEC_VALUE_I8 || kind == ExecValueKind.EXEC_VALUE_I16 ||
        kind == ExecValueKind.EXEC_VALUE_I32 || kind == ExecValueKind.EXEC_VALUE_I64 ||
        kind == ExecValueKind.EXEC_VALUE_ISIZE {
        return 1;
    }
    return 0;
}

/// 把 VM 值原地清零（保留结构形状，等价于对底层字节 memset 0）。
/// 参数：`target` 目标值。
/// 返回值：无。
fn exec_vm_zero_value_in_place(target: &ExecValue) void {
    if target == null {
        return;
    }
    if exec_value_is_raw_array(target) != 0 {
        if target.ptr_value != null {
            const bytes: usize = exec_vm_type_kind_size(target.aux_i64_value as i32) * (target.i64_value as usize);
            _ = memset(target.ptr_value as *void, 0, bytes);
        }
        return;
    }
    const aggregate: &ExecAggregate = exec_value_as_aggregate(target);
    if aggregate != null {
        var i: i32 = 0;
        while i < aggregate.count {
            exec_vm_zero_value_in_place(&aggregate.values[i]);
            i = i + 1;
        }
        target.i64_value = 0;
        return;
    }
    if target.kind == ExecValueKind.EXEC_VALUE_UNION ||
        target.kind == ExecValueKind.EXEC_VALUE_SLICE ||
        target.kind == ExecValueKind.EXEC_VALUE_STRING ||
        target.kind == ExecValueKind.EXEC_VALUE_ERROR_UNION {
        target[0] = exec_make_void();
        return;
    }
    target.i64_value = 0;
    target.ptr_value = null;
}

fn exec_vm_pointer_element_ptr(function: &BCFunction, base: ExecValue, index_value: i64,
    elem_size_hint: usize) ExecValue {
    if function == null {
        exec_backend_set_error(null, "exec: pointer addr 输入无效" as *byte, 0);
        return exec_make_void();
    }
    const base_addr: usize = exec_vm_pointer_address(&base);
    if base_addr == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 空指针解引用" as *byte, 0);
        return exec_make_void();
    }
    if index_value < 0 {
        exec_backend_set_error(function.decl, "exec: 指针下标不能为负数" as *byte, 0);
        return exec_make_void();
    }
    // INDEX 基引用按 aggregate.values 步进，元素是 ExecValue 而不是原生标量。
    if exec_vm_pointer_is_index_base_ref(&base) != 0 {
        const index_ref_kind: i32 = exec_vm_decode_ref_kind(base.aux_i64_value as i32);
        return exec_vm_make_index_ref_from_addr(exec_vm_index_ref_element_addr(&base, index_value), index_ref_kind);
    }
    // 值引用指向 ExecValue 本体（`&local`/`&struct.field`）：按 ExecValue 步进，
    // 取元素得到的是指向该 ExecValue 的引用，不能按原生标量尺寸计算。
    if exec_vm_pointer_is_internal_ref(&base) != 0 {
        const value_ref_kind: i32 = exec_vm_decode_ref_kind(base.aux_i64_value as i32);
        return exec_vm_make_index_ref_from_addr(exec_vm_index_ref_element_addr(&base, index_value), value_ref_kind);
    }
    var pointee_kind: i32 = exec_value_pointer_pointee_kind(&base);
    var elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if pointee_kind == TypeKind.TYPE_VOID as i32 {
        // `*void` 的下标按字节走（和 `mem.uya` 里 `dst[i]` 的用法一致）。
        pointee_kind = TypeKind.TYPE_BYTE as i32;
        elem_size = 1 as usize;
    }
    if elem_size == 0 as usize {
        // 原生内存里的结构体数组（`&EpollEvent` 之类）：编译期把元素字节数放在
        // 指令 imm 里，这里直接按 C 布局步进，返回真正的原生指针。退化成旁路表
        // 槽位引用会让字段访问找不到原生基址（表现为 `LOAD_FIELD 字段越界`）。
        if elem_size_hint > 0 as usize && !exec_vm_address_is_vm_resident(base_addr) {
            return exec_make_pointer_with_kind(base_addr + (index_value as usize) * elem_size_hint,
                pointee_kind);
        }
        const agg_slot: &ExecValue = exec_vm_native_agg_slot(base_addr, index_value);
        if agg_slot == null {
            exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
            return exec_make_void();
        }
        return exec_vm_make_value_ref(agg_slot, pointee_kind);
    }
    const addr: usize = base_addr + (index_value as usize) * elem_size;
    return exec_make_pointer_with_kind(addr, pointee_kind);
}

fn exec_vm_index_ref(value: &ExecValue, index_value: i32) &ExecValue {
    if value == null || index_value < 0 {
        return null;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(value);
        if slice_data == null || slice_data.aggregate == null || index_value >= slice_data.len {
            return null;
        }
        return &slice_data.aggregate.values[slice_data.start +| index_value];
    }
    if exec_vm_pointer_is_internal_ref(value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(value);
        if target == null {
            return null;
        }
        const is_index_base: i32 = exec_vm_pointer_is_index_base_ref(value);
        const target_aggregate: &ExecAggregate = exec_value_as_aggregate(target);
        const ref_kind: i32 = exec_vm_decode_ref_kind(value.aux_i64_value as i32);
        // `*ref`：引用指向 struct/tuple 值本体时，下标 0 就是该值本身
        // （结构体字段访问走 LOAD_FIELD，不经过下标）。
        // `*ref`：引用指向「值本体」时下标 0 就是该值。除了 STRUCT/TUPLE，
        // 接口（`&self.conn` 这类 `&Conn`）在 VM 里同样是以聚合形式承载的
        // （方法入口表 + 数据），必须一起认，否则 `out[0] = impl` 会写到
        // 一个临时地址、调用方看不到任何变化
        // （test_std_sql 的 `db_open` → `drv.open(..., &db.conn)` 就是这么失效的）。
        if is_index_base == 0 && index_value == 0 && target_aggregate != null &&
            (ref_kind == TypeKind.TYPE_STRUCT as i32 || ref_kind == TypeKind.TYPE_TUPLE as i32 ||
             ref_kind == TypeKind.TYPE_INTERFACE as i32 || ref_kind == TypeKind.TYPE_UNION as i32) {
            return target;
        }
        // 嵌套数组 `arr[0][1]`：引用指向内层数组本体，下标要按内层 aggregate.values 取，
        // 不能沿外层 aggregate 步进。判据是引用的元素类型是数组。
        if is_index_base != 0 && target_aggregate != null &&
            ref_kind == TypeKind.TYPE_ARRAY as i32 && index_value < target_aggregate.count {
            return &target_aggregate.values[index_value];
        }
        // INDEX 基引用已经指向 aggregate.values 里的某个元素，必须按 ExecValue 步进：
        // slice.ptr[i] 的 i 是元素序号，而不是结构体字段下标。
        if is_index_base != 0 {
            const target_addr2: usize = @usize_from_ptr(target as &void);
            return @ptr_from_usize(target_addr2 + (@size_of(ExecValue) as usize) * (index_value as usize)) as &ExecValue;
        }
        // 装箱聚合（数组/元组/结构体）的元素在 aggregate.values 里，必须按聚合下标取，
        // 不能对 &ExecValue 做原始指针步进：嵌套数组写入 arr[0][1] = x 走的正是这条路径，
        // 一旦按指针步进就会写到聚合头之外的地址，写回丢失。
        if target_aggregate != null && target_aggregate.values != null && index_value < target_aggregate.count {
            return &target_aggregate.values[index_value];
        }
        return exec_vm_index_ref(target, index_value);
    }
    const aggregate: &ExecAggregate = exec_value_as_aggregate(value);
    if aggregate == null || index_value >= aggregate.count {
        return null;
    }
    return &aggregate.values[index_value];
}

/// 指针下标解引用前的地址合理性检查。
///
/// `exec_vm_pointer_address` 对任何 kind 都直接返回 `i64_value`，一旦上层把
/// 非指针值（或负值）当成指针传进下标路径，算出来的「地址」可能是
/// `0xfffffffffffffff1` 这类非用户态地址，直接解引用就是 SIGSEGV
/// （`test_http_uyagin` 崩在这里，rc=139，si_addr=-15）。用户态地址范围之外
/// 一律报可诊断的错误，不要交给内核去崩。
///
/// 参数：`function` 当前函数（用于报错定位）；`value` 被当成指针的基值；
///       `addr` 计算出的元素地址；`index` 下标。
/// 返回值：0 地址可用；-1 已设置错误。
const EXEC_VM_USER_ADDR_LIMIT: usize = 0x0000800000000000 as usize;
const EXEC_VM_NULL_PAGE_LIMIT: usize = 4096 as usize;

fn exec_vm_check_deref_addr(function: &BCFunction, value: &ExecValue, addr: usize, index: i64) i32 {
    if addr >= EXEC_VM_USER_ADDR_LIMIT || addr < EXEC_VM_NULL_PAGE_LIMIT {
        var msg: [byte: 192] = [];
        var base_kind: i32 = -1;
        var base_i64: i64 = 0;
        if value != null {
            base_kind = value.kind as i32;
            base_i64 = value.i64_value;
        }
        _ = snprintf(&msg[0] as *byte, 192,
            "exec: 指针下标解引用地址非法(addr=0x%lx idx=%ld base=%ld kind=%d)" as *byte,
            addr, index, base_i64, base_kind);
        exec_backend_set_error(function.decl, &msg[0] as &byte, 0);
        return -1;
    }
    return 0;
}

fn exec_vm_load_pointer_index(function: &BCFunction, base: ExecValue, index_value: i64, elem_size_hint: usize, out_value: &ExecValue) i32 {
    if function == null || out_value == null {
        exec_backend_set_error(null, "exec: pointer load 输入无效" as *byte, 0);
        return -1;
    }
    const base_addr: usize = exec_vm_pointer_address(&base);
    if base_addr == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 空指针解引用" as *byte, 0);
        return -1;
    }
    if index_value < 0 {
        exec_backend_set_error(function.decl, "exec: 指针下标不能为负数" as *byte, 0);
        return -1;
    }
    // INDEX 基引用按 aggregate.values 步进，元素是 ExecValue 而不是原生标量。
    if exec_vm_pointer_is_index_base_ref(&base) != 0 {
        const index_elem: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        out_value[0] = exec_value_clone(index_elem);
        return 0;
    }
    // 值引用指向 ExecValue 本体（`&local`/`&struct.field`）：解引用直接取该 ExecValue，
    // 不能按原生标量尺寸访问，否则会把 ExecValue 头当成数据。
    if exec_vm_pointer_is_internal_ref(&base) != 0 {
        const byte_view_load: i32 = exec_vm_try_load_scalar_byte_view(function, &base, index_value, out_value);
        if byte_view_load > 0 {
            return 0;
        }
        if byte_view_load < 0 {
            return -1;
        }
        // 下标必须落在目标的元素范围内：`exec_vm_index_ref_element_addr` 是
        // 裸地址加法，越界会读到任意内存并让 `exec_value_clone` 段错误
        // （test_http_uyagin 就是在这里崩的，rc=139）。
        const elem_target: &ExecValue = exec_vm_ref_target_value(&base);
        if elem_target == null {
            exec_backend_set_error(function.decl, "exec: 指针解引用目标无效" as *byte, 0);
            return -1;
        }
        const elem_agg: &ExecAggregate = exec_vm_aggregate_ref_from_value(elem_target);
        if elem_agg != null {
            if index_value >= (elem_agg.count as i64) {
                exec_backend_set_error(function.decl, "exec: 指针下标越界" as *byte, 0);
                return -1;
            }
        } else if exec_value_is_raw_array(elem_target) != 0 {
            if index_value >= (elem_target.i64_value as i64) {
                exec_backend_set_error(function.decl, "exec: 指针下标越界" as *byte, 0);
                return -1;
            }
        }
        const value_elem: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        out_value[0] = exec_value_clone(value_elem);
        return 0;
    }
    var pointee_kind: i32 = exec_value_pointer_pointee_kind(&base);
    var elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if pointee_kind == TypeKind.TYPE_VOID as i32 {
        pointee_kind = TypeKind.TYPE_BYTE as i32;
        elem_size = 1 as usize;
    }
    if elem_size == 0 as usize {
        // 原生内存里的结构体数组（`&EpollEvent` 之类）：编译期把元素字节数放在
        // 指令 imm 里，这里按真实步长算出元素地址并返回「指向该元素」的指针，
        // 后续字段访问才能走原生字段读写。
        // 裸地址落在 VM 值竞技场里：指针丢了内部引用编码，目标就是 ExecValue
        // 本体（与 STORE 侧对称）。判定必须排除原生聚合旁路表，否则会把
        // C 侧结构体字节误读成 ExecValue（fmt/json/yaml 系列曾因此崩溃）。
        if exec_vm_address_is_exec_value_storage(base_addr) {
            const direct_elem: &ExecValue = @ptr_from_usize(base_addr) as &ExecValue;
            out_value[0] = exec_value_clone(direct_elem);
            return 0;
        }
        // 该元素此前被 `STORE_INDEX` 写进过旁路表：真实内容在那里，不在原生缓冲区。
        // 必须先取旁路槽位，否则读回的是从未写过的原始字节。
        const agg_stored: &ExecValue = exec_vm_native_agg_peek(base_addr, index_value);
        if agg_stored != null {
            out_value[0] = exec_value_clone(agg_stored);
            return 0;
        }
        if elem_size_hint > 0 as usize && !exec_vm_address_is_vm_resident(base_addr) {
            out_value[0] = exec_make_pointer_with_kind(base_addr + (index_value as usize) * elem_size_hint,
                pointee_kind);
            return 0;
        }
        const agg_slot: &ExecValue = exec_vm_native_agg_slot(base_addr, index_value);
        if agg_slot == null {
            exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_value_clone(agg_slot);
        return 0;
    }
    const addr: usize = base_addr +| (index_value as usize) *| elem_size;
    if exec_vm_check_deref_addr(function, &base, addr, index_value) != 0 {
        return -1;
    }
    if pointee_kind == TypeKind.TYPE_BOOL as i32 {
        const ptr_bool: &byte = @ptr_from_usize(addr) as &byte;
        out_value[0] = exec_make_bool((ptr_bool[0] != 0) as i32);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I8 as i32 {
        const ptr_i8: &i8 = @ptr_from_usize(addr) as &i8;
        out_value[0] = exec_make_i8(ptr_i8[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_BYTE as i32 || pointee_kind == TypeKind.TYPE_U8 as i32 {
        const ptr_u8: &byte = @ptr_from_usize(addr) as &byte;
        if pointee_kind == TypeKind.TYPE_U8 as i32 {
            out_value[0] = exec_make_u8(ptr_u8[0]);
        } else {
            out_value[0] = exec_make_byte(ptr_u8[0] as i32);
        }
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I16 as i32 {
        const ptr_i16: &i16 = @ptr_from_usize(addr) as &i16;
        out_value[0] = exec_make_i16(ptr_i16[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U16 as i32 {
        const ptr_u16: &u16 = @ptr_from_usize(addr) as &u16;
        out_value[0] = exec_make_u16(ptr_u16[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I32 as i32 || pointee_kind == TypeKind.TYPE_ENUM as i32 {
        const ptr_i32: &i32 = @ptr_from_usize(addr) as &i32;
        out_value[0] = exec_make_i32(ptr_i32[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U32 as i32 {
        const ptr_u32: &u32 = @ptr_from_usize(addr) as &u32;
        out_value[0] = exec_make_u32(ptr_u32[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F32 as i32 {
        const ptr_f32: &f32 = @ptr_from_usize(addr) as &f32;
        out_value[0] = exec_make_f32(ptr_f32[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I64 as i32 {
        const ptr_i64: &i64 = @ptr_from_usize(addr) as &i64;
        out_value[0] = exec_make_i64(ptr_i64[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U64 as i32 {
        const ptr_u64: &u64 = @ptr_from_usize(addr) as &u64;
        out_value[0] = exec_make_u64(ptr_u64[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_USIZE as i32 {
        const ptr_usize: &usize = @ptr_from_usize(addr) as &usize;
        out_value[0] = exec_make_usize(ptr_usize[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F64 as i32 {
        const ptr_f64: &f64 = @ptr_from_usize(addr) as &f64;
        out_value[0] = exec_make_f64(ptr_f64[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_POINTER as i32 {
        const ptr_ptr: &usize = @ptr_from_usize(addr) as &usize;
        out_value[0] = exec_make_pointer_with_kind(ptr_ptr[0], TypeKind.TYPE_VOID as i32);
        return 0;
    }
    exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
    return -1;
}

fn exec_vm_store_pointer_index(function: &BCFunction, base: ExecValue, index_value: i64,
    elem_size_hint: usize, src_value: ExecValue) i32 {
    if function == null {
        exec_backend_set_error(null, "exec: pointer store 输入无效" as *byte, 0);
        return -1;
    }
    const base_addr: usize = exec_vm_pointer_address(&base);
    if base_addr == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 空指针解引用" as *byte, 0);
        return -1;
    }
    if index_value < 0 {
        exec_backend_set_error(function.decl, "exec: 指针下标不能为负数" as *byte, 0);
        return -1;
    }
    // INDEX 基引用按 aggregate.values 步进，元素是 ExecValue 而不是原生标量。
    if exec_vm_pointer_is_index_base_ref(&base) != 0 {
        const index_elem2: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        index_elem2[0] = exec_value_clone(&src_value);
        return 0;
    }
    // 值引用指向 ExecValue 本体：写入时整块替换该 ExecValue（`*ptr = v`）。
    if exec_vm_pointer_is_internal_ref(&base) != 0 {
        const byte_view_store: i32 = exec_vm_try_store_scalar_byte_view(function, &base, index_value, &src_value);
        if byte_view_store > 0 {
            return 0;
        }
        if byte_view_store < 0 {
            return -1;
        }
        const value_elem2: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        value_elem2[0] = exec_value_clone(&src_value);
        return 0;
    }
    var pointee_kind: i32 = exec_value_pointer_pointee_kind(&base);
    var elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if pointee_kind == TypeKind.TYPE_VOID as i32 {
        pointee_kind = TypeKind.TYPE_BYTE as i32;
        elem_size = 1 as usize;
    }
    if elem_size == 0 as usize {
        // 裸地址落在 VM 值竞技场里：指针虽然丢了内部引用编码，目标仍是
        // ExecValue 本体（`@ptr_from_usize(&arr[i])` 后再 `*p = v` 就是这个形态）。
        // 直接整块替换，不能退化成旁路表，否则写进影子槽、读回仍是旧值。
        // 判定必须排除原生聚合旁路表，见 `exec_vm_address_is_exec_value_storage`。
        if exec_vm_address_is_exec_value_storage(base_addr) {
            const direct_elem: &ExecValue = @ptr_from_usize(base_addr) as &ExecValue;
            direct_elem[0] = exec_value_clone(&src_value);
            return 0;
        }
        // 原生结构体数组：不可就地写到 C 布局里（元素类型是 VM 聚合），
        // 只能按旁路表槽位写入；有元素步长时至少保证下标不串位。
        const agg_slot: &ExecValue = exec_vm_native_agg_slot(base_addr, index_value);
        if agg_slot == null {
                        exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
            return -1;
        }
        agg_slot[0] = exec_value_clone(&src_value);
        return 0;
    }
    const addr: usize = base_addr +| (index_value as usize) *| elem_size;
    if exec_vm_check_deref_addr(function, &base, addr, index_value) != 0 {
        return -1;
    }
    if pointee_kind == TypeKind.TYPE_BOOL as i32 {
        const ptr_bool: &byte = @ptr_from_usize(addr) as &byte;
        ptr_bool[0] = src_value.i64_value as byte;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I8 as i32 {
        const ptr_i8: &i8 = @ptr_from_usize(addr) as &i8;
        ptr_i8[0] = src_value.i64_value as i8;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_BYTE as i32 || pointee_kind == TypeKind.TYPE_U8 as i32 {
        const ptr_u8: &byte = @ptr_from_usize(addr) as &byte;
        ptr_u8[0] = src_value.i64_value as byte;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I16 as i32 {
        const ptr_i16: &i16 = @ptr_from_usize(addr) as &i16;
        ptr_i16[0] = src_value.i64_value as i16;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U16 as i32 {
        const ptr_u16: &u16 = @ptr_from_usize(addr) as &u16;
        ptr_u16[0] = src_value.i64_value as u16;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I32 as i32 || pointee_kind == TypeKind.TYPE_ENUM as i32 {
        const ptr_i32: &i32 = @ptr_from_usize(addr) as &i32;
        ptr_i32[0] = src_value.i64_value as i32;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U32 as i32 {
        const ptr_u32: &u32 = @ptr_from_usize(addr) as &u32;
        ptr_u32[0] = src_value.i64_value as u32;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F32 as i32 {
        const ptr_f32: &f32 = @ptr_from_usize(addr) as &f32;
        ptr_f32[0] = exec_value_as_f32(&src_value);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I64 as i32 {
        const ptr_i64: &i64 = @ptr_from_usize(addr) as &i64;
        ptr_i64[0] = src_value.i64_value;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U64 as i32 {
        const ptr_u64: &u64 = @ptr_from_usize(addr) as &u64;
        ptr_u64[0] = src_value.i64_value as u64;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_USIZE as i32 {
        const ptr_usize: &usize = @ptr_from_usize(addr) as &usize;
        ptr_usize[0] = src_value.i64_value as usize;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F64 as i32 {
        const ptr_f64: &f64 = @ptr_from_usize(addr) as &f64;
        ptr_f64[0] = exec_value_as_f64(&src_value);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_POINTER as i32 {
        const ptr_ptr: &usize = @ptr_from_usize(addr) as &usize;
        ptr_ptr[0] = src_value.i64_value as usize;
        return 0;
    }
    exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
    return -1;
}

fn exec_vm_cast_value(value: ExecValue, target_kind: i32, target_pointee_kind: i32) ExecValue {
    if target_kind == TypeKind.TYPE_F32 as i32 {
        return exec_make_f32(exec_value_as_f32(&value));
    }
    if target_kind == TypeKind.TYPE_F64 as i32 {
        return exec_make_f64(exec_value_as_f64(&value));
    }
    if target_kind == TypeKind.TYPE_I8 as i32 {
        return exec_make_i8(exec_vm_numeric_to_i64(value) as i8);
    }
    if target_kind == TypeKind.TYPE_I16 as i32 {
        return exec_make_i16(exec_vm_numeric_to_i64(value) as i16);
    }
    if target_kind == TypeKind.TYPE_I32 as i32 {
        return exec_make_i32(exec_vm_numeric_to_i64(value) as i32);
    }
    if target_kind == TypeKind.TYPE_I64 as i32 {
        return exec_make_i64(exec_vm_numeric_to_i64(value));
    }
    if target_kind == TypeKind.TYPE_U8 as i32 {
        return exec_make_u8(exec_vm_numeric_to_u64(value) as u8);
    }
    if target_kind == TypeKind.TYPE_U16 as i32 {
        return exec_make_u16(exec_vm_numeric_to_u64(value) as u16);
    }
    if target_kind == TypeKind.TYPE_U32 as i32 {
        return exec_make_u32(exec_vm_numeric_to_u64(value) as u32);
    }
    if target_kind == TypeKind.TYPE_U64 as i32 {
        return exec_make_u64(exec_vm_numeric_to_u64(value));
    }
    if target_kind == TypeKind.TYPE_USIZE as i32 {
        return exec_make_usize(exec_vm_value_bytes_address(value) as usize);
    }
    if target_kind == TypeKind.TYPE_BOOL as i32 {
        return exec_make_bool((exec_value_truthy(value) != 0) as i32);
    }
    if target_kind == TypeKind.TYPE_BYTE as i32 {
        return exec_make_byte(exec_vm_numeric_to_i64(value) as i32);
    }
    if target_kind == TypeKind.TYPE_POINTER as i32 {
        if value.kind == ExecValueKind.EXEC_VALUE_POINTER {
            // 内部引用（`&local`/`&arr[i]` 产出的引用）转指针时保留引用编码，
            // 否则后续解引用会把它当原生指针对待，按标量尺寸访问 ExecValue。
            if exec_vm_pointer_is_internal_ref(&value) != 0 {
                if exec_vm_pointer_is_index_base_ref(&value) != 0 {
                    return exec_make_pointer_with_kind(value.i64_value as usize,
                        exec_vm_encode_index_ref_kind(target_pointee_kind));
                }
                return exec_make_pointer_with_kind(value.i64_value as usize,
                    exec_vm_encode_ref_kind(target_pointee_kind));
            }
            return exec_make_pointer_with_kind(value.i64_value as usize, target_pointee_kind);
        }
        if value.kind == ExecValueKind.EXEC_VALUE_STRING {
            return exec_make_pointer_with_kind(value.i64_value as usize, target_pointee_kind);
        }
        // ExecValue 聚合转指针：元素按 56 字节排布，宿主（execve 的 argv、
        // 任何 C 数组参数）读不了，必须先物化成连续 8 字节数组。
        // 只处理「指针数组转指针」（argv 那类）。`&Self` 这种结构体取址必须
        // 继续走内部引用，否则字段偏移全乱（async.uya 的 LOAD_INDEX 越界就是）。
        if target_pointee_kind == TypeKind.TYPE_POINTER as i32 &&
            (value.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
             value.kind == ExecValueKind.EXEC_VALUE_TUPLE) {
            const cast_agg: &ExecAggregate = exec_value_as_aggregate(&value);
            if cast_agg != null && cast_agg.values != null && cast_agg.count > 0 &&
                cast_agg.count <= 4096 {
                const cast_bytes: usize = (@size_of(i64) as usize) * (cast_agg.count as usize);
                const cast_buf: &i64 = exec_value_alloc_bytes(cast_bytes) as &i64;
                if cast_buf != null {
                    var cast_i: i32 = 0;
                    while cast_i < cast_agg.count {
                        const cast_elem: &ExecValue = &cast_agg.values[cast_i];
                        if exec_value_is_pointer_like(cast_elem[0]) != 0 {
                            cast_buf[cast_i] = @usize_from_ptr(cast_elem[0].ptr_value as &void) as i64;
                        } else {
                            cast_buf[cast_i] = exec_vm_numeric_to_i64(cast_elem[0]);
                        }
                        cast_i = cast_i + 1;
                    }
                    return exec_make_pointer_with_kind(@usize_from_ptr(cast_buf as &void),
                        target_pointee_kind);
                }
            }
        }
        // 聚合转指针（`args as &(&byte)`、`buf as &byte`）必须取**数据区**地址，
        // 不能取 `i64_value`：后者的语义是元素个数，C 里等价于 `&buf[0]`，
        // VM 里数据在 `ptr_value`。`exec_vm_value_bytes_address` 正是为此写的。
        return exec_make_pointer_with_kind(exec_vm_value_bytes_address(value) as usize,
            target_pointee_kind);
    }
    if target_kind == TypeKind.TYPE_VA_LIST as i32 && value.kind == ExecValueKind.EXEC_VALUE_VA_LIST {
        return exec_value_clone(&value);
    }
    return value;
}

/// 取一个可打印值的字节码（低 8 位），非整数类型返回 0。
fn exec_vm_print_byte_at(value: ExecValue) i32 {
    if exec_vm_value_kind_is_integer(value.kind) == 0 {
        return 0;
    }
    return (value.i64_value & 255) as i32;
}

/// 打印字节切片：与 C 的 `%s` 一致，遇到 NUL 或切片末尾就停。
/// 参数：value 字节切片；newline 非 0 时追加换行。
/// 返回值：实际写出的字节数（含换行）。
fn exec_vm_print_byte_slice(value: ExecValue, newline: i32) i64 {
    if exec_value_is_raw_slice(&value) != 0 {
        const raw: &byte = exec_value_slice_raw_ptr(&value);
        if raw == null {
            return 0;
        }
        if newline != 0 {
            return fprintf(libc.stdout, "%s\n" as *byte, raw) as i64;
        }
        return fprintf(libc.stdout, "%s" as *byte, raw) as i64;
    }
    const slice_data: &ExecSliceData = exec_value_as_slice(&value);
    if slice_data == null || slice_data.aggregate == null || slice_data.aggregate.values == null {
        return 0;
    }
    var printed: i64 = 0;
    var step: i32 = 0;
    while step < slice_data.len {
        const idx: i32 = slice_data.start +% step;
        if idx < 0 || idx >= slice_data.aggregate.count {
            break;
        }
        const ch: i32 = exec_vm_print_byte_at(slice_data.aggregate.values[idx]);
        if ch == 0 {
            break;
        }
        if fputc(ch, libc.stdout) < 0 {
            break;
        }
        printed = printed + 1;
        step = step + 1;
    }
    if newline != 0 && fputc(10, libc.stdout) >= 0 {
        printed = printed + 1;
    }
    return printed;
}

fn exec_vm_print_value(value: ExecValue, newline: i32) i64 {
    if value.kind == ExecValueKind.EXEC_VALUE_I8 {
        if newline != 0 {
            return fprintf(libc.stdout, "%d\n" as *byte, value.i64_value as i8) as i64;
        } else {
            return fprintf(libc.stdout, "%d" as *byte, value.i64_value as i8) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I16 {
        if newline != 0 {
            return fprintf(libc.stdout, "%d\n" as *byte, value.i64_value as i16) as i64;
        } else {
            return fprintf(libc.stdout, "%d" as *byte, value.i64_value as i16) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I32 {
        if newline != 0 {
            return fprintf(libc.stdout, "%d\n" as *byte, value.i64_value as i32) as i64;
        } else {
            return fprintf(libc.stdout, "%d" as *byte, value.i64_value as i32) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I64 {
        if newline != 0 {
            return fprintf(libc.stdout, "%ld\n" as *byte, value.i64_value) as i64;
        } else {
            return fprintf(libc.stdout, "%ld" as *byte, value.i64_value) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_ISIZE {
        if newline != 0 {
            return fprintf(libc.stdout, "%ld\n" as *byte, value.i64_value as isize) as i64;
        } else {
            return fprintf(libc.stdout, "%ld" as *byte, value.i64_value as isize) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U8 {
        if newline != 0 {
            return fprintf(libc.stdout, "%u\n" as *byte, value.i64_value as u8) as i64;
        } else {
            return fprintf(libc.stdout, "%u" as *byte, value.i64_value as u8) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U16 {
        if newline != 0 {
            return fprintf(libc.stdout, "%u\n" as *byte, value.i64_value as u16) as i64;
        } else {
            return fprintf(libc.stdout, "%u" as *byte, value.i64_value as u16) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U32 {
        if newline != 0 {
            return fprintf(libc.stdout, "%u\n" as *byte, value.i64_value as u32) as i64;
        } else {
            return fprintf(libc.stdout, "%u" as *byte, value.i64_value as u32) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U64 {
        if newline != 0 {
            return fprintf(libc.stdout, "%lu\n" as *byte, value.i64_value as u64) as i64;
        } else {
            return fprintf(libc.stdout, "%lu" as *byte, value.i64_value as u64) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_USIZE {
        if newline != 0 {
            return fprintf(libc.stdout, "%lu\n" as *byte, value.i64_value as usize) as i64;
        } else {
            return fprintf(libc.stdout, "%lu" as *byte, value.i64_value as usize) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_F32 {
        if newline != 0 {
            return fprintf(libc.stdout, "%g\n" as *byte, exec_f32_from_bits(value.i64_value as u32) as f64) as i64;
        } else {
            return fprintf(libc.stdout, "%g" as *byte, exec_f32_from_bits(value.i64_value as u32) as f64) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_F64 {
        if newline != 0 {
            return fprintf(libc.stdout, "%g\n" as *byte, exec_f64_from_bits(value.i64_value as u64)) as i64;
        } else {
            return fprintf(libc.stdout, "%g" as *byte, exec_f64_from_bits(value.i64_value as u64)) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_BOOL {
        var bool_text: *byte = "false" as *byte;
        if value.i64_value != 0 {
            bool_text = "true" as *byte;
        }
        if newline != 0 {
            return fprintf(libc.stdout, "%s\n" as *byte, bool_text) as i64;
        } else {
            return fprintf(libc.stdout, "%s" as *byte, bool_text) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_BYTE {
        if newline != 0 {
            return fprintf(libc.stdout, "%c\n" as *byte, value.i64_value as i32) as i64;
        } else {
            return fprintf(libc.stdout, "%c" as *byte, value.i64_value as i32) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRING && value.ptr_value != null {
        if newline != 0 {
            return fprintf(libc.stdout, "%s\n" as *byte, value.ptr_value as *byte) as i64;
        } else {
            return fprintf(libc.stdout, "%s" as *byte, value.ptr_value as *byte) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const print_slice_elem: i32 = exec_value_slice_element_kind(&value);
        if print_slice_elem == TypeKind.TYPE_BYTE as i32 || print_slice_elem == TypeKind.TYPE_I8 as i32 ||
            print_slice_elem == TypeKind.TYPE_U8 as i32 {
            return exec_vm_print_byte_slice(value, newline);
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER {
        const print_pointee: i32 = exec_value_pointer_pointee_kind(&value);
        if value.ptr_value != null && (print_pointee == TypeKind.TYPE_BYTE as i32 ||
            print_pointee == TypeKind.TYPE_I8 as i32 || print_pointee == TypeKind.TYPE_U8 as i32) {
            if newline != 0 {
                return fprintf(libc.stdout, "%s\n" as *byte, value.ptr_value as *byte) as i64;
            } else {
                return fprintf(libc.stdout, "%s" as *byte, value.ptr_value as *byte) as i64;
            }
        } else if newline != 0 {
            return fprintf(libc.stdout, "%lu\n" as *byte, value.i64_value as usize) as i64;
        } else {
            return fprintf(libc.stdout, "%lu" as *byte, value.i64_value as usize) as i64;
        }
    }
    if newline != 0 {
        return fprintf(libc.stdout, "\n" as *byte) as i64;
    }
    return 0;
}

fn exec_vm_trace(trace_vm: i32, fn_name: &byte, ip: i32, instr: &BCInstr) void {
    if trace_vm == 0 || instr == null {
        return;
    }
    fprintf(libc.stderr, "[vm] fn=%s ip=%d op=%s(%d) a=%d b=%d c=%d imm=%ld\n" as *byte,
        fn_name as *byte, ip, exec_debug_opcode_name(instr.opcode) as *byte, instr.opcode as i32, instr.a, instr.b, instr.c, instr.imm);
}

fn exec_vm_trace_call_enter(trace_vm: i32, fn_name: &byte, arg_count: i32) void {
    if trace_vm == 0 {
        return;
    }
    fprintf(libc.stderr, "[vm] enter fn=%s args=%d\n" as *byte, fn_name as *byte, arg_count);
}

fn exec_vm_trace_jump(trace_vm: i32, fn_name: &byte, from_ip: i32, to_ip: i32, reason: &byte) void {
    if trace_vm == 0 {
        return;
    }
    fprintf(libc.stderr, "[vm] jump fn=%s from=%d to=%d reason=%s\n" as *byte,
        fn_name as *byte, from_ip, to_ip, reason as *byte);
}

fn exec_vm_load_const(program: &BCProgram, function: &BCFunction, const_idx: i32, out_value: &ExecValue) i32 {
    if program == null || function == null || out_value == null {
        exec_backend_set_error(null, "exec: LOAD_CONST 输入无效" as *byte, 0);
        return -1;
    }
    if const_idx < 0 || const_idx >= program.const_pool.count || program.const_pool.values == null {
        exec_backend_set_error(function.decl, "exec: LOAD_CONST 常量索引越界" as *byte, 0);
        return -1;
    }
    out_value[0] = program.const_pool.values[const_idx];
    return 0;
}

fn exec_vm_get_aggregate_for_slice(function: &BCFunction, value: ExecValue) &ExecAggregate {
    if value.kind == ExecValueKind.EXEC_VALUE_ARRAY {
        return exec_value_as_aggregate(&value);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(&value);
        if slice_data != null {
            return slice_data.aggregate;
        }
    }
    exec_backend_set_error(function.decl, "exec: 切片基值不是 array/slice" as *byte, 0);
    return null;
}

fn exec_vm_lookup_error_name(program: &BCProgram, error_id: i32) &byte {
    if program == null || error_id == 0 || program.error_names == null || program.error_name_count <= 0 {
        return "UnknownError" as &byte;
    }
    var left: i32 = 0;
    var right: i32 = program.error_name_count - 1;
    while left <= right {
        const mid: i32 = left + (right - left) / 2;
        const entry: &BCErrorNameEntry = program.error_names + mid;
        if entry == null {
            break;
        }
        if entry.error_id == error_id {
            if entry.name != null {
                return entry.name;
            }
            break;
        }
        if entry.error_id < error_id {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    return "UnknownError" as &byte;
}

fn exec_vm_wrap_syscall_result(result: !i64, target_kind: i32, target_pointee_kind: i32) ExecValue {
    const ok_value: i64 = result catch |err| {
        return exec_make_error_union_err(@error_id(err) as i32);
    };
    const raw_value: ExecValue = exec_make_i64(ok_value);
    const cast_value: ExecValue = exec_vm_cast_value(raw_value, target_kind, target_pointee_kind);
    return exec_make_error_union_ok(cast_value);
}

/// 执行一次 `sscanf`，把解析到的整数写回调用方给的 VM 槽位。
///
/// 只实现 `%d` / `%i` / `%u`（可带宽度、可带 `*` 抑制），覆盖现有用例。
/// 遇到不认识的转换符就停止解析并返回已成功的个数 —— 与 C 的行为一致。
///
/// 参数：`frame` 当前帧；`arg_base` 参数槽起点；`arg_count` 参数个数；
///       `src` 输入字符串；`fmt` 格式串。
/// 返回值：成功赋值的项数；参数异常返回 -1。
fn exec_vm_do_sscanf(frame: &ExecFrame, arg_base: i32, arg_count: i32,
    src: &const byte, fmt: &const byte) i32 {
    if src == null || fmt == null {
        return -1;
    }
    var si: usize = 0;
    var fi: usize = 0;
    var assigned: i32 = 0;
    var out_idx: i32 = 2;
    while fmt[fi] != 0 as byte {
        const fc: byte = fmt[fi];
        if fc == 32 as byte || fc == 9 as byte || fc == 10 as byte {
            // 格式串里的空白匹配任意空白（含零个）。
            while src[si] == 32 as byte || src[si] == 9 as byte || src[si] == 10 as byte {
                si = si + 1;
            }
            fi = fi + 1;
            continue;
        }
        if fc != 37 as byte {
            // 普通字符必须逐字匹配。
            if src[si] != fc {
                return assigned;
            }
            si = si + 1;
            fi = fi + 1;
            continue;
        }
        fi = fi + 1;
        var suppress: i32 = 0;
        if fmt[fi] == 42 as byte {
            suppress = 1;
            fi = fi + 1;
        }
        // 跳过宽度数字（本实现按「不限制宽度」处理）。
        while fmt[fi] >= 48 as byte && fmt[fi] <= 57 as byte {
            fi = fi + 1;
        }
        const conv: byte = fmt[fi];
        if conv != 100 as byte && conv != 105 as byte && conv != 117 as byte {
            return assigned;
        }
        fi = fi + 1;
        while src[si] == 32 as byte || src[si] == 9 as byte || src[si] == 10 as byte {
            si = si + 1;
        }
        var neg: i32 = 0;
        if src[si] == 45 as byte {
            neg = 1;
            si = si + 1;
        } else if src[si] == 43 as byte {
            si = si + 1;
        }
        var any: i32 = 0;
        var acc: i64 = 0;
        while src[si] >= 48 as byte && src[si] <= 57 as byte {
            acc = acc *| 10 +| ((src[si] as i64) -| 48);
            any = 1;
            si = si + 1;
        }
        if any == 0 {
            return assigned;
        }
        if neg != 0 {
            acc = 0 - acc;
        }
        if suppress == 0 {
            if out_idx >= arg_count {
                return assigned;
            }
            const ptr_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base +| out_idx);
            if ptr_slot == null {
                return -1;
            }
            const target: &ExecValue = exec_vm_ref_target_value(ptr_slot);
            if target == null {
                return -1;
            }
            target[0] = exec_make_i64(acc);
            if target[0].kind != ExecValueKind.EXEC_VALUE_I64 {
                // 调用方可能声明成 i32：按目标原来的宽度收敛，保持 kind 不变。
                target[0].i64_value = acc;
            }
            out_idx = out_idx +| 1;
            assigned = assigned + 1;
        }
    }
    return assigned;
}

fn exec_vm_host_syscall0(target_kind: i32, target_pointee_kind: i32, nr: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall1(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall2(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall3(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3), target_kind, target_pointee_kind);
}

/// 判断系统调用号是否属于「信号」这一族（解释器里必须走桩）。
///
/// 参数：`nr` 系统调用号。
/// 返回值：1 是；0 否。
fn exec_vm_is_signal_syscall(nr: i64) i32 {
    // rt_sigaction=13、rt_sigprocmask=14、kill=62、tgkill=234、tkill=200、
    // rt_sigreturn=15、rt_sigsuspend=130、sigaltstack=131。
    if nr == 13 || nr == 14 || nr == 15 || nr == 62 || nr == 130 {
        return 1;
    }
    if nr == 131 || nr == 200 || nr == 234 {
        return 1;
    }
    return 0;
}

fn exec_vm_host_syscall4(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64, a4: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3, a4), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall5(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3, a4, a5), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall6(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3, a4, a5, a6), target_kind, target_pointee_kind);
}

/// 取错误值自带的错误 id（错误值 / 错误联合）；不是错误值就按整数载荷处理。
fn exec_vm_error_id_from_value(value: ExecValue) i64 {
    if value.kind == ExecValueKind.EXEC_VALUE_ERROR || value.kind == ExecValueKind.EXEC_VALUE_ERROR_UNION {
        return (value.error_id as u32) as i64;
    }
    return value.i64_value;
}

fn exec_vm_dispatch_host_syscall(target_kind: i32, target_pointee_kind: i32, nr: i64, args: &i64, arg_count: i32) ExecValue {
    // 信号相关系统调用在解释器里必须降级成桩：VM 没有真实线程/信号语义，
    // 真把 `rt_sigaction` 交给宿主会给**解释器进程自己**装上信号处理器，
    // 后续 `raise`/`kill` 直接把解释器打死（test_signal 实测在注册 SIGUSR1
    // 之后被信号终止，返回码 138）。按 `pthread_*` 的既有处理方式一律返回
    // 「调用成功、什么都没发生」。**必须放在 `arg_count` 分支之前**：
    // `tgkill`/`kill` 是 3 参数，会先命中 `arg_count == 3` 直接真发信号。
    if exec_vm_is_signal_syscall(nr) != 0 {
        const stub_raw: ExecValue = exec_make_i64(0 as i64);
        return exec_make_error_union_ok(exec_vm_cast_value(stub_raw, target_kind, target_pointee_kind));
    }
    if arg_count == 0 {
        return exec_vm_host_syscall0(target_kind, target_pointee_kind, nr);
    }
    if arg_count == 1 {
        return exec_vm_host_syscall1(target_kind, target_pointee_kind, nr, args[0]);
    }
    if arg_count == 2 {
        return exec_vm_host_syscall2(target_kind, target_pointee_kind, nr, args[0], args[1]);
    }
    if arg_count == 3 {
        return exec_vm_host_syscall3(target_kind, target_pointee_kind, nr, args[0], args[1], args[2]);
    }
    if arg_count == 4 {
        return exec_vm_host_syscall4(target_kind, target_pointee_kind, nr, args[0], args[1], args[2], args[3]);
    }
    if arg_count == 5 {
        return exec_vm_host_syscall5(target_kind, target_pointee_kind, nr, args[0], args[1], args[2], args[3], args[4]);
    }
    if arg_count == 6 {
        return exec_vm_host_syscall6(target_kind, target_pointee_kind, nr, args[0], args[1], args[2], args[3], args[4], args[5]);
    }
    return exec_make_void();
}

/// 把落在 VM 槽位池里的 syscall 参数地址换成原生缓冲区。
///
/// 内核按自己认得的结构体布局读写用户内存。VM 的槽位里放的是 `ExecValue`，
/// 一旦把槽地址直接交给内核，内核写的几十上百字节就会把 `ExecValue` 的头
/// （`kind` 字段）覆盖成垃圾 —— `test_signal` 的 `rt_sigaction` 正是这样把
/// `old_action` 所在的槽写坏，之后所有 `LOAD_FIELD` 都报「字段越界」。
///
/// 参数：`frame` 当前帧；`arg_base`/`arg_count` 参数槽范围；`out_mask` 出参位图；
///       `args` 参数数组（就地改写）。
/// 返回值：0 成功。
fn exec_vm_syscall_shield_vm_addresses(frame: &ExecFrame, arg_base: i32, arg_count: i32,
    out_mask: i32, args: &i64) i32 {
    if frame == null || args == null || arg_count <= 0 {
        return 0;
    }
    var si: i32 = 0;
    while si < arg_count && si < 6 {
        // `out_mask` 标记过的出参交给 `exec_vm_syscall_marshal_out_struct` 处理：
        // 它需要拿到**原始**地址去 `exec_vm_realign_to_slot` 定位 VM 槽位，
        // 这里先换成 scratch 会让它认不出来、于是出参永远回填不了
        // （`sys_gettimeofday(&tv, ...)` 的 `tv.tv_sec` 一直是 0）。
        if (out_mask & (1 << si)) != 0 {
            si = si + 1;
            continue;
        }
        const addr: usize = args[si] as usize;
        if addr == 0 as usize {
            si = si + 1;
            continue;
        }
        const slot: &ExecValue = exec_vm_realign_to_slot(addr);
        if slot == null {
            // 竞技场里的 ExecValue 数组（`&argv[0]` 交给 `execve`）：元素是
            // 56 字节的 ExecValue，宿主要的是连续 8 字节指针数组。不物化的话
            // 内核读到的是 `kind` 字段，`execve` 直接 EFAULT，子进程走
            // `os_exit(104)` 分支（`test_osal` 三个 redirect 用例就是这样）。
            const remaining: i32 = exec_value_array_element_remaining(addr);
            if remaining > 0 && remaining <= 1024 {
                const elems: &ExecValue = @ptr_from_usize(addr) as &ExecValue;
                const head_kind: i32 = elems[0].kind;
                if head_kind == ExecValueKind.EXEC_VALUE_POINTER as i32 ||
                    head_kind == ExecValueKind.EXEC_VALUE_STRING as i32 ||
                    head_kind == ExecValueKind.EXEC_VALUE_VOID as i32 {
                    const pbytes: usize = (@size_of(i64) as usize) * (remaining as usize);
                    const pbuf: &i64 = exec_value_alloc_bytes(pbytes) as &i64;
                    if pbuf != null {
                        var pi: i32 = 0;
                        while pi < remaining {
                            const pe: &ExecValue = &elems[pi];
                            if exec_value_is_pointer_like(pe[0]) != 0 {
                                pbuf[pi] = @usize_from_ptr(pe[0].ptr_value as &void) as i64;
                            } else {
                                pbuf[pi] = exec_vm_numeric_to_i64(pe[0]);
                            }
                            pi = pi + 1;
                        }
                        args[si] = pbuf as i64;
                    }
                }
            }
            si = si + 1;
            continue;
        }
        var shield_bytes: usize = 256 as usize;
        var field_count2: i32 = 0;
        const field_probe: &ExecAggregate = slot.ptr_value as &ExecAggregate;
        if field_probe != null && field_probe.values != null && field_probe.count > 0 {
            field_count2 = field_probe.count;
            const need: usize = (@size_of(i64) as usize) * (field_probe.count as usize);
            if need > shield_bytes {
                shield_bytes = need;
            }
        }
        const scratch2: &i64 = exec_value_alloc_bytes(shield_bytes) as &i64;
        if scratch2 == null {
            si = si + 1;
            continue;
        }
        _ = memset(scratch2 as *void, 0, shield_bytes);
        if field_probe != null && field_probe.values != null {
            var fi: i32 = 0;
            while fi < field_count2 && fi < 64 {
                scratch2[fi] = exec_vm_numeric_to_i64(field_probe.values[fi]);
                fi = fi + 1;
            }
        } else {
            // 标量局部按指针传入（`sys_getsockname(fd, &addr, &alen)` 的 `&alen`
            // 就是这种）：必须把当前值写进缓冲区。以前 memset 清零后不填，
            // 内核读到的 `addrlen` 是 0，于是**一个字节都不写回**、还返回 0，
            // 表现为「调用成功但端口一直是 0」。
            scratch2[0] = exec_vm_numeric_to_i64(slot[0]);
        }
        args[si] = scratch2 as i64;
        si = si + 1;
    }
    return 0;
}


/// 出参结构体：把标记过的参数换成原生缓冲区（内核按原生布局写入），
/// 调完 syscall 再按字段顺序写回 VM 的聚合值。
/// 参数：function - 当前函数；frame - 当前帧；meta 各字段见 exec_vm_decode_*；
///       args - 参数数组（会被就地改写为缓冲区地址）；out_target - 输出出参聚合值。
/// 返回：0 成功，-1 失败。
/// 出参结构体：把标记过的参数换成原生缓冲区（内核按原生布局写入），
/// 调完 syscall 再按字段顺序写回 VM 的聚合值。
/// 参数：function/frame/arg_base/arg_count/out_mask 见调用方；args 参数数组（会被就地改写）；
///       out_targets/out_buffers/out_fields 输出数组；out_count 输出的出参个数。
/// 返回：0 成功，-1 失败。
fn exec_vm_syscall_marshal_out_struct(function: &BCFunction, frame: &ExecFrame, arg_base: i32,
    arg_count: i32, out_mask: i32, args: &i64, out_targets: & & ExecValue, out_buffers: & & i64,
    out_fields: &i32, out_count: &i32) i32 {
    if out_count == null {
        return -1;
    }
    out_count[0] = 0;
    if out_mask == 0 || args == null || out_targets == null || out_buffers == null || out_fields == null {
        return 0;
    }
    var oi: i32 = 0;
    while oi < arg_count && oi < 6 {
        if (out_mask & (1 << oi)) != 0 {
            const arg_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base + oi);
            const target: &ExecValue = exec_vm_syscall_out_struct_target(arg_slot, args[oi]);
            var field_count: i32 = 0;
            var buffer: &i64 = exec_vm_syscall_out_struct_prepare(target, &field_count);
            var register_target: &ExecValue = target;
            if buffer == null {
                // 目标槽还是空的（`var s: sigset_t = sigset_t {}` 之后、还没有
                // 任何字段被写过）。此时既不能把槽地址直接交给内核，也不能只
                // 换成 scratch 就算完 —— 内核写的结果会丢在 scratch 里，槽永远
                // 是空的，随后 `sigismember(&s, ...)` 就报「字段越界 count=-1」。
                // 先按 `exec_vm_field_ref_store` 的同一约定把空槽物化成聚合，
                // 再重试一次 prepare，出参回填登记就能建立起来。
                var materialize_target: &ExecValue = target;
                if materialize_target == null {
                    materialize_target = exec_vm_realign_to_slot(args[oi] as usize);
                }
                // 不必再判「参数是不是聚合指针」：`out_mask` 的位是构建期
                // `exec_builder_syscall_arg_out_struct_bit` 打上的，只有
                // 「指针指向 struct/union/array/tuple」才会置位。而且实参常常
                // 是 `set as i64` 这种已被折成整数的形态，按参数类型判反而会
                // 把正是聚合出参的情况漏掉。
                if materialize_target != null && materialize_target[0].kind == ExecValueKind.EXEC_VALUE_VOID {
                    materialize_target[0] = exec_value_make_aggregate(ExecValueKind.EXEC_VALUE_STRUCT, 64);
                    buffer = exec_vm_syscall_out_struct_prepare(materialize_target, &field_count);
                    register_target = materialize_target;
                }
            }
            if buffer == null {
                // 目标不是能解析出来的单块结构体。
                //
                // 如果原地址落在 VM 槽位池 / 值 arena 里（`&old_action` 就是
                // `slots[5]`），**绝不能把它继续交给内核**：内核会按原生 `struct`
                // 布局往里写，把 ExecValue 的头（`kind`）覆盖掉，之后所有
                // `LOAD_FIELD` 都报「字段越界」（test_signal 的 `rt_sigaction`
                // 就这么坏的）。这种情况下换成一块原生 scratch。
                //
                // 反之，地址本来就在宿主原生内存里（`epoll_wait` 的事件数组是
                // malloc 出来的字节块，参数已经是 `events as i64`，解析不出
                // ExecValue 结构）——这时把地址原样交给内核是**正确**的，换
                // scratch 反而会让内核把事件写进 scratch，调用方永远读到全 0：
                // `epoll_wait` 返回 n=1 但 `epoll_event_fd` 读到 0，`find_slot`
                // 找不到，waker 永不唤醒（test_std_async_event 系列）。
                    if exec_vm_address_is_vm_resident(args[oi] as usize) {
                    const scratch: &i64 = exec_value_alloc_bytes(256 as usize) as &i64;
                    if scratch != null {
                        _ = memset(scratch as *void, 0, 256 as usize);
                        args[oi] = scratch as i64;
                    }
                }
                oi = oi + 1;
                continue;
            }
            out_targets[out_count[0]] = register_target;
            out_buffers[out_count[0]] = buffer;
            out_fields[out_count[0]] = field_count;
            out_count[0] = out_count[0] +| 1;
            args[oi] = buffer as i64;
        }
        oi = oi + 1;
    }
    return 0;
}

/// 把 `epoll_ctl` 的 `&EpollEvent` 入参按 C 布局（events u32 @0、data u64 @4，
/// packed 12 字节）写进原生缓冲区。
///
/// 解释器里 `&event` 指向的是 VM 内存（ExecValue），直接把那个地址交给内核
/// 只会读到 wrapper 字节 —— 表现为 `epoll_ctl` 返回 0、`epoll_wait` 永远等不到事件。
///
/// 参数：`arg_slot` 参数槽；`raw_addr` 参数裸地址；`out_buf` 原生缓冲区（≥16 字节）。
/// 返回值：0 成功，-1 无法解析。
fn exec_vm_epoll_ctl_native_event(arg_slot: &ExecValue, raw_addr: i64, out_buf: &byte) i32 {
    if out_buf == null {
        return -1;
    }
    const target_head: &ExecValue = exec_vm_syscall_out_struct_target(arg_slot, raw_addr);
    if target_head != null {
        var target: &ExecValue = target_head;
        if target.kind == ExecValueKind.EXEC_VALUE_POINTER {
            const deref: &ExecValue = exec_vm_ref_target_value(target);
            if deref != null {
                target = deref;
            }
        }
        const agg: &ExecAggregate = exec_value_as_aggregate(target);
        if agg != null && agg.values != null && agg.count >= 2 {
            const events_val: i32 = exec_vm_numeric_to_i64(agg.values[0]) as i32;
            const slot1: i64 = exec_vm_numeric_to_i64(agg.values[1]);
            var slot2: i64 = 0i64;
            if agg.count >= 3 {
                slot2 = exec_vm_numeric_to_i64(agg.values[2]);
            }
            // `data` 的 8 个字节跨两个 u32 槽。**不能**假定槽序等于声明序：
            // 实测 `EpollEvent{events, data_lo, data_hi}` 在 VM 聚合里可能落到
            // `[events, data_hi, data_lo]`，按声明序取值会把 fd 写进 data 的高
            // 32 位（内核读到 `data=0x600000000`）：注册「成功」，但
            // `epoll_wait` 回来后 `epoll_event_fd` 读到 0，`find_slot` 找不到，
            // waker 永不唤醒。本运行时 `data` 只当 fd 用、值恒在低 32 位，
            // 所以「槽 1 为零而槽 2 非零」时把槽 2 当低 32 位。
            var data64: i64 = 0i64;
            if slot1 == 0i64 && slot2 != 0i64 {
                data64 = slot2 & 0xFFFFFFFFi64;
            } else {
                data64 = (slot1 & 0xFFFFFFFFi64) | ((slot2 & 0xFFFFFFFFi64) << 32);
            }
            const words: &u32 = out_buf as &u32;
            words[0] = events_val as u32;
            words[1] = (data64 & 0xFFFFFFFFi64) as u32;
            words[2] = ((data64 >> 32) & 0xFFFFFFFFi64) as u32;
            words[3] = 0 as u32;
            return 0;
        }
    }
    // 回退：调用点写的是 `&ev as i64`，指针先被整数化，参数槽里只剩 kind=I64，
    // 解析不出 ExecValue 结构。此时 `&ev` 指向编译器给「按值结构体」准备的原生
    // 缓冲区 —— **每个字段占一个 i64**（和 `exec_vm_syscall_out_struct_prepare`
    // 造出来的缓冲区同一种表示），不是 12 字节的 C 布局。按 3 个 i64 读出来重新
    // 打包成 packed 的 `{u32 events; u64 data@4}`。
    //
    // 这里**不**按「地址是否落在 VM 驻留区」筛：竞技场（200MB）和宿主 malloc
    // 出来的内存在同一片地址空间里，`exec_vm_address_is_value` 会把不少宿主
    // 指针也判成驻留，用它当门禁等于把这个回退整体关掉。改成只读 + 内容校验
    // （events 非零且落在 u32 内、data 的高 32 位为空），不满足就原样留给内核。
    if raw_addr == 0 {
        return -1;
    }
    const src: &i64 = @ptr_from_usize(raw_addr as usize) as &i64;
    if src == null {
        return -1;
    }
    const src_events: i64 = src[0];
    const src_data: i64 = src[1];
    const src_hi: i64 = src[2];
    if src_events <= 0i64 || src_events > 4294967295i64 ||
        src_data < 0i64 || src_data > 4294967295i64 || src_hi != 0i64 {
        return -1;
    }
    const fallback_words: &u32 = out_buf as &u32;
    fallback_words[0] = (src_events & 0xFFFFFFFFi64) as u32;
    fallback_words[1] = (src_data & 0xFFFFFFFFi64) as u32;
    fallback_words[2] = 0 as u32;
    fallback_words[3] = 0 as u32;
    return 0;
}

fn exec_vm_exec_syscall(function: &BCFunction, frame: &ExecFrame, nr_slot: &ExecValue, syscall_meta: i64, out_value: &ExecValue) i32 {
    if function == null || frame == null || nr_slot == null || out_value == null {
        exec_backend_set_error(null, "exec: syscall 输入无效" as *byte, 0);
        return -1;
    }
    const arg_base: i32 = exec_vm_decode_syscall_arg_base(syscall_meta);
    const arg_count: i32 = exec_vm_decode_syscall_arg_count(syscall_meta);
    const target_kind: i32 = exec_vm_decode_syscall_target_kind(syscall_meta);
    const target_pointee_kind: i32 = exec_vm_decode_syscall_target_pointee_kind(syscall_meta);
    const out_mask: i32 = exec_vm_decode_syscall_out_mask(syscall_meta);
    var args: [i64: 6] = [];
    var ai: i32 = 0;
    while ai < arg_count {
        const arg_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base + ai);
        if arg_slot == null {
            exec_backend_set_error(function.decl, "exec: syscall 参数槽位越界" as *byte, 0);
            return -1;
        }
        args[ai] = exec_vm_syscall_arg_to_i64(arg_slot[0]);
        ai = ai + 1;
    }
    const nr_value: i64 = exec_vm_syscall_arg_to_i64(nr_slot[0]);
    var out_targets: [&ExecValue: 6] = [];
    var out_buffers: [&i64: 6] = [];
    var out_fields: [i32: 6] = [];
    var out_count2: i32 = 0;
    // 任何指向 VM 槽位池的裸地址参数都要换成原生缓冲区：内核按原生 `struct`
    // 布局读写，直接拿槽地址过去会把 ExecValue 的头（`kind`）覆盖掉。入参先把
    // 现有字段值填进缓冲区，出参（`out_mask` 里标过的）由 marshal 负责回填。
    // 记下换过缓冲区之前的原始地址：标量出参（`waitpid(fd, &status, ...)` 的
    // `&status`、`read(..., &len)` 的 `&len`）走的是 shield 的标量分支，
    // 内核写在 scratch 里；不主动回填的话调用方的局部永远是旧值。
    var raw_before: [i64: 6] = [];
    var rb_i: i32 = 0;
    while rb_i < arg_count && rb_i < 6 {
        raw_before[rb_i] = args[rb_i];
        rb_i = rb_i + 1;
    }
    _ = exec_vm_syscall_shield_vm_addresses(frame, arg_base, arg_count, out_mask, &args[0]);
    if exec_vm_syscall_marshal_out_struct(function, frame, arg_base, arg_count, out_mask, &args[0],
        &out_targets[0] as & & ExecValue, &out_buffers[0] as & & i64, &out_fields[0], &out_count2) != 0 {
        return -1;
    }
    if arg_count > 6 {
        exec_backend_set_error(function.decl, "exec: syscall 参数数量非法" as *byte, 0);
        return -1;
    }
    // clone 出来的线程与父线程共享地址空间，却会各自持有解释器状态，
    // 父线程等待子线程就永远等不到（普查里表现为整例超时）。fork/vfork 是
    // 写时复制的独立副本，解释器状态自洽，保持放行。
    if nr_value == 56 || nr_value == 435 {
        exec_backend_set_error(function.decl, "exec: 解释器不支持创建线程/进程(clone/fork)" as *byte, 0);
        return -1;
    }
    // arch_prctl(158) / set_thread_area(205)：解释器与编译器共用同一个进程，
    // 改 GS/FS 基址会把编译器自己的 TLS 换掉。Uya 的 libc 把线程堆缓存放在
    // gs:8，一旦被换掉，编译器下一次 malloc 就会从垃圾指针里取 tcache
    // （实测 test_typed_pipeline_capability 崩在 tcache_count，cache=0x16）。
    // 调用方都忽略返回值，假成功即可。
    if nr_value == 158 || nr_value == 205 {
        const ignored_raw: ExecValue = exec_make_i64(0i64);
        const ignored_cast: ExecValue = exec_vm_cast_value(ignored_raw, target_kind, target_pointee_kind);
        out_value[0] = exec_make_error_union_ok(ignored_cast);
        return 0;
    }
    // epoll_ctl(233)：`&EpollEvent` 入参必须转成原生布局，否则内核读到的
    // 是 VM 槽位（ExecValue）/ 聚合缓冲区（每个字段 8 字节）而不是 12 字节的
    // C `struct epoll_event`。
    //
    // **不能**按「地址是否落在 VM 驻留区」来筛：结构体按值返回时会被放进一块
    // 原生聚合缓冲区（3 个字段 × 8 字节），地址不在驻留区里，可那恰恰是最需要
    // 转换的一种。原样交给内核时，内核按 `{u32 events; u64 data@4}` 读，
    // `data` 取到的是第 2、3 个字段的高低位错位值 0x0000000600000000 ——
    // 注册「成功」，但 `epoll_wait` 回来后 `epoll_event_fd` 读到 0，
    // `find_slot` 找不到，waker 永不唤醒（test_std_async_event 系列）。
    // 所以一律先尝试转换，转换失败（比如 EPOLL_CTL_DEL 传 0）才保留原地址。
    const EPOLL_CTL_NR: i64 = 233;
    if nr_value == EPOLL_CTL_NR && arg_count >= 4 {
        const ev_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 3);
        const ev_buf: &byte = exec_value_alloc_bytes(32 as usize) as &byte;
        if ev_arg != null && ev_buf != null &&
            exec_vm_epoll_ctl_native_event(ev_arg, args[3], ev_buf) == 0 {
            args[3] = @usize_from_ptr(ev_buf as &void) as i64;
        }
    }
    out_value[0] = exec_vm_dispatch_host_syscall(target_kind, target_pointee_kind, nr_value, &args[0], arg_count);
    var out_apply_i: i32 = 0;
    while out_apply_i < out_count2 {
        exec_vm_syscall_out_struct_apply(out_targets[out_apply_i], out_buffers[out_apply_i],
            out_fields[out_apply_i]);
        out_apply_i = out_apply_i +| 1;
    }
    // 标量出参回填：只处理「shield 换过地址」且「原始地址指向标量槽」的参数。
    // 聚合槽的 `ptr_value` 非空，交给上面的 out_struct 通道，这里跳过。
    var sc_i: i32 = 0;
    while sc_i < arg_count && sc_i < 6 {
        if args[sc_i] != raw_before[sc_i] && raw_before[sc_i] != 0 {
            const sc_slot: &ExecValue = exec_vm_realign_to_slot(raw_before[sc_i] as usize);
            if sc_slot != null && sc_slot.ptr_value == null {
                const sc_buf: &i64 = @ptr_from_usize(args[sc_i] as usize) as &i64;
                if sc_buf != null {
                    sc_slot[0].i64_value = sc_buf[0];
                }
            }
        }
        sc_i = sc_i + 1;
    }
    // epoll_wait(232) / epoll_pwait(281)：内核写的是 packed 12 字节记录，
    // 通用 apply 的 8 字节步长会把字段读歪，这里按 packed 记录重新解包。
    if (nr_value == 232i64 || nr_value == 281i64) && out_count2 > 0 {
        const got_value: ExecValue = exec_value_unwrap_ok(exec_value_clone(&out_value[0]));
        if got_value.i64_value > 0i64 {
            exec_vm_unpack_epoll_events(out_targets[0], out_buffers[0], got_value.i64_value as i32);
        }
    }
    return 0;
}

fn exec_vm_va_start(function: &BCFunction, frame: &ExecFrame, ap_ref_slot: &ExecValue) i32 {
    if function == null || frame == null {
        exec_backend_set_error(null, "exec: va_start 输入无效" as *byte, 0);
        return -1;
    }
    const ap_target: &ExecValue = exec_vm_resolve_va_target(ap_ref_slot);
    if ap_target == null {
        exec_backend_set_error(function.decl, "exec: va_start 目标无效" as *byte, 0);
        return -1;
    }
    ap_target[0] = exec_make_va_list(&frame.varargs[0], frame.vararg_count, 0);
    return 0;
}

fn exec_vm_va_end(function: &BCFunction, ap_ref_slot: &ExecValue) i32 {
    if function == null {
        exec_backend_set_error(null, "exec: va_end 输入无效" as *byte, 0);
        return -1;
    }
    const ap_target: &ExecValue = exec_vm_resolve_va_target(ap_ref_slot);
    if ap_target == null {
        exec_backend_set_error(function.decl, "exec: va_end 目标无效" as *byte, 0);
        return -1;
    }
    ap_target[0] = exec_make_void();
    return 0;
}

fn exec_vm_va_copy(function: &BCFunction, dest_ref_slot: &ExecValue, src_ref_slot: &ExecValue) i32 {
    if function == null {
        exec_backend_set_error(null, "exec: va_copy 输入无效" as *byte, 0);
        return -1;
    }
    const dest_target: &ExecValue = exec_vm_resolve_va_target(dest_ref_slot);
    const src_target: &ExecValue = exec_vm_resolve_va_target(src_ref_slot);
    if dest_target == null || src_target == null {
        exec_backend_set_error(function.decl, "exec: va_copy 目标无效" as *byte, 0);
        return -1;
    }
    if src_target.kind != ExecValueKind.EXEC_VALUE_VA_LIST {
        exec_backend_set_error(function.decl, "exec: va_copy 源不是 va_list" as *byte, 0);
        return -1;
    }
    dest_target[0] = exec_value_clone(src_target);
    return 0;
}

fn exec_vm_va_arg(function: &BCFunction, ap_ref_slot: &ExecValue, target_kind: i32, target_pointee_kind: i32, out_value: &ExecValue) i32 {
    if function == null || out_value == null {
        exec_backend_set_error(null, "exec: va_arg 输入无效" as *byte, 0);
        return -1;
    }
    const ap_target: &ExecValue = exec_vm_resolve_va_target(ap_ref_slot);
    if ap_target == null {
        exec_backend_set_error(function.decl, "exec: va_arg 目标无效" as *byte, 0);
        return -1;
    }
    if ap_target.kind != ExecValueKind.EXEC_VALUE_VA_LIST {
        exec_backend_set_error(function.decl, "exec: va_arg 源不是 va_list" as *byte, 0);
        return -1;
    }
    const arg_index: i32 = ap_target.i64_value as i32;
    const arg_count: i32 = ap_target.aux_i64_value as i32;
    if arg_index < 0 || arg_index >= arg_count {
        exec_backend_set_error(function.decl, "exec: va_arg 越界" as *byte, 0);
        return -1;
    }
    const args_ptr: &ExecValue = ap_target.ptr_value as &ExecValue;
    if args_ptr == null {
        exec_backend_set_error(function.decl, "exec: va_arg 数据为空" as *byte, 0);
        return -1;
    }
    const raw_value: ExecValue = args_ptr[arg_index];
    ap_target.i64_value = (arg_index + 1) as i64;
    out_value[0] = exec_vm_cast_value(raw_value, target_kind, target_pointee_kind);
    return 0;
}

fn exec_vm_host_call_site_ref(program: &BCProgram, idx: i32) &BCHostCallSite {
    if program == null || program.host_calls == null || idx < 0 || idx >= program.host_call_count {
        return null;
    }
    return &program.host_calls[idx];
}

fn exec_vm_pointer_load_value(function: &BCFunction, ptr_value: &ExecValue, out_value: &ExecValue) i32 {
    if function == null || ptr_value == null || out_value == null {
        exec_backend_set_error(null, "exec: pointer load helper 输入无效" as *byte, 0);
        return -1;
    }
    if exec_vm_pointer_is_internal_ref(ptr_value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(ptr_value);
        if target == null {
            exec_backend_set_error(function.decl, "exec: pointer load helper 目标为空" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_value_clone(target);
        return 0;
    }
    if exec_value_is_pointer_like(ptr_value[0]) != 0 {
        return exec_vm_load_pointer_index(function, ptr_value[0], 0, 0 as usize, out_value);
    }
    exec_backend_set_error(function.decl, "exec: pointer load helper 目标不是指针" as *byte, 0);
    return -1;
}

fn exec_vm_pointer_store_value(function: &BCFunction, ptr_value: &ExecValue, src_value: ExecValue) i32 {
    if function == null || ptr_value == null {
        exec_backend_set_error(null, "exec: pointer store helper 输入无效" as *byte, 0);
        return -1;
    }
    if exec_vm_pointer_is_internal_ref(ptr_value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(ptr_value);
        if target == null {
            exec_backend_set_error(function.decl, "exec: pointer store helper 目标为空" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(target, src_value);
        return 0;
    }
    if exec_value_is_pointer_like(ptr_value[0]) != 0 {
        return exec_vm_store_pointer_index(function, ptr_value[0], 0, 0 as usize, src_value);
    }
    exec_backend_set_error(function.decl, "exec: pointer store helper 目标不是指针" as *byte, 0);
    return -1;
}

/// 原子读改写：读旧值 -> 按 op 算新值 -> 写回 -> 输出旧值或新值。
///
/// 参数：`op` 0=只读、1=加、2=减、3=写成第 2 个实参；
///       `want_new` 非 0 时输出新值（add_fetch 语义），否则输出旧值。
/// 返回值：0 成功；-1 失败（已设置错误）。
fn exec_vm_atomic_update(function: &BCFunction, frame: &ExecFrame, arg_base: i32,
    op: i32, want_new: i32, out_value: &ExecValue) i32 {
    const ptr_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
    if ptr_arg == null {
        exec_backend_set_error(function.decl, "exec: 原子操作参数槽位非法" as *byte, 0);
        return -1;
    }
    var current: ExecValue = exec_make_void();
    if exec_vm_pointer_load_value(function, ptr_arg, &current) != 0 {
        return -1;
    }
    if op == 0 {
        out_value[0] = exec_value_clone(&current);
        return 0;
    }
    const operand_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
    if operand_arg == null {
        exec_backend_set_error(function.decl, "exec: 原子操作操作数槽位非法" as *byte, 0);
        return -1;
    }
    var updated_value: ExecValue = operand_arg[0];
    if op == 1 || op == 2 {
        const base_i64: i64 = exec_vm_numeric_to_i64(exec_value_clone(&current));
        const operand_i64: i64 = exec_vm_numeric_to_i64(operand_arg[0]);
        var new_i64: i64 = base_i64 +| operand_i64;
        if op == 2 {
            new_i64 = base_i64 -| operand_i64;
        }
        updated_value = exec_make_i64(new_i64);
    }
    const pointee_kind_atomic: i32 = exec_value_pointer_pointee_kind(&ptr_arg[0]);
    const cast_updated: ExecValue = exec_vm_cast_value(updated_value, pointee_kind_atomic, 0);
    if exec_vm_pointer_store_value(function, ptr_arg, cast_updated) != 0 {
        return -1;
    }
    if want_new != 0 {
        out_value[0] = cast_updated;
    } else {
        out_value[0] = exec_value_clone(&current);
    }
    return 0;
}

/// 同步解释器里的「线程」槽位表：`pthread_create` 只登记，`join`/`detach` 只维护状态。
/// 块上限与 pthread 用例规模匹配（远小于真实线程数上限）。
const EXEC_VM_THREAD_SLOTS: i32 = 16;

var exec_vm_thread_used: [i32: EXEC_VM_THREAD_SLOTS] = [];
var exec_vm_thread_detached: [i32: EXEC_VM_THREAD_SLOTS] = [];
var exec_vm_thread_result: [ExecValue: EXEC_VM_THREAD_SLOTS] = [];

/// `pthread_key_*` 的线程局部存储：键下标 → 值（同步 VM 只有一条"线程"）。
const EXEC_VM_TLS_KEYS: i32 = 16;
var exec_vm_tls_values: [ExecValue: EXEC_VM_TLS_KEYS] = [];
var exec_vm_tls_used: [i32: EXEC_VM_TLS_KEYS] = [];
var g_exec_vm_cancel_state: i32 = 0;
var g_exec_vm_cancel_type: i32 = 0;

/// `pthread_exit(v)` 在同步解释器里的「提前收工」标记：v 作为当前帧的返回值。
var g_exec_vm_thread_exit_requested: i32 = 0;
var g_exec_vm_thread_exit_value: ExecValue = ExecValue {
    kind: ExecValueKind.EXEC_VALUE_VOID,
    i64_value: 0,
    ptr_value: null,
    aux_kind: ExecValueKind.EXEC_VALUE_VOID,
    aux_i64_value: 0,
    aux_ptr_value: null,
    error_id: 0,
};

/// `&fn` 产出的指针值基址（与构建期 `EXEC_FN_REF_BASE` 保持一致）。
const EXEC_VM_FN_REF_BASE: i64 = 0x40000000;

/// 把 `&fn` 指针值解成模块内函数下标。
/// 参数：`value` 指针值。返回值：函数下标；不是函数地址返回 -1。
fn exec_vm_fn_ref_index(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_POINTER {
        return -1;
    }
    if value.i64_value < EXEC_VM_FN_REF_BASE {
        return -1;
    }
    return (value.i64_value - EXEC_VM_FN_REF_BASE) as i32;
}

/// 从 `pthread_t` 值里读线程槽位号（`tid` 字段，字段 0；0 表示未创建）。
/// 参数：thread - `pthread_t` 值（结构体或指向结构体的引用）。
/// 返回值：槽位下标；无效返回 -1。
fn exec_vm_thread_slot_of(thread: &ExecValue) i32 {
    if thread == null {
        return -1;
    }
    const tid_field: &ExecValue = exec_vm_field_ref(thread, 0);
    if tid_field == null {
        return -1;
    }
    const slot: i32 = (tid_field.i64_value -| 1) as i32;
    if slot < 0 || slot >= EXEC_VM_THREAD_SLOTS {
        return -1;
    }
    return slot;
}

/// 按函数名分派一元 libm（`f64 -> f64`）。
///
/// 参数：`name` 函数名；`x` 入参。
/// 返回值：计算结果；名字不认识时返回 0（调用方已按名字校验过，正常不会命中）。
fn exec_vm_libm_unary(name: &byte, x: f64) f64 {
    if str_equals(name, "fabs" as &byte) != 0 { return fabs(x); }
    if str_equals(name, "sqrt" as &byte) != 0 { return sqrt(x); }
    if str_equals(name, "cbrt" as &byte) != 0 { return cbrt(x); }
    if str_equals(name, "exp" as &byte) != 0 { return exp(x); }
    if str_equals(name, "exp2" as &byte) != 0 { return exp2(x); }
    if str_equals(name, "log" as &byte) != 0 { return log(x); }
    if str_equals(name, "log2" as &byte) != 0 { return log2(x); }
    if str_equals(name, "log10" as &byte) != 0 { return log10(x); }
    if str_equals(name, "sin" as &byte) != 0 { return sin(x); }
    if str_equals(name, "cos" as &byte) != 0 { return cos(x); }
    if str_equals(name, "tan" as &byte) != 0 { return tan(x); }
    if str_equals(name, "asin" as &byte) != 0 { return asin(x); }
    if str_equals(name, "acos" as &byte) != 0 { return acos(x); }
    if str_equals(name, "atan" as &byte) != 0 { return atan(x); }
    if str_equals(name, "sinh" as &byte) != 0 { return sinh(x); }
    if str_equals(name, "cosh" as &byte) != 0 { return cosh(x); }
    if str_equals(name, "tanh" as &byte) != 0 { return tanh(x); }
    if str_equals(name, "floor" as &byte) != 0 { return floor(x); }
    if str_equals(name, "ceil" as &byte) != 0 { return ceil(x); }
    if str_equals(name, "round" as &byte) != 0 { return round(x); }
    if str_equals(name, "trunc" as &byte) != 0 { return trunc(x); }
    return 0.0;
}

/// 按函数名分派二元 libm（`(f64, f64) -> f64`）。
///
/// 参数：`name` 函数名；`x`/`y` 入参。
/// 返回值：计算结果；名字不认识时返回 0。
fn exec_vm_libm_binary(name: &byte, x: f64, y: f64) f64 {
    if str_equals(name, "pow" as &byte) != 0 { return pow(x, y); }
    if str_equals(name, "fmod" as &byte) != 0 { return fmod(x, y); }
    if str_equals(name, "atan2" as &byte) != 0 { return atan2(x, y); }
    if str_equals(name, "hypot" as &byte) != 0 { return hypot(x, y); }
    if str_equals(name, "copysign" as &byte) != 0 { return copysign(x, y); }
    if str_equals(name, "fmin" as &byte) != 0 { return fmin(x, y); }
    if str_equals(name, "fmax" as &byte) != 0 { return fmax(x, y); }
    return 0.0;
}

/// 真正调用内核的 `rt_sigprocmask`（14 号）。
///
/// 参数：`how`（SIG_BLOCK=0 / SIG_UNBLOCK=1 / SIG_SETMASK=2）；`mask_new` 新屏蔽字
/// 的低 64 位；`mask_old` 接收旧屏蔽字；`has_set` 为 0 时按「set 传 null」处理。
/// 返回值：内核返回值（0 成功，负数为 -errno）。
fn exec_vm_rt_sigprocmask(how: i32, mask_new: i64, mask_old: &i64, has_set: bool) i64 {
    var buf_new: [i64: 1] = [mask_new];
    var buf_old: [i64: 1] = [0i64];
    var set_ptr: i64 = 0;
    if has_set {
        set_ptr = @usize_from_ptr(&buf_new[0] as &void) as i64;
    }
    const raw: !i64 = @syscall(14i64, how as i64, set_ptr,
        @usize_from_ptr(&buf_old[0] as &void) as i64, 8i64);
    const rc: i64 = raw catch { return 0 -| 1; };
    if mask_old != null {
        mask_old[0] = buf_old[0];
    }
    return rc;
}

fn exec_vm_call_host(program: &BCProgram, function: &BCFunction, site: &BCHostCallSite, frame: &ExecFrame, arg_base: i32, arg_count: i32, out_value: &ExecValue) i32 {
    if function == null || site == null || frame == null || out_value == null {
        exec_backend_set_error(null, "exec: hostcall 输入无效" as *byte, 0);
        return -1;
    }
    if site.arg_count != arg_count {
        exec_backend_set_error(function.decl, "exec: hostcall 参数数量非法" as *byte, 0);
        return -1;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PUTS {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: puts 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: puts 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(puts(arg0.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOI {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: atoi 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: atoi 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(atoi(arg0.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOLL {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: atoll 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: atoll 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i64(atoll(arg0.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_LIBM1 {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: libm 一元参数数量非法" as *byte, 0);
            return -1;
        }
        const libm1_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if libm1_arg == null || site.name == null {
            exec_backend_set_error(function.decl, "exec: libm 一元参数槽位非法" as *byte, 0);
            return -1;
        }
        const x1: f64 = exec_value_as_f64(libm1_arg);
        out_value[0] = exec_make_f64(exec_vm_libm_unary(site.name, x1));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_LIBM2 {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: libm 二元参数数量非法" as *byte, 0);
            return -1;
        }
        const libm2_a: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const libm2_b: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if libm2_a == null || libm2_b == null || site.name == null {
            exec_backend_set_error(function.decl, "exec: libm 二元参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_f64(exec_vm_libm_binary(site.name,
            exec_value_as_f64(libm2_a), exec_value_as_f64(libm2_b)));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ISQRT {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: isqrt 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: isqrt 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_u64(isqrt(arg0.i64_value as u64));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_STRCMP {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: strcmp 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if arg0 == null || arg1 == null {
            exec_backend_set_error(function.decl, "exec: strcmp 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(strcmp(arg0.ptr_value, arg1.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_LLABS {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: llabs 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: llabs 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i64(llabs(arg0.i64_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MEMCPY || site.id == ExecHostCallId.EXEC_HOST_CALL_MEMMOVE ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_MEMSET {
        if arg_count != 3 {
            exec_backend_set_error(function.decl, "exec: 内存函数参数数量非法" as *byte, 0);
            return -1;
        }
        const mem_dst: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const mem_second: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const mem_n: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if mem_dst == null || mem_second == null || mem_n == null {
            exec_backend_set_error(function.decl, "exec: 内存函数参数槽位非法" as *byte, 0);
            return -1;
        }
        const mem_count: usize = mem_n.i64_value as usize;
        var mem_copy_len: usize = mem_count;
        var dst_cap: usize = 0 as usize;
        var dst_view: i32 = 0;
        var src_cap: usize = 0 as usize;
        var src_view: i32 = 0;
        const mem_dst_ptr: &byte = exec_vm_mem_view(mem_dst, &dst_cap, &dst_view);
        var mem_src_ptr: &byte = mem_second.ptr_value;
        if site.id != ExecHostCallId.EXEC_HOST_CALL_MEMSET {
            mem_src_ptr = exec_vm_mem_view(mem_second, &src_cap, &src_view);
        }
        // 原生块之间的 memcpy：旁路表里挂在源基址上的结构体元素一起搬过去
        // （`malloc + memcpy + free` 增容后旧元素不能凭空消失）。
        if (site.id == ExecHostCallId.EXEC_HOST_CALL_MEMCPY ||
            site.id == ExecHostCallId.EXEC_HOST_CALL_MEMMOVE) &&
            dst_view != EXEC_MEM_VIEW_VALUE && src_view != EXEC_MEM_VIEW_VALUE &&
            mem_dst_ptr != null && mem_src_ptr != null {
            exec_vm_native_agg_carry(@usize_from_ptr(mem_src_ptr as &void),
                @usize_from_ptr(mem_dst_ptr as &void));
        }
        // 目标是 VM 值本体（`&local`/`&field`）：不能按字节写，按语义整体处理。
        if dst_view == EXEC_MEM_VIEW_VALUE && mem_count > 0 as usize {
            if site.id == ExecHostCallId.EXEC_HOST_CALL_MEMSET && (mem_second.i64_value as byte) == 0 {
                const dst_target: &ExecValue = exec_vm_ref_target_value(mem_dst);
                exec_vm_zero_value_in_place(dst_target);
                out_value[0] = mem_dst[0];
                return 0;
            }
            if site.id != ExecHostCallId.EXEC_HOST_CALL_MEMSET && src_view == EXEC_MEM_VIEW_VALUE {
                const dst_target2: &ExecValue = exec_vm_ref_target_value(mem_dst);
                const src_target: &ExecValue = exec_vm_ref_target_value(mem_second);
                if dst_target2 != null && src_target != null && dst_target2.kind != src_target.kind {
                    // 位转换（`memcpy(&u64, &f64, 8)`）：保留目标的 kind，只搬位。
                    exec_vm_store_slot(dst_target2, exec_vm_bitcast_value(src_target, dst_target2.kind));
                } else {
                    exec_vm_store_slot(dst_target2, src_target[0]);
                }
                out_value[0] = mem_dst[0];
                return 0;
            }
            // 目标是 VM 值本体、**源是原生缓冲区**（`memcpy(&f, &buf[off], 4)`，
            // 典型形态是 tflm 的 `load_f32`）。按字节读源、再按目标 kind 组装值。
            if site.id != ExecHostCallId.EXEC_HOST_CALL_MEMSET && mem_src_ptr != null {
                if src_view != EXEC_MEM_VIEW_VALUE {
                    const dst_target3: &ExecValue = exec_vm_ref_target_value(mem_dst);
                    if dst_target3 != null {
                        const wrote: i32 = exec_vm_scalar_from_bytes(
                            dst_target3[0].kind, mem_src_ptr, mem_count, dst_target3);
                        if wrote == 0 {
                            out_value[0] = mem_dst[0];
                            return 0;
                        }
                    }
                }
            }
            // 源也是 VM 视图，但它指向的是单个标量（`&(p[off])` 里 `p` 是
            // VM 里的指针值）：把源值按字节展开，再装进目标。tflm 的
            // `load_f32` 就走这条 —— 源 `&(p[off])` 被判成 single-element 视图。
            if site.id != ExecHostCallId.EXEC_HOST_CALL_MEMSET {
                const src_target3: &ExecValue = exec_vm_ref_target_value(mem_second);
                const dst_target4: &ExecValue = exec_vm_ref_target_value(mem_dst);
                if src_target3 != null && dst_target4 != null {
                    if exec_vm_copy_value_bits(src_target3, dst_target4, mem_count) == 0 {
