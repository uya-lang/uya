// exec/vm.uya - Minimal bytecode VM

use libc;
use libc.puts;
use libc.atoi;
use libc.atoll;
use libc.isqrt;
use libc.strcmp;
use libc.llabs;
use libc.mkdir;
use libc.rmdir;
use libc.fprintf;
use libc.printf;
use libc.sprintf;
use libc.snprintf;
use libc.write;
use libc.strlen;
use libc.fflush;
use libc.malloc;
use libc.calloc;
use libc.realloc;
use libc.free;
use libc.exit;
use libc.fflush;

const EXEC_VM_REF_KIND_BASE: i32 = 65536;
const EXEC_VM_REF_KIND_INDEX_BASE: i32 = 131072;

// 调用帧槽位的共享栈（LIFO）。
//
// 早先每个调用都在 C 栈上放一个 `[ExecValue: 8192]`（约 393KB）并逐槽清零：
// 一次普通函数调用要几十万条初始化指令，纯计算型用例（大数模幂、SHA-384）
// 因此慢到几十分钟。改为按 function.slot_count 从共享栈里切一段，调用返回时
// 回退栈顶；递归按 LIFO 自然正确。
var g_exec_vm_slot_pool: [ExecValue: EXEC_MAX_FRAME_SLOTS] = [];
var g_exec_vm_slot_top: i32 = 0;

/// 从共享槽位栈里切一段给新调用帧。
/// 参数：`slot_count` 本次调用需要的槽位数。
/// 返回值：切出的起始下标；空间不足返回 -1。
fn exec_vm_slot_pool_push(slot_count: i32) i32 {
    if slot_count < 0 || g_exec_vm_slot_top < 0 {
        return -1;
    }
    const base: i32 = g_exec_vm_slot_top;
    if slot_count > EXEC_MAX_FRAME_SLOTS -| base {
        return -1;
    }
    g_exec_vm_slot_top = base +| slot_count;
    return base;
}

/// 取共享槽位栈里某段起始位置的值指针。
/// 参数：`base` push 返回的起始下标。
/// 返回值：指向该槽位的指针；下标越界返回 null。
fn exec_vm_slot_pool_base(base: i32) &ExecValue {
    if base < 0 || base >= EXEC_MAX_FRAME_SLOTS {
        return null;
    }
    return &g_exec_vm_slot_pool[base];
}

/// 归还一段槽位（必须与 push 一一配对）。
/// 参数：`base` push 返回的起始下标。
fn exec_vm_slot_pool_pop(base: i32) void {
    if base >= 0 && base <= EXEC_MAX_FRAME_SLOTS {
        g_exec_vm_slot_top = base;
    }
}

fn exec_vm_slot_ref(frame: &ExecFrame, idx: i32) &ExecValue {
    if frame == null || idx < 0 || idx >= EXEC_MAX_FRAME_SLOTS {
        return null;
    }
    if idx >= 0 && idx < EXEC_MAX_FRAME_SLOTS {
        return &frame.slots[idx];
    }
    return null;
}

/// 判断某个值是否「自己拥有」它的聚合内存（可以原地复用）。
///
/// `error_id` 对聚合/原始数组没有其它含义：0 表示这块内存是当前槽位独占的
/// （`exec_value_clone` / 构造时新建），非 0 表示它是从别的槽位浅拷贝借来的
/// （`exec_vm_store_slot_shallow`），不能原地写，否则会改到别人。
fn exec_vm_value_owns_buffer(value: &ExecValue) i32 {
    if value == null {
        return 0;
    }
    if value.kind != ExecValueKind.EXEC_VALUE_ARRAY &&
        value.kind != ExecValueKind.EXEC_VALUE_STRUCT &&
        value.kind != ExecValueKind.EXEC_VALUE_TUPLE {
        return 0;
    }
    return (value.error_id == 0) as i32;
}

/// 尝试把 `src` 逐元素写进 `dst` 已有的聚合缓冲区（不重新分配）。
///
/// 参数：`dst` 目标槽位值；`src` 源值。
/// 返回值：1 表示已就地完成（值语义与深拷贝一致）；0 表示需要走深拷贝。
fn exec_vm_store_aggregate_in_place(dst: &ExecValue, src: &ExecValue) i32 {
    if dst == null || src == null || exec_vm_value_owns_buffer(dst) == 0 {
        return 0;
    }
    if dst.kind != src.kind {
        return 0;
    }
    if exec_value_is_raw_array(src) != 0 {
        if exec_value_is_raw_array(dst) == 0 || dst.i64_value != src.i64_value {
            return 0;
        }
        if dst.aux_i64_value != src.aux_i64_value || dst.ptr_value == src.ptr_value {
            return 0;
        }
        if dst.ptr_value == null || src.ptr_value == null {
            return 0;
        }
        const elem_size: usize = exec_vm_type_kind_size(src.aux_i64_value as i32);
        if elem_size == 0 as usize {
            return 0;
        }
        _ = memcpy(dst.ptr_value as *void, src.ptr_value as *const void,
            elem_size * (src.i64_value as usize));
        return 1;
    }
    const dst_agg: &ExecAggregate = exec_value_as_aggregate(dst);
    const src_agg: &ExecAggregate = exec_value_as_aggregate(src);
    if dst_agg == null || src_agg == null || dst_agg.count != src_agg.count {
        return 0;
    }
    if dst_agg.values == src_agg.values {
        return 1;
    }
    var i: i32 = 0;
    while i < dst_agg.count {
        exec_vm_store_slot(&dst_agg.values[i], src_agg.values[i]);
        i = i + 1;
    }
    dst.i64_value = src.i64_value;
    return 1;
}

fn exec_vm_store_slot(slot: &ExecValue, value: ExecValue) void {
    if slot == null {
        return;
    }
    // 目标槽位已经持有同形聚合时逐元素覆盖：循环里反复赋值 `[u64: N]` / 结构体
    // 时不再每次都向 arena 申请整块内存（curve25519 这类纯计算用例原本会按
    // 每秒几十 MB 一路上涨）。
    if exec_vm_store_aggregate_in_place(&slot[0], &value) != 0 {
        return;
    }
    slot[0] = exec_value_clone(&value);
}

/// 把值原样写进槽位（不深拷贝）。
///
/// 表达式求值读局部/全局变量时用这个：`exec_value_clone` 对聚合数组是逐元素
/// 深拷贝，而聚合内存来自只增不减的 arena —— `acc[i]` 这种下标读每执行一次就
/// 复制整个数组，循环里直接把内存吃到 GB 级（test_crypto_bigint 的 7GB 就是这么
/// 来的）。读出来的临时值不会被写回，浅拷贝即可；真正的赋值（BC_MOV /
/// BC_STORE_LOCAL / 字段与下标写）仍然走深拷贝，值语义不变。
fn exec_vm_store_slot_shallow(slot: &ExecValue, value: ExecValue) void {
    if slot == null {
        return;
    }
    slot[0] = value;
    // 标记为「借来的」聚合内存：后续若要往这个槽位写，必须另做深拷贝，
    // 不能原地覆盖（那块内存还属于别人）。
    if slot[0].kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        slot[0].kind == ExecValueKind.EXEC_VALUE_STRUCT ||
        slot[0].kind == ExecValueKind.EXEC_VALUE_TUPLE {
        slot[0].error_id = 1;
    }
}

fn exec_vm_global_ref(program: &BCProgram, idx: i32) &ExecValue {
    if program == null || idx < 0 || idx >= program.global_count || program.globals == null {
        return null;
    }
    return &program.globals[idx];
}

fn exec_vm_value_kind_is_unsigned(kind: ExecValueKind) i32 {
    if kind == ExecValueKind.EXEC_VALUE_U8 ||
        kind == ExecValueKind.EXEC_VALUE_U16 ||
        kind == ExecValueKind.EXEC_VALUE_U32 ||
        kind == ExecValueKind.EXEC_VALUE_U64 ||
        kind == ExecValueKind.EXEC_VALUE_USIZE ||
        kind == ExecValueKind.EXEC_VALUE_BYTE ||
        kind == ExecValueKind.EXEC_VALUE_POINTER ||
        kind == ExecValueKind.EXEC_VALUE_STRING {
        return 1;
    }
    return 0;
}

// 按目标整数类型求饱和边界（有符号）
fn exec_vm_sat_bounds_signed(kind: ExecValueKind, out_min: &i64, out_max: &i64) void {
    out_min[0] = -2147483647 - 1;
    out_max[0] = 2147483647;
    if kind == ExecValueKind.EXEC_VALUE_I8 {
        out_min[0] = -128;  out_max[0] = 127;
    } else if kind == ExecValueKind.EXEC_VALUE_I16 {
        out_min[0] = -32768; out_max[0] = 32767;
    } else if kind == ExecValueKind.EXEC_VALUE_I64 || kind == ExecValueKind.EXEC_VALUE_ISIZE {
        out_min[0] = @min; out_max[0] = @max;
    }
}

// 按目标整数类型求饱和边界（无符号）
fn exec_vm_sat_bounds_unsigned(kind: ExecValueKind, out_max: &u64) void {
    out_max[0] = 4294967295u64;
    if kind == ExecValueKind.EXEC_VALUE_U8 {
        out_max[0] = 255u64;
    } else if kind == ExecValueKind.EXEC_VALUE_U16 {
        out_max[0] = 65535u64;
    } else if kind == ExecValueKind.EXEC_VALUE_U64 || kind == ExecValueKind.EXEC_VALUE_USIZE {
        out_max[0] = @max;
    } else if kind == ExecValueKind.EXEC_VALUE_BYTE {
        out_max[0] = 255u64;
    }
}

// 饱和加法：结果超出目标类型时钳到极值
fn exec_vm_sat_add(kind: ExecValueKind, a_signed: i64, a_unsigned: u64, b_signed: i64, b_unsigned: u64) ExecValue {
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        var umax: [u64: 1] = [0u64];
        exec_vm_sat_bounds_unsigned(kind, &umax[0]);
        const sum: u64 = a_unsigned + b_unsigned;
        if sum < a_unsigned {
            return exec_vm_make_integer_by_kind(kind, 0, umax[0]);
        }
        if sum > umax[0] {
            return exec_vm_make_integer_by_kind(kind, 0, umax[0]);
        }
        return exec_vm_make_integer_by_kind(kind, 0, sum);
    }
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    var sum2: i64 = a_signed +| b_signed;
    if b_signed > 0 && a_signed > hi[0] -| b_signed {
        sum2 = hi[0];
    } else if b_signed < 0 && a_signed < lo[0] -| b_signed {
        sum2 = lo[0];
    }
    return exec_vm_make_integer_by_kind(kind, sum2, 0);
}

// 饱和减法
fn exec_vm_sat_sub(kind: ExecValueKind, a_signed: i64, a_unsigned: u64, b_signed: i64, b_unsigned: u64) ExecValue {
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        if b_unsigned > a_unsigned {
            return exec_vm_make_integer_by_kind(kind, 0, 0u64);
        }
        return exec_vm_make_integer_by_kind(kind, 0, a_unsigned - b_unsigned);
    }
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    var diff: i64 = a_signed -| b_signed;
    if b_signed < 0 && a_signed > hi[0] +| b_signed {
        diff = hi[0];
    } else if b_signed > 0 && a_signed < lo[0] +| b_signed {
        diff = lo[0];
    }
    return exec_vm_make_integer_by_kind(kind, diff, 0);
}

// 饱和乘法
fn exec_vm_sat_mul(kind: ExecValueKind, a_signed: i64, a_unsigned: u64, b_signed: i64, b_unsigned: u64) ExecValue {
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        var umax: [u64: 1] = [0u64];
        exec_vm_sat_bounds_unsigned(kind, &umax[0]);
        if a_unsigned != 0u64 && b_unsigned > umax[0] / a_unsigned {
            return exec_vm_make_integer_by_kind(kind, 0, umax[0]);
        }
        return exec_vm_make_integer_by_kind(kind, 0, a_unsigned * b_unsigned);
    }
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    const prod: i64 = a_signed *| b_signed;
    // 用除法回验是否溢出（避免依赖未定义的乘法溢出）
    if a_signed != 0 && (prod / a_signed != b_signed) {
        if (a_signed > 0 && b_signed > 0) || (a_signed < 0 && b_signed < 0) {
            return exec_vm_make_integer_by_kind(kind, hi[0], 0);
        }
        return exec_vm_make_integer_by_kind(kind, lo[0], 0);
    }
    if prod > hi[0] {
        return exec_vm_make_integer_by_kind(kind, hi[0], 0);
    }
    if prod < lo[0] {
        return exec_vm_make_integer_by_kind(kind, lo[0], 0);
    }
    return exec_vm_make_integer_by_kind(kind, prod, 0);
}

// 溢出受检算术（`(a + b) catch` 的语义）：结果封装成错误联合，
// 正常时携带运算结果，溢出/除零时携带 err_id（来自指令 imm 高位，
// 与 checker 注册的 error.Overflow / error.DivisionByZero 一致）。

/// 判断整数 kind 的取值是否落在该类型范围内。
/// 参数：kind 目标整数类型；value 待检查的十进制值。
/// 返回值：1 表示在范围内，0 表示溢出。
fn exec_vm_checked_arith_in_range(kind: ExecValueKind, value: i64) i32 {
    var lo: [i64: 1] = [0i64];
    var hi: [i64: 1] = [0i64];
    exec_vm_sat_bounds_signed(kind, &lo[0], &hi[0]);
    if value < lo[0] || value > hi[0] {
        return 0;
    }
    return 1;
}

/// 判断无符号 kind 的取值是否落在该类型范围内。
/// 参数：kind 目标整数类型；value 待检查的无符号值。
/// 返回值：1 表示在范围内，0 表示越界。
fn exec_vm_checked_arith_in_unsigned_range(kind: ExecValueKind, value: u64) i32 {
    var umax: [u64: 1] = [0u64];
    exec_vm_sat_bounds_unsigned(kind, &umax[0]);
    if value > umax[0] {
        return 0;
    }
    return 1;
}

/// 执行一个溢出受检的整数二元运算。
/// 参数：opcode 受检运算 opcode；type_code 结果类型的 TypeKind 编码；
///       left/right 左右操作数。
/// 返回值：错误联合值；正常分支携带运算结果，错误分支携带溢出/除零 id。
fn exec_vm_checked_arith(opcode: BCOpcode, type_code: i32, err_id: i32, left: ExecValue, right: ExecValue) ExecValue {
    const kind: ExecValueKind = exec_vm_value_kind_from_type_code(type_code, left.kind);
    const is_div: i32 = (opcode == BCOpcode.BC_DIV_CHECK || opcode == BCOpcode.BC_REM_CHECK) as i32;
    if is_div != 0 && right.i64_value == 0 {
        return exec_make_error_union_err(err_id);
    }
    if exec_vm_value_kind_is_float(kind) != 0 {
        // 浮点没有整数溢出语义，退化为普通运算。
        if opcode == BCOpcode.BC_ADD_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) + exec_value_as_f64(&right)));
        }
        if opcode == BCOpcode.BC_SUB_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) - exec_value_as_f64(&right)));
        }
        if opcode == BCOpcode.BC_MUL_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) * exec_value_as_f64(&right)));
        }
        if opcode == BCOpcode.BC_DIV_CHECK {
            return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left) / exec_value_as_f64(&right)));
        }
        return exec_make_error_union_ok(exec_vm_make_float_by_kind(kind, exec_value_as_f64(&left)));
    }
    if exec_vm_value_kind_is_unsigned(kind) != 0 {
        // 无符号 checked 算术：算出结果后按目标类型上界判定是否越界。
        const lhs_u: u64 = left.i64_value as u64;
        const rhs_u: u64 = right.i64_value as u64;
        var value_u: u64 = 0;
        var overflow_u: i32 = 0;
        if opcode == BCOpcode.BC_ADD_CHECK {
            value_u = lhs_u +% rhs_u;
            if (lhs_u +| rhs_u) != value_u {
                overflow_u = 1;
            }
        } else if opcode == BCOpcode.BC_SUB_CHECK {
            if rhs_u > lhs_u {
                overflow_u = 1;
                value_u = 0u64;
            } else {
                value_u = lhs_u - rhs_u;
            }
        } else if opcode == BCOpcode.BC_MUL_CHECK {
            value_u = lhs_u *% rhs_u;
            if (lhs_u *| rhs_u) != value_u {
                overflow_u = 1;
            }
        } else if opcode == BCOpcode.BC_DIV_CHECK {
            value_u = lhs_u / rhs_u;
        } else {
            value_u = lhs_u % rhs_u;
        }
        if overflow_u == 0 && exec_vm_checked_arith_in_unsigned_range(kind, value_u) == 0 {
            overflow_u = 1;
        }
        if overflow_u != 0 {
            return exec_make_error_union_err(err_id);
        }
        return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, 0, value_u));
    }
    const lhs: i64 = left.i64_value;
    const rhs: i64 = right.i64_value;
    if is_div != 0 {
        var lo_div: [i64: 1] = [0i64];
        var hi_div: [i64: 1] = [0i64];
        exec_vm_sat_bounds_signed(kind, &lo_div[0], &hi_div[0]);
        // 最小值 / -1 是唯一的除法溢出；最小值 % -1 定义为 0。
        if rhs == (0 - 1) && lhs == lo_div[0] {
            if opcode == BCOpcode.BC_DIV_CHECK {
                return exec_make_error_union_err(err_id);
            }
            return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, 0, 0u64));
        }
        var value_d: i64 = 0;
        if opcode == BCOpcode.BC_DIV_CHECK {
            value_d = lhs / rhs;
        } else {
            value_d = lhs % rhs;
        }
        return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, value_d, 0));
    }
    // 加减乘：包装结果与饱和结果不一致即 i64 溢出；窄类型再用范围判定。
    var wrapped: i64 = 0;
    var saturated: i64 = 0;
    if opcode == BCOpcode.BC_ADD_CHECK {
        wrapped = lhs +% rhs;
        saturated = lhs +| rhs;
    } else if opcode == BCOpcode.BC_SUB_CHECK {
        wrapped = lhs -% rhs;
        saturated = lhs -| rhs;
    } else {
        wrapped = lhs *% rhs;
        saturated = lhs *| rhs;
    }
    if saturated != wrapped {
        return exec_make_error_union_err(err_id);
    }
    if exec_vm_checked_arith_in_range(kind, wrapped) == 0 {
        return exec_make_error_union_err(err_id);
    }
    return exec_make_error_union_ok(exec_vm_make_integer_by_kind(kind, wrapped, 0));
}

fn exec_vm_make_integer_by_kind(kind: ExecValueKind, signed_value: i64, unsigned_value: u64) ExecValue {
    if kind == ExecValueKind.EXEC_VALUE_I8 {
        return exec_make_i8(signed_value as i8);
    }
    if kind == ExecValueKind.EXEC_VALUE_I16 {
        return exec_make_i16(signed_value as i16);
    }
    if kind == ExecValueKind.EXEC_VALUE_I64 {
        return exec_make_i64(signed_value);
    }
    if kind == ExecValueKind.EXEC_VALUE_ISIZE {
        return exec_make_isize(signed_value as isize);
    }
    if kind == ExecValueKind.EXEC_VALUE_U8 {
        return exec_make_u8(unsigned_value as u8);
    }
    if kind == ExecValueKind.EXEC_VALUE_U16 {
        return exec_make_u16(unsigned_value as u16);
    }
    if kind == ExecValueKind.EXEC_VALUE_U32 {
        return exec_make_u32(unsigned_value as u32);
    }
    if kind == ExecValueKind.EXEC_VALUE_U64 {
        return exec_make_u64(unsigned_value);
    }
    if kind == ExecValueKind.EXEC_VALUE_USIZE {
        return exec_make_usize(unsigned_value as usize);
    }
    if kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f32(signed_value as f32);
    }
    if kind == ExecValueKind.EXEC_VALUE_F64 {
        return exec_make_f64(signed_value as f64);
    }
    if kind == ExecValueKind.EXEC_VALUE_BYTE {
        return exec_make_byte(unsigned_value as i32);
    }
    return exec_make_i32(signed_value as i32);
}

fn exec_vm_value_kind_from_type_code(kind_code: i32, fallback: ExecValueKind) ExecValueKind {
    if kind_code == TypeKind.TYPE_I8 as i32 {
        return ExecValueKind.EXEC_VALUE_I8;
    }
    if kind_code == TypeKind.TYPE_I16 as i32 {
        return ExecValueKind.EXEC_VALUE_I16;
    }
    if kind_code == TypeKind.TYPE_I64 as i32 {
        return ExecValueKind.EXEC_VALUE_I64;
    }
    if kind_code == TypeKind.TYPE_U8 as i32 {
        return ExecValueKind.EXEC_VALUE_U8;
    }
    if kind_code == TypeKind.TYPE_U16 as i32 {
        return ExecValueKind.EXEC_VALUE_U16;
    }
    if kind_code == TypeKind.TYPE_U32 as i32 {
        return ExecValueKind.EXEC_VALUE_U32;
    }
    if kind_code == TypeKind.TYPE_U64 as i32 {
        return ExecValueKind.EXEC_VALUE_U64;
    }
    if kind_code == TypeKind.TYPE_USIZE as i32 {
        return ExecValueKind.EXEC_VALUE_USIZE;
    }
    if kind_code == TypeKind.TYPE_F32 as i32 {
        return ExecValueKind.EXEC_VALUE_F32;
    }
    if kind_code == TypeKind.TYPE_F64 as i32 {
        return ExecValueKind.EXEC_VALUE_F64;
    }
    if kind_code == TypeKind.TYPE_BYTE as i32 {
        return ExecValueKind.EXEC_VALUE_BYTE;
    }
    if kind_code == TypeKind.TYPE_BOOL as i32 {
        return ExecValueKind.EXEC_VALUE_BOOL;
    }
    if kind_code == TypeKind.TYPE_ENUM as i32 {
        return ExecValueKind.EXEC_VALUE_I32;
    }
    if kind_code == TypeKind.TYPE_POINTER as i32 {
        return ExecValueKind.EXEC_VALUE_POINTER;
    }
    if kind_code == TypeKind.TYPE_VA_LIST as i32 {
        return ExecValueKind.EXEC_VALUE_VA_LIST;
    }
    return fallback;
}

fn exec_vm_value_kind_is_float(kind: ExecValueKind) i32 {
    return exec_value_is_float_kind(kind);
}

/// 值类型的 kind 是否是整数族（写回 syscall 出参结构体时用）。
fn exec_vm_value_kind_is_integer(kind: ExecValueKind) i32 {
    if kind == ExecValueKind.EXEC_VALUE_I8 || kind == ExecValueKind.EXEC_VALUE_I16 ||
        kind == ExecValueKind.EXEC_VALUE_I32 || kind == ExecValueKind.EXEC_VALUE_I64 ||
        kind == ExecValueKind.EXEC_VALUE_ISIZE || kind == ExecValueKind.EXEC_VALUE_U8 ||
        kind == ExecValueKind.EXEC_VALUE_U16 || kind == ExecValueKind.EXEC_VALUE_U32 ||
        kind == ExecValueKind.EXEC_VALUE_U64 || kind == ExecValueKind.EXEC_VALUE_USIZE ||
        kind == ExecValueKind.EXEC_VALUE_BOOL || kind == ExecValueKind.EXEC_VALUE_BYTE ||
        kind == ExecValueKind.EXEC_VALUE_POINTER {
        return 1;
    }
    return 0;
}

fn exec_vm_make_float_by_kind(kind: ExecValueKind, value: f64) ExecValue {
    if kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f32(value as f32);
    }
    return exec_make_f64(value);
}

fn exec_vm_numeric_to_i64(value: ExecValue) i64 {
    if exec_vm_value_kind_is_float(value.kind) != 0 {
        return exec_value_as_f64(&value) as i64;
    }
    return value.i64_value;
}

/// 把「指向聚合的内部引用」换算成可当字节地址用的整数。
/// `&buf` 在 C 里与 `&buf[0]` 取值相同；VM 里裸数组的数据在 ptr_value，
/// 直接取引用地址会得到 ExecValue 自身的地址（memset/memcpy 会写坏值）。
/// 参数：value 待换算的值。
/// 返回值：可当字节地址使用的无符号整数。
fn exec_vm_value_bytes_address(value: ExecValue) u64 {
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER && exec_vm_pointer_is_internal_ref(&value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(&value);
        if target != null && exec_value_is_raw_array(target) != 0 {
            return target.ptr_value as u64;
        }
    }
    return exec_vm_numeric_to_u64(value);
}

fn exec_vm_numeric_to_u64(value: ExecValue) u64 {
    if exec_vm_value_kind_is_float(value.kind) != 0 {
        return exec_value_as_f64(&value) as u64;
    }
    return value.i64_value as u64;
}

fn exec_vm_promote_vararg_value(value: ExecValue) ExecValue {
    if value.kind == ExecValueKind.EXEC_VALUE_I8 || value.kind == ExecValueKind.EXEC_VALUE_I16 {
        return exec_make_i32(value.i64_value as i32);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U8 ||
        value.kind == ExecValueKind.EXEC_VALUE_U16 ||
        value.kind == ExecValueKind.EXEC_VALUE_BYTE ||
        value.kind == ExecValueKind.EXEC_VALUE_BOOL {
        return exec_make_i32(value.i64_value as i32);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_F32 {
        return exec_make_f64(exec_value_as_f32(&value) as f64);
    }
    return exec_value_clone(&value);
}

fn exec_vm_resolve_va_target(slot: &ExecValue) &ExecValue {
    if slot == null {
        return null;
    }
    if exec_vm_pointer_is_internal_ref(slot) != 0 {
        return exec_vm_ref_target_value(slot);
    }
    return slot;
}

fn exec_vm_decode_syscall_arg_base(meta: i64) i32 {
    return (meta & 65535) as i32;
}

fn exec_vm_decode_syscall_arg_count(meta: i64) i32 {
    return ((meta >> 16) & 255) as i32;
}

fn exec_vm_decode_syscall_target_kind(meta: i64) i32 {
    return ((meta >> 24) & 65535) as i32;
}

fn exec_vm_decode_syscall_target_pointee_kind(meta: i64) i32 {
    return ((meta >> 40) & 65535) as i32;
}

fn exec_vm_decode_syscall_out_mask(meta: i64) i32 {
    return ((meta >> 56) & 127) as i32;
}

/// 给出参结构体准备原生缓冲区：VM 的聚合值每个字段都是 ExecValue，
/// 内核却按 `{ i64, i64 }` 这类原生布局写入，直接传引用地址会把
/// ExecValue 头部写成垃圾（`sys_gettimeofday(&tv, …)` 之后的 `tv.tv_sec` 就会崩）。
/// 参数：target - 出参聚合值；out_count - 输出字段数。
/// 返回：原生缓冲区（每字段 8 字节），不是聚合值时返回 null。
fn exec_vm_syscall_out_struct_prepare(target: &ExecValue, out_count: &i32) &i64 {
    if target == null || out_count == null {
        return null;
    }
    if target.kind != ExecValueKind.EXEC_VALUE_STRUCT &&
        target.kind != ExecValueKind.EXEC_VALUE_ARRAY &&
        target.kind != ExecValueKind.EXEC_VALUE_TUPLE {
        return null;
    }
    const aggregate: &ExecAggregate = target.ptr_value as &ExecAggregate;
    if aggregate == null || aggregate.values == null {
        return null;
    }
    const field_count: i32 = aggregate.count;
    if field_count <= 0 || field_count > 16 {
        return null;
    }
    const buffer: &i64 = exec_value_alloc_bytes((@size_of(i64) * field_count as usize)) as &i64;
    if buffer == null {
        return null;
    }
    var i: i32 = 0;
    while i < field_count {
        buffer[i] = exec_vm_numeric_to_i64(aggregate.values[i]);
        i = i + 1;
    }
    out_count[0] = field_count;
    return buffer;
}

/// 把原生缓冲区写回出参聚合值（只覆盖整数字段，其余字段保持原值）。
fn exec_vm_syscall_out_struct_apply(target: &ExecValue, buffer: &i64, field_count: i32) void {
    if target == null || buffer == null {
        return;
    }
    const aggregate: &ExecAggregate = target.ptr_value as &ExecAggregate;
    if aggregate == null || aggregate.values == null {
        return;
    }
    var i: i32 = 0;
    while i < aggregate.count && i < field_count {
        if exec_vm_value_kind_is_integer(aggregate.values[i].kind) != 0 {
            aggregate.values[i].i64_value = buffer[i];
        }
        i = i + 1;
    }
}

/// 定位 syscall 出参结构体（参数值可能是指针、内部引用或裸地址）。
fn exec_vm_syscall_out_struct_target(arg_slot: &ExecValue, raw_address: i64) &ExecValue {
    const resolved: &ExecValue = exec_vm_resolve_va_target(arg_slot);
    if resolved != null && (resolved.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
            resolved.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
            resolved.kind == ExecValueKind.EXEC_VALUE_TUPLE) {
        return resolved;
    }
    if raw_address <= 0 {
        return null;
    }
    const by_address: &ExecValue = raw_address as &ExecValue;
    if by_address.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
        by_address.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        by_address.kind == ExecValueKind.EXEC_VALUE_TUPLE {
        return by_address;
    }
    return null;
}

fn exec_vm_syscall_arg_to_i64(value: ExecValue) i64 {
    if exec_value_is_pointer_like(value) != 0 {
        return value.i64_value;
    }
    return exec_vm_numeric_to_i64(value);
}


/// 向量值的元素类型（TypeKind 编码，存放在 i64_value）。
fn exec_value_vector_elem_kind(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_VECTOR {
        return TypeKind.TYPE_VOID as i32;
    }
    return value.i64_value as i32;
}

/// 向量 / 掩码的通道数（存放在 aux_i64_value）。
fn exec_value_vector_lanes(value: &ExecValue) i32 {
    if value == null {
        return 0;
    }
    if value.kind != ExecValueKind.EXEC_VALUE_VECTOR && value.kind != ExecValueKind.EXEC_VALUE_MASK {
        return 0;
    }
    return value.aux_i64_value as i32;
}

/// 向量的数据缓冲（元素紧密排列，无对齐假设）。
fn exec_value_vector_data(value: &ExecValue) &byte {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_VECTOR {
        return null;
    }
    return value.ptr_value;
}

fn exec_make_vector(elem_type_kind: i32, lane_count: i32) ExecValue {
    const elem_size: usize = exec_vm_type_kind_size(elem_type_kind);
    if lane_count <= 0 || elem_size == 0 as usize {
        return exec_make_void();
    }
    const total: usize = elem_size * (lane_count as usize);
    const buf: &byte = exec_value_alloc_bytes(total);
    if buf == null {
        return exec_make_void();
    }
    var vi: usize = 0;
    while vi < total {
        buf[vi] = 0 as byte;
        vi = vi + 1;
    }
    return ExecValue {
        kind: ExecValueKind.EXEC_VALUE_VECTOR,
        i64_value: elem_type_kind as i64,
        ptr_value: buf,
        aux_kind: ExecValueKind.EXEC_VALUE_VOID,
        aux_i64_value: lane_count as i64,
        aux_ptr_value: null,
        error_id: 0,
    };
}

fn exec_make_mask_value(lane_count: i32) ExecValue {
    return ExecValue {
        kind: ExecValueKind.EXEC_VALUE_MASK,
        i64_value: 0,
        ptr_value: null,
        aux_kind: ExecValueKind.EXEC_VALUE_VOID,
        aux_i64_value: lane_count as i64,
        aux_ptr_value: null,
        error_id: 0,
    };
}

/// 取某个通道的原始比特（小端拼装，避免对齐/别名假设）。
fn exec_vector_lane_bits(data: &byte, elem_type_kind: i32, index: i32) i64 {
    const elem_size: usize = exec_vm_type_kind_size(elem_type_kind);
    if data == null || index < 0 || elem_size == 0 as usize {
        return 0;
    }
    const base: usize = elem_size * (index as usize);
    var bits: u64 = 0 as u64;
    var bi: usize = 0;
    while bi < elem_size {
        const byte_value: u64 = (data[base +| bi] as byte) as u64;
        bits = bits | (byte_value << ((bi as i32) * 8));
        bi = bi + 1;
    }
    return bits as i64;
}

fn exec_vector_set_lane_bits(data: &byte, elem_type_kind: i32, index: i32, bits: i64) void {
    const elem_size: usize = exec_vm_type_kind_size(elem_type_kind);
    if data == null || index < 0 || elem_size == 0 as usize {
        return;
    }
    const base: usize = elem_size * (index as usize);
    var bi: usize = 0;
    while bi < elem_size {
        const shifted: u64 = (bits as u64) >> ((bi as i32) * 8);
        data[base +| bi] = (shifted & 0xFFu64) as byte;
        bi = bi + 1;
    }
}

/// 向量逐通道比较，结果写进掩码（低位为通道 0）。
/// 有符号元素类型按自身宽度做符号扩展（通道值以小端拼接成 i64）。
fn exec_vector_elem_is_signed(elem_type_kind: i32) i32 {
    if elem_type_kind == TypeKind.TYPE_I8 as i32 ||
        elem_type_kind == TypeKind.TYPE_I16 as i32 ||
        elem_type_kind == TypeKind.TYPE_I32 as i32 ||
        elem_type_kind == TypeKind.TYPE_I64 as i32 ||
        elem_type_kind == TypeKind.TYPE_ENUM as i32 {
        return 1;
    }
    return 0;
}

fn exec_vector_lane_signed(bits: i64, elem_type_kind: i32) i64 {
    if elem_type_kind == TypeKind.TYPE_I8 as i32 {
        return (bits as i8) as i64;
    }
    if elem_type_kind == TypeKind.TYPE_I16 as i32 {
        return (bits as i16) as i64;
    }
    if elem_type_kind == TypeKind.TYPE_I32 as i32 || elem_type_kind == TypeKind.TYPE_ENUM as i32 {
        return (bits as i32) as i64;
    }
    return bits;
}

/// 把通道值钳到元素类型的取值范围内（向量饱和运算用）。
fn exec_vector_clamp_lane(value: i64, elem_type_kind: i32) i64 {
    if elem_type_kind == TypeKind.TYPE_I8 as i32 {
        if value > 127 as i64 { return 127 as i64; }
        if value < -128 as i64 { return -128 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_I16 as i32 {
        if value > 32767 as i64 { return 32767 as i64; }
        if value < -32768 as i64 { return -32768 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_I32 as i32 || elem_type_kind == TypeKind.TYPE_ENUM as i32 {
        if value > 2147483647 as i64 { return 2147483647 as i64; }
        if value < (-2147483647 as i64) - 1 as i64 { return (-2147483647 as i64) - 1 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_U8 as i32 || elem_type_kind == TypeKind.TYPE_BYTE as i32 {
        if value > 255 as i64 { return 255 as i64; }
        if value < 0 as i64 { return 0 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_U16 as i32 {
        if value > 65535 as i64 { return 65535 as i64; }
        if value < 0 as i64 { return 0 as i64; }
        return value;
    }
    if elem_type_kind == TypeKind.TYPE_U32 as i32 {
        if value > 4294967295 as i64 { return 4294967295 as i64; }
        if value < 0 as i64 { return 0 as i64; }
        return value;
    }
    return value;
}

fn exec_vm_vector_compare(opcode_code: i32, left: ExecValue, right: ExecValue) ExecValue {
    const lanes: i32 = exec_value_vector_lanes(&left);
    const elem_kind: i32 = exec_value_vector_elem_kind(&left);
    const ldata: &byte = exec_value_vector_data(&left);
    const rdata: &byte = exec_value_vector_data(&right);
    const right_is_vector: i32 = (right.kind == ExecValueKind.EXEC_VALUE_VECTOR) as i32;
    const right_scalar_bits: i64 = right.i64_value;
    const signed_elem: i32 = exec_vector_elem_is_signed(elem_kind);
    if lanes <= 0 || lanes > 64 || ldata == null {
        return exec_make_void();
    }
    const is_f32: i32 = (elem_kind == TypeKind.TYPE_F32 as i32) as i32;
    const is_f64: i32 = (elem_kind == TypeKind.TYPE_F64 as i32) as i32;
    var mask_bits: i64 = 0;
    var li: i32 = 0;
    while li < lanes {
        var lb: i64 = exec_vector_lane_bits(ldata, elem_kind, li);
        var rb: i64 = right_scalar_bits;
        if right_is_vector != 0 {
            rb = exec_vector_lane_bits(rdata, elem_kind, li);
        }
        if signed_elem != 0 {
            lb = exec_vector_lane_signed(lb, elem_kind);
            rb = exec_vector_lane_signed(rb, elem_kind);
        }
        var lane_true: i32 = 0;
        if is_f32 != 0 || is_f64 != 0 {
            var lf: f64 = 0.0;
            var rf: f64 = 0.0;
            if is_f32 != 0 {
                lf = exec_f32_from_bits(lb as u32) as f64;
                rf = exec_f32_from_bits(rb as u32) as f64;
            } else {
                lf = exec_f64_from_bits(lb as u64);
                rf = exec_f64_from_bits(rb as u64);
            }
            if opcode_code == BCOpcode.BC_CMP_EQ as i32 { lane_true = (lf == rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_NE as i32 { lane_true = (lf != rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LT as i32 { lane_true = (lf < rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LE as i32 { lane_true = (lf <= rf) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_GT as i32 { lane_true = (lf > rf) as i32;
            } else { lane_true = (lf >= rf) as i32; }
        } else {
            if opcode_code == BCOpcode.BC_CMP_EQ as i32 { lane_true = (lb == rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_NE as i32 { lane_true = (lb != rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LT as i32 { lane_true = (lb < rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_LE as i32 { lane_true = (lb <= rb) as i32;
            } else if opcode_code == BCOpcode.BC_CMP_GT as i32 { lane_true = (lb > rb) as i32;
            } else { lane_true = (lb >= rb) as i32; }
        }
        if lane_true != 0 {
            mask_bits = mask_bits | ((1 as i64) << li);
        }
        li = li + 1;
    }
    var mask_result: ExecValue = exec_make_mask_value(lanes);
    mask_result.i64_value = mask_bits;
    return mask_result;
}

/// 向量逐通道算术；浮点元素按 f32/f64 位模式换算。
fn exec_vm_vector_binary(opcode_code: i32, left: ExecValue, right: ExecValue) ExecValue {
    const lanes: i32 = exec_value_vector_lanes(&left);
    const elem_kind: i32 = exec_value_vector_elem_kind(&left);
    const ldata: &byte = exec_value_vector_data(&left);
    const rdata: &byte = exec_value_vector_data(&right);
    const right_is_vector2: i32 = (right.kind == ExecValueKind.EXEC_VALUE_VECTOR) as i32;
    const right_scalar_bits2: i64 = right.i64_value;
    const signed_elem2: i32 = exec_vector_elem_is_signed(elem_kind);
    if lanes <= 0 || ldata == null {
        return exec_make_void();
    }
    const is_f32_elem: i32 = (elem_kind == TypeKind.TYPE_F32 as i32) as i32;
    const is_float_elem: i32 = (is_f32_elem != 0 || elem_kind == TypeKind.TYPE_F64 as i32) as i32;
    var out: ExecValue = exec_make_vector(elem_kind, lanes);
    const odata: &byte = exec_value_vector_data(&out);
    if odata == null {
        return exec_make_void();
    }
    var li: i32 = 0;
    while li < lanes {
        var lb: i64 = exec_vector_lane_bits(ldata, elem_kind, li);
        var rb: i64 = right_scalar_bits2;
        if right_is_vector2 != 0 {
            rb = exec_vector_lane_bits(rdata, elem_kind, li);
        }
        if signed_elem2 != 0 {
            lb = exec_vector_lane_signed(lb, elem_kind);
            rb = exec_vector_lane_signed(rb, elem_kind);
        }
        var res: i64 = 0;
        if is_float_elem != 0 {
            var lf: f64 = 0.0;
            var rf: f64 = 0.0;
            if is_f32_elem != 0 {
                lf = exec_f32_from_bits(lb as u32) as f64;
                rf = exec_f32_from_bits(rb as u32) as f64;
            } else {
                lf = exec_f64_from_bits(lb as u64);
                rf = exec_f64_from_bits(rb as u64);
            }
            var fr: f64 = 0.0;
            if opcode_code == BCOpcode.BC_ADD as i32 {
                fr = lf + rf;
            } else if opcode_code == BCOpcode.BC_SUB as i32 {
                fr = lf - rf;
            } else if opcode_code == BCOpcode.BC_MUL as i32 {
                fr = lf * rf;
            } else if rf != 0.0 {
                fr = lf / rf;
            }
            if is_f32_elem != 0 {
                res = exec_f32_to_bits(fr as f32) as i64;
            } else {
                res = exec_f64_to_bits(fr) as i64;
            }
        } else if opcode_code == BCOpcode.BC_ADD as i32 {
            res = lb +| rb;
        } else if opcode_code == BCOpcode.BC_SUB as i32 {
            res = lb -| rb;
        } else if opcode_code == BCOpcode.BC_MUL as i32 {
            res = lb *| rb;
        } else if opcode_code == BCOpcode.BC_DIV as i32 {
            if rb != 0 { res = lb / rb; }
        } else if opcode_code == BCOpcode.BC_REM as i32 {
            if rb != 0 { res = lb % rb; }
        } else if opcode_code == BCOpcode.BC_BIT_AND as i32 {
            res = lb & rb;
        } else if opcode_code == BCOpcode.BC_BIT_OR as i32 {
            res = lb | rb;
        } else {
            res = lb ^ rb;
        }
        exec_vector_set_lane_bits(odata, elem_kind, li, res);
        li = li + 1;
    }
    return out;
}

/// 判断值是否需要按聚合语义（逐元素）比较。
///
/// 参数：`value` 待判断的值。
/// 返回值：是聚合值返回 1，否则返回 0。
fn exec_vm_value_is_aggregate(value: &ExecValue) i32 {
    if value == null {
        return 0;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRUCT || value.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        value.kind == ExecValueKind.EXEC_VALUE_TUPLE || value.kind == ExecValueKind.EXEC_VALUE_SLICE ||
        value.kind == ExecValueKind.EXEC_VALUE_UNION {
        return 1;
    }
    return exec_value_is_raw_array(value);
}

/// 按值语义比较两个聚合值：元素个数相同且逐元素相等才算相等。
///
/// 结构体比较只看 `i64_value` 会永远得到 0（相等），`!=` 因此恒为假。
///
/// 参数：`left`/`right` 待比较的值。
/// 返回值：-1 表示左小，0 表示相等，1 表示左大。
fn exec_vm_compare_aggregates(left: ExecValue, right: ExecValue) i32 {
    if left.kind != right.kind {
        if (left.kind as i32) < (right.kind as i32) {
            return -1;
        }
        return 1;
    }
    if left.kind == ExecValueKind.EXEC_VALUE_UNION {
        if left.i64_value < right.i64_value { return -1; }
        if left.i64_value > right.i64_value { return 1; }
        return 0;
    }
    const left_ref: &ExecValue = &left;
    const right_ref: &ExecValue = &right;
    const left_count: i32 = exec_value_count(left_ref);
    const right_count: i32 = exec_value_count(right_ref);
    if left_count < right_count { return -1; }
    if left_count > right_count { return 1; }
    var i: i32 = 0;
    while i < left_count {
        const left_item: ExecValue = exec_value_get_index(left_ref, i);
        const right_item: ExecValue = exec_value_get_index(right_ref, i);
        const item_cmp: i32 = exec_vm_compare_values(exec_value_clone(&left_item), exec_value_clone(&right_item));
        if item_cmp != 0 {
            return item_cmp;
        }
        i = i + 1;
    }
    return 0;
}

fn exec_vm_compare_values(left: ExecValue, right: ExecValue) i32 {
    if exec_vm_value_is_aggregate(&left) != 0 || exec_vm_value_is_aggregate(&right) != 0 {
        return exec_vm_compare_aggregates(left, right);
    }
    if exec_value_is_pointer_like(left) != 0 || exec_value_is_pointer_like(right) != 0 {
        const left_u: u64 = left.i64_value as u64;
        const right_u: u64 = right.i64_value as u64;
        if left_u < right_u { return -1; }
        if left_u > right_u { return 1; }
        return 0;
    }
    if exec_vm_value_kind_is_unsigned(left.kind) != 0 {
        const left_u2: u64 = left.i64_value as u64;
        const right_u2: u64 = right.i64_value as u64;
        if left_u2 < right_u2 { return -1; }
        if left_u2 > right_u2 { return 1; }
        return 0;
    }
    if left.i64_value < right.i64_value { return -1; }
    if left.i64_value > right.i64_value { return 1; }
    return 0;
}

fn exec_vm_type_kind_size(kind_code: i32) usize {
    if kind_code == TypeKind.TYPE_BOOL as i32 ||
        kind_code == TypeKind.TYPE_BYTE as i32 ||
        kind_code == TypeKind.TYPE_I8 as i32 ||
        kind_code == TypeKind.TYPE_U8 as i32 {
        return 1 as usize;
    }
    if kind_code == TypeKind.TYPE_I16 as i32 || kind_code == TypeKind.TYPE_U16 as i32 {
        return 2 as usize;
    }
    if kind_code == TypeKind.TYPE_I32 as i32 || kind_code == TypeKind.TYPE_U32 as i32 {
        return 4 as usize;
    }
    if kind_code == TypeKind.TYPE_F32 as i32 {
        return 4 as usize;
    }
    if kind_code == TypeKind.TYPE_ENUM as i32 {
        return 4 as usize;
    }
    if kind_code == TypeKind.TYPE_I64 as i32 || kind_code == TypeKind.TYPE_U64 as i32 ||
        kind_code == TypeKind.TYPE_USIZE as i32 ||
        kind_code == TypeKind.TYPE_F64 as i32 ||
        kind_code == TypeKind.TYPE_POINTER as i32 {
        return @size_of(usize) as usize;
    }
    return 0 as usize;
}

fn exec_vm_pointer_address(value: &ExecValue) usize {
    if value == null {
        return 0 as usize;
    }
    return value.i64_value as usize;
}

fn exec_vm_encode_ref_kind(pointee_kind: i32) i32 {
    return EXEC_VM_REF_KIND_BASE +| pointee_kind;
}

fn exec_vm_encode_index_ref_kind(pointee_kind: i32) i32 {
    return EXEC_VM_REF_KIND_INDEX_BASE +| pointee_kind;
}

fn exec_vm_decode_ref_kind(encoded_kind: i32) i32 {
    if encoded_kind >= EXEC_VM_REF_KIND_INDEX_BASE {
        return encoded_kind - EXEC_VM_REF_KIND_INDEX_BASE;
    }
    if encoded_kind >= EXEC_VM_REF_KIND_BASE {
        return encoded_kind - EXEC_VM_REF_KIND_BASE;
    }
    return TypeKind.TYPE_VOID as i32;
}

fn exec_vm_pointer_is_internal_ref(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_POINTER {
        return 0;
    }
    return (value.aux_i64_value as i32 >= EXEC_VM_REF_KIND_BASE) as i32;
}

fn exec_vm_pointer_is_index_base_ref(value: &ExecValue) i32 {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_POINTER {
        return 0;
    }
    return (value.aux_i64_value as i32 >= EXEC_VM_REF_KIND_INDEX_BASE) as i32;
}

fn exec_vm_make_value_ref(target: &ExecValue, pointee_kind: i32) ExecValue {
    if target == null {
        return exec_make_pointer_with_kind(0 as usize, exec_vm_encode_ref_kind(pointee_kind));
    }
    const target_addr: usize = @usize_from_ptr(target as &void);
    return exec_make_pointer_with_kind(target_addr, exec_vm_encode_ref_kind(pointee_kind));
}

fn exec_vm_make_index_ref_from_addr(addr: usize, pointee_kind: i32) ExecValue {
    return exec_make_pointer_with_kind(addr, exec_vm_encode_index_ref_kind(pointee_kind));
}

fn exec_vm_make_index_value_ref(target: &ExecValue, pointee_kind: i32) ExecValue {
    if target == null {
        return exec_make_pointer_with_kind(0 as usize, exec_vm_encode_index_ref_kind(pointee_kind));
    }
    const target_addr: usize = @usize_from_ptr(target as &void);
    return exec_make_pointer_with_kind(target_addr, exec_vm_encode_index_ref_kind(pointee_kind));
}

fn exec_vm_ref_target_value(value: &ExecValue) &ExecValue {
    if exec_vm_pointer_is_internal_ref(value) == 0 {
        return null;
    }
    const target_addr: usize = exec_vm_pointer_address(value);
    if target_addr == 0 as usize {
        return null;
    }
    return @ptr_from_usize(target_addr) as &ExecValue;
}

// INDEX 基引用指向 aggregate.values 数组里的 ExecValue，元素步长固定为 sizeof(ExecValue)。
// 参数：base - INDEX 基引用；index_value - 元素序号。返回：目标元素地址。
fn exec_vm_index_ref_element_addr(base: &ExecValue, index_value: i64) usize {
    const base_addr: usize = base.i64_value as usize;
    return base_addr + (@size_of(ExecValue) as usize) * (index_value as usize);
}

fn exec_vm_box_value_ref(value: ExecValue, pointee_kind: i32) ExecValue {
    const boxed: &ExecValue = exec_value_alloc_bytes(@size_of(ExecValue)) as &ExecValue;
    if boxed == null {
        return exec_make_pointer_with_kind(0 as usize, exec_vm_encode_ref_kind(pointee_kind));
    }
    boxed[0] = exec_value_clone(&value);
    return exec_vm_make_value_ref(boxed, pointee_kind);
}

fn exec_vm_aggregate_ref_from_value(value: &ExecValue) &ExecAggregate {
    if value == null {
        return null;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
        value.kind == ExecValueKind.EXEC_VALUE_ARRAY ||
        value.kind == ExecValueKind.EXEC_VALUE_TUPLE {
        return exec_value_as_aggregate(value);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER && exec_vm_pointer_is_internal_ref(value) == 0 {
        // 裸指针指向聚合：`p.field` 等价于旁路表第 0 个元素。
        const pointee_kind_code: i32 = exec_value_pointer_pointee_kind(value);
        if exec_vm_type_kind_size(pointee_kind_code) == 0 as usize {
            const elem: &ExecValue = exec_vm_native_agg_slot(exec_vm_pointer_address(value), 0);
            if elem != null {
                return exec_value_as_aggregate(elem);
            }
        }
        return null;
    }
    if exec_vm_pointer_is_internal_ref(value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(value);
        if target == null {
            return null;
        }
        const direct_aggregate: &ExecAggregate = exec_value_as_aggregate(target);
        if direct_aggregate != null {
            return direct_aggregate;
        }
        if exec_value_is_pointer_like(target[0]) != 0 && exec_vm_pointer_is_internal_ref(target) != 0 {
            const nested_target: &ExecValue = exec_vm_ref_target_value(target);
            if nested_target != null {
                return exec_value_as_aggregate(nested_target);
            }
        }
    }
    return null;
}

/// STORE_FIELD 的字段引用：允许把未初始化的槽位就地长成一个结构体。
/// 原生指针上的聚合元素只能按需落地，第一次写字段时给它一个足够大的容量，
/// 之后所有字段写入都只是改 ExecValue 元素，不再越界。
/// 参数：value 目标对象；field_idx 字段下标。
/// 返回值：字段槽位；无法建立返回 null。
fn exec_vm_field_ref_store(value: &ExecValue, field_idx: i32) &ExecValue {
    if value == null || field_idx < 0 || field_idx >= 64 {
        return null;
    }
    const object: &ExecValue = exec_vm_field_object(value);
    if object == null {
        return null;
    }
    if object.kind == ExecValueKind.EXEC_VALUE_VOID {
        object[0] = exec_value_make_aggregate(ExecValueKind.EXEC_VALUE_STRUCT, 64);
    }
    const aggregate: &ExecAggregate = exec_vm_aggregate_ref_from_value(object);
    if aggregate == null || field_idx >= aggregate.count {
        return null;
    }
    return &aggregate.values[field_idx];
}

/// 取字段访问真正要读写的对象：沿引用/裸指针自动解引用到聚合为止。
/// 参数：value 字段访问的基值。
/// 返回值：聚合对象的 ExecValue；无法解析返回 null。
/// 插值实参里 `%s` 需要 C 字符串：切片先取首字节指针再当字符串用。
/// 参数：value 实参值。
/// 返回值：可直接给 exec_format_render 的值。
fn exec_vm_interp_string_arg(value: ExecValue) ExecValue {
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(&value);
        if slice_data != null && slice_data.raw_ptr != null {
            return exec_make_string(slice_data.raw_ptr);
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER && exec_vm_pointer_is_internal_ref(&value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(&value);
        if target != null && target.kind == ExecValueKind.EXEC_VALUE_STRING {
            return exec_make_string(target.ptr_value);
        }
    }
    return value;
}

fn exec_vm_field_object(value: &ExecValue) &ExecValue {
    if value == null {
        return null;
    }
    var object: &ExecValue = value;
    var depth: i32 = 0;
    while depth < 4 {
        if object.kind == ExecValueKind.EXEC_VALUE_STRUCT ||
            object.kind == ExecValueKind.EXEC_VALUE_TUPLE ||
            object.kind == ExecValueKind.EXEC_VALUE_UNION {
            return object;
        }
        if object.kind == ExecValueKind.EXEC_VALUE_POINTER {
            if exec_vm_pointer_is_internal_ref(object) != 0 {
                const target: &ExecValue = exec_vm_ref_target_value(object);
                if target == null {
                    return null;
                }
                object = target;
            } else {
                const pointee_kind_code: i32 = exec_value_pointer_pointee_kind(object);
                if exec_vm_type_kind_size(pointee_kind_code) != 0 as usize {
                    return null;
                }
                const elem: &ExecValue = exec_vm_native_agg_slot(exec_vm_pointer_address(object), 0);
                if elem == null {
                    return null;
                }
                object = elem;
            }
            depth = depth + 1;
            continue;
        }
        return object;
    }
    return null;
}

fn exec_vm_field_ref(value: &ExecValue, field_idx: i32) &ExecValue {
    const object: &ExecValue = exec_vm_field_object(value);
    if object == null {
        return null;
    }
    const aggregate: &ExecAggregate = exec_vm_aggregate_ref_from_value(object);
    if aggregate == null || field_idx < 0 || field_idx >= aggregate.count {
        return null;
    }
    return &aggregate.values[field_idx];
}

fn exec_vm_file_fd_from_value(value: &ExecValue) i32 {
    if value == null {
        return -1;
    }
    if exec_vm_pointer_is_internal_ref(value) == 0 {
        return -1;
    }
    const file_value: &ExecValue = exec_vm_ref_target_value(value);
    if file_value == null {
        return -1;
    }
    const fd_field: &ExecValue = exec_vm_field_ref(file_value, 0);
    if fd_field == null {
        return -1;
    }
    return fd_field.i64_value as i32;
}

fn exec_vm_raw_array_element_ptr(value: &ExecValue, index_value: i32) ExecValue {
    if value == null || exec_value_is_raw_array(value) == 0 || index_value < 0 {
        return exec_make_void();
    }
    const count: i32 = value.i64_value as i32;
    const elem_kind: i32 = exec_value_raw_array_element_kind(value);
    const elem_size: usize = exec_vm_type_kind_size(elem_kind);
    if index_value >= count || elem_size == 0 as usize {
        return exec_make_void();
    }
    const base_ptr: &byte = exec_value_raw_array_ptr(value);
    if base_ptr == null {
        return exec_make_void();
    }
    const addr: usize = @usize_from_ptr(base_ptr as &void) + elem_size * (index_value as usize);
    return exec_make_pointer_with_kind(addr, elem_kind);
}

fn exec_vm_raw_array_slice_ptr(value: &ExecValue, index_value: i32) ExecValue {
    if value == null || exec_value_is_raw_array(value) == 0 || index_value < 0 {
        return exec_make_void();
    }
    const count: i32 = value.i64_value as i32;
    const elem_kind: i32 = exec_value_raw_array_element_kind(value);
    const elem_size: usize = exec_vm_type_kind_size(elem_kind);
    if index_value > count || elem_size == 0 as usize {
        return exec_make_void();
    }
    const base_ptr: &byte = exec_value_raw_array_ptr(value);
    if base_ptr == null {
        if index_value == 0 && count == 0 {
            return exec_make_pointer_with_kind(0 as usize, elem_kind);
        }
        return exec_make_void();
    }
    const addr: usize = @usize_from_ptr(base_ptr as &void) + elem_size * (index_value as usize);
    return exec_make_pointer_with_kind(addr, elem_kind);
}

// 指针算术：`ptr ± n` 按 pointee 元素大小缩放，`ptr - ptr` 返回元素个数。
// 参数：function - 当前函数（错误定位）；base - 指针操作数；offset - 偏移量或另一指针；
// subtract - 1 表示减法。返回：结果值；非法元素类型时返回 void 并设置错误。
fn exec_vm_pointer_add(function: &BCFunction, base: &ExecValue, offset: &ExecValue, subtract: i32) ExecValue {
    if base == null || offset == null {
        return exec_make_void();
    }
    const pointee_kind: i32 = exec_value_pointer_pointee_kind(base);
    const elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if elem_size == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 指针算术不支持该元素类型" as *byte, 0);
        return exec_make_void();
    }
    var effective_sub: i32 = (subtract != 0) as i32;
    if effective_sub != 0 && offset.kind == ExecValueKind.EXEC_VALUE_POINTER {
        return exec_make_i64((base.i64_value -| offset.i64_value) / (elem_size as i64));
    }
    var magnitude: usize = offset.i64_value as usize;
    if offset.i64_value < 0 {
        var neg_value: i64 = 0 as i64 -| offset.i64_value;
        magnitude = neg_value as usize;
        if effective_sub != 0 {
            effective_sub = 0;
        } else {
            effective_sub = 1;
        }
    }
    const scaled: usize = elem_size * magnitude;
    if effective_sub != 0 {
        return exec_make_pointer_with_kind((base.i64_value as usize) -| scaled, pointee_kind);
    }
    return exec_make_pointer_with_kind((base.i64_value as usize) +| scaled, pointee_kind);
}

fn exec_vm_raw_slice_element_ptr(value: &ExecValue, index_value: i32, allow_end: i32) ExecValue {
    if value == null || exec_value_is_raw_slice(value) == 0 || index_value < 0 {
        return exec_make_void();
    }
    const count: i32 = exec_value_count(value);
    const elem_kind: i32 = exec_value_slice_element_kind(value);
    const elem_size: usize = exec_vm_type_kind_size(elem_kind);
    if elem_size == 0 as usize {
        return exec_make_void();
    }
    if index_value > count || (allow_end == 0 && index_value >= count) {
        return exec_make_void();
    }
    const base_ptr: &byte = exec_value_slice_raw_ptr(value);
    if base_ptr == null {
        if index_value == 0 && count == 0 {
            return exec_make_pointer_with_kind(0 as usize, elem_kind);
        }
        return exec_make_void();
    }
    const addr: usize = @usize_from_ptr(base_ptr as &void) + elem_size * (index_value as usize);
    return exec_make_pointer_with_kind(addr, elem_kind);
}

fn exec_vm_slice_ptr_value(value: &ExecValue, pointee_kind: i32) ExecValue {
    if value == null || value.kind != ExecValueKind.EXEC_VALUE_SLICE {
        return exec_make_void();
    }
    if exec_value_is_raw_slice(value) != 0 {
        const raw_ptr: &byte = exec_value_slice_raw_ptr(value);
        if raw_ptr == null {
            return exec_make_pointer_with_kind(0 as usize, pointee_kind);
        }
        return exec_make_pointer_with_kind(@usize_from_ptr(raw_ptr as &void), pointee_kind);
    }
    const slice_data: &ExecSliceData = exec_value_as_slice(value);
    if slice_data == null || slice_data.aggregate == null || slice_data.aggregate.values == null {
        return exec_make_pointer_with_kind(0 as usize, pointee_kind);
    }
    if slice_data.start < 0 || slice_data.start >= slice_data.aggregate.count {
        return exec_make_pointer_with_kind(0 as usize, pointee_kind);
    }
    return exec_vm_make_index_value_ref(&slice_data.aggregate.values[slice_data.start], pointee_kind);
}

// 原生指针上的聚合元素旁路表。
// `arena_alloc` 之类返回的是原生内存，里面放不下 ExecValue；
// 以「基地址 → ExecValue 数组」的旁路表承接 `ptr[i].field` 的读写。
const EXEC_NATIVE_AGG_MAX_BASES: i32 = 256;
const EXEC_NATIVE_AGG_MAX_ELEMS: i32 = 512;

var g_native_agg_base: [usize: 256] = [];
var g_native_agg_count: [i32: 256] = [];
var g_native_agg_values: [[ExecValue: 512]: 256] = [];
var g_native_agg_handles: [ExecAggregate: 256] = [];
var g_native_agg_used: i32 = 0;

/// 查找或建立原生指针聚合元素旁路表的条目。
/// 参数：base 指针地址。
/// 返回值：条目下标；无法建立返回 -1。
fn exec_vm_native_agg_slot_index(base: usize) i32 {
    if base == 0 as usize {
        return -1;
    }
    var slot: i32 = -1;
    var i: i32 = 0;
    while i < g_native_agg_used {
        if g_native_agg_base[i] == base {
            slot = i;
            break;
        }
        i = i + 1;
    }
    if slot >= 0 {
        return slot;
    }
    if g_native_agg_used < 0 || g_native_agg_used >= EXEC_NATIVE_AGG_MAX_BASES {
        return -1;
    }
    slot = g_native_agg_used;
    g_native_agg_base[slot] = base;
    g_native_agg_count[slot] = 0;
    g_native_agg_handles[slot].count = 0;
    g_native_agg_handles[slot].values = &g_native_agg_values[slot][0];
    g_native_agg_used = slot + 1;
    return slot;
}

/// 取原生指针第 index 个聚合元素对应的 ExecValue 槽位（按需建表）。
/// 参数：base 指针地址；index 元素下标。
/// 返回值：指向该元素 ExecValue 的指针；越界或表满返回 null。
fn exec_vm_native_agg_slot(base: usize, index: i64) &ExecValue {
    if index < 0 || index >= (EXEC_NATIVE_AGG_MAX_ELEMS as i64) {
        return null;
    }
    const slot: i32 = exec_vm_native_agg_slot_index(base);
    if slot < 0 || slot >= EXEC_NATIVE_AGG_MAX_BASES {
        return null;
    }
    const idx: i32 = index as i32;
    if idx < 0 || idx >= EXEC_NATIVE_AGG_MAX_ELEMS {
        return null;
    }
    if idx >= g_native_agg_count[slot] {
        g_native_agg_count[slot] = idx + 1;
        g_native_agg_handles[slot].count = idx + 1;
    }
    return &g_native_agg_values[slot][idx];
}

/// 取原生指针聚合元素旁路表的聚合视图（按需建表）。
/// `&Token` 这类裸指针切片的元素是 ExecValue，只能落在旁路表里。
/// 参数：base 指针地址。
/// 返回值：覆盖该表的聚合句柄；无法建立返回 null。
fn exec_vm_native_agg_handle(base: usize) &ExecAggregate {
    const slot: i32 = exec_vm_native_agg_slot_index(base);
    if slot < 0 || slot >= EXEC_NATIVE_AGG_MAX_BASES {
        return null;
    }
    return &g_native_agg_handles[slot];
}

fn exec_vm_pointer_element_ptr(function: &BCFunction, base: ExecValue, index_value: i64) ExecValue {
    if function == null {
        exec_backend_set_error(null, "exec: pointer addr 输入无效" as *byte, 0);
        return exec_make_void();
    }
    const base_addr: usize = exec_vm_pointer_address(&base);
    if base_addr == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 空指针解引用" as *byte, 0);
        return exec_make_void();
    }
    if index_value < 0 {
        exec_backend_set_error(function.decl, "exec: 指针下标不能为负数" as *byte, 0);
        return exec_make_void();
    }
    // INDEX 基引用按 aggregate.values 步进，元素是 ExecValue 而不是原生标量。
    if exec_vm_pointer_is_index_base_ref(&base) != 0 {
        const index_ref_kind: i32 = exec_vm_decode_ref_kind(base.aux_i64_value as i32);
        return exec_vm_make_index_ref_from_addr(exec_vm_index_ref_element_addr(&base, index_value), index_ref_kind);
    }
    // 值引用指向 ExecValue 本体（`&local`/`&struct.field`）：按 ExecValue 步进，
    // 取元素得到的是指向该 ExecValue 的引用，不能按原生标量尺寸计算。
    if exec_vm_pointer_is_internal_ref(&base) != 0 {
        const value_ref_kind: i32 = exec_vm_decode_ref_kind(base.aux_i64_value as i32);
        return exec_vm_make_index_ref_from_addr(exec_vm_index_ref_element_addr(&base, index_value), value_ref_kind);
    }
    const pointee_kind: i32 = exec_value_pointer_pointee_kind(&base);
    const elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if elem_size == 0 as usize {
        const agg_slot: &ExecValue = exec_vm_native_agg_slot(base_addr, index_value);
        if agg_slot == null {
            exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
            return exec_make_void();
        }
        return exec_vm_make_value_ref(agg_slot, pointee_kind);
    }
    const addr: usize = base_addr + (index_value as usize) * elem_size;
    return exec_make_pointer_with_kind(addr, pointee_kind);
}

fn exec_vm_index_ref(value: &ExecValue, index_value: i32) &ExecValue {
    if value == null || index_value < 0 {
        return null;
    }
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(value);
        if slice_data == null || slice_data.aggregate == null || index_value >= slice_data.len {
            return null;
        }
        return &slice_data.aggregate.values[slice_data.start +| index_value];
    }
    if exec_vm_pointer_is_internal_ref(value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(value);
        if target == null {
            return null;
        }
        const is_index_base: i32 = exec_vm_pointer_is_index_base_ref(value);
        const target_aggregate: &ExecAggregate = exec_value_as_aggregate(target);
        const ref_kind: i32 = exec_vm_decode_ref_kind(value.aux_i64_value as i32);
        // `*ref`：引用指向 struct/tuple 值本体时，下标 0 就是该值本身
        // （结构体字段访问走 LOAD_FIELD，不经过下标）。
        if is_index_base == 0 && index_value == 0 && target_aggregate != null &&
            (ref_kind == TypeKind.TYPE_STRUCT as i32 || ref_kind == TypeKind.TYPE_TUPLE as i32) {
            return target;
        }
        // 嵌套数组 `arr[0][1]`：引用指向内层数组本体，下标要按内层 aggregate.values 取，
        // 不能沿外层 aggregate 步进。判据是引用的元素类型是数组。
        if is_index_base != 0 && target_aggregate != null &&
            ref_kind == TypeKind.TYPE_ARRAY as i32 && index_value < target_aggregate.count {
            return &target_aggregate.values[index_value];
        }
        // INDEX 基引用已经指向 aggregate.values 里的某个元素，必须按 ExecValue 步进：
        // slice.ptr[i] 的 i 是元素序号，而不是结构体字段下标。
        if is_index_base != 0 {
            const target_addr2: usize = @usize_from_ptr(target as &void);
            return @ptr_from_usize(target_addr2 + (@size_of(ExecValue) as usize) * (index_value as usize)) as &ExecValue;
        }
        // 装箱聚合（数组/元组/结构体）的元素在 aggregate.values 里，必须按聚合下标取，
        // 不能对 &ExecValue 做原始指针步进：嵌套数组写入 arr[0][1] = x 走的正是这条路径，
        // 一旦按指针步进就会写到聚合头之外的地址，写回丢失。
        if target_aggregate != null && target_aggregate.values != null && index_value < target_aggregate.count {
            return &target_aggregate.values[index_value];
        }
        return exec_vm_index_ref(target, index_value);
    }
    const aggregate: &ExecAggregate = exec_value_as_aggregate(value);
    if aggregate == null || index_value >= aggregate.count {
        return null;
    }
    return &aggregate.values[index_value];
}

fn exec_vm_load_pointer_index(function: &BCFunction, base: ExecValue, index_value: i64, out_value: &ExecValue) i32 {
    if function == null || out_value == null {
        exec_backend_set_error(null, "exec: pointer load 输入无效" as *byte, 0);
        return -1;
    }
    const base_addr: usize = exec_vm_pointer_address(&base);
    if base_addr == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 空指针解引用" as *byte, 0);
        return -1;
    }
    if index_value < 0 {
        exec_backend_set_error(function.decl, "exec: 指针下标不能为负数" as *byte, 0);
        return -1;
    }
    // INDEX 基引用按 aggregate.values 步进，元素是 ExecValue 而不是原生标量。
    if exec_vm_pointer_is_index_base_ref(&base) != 0 {
        const index_elem: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        out_value[0] = exec_value_clone(index_elem);
        return 0;
    }
    // 值引用指向 ExecValue 本体（`&local`/`&struct.field`）：解引用直接取该 ExecValue，
    // 不能按原生标量尺寸访问，否则会把 ExecValue 头当成数据。
    if exec_vm_pointer_is_internal_ref(&base) != 0 {
        const value_elem: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        out_value[0] = exec_value_clone(value_elem);
        return 0;
    }
    const pointee_kind: i32 = exec_value_pointer_pointee_kind(&base);
    const elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if elem_size == 0 as usize {
        const agg_slot: &ExecValue = exec_vm_native_agg_slot(base_addr, index_value);
        if agg_slot == null {
            exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_value_clone(agg_slot);
        return 0;
    }
    const addr: usize = base_addr + (index_value as usize) * elem_size;
    if pointee_kind == TypeKind.TYPE_BOOL as i32 {
        const ptr_bool: &byte = @ptr_from_usize(addr) as &byte;
        out_value[0] = exec_make_bool((ptr_bool[0] != 0) as i32);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I8 as i32 {
        const ptr_i8: &i8 = @ptr_from_usize(addr) as &i8;
        out_value[0] = exec_make_i8(ptr_i8[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_BYTE as i32 || pointee_kind == TypeKind.TYPE_U8 as i32 {
        const ptr_u8: &byte = @ptr_from_usize(addr) as &byte;
        if pointee_kind == TypeKind.TYPE_U8 as i32 {
            out_value[0] = exec_make_u8(ptr_u8[0]);
        } else {
            out_value[0] = exec_make_byte(ptr_u8[0] as i32);
        }
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I16 as i32 {
        const ptr_i16: &i16 = @ptr_from_usize(addr) as &i16;
        out_value[0] = exec_make_i16(ptr_i16[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U16 as i32 {
        const ptr_u16: &u16 = @ptr_from_usize(addr) as &u16;
        out_value[0] = exec_make_u16(ptr_u16[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I32 as i32 {
        const ptr_i32: &i32 = @ptr_from_usize(addr) as &i32;
        out_value[0] = exec_make_i32(ptr_i32[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U32 as i32 {
        const ptr_u32: &u32 = @ptr_from_usize(addr) as &u32;
        out_value[0] = exec_make_u32(ptr_u32[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F32 as i32 {
        const ptr_f32: &f32 = @ptr_from_usize(addr) as &f32;
        out_value[0] = exec_make_f32(ptr_f32[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I64 as i32 {
        const ptr_i64: &i64 = @ptr_from_usize(addr) as &i64;
        out_value[0] = exec_make_i64(ptr_i64[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U64 as i32 {
        const ptr_u64: &u64 = @ptr_from_usize(addr) as &u64;
        out_value[0] = exec_make_u64(ptr_u64[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_USIZE as i32 {
        const ptr_usize: &usize = @ptr_from_usize(addr) as &usize;
        out_value[0] = exec_make_usize(ptr_usize[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F64 as i32 {
        const ptr_f64: &f64 = @ptr_from_usize(addr) as &f64;
        out_value[0] = exec_make_f64(ptr_f64[0]);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_POINTER as i32 {
        const ptr_ptr: &usize = @ptr_from_usize(addr) as &usize;
        out_value[0] = exec_make_pointer_with_kind(ptr_ptr[0], TypeKind.TYPE_VOID as i32);
        return 0;
    }
    exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
    return -1;
}

fn exec_vm_store_pointer_index(function: &BCFunction, base: ExecValue, index_value: i64, src_value: ExecValue) i32 {
    if function == null {
        exec_backend_set_error(null, "exec: pointer store 输入无效" as *byte, 0);
        return -1;
    }
    const base_addr: usize = exec_vm_pointer_address(&base);
    if base_addr == 0 as usize {
        exec_backend_set_error(function.decl, "exec: 空指针解引用" as *byte, 0);
        return -1;
    }
    if index_value < 0 {
        exec_backend_set_error(function.decl, "exec: 指针下标不能为负数" as *byte, 0);
        return -1;
    }
    // INDEX 基引用按 aggregate.values 步进，元素是 ExecValue 而不是原生标量。
    if exec_vm_pointer_is_index_base_ref(&base) != 0 {
        const index_elem2: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        index_elem2[0] = exec_value_clone(&src_value);
        return 0;
    }
    // 值引用指向 ExecValue 本体：写入时整块替换该 ExecValue（`*ptr = v`）。
    if exec_vm_pointer_is_internal_ref(&base) != 0 {
        const value_elem2: &ExecValue = @ptr_from_usize(exec_vm_index_ref_element_addr(&base, index_value)) as &ExecValue;
        value_elem2[0] = exec_value_clone(&src_value);
        return 0;
    }
    const pointee_kind: i32 = exec_value_pointer_pointee_kind(&base);
    const elem_size: usize = exec_vm_type_kind_size(pointee_kind);
    if elem_size == 0 as usize {
        const agg_slot: &ExecValue = exec_vm_native_agg_slot(base_addr, index_value);
        if agg_slot == null {
            exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
            return -1;
        }
        agg_slot[0] = exec_value_clone(&src_value);
        return 0;
    }
    const addr: usize = base_addr + (index_value as usize) * elem_size;
    if pointee_kind == TypeKind.TYPE_BOOL as i32 {
        const ptr_bool: &byte = @ptr_from_usize(addr) as &byte;
        ptr_bool[0] = src_value.i64_value as byte;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I8 as i32 {
        const ptr_i8: &i8 = @ptr_from_usize(addr) as &i8;
        ptr_i8[0] = src_value.i64_value as i8;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_BYTE as i32 || pointee_kind == TypeKind.TYPE_U8 as i32 {
        const ptr_u8: &byte = @ptr_from_usize(addr) as &byte;
        ptr_u8[0] = src_value.i64_value as byte;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I16 as i32 {
        const ptr_i16: &i16 = @ptr_from_usize(addr) as &i16;
        ptr_i16[0] = src_value.i64_value as i16;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U16 as i32 {
        const ptr_u16: &u16 = @ptr_from_usize(addr) as &u16;
        ptr_u16[0] = src_value.i64_value as u16;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I32 as i32 {
        const ptr_i32: &i32 = @ptr_from_usize(addr) as &i32;
        ptr_i32[0] = src_value.i64_value as i32;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U32 as i32 {
        const ptr_u32: &u32 = @ptr_from_usize(addr) as &u32;
        ptr_u32[0] = src_value.i64_value as u32;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F32 as i32 {
        const ptr_f32: &f32 = @ptr_from_usize(addr) as &f32;
        ptr_f32[0] = exec_value_as_f32(&src_value);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_I64 as i32 {
        const ptr_i64: &i64 = @ptr_from_usize(addr) as &i64;
        ptr_i64[0] = src_value.i64_value;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_U64 as i32 {
        const ptr_u64: &u64 = @ptr_from_usize(addr) as &u64;
        ptr_u64[0] = src_value.i64_value as u64;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_USIZE as i32 {
        const ptr_usize: &usize = @ptr_from_usize(addr) as &usize;
        ptr_usize[0] = src_value.i64_value as usize;
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_F64 as i32 {
        const ptr_f64: &f64 = @ptr_from_usize(addr) as &f64;
        ptr_f64[0] = exec_value_as_f64(&src_value);
        return 0;
    }
    if pointee_kind == TypeKind.TYPE_POINTER as i32 {
        const ptr_ptr: &usize = @ptr_from_usize(addr) as &usize;
        ptr_ptr[0] = src_value.i64_value as usize;
        return 0;
    }
    exec_backend_set_error(function.decl, "exec: 当前不支持该指针元素类型" as *byte, 0);
    return -1;
}

fn exec_vm_cast_value(value: ExecValue, target_kind: i32, target_pointee_kind: i32) ExecValue {
    if target_kind == TypeKind.TYPE_F32 as i32 {
        return exec_make_f32(exec_value_as_f32(&value));
    }
    if target_kind == TypeKind.TYPE_F64 as i32 {
        return exec_make_f64(exec_value_as_f64(&value));
    }
    if target_kind == TypeKind.TYPE_I8 as i32 {
        return exec_make_i8(exec_vm_numeric_to_i64(value) as i8);
    }
    if target_kind == TypeKind.TYPE_I16 as i32 {
        return exec_make_i16(exec_vm_numeric_to_i64(value) as i16);
    }
    if target_kind == TypeKind.TYPE_I32 as i32 {
        return exec_make_i32(exec_vm_numeric_to_i64(value) as i32);
    }
    if target_kind == TypeKind.TYPE_I64 as i32 {
        return exec_make_i64(exec_vm_numeric_to_i64(value));
    }
    if target_kind == TypeKind.TYPE_U8 as i32 {
        return exec_make_u8(exec_vm_numeric_to_u64(value) as u8);
    }
    if target_kind == TypeKind.TYPE_U16 as i32 {
        return exec_make_u16(exec_vm_numeric_to_u64(value) as u16);
    }
    if target_kind == TypeKind.TYPE_U32 as i32 {
        return exec_make_u32(exec_vm_numeric_to_u64(value) as u32);
    }
    if target_kind == TypeKind.TYPE_U64 as i32 {
        return exec_make_u64(exec_vm_numeric_to_u64(value));
    }
    if target_kind == TypeKind.TYPE_USIZE as i32 {
        return exec_make_usize(exec_vm_value_bytes_address(value) as usize);
    }
    if target_kind == TypeKind.TYPE_BOOL as i32 {
        return exec_make_bool((exec_value_truthy(value) != 0) as i32);
    }
    if target_kind == TypeKind.TYPE_BYTE as i32 {
        return exec_make_byte(exec_vm_numeric_to_i64(value) as i32);
    }
    if target_kind == TypeKind.TYPE_POINTER as i32 {
        if value.kind == ExecValueKind.EXEC_VALUE_POINTER {
            // 内部引用（`&local`/`&arr[i]` 产出的引用）转指针时保留引用编码，
            // 否则后续解引用会把它当原生指针对待，按标量尺寸访问 ExecValue。
            if exec_vm_pointer_is_internal_ref(&value) != 0 {
                if exec_vm_pointer_is_index_base_ref(&value) != 0 {
                    return exec_make_pointer_with_kind(value.i64_value as usize,
                        exec_vm_encode_index_ref_kind(target_pointee_kind));
                }
                return exec_make_pointer_with_kind(value.i64_value as usize,
                    exec_vm_encode_ref_kind(target_pointee_kind));
            }
            return exec_make_pointer_with_kind(value.i64_value as usize, target_pointee_kind);
        }
        if value.kind == ExecValueKind.EXEC_VALUE_STRING {
            return exec_make_pointer_with_kind(value.i64_value as usize, target_pointee_kind);
        }
        return exec_make_pointer_with_kind(exec_vm_numeric_to_u64(value) as usize, target_pointee_kind);
    }
    if target_kind == TypeKind.TYPE_VA_LIST as i32 && value.kind == ExecValueKind.EXEC_VALUE_VA_LIST {
        return exec_value_clone(&value);
    }
    return value;
}

/// 取一个可打印值的字节码（低 8 位），非整数类型返回 0。
fn exec_vm_print_byte_at(value: ExecValue) i32 {
    if exec_vm_value_kind_is_integer(value.kind) == 0 {
        return 0;
    }
    return (value.i64_value & 255) as i32;
}

/// 打印字节切片：与 C 的 `%s` 一致，遇到 NUL 或切片末尾就停。
/// 参数：value 字节切片；newline 非 0 时追加换行。
/// 返回值：实际写出的字节数（含换行）。
fn exec_vm_print_byte_slice(value: ExecValue, newline: i32) i64 {
    if exec_value_is_raw_slice(&value) != 0 {
        const raw: &byte = exec_value_slice_raw_ptr(&value);
        if raw == null {
            return 0;
        }
        if newline != 0 {
            return fprintf(libc.stdout, "%s\n" as *byte, raw) as i64;
        }
        return fprintf(libc.stdout, "%s" as *byte, raw) as i64;
    }
    const slice_data: &ExecSliceData = exec_value_as_slice(&value);
    if slice_data == null || slice_data.aggregate == null || slice_data.aggregate.values == null {
        return 0;
    }
    var printed: i64 = 0;
    var step: i32 = 0;
    while step < slice_data.len {
        const idx: i32 = slice_data.start +% step;
        if idx < 0 || idx >= slice_data.aggregate.count {
            break;
        }
        const ch: i32 = exec_vm_print_byte_at(slice_data.aggregate.values[idx]);
        if ch == 0 {
            break;
        }
        if fputc(ch, libc.stdout) < 0 {
            break;
        }
        printed = printed + 1;
        step = step + 1;
    }
    if newline != 0 && fputc(10, libc.stdout) >= 0 {
        printed = printed + 1;
    }
    return printed;
}

fn exec_vm_print_value(value: ExecValue, newline: i32) i64 {
    if value.kind == ExecValueKind.EXEC_VALUE_I8 {
        if newline != 0 {
            return fprintf(libc.stdout, "%d\n" as *byte, value.i64_value as i8) as i64;
        } else {
            return fprintf(libc.stdout, "%d" as *byte, value.i64_value as i8) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I16 {
        if newline != 0 {
            return fprintf(libc.stdout, "%d\n" as *byte, value.i64_value as i16) as i64;
        } else {
            return fprintf(libc.stdout, "%d" as *byte, value.i64_value as i16) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I32 {
        if newline != 0 {
            return fprintf(libc.stdout, "%d\n" as *byte, value.i64_value as i32) as i64;
        } else {
            return fprintf(libc.stdout, "%d" as *byte, value.i64_value as i32) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_I64 {
        if newline != 0 {
            return fprintf(libc.stdout, "%ld\n" as *byte, value.i64_value) as i64;
        } else {
            return fprintf(libc.stdout, "%ld" as *byte, value.i64_value) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_ISIZE {
        if newline != 0 {
            return fprintf(libc.stdout, "%ld\n" as *byte, value.i64_value as isize) as i64;
        } else {
            return fprintf(libc.stdout, "%ld" as *byte, value.i64_value as isize) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U8 {
        if newline != 0 {
            return fprintf(libc.stdout, "%u\n" as *byte, value.i64_value as u8) as i64;
        } else {
            return fprintf(libc.stdout, "%u" as *byte, value.i64_value as u8) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U16 {
        if newline != 0 {
            return fprintf(libc.stdout, "%u\n" as *byte, value.i64_value as u16) as i64;
        } else {
            return fprintf(libc.stdout, "%u" as *byte, value.i64_value as u16) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U32 {
        if newline != 0 {
            return fprintf(libc.stdout, "%u\n" as *byte, value.i64_value as u32) as i64;
        } else {
            return fprintf(libc.stdout, "%u" as *byte, value.i64_value as u32) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_U64 {
        if newline != 0 {
            return fprintf(libc.stdout, "%lu\n" as *byte, value.i64_value as u64) as i64;
        } else {
            return fprintf(libc.stdout, "%lu" as *byte, value.i64_value as u64) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_USIZE {
        if newline != 0 {
            return fprintf(libc.stdout, "%lu\n" as *byte, value.i64_value as usize) as i64;
        } else {
            return fprintf(libc.stdout, "%lu" as *byte, value.i64_value as usize) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_F32 {
        if newline != 0 {
            return fprintf(libc.stdout, "%g\n" as *byte, exec_f32_from_bits(value.i64_value as u32) as f64) as i64;
        } else {
            return fprintf(libc.stdout, "%g" as *byte, exec_f32_from_bits(value.i64_value as u32) as f64) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_F64 {
        if newline != 0 {
            return fprintf(libc.stdout, "%g\n" as *byte, exec_f64_from_bits(value.i64_value as u64)) as i64;
        } else {
            return fprintf(libc.stdout, "%g" as *byte, exec_f64_from_bits(value.i64_value as u64)) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_BOOL {
        var bool_text: *byte = "false" as *byte;
        if value.i64_value != 0 {
            bool_text = "true" as *byte;
        }
        if newline != 0 {
            return fprintf(libc.stdout, "%s\n" as *byte, bool_text) as i64;
        } else {
            return fprintf(libc.stdout, "%s" as *byte, bool_text) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_BYTE {
        if newline != 0 {
            return fprintf(libc.stdout, "%c\n" as *byte, value.i64_value as i32) as i64;
        } else {
            return fprintf(libc.stdout, "%c" as *byte, value.i64_value as i32) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_STRING && value.ptr_value != null {
        if newline != 0 {
            return fprintf(libc.stdout, "%s\n" as *byte, value.ptr_value as *byte) as i64;
        } else {
            return fprintf(libc.stdout, "%s" as *byte, value.ptr_value as *byte) as i64;
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const print_slice_elem: i32 = exec_value_slice_element_kind(&value);
        if print_slice_elem == TypeKind.TYPE_BYTE as i32 || print_slice_elem == TypeKind.TYPE_I8 as i32 ||
            print_slice_elem == TypeKind.TYPE_U8 as i32 {
            return exec_vm_print_byte_slice(value, newline);
        }
    }
    if value.kind == ExecValueKind.EXEC_VALUE_POINTER {
        const print_pointee: i32 = exec_value_pointer_pointee_kind(&value);
        if value.ptr_value != null && (print_pointee == TypeKind.TYPE_BYTE as i32 ||
            print_pointee == TypeKind.TYPE_I8 as i32 || print_pointee == TypeKind.TYPE_U8 as i32) {
            if newline != 0 {
                return fprintf(libc.stdout, "%s\n" as *byte, value.ptr_value as *byte) as i64;
            } else {
                return fprintf(libc.stdout, "%s" as *byte, value.ptr_value as *byte) as i64;
            }
        } else if newline != 0 {
            return fprintf(libc.stdout, "%lu\n" as *byte, value.i64_value as usize) as i64;
        } else {
            return fprintf(libc.stdout, "%lu" as *byte, value.i64_value as usize) as i64;
        }
    }
    if newline != 0 {
        return fprintf(libc.stdout, "\n" as *byte) as i64;
    }
    return 0;
}

fn exec_vm_trace(trace_vm: i32, fn_name: &byte, ip: i32, instr: &BCInstr) void {
    if trace_vm == 0 || instr == null {
        return;
    }
    fprintf(libc.stderr, "[vm] fn=%s ip=%d op=%s(%d) a=%d b=%d c=%d imm=%ld\n" as *byte,
        fn_name as *byte, ip, exec_debug_opcode_name(instr.opcode) as *byte, instr.opcode as i32, instr.a, instr.b, instr.c, instr.imm);
}

fn exec_vm_trace_call_enter(trace_vm: i32, fn_name: &byte, arg_count: i32) void {
    if trace_vm == 0 {
        return;
    }
    fprintf(libc.stderr, "[vm] enter fn=%s args=%d\n" as *byte, fn_name as *byte, arg_count);
}

fn exec_vm_trace_jump(trace_vm: i32, fn_name: &byte, from_ip: i32, to_ip: i32, reason: &byte) void {
    if trace_vm == 0 {
        return;
    }
    fprintf(libc.stderr, "[vm] jump fn=%s from=%d to=%d reason=%s\n" as *byte,
        fn_name as *byte, from_ip, to_ip, reason as *byte);
}

fn exec_vm_load_const(program: &BCProgram, function: &BCFunction, const_idx: i32, out_value: &ExecValue) i32 {
    if program == null || function == null || out_value == null {
        exec_backend_set_error(null, "exec: LOAD_CONST 输入无效" as *byte, 0);
        return -1;
    }
    if const_idx < 0 || const_idx >= program.const_pool.count || program.const_pool.values == null {
        exec_backend_set_error(function.decl, "exec: LOAD_CONST 常量索引越界" as *byte, 0);
        return -1;
    }
    out_value[0] = program.const_pool.values[const_idx];
    return 0;
}

fn exec_vm_get_aggregate_for_slice(function: &BCFunction, value: ExecValue) &ExecAggregate {
    if value.kind == ExecValueKind.EXEC_VALUE_ARRAY {
        return exec_value_as_aggregate(&value);
    }
    if value.kind == ExecValueKind.EXEC_VALUE_SLICE {
        const slice_data: &ExecSliceData = exec_value_as_slice(&value);
        if slice_data != null {
            return slice_data.aggregate;
        }
    }
    exec_backend_set_error(function.decl, "exec: 切片基值不是 array/slice" as *byte, 0);
    return null;
}

fn exec_vm_lookup_error_name(program: &BCProgram, error_id: i32) &byte {
    if program == null || error_id == 0 || program.error_names == null || program.error_name_count <= 0 {
        return "UnknownError" as &byte;
    }
    var left: i32 = 0;
    var right: i32 = program.error_name_count - 1;
    while left <= right {
        const mid: i32 = left + (right - left) / 2;
        const entry: &BCErrorNameEntry = program.error_names + mid;
        if entry == null {
            break;
        }
        if entry.error_id == error_id {
            if entry.name != null {
                return entry.name;
            }
            break;
        }
        if entry.error_id < error_id {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    return "UnknownError" as &byte;
}

fn exec_vm_wrap_syscall_result(result: !i64, target_kind: i32, target_pointee_kind: i32) ExecValue {
    const ok_value: i64 = result catch |err| {
        return exec_make_error_union_err(@error_id(err) as i32);
    };
    const raw_value: ExecValue = exec_make_i64(ok_value);
    const cast_value: ExecValue = exec_vm_cast_value(raw_value, target_kind, target_pointee_kind);
    return exec_make_error_union_ok(cast_value);
}

fn exec_vm_host_syscall0(target_kind: i32, target_pointee_kind: i32, nr: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall1(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall2(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall3(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall4(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64, a4: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3, a4), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall5(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3, a4, a5), target_kind, target_pointee_kind);
}

fn exec_vm_host_syscall6(target_kind: i32, target_pointee_kind: i32, nr: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) ExecValue {
    return exec_vm_wrap_syscall_result(@syscall(nr, a1, a2, a3, a4, a5, a6), target_kind, target_pointee_kind);
}

/// 取错误值自带的错误 id（错误值 / 错误联合）；不是错误值就按整数载荷处理。
fn exec_vm_error_id_from_value(value: ExecValue) i64 {
    if value.kind == ExecValueKind.EXEC_VALUE_ERROR || value.kind == ExecValueKind.EXEC_VALUE_ERROR_UNION {
        return (value.error_id as u32) as i64;
    }
    return value.i64_value;
}

fn exec_vm_dispatch_host_syscall(target_kind: i32, target_pointee_kind: i32, nr: i64, args: &i64, arg_count: i32) ExecValue {
    if arg_count == 0 {
        return exec_vm_host_syscall0(target_kind, target_pointee_kind, nr);
    }
    if arg_count == 1 {
        return exec_vm_host_syscall1(target_kind, target_pointee_kind, nr, args[0]);
    }
    if arg_count == 2 {
        return exec_vm_host_syscall2(target_kind, target_pointee_kind, nr, args[0], args[1]);
    }
    if arg_count == 3 {
        return exec_vm_host_syscall3(target_kind, target_pointee_kind, nr, args[0], args[1], args[2]);
    }
    if arg_count == 4 {
        return exec_vm_host_syscall4(target_kind, target_pointee_kind, nr, args[0], args[1], args[2], args[3]);
    }
    if arg_count == 5 {
        return exec_vm_host_syscall5(target_kind, target_pointee_kind, nr, args[0], args[1], args[2], args[3], args[4]);
    }
    if arg_count == 6 {
        return exec_vm_host_syscall6(target_kind, target_pointee_kind, nr, args[0], args[1], args[2], args[3], args[4], args[5]);
    }
    return exec_make_void();
}

/// 出参结构体：把标记过的参数换成原生缓冲区（内核按原生布局写入），
/// 调完 syscall 再按字段顺序写回 VM 的聚合值。
/// 参数：function - 当前函数；frame - 当前帧；meta 各字段见 exec_vm_decode_*；
///       args - 参数数组（会被就地改写为缓冲区地址）；out_target - 输出出参聚合值。
/// 返回：0 成功，-1 失败。
fn exec_vm_syscall_marshal_out_struct(function: &BCFunction, frame: &ExecFrame, arg_base: i32, arg_count: i32,
    out_mask: i32, args: &i64, out_target: & & ExecValue) &i64 {
    out_target[0] = null;
    if out_mask == 0 || args == null {
        return null;
    }
    var oi: i32 = 0;
    while oi < arg_count && oi < 2 {
        if (out_mask & (1 << oi)) != 0 {
            const arg_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base + oi);
            const target: &ExecValue = exec_vm_syscall_out_struct_target(arg_slot, args[oi]);
            var field_count: i32 = 0;
            const buffer: &i64 = exec_vm_syscall_out_struct_prepare(target, &field_count);
            if buffer != null {
                out_target[0] = target;
                args[oi] = buffer as i64;
                return buffer;
            }
            return null;
        }
        oi = oi + 1;
    }
    return null;
}

fn exec_vm_exec_syscall(function: &BCFunction, frame: &ExecFrame, nr_slot: &ExecValue, syscall_meta: i64, out_value: &ExecValue) i32 {
    if function == null || frame == null || nr_slot == null || out_value == null {
        exec_backend_set_error(null, "exec: syscall 输入无效" as *byte, 0);
        return -1;
    }
    const arg_base: i32 = exec_vm_decode_syscall_arg_base(syscall_meta);
    const arg_count: i32 = exec_vm_decode_syscall_arg_count(syscall_meta);
    const target_kind: i32 = exec_vm_decode_syscall_target_kind(syscall_meta);
    const target_pointee_kind: i32 = exec_vm_decode_syscall_target_pointee_kind(syscall_meta);
    const out_mask: i32 = exec_vm_decode_syscall_out_mask(syscall_meta);
    var args: [i64: 6] = [];
    var ai: i32 = 0;
    while ai < arg_count {
        const arg_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base + ai);
        if arg_slot == null {
            exec_backend_set_error(function.decl, "exec: syscall 参数槽位越界" as *byte, 0);
            return -1;
        }
        args[ai] = exec_vm_syscall_arg_to_i64(arg_slot[0]);
        ai = ai + 1;
    }
    const nr_value: i64 = exec_vm_syscall_arg_to_i64(nr_slot[0]);
    var out_target: &ExecValue = null;
    const out_buffer: &i64 = exec_vm_syscall_marshal_out_struct(function, frame, arg_base, arg_count,
        out_mask, &args[0], &out_target);
    if arg_count > 6 {
        exec_backend_set_error(function.decl, "exec: syscall 参数数量非法" as *byte, 0);
        return -1;
    }
    // clone 出来的线程与父线程共享地址空间，却会各自持有解释器状态，
    // 父线程等待子线程就永远等不到（普查里表现为整例超时）。fork/vfork 是
    // 写时复制的独立副本，解释器状态自洽，保持放行。
    if nr_value == 56 || nr_value == 435 {
        exec_backend_set_error(function.decl, "exec: 解释器不支持创建线程/进程(clone/fork)" as *byte, 0);
        return -1;
    }
    out_value[0] = exec_vm_dispatch_host_syscall(target_kind, target_pointee_kind, nr_value, &args[0], arg_count);
    if out_target != null && out_buffer != null {
        exec_vm_syscall_out_struct_apply(out_target, out_buffer, out_target.i64_value as i32);
    }
    return 0;
}

fn exec_vm_va_start(function: &BCFunction, frame: &ExecFrame, ap_ref_slot: &ExecValue) i32 {
    if function == null || frame == null {
        exec_backend_set_error(null, "exec: va_start 输入无效" as *byte, 0);
        return -1;
    }
    const ap_target: &ExecValue = exec_vm_resolve_va_target(ap_ref_slot);
    if ap_target == null {
        exec_backend_set_error(function.decl, "exec: va_start 目标无效" as *byte, 0);
        return -1;
    }
    ap_target[0] = exec_make_va_list(&frame.varargs[0], frame.vararg_count, 0);
    return 0;
}

fn exec_vm_va_end(function: &BCFunction, ap_ref_slot: &ExecValue) i32 {
    if function == null {
        exec_backend_set_error(null, "exec: va_end 输入无效" as *byte, 0);
        return -1;
    }
    const ap_target: &ExecValue = exec_vm_resolve_va_target(ap_ref_slot);
    if ap_target == null {
        exec_backend_set_error(function.decl, "exec: va_end 目标无效" as *byte, 0);
        return -1;
    }
    ap_target[0] = exec_make_void();
    return 0;
}

fn exec_vm_va_copy(function: &BCFunction, dest_ref_slot: &ExecValue, src_ref_slot: &ExecValue) i32 {
    if function == null {
        exec_backend_set_error(null, "exec: va_copy 输入无效" as *byte, 0);
        return -1;
    }
    const dest_target: &ExecValue = exec_vm_resolve_va_target(dest_ref_slot);
    const src_target: &ExecValue = exec_vm_resolve_va_target(src_ref_slot);
    if dest_target == null || src_target == null {
        exec_backend_set_error(function.decl, "exec: va_copy 目标无效" as *byte, 0);
        return -1;
    }
    if src_target.kind != ExecValueKind.EXEC_VALUE_VA_LIST {
        exec_backend_set_error(function.decl, "exec: va_copy 源不是 va_list" as *byte, 0);
        return -1;
    }
    dest_target[0] = exec_value_clone(src_target);
    return 0;
}

fn exec_vm_va_arg(function: &BCFunction, ap_ref_slot: &ExecValue, target_kind: i32, target_pointee_kind: i32, out_value: &ExecValue) i32 {
    if function == null || out_value == null {
        exec_backend_set_error(null, "exec: va_arg 输入无效" as *byte, 0);
        return -1;
    }
    const ap_target: &ExecValue = exec_vm_resolve_va_target(ap_ref_slot);
    if ap_target == null {
        exec_backend_set_error(function.decl, "exec: va_arg 目标无效" as *byte, 0);
        return -1;
    }
    if ap_target.kind != ExecValueKind.EXEC_VALUE_VA_LIST {
        exec_backend_set_error(function.decl, "exec: va_arg 源不是 va_list" as *byte, 0);
        return -1;
    }
    const arg_index: i32 = ap_target.i64_value as i32;
    const arg_count: i32 = ap_target.aux_i64_value as i32;
    if arg_index < 0 || arg_index >= arg_count {
        exec_backend_set_error(function.decl, "exec: va_arg 越界" as *byte, 0);
        return -1;
    }
    const args_ptr: &ExecValue = ap_target.ptr_value as &ExecValue;
    if args_ptr == null {
        exec_backend_set_error(function.decl, "exec: va_arg 数据为空" as *byte, 0);
        return -1;
    }
    const raw_value: ExecValue = args_ptr[arg_index];
    ap_target.i64_value = (arg_index + 1) as i64;
    out_value[0] = exec_vm_cast_value(raw_value, target_kind, target_pointee_kind);
    return 0;
}

fn exec_vm_host_call_site_ref(program: &BCProgram, idx: i32) &BCHostCallSite {
    if program == null || program.host_calls == null || idx < 0 || idx >= program.host_call_count {
        return null;
    }
    return &program.host_calls[idx];
}

fn exec_vm_pointer_load_value(function: &BCFunction, ptr_value: &ExecValue, out_value: &ExecValue) i32 {
    if function == null || ptr_value == null || out_value == null {
        exec_backend_set_error(null, "exec: pointer load helper 输入无效" as *byte, 0);
        return -1;
    }
    if exec_vm_pointer_is_internal_ref(ptr_value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(ptr_value);
        if target == null {
            exec_backend_set_error(function.decl, "exec: pointer load helper 目标为空" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_value_clone(target);
        return 0;
    }
    if exec_value_is_pointer_like(ptr_value[0]) != 0 {
        return exec_vm_load_pointer_index(function, ptr_value[0], 0, out_value);
    }
    exec_backend_set_error(function.decl, "exec: pointer load helper 目标不是指针" as *byte, 0);
    return -1;
}

fn exec_vm_pointer_store_value(function: &BCFunction, ptr_value: &ExecValue, src_value: ExecValue) i32 {
    if function == null || ptr_value == null {
        exec_backend_set_error(null, "exec: pointer store helper 输入无效" as *byte, 0);
        return -1;
    }
    if exec_vm_pointer_is_internal_ref(ptr_value) != 0 {
        const target: &ExecValue = exec_vm_ref_target_value(ptr_value);
        if target == null {
            exec_backend_set_error(function.decl, "exec: pointer store helper 目标为空" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(target, src_value);
        return 0;
    }
    if exec_value_is_pointer_like(ptr_value[0]) != 0 {
        return exec_vm_store_pointer_index(function, ptr_value[0], 0, src_value);
    }
    exec_backend_set_error(function.decl, "exec: pointer store helper 目标不是指针" as *byte, 0);
    return -1;
}

/// 原子读改写：读旧值 -> 按 op 算新值 -> 写回 -> 输出旧值或新值。
///
/// 参数：`op` 0=只读、1=加、2=减、3=写成第 2 个实参；
///       `want_new` 非 0 时输出新值（add_fetch 语义），否则输出旧值。
/// 返回值：0 成功；-1 失败（已设置错误）。
fn exec_vm_atomic_update(function: &BCFunction, frame: &ExecFrame, arg_base: i32,
    op: i32, want_new: i32, out_value: &ExecValue) i32 {
    const ptr_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
    if ptr_arg == null {
        exec_backend_set_error(function.decl, "exec: 原子操作参数槽位非法" as *byte, 0);
        return -1;
    }
    var current: ExecValue = exec_make_void();
    if exec_vm_pointer_load_value(function, ptr_arg, &current) != 0 {
        return -1;
    }
    if op == 0 {
        out_value[0] = exec_value_clone(&current);
        return 0;
    }
    const operand_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
    if operand_arg == null {
        exec_backend_set_error(function.decl, "exec: 原子操作操作数槽位非法" as *byte, 0);
        return -1;
    }
    var updated_value: ExecValue = operand_arg[0];
    if op == 1 || op == 2 {
        const base_i64: i64 = exec_vm_numeric_to_i64(exec_value_clone(&current));
        const operand_i64: i64 = exec_vm_numeric_to_i64(operand_arg[0]);
        var new_i64: i64 = base_i64 +| operand_i64;
        if op == 2 {
            new_i64 = base_i64 -| operand_i64;
        }
        updated_value = exec_make_i64(new_i64);
    }
    const pointee_kind_atomic: i32 = exec_value_pointer_pointee_kind(&ptr_arg[0]);
    const cast_updated: ExecValue = exec_vm_cast_value(updated_value, pointee_kind_atomic, 0);
    if exec_vm_pointer_store_value(function, ptr_arg, cast_updated) != 0 {
        return -1;
    }
    if want_new != 0 {
        out_value[0] = cast_updated;
    } else {
        out_value[0] = exec_value_clone(&current);
    }
    return 0;
}

fn exec_vm_call_host(function: &BCFunction, site: &BCHostCallSite, frame: &ExecFrame, arg_base: i32, arg_count: i32, out_value: &ExecValue) i32 {
    if function == null || site == null || frame == null || out_value == null {
        exec_backend_set_error(null, "exec: hostcall 输入无效" as *byte, 0);
        return -1;
    }
    if site.arg_count != arg_count {
        exec_backend_set_error(function.decl, "exec: hostcall 参数数量非法" as *byte, 0);
        return -1;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PUTS {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: puts 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: puts 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(puts(arg0.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOI {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: atoi 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: atoi 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(atoi(arg0.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ATOLL {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: atoll 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: atoll 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i64(atoll(arg0.ptr_value));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_ISQRT {
        if arg_count != 1 {
            exec_backend_set_error(function.decl, "exec: isqrt 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: isqrt 参数槽位非法" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_u64(isqrt(arg0.i64_value as u64));
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_STRCMP {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: strcmp 参数数量非法" as *byte, 0);
            return -1;
        }
