        }
        out_value[0] = exec_make_i32(0);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_INIT ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETSTACKSIZE ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_SETSTACKSIZE ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETDETACHSTATE ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_SETDETACHSTATE ||
        site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_COND_TIMEDWAIT {
