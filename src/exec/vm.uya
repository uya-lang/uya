            exec_backend_set_error(function.decl, "exec: MUL_SAT 槽位越界" as *byte, 0);
            return -1;
        }
        const sat_mul_kind: ExecValueKind = exec_vm_value_kind_from_type_code(instr.imm as i32, slot_b.kind);
        if exec_vm_value_kind_is_float(sat_mul_kind) != 0 {
