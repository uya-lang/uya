            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_UNLOCK {
            const mutex_value4: &ExecValue = exec_vm_slot_ref(frame, arg_base);
            const mutex_state4: &ExecValue = exec_vm_field_ref_store(mutex_value4, 0);
            if mutex_state4 != null {
                exec_vm_store_slot(mutex_state4, exec_make_i32(0));
