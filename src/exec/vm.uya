        if exec_vm_value_kind_is_float(sat_add_kind) != 0 {
            // 浮点没有饱和语义，按普通加法处理
            slot_a[0] = exec_vm_make_float_by_kind(sat_add_kind, exec_value_as_f64(slot_b) + exec_value_as_f64(slot_c));
        } else {
            slot_a[0] = exec_vm_sat_add(sat_add_kind, slot_b.i64_value, slot_b.i64_value as u64,
