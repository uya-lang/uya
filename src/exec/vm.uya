                exec_vm_store_slot(attr_stack, exec_make_usize(8388608 as usize));
            }
            const attr_detached: &ExecValue = exec_vm_field_ref_store(attr_value, 1);
            if attr_detached != null {
                exec_vm_store_slot(attr_detached, exec_make_i32(0));
            }
            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETSTACKSIZE ||
            site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETDETACHSTATE {
            const out_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
            const out_target: &ExecValue = exec_vm_ref_target_value(out_arg);
            const attr_field_index: i32 =
                if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETSTACKSIZE { 0 } else { 1 };
            const attr_field: &ExecValue = exec_vm_field_ref(attr_value, attr_field_index);
            if out_target != null && attr_field != null {
                if attr_field_index == 0 {
                    exec_vm_store_slot(out_target, exec_make_usize(attr_field.i64_value as usize));
                } else {
                    exec_vm_store_slot(out_target, exec_make_i32(attr_field.i64_value as i32));
                }
