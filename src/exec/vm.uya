            out_value[0] = exec_make_i32(0);
            return 0;
        }
        // setstacksize / setdetachstate
        const in_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const set_field_index: i32 =
            if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_SETSTACKSIZE { 0 } else { 1 };
        if in_arg != null {
            if set_field_index == 0 && in_arg.i64_value < 16384 {
                // 栈下限 16KB（与 C 侧 pthread_attr_setstacksize 一致）
                out_value[0] = exec_make_i32(22);
                return 0;
            }
            if set_field_index == 1 && in_arg.i64_value != 0 && in_arg.i64_value != 1 {
                out_value[0] = exec_make_i32(22);
                return 0;
            }
        }
        const set_field: &ExecValue = exec_vm_field_ref_store(attr_value, set_field_index);
        if set_field != null && in_arg != null {
            if set_field_index == 0 {
                exec_vm_store_slot(set_field, exec_make_usize(in_arg.i64_value as usize));
            } else {
                exec_vm_store_slot(set_field, exec_make_i32(in_arg.i64_value as i32));
            }
        }
        out_value[0] = exec_make_i32(0);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_EXIT {
        if arg_count == 1 {
            const exit_arg: &ExecValue = exec_vm_slot_ref(frame, arg_base);
            if exit_arg != null {
