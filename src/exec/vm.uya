            const retval_slot: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
            if retval_slot != null && retval_slot.ptr_value != null {
                const retval_target: &ExecValue = exec_vm_ref_target_value(retval_slot);
                if retval_target != null {
                    var join_result: ExecValue = exec_make_pointer_with_kind(0 as usize, TypeKind.TYPE_VOID as i32);
                    if th_slot >= 0 && th_slot < EXEC_VM_THREAD_SLOTS {
