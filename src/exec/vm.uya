            slot_a[0] = slot_b[0];
        }
    } else if instr.opcode == BCOpcode.BC_UNWRAP_ERR {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: UNWRAP_ERR 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_is_error_union_err(slot_b[0]) == 0 {
            exec_backend_set_error(function.decl, "exec: UNWRAP_ERR 遇到成功值" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_value_unwrap_err(slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_ERROR_ID {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ERROR_ID 槽位越界" as *byte, 0);
            return -1;
        }
        // `@error_id` 的类型是 u32：必须零扩展，否则高位为 1 的错误 id
        // （如 error.NamedFailure = 3096688242）会变成负数，和常量比较恒不相等。
        slot_a[0] = exec_make_u32(exec_value_error_id(slot_b[0]) as u32);
    } else if instr.opcode == BCOpcode.BC_ERROR_NAME {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ERROR_NAME 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_string(exec_vm_lookup_error_name(program, exec_value_error_id(slot_b[0])));
    } else if instr.opcode == BCOpcode.BC_AWAIT {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: AWAIT 槽位越界" as *byte, 0);
            return -1;
        }
        // `@await f`：Future 只有 `state: Poll<T>` 一个字段；Poll 的 Ready 变体下标是 1
        // （`union Poll<T> { Pending: void, Ready: T }`）。
        // VM 里 async 函数同步执行到完成，所以这里只会见到 Ready。
        const poll_data: &ExecUnionData = exec_vm_await_find_poll(slot_b, 0);
        if poll_data != null && poll_data.tag == 1 {
            slot_a[0] = exec_value_clone(&poll_data.payload);
        } else if poll_data != null && poll_data.tag == 0 {
            // 明确的 Pending：穿透给调用方（详见 exec_vm_await_pass_through_pending）。
            if exec_vm_await_pass_through_pending(function, slot_b, out_value) != 0 {
                return 1;
            }
            exec_backend_set_error(function.decl,
                "exec: @await 操作数始终 Pending，且当前函数不返回 Future" as *byte, 0);
            return -1;
        } else {
            // 自己实现 poll 的 Future：同步忙等直到不再是 Pending。
            var awaited: ExecValue = exec_make_void();
            const poll_rc: i32 = exec_vm_await_poll_interface(program, slot_b, &awaited);
            if poll_rc == 1 {
                // 忙等窗口内一直 Pending：同样穿透。
                if exec_vm_await_pass_through_pending(function, slot_b, out_value) != 0 {
                    return 1;
                }
                exec_backend_set_error(function.decl,
                    "exec: @await 操作数始终 Pending，且当前函数不返回 Future" as *byte, 0);
                return -1;
            }
            if poll_rc < 0 {
                // 内层（真正的 poll 调用）已经设过错误信息，别覆盖掉，
                // 否则这里只会看到「不是 Future」，查不到真实原因。
                return -1;
            }
            if poll_rc != 0 {
                exec_backend_set_error(function.decl,
                    "exec: @await 操作数不是 Future" as *byte, 0);
                return -1;
            }
            slot_a[0] = awaited;
        }
    } else if instr.opcode == BCOpcode.BC_JMP {
        exec_vm_trace_jump(trace_vm, function.name, frame.ip, instr.imm as i32, "jmp" as *byte);
        frame.ip = instr.imm as i32;
        return 0;
    } else if instr.opcode == BCOpcode.BC_JMP_IF_TRUE {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: JMP_IF_TRUE 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_truthy(slot_a[0]) != 0 {
            exec_vm_trace_jump(trace_vm, function.name, frame.ip, instr.imm as i32, "cond-true" as *byte);
            frame.ip = instr.imm as i32;
            return 0;
        }
    } else if instr.opcode == BCOpcode.BC_JMP_IF_FALSE {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: JMP_IF_FALSE 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_value_truthy(slot_a[0]) == 0 {
            exec_vm_trace_jump(trace_vm, function.name, frame.ip, instr.imm as i32, "cond-false" as *byte);
            frame.ip = instr.imm as i32;
            return 0;
        }
    } else if instr.opcode == BCOpcode.BC_CALL {
        const callee_idx: i32 = instr.imm as i32;
        if callee_idx < 0 || callee_idx >= program.function_count {
            exec_backend_set_error(function.decl, "exec: 无法找到被调用函数" as *byte, 0);
            return -1;
        }
        var call_args: [ExecValue: EXEC_MAX_CALL_ARGS] = [];
        var ai: i32 = 0;
        while ai < instr.c && ai < EXEC_MAX_CALL_ARGS {
            const arg_slot: &ExecValue = exec_vm_slot_ref(frame, instr.b + ai);
            if arg_slot == null {
                exec_backend_set_error(function.decl, "exec: CALL 参数槽位越界" as *byte, 0);
                return -1;
            }
            call_args[ai] = exec_value_clone(arg_slot);
            ai = ai + 1;
        }
        var call_result: ExecValue = exec_make_void();
        if exec_vm_call_function(program, callee_idx, &call_args[0], instr.c, trace_vm, &call_result) != 0 {
            return -1;
        }
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: CALL 返回槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, call_result);
    } else if instr.opcode == BCOpcode.BC_CALL_INDIRECT {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: CALL_INDIRECT 槽位越界" as *byte, 0);
            return -1;
        }
        const callee_idx2: i32 = slot_b.i64_value as i32;
        if callee_idx2 < 0 || callee_idx2 >= program.function_count {
            exec_backend_set_error(function.decl, "exec: CALL_INDIRECT 目标非法" as *byte, 0);
            return -1;
        }
        var call_args3: [ExecValue: EXEC_MAX_CALL_ARGS] = [];
        var ai3: i32 = 0;
        while ai3 < instr.imm as i32 && ai3 < EXEC_MAX_CALL_ARGS {
            const arg_slot3: &ExecValue = exec_vm_slot_ref(frame, instr.c + ai3);
            if arg_slot3 == null {
                exec_backend_set_error(function.decl, "exec: CALL_INDIRECT 参数槽位越界" as *byte, 0);
                return -1;
            }
            call_args3[ai3] = exec_value_clone(arg_slot3);
            ai3 = ai3 + 1;
        }
        var indirect_result: ExecValue = exec_make_void();
        if exec_vm_call_function(program, callee_idx2, &call_args3[0], instr.imm as i32, trace_vm, &indirect_result) != 0 {
            return -1;
        }
        exec_vm_store_slot(slot_a, indirect_result);
    } else if instr.opcode == BCOpcode.BC_HOSTCALL {
        const host_site: &BCHostCallSite = exec_vm_host_call_site_ref(program, instr.imm as i32);
        if host_site == null {
            exec_backend_set_error(function.decl, "exec: HOSTCALL 目标非法" as *byte, 0);
            return -1;
        }
        var host_result: ExecValue = exec_make_void();
        if exec_vm_call_host(program, function, host_site, frame, instr.b, instr.c, &host_result) != 0 {
            return -1;
        }
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: HOSTCALL 返回槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, host_result);
    } else if instr.opcode == BCOpcode.BC_SYSCALL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: SYSCALL 槽位越界" as *byte, 0);
            return -1;
        }
        var syscall_result: ExecValue = exec_make_void();
        if exec_vm_exec_syscall(function, frame, slot_b, instr.imm, &syscall_result) != 0 {
            return -1;
        }
        exec_vm_store_slot(slot_a, syscall_result);
    } else if instr.opcode == BCOpcode.BC_VA_START {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: VA_START 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_start(function, frame, slot_b) != 0 {
            return -1;
        }
        slot_a[0] = exec_make_void();
    } else if instr.opcode == BCOpcode.BC_VA_END {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: VA_END 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_end(function, slot_b) != 0 {
            return -1;
        }
        slot_a[0] = exec_make_void();
    } else if instr.opcode == BCOpcode.BC_VA_ARG {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: VA_ARG 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_arg(function, slot_b, instr.imm as i32, instr.c, slot_a) != 0 {
            return -1;
        }
    } else if instr.opcode == BCOpcode.BC_VA_COPY {
        if slot_a == null || slot_b == null || slot_c == null {
            exec_backend_set_error(function.decl, "exec: VA_COPY 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_va_copy(function, slot_b, slot_c) != 0 {
            return -1;
        }
        slot_a[0] = exec_make_void();
    } else if instr.opcode == BCOpcode.BC_PRINT {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: PRINT 槽位越界" as *byte, 0);
            return -1;
        }
        // `@print`/`@println` 的返回值是实际写出的字节数（含换行），
        // 和 C 的 printf 一致；写进 a 槽（临时槽）。
        slot_a[0] = exec_make_i32(exec_vm_print_value(slot_b[0], 0) as i32);
    } else if instr.opcode == BCOpcode.BC_STRING_INTERP {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 槽位越界" as *byte, 0);
            return -1;
        }
        const interp_count: i32 = instr.c;
        if interp_count < 0 || interp_count > 16 {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 实参数量非法" as *byte, 0);
            return -1;
        }
        var interp_args: [ExecValue: 16] = [];
        var interp_i: i32 = 0;
        while interp_i < interp_count {
            const interp_arg_ref: &ExecValue = exec_vm_slot_ref(frame, instr.b + interp_i);
            if interp_arg_ref == null {
                exec_backend_set_error(function.decl, "exec: STRING_INTERP 实参槽位越界" as *byte, 0);
                return -1;
            }
            interp_args[interp_i] = exec_vm_interp_string_arg(interp_arg_ref[0]);
            interp_i = interp_i + 1;
        }
        var interp_buf: ExecFormatBuffer = ExecFormatBuffer {
            data: null,
            len: 0 as usize,
            cap: 0 as usize,
        };
        if exec_format_buffer_init(&interp_buf) == 0 {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 缓冲分配失败" as *byte, 0);
            return -1;
        }
        if exec_format_render(instr.text, &interp_args[0], interp_count, &interp_buf) == 0 {
            exec_backend_set_error(function.decl, "exec: STRING_INTERP 渲染失败" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_string(interp_buf.data);
    } else if instr.opcode == BCOpcode.BC_PRINTLN {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: PRINTLN 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_make_i32(exec_vm_print_value(slot_b[0], 1) as i32);
    } else if instr.opcode == BCOpcode.BC_RET {
        if instr.a >= 0 {
            if slot_a == null {
                exec_backend_set_error(function.decl, "exec: RET 槽位越界" as *byte, 0);
                return -1;
            }
            out_value[0] = exec_value_clone(slot_a);
        } else {
            out_value[0] = exec_make_void();
        }
        return 1;
    } else {
        exec_backend_set_error(function.decl, "exec: 未知 bytecode opcode" as *byte, 0);
        return -1;
    }
    frame.ip = frame.ip + 1;
    return 0;
}

fn exec_vm_call_function(program: &BCProgram, function_index: i32, args: &ExecValue, arg_count: i32, trace_vm: i32, out_value: &ExecValue) i32 {
    if program == null || function_index < 0 || function_index >= program.function_count || out_value == null {
        exec_backend_set_error(null, "exec: VM 调用参数无效" as *byte, 0);
        return -1;
    }
    const function: &BCFunction = program.functions + function_index;
    if function.slot_count > EXEC_MAX_FRAME_SLOTS {
        exec_backend_set_error(function.decl, "exec: VM frame slot 超限" as *byte, 0);
        return -1;
    }
    const base: i32 = exec_vm_slot_pool_push(function.slot_count);
    if base < 0 {
        exec_backend_set_error(function.decl, "exec: VM frame slot 超限" as *byte, 0);
        return -1;
    }
    const rc: i32 = exec_vm_run_frame(program, function, args, arg_count, trace_vm, out_value, base);
    exec_vm_slot_pool_pop(base);
    return rc;
}

/// 在已经切好的槽位栈段上执行一个函数体（配对 `exec_vm_call_function`）。
/// 参数：`base` 槽位栈起始下标。
/// 返回值：0 表示执行完成，-1 表示运行时错误。
fn exec_vm_run_frame(program: &BCProgram, function: &BCFunction, args: &ExecValue, arg_count: i32,
    trace_vm: i32, out_value: &ExecValue, base: i32) i32 {
    var slots_ptr: &ExecValue = exec_vm_slot_pool_base(base);
    if slots_ptr == null {
        // 拿不到自己的槽段时绝不能退回 pool[0]：那会和最深层的帧重叠，
        // 表现为「参数刚拷进去是对的，一次内层调用回来就变了别的类型」。
        exec_backend_set_error(function.decl, "exec: 调用帧槽位段无效" as *byte, 0);
        return -1;
    }
    var frame: ExecFrame = ExecFrame {
        function: function,
        ip: 0,
        slots: slots_ptr,
        varargs: [],
        vararg_count: 0,
    };
    exec_vm_trace_call_enter(trace_vm, function.name, arg_count);
    var si: i32 = 0;
    while si < function.slot_count {
        frame.slots[si] = exec_make_void();
        si = si + 1;
    }
    si = 0;
    while si < EXEC_MAX_CALL_ARGS {
        frame.varargs[si] = exec_make_void();
        si = si + 1;
    }
    si = 0;
    while si < arg_count && si < function.param_count {
        frame.slots[si] = args[si];
        si = si + 1;
    }
    if function.is_varargs != 0 {
        var vi: i32 = 0;
        while function.param_count + vi < arg_count && vi < EXEC_MAX_CALL_ARGS {
            frame.varargs[vi] = exec_vm_promote_vararg_value(args[function.param_count + vi]);
            vi = vi + 1;
        }
        frame.vararg_count = vi;
    }

    while frame.ip < function.instr_count {
        const step_result: i32 = vm_step(program, &frame, trace_vm, out_value);
        if step_result < 0 {
            return -1;
        }
        if step_result > 0 {
            return 0;
        }
        // `pthread_exit(v)`：当前帧直接带 v 返回（C 语义里它不返回）。
        if g_exec_vm_thread_exit_requested != 0 {
            g_exec_vm_thread_exit_requested = 0;
            exec_vm_store_slot(out_value, exec_value_clone(&g_exec_vm_thread_exit_value));
            return 0;
        }
    }
    out_value[0] = exec_make_void();
    return 0;
}

/// 运行已经构建好的 bytecode 程序。
/// 参数：`program` 为 exec backend 构建产物；`trace_vm` 控制是否打印逐条 VM trace。
/// 返回值：成功时返回程序 `main` 的退出码；失败时返回非 0，并通过 exec backend 错误状态说明原因。
/// `exit()` 在解释器里的「提前收工」标记与退出码。
var g_exec_vm_exit_requested: i32 = 0;
var g_exec_vm_exit_code: i32 = 0;

/// `exit()` 是否已经被调用过（用于区分「程序正常结束」和「运行时错误」）。
export fn vm_exit_requested() i32 {
    return g_exec_vm_exit_requested;
}

export fn vm_run_program(program: &BCProgram, trace_vm: i32) i32 {
    if program == null {
        exec_backend_set_error(null, "exec: VM 程序为空" as *byte, 0);
        return 1;
    }
    g_exec_vm_globals_base = @usize_from_ptr(program.globals as &void);
    g_exec_vm_globals_end = g_exec_vm_globals_base +| ((@size_of(ExecValue) as usize) * (program.global_count as usize));
    var gi: i32 = 0;
    while gi < program.global_count {
        program.globals[gi] = exec_make_void();
        gi = gi + 1;
    }
    if program.global_init_function_index >= 0 {
        var init_result: ExecValue = exec_make_void();
        if exec_vm_call_function(program, program.global_init_function_index, null, 0, trace_vm, &init_result) != 0 {
            if g_exec_vm_exit_requested != 0 {
                return g_exec_vm_exit_code;
            }
            return 1;
        }
    }
    // VM 没有 C 运行时的 `uya_rt_init(argc, argv)`：把 `std.runtime.saved_argc`
    // 补成 1（只有程序名），让 `get_argc`/`get_argv` 在 VM 里也自洽。
    if program.saved_argc_global_index >= 0 && program.saved_argc_global_index < program.global_count {
        program.globals[program.saved_argc_global_index] = exec_make_i32(1);
    }
    // `saved_envp: &&byte` 指向**编译器进程自己的**环境表（`std.runtime.saved_envp`
    // 由编译器入口填好）。解释器与 C99 子进程继承同一份环境，语义一致。
    if program.saved_envp_global_index >= 0 && program.saved_envp_global_index < program.global_count &&
        saved_envp != null {
        program.globals[program.saved_envp_global_index] = exec_make_pointer_with_kind(
            @usize_from_ptr(saved_envp as &void), TypeKind.TYPE_POINTER as i32);
    }
    // 顶层 test "..." 块：与 C99 侧 uya_run_tests() 的输出格式保持一致。
    // - 没有用户 main 时（测试文件），先打印 "=== Running N tests ==="，最后打印汇总并
    //   以失败用例数作为退出码；
    // - 有用户 main 时，测试在 main 之前执行（对齐 C99 在 main 开头注入 uya_run_tests），
    //   退出码仍取 main 的返回值。
    if program.test_count > 0 {
        if program.has_user_main == 0 {
            printf("\n=== Running %d tests ===\n" as *byte, program.test_count);
        }
        var passed_cases: i32 = 0;
        var failed_cases: i32 = 0;
        var test_i: i32 = 0;
        while test_i < program.test_count {
            var test_desc: &const byte = null;
            if program.test_descriptions != null && program.test_descriptions[test_i] != null {
                test_desc = program.test_descriptions[test_i] as &const byte;
            }
            printf("  TEST: %s ... " as *byte, test_desc);
            _ = fflush(libc.stdout);
            var test_result: ExecValue = exec_make_void();
            if exec_vm_call_function(program, program.test_function_indices[test_i], null, 0, trace_vm, &test_result) != 0 {
                if g_exec_vm_exit_requested != 0 {
                    return g_exec_vm_exit_code;
                }
                return 1;
            }
            if exec_value_is_error_union_err(test_result) != 0 {
                printf("ERROR\n" as *byte);
                failed_cases = failed_cases +| 1;
            } else {
                passed_cases = passed_cases +| 1;
                printf("OK\n" as *byte);
            }
            test_i = test_i + 1;
        }
        if program.has_user_main == 0 {
            var assertion_count: i32 = 0;
            if program.test_passed_global_index >= 0 && program.test_passed_global_index < program.global_count {
                assertion_count = program.globals[program.test_passed_global_index].i64_value as i32;
            }
            printf("\n=== Results ===\n" as *byte);
            printf("  Tests Passed:       %d\n" as *byte, passed_cases);
            printf("  Tests Failed:       %d\n" as *byte, failed_cases);
            printf("  Assertions Passed:  %d\n" as *byte, assertion_count);
            return failed_cases;
        }
    }
    var result: ExecValue = exec_make_void();
    if exec_vm_call_function(program, program.entry_function_index, null, 0, trace_vm, &result) != 0 {
        if g_exec_vm_exit_requested != 0 {
            return g_exec_vm_exit_code;
        }
        return 1;
    }
    if g_exec_vm_exit_requested != 0 {
        return g_exec_vm_exit_code;
    }
    if result.kind == ExecValueKind.EXEC_VALUE_I32 ||
        result.kind == ExecValueKind.EXEC_VALUE_I8 ||
        result.kind == ExecValueKind.EXEC_VALUE_I16 ||
        result.kind == ExecValueKind.EXEC_VALUE_ISIZE ||
        result.kind == ExecValueKind.EXEC_VALUE_U8 ||
        result.kind == ExecValueKind.EXEC_VALUE_U16 ||
        result.kind == ExecValueKind.EXEC_VALUE_U32 ||
        result.kind == ExecValueKind.EXEC_VALUE_USIZE ||
        result.kind == ExecValueKind.EXEC_VALUE_BYTE ||
        result.kind == ExecValueKind.EXEC_VALUE_BOOL {
        return result.i64_value as i32;
    }
    return 0;
}
