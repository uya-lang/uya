        out_value[0] = exec_make_usize(len_count);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_MKDIR {
        if arg_count != 2 {
            exec_backend_set_error(function.decl, "exec: mkdir 参数数量非法" as *byte, 0);
            return -1;
