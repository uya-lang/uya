        if arg0 == null || arg1 == null {
            exec_backend_set_error(function.decl, "exec: sprintf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        const written: i32 = exec_format_printf_like(EXEC_FORMAT_TARGET_BUF, -1, null,
            arg0.ptr_value, 0, arg1.ptr_value as &const byte, rest, arg_count -| 2);
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: sprintf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_SNPRINTF_FIXED {
        if arg_count < 3 {
            exec_backend_set_error(function.decl, "exec: snprintf 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        const arg2: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        if arg0 == null || arg1 == null || arg2 == null {
            exec_backend_set_error(function.decl, "exec: snprintf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 3);
        const written: i32 = exec_format_printf_like(EXEC_FORMAT_TARGET_BUF_LIMIT, -1, null,
            arg0.ptr_value, arg1.i64_value as usize, arg2.ptr_value as &const byte, rest, arg_count -| 3);
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: snprintf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    exec_backend_set_error(function.decl, "exec: hostcall 目标非法" as *byte, 0);
    return -1;
}

fn vm_step(program: &BCProgram, frame: &ExecFrame, trace_vm: i32, out_value: &ExecValue) i32 {
    if program == null || frame == null || frame.function == null || out_value == null {
        exec_backend_set_error(null, "exec: vm_step 输入无效" as *byte, 0);
        return -1;
    }
    const function: &BCFunction = frame.function;
    if frame.ip < 0 || frame.ip >= function.instr_count {
        exec_backend_set_error(function.decl, "exec: vm_step 指令指针越界" as *byte, 0);
        return -1;
    }
    const instr: &BCInstr = function.instrs + frame.ip;
    g_exec_dbg_cur_op = instr.opcode as i32;
    // 条件前移：trace 关掉时这里是每条指令一次的纯函数调用开销
    // （函数体只有 `if trace_vm == 0 { return; }`，perf 上仍占 ~2%）。
    if trace_vm != 0 {
        exec_vm_trace(trace_vm, function.name, frame.ip, instr);
    }
    const slot_a: &ExecValue = exec_vm_slot_ref(frame, instr.a);
    const slot_b: &ExecValue = exec_vm_slot_ref(frame, instr.b);
    const slot_c: &ExecValue = exec_vm_slot_ref(frame, instr.c);
    if instr.opcode == BCOpcode.BC_LOAD_CONST {
        if slot_a == null {
            exec_backend_set_error(function.decl, "exec: LOAD_CONST 槽位越界" as *byte, 0);
            return -1;
        }
        if exec_vm_load_const(program, function, instr.imm as i32, slot_a) != 0 {
            return -1;
        }
    } else if instr.opcode == BCOpcode.BC_LOAD_LOCAL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: LOAD_LOCAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot_shallow(slot_a, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_LOAD_GLOBAL {
        const global_slot: &ExecValue = exec_vm_global_ref(program, instr.b);
        if slot_a == null || global_slot == null {
            exec_backend_set_error(function.decl, "exec: LOAD_GLOBAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot_shallow(slot_a, global_slot[0]);
    } else if instr.opcode == BCOpcode.BC_STORE_LOCAL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: STORE_LOCAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_STORE_GLOBAL {
        const global_slot2: &ExecValue = exec_vm_global_ref(program, instr.a);
        if global_slot2 == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: STORE_GLOBAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(global_slot2, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_MOV {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: MOV 槽位越界" as *byte, 0);
            return -1;
        }
        exec_vm_store_slot(slot_a, slot_b[0]);
    } else if instr.opcode == BCOpcode.BC_ADDR_LOCAL {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ADDR_LOCAL 槽位越界" as *byte, 0);
            return -1;
        }
        exec_value_mark_ref_holder(slot_b);
        slot_a[0] = exec_vm_make_value_ref(slot_b, instr.c);
    } else if instr.opcode == BCOpcode.BC_ADDR_GLOBAL {
        const global_slot3: &ExecValue = exec_vm_global_ref(program, instr.b);
        if slot_a == null || global_slot3 == null {
            exec_backend_set_error(function.decl, "exec: ADDR_GLOBAL 槽位越界" as *byte, 0);
            return -1;
        }
        slot_a[0] = exec_vm_make_value_ref(global_slot3, instr.c);
    } else if instr.opcode == BCOpcode.BC_ADDR_FIELD {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: ADDR_FIELD 槽位越界" as *byte, 0);
            return -1;
        }
        const addr_native_kind: i32 = (instr.c >> 8) & 0xFF;
        const addr_native_base: usize = exec_vm_field_native_base(slot_b);
        if addr_native_kind > 0 && addr_native_base != 0 as usize {
            const addr_offset: usize = ((instr.imm >> 32) as i32) as usize;
            // 定长数组字段在 C 里按下标访问时退化成「指向元素」：编译期把元素 kind
            // 放在 c 的 16..23 位，这里**只在基址确实是原生内存时**才覆盖 pointee。
            // VM 聚合结构（局部变量）走不到这里，语义不受影响。
            var addr_pointee_kind: i32 = instr.c & 0xFF;
            const addr_elem_kind: i32 = (instr.c >> 16) & 0xFF;
            if addr_elem_kind > 0 && (addr_native_kind - 1 == TypeKind.TYPE_ARRAY as i32 ||
                addr_native_kind - 1 == TypeKind.TYPE_SLICE as i32) {
                addr_pointee_kind = addr_elem_kind;
            }
            slot_a[0] = exec_make_pointer_with_kind(addr_native_base +| addr_offset, addr_pointee_kind);
            frame.ip = frame.ip + 1;
            return 0;
        }
        const field_ref: &ExecValue = exec_vm_field_ref(slot_b, instr.imm as i32);
        // 聚合路径给出 VOID 字段时也算「没找到」：原生聚合的大结构体字段必须
        // 再试一次 relaxed 原生基址（与 BC_LOAD_FIELD 同一处修复，见那里的注释）。
        const af_ref_is_void: i32 = (field_ref != null &&
            field_ref[0].kind == ExecValueKind.EXEC_VALUE_VOID) as i32;
        if (field_ref == null || af_ref_is_void != 0) && addr_native_kind > 0 && addr_native_base == 0 as usize {
            const af_relaxed: usize = exec_vm_field_native_base_relaxed(slot_b);
            if af_relaxed != 0 as usize {
                var af_relaxed_pointee: i32 = instr.c & 0xFF;
                const af_relaxed_elem: i32 = (instr.c >> 16) & 0xFF;
                if af_relaxed_elem > 0 && (addr_native_kind - 1 == TypeKind.TYPE_ARRAY as i32 ||
                    addr_native_kind - 1 == TypeKind.TYPE_SLICE as i32) {
                    af_relaxed_pointee = af_relaxed_elem;
                }
                const af_relaxed_offset: usize = ((instr.imm >> 32) as i32) as usize;
                slot_a[0] = exec_make_pointer_with_kind(af_relaxed +| af_relaxed_offset,
                    af_relaxed_pointee);
                frame.ip = frame.ip + 1;
                return 0;
            }
        }
        if field_ref == null {
            var af_msg: [byte: 512] = [];
            var af_isref: i32 = -1;
            var af_target_kind: i32 = -1;
            var af_pointee: i32 = -1;
            if slot_b.kind == ExecValueKind.EXEC_VALUE_POINTER {
                af_isref = exec_vm_pointer_is_internal_ref(slot_b);
                af_pointee = exec_value_pointer_pointee_kind(&slot_b[0]);
                const af_target: &ExecValue = exec_vm_ref_target_value(slot_b);
                if af_target != null {
                    af_target_kind = af_target.kind as i32;
                }
            }
            _ = snprintf(&af_msg[0] as *byte, 512,
                "exec: ADDR_FIELD 字段越界(fn=%s ip=%d slot=%d kind=%d idx=%d nk=%d nb=%zx isref=%d pointee=%d tgt=%d addr=%zx res=%d line=%d col=%d)" as *byte,
                function.name as *byte, frame.ip, instr.b, slot_b.kind as i32,
                instr.imm as i32, addr_native_kind, addr_native_base, af_isref, af_pointee,
                af_target_kind, exec_vm_pointer_address(slot_b),
                exec_vm_address_is_vm_resident(exec_vm_pointer_address(slot_b)),
                instr.source.line, instr.source.column);
            exec_backend_set_error(function.decl, &af_msg[0] as &byte, 0);
            return -1;
        }
        exec_value_mark_ref_holder(slot_b);
        slot_a[0] = exec_vm_make_value_ref(field_ref, instr.c & 0xFF);
    } else if instr.opcode == BCOpcode.BC_ADDR_INDEX {
        if slot_a == null || slot_b == null || slot_c == null {
            exec_backend_set_error(function.decl, "exec: ADDR_INDEX 槽位越界" as *byte, 0);
            return -1;
        }
        var handled_raw_addr: i32 = 0;
        if exec_value_is_raw_array(slot_b) != 0 {
            const ai_elem_kind: i32 = exec_value_raw_array_element_kind(slot_b);
            const ai_is_agg: i32 = (ai_elem_kind == TypeKind.TYPE_STRUCT as i32 ||
                ai_elem_kind == TypeKind.TYPE_UNION as i32 ||
                ai_elem_kind == TypeKind.TYPE_TUPLE as i32 ||
                ai_elem_kind == TypeKind.TYPE_ARRAY as i32) as i32;
            if ai_is_agg != 0 && slot_c.i64_value >= 0 && instr.imm > 0 {
                // 同上（LOAD_INDEX）：聚合元素按指令 imm 的字节步长取址，返回指向元素的指针。
                const ai_base: usize = @usize_from_ptr(slot_b.ptr_value as &void);
                const ai_addr: usize = ai_base +| ((slot_c.i64_value as usize) *| (instr.imm as usize));
                slot_a[0] = exec_make_pointer_with_kind(ai_addr, ai_elem_kind);
                handled_raw_addr = 1;
            }
            const raw_ptr_value: ExecValue = exec_vm_raw_array_element_ptr(slot_b, slot_c.i64_value as i32);
            if handled_raw_addr == 0 && raw_ptr_value.kind != ExecValueKind.EXEC_VALUE_POINTER {
                var _aim: [byte: 512] = [];
                _ = snprintf(&_aim[0] as *byte, 512,
                    "exec: ADDR_INDEX 越界(fn=%s ip=%d idx=%lld cnt=%d ek=%d imm=%d line=%d col=%d)" as *byte,
                    function.name as *byte, frame.ip, slot_c.i64_value,
                    slot_b.i64_value as i32, exec_value_raw_array_element_kind(slot_b),
                    instr.imm as i32, instr.source.line, instr.source.column);
                exec_backend_set_error(function.decl, &_aim[0] as &byte, 0);
                return -1;
            }
            if handled_raw_addr == 0 {
                slot_a[0] = raw_ptr_value;
                handled_raw_addr = 1;
            }
        } else if exec_value_is_raw_slice(slot_b) != 0 {
            const raw_slice_ptr_value: ExecValue = exec_vm_raw_slice_element_ptr(slot_b, slot_c.i64_value as i32, 0);
            if raw_slice_ptr_value.kind != ExecValueKind.EXEC_VALUE_POINTER {
                var _aim2: [byte: 512] = [];
                _ = snprintf(&_aim2[0] as *byte, 512,
                    "exec: ADDR_INDEX 越界(RAWSLC fn=%s ip=%d idx=%lld line=%d col=%d)" as *byte,
                    function.name as *byte, frame.ip, slot_c.i64_value, instr.source.line, instr.source.column);
                exec_backend_set_error(function.decl, &_aim2[0] as &byte, 0);
                return -1;
            }
            slot_a[0] = raw_slice_ptr_value;
            handled_raw_addr = 1;
        } else if slot_b.kind == ExecValueKind.EXEC_VALUE_STRING {
            // `&"abc"[i]` / `&GREETING[i]`：字符串常量的数据指针在 i64_value 里。
            const str_base: usize = slot_b.i64_value as usize;
            const str_index: i64 = slot_c.i64_value;
            if str_base != 0 && str_index >= 0 {
                slot_a[0] = exec_make_pointer_with_kind(str_base +| (str_index as usize), TypeKind.TYPE_BYTE as i32);
                handled_raw_addr = 1;
            }
        } else if slot_b.kind == ExecValueKind.EXEC_VALUE_POINTER &&
            exec_vm_pointer_is_internal_ref(slot_b) == 0 {
            // 原生指针算术：`&p[i]` 就是 `p + i * elem_size`（`slice.ptr` / `@ptr_from_usize` 来的指针）。
            const plain_elem_ptr: ExecValue = exec_vm_pointer_element_ptr(function, slot_b[0], slot_c.i64_value,
                (instr.imm >> 32) as usize);
            if plain_elem_ptr.kind == ExecValueKind.EXEC_VALUE_POINTER {
                slot_a[0] = plain_elem_ptr;
                handled_raw_addr = 1;
            }
        } else if exec_vm_pointer_is_internal_ref(slot_b) != 0 {
            const base_target: &ExecValue = exec_vm_ref_target_value(slot_b);
            if exec_value_is_raw_array(base_target) != 0 {
                const raw_ptr_value2: ExecValue = exec_vm_raw_array_element_ptr(base_target, slot_c.i64_value as i32);
                if raw_ptr_value2.kind != ExecValueKind.EXEC_VALUE_POINTER {
                    var _aim3: [byte: 512] = [];
                    _ = snprintf(&_aim3[0] as *byte, 512,
                        "exec: ADDR_INDEX 越界(REFARR fn=%s ip=%d idx=%lld cnt=%d ek=%d line=%d col=%d)" as *byte,
                        function.name as *byte, frame.ip, slot_c.i64_value,
                        base_target.i64_value as i32, exec_value_raw_array_element_kind(base_target),
                        instr.source.line, instr.source.column);
                    exec_backend_set_error(function.decl, &_aim3[0] as &byte, 0);
                    return -1;
                }
                slot_a[0] = raw_ptr_value2;
                handled_raw_addr = 1;
            } else if exec_value_is_raw_slice(base_target) != 0 {
                const raw_slice_ptr_value2: ExecValue = exec_vm_raw_slice_element_ptr(base_target, slot_c.i64_value as i32, 0);
                if raw_slice_ptr_value2.kind != ExecValueKind.EXEC_VALUE_POINTER {
                    exec_backend_set_error(function.decl, "exec: ADDR_INDEX 越界" as *byte, 0);
                    return -1;
                }
                slot_a[0] = raw_slice_ptr_value2;
                handled_raw_addr = 1;
            } else if exec_value_is_pointer_like(base_target[0]) != 0 {
                const ptr_index_value: ExecValue = exec_vm_pointer_element_ptr(function, base_target[0], slot_c.i64_value,
                    (instr.imm >> 32) as usize);
                if ptr_index_value.kind != ExecValueKind.EXEC_VALUE_POINTER {
                    return -1;
                }
                slot_a[0] = ptr_index_value;
                handled_raw_addr = 1;
            }
        }
        if handled_raw_addr == 0 {
            const index_ref: &ExecValue = exec_vm_index_ref(slot_b, slot_c.i64_value as i32);
            if index_ref == null {
                // 聚合分配失败会把 VOID 当成合法值交出来，之后在这里取地址就
                // 变成「下标越界」。看到失败计数非零就直接说真正原因，别让
                // `ADDR_INDEX 越界(IDXREF …)` 把「内存不够」伪装成类型问题。
                if exec_value_alloc_failure_count() > 0 {
                    var _aimfa: [byte: 512] = [];
                    _ = snprintf(&_aimfa[0] as *byte, 512,
                        "exec: 聚合分配失败（地址空间不足）fn=%s ip=%d line=%d col=%d 失败次数=%lld" as *byte,
                        function.name as *byte, frame.ip,
                        instr.source.line, instr.source.column,
                        exec_value_alloc_failure_count());
                    exec_backend_set_error(function.decl, &_aimfa[0] as &byte, 0);
                    return -1;
                }
                var _aim4: [byte: 512] = [];
                const _agg4: &ExecAggregate = exec_vm_aggregate_ref_from_value(slot_b);
                _ = snprintf(&_aim4[0] as *byte, 512,
                    "exec: ADDR_INDEX 越界(IDXREF fn=%s ip=%d idx=%lld kind=%d cnt=%d isref=%d pointee=%d line=%d col=%d)" as *byte,
                    function.name as *byte, frame.ip, slot_c.i64_value, slot_b.kind as i32,
                    if _agg4 == null { 0 - 1; } else { _agg4.count },
                    exec_vm_pointer_is_internal_ref(slot_b),
                    if slot_b.kind == ExecValueKind.EXEC_VALUE_POINTER { exec_value_pointer_pointee_kind(&slot_b[0]); } else { 0 - 1; },
                    instr.source.line, instr.source.column);
                exec_backend_set_error(function.decl, &_aim4[0] as &byte, 0);
                return -1;
            }
            exec_value_mark_ref_holder(slot_b);
            slot_a[0] = exec_vm_make_index_value_ref(index_ref, instr.imm as i32);
        }
    } else if instr.opcode == BCOpcode.BC_BOX_VALUE {
        if slot_a == null || slot_b == null {
            exec_backend_set_error(function.decl, "exec: BOX_VALUE 槽位越界" as *byte, 0);
            return -1;
        }
        const boxed_by_alloc: ExecValue = exec_vm_box_value_ref_via_allocator(program, slot_b[0], instr.c);
        if boxed_by_alloc.kind == ExecValueKind.EXEC_VALUE_POINTER &&
            exec_vm_pointer_address(&boxed_by_alloc) != 0 as usize {
            slot_a[0] = boxed_by_alloc;
        } else {
            slot_a[0] = exec_vm_box_value_ref(slot_b[0], instr.c);
        }
    } else if (instr.opcode == BCOpcode.BC_ADD || instr.opcode == BCOpcode.BC_SUB ||
        instr.opcode == BCOpcode.BC_MUL || instr.opcode == BCOpcode.BC_DIV ||
        instr.opcode == BCOpcode.BC_REM || instr.opcode == BCOpcode.BC_BIT_AND ||
        instr.opcode == BCOpcode.BC_BIT_OR || instr.opcode == BCOpcode.BC_BIT_XOR) &&
        slot_a != null && slot_b != null && slot_c != null &&
        slot_b.kind == ExecValueKind.EXEC_VALUE_VECTOR {
        const vec_bin: ExecValue = exec_vm_vector_binary(instr.opcode as i32, slot_b[0], slot_c[0]);
        if vec_bin.kind != ExecValueKind.EXEC_VALUE_VECTOR {
            exec_backend_set_error(function.decl, "exec: 向量算术失败" as *byte, 0);
            return -1;
        }
        slot_a[0] = vec_bin;
    } else if (instr.opcode == BCOpcode.BC_BIT_AND || instr.opcode == BCOpcode.BC_BIT_OR ||
        instr.opcode == BCOpcode.BC_BIT_XOR) &&
        slot_a != null && slot_b != null && slot_c != null &&
        slot_b.kind == ExecValueKind.EXEC_VALUE_MASK {
        var mask_out_bits: i64 = 0;
        if instr.opcode == BCOpcode.BC_BIT_AND {
            mask_out_bits = slot_b.i64_value & slot_c.i64_value;
        } else if instr.opcode == BCOpcode.BC_BIT_OR {
            mask_out_bits = slot_b.i64_value | slot_c.i64_value;
        } else {
            mask_out_bits = slot_b.i64_value ^ slot_c.i64_value;
        }
        var mask_out: ExecValue = exec_make_mask_value(exec_value_vector_lanes(slot_b));
        mask_out.i64_value = mask_out_bits;
        slot_a[0] = mask_out;
    } else if (instr.opcode == BCOpcode.BC_SHL || instr.opcode == BCOpcode.BC_SHR) &&
        slot_a != null && slot_b != null && slot_c != null &&
        slot_b.kind == ExecValueKind.EXEC_VALUE_VECTOR {
        const sh_lanes: i32 = exec_value_vector_lanes(slot_b);
        const sh_kind: i32 = exec_value_vector_elem_kind(slot_b);
        const sh_ldata: &byte = exec_value_vector_data(slot_b);
        const sh_right_is_vec: i32 = (slot_c.kind == ExecValueKind.EXEC_VALUE_VECTOR) as i32;
        const sh_rdata: &byte = exec_value_vector_data(slot_c);
        const sh_scalar: i64 = slot_c.i64_value;
        var sh_out: ExecValue = exec_make_vector(sh_kind, sh_lanes);
        const sh_odata: &byte = exec_value_vector_data(&sh_out);
        if sh_odata == null {
            exec_backend_set_error(function.decl, "exec: 向量移位分配失败" as *byte, 0);
            return -1;
        }
        var shi: i32 = 0;
        while shi < sh_lanes {
            const sh_lb: i64 = exec_vector_lane_bits(sh_ldata, sh_kind, shi);
            var sh_rb: i64 = sh_scalar;
            if sh_right_is_vec != 0 {
                sh_rb = exec_vector_lane_bits(sh_rdata, sh_kind, shi);
            }
            var sh_res: i64 = 0;
            if instr.opcode == BCOpcode.BC_SHL {
                sh_res = sh_lb << (sh_rb as i32);
            } else {
                sh_res = sh_lb >> (sh_rb as i32);
            }
            exec_vector_set_lane_bits(sh_odata, sh_kind, shi, sh_res);
            shi = shi + 1;
        }
        slot_a[0] = sh_out;
    } else if (instr.opcode == BCOpcode.BC_NEG || instr.opcode == BCOpcode.BC_NOT) &&
        slot_a != null && slot_b != null && slot_b.kind == ExecValueKind.EXEC_VALUE_VECTOR {
        const un_lanes: i32 = exec_value_vector_lanes(slot_b);
        const un_kind: i32 = exec_value_vector_elem_kind(slot_b);
        const un_src: &byte = exec_value_vector_data(slot_b);
        var un_out: ExecValue = exec_make_vector(un_kind, un_lanes);
        const un_dst: &byte = exec_value_vector_data(&un_out);
        if un_dst == null {
            exec_backend_set_error(function.decl, "exec: 向量一元运算分配失败" as *byte, 0);
            return -1;
        }
        const un_is_f32: i32 = (un_kind == TypeKind.TYPE_F32 as i32) as i32;
        const un_is_float: i32 = (un_is_f32 != 0 || un_kind == TypeKind.TYPE_F64 as i32) as i32;
        var uni: i32 = 0;
        while uni < un_lanes {
            const un_bits: i64 = exec_vector_lane_bits(un_src, un_kind, uni);
            var un_res: i64 = 0;
            if instr.opcode == BCOpcode.BC_NOT {
                un_res = ~un_bits;
            } else if un_is_float != 0 {
                if un_is_f32 != 0 {
                    un_res = exec_f32_to_bits(-(exec_f32_from_bits(un_bits as u32))) as i64;
                } else {
                    un_res = exec_f64_to_bits(-(exec_f64_from_bits(un_bits as u64))) as i64;
                }
            } else {
                un_res = 0 -| un_bits;
            }
            exec_vector_set_lane_bits(un_dst, un_kind, uni, un_res);
            uni = uni + 1;
        }
        slot_a[0] = un_out;
    } else if instr.opcode == BCOpcode.BC_NOT &&
        slot_a != null && slot_b != null && slot_b.kind == ExecValueKind.EXEC_VALUE_MASK {
        var not_mask: ExecValue = exec_make_mask_value(exec_value_vector_lanes(slot_b));
        not_mask.i64_value = ~slot_b.i64_value;
