        }
        const th_value: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const th_slot: i32 = exec_vm_thread_slot_of(th_value);
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CREATE {
            var free_slot: i32 = -1;
