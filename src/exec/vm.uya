        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        const arg1: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        if arg0 == null || arg1 == null {
            exec_backend_set_error(function.decl, "exec: fprintf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 2);
        const vm_fd: i32 = exec_vm_file_fd_from_value(arg0);
        var written: i32 = -1;
        if vm_fd >= 0 {
            written = exec_format_printf_like(EXEC_FORMAT_TARGET_FD, vm_fd, null, null, 0,
                arg1.ptr_value as &const byte, rest, arg_count -| 2);
        } else {
            written = exec_format_printf_like(EXEC_FORMAT_TARGET_FILE, -1, arg0.ptr_value as &FILE,
                null, 0, arg1.ptr_value as &const byte, rest, arg_count -| 2);
        }
        if written < 0 {
            exec_backend_set_error(function.decl, "exec: fprintf 格式化失败（不支持的格式或不完整实参）" as *byte, 0);
            return -1;
        }
        out_value[0] = exec_make_i32(written);
        return 0;
    }
    if site.id == ExecHostCallId.EXEC_HOST_CALL_PRINTF_FIXED {
        if arg_count < 1 {
            exec_backend_set_error(function.decl, "exec: printf 参数数量非法" as *byte, 0);
            return -1;
        }
        const arg0: &ExecValue = exec_vm_slot_ref(frame, arg_base);
        if arg0 == null {
            exec_backend_set_error(function.decl, "exec: printf 参数槽位非法" as *byte, 0);
            return -1;
        }
        const rest: &ExecValue = exec_vm_slot_ref(frame, arg_base +| 1);
        // 与 @print 保持一致：写 libc.stdout（Uya stdio 实现，带行缓冲），
        // 避免宿主 fd 写入与缓冲输出交错导致与 C99 后端顺序不一致。
        const written: i32 = exec_format_printf_like(EXEC_FORMAT_TARGET_FILE, -1, libc.stdout, null, 0,
