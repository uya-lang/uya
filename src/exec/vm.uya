            out_value[0] = exec_make_i32(0);
            return 0;
        }
        if site.id == ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_INIT {
            const ca_clock: &ExecValue = exec_vm_field_ref_store(exec_vm_slot_ref(frame, arg_base), 0);
