            // 名与值都按固定顺序排列，直接按 `struct_init_field_count` 内联构造。
            if expr.struct_init_field_count > 0 && expr.struct_init_field_values != null {
                const synth_items: & & HIRExpr = exec_lower_alloc_items(ctx, expr.struct_init_field_count);
                if synth_items == null {
                    exec_backend_set_error(expr, "exec: struct items 分配失败" as *byte, 0);
                    return null;
                }
                var sfi: i32 = 0;
                while sfi < expr.struct_init_field_count {
                    const sv: &ASTNode = exec_lower_unwrap_typed_init(expr.struct_init_field_values[sfi]);
                    const se: &HIRExpr = exec_lower_expr(ctx, sv);
                    if se == null {
                        return null;
