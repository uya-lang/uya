                    exec_lower_pop_scope(ctx);
                } else if arm_union.kind == MatchPatternKind.MATCH_PAT_BIND &&
                    arm_union.var_name != null && str_equals(arm_union.var_name, "_" as *byte) == 0 {
                    // 绑定臂：把整个 union 值绑定到变量后无条件进入分支。
                    if exec_lower_push_scope(ctx, arm_union.result_expr, -1) == 0 {
                        return null;
                    }
                    bind_slot = exec_lower_append_local(ctx, null, arm_union.var_name, &subject_type, 0);
                    if bind_slot < 0 {
                        exec_lower_pop_scope(ctx);
                        exec_backend_set_error(expr, "exec: union match 绑定槽位不足" as *byte, 0);
                        return null;
                    }
                    arm_result_expr2 = exec_lower_match_arm_value(ctx, &arm_union, match_is_void, &arm_result_block2);
                    exec_lower_pop_scope(ctx);
                } else {
                    arm_result_expr2 = exec_lower_match_arm_value(ctx, &arm_union, match_is_void, &arm_result_block2);
                }
                if arm_result_expr2 == null {
                    return null;
                }
                arms_union[umi] = HIRMatchArm {
                    kind: arm_union.kind,
                    int_value: variant_index2 as i64,
                    bool_value: 0,
                    bind_local_slot: bind_slot,
                    result_block: arm_result_block2,
                    result_expr: arm_result_expr2,
                };
                umi = umi + 1;
            }
            const hir_union_match: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_MATCH, &expr_type);
            if hir_union_match == null {
                return null;
            }
            hir_union_match.left = subject_expr;
            hir_union_match.match_arms = arms_union;
            hir_union_match.match_arm_count = expr.match_expr_arm_count;
            return hir_union_match;
        }
        if subject_type.kind == TypeKind.TYPE_ERROR_UNION {
            return exec_lower_error_union_match_expr(ctx, expr, subject_expr, subject_type, match_is_void);
        }
        if exec_type_is_scalar_supported(subject_type) == 0 {
            return exec_lower_fail_expr_reason(expr, "exec: 当前仅支持标量 match" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
        }
        const arms: &HIRMatchArm = compiler_arena_alloc(ctx.arena, @size_of(HIRMatchArm) * expr.match_expr_arm_count as usize) as &HIRMatchArm;
        if arms == null {
            exec_backend_set_error(expr, "exec: match arms 分配失败" as *byte, 0);
            return null;
        }
        var mi: i32 = 0;
        while mi < expr.match_expr_arm_count {
            const arm: ASTMatchArm = expr.match_expr_arms[mi];
            if arm.kind != MatchPatternKind.MATCH_PAT_LITERAL &&
                arm.kind != MatchPatternKind.MATCH_PAT_ENUM &&
                arm.kind != MatchPatternKind.MATCH_PAT_BIND &&
                arm.kind != MatchPatternKind.MATCH_PAT_ELSE &&
                arm.kind != MatchPatternKind.MATCH_PAT_WILDCARD {
                return exec_lower_fail_expr_reason(expr, "exec: 当前仅支持 literal/枚举/绑定/else/wildcard match" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
            }
            var pattern_value: i64 = arm.literal_int_value as i64;
            if arm.kind == MatchPatternKind.MATCH_PAT_ENUM {
                const variant_value: i32 = exec_lower_enum_variant_value(ctx, arm.enum_name, arm.variant_name);
                if variant_value < 0 {
                    return exec_lower_fail_expr_reason(expr, "exec: match 枚举变体数值无效" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
                }
                pattern_value = variant_value as i64;
            }
            var bind_slot: i32 = -1;
            var arm_scope_pushed: i32 = 0;
            if arm.kind == MatchPatternKind.MATCH_PAT_BIND && arm.var_name != null &&
                str_equals(arm.var_name, "_" as *byte) == 0 {
                if exec_lower_push_scope(ctx, arm.result_expr, -1) == 0 {
                    return null;
                }
                arm_scope_pushed = 1;
                bind_slot = exec_lower_append_local(ctx, null, arm.var_name, &subject_type, 0);
                if bind_slot < 0 {
                    exec_lower_pop_scope(ctx);
                    exec_backend_set_error(expr, "exec: match 绑定槽位不足" as *byte, 0);
                    return null;
                }
            }
            var arm_result_block: &HIRBlock = null;
            var arm_result_expr: &HIRExpr = null;
            arm_result_expr = exec_lower_match_arm_value(ctx, &arm, match_is_void, &arm_result_block);
            if arm_scope_pushed != 0 {
                exec_lower_pop_scope(ctx);
            }
            if arm_result_expr == null {
                return null;
            }
            arms[mi] = HIRMatchArm {
                kind: arm.kind,
                int_value: pattern_value,
                bool_value: arm.literal_is_bool,
                bind_local_slot: bind_slot,
                result_block: arm_result_block,
                result_expr: arm_result_expr,
            };
            mi = mi + 1;
        }
        const hir_match: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_MATCH, &expr_type);
        if hir_match == null {
            return null;
        }
        hir_match.left = subject_expr;
        hir_match.match_arms = arms;
        hir_match.match_arm_count = expr.match_expr_arm_count;
        return hir_match;
    }
    if expr.type == ASTNodeType.AST_BLOCK {
        return exec_lower_block_expr(ctx, expr, &expr_type);
    }
    if expr.type == ASTNodeType.AST_ASM {
        return exec_lower_fail_expr_reason(expr, "exec: 当前不支持 inline asm" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_ASM);
    }
    if expr.type == ASTNodeType.AST_PARAMS {
        return exec_lower_params_tuple_expr(ctx, expr, &expr_type);
    }
    if expr.type == ASTNodeType.AST_AWAIT_EXPR && expr.await_expr_operand != null {
        // `@await f`：VM 里 async 函数同步执行到完成，所以只需要从 Future 的
        // `state: Poll<T>` 里取出 Ready 载荷（builder 发 BC_AWAIT）。
        const await_operand: &HIRExpr = exec_lower_expr(ctx, expr.await_expr_operand);
        if await_operand == null {
            return null;
        }
        const hir_await: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_AWAIT, &expr_type);
        if hir_await == null {
            return null;
        }
        hir_await.left = await_operand;
        return hir_await;
    }
    var unsupported_expr_msg: [byte: 128] = [];
    _ = snprintf(&unsupported_expr_msg[0] as *byte, 128, "exec: 尚未支持的表达式节点(type=%d)" as *byte, expr.type as i32);
    if expr.type == ASTNodeType.AST_MC_SOURCE {
        // C99 侧对未被宏展开替换的 @mc_source 发射空字符串，exec 保持一致。
        return exec_lower_make_string_const_expr(ctx, expr, &expr_type, "" as &byte);
    }
    if expr.type == ASTNodeType.AST_ASSIGN {
        // 赋值表达式（(x = 1) != 0）：与赋值语句共用目标/取值的 lowering 规则。
        if expr.assign_dest == null || expr.assign_src == null {
            return exec_lower_fail_expr(expr, "exec: 赋值表达式缺少目标或值" as *byte);
        }
        if expr.assign_dest.type == ASTNodeType.AST_UNDERSCORE {
            return exec_lower_fail_expr(expr, "exec: 不支持把 `_ =` 用作表达式" as *byte);
        }
        const assign_dest_expr: &HIRExpr = exec_lower_make_dest_expr(ctx, expr.assign_dest);
        if assign_dest_expr == null {
            return null;
        }
        const assign_value_expr: &HIRExpr = exec_lower_coerce_expr(ctx, expr.assign_src, &assign_dest_expr.type_ref.type);
        if assign_value_expr == null {
            return null;
        }
        const hir_assign_expr: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_ASSIGN, &expr_type);
        if hir_assign_expr == null {
            return null;
        }
        hir_assign_expr.left = assign_dest_expr;
        hir_assign_expr.right = assign_value_expr;
        return hir_assign_expr;
    }
    if expr.type == ASTNodeType.AST_IF_STMT {
        // if 表达式：分支取值为块尾表达式（checker 提供统一取值规则）。
        if expr.if_stmt_condition == null || expr.if_stmt_then_branch == null || expr.if_stmt_else_branch == null {
            return exec_lower_fail_expr(expr, "exec: if 表达式缺少条件或分支" as *byte);
        }
        const if_cond_expr: &HIRExpr = exec_lower_expr(ctx, expr.if_stmt_condition);
        if if_cond_expr == null {
            return null;
        }
        const then_value_node: &ASTNode = checker_if_expr_branch_value_node(expr.if_stmt_then_branch);
        if then_value_node == null {
            return exec_lower_fail_expr(expr, "exec: if 表达式 then 分支没有值" as *byte);
        }
        var then_value_expr: &HIRExpr = null;
        if exec_lower_node_is_jump_stmt(then_value_node) != 0 {
            const then_block: &ASTNode = exec_lower_single_stmt_block(ctx, then_value_node);
            if then_block == null {
                return null;
            }
            then_value_expr = exec_lower_block_expr(ctx, then_block, &expr_type);
        } else {
            then_value_expr = exec_lower_coerce_expr(ctx, then_value_node, &expr_type);
        }
        if then_value_expr == null {
            return null;
        }
        const else_value_node: &ASTNode = checker_if_expr_branch_value_node(expr.if_stmt_else_branch);
        if else_value_node == null {
            return exec_lower_fail_expr(expr, "exec: if 表达式 else 分支没有值" as *byte);
        }
        var else_value_expr: &HIRExpr = null;
        if exec_lower_node_is_jump_stmt(else_value_node) != 0 {
            const else_block: &ASTNode = exec_lower_single_stmt_block(ctx, else_value_node);
            if else_block == null {
                return null;
            }
            else_value_expr = exec_lower_block_expr(ctx, else_block, &expr_type);
        } else {
            else_value_expr = exec_lower_coerce_expr(ctx, else_value_node, &expr_type);
        }
        if else_value_expr == null {
            return null;
        }
        const if_items: & & HIRExpr = exec_lower_alloc_items(ctx, 1);
        if if_items == null {
            return null;
        }
        if_items[0] = else_value_expr;
        const hir_if_expr: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_IF, &expr_type);
        if hir_if_expr == null {
            return null;
        }
        hir_if_expr.left = if_cond_expr;
        hir_if_expr.right = then_value_expr;
        hir_if_expr.items = if_items;
        hir_if_expr.item_count = 1;
        return hir_if_expr;
    }
    return exec_lower_fail_expr(expr, &unsupported_expr_msg[0]);
}

/// `const (a, _, c) = (10, 20, 30);`：右值先降到临时局部，再逐项按元组下标取元素绑定名字。
///
/// 参数：`ctx` lowering 上下文；`stmt_node` 是 `AST_DESTRUCTURE_DECL`。
/// 返回值：包住这些初始化语句的 `HIR_STMT_BLOCK`；失败返回 null（已设置错误）。
fn exec_lower_make_destructure_stmt(ctx: &ExecLowerContext, stmt_node: &ASTNode) &HIRStmt {
    if ctx == null || stmt_node == null || stmt_node.destructure_decl_init == null ||
        stmt_node.destructure_decl_names == null || stmt_node.destructure_decl_name_count <= 0 {
        exec_backend_set_error(stmt_node, "exec: 解构声明缺少右值或名字" as *byte, 0);
        return null;
    }
    const init_type: Type = exec_lower_expr_type(ctx, stmt_node.destructure_decl_init);
    if init_type.kind != TypeKind.TYPE_TUPLE || init_type.tuple_element_types == null {
        exec_backend_set_error(stmt_node, "exec: 目前只支持元组解构" as *byte, 0);
        return null;
    }
    var bind_count: i32 = 0;
    var k: i32 = 0;
    while k < stmt_node.destructure_decl_name_count {
        const name_k: &byte = stmt_node.destructure_decl_names[k];
        if name_k != null && str_equals(name_k, "_" as &byte) == 0 && k < init_type.tuple_count {
            bind_count = bind_count +| 1;
        }
        k = k + 1;
    }
    const inner: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, bind_count +| 1);
    if inner == null {
        return null;
    }
    var temp_name_buf: [byte: 48] = [];
    _ = snprintf(&temp_name_buf[0] as *byte, 48, "@destructure_%d" as *byte, stmt_node.line);
    const temp_slot: i32 = exec_lower_append_local(ctx, stmt_node, &temp_name_buf[0] as &byte, &init_type, 0);
    if temp_slot < 0 {
        exec_backend_set_error(stmt_node, "exec: 解构临时槽位不足" as *byte, 0);
        return null;
    }
    const init_expr: &HIRExpr = exec_lower_coerce_expr(ctx, stmt_node.destructure_decl_init, &init_type);
    if init_expr == null {
        return null;
    }
    const temp_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
    if temp_stmt == null {
        return null;
    }
    temp_stmt.local_slot = temp_slot;
    temp_stmt.expr = init_expr;
    inner.stmts[1] = temp_stmt;
    var out_idx: i32 = 2;
    k = 0;
    while k < stmt_node.destructure_decl_name_count {
        const name: &byte = stmt_node.destructure_decl_names[k];
        if name != null && str_equals(name, "_" as &byte) == 0 && k < init_type.tuple_count {
            var elem_type: Type = copy_type(&init_type.tuple_element_types[k]);
            const slot: i32 = exec_lower_append_local(ctx, stmt_node, name, &elem_type, 0);
            if slot < 0 {
                exec_backend_set_error(stmt_node, "exec: 解构绑定槽位不足" as *byte, 0);
                return null;
            }
            const base_local: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_LOCAL, &init_type);
            if base_local == null {
                return null;
            }
            base_local.local_slot = temp_slot;
            const field_expr: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_FIELD, &elem_type);
            if field_expr == null {
                return null;
            }
            field_expr.left = base_local;
            field_expr.int_value = k as i64;
            const bind_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
            if bind_stmt == null {
                return null;
            }
            bind_stmt.local_slot = slot;
            bind_stmt.expr = field_expr;
            inner.stmts[out_idx] = bind_stmt;
            out_idx = out_idx +| 1;
        }
        k = k + 1;
    }
    const block_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_BLOCK);
    if block_stmt == null {
        return null;
    }
    block_stmt.then_block = inner;
    return block_stmt;
}

/// 按名字找一个在用局部变量的槽位（参数不算，参数不参与 drop）。
/// 参数：`ctx` 上下文；`name` 变量名。
/// 返回值：槽位下标；找不到或该名字是参数返回 -1。
fn exec_lower_find_local_slot_by_name(ctx: &ExecLowerContext, name: &byte) i32 {
    if ctx == null || name == null {
        return -1;
    }
    var i: i32 = 0;
    while i < ctx.active_local_count {
        if ctx.local_names[i] != null && str_equals(ctx.local_names[i], name) != 0 {
            if ctx.local_is_param[i] != 0 {
                return -1;
            }
            return ctx.local_slots[i];
        }
        i = i + 1;
    }
    return -1;
}

/// 递归扫描「按值取走」的表达式，把其中出现的局部变量标记成已移动。
/// 只在构造新值的位置调用（return 表达式、结构体/数组/元组字面量、调用实参），
/// 这样 `return Outer{ inner: inner }` 里的 `inner` 出作用域时不会再 drop 一次。
/// 参数：`ctx` 上下文；`node` 表达式 AST 节点。
/// 返回值：无。
fn exec_lower_mark_moved_locals(ctx: &ExecLowerContext, node: &ASTNode) void {
    if ctx == null || node == null {
        return;
    }
    if node.type == ASTNodeType.AST_IDENTIFIER {
        const slot: i32 = exec_lower_find_local_slot_by_name(ctx, node.identifier_name);
        if slot >= 0 && slot < EXEC_MAX_LOCALS {
            ctx.slot_needs_drop[slot] = 0;
        }
        return;
    }
    if node.type == ASTNodeType.AST_STRUCT_INIT {
        var i: i32 = 0;
        while i < node.struct_init_field_count {
            exec_lower_mark_moved_locals(ctx, node.struct_init_field_values[i]);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_LITERAL {
        var ai: i32 = 0;
        while ai < node.array_literal_element_count {
            exec_lower_mark_moved_locals(ctx, node.array_literal_elements[ai]);
            ai = ai + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_TUPLE_LITERAL {
        var ti: i32 = 0;
        while ti < node.tuple_literal_element_count {
            exec_lower_mark_moved_locals(ctx, node.tuple_literal_elements[ti]);
            ti = ti + 1;
        }
        return;
    }
    // 调用实参不在这里标记：VM 的参数副本本身不参与 drop（和 C99 的按值传参
    // 各有各的 drop 点），把实参标成「已移动」会让资源两边都不释放。
}

fn exec_lower_block(ctx: &ExecLowerContext, block: &ASTNode) &HIRBlock {
    if ctx == null || block == null || block.type != ASTNodeType.AST_BLOCK {
        exec_backend_set_error(block, "exec: block lowering 失败" as *byte, 0);
        return null;
    }
    const hir_block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, block, block.block_stmt_count);
    if hir_block == null {
        return null;
    }
    if exec_lower_push_scope(ctx, block, hir_block.scope_id) == 0 {
        return null;
    }
    var i: i32 = 0;
    while i < block.block_stmt_count {
        const stmt_node: &ASTNode = block.block_stmts[i];
        var stmt: &HIRStmt = null;
        if stmt_node.type == ASTNodeType.AST_VAR_DECL {
            // `var x: T;` 没有初值：按类型给零值（和 C99 侧 uya 的默认初始化一致），
            // 这样 async 状态机里「先声明后赋值」的局部变量也能降级。
            if stmt_node.var_decl_init == null && stmt_node.var_decl_type == null {
                exec_lower_pop_scope(ctx);
                return exec_lower_fail_block(stmt_node, "exec: 未初始化局部变量缺少类型" as *byte);
            }
            var local_type: Type = make_void_type();
            if stmt_node.var_decl_type != null {
                local_type = type_from_ast(ctx.checker, stmt_node.var_decl_type);
            } else {
                local_type = exec_lower_expr_type(ctx, stmt_node.var_decl_init);
            }
            if exec_type_is_vm_value_supported(local_type) == 0 {
                exec_lower_pop_scope(ctx);
                if exec_type_uses_simd(local_type) != 0 {
                    return exec_lower_fail_block_reason(stmt_node, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
                }
                return exec_lower_fail_block(stmt_node, "exec: 当前仅支持 exec VM 可表示的局部变量" as *byte);
            }
            const slot: i32 = exec_lower_append_local(ctx, stmt_node, stmt_node.var_decl_name, &local_type, 0);
            if slot < 0 {
                exec_lower_pop_scope(ctx);
                exec_backend_set_error(stmt_node, "exec: 局部变量槽位不足" as *byte, 0);
                return null;
            }
            var init_expr: &HIRExpr = null;
            if stmt_node.var_decl_init == null {
                init_expr = exec_lower_make_zero_expr(ctx, stmt_node, &local_type);
            } else {
                init_expr = exec_lower_coerce_expr(ctx, stmt_node.var_decl_init, &local_type);
            }
            if init_expr == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt.local_slot = slot;
            stmt.expr = init_expr;
        } else if stmt_node.type == ASTNodeType.AST_DESTRUCTURE_DECL {
            stmt = exec_lower_make_destructure_stmt(ctx, stmt_node);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
        } else if stmt_node.type == ASTNodeType.AST_ASSIGN {
            if stmt_node.assign_dest != null && stmt_node.assign_dest.type == ASTNodeType.AST_UNDERSCORE {
                // `_ = expr;` keeps RHS side effects and explicitly discards the value.
                const discard_expr: &HIRExpr = exec_lower_expr(ctx, stmt_node.assign_src);
                if discard_expr == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_EXPR);
                if stmt == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                stmt.expr = discard_expr;
            } else {
                const assign_target: &HIRExpr = exec_lower_make_dest_expr(ctx, stmt_node.assign_dest);
                if assign_target == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                const value_expr: &HIRExpr = exec_lower_coerce_expr(ctx, stmt_node.assign_src, &assign_target.type_ref.type);
                if value_expr == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_ASSIGN);
                if stmt == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                if assign_target.kind == HIRExprKind.HIR_EXPR_LOCAL {
                    stmt.local_slot = assign_target.local_slot;
                }
                stmt.assign_target = assign_target;
                stmt.assign_expr = value_expr;
            }
        } else if stmt_node.type == ASTNodeType.AST_CAST_EXPR ||
            stmt_node.type == ASTNodeType.AST_PIPELINE_EXPR ||
            stmt_node.type == ASTNodeType.AST_CALL_EXPR ||
            stmt_node.type == ASTNodeType.AST_PRINT ||
            stmt_node.type == ASTNodeType.AST_PRINTLN ||
            stmt_node.type == ASTNodeType.AST_VA_START ||
            stmt_node.type == ASTNodeType.AST_VA_END ||
            stmt_node.type == ASTNodeType.AST_VA_ARG ||
            stmt_node.type == ASTNodeType.AST_VA_COPY ||
            stmt_node.type == ASTNodeType.AST_BINARY_EXPR ||
            stmt_node.type == ASTNodeType.AST_UNARY_EXPR ||
            stmt_node.type == ASTNodeType.AST_IDENTIFIER ||
            stmt_node.type == ASTNodeType.AST_MEMBER_ACCESS ||
            stmt_node.type == ASTNodeType.AST_ARRAY_ACCESS ||
            stmt_node.type == ASTNodeType.AST_SLICE_EXPR ||
            stmt_node.type == ASTNodeType.AST_STRUCT_INIT ||
            stmt_node.type == ASTNodeType.AST_ARRAY_LITERAL ||
            stmt_node.type == ASTNodeType.AST_TUPLE_LITERAL ||
            stmt_node.type == ASTNodeType.AST_SIZEOF ||
            stmt_node.type == ASTNodeType.AST_LEN ||
            stmt_node.type == ASTNodeType.AST_ALIGNOF ||
            stmt_node.type == ASTNodeType.AST_SRC_NAME ||
            stmt_node.type == ASTNodeType.AST_SRC_PATH ||
            stmt_node.type == ASTNodeType.AST_SRC_LINE ||
            stmt_node.type == ASTNodeType.AST_SRC_COL ||
            stmt_node.type == ASTNodeType.AST_FUNC_NAME ||
            stmt_node.type == ASTNodeType.AST_ERROR_ID ||
            stmt_node.type == ASTNodeType.AST_ERROR_NAME ||
            stmt_node.type == ASTNodeType.AST_TRY_EXPR ||
            stmt_node.type == ASTNodeType.AST_CATCH_EXPR {
            const expr_stmt: &HIRExpr = exec_lower_expr(ctx, stmt_node);
            if expr_stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_EXPR);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt.expr = expr_stmt;
        } else if stmt_node.type == ASTNodeType.AST_DEFER_STMT || stmt_node.type == ASTNodeType.AST_ERRDEFER_STMT {
            var cleanup_body: &ASTNode = stmt_node.defer_stmt_body;
            var cleanup_kind: HIRStmtKind = HIRStmtKind.HIR_STMT_DEFER;
            if stmt_node.type == ASTNodeType.AST_ERRDEFER_STMT {
                cleanup_body = stmt_node.errdefer_stmt_body;
                cleanup_kind = HIRStmtKind.HIR_STMT_ERRDEFER;
            }
            if cleanup_body == null {
                exec_lower_pop_scope(ctx);
                return exec_lower_fail_block(stmt_node, "exec: defer/errdefer body 为空" as *byte);
            }
            const cleanup_block: &HIRBlock = exec_lower_wrap_stmt_node_as_block(ctx, cleanup_body);
            if cleanup_block == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, cleanup_kind);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt.cleanup_block = cleanup_block;
        } else if stmt_node.type == ASTNodeType.AST_IF_STMT {
            const cond_expr: &HIRExpr = exec_lower_expr(ctx, stmt_node.if_stmt_condition);
            if cond_expr == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            // 分支允许直接写表达式（宏展开产物常见 `if cond { return err } else { expr }`），
            // 非 block 节点统一包一层单语句块。
            const then_block: &HIRBlock = exec_lower_wrap_stmt_node_as_block(ctx, stmt_node.if_stmt_then_branch);
            if then_block == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            var else_block: &HIRBlock = null;
            if stmt_node.if_stmt_else_branch != null {
                else_block = exec_lower_wrap_stmt_node_as_block(ctx, stmt_node.if_stmt_else_branch);
                if else_block == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
            }
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_IF);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt.expr = cond_expr;
            stmt.then_block = then_block;
            stmt.else_block = else_block;
        } else if stmt_node.type == ASTNodeType.AST_WHILE_STMT {
            const loop_body: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 1);
            if loop_body == null {
                exec_lower_pop_scope(ctx);
                exec_backend_set_error(stmt_node, "exec: loop body 分配失败" as *byte, 0);
                return null;
            }
            const cond_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_IF);
            const cond_expr: &HIRExpr = exec_lower_expr(ctx, stmt_node.while_stmt_condition);
            const body_block: &HIRBlock = exec_lower_block(ctx, stmt_node.while_stmt_body);
            if cond_stmt == null || cond_expr == null || body_block == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            const break_block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 1);
            const break_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_BREAK);
            if break_block == null || break_stmt == null {
                exec_lower_pop_scope(ctx);
                exec_backend_set_error(stmt_node, "exec: while break block 分配失败" as *byte, 0);
                return null;
            }
            break_block.stmts[1] = break_stmt;
            cond_stmt.expr = cond_expr;
            cond_stmt.then_block = body_block;
            cond_stmt.else_block = break_block;
            loop_body.stmts[1] = cond_stmt;
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_LOOP);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt.loop_body = loop_body;
        } else if stmt_node.type == ASTNodeType.AST_FOR_STMT {
            stmt = exec_lower_make_for_range_stmt(ctx, stmt_node);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
        } else if stmt_node.type == ASTNodeType.AST_BREAK_STMT {
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_BREAK);
        } else if stmt_node.type == ASTNodeType.AST_CONTINUE_STMT {
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_CONTINUE);
        } else if stmt_node.type == ASTNodeType.AST_RETURN_STMT {
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_RETURN);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            if stmt_node.return_stmt_expr != null {
                // 返回值是「按值取走」：里面的局部变量已经移动，出作用域不能再 drop。
                exec_lower_mark_moved_locals(ctx, stmt_node.return_stmt_expr);
                if ctx.function_decl != null && ctx.function_decl.fn_decl_return_type != null {
                    const return_type: Type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
                    // async 函数体里写的是载荷 T（而不是 Future<T>）：先按载荷类型降级，
                    // 之后再包成 `Future{ state: Poll.Ready(..) }`。
                    var coerce_target: Type = copy_type(&return_type);
                    if ctx.function_decl.fn_decl_is_async != 0 &&
                        return_type.kind == TypeKind.TYPE_STRUCT && return_type.struct_type_arg_count >= 1 &&
                        return_type.struct_type_args != null {
                        coerce_target = copy_type(&return_type.struct_type_args[0]);
                    }
                    var return_value: &HIRExpr = exec_lower_coerce_expr(ctx, stmt_node.return_stmt_expr, &coerce_target);
                    if return_value == null {
                        exec_lower_pop_scope(ctx);
                        return null;
                    }
                    if ctx.function_decl.fn_decl_is_async == 0 && return_type.kind != TypeKind.TYPE_ERROR_UNION &&
                        type_equals(return_value.type_ref.type, return_type) == 0 &&
                        exec_type_is_vm_value_supported(return_type) != 0 {
                        const cast_return: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node.return_stmt_expr, HIRExprKind.HIR_EXPR_CAST, &return_type);
                        if cast_return == null {
                            exec_lower_pop_scope(ctx);
                            return null;
                        }
                        cast_return.left = return_value;
                        return_value = cast_return;
                    }
                    if ctx.function_decl.fn_decl_is_async != 0 &&
                        (return_value.type_ref.type.kind == TypeKind.TYPE_ERROR ||
                         return_value.type_ref.type.kind == TypeKind.TYPE_ERROR_UNION) {
                        // async 里的错误返回：值被包成 Future 之后 builder 已经看不出
                        // 「这是错误返回」，用 int_value 提醒它跑 errdefer。
                        stmt.int_value = 1;
                    }
                    if ctx.function_decl.fn_decl_is_async != 0 && exec_lower_async_return_needs_wrap(
                            ctx, stmt_node.return_stmt_expr, copy_type(&return_type)) != 0 {
                        return_value = exec_lower_wrap_async_return(ctx, stmt_node.return_stmt_expr,
                            return_value, copy_type(&return_type));
                    }
                    stmt.expr = return_value;
                } else {
                    stmt.expr = exec_lower_expr(ctx, stmt_node.return_stmt_expr);
                    if stmt.expr == null {
                        exec_lower_pop_scope(ctx);
                        return null;
                    }
                }
            } else if ctx.function_decl != null && ctx.function_decl.fn_decl_return_type != null {
                const bare_return_type: Type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
                if bare_return_type.kind == TypeKind.TYPE_ERROR_UNION &&
                    bare_return_type.error_union_payload_type != null &&
                    bare_return_type.error_union_payload_type[0].kind == TypeKind.TYPE_VOID {
                    stmt.expr = exec_lower_make_zero_expr(ctx, stmt_node, &bare_return_type.error_union_payload_type[0]);
                    if stmt.expr == null {
                        exec_lower_pop_scope(ctx);
                        return null;
                    }
                }
            }
        } else if stmt_node.type == ASTNodeType.AST_BLOCK {
            const nested_block: &HIRBlock = exec_lower_block(ctx, stmt_node);
            if nested_block == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            const nested_stmt: &HIRStmt = exec_lower_wrap_block_as_stmt(ctx, stmt_node, nested_block);
            if nested_stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt = nested_stmt;
        } else if stmt_node.type == ASTNodeType.AST_ASM {
            // 内联汇编在解释执行下按无副作用语句处理：不执行机器码，
            // 输出操作数保持原值。汇编体由 C99 后端负责真正生成。
            const asm_void: Type = make_void_type();
            const asm_expr: &HIRExpr = exec_lower_make_zero_expr(ctx, stmt_node, &asm_void);
            if asm_expr == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_EXPR);
            if stmt == null {
                exec_lower_pop_scope(ctx);
                return null;
            }
            stmt.expr = asm_expr;
        } else if stmt_node.type == ASTNodeType.AST_MATCH_EXPR {
            stmt = exec_lower_try_make_returning_match_stmt(ctx, stmt_node);
            if stmt == null {
                const expr_stmt: &HIRExpr = exec_lower_expr(ctx, stmt_node);
                if expr_stmt == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                stmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_EXPR);
                if stmt == null {
                    exec_lower_pop_scope(ctx);
                    return null;
                }
                stmt.expr = expr_stmt;
            }
        } else {
            exec_lower_pop_scope(ctx);
            if stmt_node.type == ASTNodeType.AST_TEST_STMT {
                return exec_lower_fail_block(stmt_node, "exec: 当前不支持 test 语句" as *byte);
            }
            var unsupported_stmt_msg: [byte: 128] = [];
            _ = snprintf(&unsupported_stmt_msg[0] as *byte, 128, "exec: 尚未支持的语句节点(type=%d)" as *byte, stmt_node.type as i32);
            return exec_lower_fail_block(stmt_node, &unsupported_stmt_msg[0]);
        }
        if stmt == null {
            exec_lower_pop_scope(ctx);
            return null;
        }
        hir_block.stmts[i + 1] = stmt;
        i = i + 1;
    }
    if ctx.keep_scope_block != block {
        exec_lower_pop_scope(ctx);
    }
    return hir_block;
}

fn exec_lower_function(arena: &CompilerArena, checker: &TypeChecker, fn_decl: &ASTNode, globals: &HIRGlobalSlot, global_count: i32) &HIRFunction {
    if arena == null || checker == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return null;
    }
    // `@async_fn`：VM 按「同步执行到完成」降级——函数体当普通函数跑，
    // 返回值包成 `Future{ state: Poll.Ready(...) }`，`@await` 直接取载荷。
    // 真正需要挂起/交错让出执行权的场景仍不支持。
    if fn_decl.fn_decl_is_extern != 0 && exec_lower_extern_can_run_in_vm(checker, fn_decl) == 0 {
        exec_lower_set_unsupported_reason(fn_decl, "exec: 当前不支持 extern ABI" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_EXTERN_ABI);
        return null;
    }
    const saved_self_type_name: &byte = checker.current_self_type_name;
    const saved_self_is_union: i32 = checker.current_self_is_union;
    var owner_is_union: i32 = 0;
    var owner_type_name: &byte = checker_fn_decl_owner_type_name(checker, fn_decl, &owner_is_union);
    // 单态副本不是原方法声明，按声明找 owner 找不到，改用副本登记的结构体名，
    // 否则 `self: &Self` 里的 `Self` 解析不成结构体。
    const mono_owner_idx: i32 = exec_lower_mono_struct_index_of(fn_decl);
    if owner_type_name == null && mono_owner_idx >= 0 && mono_owner_idx < EXEC_MAX_MONO_STRUCT_DECLS {
        const mono_owner_decl: &ASTNode = g_mono_struct_owner[mono_owner_idx];
        if mono_owner_decl != null {
            owner_type_name = mono_owner_decl.struct_decl_name;
        }
    }
    if owner_type_name != null {
        checker.current_self_type_name = owner_type_name;
        checker.current_self_is_union = owner_is_union;
    }
    const return_type: Type = type_from_ast(checker, fn_decl.fn_decl_return_type);
    if exec_type_is_vm_value_supported(return_type) == 0 {
        checker.current_self_type_name = saved_self_type_name;
        checker.current_self_is_union = saved_self_is_union;
        if exec_type_uses_simd(return_type) != 0 {
            exec_lower_set_unsupported_reason(fn_decl, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
            return null;
        }
        exec_lower_set_unsupported(fn_decl, "exec: 当前仅支持标量/错误联合/void 返回值" as *byte);
        return null;
    }
    var ctx: ExecLowerContext = ExecLowerContext {
        arena: arena,
        checker: checker,
        function_decl: fn_decl,
        global_names: [],
        global_decls: [],
        global_types: null,
        global_is_const: [],
        global_count: 0,
        local_names: [],
        local_slots: [],
        local_types: null,
        local_is_param: [],
        slot_names: [],
        slot_decls: [],
        slot_types: null,
        slot_is_param: [],
        slot_scope_ids: [],
        slot_needs_drop: [],
        slot_drop_decls: [],
        slot_field_drop_indices: [],
        slot_field_drop_decls: [],
        slot_field_drop_count: [],
        active_local_count: 0,
        next_slot: 0,
        max_slot_count: 0,
        next_scope_id: 0,
        scope_markers: [],
        scope_ids: [],
        scope_depth: 0,
        keep_scope_block: null,
        catch_prefix_scope_open: 0,
    };
    exec_lower_seed_globals(&ctx, globals, global_count);
    var i: i32 = 0;
    while i < fn_decl.fn_decl_param_count {
        const param: &ASTNode = fn_decl.fn_decl_params[i];
        if param == null || param.type != ASTNodeType.AST_VAR_DECL {
            checker.current_self_type_name = saved_self_type_name;
            checker.current_self_is_union = saved_self_is_union;
            exec_lower_set_unsupported(fn_decl, "exec: 参数节点异常" as *byte);
            return null;
        }
        const param_type: Type = type_from_ast(checker, param.var_decl_type);
        if exec_type_is_vm_value_supported(param_type) == 0 {
            checker.current_self_type_name = saved_self_type_name;
            checker.current_self_is_union = saved_self_is_union;
            if exec_type_uses_simd(param_type) != 0 {
                exec_lower_set_unsupported_reason(param, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
                return null;
            }
            exec_lower_set_unsupported(param, "exec: 当前仅支持标量/错误联合参数" as *byte);
            return null;
        }
        if exec_lower_append_local(&ctx, param, param.var_decl_name, &param_type, 1) < 0 {
            checker.current_self_type_name = saved_self_type_name;
            checker.current_self_is_union = saved_self_is_union;
            exec_backend_set_error(param, "exec: 参数槽位不足" as *byte, 0);
            return null;
        }
        i = i + 1;
    }
    const body: &HIRBlock = exec_lower_block(&ctx, fn_decl.fn_decl_body);
    if body == null {
        checker.current_self_type_name = saved_self_type_name;
        checker.current_self_is_union = saved_self_is_union;
        return null;
    }
    const hir_fn: &HIRFunction = compiler_arena_alloc(arena, @size_of(HIRFunction)) as &HIRFunction;
    if hir_fn == null {
        checker.current_self_type_name = saved_self_type_name;
        checker.current_self_is_union = saved_self_is_union;
        exec_backend_set_error(fn_decl, "exec: HIRFunction 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(hir_fn as *byte, 0, @size_of(HIRFunction));
    hir_fn.name = fn_decl.fn_decl_name;
    hir_fn.decl = fn_decl;
    hir_fn.return_type = exec_lower_make_type_ref(&return_type);
    if ctx.max_slot_count > 0 {
        const locals: &HIRLocalSlot = compiler_arena_alloc(arena, @size_of(HIRLocalSlot) * ctx.max_slot_count as usize) as &HIRLocalSlot;
        if locals == null {
            checker.current_self_type_name = saved_self_type_name;
            checker.current_self_is_union = saved_self_is_union;
            exec_backend_set_error(fn_decl, "exec: local slot 表分配失败" as *byte, 0);
            return null;
        }
        i = 0;
        while i < ctx.max_slot_count {
            locals[i].name = ctx.slot_names[i];
            locals[i].decl = ctx.slot_decls[i];
            locals[i].slot = i;
            locals[i].scope_id = ctx.slot_scope_ids[i];
            locals[i].type_ref = exec_lower_make_type_ref(exec_lower_type_slot(ctx, 0, i, EXEC_MAX_LOCALS));
            locals[i].is_param = ctx.slot_is_param[i];
            locals[i].needs_drop = ctx.slot_needs_drop[i];
            locals[i].drop_decl = ctx.slot_drop_decls[i];
            var fdci: i32 = 0;
            while fdci < 4 {
                if i * 4 + fdci < EXEC_MAX_LOCALS * 4 {
                    locals[i].field_drop_indices[fdci] = ctx.slot_field_drop_indices[i * 4 + fdci];
                    locals[i].field_drop_decls[fdci] = ctx.slot_field_drop_decls[i * 4 + fdci];
                }
                fdci = fdci + 1;
            }
            locals[i].field_drop_count = ctx.slot_field_drop_count[i];
            i = i + 1;
        }
        hir_fn.locals = locals;
        hir_fn.local_count = ctx.max_slot_count;
    }
    hir_fn.param_count = fn_decl.fn_decl_param_count;
    hir_fn.is_varargs = fn_decl.fn_decl_is_varargs;
    hir_fn.body = body;
    checker.current_self_type_name = saved_self_type_name;
    checker.current_self_is_union = saved_self_is_union;
    return hir_fn;
}

/// 将 checker 后的可达函数降级为执行友好的 HIR。
/// 参数：`arena` 为执行后端短生命周期 Arena；`checker` 提供类型与可达性；`program` 为 merged checked AST。
/// 返回值：成功时返回 `HIRModule`；遇到当前未支持特性时返回 null，并通过 exec backend 错误状态说明原因。
export fn exec_lower_module(arena: &CompilerArena, checker: &TypeChecker, program: &ASTNode) &HIRModule {
    if arena == null || checker == null || program == null {
        exec_backend_set_error(program, "exec: lowering 输入无效" as *byte, 0);
        return null;
    }
    if g_app_mode_microapp != 0 {
        exec_lower_set_unsupported_reason(program, "exec: 当前不支持 microapp exec backend" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MICROAPP);
        return null;
    }
    if program.type == ASTNodeType.AST_PROGRAM {
        var decl_idx: i32 = 0;
        while decl_idx < program.program_decl_count {
            const decl: &ASTNode = program.program_decls[decl_idx];
            if decl != null && decl.type == ASTNodeType.AST_C_IMPORT_DECL {
                exec_lower_set_unsupported_reason(decl, "exec: 当前不支持 @c_import" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_C_IMPORT);
                return null;
            }
            decl_idx = decl_idx + 1;
        }
    }
    var global_count: i32 = 0;
    var globals: &HIRGlobalSlot = exec_lower_collect_global_slots(arena, checker, program, &global_count);
    if globals == null {
        return null;
    }
    var main_decl: &ASTNode = exec_lower_find_entry_decl(checker);
    var user_main_decl: &ASTNode = exec_lower_find_user_main_decl(checker);
    var has_user_main: i32 = 0;
    if user_main_decl != null {
        has_user_main = 1;
        main_decl = user_main_decl;
    }
    // 顶层 test "..." 块：C99 侧由代码生成器收集并为每个块发射一个 !void 函数，
    // 这里同样按源码顺序收集，交给 exec 侧 lowering 成独立 HIR 函数。
    var test_nodes: [&ASTNode: 256] = [];
    var test_count: i32 = 0;
    var test_scan: i32 = 0;
    if program.program_decls != null {
        while test_scan < program.program_decl_count && test_count < 256 {
            const scan_decl: &ASTNode = program.program_decls[test_scan];
            if scan_decl != null && scan_decl.type == ASTNodeType.AST_TEST_STMT {
                test_nodes[test_count] = scan_decl;
                test_count = test_count + 1;
            }
            test_scan = test_scan + 1;
        }
    }
    if main_decl == null && test_count == 0 {
        exec_lower_set_unsupported(program, "exec: 当前仅支持包含显式 fn/export fn main 的程序" as *byte);
        return null;
    }
    if test_count > 0 && has_user_main == 0 {
        const test_entry_decl: &ASTNode = exec_lower_build_test_entry_decl(arena, program);
        if test_entry_decl == null {
            exec_backend_set_error(program, "exec: 测试入口函数构造失败" as *byte, 0);
            return null;
        }
        main_decl = test_entry_decl;
    }
    var exec_reachable: [&ASTNode: MAX_REACHABLE_FN_DECLS] = [];
    var exec_reachable_count: i32 = 0;
    exec_reachable[0] = main_decl;
    exec_reachable_count = 1;
    var test_functions: & & HIRFunction = null;
    var test_descriptions: & & byte = null;
    var test_fn_decls: [&ASTNode: 256] = [];
    var test_seed: i32 = 0;
    while test_seed < test_count {
        if exec_reachable_count >= MAX_REACHABLE_FN_DECLS {
            exec_backend_set_error(test_nodes[test_seed], "exec: 测试种子超出上限" as *byte, 0);
            return null;
        }
        exec_reachable[exec_reachable_count] = test_nodes[test_seed];
        exec_reachable_count = exec_reachable_count + 1;
        test_seed = test_seed + 1;
    }
    if test_count > 0 {
        test_functions = compiler_arena_alloc(arena, @size_of(&HIRFunction) * test_count as usize) as & & HIRFunction;
        test_descriptions = compiler_arena_alloc(arena, @size_of(&byte) * test_count as usize) as & & byte;
        if test_functions == null || test_descriptions == null {
            exec_backend_set_error(program, "exec: 测试函数表分配失败" as *byte, 0);
            return null;
        }
        var test_build_idx: i32 = 0;
        while test_build_idx < test_count {
            const built_decl: &ASTNode = exec_lower_make_test_fn_decl(arena, test_nodes[test_build_idx], test_build_idx);
            if built_decl == null {
                exec_backend_set_error(test_nodes[test_build_idx], "exec: 测试函数声明构造失败" as *byte, 0);
                return null;
            }
            test_fn_decls[test_build_idx] = built_decl;
            test_descriptions[test_build_idx] = test_nodes[test_build_idx].test_stmt_description;
            if exec_reachable_count >= MAX_REACHABLE_FN_DECLS {
                exec_backend_set_error(built_decl, "exec: 测试函数超出可达上限" as *byte, 0);
                return null;
            }
            exec_reachable[exec_reachable_count] = built_decl;
            exec_reachable_count = exec_reachable_count + 1;
            test_build_idx = test_build_idx + 1;
        }
    }
    // 先按调用边闭包补齐可达函数集合，再按函数所在文件补采该文件的全局变量：
    // 库模块内部函数（如 std.testing 的 assert 实现）引用的模块全局不在调用方
    // program 的收集路径里，必须在 lowering 前拿到槽位。
    var queue: [&ASTNode: MAX_REACHABLE_FN_DECLS] = [];
    var head: i32 = 0;
    var tail: i32 = 0;
    var seed_idx: i32 = 0;
    while seed_idx < exec_reachable_count {
        queue[seed_idx] = exec_reachable[seed_idx];
        seed_idx = seed_idx + 1;
    }
    tail = exec_reachable_count;
    while head < tail {
        const from_decl: &ASTNode = queue[head];
        head = head + 1;
        var edge_idx: i32 = 0;
        while edge_idx < checker.fn_call_edge_count {
            if checker.fn_call_edge_from[edge_idx] == from_decl {
                const to_decl: &ASTNode = checker.fn_call_edge_to[edge_idx];
                if to_decl != null &&
                    to_decl.type == ASTNodeType.AST_FN_DECL &&
                    exec_lower_extern_can_run_in_vm(checker, to_decl) != 0 &&
                    exec_lower_decl_index(&exec_reachable[0] as & & ASTNode, exec_reachable_count, to_decl) < 0 {
                    if exec_reachable_count >= MAX_REACHABLE_FN_DECLS || tail >= MAX_REACHABLE_FN_DECLS {
                        exec_backend_set_error(to_decl, "exec: reachable 函数集合超出上限" as *byte, 0);
                        return null;
                    }
                    exec_reachable[exec_reachable_count] = to_decl;
                    exec_reachable_count = exec_reachable_count + 1;
                    queue[tail] = to_decl;
                    tail = tail + 1;
                }
            }
            edge_idx = edge_idx + 1;
        }
    }
    exec_lower_reset_collected_files();
    var file_global_i: i32 = 0;
    while file_global_i < exec_reachable_count {
        const file_global_decl: &ASTNode = exec_reachable[file_global_i];
        if file_global_decl != null && file_global_decl.filename != null {
            if exec_lower_collect_file_globals_once(checker, file_global_decl.filename, globals, &global_count) != 0 {
                return null;
            }
        }
        file_global_i = file_global_i + 1;
    }
    if exec_lower_lower_global_init_exprs(arena, checker, globals, global_count, &exec_reachable[0] as & & ASTNode, &exec_reachable_count) != 0 {
        return null;
    }
    const functions: & & HIRFunction = compiler_arena_alloc(arena, @size_of(&HIRFunction) * MAX_REACHABLE_FN_DECLS as usize) as & & HIRFunction;
    if functions == null {
        exec_backend_set_error(program, "exec: HIR function 列表分配失败" as *byte, 0);
        return null;
    }
    var count: i32 = 0;
    var entry_fn: &HIRFunction = null;
    var i: i32 = 0;
    var lower_pass: i32 = 0;
    while lower_pass < 4 {
    while i < exec_reachable_count {
        const decl: &ASTNode = exec_reachable[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_body != null && decl.filename != null {
            if exec_lower_collect_file_globals_once(checker, decl.filename, globals, &global_count) != 0 {
                return null;
            }
        }
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_body != null &&
            decl.fn_decl_type_param_count > 0 {
            if exec_lower_generic_instances(arena, checker, decl, globals, global_count, functions, &count,
                    &exec_reachable[0] as & & ASTNode, &exec_reachable_count) != 0 {
                if exec_backend_get_last_error() == null {
                    exec_backend_set_error(decl, "exec: 泛型实例 lowering 失败" as *byte, 0);
                }
                return null;
            }
            i = i + 1;
            continue;
        }
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_body != null &&
            exec_lower_mono_struct_index_of(decl) < 0 &&
            exec_lower_is_generic_struct_method(checker, decl) != 0 {
            // 泛型结构体的原方法声明不单独降级：它在具体类型实参下才有意义，
            // 调用点用的是 `结构体名_方法名$s<序号>` 的单态副本。
            i = i + 1;
            continue;
        }
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_body != null {
            const mono_idx: i32 = exec_lower_mono_struct_index_of(decl);
            const saved_mono_active: i32 = checker.subst_active;
            const saved_mono_name: &byte = checker.subst_name;
            const saved_mono_type: Type = copy_type(&checker.subst_type);
            const saved_mono_params: &TypeParam = checker.current_type_params;
            const saved_mono_param_count: i32 = checker.current_type_param_count;
            const saved_mono_current: i32 = g_mono_struct_current;
            if mono_idx >= 0 {
                exec_lower_install_mono_struct_subst(checker, mono_idx);
                g_mono_struct_current = mono_idx;
            }
            const lowered: &HIRFunction = exec_lower_function(arena, checker, decl, globals, global_count);
            checker.subst_active = saved_mono_active;
            checker.subst_name = saved_mono_name;
            checker.subst_type = copy_type(&saved_mono_type);
            checker.current_type_params = saved_mono_params;
            checker.current_type_param_count = saved_mono_param_count;
            g_mono_struct_current = saved_mono_current;
            if lowered == null {
                if exec_backend_get_last_error() == null {
                    exec_backend_set_error(decl, "exec: 函数 lowering 失败但未设置错误信息" as *byte, 0);
                }
                return null;
            }
            functions[count] = lowered;
            if decl == main_decl {
                entry_fn = lowered;
            }
            var test_match_idx: i32 = 0;
            while test_match_idx < test_count {
                if test_fn_decls[test_match_idx] == decl {
                    if test_functions != null {
                        test_functions[test_match_idx] = lowered;
                    }
                    break;
                }
                test_match_idx = test_match_idx + 1;
            }
            if lowered.body != null {
                exec_lower_collect_called_decls_from_block(lowered.body, &exec_reachable[0] as & & ASTNode, &exec_reachable_count);
            }
            exec_lower_collect_cleanup_decls_from_function(checker, lowered, &exec_reachable[0] as & & ASTNode, &exec_reachable_count);
            count = count + 1;
        }
        // 本轮 lowering 新登记的单态结构体方法副本要补进可达集合，下一轮继续降级。
        if exec_lower_drain_pending_mono_struct_decls(&exec_reachable[0] as & & ASTNode, &exec_reachable_count) != 0 {
            exec_backend_set_error(program, "exec: 单态结构体方法超出可达上限" as *byte, 0);
            return null;
        }
        i = i + 1;
    }
    // 新发现的模块全局变量（模块内部函数引用）需要补降初始化表达式；
    // 初始化表达式可能再引入新的可达函数，下一轮继续，最多 4 轮。
    if exec_lower_lower_global_init_exprs(arena, checker, globals, global_count, &exec_reachable[0] as & & ASTNode, &exec_reachable_count) != 0 {
        return null;
    }
    if i >= exec_reachable_count {
        break;
    }
    lower_pass = lower_pass + 1;
    }
    const global_init_function: &HIRFunction = exec_lower_build_global_init_function(arena, globals, global_count);
    if entry_fn == null {
        exec_lower_set_unsupported(program, "exec: 无法定位 exec 入口 main" as *byte);
        return null;
    }
    const module: &HIRModule = compiler_arena_alloc(arena, @size_of(HIRModule)) as &HIRModule;
    if module == null {
        exec_backend_set_error(program, "exec: HIRModule 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(module as *byte, 0, @size_of(HIRModule));
    module.functions = functions;
    module.function_count = count;
    module.entry_function = entry_fn;
    module.globals = globals;
    module.global_count = global_count;
    module.global_init_function = global_init_function;
    module.tests = test_functions;
    module.test_descriptions = test_descriptions;
    module.test_count = test_count;
    module.has_user_main = has_user_main;
    return module;
}
