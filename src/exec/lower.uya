        }
        if str_equals(fn_name, "pthread_mutexattr_destroy" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_DESTROY;
        }
        if str_equals(fn_name, "pthread_mutex_init" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_INIT;
        }
        if str_equals(fn_name, "pthread_mutex_destroy" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_DESTROY;
        }
        if str_equals(fn_name, "pthread_mutex_lock" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_LOCK;
        }
        if str_equals(fn_name, "pthread_mutex_trylock" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_TRYLOCK;
        }
        if str_equals(fn_name, "pthread_mutex_unlock" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEX_UNLOCK;
        }
        if str_equals(fn_name, "pthread_condattr_init" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_INIT;
        }
        if str_equals(fn_name, "pthread_condattr_getclock" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_GETCLOCK;
        }
        if str_equals(fn_name, "pthread_condattr_setclock" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_SETCLOCK;
        }
        if str_equals(fn_name, "pthread_condattr_destroy" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CONDATTR_DESTROY;
        }
        if str_equals(fn_name, "pthread_setcancelstate" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_SETCANCELSTATE;
        }
        if str_equals(fn_name, "pthread_setcanceltype" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_SETCANCELTYPE;
        }
        if str_equals(fn_name, "pthread_barrier_init" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_BARRIER_INIT;
        }
        if str_equals(fn_name, "pthread_barrier_wait" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_BARRIER_WAIT;
        }
        if str_equals(fn_name, "pthread_barrier_destroy" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_BARRIER_DESTROY;
        }
        // `setjmp`/`sigsetjmp` 是 `@naked_fn` 的内联汇编（保存 rbx/rbp/r12-r15/rsp/rip），
        // 解释器没有寄存器现场；宿主实现写一组非零标记，调用方只关心「保存过」。
        if (str_equals(fn_name, "setjmp" as &byte) != 0 ||
            str_equals(fn_name, "_setjmp" as &byte) != 0) &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_SETJMP;
        }
        if str_equals(fn_name, "sigsetjmp" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_SIGSETJMP;
        }
        if str_equals(fn_name, "pthread_key_create" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_KEY_CREATE;
        }
        if str_equals(fn_name, "pthread_key_delete" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_KEY_DELETE;
        }
        if str_equals(fn_name, "pthread_setspecific" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_SETSPECIFIC;
        }
        if str_equals(fn_name, "pthread_getspecific" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_GETSPECIFIC;
        }
        if str_equals(fn_name, "uya_interface_get_vtable" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_INTERFACE_GET_VTABLE;
        }
        if str_equals(fn_name, "__atomic_load_n" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_LOAD_N;
        }
        if str_equals(fn_name, "__atomic_store_n" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_STORE_N;
        }
        if str_equals(fn_name, "__atomic_exchange_n" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_EXCHANGE_N;
        }
        if str_equals(fn_name, "__atomic_add_fetch" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_ADD_FETCH;
        }
        if str_equals(fn_name, "__atomic_fetch_add" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FETCH_ADD;
        }
        if str_equals(fn_name, "__sync_fetch_and_add" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FETCH_ADD;
        }
        if str_equals(fn_name, "__atomic_fetch_sub" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FETCH_SUB;
        }
        if str_equals(fn_name, "__sync_fetch_and_sub" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FETCH_SUB;
        }
        if str_equals(fn_name, "__sync_synchronize" as &byte) != 0 &&
            param_count == 0 && call_arg_count == 0 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FENCE;
        }
        if str_equals(fn_name, "__atomic_thread_fence" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_FENCE;
        }
        if str_equals(fn_name, "malloc" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_MALLOC;
        }
        if str_equals(fn_name, "free" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_FREE;
        }
        if str_equals(fn_name, "calloc" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_CALLOC;
        }
        if str_equals(fn_name, "realloc" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_REALLOC;
        }
        if str_equals(fn_name, "memcpy" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_MEMCPY;
        }
        if str_equals(fn_name, "memmove" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_MEMMOVE;
        }
        if str_equals(fn_name, "memset" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_MEMSET;
        }
        if str_equals(fn_name, "memcmp" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_MEMCMP;
        }
        if str_equals(fn_name, "memchr" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_MEMCHR;
        }
        if str_equals(fn_name, "strlen" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_STRLEN;
        }
        if str_equals(fn_name, "puts" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PUTS;
        }
        if str_equals(fn_name, "atoi" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOI;
        }
        if str_equals(fn_name, "atoll" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOLL;
        }
        if str_equals(fn_name, "isqrt" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_ISQRT;
        }
        // libm 族：`lib/tflm/kernels` 这类模块只写不带体的
        // `extern "libc" fn exp(x: f64) f64;`，没有 Uya 实现体，VM 必须自己接上。
        // 具体函数名留在 hostcall 站点的 `name` 里，由 VM 按名字分派。
        if exec_lower_is_libm_unary_name(fn_name) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_LIBM1;
        }
        if exec_lower_is_libm_binary_name(fn_name) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_LIBM2;
        }
        if str_equals(fn_name, "strcmp" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_STRCMP;
        }
        if str_equals(fn_name, "llabs" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_LLABS;
        }
        if str_equals(fn_name, "mkdir" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_MKDIR;
        }
        if str_equals(fn_name, "rmdir" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_RMDIR;
        }
        if str_equals(fn_name, "__atomic_compare_exchange_n" as &byte) != 0 &&
            param_count == 6 && call_arg_count == 6 {
            return ExecHostCallId.EXEC_HOST_CALL_ATOMIC_COMPARE_EXCHANGE;
        }
        return ExecHostCallId.EXEC_HOST_CALL_NONE;
    }
    return ExecHostCallId.EXEC_HOST_CALL_NONE;
}

fn exec_lower_extern_prefers_host_call(fn_decl: &ASTNode) i32 {
    if fn_decl == null || fn_decl.fn_decl_name == null {
        return 0;
    }
    const name: &byte = fn_decl.fn_decl_name;
    // `sscanf` 的 Uya 实现体走 `@va_start` 变参路径，解释器里那条路最后要落到
    // 一个不存在的变参宿主符号上（实测「无法解析被调用函数」）。它已经有
    // 专门的宿主实现（`EXEC_HOST_CALL_SSCANF_FIXED`），这里让它优先走宿主。
    if str_equals(name, "sscanf" as *byte) != 0 {
        return 1;
    }
    // 这些入口在 VM 里有宿主实现，Uya 实现体（线程/信号/内存系统调用）在解释器里
    // 既跑不通也没有等价语义，优先走宿主实现。
    if str_equals(name, "pthread_create" as *byte) != 0 ||
        str_equals(name, "pthread_once" as *byte) != 0 ||
        str_equals(name, "pthread_exit" as *byte) != 0 ||
        str_equals(name, "pthread_attr_init" as *byte) != 0 ||
        str_equals(name, "pthread_attr_getstacksize" as *byte) != 0 ||
        str_equals(name, "pthread_attr_setstacksize" as *byte) != 0 ||
        str_equals(name, "pthread_attr_getdetachstate" as *byte) != 0 ||
        str_equals(name, "pthread_attr_setdetachstate" as *byte) != 0 ||
        str_equals(name, "pthread_cond_timedwait" as *byte) != 0 ||        str_equals(name, "pthread_mutexattr_init" as *byte) != 0 ||
        str_equals(name, "pthread_mutexattr_settype" as *byte) != 0 ||
        str_equals(name, "pthread_mutexattr_gettype" as *byte) != 0 ||
        str_equals(name, "pthread_mutexattr_destroy" as *byte) != 0 ||
        str_equals(name, "pthread_mutex_init" as *byte) != 0 ||
        str_equals(name, "pthread_mutex_destroy" as *byte) != 0 ||
        str_equals(name, "pthread_mutex_lock" as *byte) != 0 ||
        str_equals(name, "pthread_mutex_trylock" as *byte) != 0 ||
        str_equals(name, "pthread_mutex_unlock" as *byte) != 0 ||
        str_equals(name, "pthread_condattr_init" as *byte) != 0 ||
        str_equals(name, "pthread_condattr_getclock" as *byte) != 0 ||
        str_equals(name, "pthread_condattr_setclock" as *byte) != 0 ||
        str_equals(name, "pthread_condattr_destroy" as *byte) != 0 ||
        str_equals(name, "pthread_setcancelstate" as *byte) != 0 ||
        str_equals(name, "pthread_setcanceltype" as *byte) != 0 ||
        str_equals(name, "pthread_barrier_init" as *byte) != 0 ||
        str_equals(name, "pthread_barrier_wait" as *byte) != 0 ||
        str_equals(name, "pthread_barrier_destroy" as *byte) != 0 ||
        str_equals(name, "setjmp" as *byte) != 0 ||
        str_equals(name, "_setjmp" as *byte) != 0 ||
        str_equals(name, "sigsetjmp" as *byte) != 0 ||
        str_equals(name, "pthread_key_create" as *byte) != 0 ||
        str_equals(name, "pthread_key_delete" as *byte) != 0 ||
        str_equals(name, "pthread_setspecific" as *byte) != 0 ||
        str_equals(name, "pthread_getspecific" as *byte) != 0 ||
        str_equals(name, "pthread_join" as *byte) != 0 ||
        str_equals(name, "pthread_detach" as *byte) != 0 ||
        str_equals(name, "pthread_self" as *byte) != 0 ||
        str_equals(name, "pthread_equal" as *byte) != 0 {
        return 1;
    }
    return 0;
}

fn exec_lower_host_call_overrides_body(fn_decl: &ASTNode, host_call_id: ExecHostCallId) i32 {
    if fn_decl == null || host_call_id == ExecHostCallId.EXEC_HOST_CALL_NONE {
        return 0;
    }
    return exec_lower_extern_prefers_host_call(fn_decl);
}

fn exec_lower_extern_can_run_in_vm(checker: &TypeChecker, fn_decl: &ASTNode) i32 {
    if fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    if fn_decl.fn_decl_is_extern == 0 {
        return (fn_decl.fn_decl_body != null) as i32;
    }
    // 同步 VM 没有真正的线程/锁语义：`pthread_*` 的 Uya 实现体（clone 系统调用等）
    // 在解释器里跑出来的返回值没有意义，一律按「VM 不能执行」处理，
    // 能对上宿主桥的（`pthread_sigmask` 一类）仍然走宿主实现，其余退化成零值桩。
    if fn_decl.fn_decl_name != null &&
        exec_lower_name_has_prefix(fn_decl.fn_decl_name, "pthread_" as &byte) != 0 {
        return 0;
    }
    if fn_decl.fn_decl_body == null {
        return 0;
    }
    if exec_lower_extern_prefers_host_call(fn_decl) != 0 {
        return 0;
    }
    return 1;
}

fn exec_type_uses_simd(ty: Type) i32 {
    if ty.kind == TypeKind.TYPE_VECTOR || ty.kind == TypeKind.TYPE_MASK {
        return 1;
    }
    if ty.kind == TypeKind.TYPE_ARRAY && ty.element_type != null {
        return exec_type_uses_simd(ty.element_type[0]);
    }
    if ty.kind == TypeKind.TYPE_SLICE && ty.slice_element_type != null {
        return exec_type_uses_simd(ty.slice_element_type[0]);
    }
    if ty.kind == TypeKind.TYPE_TUPLE && ty.tuple_element_types != null {
        var i: i32 = 0;
        while i < ty.tuple_count {
            if exec_type_uses_simd(ty.tuple_element_types[i]) != 0 {
                return 1;
            }
            i = i + 1;
        }
    }
    if ty.kind == TypeKind.TYPE_ERROR_UNION && ty.error_union_payload_type != null {
        return exec_type_uses_simd(ty.error_union_payload_type[0]);
    }
    return 0;
}

fn exec_type_is_aggregate_supported(ty: Type) i32 {
    if ty.kind == TypeKind.TYPE_ARRAY && ty.element_type != null {
        return exec_type_is_vm_value_supported(ty.element_type[0]);
    }
    if ty.kind == TypeKind.TYPE_SLICE && ty.slice_element_type != null {
        return exec_type_is_vm_value_supported(ty.slice_element_type[0]);
    }
    if ty.kind == TypeKind.TYPE_TUPLE && ty.tuple_element_types != null {
        var ti: i32 = 0;
        while ti < ty.tuple_count {
            if exec_type_is_vm_value_supported(ty.tuple_element_types[ti]) == 0 {
                return 0;
            }
            ti = ti + 1;
        }
        return 1;
    }
    if ty.kind == TypeKind.TYPE_STRUCT && type_get_struct_name(&ty) != null {
        return 1;
    }
    return 0;
}

fn exec_type_is_vm_value_supported(type: Type) i32 {
    if exec_type_is_scalar_supported(type) != 0 {
        return 1;
    }
    if type.kind == TypeKind.TYPE_ENUM {
        return 1;
    }
    if type.kind == TypeKind.TYPE_INTERFACE {
        return 1;
    }
    if type.kind == TypeKind.TYPE_UNION {
        return 1;
    }
    if type.kind == TypeKind.TYPE_POINTER {
        return 1;
    }
    if type.kind == TypeKind.TYPE_VA_LIST {
        return 1;
    }
    if type.kind == TypeKind.TYPE_ERROR {
        return 1;
    }
    // 未替换的泛型参数（泛型声明的签名 `!T` / `&T`）按占位类型放行：
    // 单态实例里它会被具体类型替换，泛型声明本身不会被真正调用。
    if type.kind == TypeKind.TYPE_GENERIC_PARAM {
        return 1;
    }
    if type.kind == TypeKind.TYPE_ERROR_UNION && type.error_union_payload_type != null {
        return exec_type_is_vm_value_supported(type.error_union_payload_type[0]);
    }
    if exec_type_is_aggregate_supported(type) != 0 {
        return 1;
    }
    return 0;
}

fn exec_lower_expr_type(ctx: &ExecLowerContext, expr: &ASTNode) Type {
    if ctx == null || ctx.checker == null || expr == null {
        return Type {
            kind: TypeKind.TYPE_VOID,
            data: TypeData.named(null as &byte),
            enum_name: null,
            interface_name: null,
            interface_type_args: null,
            interface_type_arg_count: 0,
            struct_name: null,
            union_name: null,
            pointer_to: null,
            is_ffi_pointer: 0,
            element_type: null,
            array_size: 0,
            slice_element_type: null,
            slice_len: 0,
            slice_element_is_const: 0,
            tuple_element_types: null,
            tuple_count: 0,
            error_union_payload_type: null,
            error_error_id: 0,
            atomic_inner_type: null,
            generic_param_name: null,
            struct_type_args: null,
            struct_type_arg_count: 0,
            union_type_args: null,
            union_type_arg_count: 0,
        };
    }
    if expr.type == ASTNodeType.AST_PRINT || expr.type == ASTNodeType.AST_PRINTLN {
        return make_i32_type();
    }
    if expr.type == ASTNodeType.AST_MATCH_EXPR {
        const lowered_match_type: Type = exec_lower_infer_match_expr_type(ctx, expr);
        if lowered_match_type.kind != TypeKind.TYPE_VOID {
            return lowered_match_type;
        }
    }
    if expr.type == ASTNodeType.AST_BLOCK && expr.block_stmts != null && expr.block_stmt_count > 0 {
        // 块表达式的类型取尾语句的类型（宏展开产物常以 if 表达式收尾）。
        const block_tail: &ASTNode = expr.block_stmts[expr.block_stmt_count - 1];
        if block_tail != null {
            const block_tail_type: Type = exec_lower_expr_type(ctx, block_tail);
            if block_tail_type.kind != TypeKind.TYPE_VOID {
                return block_tail_type;
            }
        }
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS && expr.array_access_array != null {
        // `q.slots[i]`：从基表达式类型逐层取元素类型。checker 在单态化体里会把
        // 元素类型推成声明形态（`TaskQueueSlot<T>`），`@size_of` 折叠不出尺寸，
        // `ADDR_INDEX` 的元素步长退化成 0（原生数组按下标访问全部错位）。
        var aa_elem: Type = exec_lower_expr_type(ctx, expr.array_access_array);
        if aa_elem.kind == TypeKind.TYPE_POINTER && aa_elem.pointer_to != null {
            aa_elem = copy_type(&aa_elem.pointer_to[0]);
        } else if aa_elem.kind == TypeKind.TYPE_ARRAY && aa_elem.element_type != null {
            aa_elem = copy_type(&aa_elem.element_type[0]);
        } else if aa_elem.kind == TypeKind.TYPE_SLICE && aa_elem.slice_element_type != null {
            aa_elem = copy_type(&aa_elem.slice_element_type[0]);
        } else {
            aa_elem = make_void_type();
        }
        if aa_elem.kind != TypeKind.TYPE_VOID {
            return aa_elem;
        }
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS &&
        expr.member_access_object != null && expr.member_access_field_name != null {
        // `q.slots`：checker 在单态化体里会把字段类型推成声明形态
        // （`&TaskQueueSlot<T>`，实参还是 `T`），下游 `@size_of` 折叠不出尺寸，
        // exec 侧 `ADDR_INDEX` 的元素步长就退化成 0。这里改从**基表达式自己的
        // 类型**出发，用泛型实参把字段声明里的 `T` 换掉。
        const ma_base: Type = exec_lower_member_base_type(ctx, expr.member_access_object);
        if ma_base.kind == TypeKind.TYPE_STRUCT && ma_base.struct_name != null {
            const ma_field: Type = exec_lower_struct_field_type(ctx, copy_type(&ma_base),
                expr.member_access_field_name);
            if ma_field.kind != TypeKind.TYPE_VOID {
                return ma_field;
            }
        }
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR && expr.cast_expr_target_type != null {
        if expr.cast_expr_is_force_cast == 0 {
            // `x as &const void`：checker 的静默推断在 `extern "libc"` 带函数体
            // 这类上下文里会把这个 cast 的目标类型推成 `i64`，于是 lowering 发射
            // `BC_CAST imm=3`（TYPE_I64），指针被 `exec_vm_numeric_to_i64` 转成
            // 整数 —— 后续 syscall 出参结构体就定位不到，裸的槽地址被交给内核，
            // 内核按原生布局写到 ExecValue 头上（`rt_sigaction` 的 `&old_action`
            // 就是这样把 `slots[5].kind` 写没的）。这里直接按 AST 上的目标类型
            // 节点解析。
            const cast_declared: Type = type_from_ast(ctx.checker, expr.cast_expr_target_type);
            if cast_declared.kind != TypeKind.TYPE_VOID {
                return cast_declared;
            }
        }
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER && expr.identifier_name != null {
        // 局部变量/参数直接取槽位记录的类型：符号表在 lowering 阶段未必完整
        // （宏展开体、单态化体尤其明显），靠 checker_infer_type 容易退回 void。
        const ident_slot: i32 = exec_lower_find_slot(ctx, expr.identifier_name);
        if ident_slot >= 0 && ident_slot < EXEC_MAX_LOCALS {
            return copy_type(exec_lower_type_slot(ctx, 0, ident_slot, EXEC_MAX_LOCALS));
        }
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND && expr.unary_expr_operand != null {
        // 语言层 `& <切片值>` 不表示取地址（切片本身就是值），类型仍是该切片。
        const amp_operand_type: Type = exec_lower_expr_type(ctx, expr.unary_expr_operand);
        if amp_operand_type.kind == TypeKind.TYPE_SLICE {
            return amp_operand_type;
        }
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR && expr.slice_expr_base != null {
        // 切片表达式按基表达式类型直接推出 `&[元素]`：checker_infer_type 依赖符号表，
        // 在 lowering 阶段（尤其是宏展开体里）常常拿不到基变量类型而退回 void。
        const slice_base_type: Type = exec_lower_expr_type(ctx, expr.slice_expr_base);
        var slice_elem_type: &Type = null;
        if slice_base_type.kind == TypeKind.TYPE_ARRAY {
            slice_elem_type = slice_base_type.element_type;
        } else if slice_base_type.kind == TypeKind.TYPE_SLICE {
            slice_elem_type = slice_base_type.slice_element_type;
        } else if slice_base_type.kind == TypeKind.TYPE_POINTER {
            slice_elem_type = slice_base_type.pointer_to;
        }
        if slice_elem_type != null {
            const slice_elem_ptr: &Type = compiler_arena_alloc(ctx.arena, @size_of(Type)) as &Type;
            if slice_elem_ptr == null {
                return make_void_type();
            }
            slice_elem_ptr[0] = copy_type(slice_elem_type);
            return make_slice_type(ctx.arena, slice_elem_ptr);
        }
    }
    if expr.type == ASTNodeType.AST_IF_STMT && expr.if_stmt_else_branch != null {
        // `if cond { error.Foo } else { value }`：checker 只按 then 分支推断出 TYPE_ERROR，
        // 但该表达式整体是错误联合 `!value`（宏展开的 to_json/from_json 体就是这种形状）。
        const if_then_type: Type = exec_lower_expr_type(ctx, expr.if_stmt_then_branch);
        if if_then_type.kind == TypeKind.TYPE_ERROR {
            const if_else_type: Type = exec_lower_expr_type(ctx, expr.if_stmt_else_branch);
            if if_else_type.kind != TypeKind.TYPE_ERROR &&
                if_else_type.kind != TypeKind.TYPE_ERROR_UNION &&
                if_else_type.kind != TypeKind.TYPE_VOID {
                const if_else_ptr: &Type = compiler_arena_alloc(ctx.arena, @size_of(Type)) as &Type;
                if if_else_ptr == null {
                    return make_void_type();
                }
                if_else_ptr[0] = copy_type(&if_else_type);
                return make_error_union_type(ctx.arena, if_else_ptr);
            }
        }
    }
    const saved_scope_level: i32 = ctx.checker.scope_level;
    const prev_in_function: i32 = ctx.checker.in_function;
    const prev_function_decl: &ASTNode = ctx.checker.current_function_decl;
    const prev_return_type: Type = copy_type(&ctx.checker.current_return_type);
    if ctx.function_decl != null {
        ctx.checker.in_function = 1;
        ctx.checker.current_function_decl = ctx.function_decl;
        if ctx.function_decl.fn_decl_return_type != null {
            ctx.checker.current_return_type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
        }
    }
    if ctx.active_local_count > 0 {
        checker_enter_scope(ctx.checker);
        var local_i: i32 = 0;
        while local_i < ctx.active_local_count {
            const local_name: &byte = ctx.local_names[local_i];
            if local_name != null {
                var shadowed: i32 = 0;
                var local_j: i32 = local_i + 1;
                while local_j < ctx.active_local_count {
                    if ctx.local_names[local_j] != null &&
                        str_equals(ctx.local_names[local_j], local_name) != 0 {
                        shadowed = 1;
                        break;
                    }
                    local_j = local_j + 1;
                }
                if shadowed == 0 {
                    const temp_symbol: &Symbol = compiler_arena_alloc(ctx.checker.arena, @size_of(Symbol)) as &Symbol;
                    if temp_symbol != null {
                        const local_slot: i32 = ctx.local_slots[local_i];
                        var local_type: Type = copy_type(exec_lower_type_slot(ctx, 1, local_i, EXEC_MAX_LOCALS));
                        var local_line: i32 = expr.line;
                        var local_column: i32 = expr.column;
                        var local_is_const: i32 = ctx.local_is_param[local_i];
                        if local_slot >= 0 && local_slot < EXEC_MAX_LOCALS {
                            local_type = copy_type(exec_lower_type_slot(ctx, 0, local_slot, EXEC_MAX_LOCALS));
                            const local_decl: &ASTNode = ctx.slot_decls[local_slot];
                            if local_decl != null {
                                local_line = local_decl.line;
                                local_column = local_decl.column;
                                if local_decl.type == ASTNodeType.AST_VAR_DECL {
                                    local_is_const = local_decl.var_decl_is_const;
                                }
                            }
                        }
                        temp_symbol.name = local_name;
                        temp_symbol.type = copy_type(&local_type);
                        temp_symbol.is_const = local_is_const;
                        temp_symbol.is_initialized = 1;
                        temp_symbol.scope_level = ctx.checker.scope_level;
                        temp_symbol.line = local_line;
                        temp_symbol.column = local_column;
                        temp_symbol.pointee_of = null;
                        temp_symbol.pointer_known_length = -1;
                        temp_symbol.pointer_length_param = null;
                        temp_symbol.next_in_scope = null;
                        _ = symbol_table_insert(ctx.checker, temp_symbol);
                    }
                }
            }
            local_i = local_i + 1;
        }
    }
    var inferred: Type = exec_lower_checker_infer_type_quiet(ctx, expr);
    if inferred.kind == TypeKind.TYPE_VOID && expr.type == ASTNodeType.AST_MEMBER_ACCESS &&
        expr.member_access_object != null && expr.member_access_field_name != null {
        // `(x as! T).value` / `.error_id`：`as!` 的结果是错误联合，但静默推断里
        // 这种成员访问会退回 void，这里按基类型补一次。
        var fix_parent: Type = exec_lower_expr_type(ctx, expr.member_access_object);
        if fix_parent.kind == TypeKind.TYPE_POINTER && fix_parent.pointer_to != null {
            fix_parent = fix_parent.pointer_to[0];
        }
        if fix_parent.kind == TypeKind.TYPE_ERROR_UNION && fix_parent.error_union_payload_type != null {
            if str_equals(expr.member_access_field_name, "value" as *byte) != 0 {
                inferred = fix_parent.error_union_payload_type[0];
            } else if str_equals(expr.member_access_field_name, "error_id" as *byte) != 0 {
                inferred = make_u32_type();
            }
        }
    }
    while ctx.checker.scope_level > saved_scope_level {
        checker_exit_scope(ctx.checker);
    }
    ctx.checker.in_function = prev_in_function;
    ctx.checker.current_function_decl = prev_function_decl;
    ctx.checker.current_return_type = prev_return_type;
    return inferred;
}

fn exec_lower_push_scope(ctx: &ExecLowerContext, scope_owner: &ASTNode, scope_id: i32) i32 {
    if ctx == null {
        return 0;
    }
    if ctx.scope_depth >= EXEC_MAX_SCOPE_DEPTH {
        exec_backend_set_generic_unsupported_error(scope_owner, "exec: lowering scope depth 超过上限" as *byte);
        return 0;
    }
    if ctx.scope_depth >= 0 && ctx.scope_depth < EXEC_MAX_SCOPE_DEPTH {
        ctx.scope_markers[ctx.scope_depth] = ctx.active_local_count;
        ctx.scope_ids[ctx.scope_depth] = scope_id;
    }
    ctx.scope_depth = ctx.scope_depth + 1;
    return 1;
}

fn exec_lower_pop_scope(ctx: &ExecLowerContext) void {
    if ctx == null || ctx.scope_depth <= 0 {
        return;
    }
    ctx.scope_depth = ctx.scope_depth - 1;
    if ctx.scope_depth >= 0 && ctx.scope_depth < EXEC_MAX_SCOPE_DEPTH {
        ctx.active_local_count = ctx.scope_markers[ctx.scope_depth];
        ctx.next_slot = ctx.active_local_count;
        ctx.scope_ids[ctx.scope_depth] = -1;
    }
}

fn exec_lower_current_scope_id(ctx: &ExecLowerContext) i32 {
    if ctx == null || ctx.scope_depth <= 0 {
        return -1;
    }
    const scope_idx: i32 = ctx.scope_depth - 1;
    if scope_idx >= 0 && scope_idx < EXEC_MAX_SCOPE_DEPTH {
        return ctx.scope_ids[scope_idx];
    }
    return -1;
}

fn exec_lower_find_slot(ctx: &ExecLowerContext, name: &byte) i32 {
    if ctx == null || name == null {
        return -1;
    }
    var i: i32 = ctx.active_local_count -| 1;
    while i >= 0 {
        if i >= 0 && i < EXEC_MAX_LOCALS {
            if ctx.local_names[i] != null && str_equals(ctx.local_names[i], name) != 0 {
                return ctx.local_slots[i];
            }
        }
        i = i - 1;
    }
    return -1;
}

fn exec_lower_find_global_slot(ctx: &ExecLowerContext, name: &byte) i32 {
    if ctx == null || name == null {
        return -1;
    }
    var i: i32 = ctx.global_count -| 1;
    while i >= 0 {
        if i >= 0 && i < EXEC_MAX_GLOBALS {
            if ctx.global_names[i] != null && str_equals(ctx.global_names[i], name) != 0 {
                return i;
            }
        }
        i = i - 1;
    }
    return -1;
}

fn exec_lower_find_global_slot_by_decl(ctx: &ExecLowerContext, decl: &ASTNode) i32 {
    if ctx == null || decl == null {
        return -1;
    }
    var i: i32 = 0;
    while i < ctx.global_count {
        if i >= 0 && i < EXEC_MAX_GLOBALS && ctx.global_decls[i] == decl {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn exec_lower_seed_globals(ctx: &ExecLowerContext, globals: &HIRGlobalSlot, global_count: i32) void {
    if ctx == null {
        return;
    }
    ctx.global_count = 0;
    if globals == null || global_count <= 0 {
        return;
    }
    var i: i32 = 0;
    while i < global_count && i < EXEC_MAX_GLOBALS {
        ctx.global_names[i] = globals[i].name;
        ctx.global_decls[i] = globals[i].decl;
        exec_lower_type_slot(ctx, 2, i, EXEC_MAX_GLOBALS)[0] = copy_type(&globals[i].type_ref.type);
        ctx.global_is_const[i] = globals[i].is_const;
        i = i + 1;
    }
    ctx.global_count = i;
}

/// 判断某个函数声明是否是「泛型结构体/联合体的方法」。
///
/// 这类方法体里的 `T` 只有拿到具体类型实参才能折叠（`@size_of` 一类），
/// 所以只能按单态副本降级，原声明不单独降级。
///
/// 参数：`checker` 类型检查器；`decl` 函数声明。
/// 返回值：是泛型结构体方法返回 1，否则 0。
fn exec_lower_is_generic_struct_method(checker: &TypeChecker, decl: &ASTNode) i32 {
    if checker == null || decl == null || decl.type != ASTNodeType.AST_FN_DECL ||
        checker.program_node == null {
        return 0;
    }
    var owner_is_union: i32 = 0;
    const owner_name: &byte = checker_fn_decl_owner_type_name(checker, decl, &owner_is_union);
    if owner_name == null {
        return 0;
    }
    if owner_is_union != 0 {
        const union_decl: &ASTNode = find_union_decl_from_program(checker.program_node, owner_name);
        if union_decl != null && union_decl.union_decl_type_param_count > 0 {
            return 1;
        }
        return 0;
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(checker.program_node, owner_name);
    if struct_decl != null && struct_decl.struct_decl_type_param_count > 0 {
        return 1;
    }
    return 0;
}

/// 在 checker 登记的结构体单态实例里，按结构体名 + 类型实参找实例序号。
///
/// 参数：`checker` 类型检查器；`struct_name` 结构体名；`type_args` 实参类型；
/// `arg_count` 实参个数。
/// 返回值：实例序号；没有登记返回 -1。
fn exec_lower_mono_struct_instance_index(checker: &TypeChecker, struct_name: &byte,
    type_args: &Type, arg_count: i32) i32 {
    if checker == null || struct_name == null || type_args == null || arg_count <= 0 ||
        checker.mono_instances == null {
        return -1;
    }
    var idx: i32 = 0;
    while idx < checker.mono_instance_count {
        const inst: &MonoInstance = &checker.mono_instances[idx];
        if inst.is_function == 0 && inst.generic_name != null &&
            str_equals(inst.generic_name, struct_name) != 0 &&
            inst.type_arg_count == arg_count && inst.type_args != null {
            var same: i32 = 1;
            var ai: i32 = 0;
            while ai < arg_count {
                if type_equals(inst.type_args[ai], type_args[ai]) == 0 {
                    same = 0;
                }
                ai = ai + 1;
            }
            if same != 0 {
                return idx;
            }
        }
        idx = idx + 1;
    }
    return -1;
}

/// 按 `结构体名_方法名$s<序号>` 生成单态副本名。
///
/// 参数：`arena` 分配器；`struct_name` 结构体名；`method_name` 方法名；`index` 实例序号。
/// 返回值：新名字（arena 内）；分配失败时退回方法名。
fn exec_lower_mono_struct_name(arena: &CompilerArena, struct_name: &byte, method_name: &byte, index: i32) &byte {
    if arena == null || method_name == null {
        return method_name;
    }
    const base_len: i32 = strlen(method_name as *byte) as i32;
    var prefix_len: i32 = 0;
    if struct_name != null {
        prefix_len = strlen(struct_name as *byte) as i32 +| 1;
    }
    const buf: &byte = compiler_arena_alloc(arena, (base_len +| prefix_len +| 24) as usize) as &byte;
    if buf == null {
        return method_name;
    }
    if struct_name != null {
        _ = sprintf(buf as *byte, "%s_%s$s%d" as *byte, struct_name as *byte, method_name as *byte, index);
    } else {
        _ = sprintf(buf as *byte, "%s$s%d" as *byte, method_name as *byte, index);
    }
    return buf;
}

/// 取（或新建）某个泛型结构体方法的单态副本声明。
///
/// 参数：`arena` 分配器；`method_decl` 原方法声明；`struct_decl` 结构体声明；
/// `inst_idx` 实例序号；`type_args` 类型实参；`arg_count` 实参个数。
/// 返回值：副本声明（同名同序号的调用点共享同一个指针）。
fn exec_lower_mono_struct_method_decl(arena: &CompilerArena, method_decl: &ASTNode,
    struct_decl: &ASTNode, inst_idx: i32, type_args: &Type, arg_count: i32) &ASTNode {
    if arena == null || method_decl == null || struct_decl == null || type_args == null || arg_count <= 0 {
        return method_decl;
    }
    var i: i32 = 0;
    while i < g_mono_struct_count {
        if i >= 0 && i < EXEC_MAX_MONO_STRUCT_DECLS {
            if g_mono_struct_src[i] == method_decl && g_mono_struct_owner[i] == struct_decl &&
                type_equals(g_mono_struct_arg[i], type_args[0]) != 0 {
                return g_mono_struct_out[i];
            }
        }
        i = i + 1;
    }
    if g_mono_struct_count >= EXEC_MAX_MONO_STRUCT_DECLS {
        return method_decl;
    }
    const copy: &ASTNode = compiler_arena_alloc(arena, @size_of(ASTNode)) as &ASTNode;
    if copy == null {
        return method_decl;
    }
    copy[0] = method_decl[0];
    var owner_name: &byte = null;
    if struct_decl.type == ASTNodeType.AST_STRUCT_DECL {
        owner_name = struct_decl.struct_decl_name;
    } else {
        owner_name = struct_decl.union_decl_name;
    }
    copy.fn_decl_name = exec_lower_mono_struct_name(arena, owner_name, method_decl.fn_decl_name, inst_idx);
    const idx: i32 = g_mono_struct_count;
    if idx < 0 || idx >= EXEC_MAX_MONO_STRUCT_DECLS {
        return copy;
    }
    g_mono_struct_src[idx] = method_decl;
    g_mono_struct_out[idx] = copy;
    g_mono_struct_owner[idx] = struct_decl;
    g_mono_struct_arg[idx] = copy_type(&type_args[0]);
    g_mono_struct_count = idx +| 1;
    if g_mono_struct_pending < g_mono_struct_count {
        g_mono_struct_pending = g_mono_struct_count;
    }
    return copy;
}

/// 按副本声明指针查副本序号。
///
/// 参数：`decl` 函数声明。
/// 返回值：副本序号；不是副本返回 -1。
fn exec_lower_mono_struct_index_of(decl: &ASTNode) i32 {
    if decl == null {
        return -1;
    }
    var i: i32 = 0;
    while i < g_mono_struct_count {
        if i >= 0 && i < EXEC_MAX_MONO_STRUCT_DECLS && g_mono_struct_out[i] == decl {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// 装上某个单态副本的类型参数替换上下文。
///
/// 参数：`checker` 类型检查器；`idx` 副本序号。
/// 返回值：无。
fn exec_lower_install_mono_struct_subst(checker: &TypeChecker, idx: i32) void {
    if checker == null || idx < 0 || idx >= g_mono_struct_count {
        return;
    }
    var struct_decl: &ASTNode = null;
    if idx >= 0 && idx < EXEC_MAX_MONO_STRUCT_DECLS {
        struct_decl = g_mono_struct_owner[idx];
    }
    if struct_decl == null || struct_decl.struct_decl_type_params == null ||
        struct_decl.struct_decl_type_param_count <= 0 {
        return;
    }
    checker.current_type_params = struct_decl.struct_decl_type_params;
    checker.current_type_param_count = struct_decl.struct_decl_type_param_count;
    if idx < 0 || idx >= EXEC_MAX_MONO_STRUCT_DECLS {
        return;
    }
    checker.subst_active = 1;
    checker.subst_name = struct_decl.struct_decl_type_params[0].name;
    checker.subst_type = copy_type(&g_mono_struct_arg[idx]);
}

/// 把还没进可达集合的单态副本补进去。
///
/// 参数：`out_decls` 可达声明数组；`out_count` 当前数量。
/// 返回值：0 成功，-1 超出上限。
fn exec_lower_drain_pending_mono_struct_decls(out_decls: & & ASTNode, out_count: &i32) i32 {
    if out_count == null {
        return -1;
    }
    var i: i32 = 0;
    while i < g_mono_struct_count {
        var copy: &ASTNode = null;
        if i >= 0 && i < EXEC_MAX_MONO_STRUCT_DECLS {
            copy = g_mono_struct_out[i];
        }
        if copy != null && copy.fn_decl_body != null &&
            exec_lower_decl_index(out_decls, out_count[0], copy) < 0 {
            if out_count[0] >= MAX_REACHABLE_FN_DECLS {
                return -1;
            }
            out_decls[out_count[0]] = copy;
            out_count[0] = out_count[0] +| 1;
        }
        i = i + 1;
    }
    g_mono_struct_pending = 0;
    return 0;
}

/// 在程序级方法块里找 `fn drop`（`S { fn drop(self: S) … }` 写法，规范 §12）。
///
/// 参数：`method_block` 形如 `AST_METHOD_BLOCK` 的节点（可为 null）。
/// 返回值：drop 方法声明；没有返回 null。
fn exec_lower_find_drop_in_method_block(method_block: &ASTNode) &ASTNode {
    if method_block == null || method_block.type != ASTNodeType.AST_METHOD_BLOCK ||
        method_block.method_block_methods == null {
        return null;
    }
    var mi: i32 = 0;
    while mi < method_block.method_block_method_count {
        const method: &ASTNode = method_block.method_block_methods[mi];
        if method != null && method.type == ASTNodeType.AST_FN_DECL &&
            method.fn_decl_name != null &&
            str_equals(method.fn_decl_name, "drop" as *byte) != 0 {
            return method;
        }
        mi = mi + 1;
    }
    return null;
}

fn exec_lower_find_named_drop_decl(checker: &TypeChecker, named_type: &byte) &ASTNode {
    if checker == null || checker.program_node == null || named_type == null {
        return null;
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(checker.program_node, named_type);
    if struct_decl != null && struct_decl.struct_decl_methods != null {
        var si: i32 = 0;
        while si < struct_decl.struct_decl_method_count {
            const method: &ASTNode = struct_decl.struct_decl_methods[si];
            if method != null && method.type == ASTNodeType.AST_FN_DECL &&
                method.fn_decl_name != null &&
                str_equals(method.fn_decl_name, "drop" as *byte) != 0 {
                return method;
            }
            si = si + 1;
        }
    }
    const union_decl: &ASTNode = find_union_decl_from_program(checker.program_node, named_type);
    if union_decl != null && union_decl.union_decl_methods != null {
        var ui: i32 = 0;
        while ui < union_decl.union_decl_method_count {
            const method2: &ASTNode = union_decl.union_decl_methods[ui];
            if method2 != null && method2.type == ASTNodeType.AST_FN_DECL &&
                method2.fn_decl_name != null &&
                str_equals(method2.fn_decl_name, "drop" as *byte) != 0 {
                return method2;
            }
            ui = ui + 1;
        }
    }
    // `S { fn drop(self: S) … }`：drop 挂在程序级方法块里，不在结构体声明内。
    var from_block: &ASTNode = exec_lower_find_drop_in_method_block(
        find_method_block_for_struct(checker.program_node, named_type));
    if from_block != null {
        return from_block;
    }
    from_block = exec_lower_find_drop_in_method_block(
        find_method_block_for_union(checker.program_node, named_type));
    if from_block != null {
        return from_block;
    }
    return null;
}

fn exec_lower_find_drop_decl(ctx: &ExecLowerContext, decl: &ASTNode, type: &Type) &ASTNode {
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null || type == null {
        return null;
    }
    const checker: &TypeChecker = ctx.checker;
    if decl != null && decl.type == ASTNodeType.AST_VAR_DECL && decl.var_decl_type != null &&
        decl.var_decl_type.type == ASTNodeType.AST_TYPE_NAMED && decl.var_decl_type.type_named_name != null {
        const by_decl: &ASTNode = exec_lower_find_named_drop_decl(checker, decl.var_decl_type.type_named_name);
        if by_decl != null {
            // 泛型结构体（`Vec<i32>`）的 drop 也要换成对应实例的单态副本。
            return exec_lower_specialize_struct_method(ctx, by_decl, decl.var_decl_type.type_named_name, type);
        }
    }
    const struct_name: &byte = type_get_struct_name(type);
    if struct_name != null {
        const drop_decl2: &ASTNode = exec_lower_find_named_drop_decl(checker, struct_name);
        return exec_lower_specialize_struct_method(ctx, drop_decl2, struct_name, type);
    }
    const union_name: &byte = type_get_union_name(type);
    if union_name != null {
        const drop_decl3: &ASTNode = exec_lower_find_named_drop_decl(checker, union_name);
        return exec_lower_specialize_struct_method(ctx, drop_decl3, union_name, type);
    }
    return null;
}

/// 单态副本的声明返回类型按实例实参替换后的具体类型。
///
/// `Vec<EnvOverlayOp>.get` 的声明返回类型是 `!T`，调用点若无替换上下文会
/// 得到 `!T` 这种占位类型，`try` 之后就和函数签名的 `!EnvOverlayOp` 对不上。
///
/// 参数：`ctx` lowering 上下文；`decl` 方法声明（单态副本）；`owner_type` 接收者类型。
/// 返回值：替换后的返回类型；不适用或不可表示时返回 void。
fn exec_lower_resolve_mono_method_type(ctx: &ExecLowerContext, decl: &ASTNode, owner_type: &Type) Type {
    if ctx == null || ctx.checker == null || decl == null || owner_type == null ||
        decl.fn_decl_return_type == null {
        return make_void_type();
    }
    const idx: i32 = exec_lower_mono_struct_index_of(decl);
    if idx < 0 || idx >= EXEC_MAX_MONO_STRUCT_DECLS {
        return make_void_type();
    }
    const saved_active: i32 = ctx.checker.subst_active;
    const saved_name: &byte = ctx.checker.subst_name;
    const saved_type: Type = copy_type(&ctx.checker.subst_type);
    const saved_params: &TypeParam = ctx.checker.current_type_params;
    const saved_param_count: i32 = ctx.checker.current_type_param_count;
    exec_lower_install_mono_struct_subst(ctx.checker, idx);
    const resolved: Type = type_from_ast(ctx.checker, decl.fn_decl_return_type);
    ctx.checker.subst_active = saved_active;
    ctx.checker.subst_name = saved_name;
    ctx.checker.subst_type = copy_type(&saved_type);
    ctx.checker.current_type_params = saved_params;
    ctx.checker.current_type_param_count = saved_param_count;
    if exec_type_is_vm_value_supported(resolved) == 0 {
        return make_void_type();
    }
    return resolved;
}

/// 取 `Box<i32>.wrap(...)` 这类「类型名.静态方法」调用里接收者的具体类型。
///
/// 参数：`ctx` lowering 上下文；`expr` 调用表达式（callee 是成员访问）。
/// 返回值：接收者类型（`Box<i32>`）；解析不出来返回 void 类型。
fn exec_lower_static_receiver_type(ctx: &ExecLowerContext, expr: &ASTNode) Type {
    var result: Type = make_void_type();
    if ctx == null || expr == null || expr.call_expr_callee == null ||
        expr.call_expr_callee.type != ASTNodeType.AST_MEMBER_ACCESS ||
        expr.call_expr_callee.member_access_object == null {
        return result;
    }
    const recv: &ASTNode = expr.call_expr_callee.member_access_object;
    if recv.type != ASTNodeType.AST_TYPE_NAMED || recv.type_named_name == null {
        return result;
    }
    var result2: Type = type_from_ast(ctx.checker, recv);
    // parser 在某些上下文（如 `try f(Box<i32>.get(v), 21)`）里不会把 `<i32>`
    // 记到接收者节点上；此时用第一个实参的类型（UFCS 的接收者）补出类型实参。
    if result2.struct_type_arg_count <= 0 && expr.call_expr_arg_count > 0 &&
        expr.call_expr_args != null && expr.call_expr_args[0] != null {
        var arg_type: Type = exec_lower_expr_type(ctx, expr.call_expr_args[0]);
        if arg_type.kind == TypeKind.TYPE_POINTER && arg_type.pointer_to != null {
            arg_type = arg_type.pointer_to[0];
        }
        if arg_type.kind == TypeKind.TYPE_STRUCT && arg_type.struct_name != null &&
            recv.type_named_name != null &&
            str_equals(arg_type.struct_name, recv.type_named_name) != 0 &&
            arg_type.struct_type_arg_count > 0 {
            result2 = arg_type;
        }
    }
    return result2;
}

/// 如果类型是带类型实参的泛型结构体，把方法声明换成对应实例的单态副本。
///
/// 参数：`ctx` lowering 上下文；`method_decl` 原方法声明；`owner_name` 结构体/联合体名；
/// `owner_type` 带类型实参的接收者类型。
/// 返回值：单态副本声明；不适用时返回原声明。
fn exec_lower_specialize_struct_method(ctx: &ExecLowerContext, method_decl: &ASTNode,
    owner_name: &byte, owner_type: &Type) &ASTNode {
    if ctx == null || method_decl == null || owner_name == null || owner_type == null {
        return method_decl;
    }
    var type_args: &Type = null;
    var arg_count: i32 = 0;
    var struct_decl: &ASTNode = null;
    var receiver_type: Type = owner_type[0];
    if receiver_type.kind == TypeKind.TYPE_POINTER && receiver_type.pointer_to != null {
        receiver_type = receiver_type.pointer_to[0];
    }
    if receiver_type.kind == TypeKind.TYPE_STRUCT && receiver_type.struct_type_args != null {
        type_args = receiver_type.struct_type_args;
        arg_count = receiver_type.struct_type_arg_count;
        struct_decl = find_struct_decl_from_program(ctx.checker.program_node, owner_name);
    } else if receiver_type.kind == TypeKind.TYPE_UNION && receiver_type.union_type_args != null {
        type_args = receiver_type.union_type_args;
        arg_count = receiver_type.union_type_arg_count;
        struct_decl = find_union_decl_from_program(ctx.checker.program_node, owner_name);
    }
    if struct_decl == null && owner_name != null {
        struct_decl = find_struct_decl_from_program(ctx.checker.program_node, owner_name);
    }
    if type_args == null || arg_count <= 0 || struct_decl == null ||
        struct_decl.struct_decl_type_params == null || struct_decl.struct_decl_type_param_count <= 0 {
        // `self: &Self` 上的方法调用没有类型实参：继承当前正在降级的单态副本。
        if struct_decl != null && g_mono_struct_current >= 0 &&
            g_mono_struct_current < EXEC_MAX_MONO_STRUCT_DECLS &&
            g_mono_struct_owner[g_mono_struct_current] == struct_decl {
            const inherit_args: &Type = &g_mono_struct_arg[g_mono_struct_current] as &Type;
            return exec_lower_mono_struct_method_decl(ctx.arena, method_decl, struct_decl,
                g_mono_struct_current, inherit_args, 1);
        }
        return method_decl;
    }
    const inst_idx: i32 = exec_lower_mono_struct_instance_index(ctx.checker, owner_name, type_args, arg_count);
    if inst_idx < 0 {
        return method_decl;
    }
    return exec_lower_mono_struct_method_decl(ctx.arena, method_decl, struct_decl, inst_idx, type_args, arg_count);
}

fn exec_lower_append_local(ctx: &ExecLowerContext, decl: &ASTNode, name: &byte, type: &Type, is_param: i32) i32 {
    if ctx == null || name == null || ctx.active_local_count >= EXEC_MAX_LOCALS || ctx.next_slot >= EXEC_MAX_LOCALS {
        return -1;
    }
    const slot: i32 = ctx.next_slot;
    var scope_id: i32 = -1;
    var needs_drop: i32 = 0;
    var drop_decl: &ASTNode = null;
    if is_param == 0 {
        scope_id = exec_lower_current_scope_id(ctx);
        drop_decl = exec_lower_find_drop_decl(ctx, decl, type);
        if checker_type_has_drop_method(ctx.checker, type) != 0 &&
            (decl == null || decl.var_decl_was_moved == 0) {
            needs_drop = 1;
        }
    }
    if ctx.active_local_count >= 0 && ctx.active_local_count < EXEC_MAX_LOCALS {
        ctx.local_names[ctx.active_local_count] = name;
        ctx.local_slots[ctx.active_local_count] = slot;
        exec_lower_type_slot(ctx, 1, ctx.active_local_count, EXEC_MAX_LOCALS)[0] = copy_type(type);
        ctx.local_is_param[ctx.active_local_count] = is_param;
    }
    if slot >= 0 && slot < EXEC_MAX_LOCALS {
        ctx.slot_names[slot] = name;
        ctx.slot_decls[slot] = decl;
        exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0] = copy_type(type);
        ctx.slot_is_param[slot] = is_param;
        ctx.slot_scope_ids[slot] = scope_id;
        ctx.slot_needs_drop[slot] = needs_drop;
        ctx.slot_drop_decls[slot] = drop_decl;
        // 字段级 drop 的单态声明：`Vec<byte>` 这类实例的 drop 必须在 lowering
        // 阶段就换成对应实参的特化副本，构建期只剩指针匹配。
        var fdc: i32 = 0;
        if is_param == 0 && needs_drop != 0 && type != null && type.kind == TypeKind.TYPE_STRUCT &&
            type.struct_name != null {
            const fdc_struct: &ASTNode = find_struct_decl_from_program(ctx.checker.program_node, type.struct_name);
            if fdc_struct != null && fdc_struct.struct_decl_fields != null &&
                fdc_struct.struct_decl_field_count <= 4 {
                var fdi: i32 = 0;
                while fdi < fdc_struct.struct_decl_field_count {
                    const fdc_field: &ASTNode = fdc_struct.struct_decl_fields[fdi];
                    if fdc_field != null && fdc_field.var_decl_type != null {
                        var fdc_type: Type = exec_lower_subst_struct_field_type(ctx.checker, type, fdc_struct, fdc_field);
                        if fdc_type.kind == TypeKind.TYPE_VOID {
                            fdc_type = type_from_ast(ctx.checker, fdc_field.var_decl_type);
                        }
                        const fdc_drop: &ASTNode = exec_lower_find_drop_decl(ctx, fdc_field, &fdc_type);
                        if fdc_drop != null && fdc < 4 && slot * 4 + fdc < EXEC_MAX_LOCALS * 4 {
                            ctx.slot_field_drop_indices[slot * 4 + fdc] = fdi;
                            ctx.slot_field_drop_decls[slot * 4 + fdc] = fdc_drop;
                            fdc = fdc + 1;
                        }
                    }
                    fdi = fdi + 1;
                }
            }
        }
        ctx.slot_field_drop_count[slot] = fdc;
    }
    ctx.active_local_count = ctx.active_local_count + 1;
    ctx.next_slot = slot + 1;
    if ctx.next_slot > ctx.max_slot_count {
        ctx.max_slot_count = ctx.next_slot;
    }
    return slot;
}

fn exec_lower_alloc_scope_id(ctx: &ExecLowerContext) i32 {
    if ctx == null {
        return -1;
    }
    const scope_id: i32 = ctx.next_scope_id;
    ctx.next_scope_id = ctx.next_scope_id +| 1;
    return scope_id;
}

fn exec_lower_make_type_ref(type: &Type) HIRTypeRef {
    return HIRTypeRef {
        type: copy_type(type),
    };
}

fn exec_lower_alloc_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, kind: HIRExprKind, type: &Type) &HIRExpr {
    const expr: &HIRExpr = compiler_arena_alloc(ctx.arena, @size_of(HIRExpr)) as &HIRExpr;
    if expr == null {
        exec_backend_set_error(ast_node, "exec: HIRExpr 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(expr as *byte, 0, @size_of(HIRExpr));
    expr.kind = kind;
    expr.ast_node = ast_node;
    expr.type_ref = exec_lower_make_type_ref(type);
    expr.local_slot = -1;
    expr.global_slot = -1;
    return expr;
}

fn exec_lower_alloc_stmt(ctx: &ExecLowerContext, ast_node: &ASTNode, kind: HIRStmtKind) &HIRStmt {
    const stmt: &HIRStmt = compiler_arena_alloc(ctx.arena, @size_of(HIRStmt)) as &HIRStmt;
    if stmt == null {
        exec_backend_set_error(ast_node, "exec: HIRStmt 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(stmt as *byte, 0, @size_of(HIRStmt));
    stmt.kind = kind;
    stmt.ast_node = ast_node;
    stmt.scope_id = -1;
    stmt.local_slot = -1;
    return stmt;
}

fn exec_lower_alloc_scope_stmt(ctx: &ExecLowerContext, ast_node: &ASTNode, kind: HIRStmtKind, scope_id: i32) &HIRStmt {
    const stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, ast_node, kind);
    if stmt == null {
        return null;
    }
    stmt.scope_id = scope_id;
    return stmt;
}

fn exec_lower_alloc_scope_stmt_raw(arena: &CompilerArena, ast_node: &ASTNode, kind: HIRStmtKind, scope_id: i32) &HIRStmt {
    const stmt: &HIRStmt = compiler_arena_alloc(arena, @size_of(HIRStmt)) as &HIRStmt;
    if stmt == null {
        exec_backend_set_error(ast_node, "exec: HIRStmt 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(stmt as *byte, 0, @size_of(HIRStmt));
    stmt.kind = kind;
    stmt.ast_node = ast_node;
    stmt.scope_id = scope_id;
    stmt.local_slot = -1;
    return stmt;
}

fn exec_lower_alloc_scoped_block(ctx: &ExecLowerContext, ast_node: &ASTNode, body_stmt_count: i32) &HIRBlock {
    if ctx == null || body_stmt_count < 0 {
        return null;
    }
    const scope_id: i32 = exec_lower_alloc_scope_id(ctx);
    if scope_id < 0 {
        exec_backend_set_error(ast_node, "exec: scope id 分配失败" as *byte, 0);
        return null;
    }
    const total_stmt_count: i32 = body_stmt_count +| 2;
    const block: &HIRBlock = compiler_arena_alloc(ctx.arena, @size_of(HIRBlock)) as &HIRBlock;
    const stmts: & & HIRStmt = compiler_arena_alloc(ctx.arena, @size_of(&HIRStmt) * total_stmt_count as usize) as & & HIRStmt;
    if block == null || stmts == null {
        exec_backend_set_error(ast_node, "exec: HIRBlock 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(block as *byte, 0, @size_of(HIRBlock));
    block.scope_id = scope_id;
    block.stmts = stmts;
    block.stmt_count = total_stmt_count;
    const enter_stmt: &HIRStmt = exec_lower_alloc_scope_stmt(ctx, ast_node, HIRStmtKind.HIR_STMT_SCOPE_ENTER, scope_id);
    const exit_stmt: &HIRStmt = exec_lower_alloc_scope_stmt(ctx, ast_node, HIRStmtKind.HIR_STMT_SCOPE_EXIT, scope_id);
    if enter_stmt == null || exit_stmt == null {
        return null;
    }
    stmts[0] = enter_stmt;
    stmts[total_stmt_count -| 1] = exit_stmt;
    return block;
}

fn exec_lower_alloc_scoped_block_raw(arena: &CompilerArena, ast_node: &ASTNode, scope_id: i32, body_stmt_count: i32) &HIRBlock {
    if arena == null || body_stmt_count < 0 {
        return null;
    }
    const total_stmt_count: i32 = body_stmt_count +| 2;
    const block: &HIRBlock = compiler_arena_alloc(arena, @size_of(HIRBlock)) as &HIRBlock;
    const stmts: & & HIRStmt = compiler_arena_alloc(arena, @size_of(&HIRStmt) * total_stmt_count as usize) as & & HIRStmt;
    if block == null || stmts == null {
        exec_backend_set_error(ast_node, "exec: HIRBlock 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(block as *byte, 0, @size_of(HIRBlock));
    block.scope_id = scope_id;
    block.stmts = stmts;
    block.stmt_count = total_stmt_count;
    const enter_stmt: &HIRStmt = exec_lower_alloc_scope_stmt_raw(arena, ast_node, HIRStmtKind.HIR_STMT_SCOPE_ENTER, scope_id);
    const exit_stmt: &HIRStmt = exec_lower_alloc_scope_stmt_raw(arena, ast_node, HIRStmtKind.HIR_STMT_SCOPE_EXIT, scope_id);
    if enter_stmt == null || exit_stmt == null {
        return null;
    }
    stmts[0] = enter_stmt;
    stmts[total_stmt_count -| 1] = exit_stmt;
    return block;
}

fn exec_lower_extract_block_result_expr(ctx: &ExecLowerContext, block: &ASTNode, out_prefix_block: & & HIRBlock, require_return_stmt: i32) &HIRExpr {
    if out_prefix_block != null {
        out_prefix_block[0] = null;
    }
    if block == null || block.type != ASTNodeType.AST_BLOCK || block.block_stmts == null || block.block_stmt_count <= 0 {
        return exec_lower_fail_expr(block, "exec: catch/match 分支块为空" as *byte);
    }
    const tail_stmt: &ASTNode = exec_lower_block_last_stmt(block);
    if tail_stmt == null {
        return exec_lower_fail_expr(block, "exec: catch/match 分支块为空" as *byte);
    }
    if block.block_stmt_count > 1 && out_prefix_block != null {
        out_prefix_block[0] = exec_lower_make_block_prefix(ctx, block);
        if out_prefix_block[0] == null {
            return null;
        }
    }
    if tail_stmt.type == ASTNodeType.AST_RETURN_STMT {
        if tail_stmt.return_stmt_expr == null {
            return exec_lower_fail_expr(block, "exec: catch/match 分支块尾部缺少返回值" as *byte);
        }
        return exec_lower_expr(ctx, tail_stmt.return_stmt_expr);
    }
    if require_return_stmt != 0 {
        return exec_lower_fail_expr(block, "exec: 当前仅支持以 return 结束的 returning match 分支块" as *byte);
    }
    if tail_stmt.type == ASTNodeType.AST_IF_STMT && tail_stmt.if_stmt_else_branch == null {
        // 分支块以「无 else 的 if」这类语句收尾：整块按语句执行，结果用 void 零值占位
        // （C99 侧这种 match 就是语句/void match，不是表达式）。
        if out_prefix_block != null {
            out_prefix_block[0] = exec_lower_block(ctx, block);
            if out_prefix_block[0] == null {
                return null;
            }
        }
        const void_tail_type: Type = make_void_type();
        return exec_lower_make_zero_expr(ctx, tail_stmt, &void_tail_type);
    }
    return exec_lower_expr(ctx, tail_stmt);
}

fn exec_lower_block_last_stmt(block: &ASTNode) &ASTNode {
    if block == null || block.type != ASTNodeType.AST_BLOCK || block.block_stmts == null || block.block_stmt_count <= 0 {
        return null;
    }
    return block.block_stmts[block.block_stmt_count - 1];
}

fn exec_lower_match_arm_return_expr(arm: &ASTMatchArm) &ASTNode {
    if arm == null || arm.result_expr == null {
        return null;
    }
    if arm.result_is_block == 0 {
        return arm.result_expr;
    }
    const block: &ASTNode = arm.result_expr;
    const tail_stmt: &ASTNode = exec_lower_block_last_stmt(block);
    if tail_stmt == null || tail_stmt.type != ASTNodeType.AST_RETURN_STMT || tail_stmt.return_stmt_expr == null {
        return null;
    }
    return tail_stmt.return_stmt_expr;
}

fn exec_lower_match_arm_result_node(arm: &ASTMatchArm) &ASTNode {
    if arm == null || arm.result_expr == null {
        return null;
    }
    if arm.result_is_block == 0 {
        return arm.result_expr;
    }
    const block: &ASTNode = arm.result_expr;
    const tail_stmt: &ASTNode = exec_lower_block_last_stmt(block);
    if tail_stmt == null {
        return null;
    }
    if tail_stmt.type == ASTNodeType.AST_RETURN_STMT {
        if tail_stmt.return_stmt_expr == null {
            return null;
        }
        return tail_stmt.return_stmt_expr;
    }
    return tail_stmt;
}

fn exec_lower_infer_match_expr_type(ctx: &ExecLowerContext, expr: &ASTNode) Type {
    if ctx == null || expr == null || expr.type != ASTNodeType.AST_MATCH_EXPR ||
        expr.match_expr_arms == null || expr.match_expr_arm_count <= 0 {
        return make_void_type();
    }
    const subject_type: Type = exec_lower_resolve_exact_type(ctx, expr.match_expr_expr);
    var unified: Type = make_void_type();
    var first: i32 = 1;
    var i: i32 = 0;
    while i < expr.match_expr_arm_count {
        const arm: ASTMatchArm = expr.match_expr_arms[i];
        const arm_expr: &ASTNode = exec_lower_match_arm_result_node(expr.match_expr_arms + i);
        if arm_expr == null {
            return make_void_type();
        }
        var arm_type: Type = make_void_type();
        if arm.kind == MatchPatternKind.MATCH_PAT_UNION &&
            arm.variant_name != null &&
            subject_type.kind == TypeKind.TYPE_UNION {
            if exec_lower_push_scope(ctx, arm_expr, -1) == 0 {
                return make_void_type();
            }
            if arm.var_name != null && str_equals(arm.var_name, "_" as *byte) == 0 {
                const bind_type: Type = exec_lower_union_variant_type(ctx, copy_type(&subject_type), arm.variant_name);
                if bind_type.kind == TypeKind.TYPE_VOID {
                    exec_lower_pop_scope(ctx);
                    return make_void_type();
                }
                if exec_lower_append_local(ctx, null, arm.var_name, &bind_type, 0) < 0 {
                    exec_lower_pop_scope(ctx);
                    return make_void_type();
                }
            }
            arm_type = exec_lower_resolve_exact_type(ctx, arm_expr);
            exec_lower_pop_scope(ctx);
        } else {
            arm_type = exec_lower_resolve_exact_type(ctx, arm_expr);
        }
        if first != 0 {
            unified = copy_type(&arm_type);
            first = 0;
        } else {
            if unified.kind == TypeKind.TYPE_INT_LIMIT && is_integer_type(arm_type.kind) != 0 {
                unified = copy_type(&arm_type);
            } else if arm_type.kind == TypeKind.TYPE_INT_LIMIT && is_integer_type(unified.kind) != 0 {
                arm_type = copy_type(&unified);
            }
            if type_equals(unified, copy_type(&arm_type)) == 0 {
                return make_void_type();
            }
        }
        i = i + 1;
    }
    return unified;
}

fn exec_lower_make_returning_match_expr(ctx: &ExecLowerContext, expr: &ASTNode) &ASTNode {
    if ctx == null || expr == null || expr.type != ASTNodeType.AST_MATCH_EXPR ||
        expr.match_expr_arms == null || expr.match_expr_arm_count <= 0 {
        return null;
    }
    const synthetic_expr: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
    const synthetic_arms: &ASTMatchArm = compiler_arena_alloc(ctx.arena, @size_of(ASTMatchArm) * expr.match_expr_arm_count as usize) as &ASTMatchArm;
    if synthetic_expr == null || synthetic_arms == null {
        exec_backend_set_error(expr, "exec: returning match synthetic node 分配失败" as *byte, 0);
        return null;
    }
    synthetic_expr[0] = expr[0];
    synthetic_expr.match_expr_arms = synthetic_arms;
    var i: i32 = 0;
    while i < expr.match_expr_arm_count {
        synthetic_arms[i] = expr.match_expr_arms[i];
        const arm_expr: &ASTNode = exec_lower_match_arm_return_expr(expr.match_expr_arms + i);
        if arm_expr == null {
            return null;
        }
        synthetic_arms[i].result_expr = arm_expr;
        synthetic_arms[i].result_is_block = 0;
        i = i + 1;
    }
    return synthetic_expr;
}

fn exec_lower_try_make_returning_match_stmt(ctx: &ExecLowerContext, stmt_node: &ASTNode) &HIRStmt {
    if ctx == null || stmt_node == null || stmt_node.type != ASTNodeType.AST_MATCH_EXPR {
        return null;
    }
    // void match（分支都是语句、含 return/空块）按语句 lowering：
    // 各分支的 return 自己生效，不能把整个 match 包成 `return match`。
    const match_type: Type = exec_lower_expr_type(ctx, stmt_node);
    if match_type.kind == TypeKind.TYPE_VOID {
        return null;
    }
    const stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_RETURN);
    if stmt == null {
        return null;
    }
    if ctx.function_decl != null && ctx.function_decl.fn_decl_return_type != null {
        const return_type: Type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
        stmt.expr = exec_lower_expr(ctx, stmt_node);
        if stmt.expr != null &&
            return_type.kind != TypeKind.TYPE_ERROR_UNION &&
            type_equals(stmt.expr.type_ref.type, return_type) == 0 &&
            exec_type_is_vm_value_supported(return_type) != 0 {
            const cast_return: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_CAST, &return_type);
            if cast_return == null {
                return null;
            }
            cast_return.left = stmt.expr;
            stmt.expr = cast_return;
        }
    } else {
        stmt.expr = exec_lower_expr(ctx, stmt_node);
    }
    if stmt.expr == null {
        return null;
    }
    return stmt;
}

/// catch lowering 收尾：按 LIFO 依次弹出前缀块作用域与 `|e|` 绑定作用域。
///
/// 前缀块为了保留局部变量给尾语句用，降完后没有自行弹栈，所以这里补弹。
///
/// 参数：`bind_scope` 非 0 表示开了 `|e|` 绑定作用域；
/// `prefix_scope` 非 0 表示前缀块作用域仍未弹出。
/// 返回值：无。
fn exec_lower_catch_exit_scopes(ctx: &ExecLowerContext, bind_scope: i32, prefix_scope: i32) void {
    if ctx == null {
        return;
    }
    if prefix_scope != 0 {
        exec_lower_pop_scope(ctx);
    }
    if bind_scope != 0 {
        exec_lower_pop_scope(ctx);
    }
}

fn exec_lower_make_block_prefix(ctx: &ExecLowerContext, block: &ASTNode) &HIRBlock {
    if ctx != null {
        ctx.catch_prefix_scope_open = 0;
    }
    if ctx == null || block == null || block.type != ASTNodeType.AST_BLOCK || block.block_stmts == null {
        return null;
    }
    if block.block_stmt_count <= 1 {
        return null;
    }
    const prefix_count: i32 = block.block_stmt_count - 1;
    const synthetic_block: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
    const synthetic_stmts: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode) * prefix_count as usize) as & & ASTNode;
    if synthetic_block == null || synthetic_stmts == null {
        exec_backend_set_error(block, "exec: catch 前缀 block 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(synthetic_block as *byte, 0, @size_of(ASTNode));
    synthetic_block.type = ASTNodeType.AST_BLOCK;
    synthetic_block.line = block.line;
    synthetic_block.column = block.column;
    synthetic_block.filename = block.filename;
    synthetic_block.block_stmts = synthetic_stmts;
    synthetic_block.block_stmt_count = prefix_count;
    var i: i32 = 0;
    while i < prefix_count {
        synthetic_stmts[i] = block.block_stmts[i];
        i = i + 1;
    }
    const saved_keep: &ASTNode = ctx.keep_scope_block;
    ctx.keep_scope_block = synthetic_block;
    const prefix_block: &HIRBlock = exec_lower_block(ctx, synthetic_block);
    ctx.keep_scope_block = saved_keep;
    if prefix_block != null {
        // 前缀里声明的局部变量要留给尾语句用，作用域由 catch lowering 收尾时弹出。
        ctx.catch_prefix_scope_open = 1;
    }
    return prefix_block;
}

fn exec_lower_make_bool_const_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, value: i32) &HIRExpr {
    const bool_type: Type = make_bool_type();
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_CONST, &bool_type);
    if expr == null {
        return null;
    }
    expr.bool_value = value;
    return expr;
}

/// 把整数字面量按目标整数宽度归一化（符号扩展 / 截断）。
///
/// 字面量在 AST 里是「能放下就算」的 u64：`const x: i32 = 0xDEAD_BEEF` 得到
/// 3735928559，而 `%d` 打印时被截断成 -559038737，于是 `x == -559038737`
/// 在解释器里为假（C99 后端是 i32 常量，恒为真）。
///
/// 只在字面量确实落在 32 位以内（或 i32 的无符号位模式）时才归一化：像
/// `v > 922337203685477580` 这种和 i64 比较的大字面量，checker 有时仍给 i32
/// 类型，按 i32 截断会把阈值改成负数。
///
/// 参数：`type` 目标类型；`value` 原始常量值。
/// 返回值：归一化后的值（非窄整数类型、超宽字面量原样返回）。
fn exec_lower_normalize_int_const(type: &Type, value: i64) i64 {
    if type == null {
        return value;
    }
    if type.kind == TypeKind.TYPE_I8 || type.kind == TypeKind.TYPE_I16 ||
        type.kind == TypeKind.TYPE_I32 {
        const raw: u64 = value as u64;
        // 超出 32 位的字面量（含负数的补码）在 C99 里按 long long 参与运算，
        // checker 有时仍给 i32 类型，按 i32 截断会把阈值
        // （如 `v > 922337203685477580`、SHA-384 的 0xcbbb9d5dc1059ed8）改坏。
        if raw > (0xFFFFFFFF as u64) {
            return value;
        }
        if type.kind == TypeKind.TYPE_I8 {
            const m8: u64 = raw & (0xFF as u64);
            if m8 >= (0x80 as u64) {
                return (m8 as i64) - 256;
            }
            return m8 as i64;
        }
        if type.kind == TypeKind.TYPE_I16 {
            const m16: u64 = raw & (0xFFFF as u64);
            if m16 >= (0x8000 as u64) {
                return (m16 as i64) - 65536;
            }
            return m16 as i64;
        }
        const m32: u64 = raw & (0xFFFFFFFF as u64);
        if m32 >= (0x80000000 as u64) {
            return (m32 as i64) - (0x100000000 as i64);
        }
        return m32 as i64;
    }
    if type.kind == TypeKind.TYPE_U8 || type.kind == TypeKind.TYPE_BYTE {
        return ((value as u64) & (0xFF as u64)) as i64;
    }
    if type.kind == TypeKind.TYPE_U16 {
        return ((value as u64) & (0xFFFF as u64)) as i64;
    }
    if type.kind == TypeKind.TYPE_U32 {
        if value > (4294967295 as i64) {
            return value;
        }
        return ((value as u64) & (0xFFFFFFFF as u64)) as i64;
    }
    return value;
}

/// 数字字面量常量：先按目标宽度归一化再建常量。
///
/// 只在「有明确声明类型」的位置使用（`const x: i32 = 0xDEAD_BEEF`）。普通
/// 表达式里的 NUMBER 不走这条路径：checker 常把和 u64 比较的大字面量也标成
/// i32，按 i32 截断会把 `g == 4000000000` 判假。
///
/// 参数：`ctx` 上下文；`ast_node` 字面量节点；`type` 目标类型；`raw` 原始值。
/// 返回值：常量表达式。
fn exec_lower_make_number_const(ctx: &ExecLowerContext, ast_node: &ASTNode, type: &Type, raw: i64) &HIRExpr {
    return exec_lower_make_int_const_expr(ctx, ast_node, type, exec_lower_normalize_int_const(type, raw));
}

fn exec_lower_make_int_const_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, type: &Type, value: i64) &HIRExpr {
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_CONST, type);
    if expr == null {
        return null;
    }
    expr.int_value = value;
    return expr;
}

fn exec_lower_make_float_const_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, type: &Type, value: f64) &HIRExpr {
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_CONST, type);
    if expr == null {
        return null;
    }
    expr.float_value = value;
    return expr;
}

/// 用 TypeKind 编码构造只带 kind 的类型（checked 算术的载荷类型由 checker 记录）。
/// 参数：kind_code TypeKind 的整数编码。
/// 返回值：对应 Type；未知编码返回 void 类型。
fn exec_lower_type_from_kind_code(kind_code: i32) Type {
    var t: Type = make_void_type();
    if kind_code >= 0 && kind_code <= 32 {
        t.kind = kind_code as TypeKind;
    }
    return t;
}

/// 把 checked 整数算术树 lower 成溢出受检的 HIR。
/// 参数：ctx 降级上下文；node 算术 AST 节点；value_type 运算结果类型。
/// 返回值：HIR 表达式；非受检算术节点退化为普通 lowering 结果。
fn exec_lower_checked_arith_tree(ctx: &ExecLowerContext, node: &ASTNode, value_type: &Type) &HIRExpr {
    if ctx == null || node == null || value_type == null {
        return null;
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR && node.unary_expr_operand != null &&
        node.unary_expr_op == TokenType.TOKEN_MINUS as i32 {
        // 字面量取负在编译期折叠：`-2147483648` 的 AST 是「负号 + 2147483648」，
        // 按运行时 `0 -| x` 处理会撞 i32 溢出并饱和成 2147483647，与 C99
        // （常量按 long 求值）不一致。
        // 字面量取负在编译期折叠：`-2147483648` 的 AST 是「负号 + 2147483648」。
        // `-x` 的溢出等价于 `0 - x`，统一按二元受检减法处理。
        const operand_unary: &HIRExpr = exec_lower_checked_arith_tree(ctx, node.unary_expr_operand, value_type);
        const zero_unary: &HIRExpr = exec_lower_make_int_const_expr(ctx, node, value_type, 0);
        if operand_unary == null || zero_unary == null {
            return null;
        }
        const hir_neg: &HIRExpr = exec_lower_alloc_expr(ctx, node, HIRExprKind.HIR_EXPR_CHECKED_ARITH, value_type);
        if hir_neg == null {
            return null;
        }
        hir_neg.binary_op = TokenType.TOKEN_MINUS as i32;
        hir_neg.left = zero_unary;
        hir_neg.right = operand_unary;
        return hir_neg;
    }
    var is_checked_binary: i32 = 0;
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        if node.binary_expr_op == TokenType.TOKEN_PLUS as i32 ||
            node.binary_expr_op == TokenType.TOKEN_MINUS as i32 ||
            node.binary_expr_op == TokenType.TOKEN_ASTERISK as i32 ||
            node.binary_expr_op == TokenType.TOKEN_SLASH as i32 ||
            node.binary_expr_op == TokenType.TOKEN_PERCENT as i32 {
            is_checked_binary = 1;
        }
    }
    if is_checked_binary == 0 {
        return exec_lower_expr(ctx, node);
    }
    const left_tree: &HIRExpr = exec_lower_checked_arith_tree(ctx, node.binary_expr_left, value_type);
    if left_tree == null {
        return null;
    }
    const right_tree: &HIRExpr = exec_lower_checked_arith_tree(ctx, node.binary_expr_right, value_type);
    if right_tree == null {
        return null;
    }
    const hir_binary: &HIRExpr = exec_lower_alloc_expr(ctx, node, HIRExprKind.HIR_EXPR_CHECKED_ARITH, value_type);
    if hir_binary == null {
        return null;
    }
    hir_binary.binary_op = node.binary_expr_op;
    hir_binary.left = left_tree;
    hir_binary.right = right_tree;
    return hir_binary;
}

fn exec_lower_pointer_pointee_kind(type: &Type) i32 {
    if type == null || type.kind != TypeKind.TYPE_POINTER || type.pointer_to == null {
        return TypeKind.TYPE_VOID as i32;
    }
    if type.pointer_to[0].kind == TypeKind.TYPE_ATOMIC {
        const inner: &Type = type_get_atomic_inner(&type.pointer_to[0]);
        if inner != null {
            return inner[0].kind as i32;
        }
    }
    return type.pointer_to[0].kind as i32;
}

fn exec_lower_make_void_pointer_type() Type {
    return Type {
        kind: TypeKind.TYPE_POINTER,
        data: TypeData.pointer(PointerData {
            pointee: null as &Type,
            is_ffi: 0,
        }),
        enum_name: null,
        interface_name: null,
        interface_type_args: null,
        interface_type_arg_count: 0,
        struct_name: null,
        union_name: null,
        pointer_to: null,
        is_ffi_pointer: 0,
        element_type: null,
        array_size: 0,
        slice_element_type: null,
        slice_len: 0,
        slice_element_is_const: 0,
        tuple_element_types: null,
        tuple_count: 0,
        error_union_payload_type: null,
        error_error_id: 0,
        atomic_inner_type: null,
        generic_param_name: null,
        struct_type_args: null,
        struct_type_arg_count: 0,
        union_type_args: null,
        union_type_arg_count: 0,
    };
}

fn exec_lower_make_string_const_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, type: &Type, value: &byte) &HIRExpr {
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_CONST, type);
    if expr == null {
        return null;
    }
    expr.string_value = value;
    return expr;
}

fn exec_lower_make_zero_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, type: &Type) &HIRExpr {
    return exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_ZERO, type);
}

fn exec_lower_make_bare_return_expr(ctx: &ExecLowerContext, ast_node: &ASTNode) &HIRExpr {
    if ctx == null {
        return null;
    }
    var return_type: Type = make_void_type();
    if ctx.function_decl != null && ctx.function_decl.fn_decl_return_type != null {
        return_type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
    }
    if return_type.kind == TypeKind.TYPE_VOID {
        return exec_lower_make_zero_expr(ctx, ast_node, &return_type);
    }
    if return_type.kind == TypeKind.TYPE_ERROR_UNION &&
        return_type.error_union_payload_type != null &&
        return_type.error_union_payload_type[0].kind == TypeKind.TYPE_VOID {
        const payload_zero: &HIRExpr = exec_lower_make_zero_expr(ctx, ast_node, return_type.error_union_payload_type);
        if payload_zero == null {
            return null;
        }
        const ok_expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_MAKE_OK, &return_type);
        if ok_expr == null {
            return null;
        }
        ok_expr.left = payload_zero;
        return ok_expr;
    }
    return exec_lower_fail_expr(ast_node, "exec: 非 void 函数缺少返回值" as *byte);
}

fn exec_lower_make_repeat_array_init_expr(ctx: &ExecLowerContext, expr: &ASTNode, array_type: &Type) &HIRExpr {
    if ctx == null || expr == null || array_type == null {
        return null;
    }
    if expr.type != ASTNodeType.AST_ARRAY_LITERAL ||
        expr.array_literal_repeat_count_expr == null ||
        expr.array_literal_element_count <= 0 ||
        expr.array_literal_elements == null ||
        array_type.kind != TypeKind.TYPE_ARRAY ||
        array_type.element_type == null {
        return exec_lower_fail_expr(expr, "exec: repeat array literal 目标类型无效" as *byte);
    }
    var repeat_count: i32 = array_type.array_size;
    if repeat_count <= 0 {
        repeat_count = checker_eval_const_expr(ctx.checker, expr.array_literal_repeat_count_expr);
    }
    if repeat_count < 0 {
        return exec_lower_fail_expr(expr, "exec: repeat array literal 次数必须为常量非负值" as *byte);
    }
    const repeated_item: &HIRExpr = exec_lower_coerce_expr(ctx, expr.array_literal_elements[0], array_type.element_type);
    if repeated_item == null {
        return null;
    }
    const repeat_items: & & HIRExpr = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr)) as & & HIRExpr;
    if repeat_items == null {
        exec_backend_set_error(expr, "exec: repeat array literal items 分配失败" as *byte, 0);
        return null;
    }
    repeat_items[0] = repeated_item;
    const hir_repeat_array: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_ARRAY_INIT, array_type);
    if hir_repeat_array == null {
        return null;
    }
    hir_repeat_array.items = repeat_items;
    hir_repeat_array.item_count = 1;
    hir_repeat_array.int_value = repeat_count as i64;
    return hir_repeat_array;
}

fn exec_lower_basename(path: &byte) &byte {
    if path == null {
        return "(unknown)" as &byte;
    }
    var basename: &byte = strrchr(path as *byte, 47) as &byte;
    if basename == null {
        basename = strrchr(path as *byte, 92) as &byte;
    }
    if basename != null {
        return (basename as i64 + 1) as &byte;
    }
    return path;
}

fn exec_lower_known_len(expr_type: &Type) i32 {
    if expr_type == null {
        return -1;
    }
    if expr_type.kind == TypeKind.TYPE_ARRAY {
        const array_len: i32 = type_get_array_size(expr_type);
        if array_len > 0 {
            return array_len;
        }
        if expr_type.array_size > 0 {
            return expr_type.array_size;
        }
        return -1;
    }
    if expr_type.kind == TypeKind.TYPE_SLICE {
        if expr_type.slice_len > 0 {
            return expr_type.slice_len;
        }
    }
    return -1;
}

fn exec_lower_known_len_for_expr(ctx: &ExecLowerContext, expr: &ASTNode) i32 {
    if ctx == null || expr == null {
        return -1;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER && expr.identifier_name != null {
        const local_slot: i32 = exec_lower_find_slot(ctx, expr.identifier_name);
        if local_slot >= 0 && local_slot < EXEC_MAX_LOCALS {
            return exec_lower_known_len(exec_lower_type_slot(ctx, 0, local_slot, EXEC_MAX_LOCALS));
        }
        const global_slot: i32 = exec_lower_find_global_slot(ctx, expr.identifier_name);
        if global_slot >= 0 && global_slot < EXEC_MAX_GLOBALS {
            return exec_lower_known_len(exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS));
        }
    }
    const expr_type: Type = exec_lower_resolve_exact_type(ctx, expr);
    return exec_lower_known_len(&expr_type);
}

fn exec_lower_named_error_literal(expr: &ASTNode) &ASTNode {
    if expr == null {
        return null;
    }
    if expr.type == ASTNodeType.AST_ERROR_VALUE {
        return expr;
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR && expr.cast_expr_expr != null {
        return exec_lower_named_error_literal(expr.cast_expr_expr);
    }
    return null;
}

/// `@params`（函数体内取当前函数的参数元组）。
///
/// 参数在 `exec_lower_function` 里最先入槽，所以第 i 个参数的槽位就是 i；
/// 按声明顺序取槽位就能拼出与 C99 后端一致的元组值。
/// 参数：`ctx` 降级上下文；`ast_node` AST 节点；`type` 元组类型。
/// 返回值：`HIR_EXPR_TUPLE_INIT` 表达式；失败返回 null。
fn exec_lower_params_tuple_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, type: &Type) &HIRExpr {
    const fn_decl: &ASTNode = ctx.function_decl;
    var param_count: i32 = 0;
    if fn_decl != null && fn_decl.type == ASTNodeType.AST_FN_DECL {
        param_count = fn_decl.fn_decl_param_count;
    }
    if param_count < 0 {
        param_count = 0;
    }
    const items: & & HIRExpr = compiler_arena_alloc(ctx.arena,
        @size_of(&HIRExpr) * param_count) as & & HIRExpr;
    if param_count > 0 && items == null {
        return null;
    }
    var i: i32 = 0;
    while i < param_count {
        var elem_type: Type = make_void_type();
        if i < EXEC_MAX_LOCALS {
            elem_type = exec_lower_type_slot(ctx, 0, i, EXEC_MAX_LOCALS)[0];
        }
        const item_expr: &HIRExpr = exec_lower_make_local_expr(ctx, ast_node, i, &elem_type);
        if item_expr == null {
            return null;
        }
        items[i] = item_expr;
        i = i + 1;
    }
    const hir_tuple: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_TUPLE_INIT, type);
    if hir_tuple == null {
        return null;
    }
    hir_tuple.items = items;
    hir_tuple.item_count = param_count;
    return hir_tuple;
}

fn exec_lower_make_local_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, slot: i32, type: &Type) &HIRExpr {
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_LOCAL, type);
    if expr == null {
        return null;
    }
    expr.local_slot = slot;
    return expr;
}

fn exec_lower_make_global_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, slot: i32, type: &Type) &HIRExpr {
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_GLOBAL, type);
    if expr == null {
        return null;
    }
    expr.global_slot = slot;
    return expr;
}

fn exec_lower_make_binary_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, op: i32, left: &HIRExpr, right: &HIRExpr, type: &Type) &HIRExpr {
    const expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_BINARY, type);
    if expr == null {
        return null;
    }
    expr.binary_op = op;
    expr.left = left;
    expr.right = right;
    return expr;
}

fn exec_lower_make_pointer_type_copy(ctx: &ExecLowerContext, pointee_type: Type) Type {
    if ctx == null || ctx.arena == null {
        return exec_lower_make_void_pointer_type();
    }
    const pointee_copy: &Type = compiler_arena_alloc(ctx.arena, @size_of(Type)) as &Type;
    if pointee_copy == null {
        return exec_lower_make_void_pointer_type();
    }
    pointee_copy[0] = copy_type(&pointee_type);
    return make_pointer_type(ctx.arena, pointee_copy, 0);
}

fn exec_lower_add_unique_decl(out_decls: & & ASTNode, out_count: &i32, decl: &ASTNode) i32 {
    if out_count == null || decl == null {
        return -1;
    }
    var i: i32 = 0;
    while i < out_count[0] {
        if out_decls[i] == decl {
            return 0;
        }
        i = i + 1;
    }
    if out_count[0] >= EXEC_MAX_INTERFACE_METHODS {
        return -1;
    }
    out_decls[out_count[0]] = decl;
    out_count[0] = out_count[0] +| 1;
    return 0;
}

fn exec_lower_collect_interface_method_sigs_recursive(ctx: &ExecLowerContext, interface_name: &byte, out_decls: & & ASTNode, out_count: &i32) i32 {
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        interface_name == null || out_count == null {
        return -1;
    }
    const iface: &ASTNode = find_interface_decl_from_program(ctx.checker.program_node, interface_name);
    if iface == null {
        return -1;
    }
    var i: i32 = 0;
    while i < iface.interface_decl_method_sig_count {
        const sig: &ASTNode = iface.interface_decl_method_sigs[i];
        if sig != null && exec_lower_add_unique_decl(out_decls, out_count, sig) != 0 {
            return -1;
        }
        i = i + 1;
    }
    i = 0;
    while i < iface.interface_decl_composed_count {
        const composed_name: &byte = iface.interface_decl_composed_interfaces[i];
        if composed_name != null &&
            exec_lower_collect_interface_method_sigs_recursive(ctx, composed_name, out_decls, out_count) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn exec_lower_collect_interface_method_sigs(ctx: &ExecLowerContext, interface_type: &Type, out_decls: & & ASTNode, out_count: &i32) i32 {
    const interface_name: &byte = type_get_interface_name(interface_type);
    if interface_name == null {
        return -1;
    }
    return exec_lower_collect_interface_method_sigs_recursive(ctx, interface_name, out_decls, out_count);
}

fn exec_lower_interface_method_index(ctx: &ExecLowerContext, interface_type: &Type, method_name: &byte) i32 {
    if ctx == null || method_name == null {
        return -1;
    }
    var sigs: [&ASTNode: EXEC_MAX_INTERFACE_METHODS] = [];
    var sig_count: i32 = 0;
    if exec_lower_collect_interface_method_sigs(ctx, interface_type, &sigs[0] as & & ASTNode, &sig_count) != 0 {
        return -1;
    }
    var i: i32 = 0;
    while i < sig_count {
        const sig: &ASTNode = sigs[i];
        if sig != null && sig.fn_decl_name != null && str_equals(sig.fn_decl_name, method_name) != 0 {
            return i;
        }
        i = i +| 1;
    }
    return -1;
}

fn exec_lower_struct_field_type(ctx: &ExecLowerContext, struct_type: Type, field_name: &byte) Type {
    const struct_name: &byte = type_get_struct_name(&struct_type);
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        struct_name == null || field_name == null {
        return make_void_type();
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(ctx.checker.program_node, struct_name);
    if struct_decl == null {
        return make_void_type();
    }
    // 泛型结构体实例（`TaskQueue<i32>`）取字段类型时必须把 `T` 换成实参：
    // 直接 `find_struct_field_type` 拿到的是声明形态（`slots: &TaskQueueSlot<T>`），
    // 里面还是 `T`。下游 `@size_of(该字段的元素)` 于是折叠不出尺寸，
    // exec 侧 `ADDR_INDEX` 的元素步长退化成 0，按下标访问原生数组全部错位
    // （`test_async_task_queue_dynamic_growth` 的调度循环因此永远读不到 active）。
    if struct_type.struct_type_args != null && struct_type.struct_type_arg_count > 0 &&
        struct_decl.struct_decl_type_params != null && struct_decl.struct_decl_type_param_count > 0 &&
        struct_decl.struct_decl_fields != null {
        var sfi: i32 = 0;
        while sfi < struct_decl.struct_decl_field_count {
            const sfd: &ASTNode = struct_decl.struct_decl_fields[sfi];
            if sfd != null && sfd.var_decl_name != null && str_equals(sfd.var_decl_name, field_name) != 0 {
                return exec_lower_subst_struct_field_type(ctx.checker, &struct_type, struct_decl, sfd);
            }
            sfi = sfi + 1;
        }
    }
    return find_struct_field_type(ctx.checker, struct_decl, field_name);
}

fn exec_lower_resolve_exact_type(ctx: &ExecLowerContext, expr: &ASTNode) Type {
    var resolved: Type = exec_lower_expr_type(ctx, expr);
    if ctx == null || expr == null || resolved.kind != TypeKind.TYPE_VOID {
        return resolved;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER && expr.identifier_name != null {
        const symbol: &Symbol = symbol_table_lookup(ctx.checker, expr.identifier_name);
        if symbol != null && symbol.type.kind != TypeKind.TYPE_VOID {
            return symbol.type;
        }
        const slot: i32 = exec_lower_find_slot(ctx, expr.identifier_name);
        if slot >= 0 && slot < EXEC_MAX_LOCALS {
            return exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0];
        }
        const global_slot: i32 = exec_lower_find_global_slot(ctx, expr.identifier_name);
        if global_slot >= 0 && global_slot < EXEC_MAX_GLOBALS {
            return exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS)[0];
        }
        return resolved;
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS &&
        expr.member_access_object != null && expr.member_access_field_name != null {
        var parent_type: Type = exec_lower_resolve_exact_type(ctx, expr.member_access_object);
        if parent_type.kind == TypeKind.TYPE_POINTER && parent_type.pointer_to != null {
            parent_type = parent_type.pointer_to[0];
        }
        if parent_type.kind == TypeKind.TYPE_TUPLE && parent_type.tuple_element_types != null {
            const tuple_index: i32 = atoi(expr.member_access_field_name as *byte);
            if tuple_index >= 0 && tuple_index < parent_type.tuple_count {
                return parent_type.tuple_element_types[tuple_index];
            }
        }
        if parent_type.kind == TypeKind.TYPE_STRUCT {
            const field_type: Type = exec_lower_struct_field_type(ctx, copy_type(&parent_type), expr.member_access_field_name);
            if field_type.kind != TypeKind.TYPE_VOID {
                return field_type;
            }
        }
        if parent_type.kind == TypeKind.TYPE_SLICE {
            if str_equals(expr.member_access_field_name, "len" as *byte) != 0 {
                return make_usize_type();
            }
            if str_equals(expr.member_access_field_name, "ptr" as *byte) != 0 &&
                parent_type.slice_element_type != null {
                return exec_lower_make_pointer_type_copy(ctx, parent_type.slice_element_type[0]);
            }
        }
        if (parent_type.kind == TypeKind.TYPE_ERROR || parent_type.kind == TypeKind.TYPE_ERROR_UNION) &&
            str_equals(expr.member_access_field_name, "error_id" as *byte) != 0 {
            return make_u32_type();
        }
        if parent_type.kind == TypeKind.TYPE_ERROR_UNION &&
            str_equals(expr.member_access_field_name, "value" as *byte) != 0 &&
            parent_type.error_union_payload_type != null {
            return parent_type.error_union_payload_type[0];
        }
        return resolved;
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS && expr.array_access_array != null {
        const array_type: Type = exec_lower_resolve_exact_type(ctx, expr.array_access_array);
        if array_type.kind == TypeKind.TYPE_ARRAY && array_type.element_type != null {
            return array_type.element_type[0];
        }
        if array_type.kind == TypeKind.TYPE_SLICE && array_type.slice_element_type != null {
            return array_type.slice_element_type[0];
        }
        if array_type.kind == TypeKind.TYPE_POINTER && array_type.pointer_to != null {
            const pointed_type: Type = array_type.pointer_to[0];
            if pointed_type.kind == TypeKind.TYPE_ARRAY && pointed_type.element_type != null {
                return pointed_type.element_type[0];
            }
            return pointed_type;
        }
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR &&
        expr.unary_expr_operand != null &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_ASTERISK {
        const operand_type: Type = exec_lower_resolve_exact_type(ctx, expr.unary_expr_operand);
        if operand_type.kind == TypeKind.TYPE_POINTER && operand_type.pointer_to != null {
            return operand_type.pointer_to[0];
        }
    }
    return resolved;
}

/// `&f` 且 f 是函数声明时，产出一个非零常量指针（解释器没有机器码地址）。
///
/// 参数：`ctx` lowering 上下文；`unary_ast` 取地址表达式；`operand` 被取地址的操作数。
/// 返回值：命中函数标识符时返回指针常量表达式；否则返回 null（调用方继续走普通取址）。
fn exec_lower_make_fn_addr_expr(ctx: &ExecLowerContext, unary_ast: &ASTNode, operand: &ASTNode) &HIRExpr {
    if ctx == null || unary_ast == null || operand == null ||
        operand.type != ASTNodeType.AST_IDENTIFIER || operand.identifier_name == null {
        return null;
    }
    if exec_lower_find_slot(ctx, operand.identifier_name) >= 0 ||
        exec_lower_find_global_slot(ctx, operand.identifier_name) >= 0 {
        return null;
    }
    const fn_decl: &ASTNode = exec_lower_resolve_function_decl_from_file(ctx.checker, operand.filename, operand.identifier_name);
    if fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return null;
    }
    const void_pointee: Type = make_void_type();
    const ptr_type: Type = make_pointer_type(ctx.arena, &void_pointee, 0);
    const fn_addr_expr: &HIRExpr = exec_lower_make_int_const_expr(ctx, unary_ast, &ptr_type, 4096);
    if fn_addr_expr == null {
        return null;
    }
    // 把声明带到构建期：构建期才知道函数在模块里的下标，`&fn` 会被换成
    // 「函数下标 + 基址」的指针值，宿主调用（pthread_once 一类）据此回调。
    fn_addr_expr.callee_decl = fn_decl;
    return fn_addr_expr;
}

fn exec_lower_make_addr_expr(ctx: &ExecLowerContext, ast_node: &ASTNode, pointee_type: &Type) &HIRExpr {
    if pointee_type == null {
        return null;
    }
    const pointer_type: Type = exec_lower_make_pointer_type_copy(ctx, pointee_type[0]);
    return exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_ADDR, &pointer_type);
}

fn exec_lower_make_ref_expr(ctx: &ExecLowerContext, expr: &ASTNode) &HIRExpr {
    if ctx == null || expr == null {
        return null;
    }
    // `&arr[a:b]` 的切片表达式本身就是切片，不能再取一次地址
    // （否则类型会退化成指向切片的指针，return/赋值时与 `&[T]` 对不上）。
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        return exec_lower_expr(ctx, expr);
    }
    const expr_type: Type = exec_lower_resolve_exact_type(ctx, expr);
    if expr.type == ASTNodeType.AST_IDENTIFIER && expr.identifier_name != null {
        const local_slot: i32 = exec_lower_find_slot(ctx, expr.identifier_name);
        if local_slot >= 0 && local_slot < EXEC_MAX_LOCALS {
            const addr_local: &HIRExpr = exec_lower_make_addr_expr(ctx, expr, exec_lower_type_slot(ctx, 0, local_slot, EXEC_MAX_LOCALS));
            if addr_local == null {
                return null;
            }
            addr_local.local_slot = local_slot;
            return addr_local;
        }
        const global_slot: i32 = exec_lower_find_global_slot(ctx, expr.identifier_name);
        if global_slot >= 0 && global_slot < EXEC_MAX_GLOBALS {
            const addr_global: &HIRExpr = exec_lower_make_addr_expr(ctx, expr, exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS));
            if addr_global == null {
                return null;
            }
            addr_global.global_slot = global_slot;
            return addr_global;
        }
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS && expr.member_access_object != null && expr.member_access_field_name != null {
        const object_raw_type: Type = exec_lower_resolve_exact_type(ctx, expr.member_access_object);
        var base_type: Type = exec_lower_member_base_type(ctx, expr.member_access_object);
        const field_type: Type = exec_lower_resolve_exact_type(ctx, expr);
        if base_type.kind == TypeKind.TYPE_VOID &&
            expr.member_access_object.type == ASTNodeType.AST_ARRAY_ACCESS &&
            expr.member_access_object.array_access_array != null {
            const array_type: Type = exec_lower_resolve_exact_type(ctx, expr.member_access_object.array_access_array);
            if array_type.kind == TypeKind.TYPE_ARRAY && array_type.element_type != null {
                base_type = array_type.element_type[0];
            } else if array_type.kind == TypeKind.TYPE_SLICE && array_type.slice_element_type != null {
                base_type = array_type.slice_element_type[0];
            } else if array_type.kind == TypeKind.TYPE_POINTER && array_type.pointer_to != null {
                const pointed_type: Type = array_type.pointer_to[0];
                if pointed_type.kind == TypeKind.TYPE_ARRAY && pointed_type.element_type != null {
                    base_type = pointed_type.element_type[0];
                } else {
                    base_type = pointed_type;
                }
            }
        }
        if base_type.kind == TypeKind.TYPE_POINTER && base_type.pointer_to != null {
            base_type = base_type.pointer_to[0];
        }
        var addr_base_type: Type = copy_type(&base_type);
        var field_index: i32 = -1;
        if base_type.kind == TypeKind.TYPE_TUPLE {
            field_index = atoi(expr.member_access_field_name as *byte);
        } else {
            field_index = exec_lower_struct_field_index(ctx, base_type, expr.member_access_field_name);
        }
        if field_index < 0 {
            return null;
        }
        var base_ref: &HIRExpr = null;
        if object_raw_type.kind == TypeKind.TYPE_POINTER {
            base_ref = exec_lower_expr(ctx, expr.member_access_object);
        } else {
            base_ref = exec_lower_make_ref_expr(ctx, expr.member_access_object);
        }
        if base_ref == null {
            base_ref = exec_lower_expr(ctx, expr.member_access_object);
        }
        if base_ref == null {
            return null;
        }
        // 原生布局信息也要挂在 ADDR 节点上（builder 的 `&p.field` 走 ADDR_FIELD，
        // 需要偏移与字段 kind 才能按 C99 布局算出字段地址）。
        var addr_native_offset: i32 = 0;
        var addr_native_kind: i32 = 0;
        var addr_native_pointee: i32 = 0;
        var addr_native_count: i32 = 0;
        if addr_base_type.kind == TypeKind.TYPE_STRUCT {
            _ = exec_lower_native_field_layout(ctx, copy_type(&addr_base_type), field_index,
                &addr_native_offset, &addr_native_kind, &addr_native_pointee, &addr_native_count);
        }
        const addr_field: &HIRExpr = exec_lower_make_addr_expr(ctx, expr, &field_type);
        if addr_field == null {
            return null;
        }
        addr_field.left = base_ref;
        addr_field.int_value = field_index as i64;
        addr_field.unary_op = addr_native_offset;
        addr_field.binary_op = addr_native_kind | (addr_native_pointee << 8);
        addr_field.bool_value = addr_native_count;
        return addr_field;
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS && expr.array_access_array != null && expr.array_access_index != null {
        const array_raw_type: Type = exec_lower_resolve_exact_type(ctx, expr.array_access_array);
        // `resolve_exact_type` 对 `&const byte` 这类带限定符的指针会退化成标量，
        // 于是 `p[i]` 被降成「对指针变量本身取下标」。用表达式类型兜一层。
        var array_index_type: Type = copy_type(&array_raw_type);
        if array_index_type.kind != TypeKind.TYPE_POINTER {
            const fallback_type: Type = exec_lower_expr_type(ctx, expr.array_access_array);
            if fallback_type.kind == TypeKind.TYPE_POINTER {
                array_index_type = copy_type(&fallback_type);
            }
        }
        var base_expr: &HIRExpr = null;
        if array_index_type.kind == TypeKind.TYPE_POINTER {
            base_expr = exec_lower_expr(ctx, expr.array_access_array);
        } else {
            base_expr = exec_lower_make_ref_expr(ctx, expr.array_access_array);
        }
        if base_expr == null {
            base_expr = exec_lower_expr(ctx, expr.array_access_array);
        }
        const index_expr: &HIRExpr = exec_lower_expr(ctx, expr.array_access_index);
        if base_expr == null || index_expr == null {
            return null;
        }
        const addr_index: &HIRExpr = exec_lower_make_addr_expr(ctx, expr, &expr_type);
        if addr_index == null {
            return null;
        }
        addr_index.left = base_expr;
        addr_index.right = index_expr;
        // `&p[i]` 的元素字节数（ADDR 节点的 bool_value 专用于此）：
        // 原生结构体指针做下标时 VM 只能靠它拿到 C 布局步长。
        addr_index.bool_value = exec_lower_size_align_of_type(ctx, copy_type(&expr_type), 1);
        return addr_index;
    }
    const source_expr: &HIRExpr = exec_lower_expr(ctx, expr);
    if source_expr == null {
        return null;
    }
    const addr_value: &HIRExpr = exec_lower_make_addr_expr(ctx, expr, &expr_type);
    if addr_value == null {
        return null;
    }
    addr_value.left = source_expr;
    // 非左值取地址：int_value = -1 让 builder 走 BOX_VALUE（堆上装箱后取地址），
    // 避免被误判成字段地址（字段地址用 int_value >= 0 表示）。
    addr_value.int_value = -1;
    return addr_value;
}

fn exec_lower_make_va_storage_ref_expr(ctx: &ExecLowerContext, expr: &ASTNode) &HIRExpr {
    if ctx == null || expr == null {
        return null;
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND &&
        expr.unary_expr_operand != null {
        return exec_lower_make_ref_expr(ctx, expr.unary_expr_operand);
    }
    return exec_lower_make_ref_expr(ctx, expr);
}

fn exec_lower_method_receiver_expr(ctx: &ExecLowerContext, object_expr: &ASTNode, method_decl: &ASTNode) &HIRExpr {
    if ctx == null || object_expr == null || method_decl == null ||
        method_decl.type != ASTNodeType.AST_FN_DECL ||
        method_decl.fn_decl_param_count <= 0 || method_decl.fn_decl_params == null {
        return null;
    }
    const receiver_param: &ASTNode = method_decl.fn_decl_params[0];
    if receiver_param == null || receiver_param.type != ASTNodeType.AST_VAR_DECL || receiver_param.var_decl_type == null {
        return null;
    }
    const receiver_type: Type = type_from_ast(ctx.checker, receiver_param.var_decl_type);
    const object_type: Type = exec_lower_expr_type(ctx, object_expr);
    if receiver_type.kind == TypeKind.TYPE_POINTER {
        if object_type.kind == TypeKind.TYPE_POINTER {
            return exec_lower_expr(ctx, object_expr);
        }
        return exec_lower_make_ref_expr(ctx, object_expr);
    }
    return exec_lower_expr(ctx, object_expr);
}

fn exec_lower_collect_interface_dispatch_decls(ctx: &ExecLowerContext, interface_type: &Type, concrete_type: &Type, out_decls: & & ASTNode, out_count: &i32) i32 {
    const struct_name: &byte = type_get_struct_name(concrete_type);
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null || out_count == null {
        return -1;
    }
    if struct_name == null {
        return -1;
    }
    var sigs: [&ASTNode: EXEC_MAX_INTERFACE_METHODS] = [];
    var sig_count: i32 = 0;
    if exec_lower_collect_interface_method_sigs(ctx, interface_type, &sigs[0] as & & ASTNode, &sig_count) != 0 {
        return -1;
    }
    var i: i32 = 0;
    while i < sig_count {
        const sig: &ASTNode = sigs[i];
        if sig == null || sig.fn_decl_name == null {
            return -1;
        }
        var impl_decl: &ASTNode = find_instance_method_in_struct(ctx.checker.program_node, struct_name, sig.fn_decl_name);
        if impl_decl == null {
            return -1;
        }
        // 具体类型是泛型结构体实例时，方法表里放的必须是该实例的单态副本。
        impl_decl = exec_lower_specialize_struct_method(ctx, impl_decl, struct_name, concrete_type);
        out_decls[i] = impl_decl;
        i = i +| 1;
    }
    out_count[0] = sig_count;
    return 0;
}

/// 判断名字是否以给定前缀开头（`@frame` 合成的 `uya_async_*` 类型用）。
/// 参数：`name` 名字；`prefix` 前缀。返回值：1 命中；0 不命中。
fn exec_lower_name_has_prefix(name: &byte, prefix: &byte) i32 {
    if name == null || prefix == null {
        return 0;
    }
    var i: i32 = 0;
    while prefix[i] != 0 {
        if name[i] != prefix[i] {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn exec_lower_box_interface_expr(ctx: &ExecLowerContext, expr: &ASTNode, interface_type: &Type) &HIRExpr {
    if ctx == null || expr == null {
        return null;
    }
    var actual_type: Type = exec_lower_expr_type(ctx, expr);
    if actual_type.kind == TypeKind.TYPE_VOID {
        actual_type = exec_lower_member_base_type(ctx, expr);
    }
    if actual_type.kind == TypeKind.TYPE_INTERFACE && type_equals(actual_type, interface_type[0]) != 0 {
        return exec_lower_expr(ctx, expr);
    }
    // 已经是「指向具体类型的指针」时，装箱的数据就是该指针本身；
    // 再取一次地址会变成指向指针的指针，方法里的 `self.field` 就落在错误的层级。
    var boxed_is_pointer: i32 = 0;
    if actual_type.kind == TypeKind.TYPE_POINTER && actual_type.pointer_to != null {
        actual_type = actual_type.pointer_to[0];
        boxed_is_pointer = 1;
    }
    if actual_type.kind != TypeKind.TYPE_STRUCT ||
        actual_type.struct_name == null ||
        interface_type.kind != TypeKind.TYPE_INTERFACE ||
        interface_type.interface_name == null ||
        struct_implements_interface(ctx.checker, actual_type.struct_name, interface_type.interface_name) == 0 {
        return exec_lower_fail_expr(expr, "exec: 无法装箱为 interface" as *byte);
    }
    var dispatch_buf: [&ASTNode: EXEC_MAX_INTERFACE_METHODS] = [];
    var dispatch_count: i32 = 0;
    if exec_lower_collect_interface_dispatch_decls(ctx, interface_type, &actual_type, &dispatch_buf[0] as & & ASTNode, &dispatch_count) != 0 {
        return exec_lower_fail_expr(expr, "exec: interface 方法表构建失败" as *byte);
    }
    const dispatch_decls: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode) * dispatch_count as usize) as & & ASTNode;
    if dispatch_count > 0 && dispatch_decls == null {
        exec_backend_set_error(expr, "exec: interface dispatch 表分配失败" as *byte, 0);
        return null;
    }
    var di: i32 = 0;
    while di < dispatch_count {
        dispatch_decls[di] = dispatch_buf[di];
        di = di +| 1;
    }
    var source_expr: &HIRExpr = null;
    if boxed_is_pointer != 0 {
        source_expr = exec_lower_expr(ctx, expr);
    } else {
        source_expr = exec_lower_make_ref_expr(ctx, expr);
    }
    if source_expr == null {
        source_expr = exec_lower_expr(ctx, expr);
    }
    if source_expr == null {
        return null;
    }
    const boxed: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_INTERFACE_BOX, interface_type);
    if boxed == null {
        return null;
    }
    boxed.left = source_expr;
    boxed.dispatch_decls = dispatch_decls;
    boxed.dispatch_decl_count = dispatch_count;
    return boxed;
}

// `&[a, b, c]` / `&[v; N]` 在语言层构造切片（与 C99 后端 gen_slice_from_array_literal 一致）。
// 参数：ctx - lowering 上下文；unary_ast - 整个取地址表达式；slice_type - 目标切片类型。
// 返回：切片表达式；数组字面量降级失败时返回 null。
fn exec_lower_make_array_literal_slice_expr(ctx: &ExecLowerContext, unary_ast: &ASTNode, slice_type: &Type) &HIRExpr {
    const operand: &ASTNode = unary_ast.unary_expr_operand;
    if operand == null || operand.type != ASTNodeType.AST_ARRAY_LITERAL {
        return null;
    }
    const array_expr: &HIRExpr = exec_lower_expr(ctx, operand);
    if array_expr == null {
        return null;
    }
    var len_value: i64 = operand.array_literal_element_count as i64;
    if operand.array_literal_repeat_count_expr != null {
        len_value = checker_eval_const_expr(ctx.checker, operand.array_literal_repeat_count_expr) as i64;
    }
    var usize_type: Type = make_usize_type();
    const start_expr: &HIRExpr = exec_lower_make_int_const_expr(ctx, operand, &usize_type, 0);
    const len_expr: &HIRExpr = exec_lower_make_int_const_expr(ctx, operand, &usize_type, len_value);
    if start_expr == null || len_expr == null {
        return null;
    }
    const slice_expr: &HIRExpr = exec_lower_alloc_expr(ctx, unary_ast, HIRExprKind.HIR_EXPR_SLICE, slice_type);
    if slice_expr == null {
        return null;
    }
    slice_expr.left = array_expr;
    slice_expr.right = start_expr;
    slice_expr.extra = len_expr;
    return slice_expr;
}

// 枚举变体数值：显式 `= N` 解析为整数，否则按前一变体递增（与 C99 后端
// find_enum_variant_value 口径一致）。参数：ctx/枚举名/变体名。返回：数值，失败 -1。
fn exec_lower_enum_variant_value(ctx: &ExecLowerContext, enum_name: &byte, variant_name: &byte) i32 {
    if ctx == null || ctx.checker == null || enum_name == null || variant_name == null {
        return -1;
    }
    const enum_decl: &ASTNode = find_enum_decl_from_program(ctx.checker.program_node, enum_name);
    if enum_decl == null || enum_decl.type != ASTNodeType.AST_ENUM_DECL {
        return -1;
    }
    const variants: &EnumVariant = enum_decl.enum_decl_variants;
    var current_value: i32 = 0;
    var i: i32 = 0;
    while i < enum_decl.enum_decl_variant_count {
        const variant: &EnumVariant = variants + i;
        if variant.name != null {
            if variant.value != null {
                current_value = atoi(variant.value as *byte);
            }
            if str_equals(variant.name, variant_name) != 0 {
                return current_value;
            }
            current_value = current_value +| 1;
        }
        i = i + 1;
    }
    return -1;
}

/// 把字符串字面量转成切片：`"abc" as &[byte]` 需要编译期补齐长度。
/// 参数：ctx lowering 上下文；cast_ast 类型转换节点；slice_type 目标切片类型。
/// 返回值：构造切片的 HIR 表达式；失败返回 null。
fn exec_lower_string_as_slice(ctx: &ExecLowerContext, cast_ast: &ASTNode, slice_type: &Type) &HIRExpr {
    if ctx == null || cast_ast == null || slice_type == null || slice_type.slice_element_type == null {
        return null;
    }
    return exec_lower_make_string_literal_slice(ctx, cast_ast.cast_expr_expr, slice_type);
}

/// 把字符串字面量按目标切片类型构造 `{ ptr, 0, len }` 切片值。
///
/// 参数：`ctx` lowering 上下文；`literal` 字符串字面量节点；`slice_type` 目标切片类型。
/// 返回值：切片表达式；参数非法或分配失败时返回 null。
fn exec_lower_make_string_literal_slice(ctx: &ExecLowerContext, literal: &ASTNode, slice_type: &Type) &HIRExpr {
    if ctx == null || literal == null || slice_type == null || slice_type.slice_element_type == null {
        return null;
    }
    var elem_type: Type = slice_type.slice_element_type[0];
    const ptr_type: Type = make_pointer_type(ctx.arena, &elem_type, 0);
    const str_const: &HIRExpr = exec_lower_make_string_const_expr(ctx, literal, &ptr_type, literal.string_literal_value);
    if str_const == null {
        return null;
    }
    const usize_type: Type = make_usize_type();
    const start_const: &HIRExpr = exec_lower_make_int_const_expr(ctx, literal, &usize_type, 0);
    const len_value: i64 = strlen(literal.string_literal_value as *byte) as i64;
    const len_const: &HIRExpr = exec_lower_make_int_const_expr(ctx, literal, &usize_type, len_value);
    if start_const == null || len_const == null {
        return null;
    }
    const hir_slice: &HIRExpr = exec_lower_alloc_expr(ctx, literal, HIRExprKind.HIR_EXPR_SLICE, slice_type);
    if hir_slice == null {
        return null;
    }
    hir_slice.left = str_const;
    hir_slice.right = start_const;
    hir_slice.extra = len_const;
    return hir_slice;
}

fn exec_lower_coerce_expr(ctx: &ExecLowerContext, expr: &ASTNode, expected_type: &Type) &HIRExpr {
    if ctx == null || expr == null {
        return null;
    }
    // `undefined` 表示「未初始化」：exec VM 一律按零值处理（内容本就不保证）。
    if expected_type != null && expr.type == ASTNodeType.AST_IDENTIFIER &&
        expr.identifier_name != null && str_equals(expr.identifier_name, "undefined" as &byte) != 0 {
        return exec_lower_make_zero_expr(ctx, expr, expected_type);
    }
    if expected_type != null &&
        expr.type == ASTNodeType.AST_ARRAY_LITERAL &&
        expr.array_literal_repeat_count_expr != null &&
        expected_type.kind == TypeKind.TYPE_ARRAY {
        return exec_lower_make_repeat_array_init_expr(ctx, expr, expected_type);
    }
    if expected_type != null &&
        expr.type == ASTNodeType.AST_ARRAY_LITERAL &&
        expr.array_literal_repeat_count_expr == null &&
        expr.array_literal_element_count == 0 &&
        (expected_type.kind == TypeKind.TYPE_ARRAY || expected_type.kind == TypeKind.TYPE_SLICE) {
        return exec_lower_make_zero_expr(ctx, expr, expected_type);
    }
    // 固定长度数组字面量按**声明类型**建值：元素种类决定它能否用裸字节缓冲表示。
    // 未加后缀的字面量会被推断成 [i32; N]，若照推断类型建值，`[byte: N]` 会变成
    // 聚合，`&buf` 取到的是槽位地址而不是数据地址（memset/memcpy 会写坏值）。
    if expected_type != null &&
        expected_type.kind == TypeKind.TYPE_ARRAY &&
        expr.type == ASTNodeType.AST_ARRAY_LITERAL &&
        expr.array_literal_repeat_count_expr == null &&
        expr.array_literal_element_count > 0 {
        const coerced_array: &HIRExpr = exec_lower_expr(ctx, expr);
        if coerced_array != null && coerced_array.kind == HIRExprKind.HIR_EXPR_ARRAY_INIT {
            coerced_array.type_ref = exec_lower_make_type_ref(expected_type);
        }
        return coerced_array;
    }
    // 存储是编码值 = TypeKind + 1（resolve_int_limit_node）：解析、求值
    // 与 exec_lower_eval_int_limit 的解码保持同一口径。
    if expected_type != null && expr.type == ASTNodeType.AST_INT_LIMIT && is_integer_type(expected_type.kind) != 0 {
        expr.int_limit_resolved_kind = (expected_type.kind as i32) +| 1;
        var int_limit_ok: i32 = 0;
        const int_limit_value: i64 = exec_lower_eval_int_limit(expr, expected_type.kind, &int_limit_ok);
        if int_limit_ok != 0 {
            return exec_lower_make_int_const_expr(ctx, expr, expected_type, int_limit_value);
        }
    }
    if expected_type != null && expr.type == ASTNodeType.AST_NUMBER && is_integer_type(expected_type.kind) != 0 {
        return exec_lower_make_number_const(ctx, expr, expected_type, expr.number_value_i64);
    }
    if expected_type != null && expr.type == ASTNodeType.AST_CHAR && is_integer_type(expected_type.kind) != 0 {
        return exec_lower_make_int_const_expr(ctx, expr, expected_type, expr.char_literal_value as i64);
    }
    if expected_type != null &&
        expected_type.kind == TypeKind.TYPE_INTERFACE && expected_type.interface_name != null {
        var actual_type: Type = exec_lower_expr_type(ctx, expr);
        if actual_type.kind == TypeKind.TYPE_VOID {
            actual_type = exec_lower_member_base_type(ctx, expr);
        }
        // `&T`（T 实现该 interface）也要装箱：数据直接就是那个指针。
        var coerced_type: Type = copy_type(&actual_type);
        if coerced_type.kind == TypeKind.TYPE_POINTER && coerced_type.pointer_to != null {
            coerced_type = coerced_type.pointer_to[0];
        }
        if coerced_type.kind == TypeKind.TYPE_STRUCT && coerced_type.struct_name != null &&
            struct_implements_interface(ctx.checker, coerced_type.struct_name, expected_type.interface_name) != 0 {
            return exec_lower_box_interface_expr(ctx, expr, expected_type);
        }
    }
    if expected_type != null && expected_type.kind == TypeKind.TYPE_ERROR_UNION {
        var actual_error_type: Type = exec_lower_expr_type(ctx, expr);
        if actual_error_type.kind == TypeKind.TYPE_ERROR {
            const error_value_expr: &HIRExpr = exec_lower_expr(ctx, expr);
            if error_value_expr == null {
                return null;
            }
            const make_err_expr: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_MAKE_ERR, expected_type);
            if make_err_expr == null {
                return null;
            }
            make_err_expr.left = error_value_expr;
            make_err_expr.int_value = actual_error_type.error_error_id as i64;
            return make_err_expr;
        }
    }
    if expected_type != null && expected_type.kind == TypeKind.TYPE_SLICE &&
        expr.type == ASTNodeType.AST_STRING && expected_type.slice_element_type != null {
        // 字符串字面量隐式转切片（函数实参、变量初始化）：必须构造真正的
        // `{ ptr, 0, len }` 值，否则 `.len` 读到的是字符串常量的占位字段。
        return exec_lower_make_string_literal_slice(ctx, expr, expected_type);
    }
    if expected_type != null && expected_type.kind == TypeKind.TYPE_SLICE &&
        expr.type == ASTNodeType.AST_UNARY_EXPR &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND &&
        expr.unary_expr_operand != null {
        // 语言层 `& <切片值>` 不表示取地址（切片本身就是值），直接使用切片值；
        // `&[a, b, c]` / `&[v; N]` 则构造切片。
        var ref_operand_type: Type = exec_lower_expr_type(ctx, expr.unary_expr_operand);
        if ref_operand_type.kind == TypeKind.TYPE_SLICE {
            return exec_lower_expr(ctx, expr.unary_expr_operand);
        }
        if expr.unary_expr_operand.type == ASTNodeType.AST_ARRAY_LITERAL {
            return exec_lower_make_array_literal_slice_expr(ctx, expr, expected_type);
        }
    }
    // 具体结构体值隐式转接口（`Future<T>` 这类同名接口/结构体最常见）：
    // 接口值 = [方法入口…, 数据指针]，不装箱的话后续接口分派会按错误布局取字段。
    if expected_type != null {
        var iface_target: Type = expected_type[0];
        if iface_target.kind == TypeKind.TYPE_ERROR_UNION && iface_target.error_union_payload_type != null {
            iface_target = iface_target.error_union_payload_type[0];
        }
        if iface_target.kind == TypeKind.TYPE_INTERFACE && iface_target.interface_name != null {
            const actual_type: Type = exec_lower_expr_type(ctx, expr);
            if actual_type.kind == TypeKind.TYPE_STRUCT && actual_type.struct_name != null &&
                struct_implements_interface(ctx.checker, actual_type.struct_name, iface_target.interface_name) != 0 {
                const boxed_iface: &HIRExpr = exec_lower_box_interface_expr(ctx, expr, &iface_target);
                if boxed_iface != null {
                    return boxed_iface;
                }
            }
        }
    }
    // 浮点窄化/拓宽（`var x: f32 = 1.0`、`f32_to_bits(1.0)`）：C 侧靠赋值的隐式
    // 转换，VM 的值自带 kind，必须在降级期显式插 CAST，否则 f32 局部/形参槽里
    // 存的是 f64 位模式，`memcpy(&bits, &f, 4)` 这类位重解释会读到全 0。
    if expected_type != null &&
        (expected_type.kind == TypeKind.TYPE_F32 || expected_type.kind == TypeKind.TYPE_F64) {
        const actual_float_type: Type = exec_lower_expr_type(ctx, expr);
        if actual_float_type.kind != expected_type.kind &&
            (actual_float_type.kind == TypeKind.TYPE_F32 || actual_float_type.kind == TypeKind.TYPE_F64 ||
             is_integer_type(actual_float_type.kind) != 0) {
            const float_operand: &HIRExpr = exec_lower_expr(ctx, expr);
            if float_operand == null {
                return null;
            }
            const float_cast: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CAST, expected_type);
            if float_cast == null {
                return null;
            }
            float_cast.left = float_operand;
            return float_cast;
        }
    }
    return exec_lower_expr(ctx, expr);
}

/// 计算结构体字段在原生（C99 布局）内存里的字节偏移与类型信息。
/// 参数：`ctx` 上下文；`struct_type` 结构体类型；`field_index` 字段下标。
/// 输出：`out_offset` 字段字节偏移；`out_kind` 字段 kind+1；`out_pointee` 指针字段 pointee kind+1。
/// 返回值：1 解析成功；0 无法解析（调用方沿用纯 VM 聚合语义）。
fn exec_lower_native_field_layout(ctx: &ExecLowerContext, struct_type: Type, field_index: i32,
    out_offset: &i32, out_kind: &i32, out_pointee: &i32, out_count: &i32) i32 {
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null || field_index < 0 {
        return 0;
    }
    if out_offset == null || out_kind == null || out_pointee == null || out_count == null {
        return 0;
    }
    var struct_copy: Type = copy_type(&struct_type);
    const struct_name: &byte = type_get_struct_name(&struct_copy);
    if struct_name == null {
        return 0;
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(ctx.checker.program_node, struct_name);
    if struct_decl == null || struct_decl.struct_decl_fields == null {
        return 0;
    }
    if field_index >= struct_decl.struct_decl_field_count {
        return 0;
    }
    var offset: i32 = 0;
    var fi: i32 = 0;
    while fi < struct_decl.struct_decl_field_count {
        const field_decl: &ASTNode = struct_decl.struct_decl_fields[fi];
        if field_decl == null {
            return 0;
        }
        const field_type: Type = exec_lower_subst_struct_field_type(ctx.checker, &struct_copy, struct_decl, field_decl);
        const field_size: i32 = exec_lower_size_align_of_type(ctx, copy_type(&field_type), 1);
        const field_align: i32 = exec_lower_size_align_of_type(ctx, copy_type(&field_type), 0);
        if field_size <= 0 {
            return 0;
        }
        if field_align > 1 {
            const rem: i32 = offset % field_align;
            if rem != 0 {
                offset = offset +| (field_align -| rem);
            }
        }
        if fi == field_index {
            // `atomic T` 在原生内存里就是一个 T：把内层类型解出来再编码字段 kind，
            // 否则 VM 拿到 TypeKind.TYPE_ATOMIC 后不认识，字段读写会报「字段越界」。
            var layout_type: Type = copy_type(&field_type);
            if layout_type.kind == TypeKind.TYPE_ATOMIC {
                const atomic_inner: &Type = type_get_atomic_inner(&layout_type);
                if atomic_inner != null {
                    layout_type = copy_type(&atomic_inner[0]);
                }
            }
            out_offset[0] = offset;
            out_kind[0] = (layout_type.kind as i32) +| 1;
            out_pointee[0] = 0;
            out_count[0] = 0;
            if layout_type.kind == TypeKind.TYPE_POINTER && layout_type.pointer_to != null {
                out_pointee[0] = (layout_type.pointer_to[0].kind as i32) +| 1;
            }
            if layout_type.kind == TypeKind.TYPE_ARRAY && layout_type.element_type != null && field_type.kind == TypeKind.TYPE_ARRAY && field_type.element_type != null {
                // 原生内存里的定长数组字段：pointee 槽放元素 kind，count 槽放元素个数。
                // 个数按「字段字节数 / 元素字节数」算，避免 `[T: CONST]` 的 array_size
                // 在类型里没解析出来（那时是 0）。
                out_pointee[0] = (field_type.element_type[0].kind as i32) +| 1;
                const elem_size: i32 = exec_lower_size_align_of_type(ctx, copy_type(&field_type.element_type[0]), 1);
                if elem_size > 0 {
                    out_count[0] = field_size / elem_size;
                }
            }
            return 1;
        }
        offset = offset +| field_size;
        fi = fi + 1;
    }
    return 0;
}

/// `TypeInfo` 的字段下标（该结构体由宏展开阶段合成，没有真实声明）。
///
/// 顺序必须与 `src/checker/macro_expand.uya` 的 `create_type_info_struct` 一致。
///
/// 参数：`field_name` 字段名。
/// 返回值：字段下标；不认识返回 -1。
fn exec_lower_type_info_field_index(field_name: &byte) i32 {
    if field_name == null {
        return -1;
    }
    if str_equals(field_name, "name" as *byte) != 0 { return 0; }
    if str_equals(field_name, "size" as *byte) != 0 { return 1; }
    if str_equals(field_name, "align" as *byte) != 0 { return 2; }
    if str_equals(field_name, "kind" as *byte) != 0 { return 3; }
    if str_equals(field_name, "type_id" as *byte) != 0 { return 4; }
    if str_equals(field_name, "is_integer" as *byte) != 0 { return 5; }
    if str_equals(field_name, "is_float" as *byte) != 0 { return 6; }
    if str_equals(field_name, "is_bool" as *byte) != 0 { return 7; }
    if str_equals(field_name, "is_pointer" as *byte) != 0 { return 8; }
    if str_equals(field_name, "is_array" as *byte) != 0 { return 9; }
    return -1;
}

/// 接口在 exec VM 里以聚合承载：下标 0..n-1 是方法表，最后一项是数据引用
/// （见 `exec_builder` 的 `HIR_EXPR_INTERFACE_BOX`）。`.data` 就是最后那格。
fn exec_lower_interface_data_field_index(ctx: &ExecLowerContext, iface_type: &Type, field_name: &byte) i32 {
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        iface_type == null || field_name == null {
        return -1;
    }
    if str_equals(field_name, "data" as *byte) == 0 {
        return -1;
    }
    const iface_name: &byte = type_get_interface_name(iface_type);
    if iface_name == null {
        return -1;
    }
    const iface_decl: &ASTNode = find_interface_decl_from_program(ctx.checker.program_node, iface_name);
    if iface_decl == null || iface_decl.interface_decl_method_sig_count < 0 {
        return -1;
    }
    return iface_decl.interface_decl_method_sig_count;
}

fn exec_lower_struct_field_index(ctx: &ExecLowerContext, struct_type: Type, field_name: &byte) i32 {
    const struct_name: &byte = type_get_struct_name(&struct_type);
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        struct_name == null || field_name == null {
        return -1;
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(ctx.checker.program_node, struct_name);
    if struct_decl == null || struct_decl.struct_decl_fields == null {
        // `TypeInfo` 没有真实声明（字段表由宏展开阶段的
        // `create_type_info_struct` 合成，见 `src/checker/macro_expand.uya:375`）。
        // 那里的字段顺序是固定的，这里按同一顺序回答下标。
        if str_equals(struct_name, "TypeInfo" as *byte) != 0 {
            return exec_lower_type_info_field_index(field_name);
        }
        return -1;
    }
    var fi: i32 = 0;
    while fi < struct_decl.struct_decl_field_count {
        const field: &ASTNode = struct_decl.struct_decl_fields[fi];
        if field != null && field.var_decl_name != null && str_equals(field.var_decl_name, field_name) != 0 {
            return fi;
        }
        fi = fi + 1;
    }
    return -1;
}

/// 取出 `Future<T>` 结构体实例里的 `state: Poll<T>` 字段类型。
/// 参数：`ctx` 上下文；`future_type` Future 结构体类型。
/// 返回值：Poll 联合类型；解析不出来返回 void 类型。
fn exec_lower_future_state_type(ctx: &ExecLowerContext, future_type: Type) Type {
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        future_type.kind != TypeKind.TYPE_STRUCT || future_type.struct_name == null {
        return make_void_type();
    }
    const future_decl: &ASTNode = find_struct_decl_from_program(ctx.checker.program_node, future_type.struct_name);
    if future_decl == null || future_decl.struct_decl_fields == null || future_decl.struct_decl_field_count <= 0 {
        return make_void_type();
    }
    const state_field: &ASTNode = future_decl.struct_decl_fields[0];
    if state_field == null || state_field.var_decl_type == null {
        return make_void_type();
    }
    return exec_lower_subst_struct_field_type(ctx.checker, future_type, future_decl, state_field);
}

/// 把 `@async_fn` 里的返回值包成 `Future{ state: Poll.Ready(<值>) }`。
///
/// VM 把 async 函数当成同步函数执行，所以返回的 Future 一定是 Ready 状态；
/// 调用方的 `@await` 直接取载荷即可（见 BC_AWAIT）。
/// 参数：`ctx` 上下文；`ast_node` 返回语句节点；`value` 返回值 HIR；
///       `fn_return_type` 函数声明的返回类型。
/// 返回值：包装后的 HIR；不需要/无法包装时原样返回 `value`。
/// 判断 `@async_fn` 的返回语句是否还需要包成 `Future{ state: Poll.Ready(..) }`。
///
/// async 函数有两种写法：一种是直接返回 Future（`return Future<T>{..}`），
/// 另一种是返回载荷（`return x`，x 的类型是 T）。只有后者需要包装。
/// 参数：`ctx` 上下文；`return_expr` 返回表达式；`fn_return_type` 函数声明的返回类型。
/// 返回值：1 需要包装，0 已经是 Future。
/// 把 async 函数里的 `try x` 降级成「错误提前返回」的 catch 形状。
///
/// `try x` 在普通函数里等于「err 时原样返回错误联合」，但 async 函数返回的是
/// `Future`，必须包成 `Future{ state: Poll.Ready(err) }` 才能和正常返回一致。
/// 所以这里造 `x catch { return <wrap(err_union)> }` 的 HIR：
/// `local_slot` 绑定整个错误联合（`int_value=1` 让 builder 跳过 UNWRAP_ERR），
/// `extra` 是包装后的 Future 表达式。
/// 参数：`ctx` 上下文；`ast_node` try 节点；`operand` 降级后的错误联合；
///       `payload_type` try 表达式的结果类型。
/// 返回值：catch 形态的 HIR；失败返回 null。
/// `catch { return v }` 的返回值在 async 函数里也要包成 Future。
///
/// async 函数体内任何 `return` 都必须返回 `Future{ state: Poll.Ready(..) }`，
/// 包括 catch 分支里的提前返回，否则调用方拿到的是裸值。
/// 参数：`ctx` 上下文；`ast_node` catch 节点；`value` 已按返回类型 coerce 的值；
///       `return_type` 函数声明的返回类型。
/// 返回值：包装后的表达式（不需要包装时原样返回）。
fn exec_lower_wrap_catch_return(ctx: &ExecLowerContext, ast_node: &ASTNode, value: &HIRExpr,
    return_type: Type) &HIRExpr {
    if ctx == null || value == null || ctx.function_decl == null {
        return value;
    }
    if ctx.function_decl.fn_decl_is_async == 0 {
        return value;
    }
    return exec_lower_wrap_async_return(ctx, ast_node, value, return_type);
}

fn exec_lower_make_async_try_catch(ctx: &ExecLowerContext, ast_node: &ASTNode, operand: &HIRExpr,
    payload_type: Type) &HIRExpr {
    if ctx == null || ast_node == null || operand == null {
        return null;
    }
    // 不额外开作用域：这个槽位只是把错误联合原样带进 catch 分支，
    // 多开一层会让 errdefer/清理列表的作用域层级错位。
    const union_type: Type = copy_type(&operand.type_ref.type);
    const err_slot: i32 = exec_lower_append_local(ctx, null, "__exec_try_err" as &byte, &union_type, 0);
    if err_slot < 0 {
        exec_backend_set_error(ast_node, "exec: async try 错误槽位不足" as *byte, 0);
        return null;
    }
    const err_local: &HIRExpr = exec_lower_make_local_expr(ctx, ast_node, err_slot, &union_type);
    if err_local == null {
        return null;
    }
    const return_type: Type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
    const wrapped: &HIRExpr = exec_lower_wrap_async_return(ctx, ast_node, err_local, return_type);
    if wrapped == null {
        return null;
    }
    var catch_type: Type = copy_type(&payload_type);
    const hir_catch: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_CATCH, &catch_type);
    if hir_catch == null {
        return null;
    }
    hir_catch.left = operand;
    hir_catch.local_slot = err_slot;
    hir_catch.int_value = 1;
    hir_catch.extra = wrapped;
    return hir_catch;
}

fn exec_lower_async_return_needs_wrap(ctx: &ExecLowerContext, return_expr: &ASTNode,
    fn_return_type: Type) i32 {
    if ctx == null || return_expr == null {
        return 0;
    }
    const raw_type: Type = exec_lower_expr_type(ctx, return_expr);
    if type_equals(raw_type, fn_return_type) != 0 {
        return 0;
    }
    if fn_return_type.kind == TypeKind.TYPE_ERROR_UNION && fn_return_type.error_union_payload_type != null &&
        type_equals(raw_type, fn_return_type.error_union_payload_type[0]) != 0 {
        return 0;
    }
    return 1;
}

fn exec_lower_wrap_async_return(ctx: &ExecLowerContext, ast_node: &ASTNode, value: &HIRExpr,
    fn_return_type: Type) &HIRExpr {
    if ctx == null || value == null {
        return value;
    }
    var declared: Type = copy_type(&fn_return_type);
    var interface_type: Type = make_void_type();
    var needs_box: i32 = 0;
    if declared.kind == TypeKind.TYPE_ERROR_UNION && declared.error_union_payload_type != null {
        declared = copy_type(&declared.error_union_payload_type[0]);
    }
    // `Future<T>` 同时是接口名与结构体名：checker 解析成接口，实现类型是结构体。
    // 这里把接口类型「转写」成同名结构体类型，装箱时再包回接口。
    if declared.kind == TypeKind.TYPE_INTERFACE && declared.interface_name != null &&
        declared.interface_type_arg_count == 1 && declared.interface_type_args != null {
        interface_type = copy_type(&declared);
        declared.kind = TypeKind.TYPE_STRUCT;
        declared.struct_name = interface_type.interface_name;
        declared.struct_type_args = interface_type.interface_type_args;
        declared.struct_type_arg_count = interface_type.interface_type_arg_count;
        declared.decl_node = find_struct_decl_from_program(ctx.checker.program_node, declared.struct_name);
        needs_box = 1;
    }
    if declared.kind != TypeKind.TYPE_STRUCT || declared.struct_name == null ||
        declared.struct_type_arg_count < 1 || declared.struct_type_args == null {
        return value;
    }
    const poll_type: Type = exec_lower_future_state_type(ctx, copy_type(&declared));
    if poll_type.kind != TypeKind.TYPE_UNION {
        return value;
    }
    const ready_index: i32 = exec_lower_union_variant_index(ctx, copy_type(&poll_type), "Ready" as &byte);
    if ready_index < 0 {
        return value;
    }
    // 返回语句可能已经写的是 `!T`（错误联合，正好是 Future 的载荷）；
    // 也可能写的是裸 `T`，需要先包一层 ok()。
    var payload: &HIRExpr = value;
    const expect_type: Type = copy_type(&declared.struct_type_args[0]);
    if type_equals(payload.type_ref.type, expect_type) == 0 &&
        expect_type.kind == TypeKind.TYPE_ERROR_UNION && expect_type.error_union_payload_type != null &&
        type_equals(payload.type_ref.type, expect_type.error_union_payload_type[0]) != 0 {
        const ok_expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_MAKE_OK, &expect_type);
        if ok_expr == null {
            return value;
        }
        ok_expr.left = payload;
        payload = ok_expr;
    }
    // 裸 `error.X` 返回：Future 的载荷是 `!T`，必须先包成错误分支，
    // 否则 Ready 里躺着一个裸 error 值，调用方的 `catch`/`LOAD_ERROR_TAG`
    // 会报「目标不是错误联合」。
    if payload.type_ref.type.kind == TypeKind.TYPE_ERROR &&
        expect_type.kind == TypeKind.TYPE_ERROR_UNION {
        const err_expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_MAKE_ERR, &expect_type);
        if err_expr == null {
            return value;
        }
        err_expr.left = payload;
        err_expr.int_value = payload.type_ref.type.error_error_id as i64;
        payload = err_expr;
    }
    const union_expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_UNION_INIT, &poll_type);
    if union_expr == null {
        return value;
    }
    union_expr.int_value = ready_index as i64;
    union_expr.left = payload;
    const items: & & HIRExpr = exec_lower_alloc_items(ctx, 1);
    if items == null {
        return value;
    }
    items[0] = union_expr;
    const future_expr: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_STRUCT_INIT, &declared);
    if future_expr == null {
        return value;
    }
    future_expr.items = items;
    future_expr.item_count = 1;
    if needs_box == 0 {
        return future_expr;
    }
    // 装箱：接口值 = [方法入口下标…, 数据指针]。数据用结构体值本身，
    // 方法里的 `self` 由 VM 的字段访问自动解引用。
    var dispatch_buf: [&ASTNode: EXEC_MAX_INTERFACE_METHODS] = [];
    var dispatch_count: i32 = 0;
    if exec_lower_collect_interface_dispatch_decls(ctx, &interface_type, &declared,
            &dispatch_buf[0] as & & ASTNode, &dispatch_count) != 0 {
        return value;
    }
    const dispatch_decls: & & ASTNode = compiler_arena_alloc(ctx.arena,
        @size_of(&ASTNode) * dispatch_count as usize) as & & ASTNode;
    if dispatch_count > 0 && dispatch_decls == null {
        return value;
    }
    var di: i32 = 0;
    while di < dispatch_count {
        dispatch_decls[di] = dispatch_buf[di];
        di = di +| 1;
    }
    const boxed: &HIRExpr = exec_lower_alloc_expr(ctx, ast_node, HIRExprKind.HIR_EXPR_INTERFACE_BOX, &interface_type);
    if boxed == null {
        return value;
    }
    boxed.left = future_expr;
    boxed.dispatch_decls = dispatch_decls;
    boxed.dispatch_decl_count = dispatch_count;
    return boxed;
}

fn exec_lower_union_variant_index(ctx: &ExecLowerContext, union_type: Type, variant_name: &byte) i32 {
    const union_name: &byte = type_get_union_name(&union_type);
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        union_name == null || variant_name == null {
        return -1;
    }
    const union_decl: &ASTNode = find_union_decl_from_program(ctx.checker.program_node, union_name);
    if union_decl == null || union_decl.union_decl_variants == null {
        return -1;
    }
    var i: i32 = 0;
    while i < union_decl.union_decl_variant_count {
        const variant_decl: &ASTNode = union_decl.union_decl_variants[i];
        if variant_decl != null && variant_decl.type == ASTNodeType.AST_VAR_DECL &&
            variant_decl.var_decl_name != null && str_equals(variant_decl.var_decl_name, variant_name) != 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn exec_lower_union_variant_type(ctx: &ExecLowerContext, union_type: Type, variant_name: &byte) Type {
    const union_name: &byte = type_get_union_name(&union_type);
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null || union_name == null {
        return make_void_type();
    }
    const union_decl: &ASTNode = find_union_decl_from_program(ctx.checker.program_node, union_name);
    if union_decl == null || union_decl.union_decl_variants == null {
        return make_void_type();
    }
    var i: i32 = 0;
    while i < union_decl.union_decl_variant_count {
        const variant_decl: &ASTNode = union_decl.union_decl_variants[i];
        if variant_decl != null && variant_decl.type == ASTNodeType.AST_VAR_DECL &&
            variant_decl.var_decl_name != null && str_equals(variant_decl.var_decl_name, variant_name) != 0 &&
            variant_decl.var_decl_type != null {
            // `Option<Event>` 的 `.Some(evt)` 载荷声明是 `T`：按联合体实例的
            // 类型实参替换后再解析，否则绑定变量拿到的是泛型占位类型。
            if union_type.union_type_args != null && union_type.union_type_arg_count > 0 &&
                union_decl.union_decl_type_params != null && union_decl.union_decl_type_param_count > 0 {
                const saved_active: i32 = ctx.checker.subst_active;
                const saved_name: &byte = ctx.checker.subst_name;
                const saved_type: Type = copy_type(&ctx.checker.subst_type);
                const saved_params: &TypeParam = ctx.checker.current_type_params;
                const saved_param_count: i32 = ctx.checker.current_type_param_count;
                ctx.checker.current_type_params = union_decl.union_decl_type_params;
                ctx.checker.current_type_param_count = union_decl.union_decl_type_param_count;
                ctx.checker.subst_active = 1;
                ctx.checker.subst_name = union_decl.union_decl_type_params[0].name;
                ctx.checker.subst_type = copy_type(&union_type.union_type_args[0]);
                const resolved_payload: Type = type_from_ast(ctx.checker, variant_decl.var_decl_type);
                ctx.checker.subst_active = saved_active;
                ctx.checker.subst_name = saved_name;
                ctx.checker.subst_type = copy_type(&saved_type);
                ctx.checker.current_type_params = saved_params;
                ctx.checker.current_type_param_count = saved_param_count;
                return resolved_payload;
            }
            return type_from_ast(ctx.checker, variant_decl.var_decl_type);
        }
        i = i + 1;
    }
    return make_void_type();
}

/// `Kind.Closed` 这种「类型名.空载荷变体」取值形式（没有调用括号）。
///
/// 参数：`ctx` lowering 上下文；`expr` 成员访问节点；`expr_type` 推断出的类型。
/// 返回值：联合体值表达式；不适用（非联合体类型、找不到该变体、载荷非空）返回 null。
fn exec_lower_try_union_member_value(ctx: &ExecLowerContext, expr: &ASTNode, expr_type: &Type) &HIRExpr {
    if ctx == null || expr == null || expr.type != ASTNodeType.AST_MEMBER_ACCESS ||
        expr.member_access_object == null || expr.member_access_field_name == null ||
        ctx.checker == null || ctx.checker.program_node == null {
        return null;
    }
    const object: &ASTNode = expr.member_access_object;
    var union_name: &byte = null;
    if object.type == ASTNodeType.AST_IDENTIFIER && object.identifier_name != null {
        union_name = object.identifier_name;
    } else if object.type == ASTNodeType.AST_TYPE_NAMED && object.type_named_name != null {
        union_name = object.type_named_name;
    }
    if union_name == null || find_union_decl_from_program(ctx.checker.program_node, union_name) == null {
        return null;
    }
    var member_type: Type = expr_type[0];
    if member_type.kind != TypeKind.TYPE_UNION {
        member_type = make_named_type(TypeKind.TYPE_UNION, union_name);
    }
    const variant_index: i32 = exec_lower_union_variant_index(ctx, copy_type(&member_type), expr.member_access_field_name);
    if variant_index < 0 {
        return null;
    }
    const variant_type: Type = exec_lower_union_variant_type(ctx, copy_type(&member_type), expr.member_access_field_name);
    if variant_type.kind != TypeKind.TYPE_VOID {
        return null;
    }
    const hir_union: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_UNION_INIT, &member_type);
    if hir_union == null {
        return null;
    }
    hir_union.int_value = variant_index as i64;
    return hir_union;
}

fn exec_lower_try_union_ctor_expr(ctx: &ExecLowerContext, expr: &ASTNode, expr_type: &Type) &HIRExpr {
    if ctx == null || expr == null || expr.type != ASTNodeType.AST_CALL_EXPR ||
        expr.call_expr_callee == null || expr.call_expr_callee.type != ASTNodeType.AST_MEMBER_ACCESS {
        return null;
    }
    const callee: &ASTNode = expr.call_expr_callee;
    const object: &ASTNode = callee.member_access_object;
    var union_name: &byte = null;
    if object != null && object.type == ASTNodeType.AST_IDENTIFIER && object.identifier_name != null {
        union_name = object.identifier_name;
    } else if object != null && object.type == ASTNodeType.AST_TYPE_NAMED && object.type_named_name != null {
        union_name = object.type_named_name;
    }
    if union_name == null || callee.member_access_field_name == null || ctx.checker == null || ctx.checker.program_node == null {
        return null;
    }
    const union_decl: &ASTNode = find_union_decl_from_program(ctx.checker.program_node, union_name);
    if union_decl == null {
        return null;
    }
    // `EventKind.Readable({})`：类型推断拿不到具体联合体类型（结果是 void）时，
    // 按接收者类型名合成一个具名联合体类型，否则整条构造被当成未知方法调用。
    var ctor_type: Type = expr_type[0];
    if ctor_type.kind != TypeKind.TYPE_UNION &&
        find_union_decl_from_program(ctx.checker.program_node, union_name) != null {
        ctor_type = make_named_type(TypeKind.TYPE_UNION, union_name);
    }
    const variant_index: i32 = exec_lower_union_variant_index(ctx, copy_type(&ctor_type), callee.member_access_field_name);
    if variant_index < 0 {
        return null;
    }
    const variant_type: Type = exec_lower_union_variant_type(ctx, copy_type(&ctor_type), callee.member_access_field_name);
    var payload_expr: &HIRExpr = null;
    if variant_type.kind == TypeKind.TYPE_VOID {
        // 空载荷变体允许带实参（`EventKind.Readable({})` 这种写法 checker 接受），
        // 实参没有语义，直接忽略。
    } else {
        if expr.call_expr_arg_count != 1 || expr.call_expr_args == null {
            return exec_lower_fail_expr(expr, "exec: union 变体当前仅支持单参数构造" as *byte);
        }
        payload_expr = exec_lower_expr(ctx, expr.call_expr_args[0]);
        if payload_expr == null {
            return null;
        }
    }
    const hir_union: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_UNION_INIT, &ctor_type);
    if hir_union == null {
        return null;
    }
    hir_union.int_value = variant_index as i64;
    hir_union.left = payload_expr;
    return hir_union;
}

fn exec_lower_alloc_items(ctx: &ExecLowerContext, count: i32) & & HIRExpr {
    if count <= 0 {
        return null;
    }
    return compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * count as usize) as & & HIRExpr;
}

fn exec_lower_expr_list(ctx: &ExecLowerContext, exprs: & & ASTNode, count: i32) & & HIRExpr {
    const items: & & HIRExpr = exec_lower_alloc_items(ctx, count);
    if count > 0 && items == null {
        exec_backend_set_error(ctx.function_decl, "exec: HIR expr 列表分配失败" as *byte, 0);
        return null;
    }
    var i: i32 = 0;
    while i < count {
        const item: &HIRExpr = exec_lower_expr(ctx, exprs[i]);
        if item == null {
            return null;
        }
        items[i] = item;
        i = i + 1;
    }
    return items;
}

/// `mod.f(args)` 里 `mod` 是模块名而不是值：把 callee 就地改写成标识符 `f`，
/// 让后面的直接调用路径按文件名+导入关系解析。类型名/静态方法调用不受影响。
///
/// 参数：`ctx` lowering 上下文；`call_expr` 是 `AST_CALL_EXPR` 节点。
/// 返回值：发生了改写返回 1，否则 0。
fn exec_lower_rewrite_module_qualified_callee(ctx: &ExecLowerContext, call_expr: &ASTNode) i32 {
    if ctx == null || call_expr == null || call_expr.type != ASTNodeType.AST_CALL_EXPR {
        return 0;
    }
    const callee: &ASTNode = call_expr.call_expr_callee;
    if callee == null || callee.type != ASTNodeType.AST_MEMBER_ACCESS {
        return 0;
    }
    const object_ast: &ASTNode = callee.member_access_object;
    const member_name: &byte = callee.member_access_field_name;
    if object_ast == null || object_ast.type != ASTNodeType.AST_IDENTIFIER ||
        object_ast.identifier_name == null || member_name == null {
        return 0;
    }
    const qualifier: &byte = object_ast.identifier_name;
    if find_struct_decl_from_program(ctx.checker.program_node, qualifier) != null {
        return 0;
    }
    if find_union_decl_from_program(ctx.checker.program_node, qualifier) != null {
        return 0;
    }
    if find_interface_decl_from_program(ctx.checker.program_node, qualifier) != null {
        return 0;
    }
    if find_type_alias_from_program(ctx.checker.program_node, qualifier) != null {
        return 0;
    }
    if exec_lower_find_slot(ctx, qualifier) >= 0 {
        return 0;
    }
    var target_decl: &ASTNode = exec_lower_resolve_function_decl_from_file(ctx.checker, call_expr.filename, member_name);
    if target_decl == null && call_expr.filename != null {
        target_decl = exec_lower_resolve_imported_decl_from_file(ctx.checker, call_expr.filename, member_name, 10);
    }
    if target_decl == null || target_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    callee.type = ASTNodeType.AST_IDENTIFIER;
    callee.identifier_name = member_name;
    return 1;
}

fn exec_lower_member_base_type(ctx: &ExecLowerContext, object: &ASTNode) Type {
    var base_type: Type = exec_lower_resolve_exact_type(ctx, object);
    if type_get_struct_name(&base_type) != null {
        return base_type;
    }
    if base_type.kind == TypeKind.TYPE_POINTER && base_type.pointer_to != null {
        return base_type.pointer_to[0];
    }
    if object != null && object.type == ASTNodeType.AST_IDENTIFIER && object.identifier_name != null {
        const symbol: &Symbol = symbol_table_lookup(ctx.checker, object.identifier_name);
        if symbol != null && symbol.type.kind != TypeKind.TYPE_VOID {
            if symbol.type.kind == TypeKind.TYPE_POINTER && symbol.type.pointer_to != null {
                return symbol.type.pointer_to[0];
            }
            return symbol.type;
        }
        const slot: i32 = exec_lower_find_slot(ctx, object.identifier_name);
        if slot >= 0 && slot < EXEC_MAX_LOCALS {
            if exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0].kind == TypeKind.TYPE_POINTER && exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0].pointer_to != null {
                return exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0].pointer_to[0];
            }
            return exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0];
        }
        const global_slot: i32 = exec_lower_find_global_slot(ctx, object.identifier_name);
        if global_slot >= 0 && global_slot < EXEC_MAX_GLOBALS {
            if exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS)[0].kind == TypeKind.TYPE_POINTER && exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS)[0].pointer_to != null {
                return exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS)[0].pointer_to[0];
            }
            return exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS)[0];
        }
    }
    if object != null && object.type == ASTNodeType.AST_MEMBER_ACCESS &&
        object.member_access_object != null && object.member_access_field_name != null {
        var parent_type: Type = exec_lower_member_base_type(ctx, object.member_access_object);
        if parent_type.kind == TypeKind.TYPE_POINTER && parent_type.pointer_to != null {
            parent_type = parent_type.pointer_to[0];
        }
        if parent_type.kind == TypeKind.TYPE_TUPLE && parent_type.tuple_element_types != null {
            const tuple_index: i32 = atoi(object.member_access_field_name as *byte);
            if tuple_index >= 0 && tuple_index < parent_type.tuple_count {
                return parent_type.tuple_element_types[tuple_index];
            }
        }
        if parent_type.kind == TypeKind.TYPE_STRUCT {
            const field_type: Type = exec_lower_struct_field_type(ctx, parent_type, object.member_access_field_name);
            if field_type.kind != TypeKind.TYPE_VOID {
                return field_type;
            }
        }
    }
    return base_type;
}

fn exec_lower_make_assign_stmt(ctx: &ExecLowerContext, ast_node: &ASTNode, slot: i32, value: &HIRExpr) &HIRStmt {
    const stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, ast_node, HIRStmtKind.HIR_STMT_ASSIGN);
    if stmt == null {
        return null;
    }
    if value == null {
        exec_backend_set_error(ast_node, "exec: assign 语句值为空" as *byte, 0);
        return null;
    }
    const target: &HIRExpr = exec_lower_make_local_expr(ctx, ast_node, slot, &value.type_ref.type);
    if target == null {
        return null;
    }
    stmt.local_slot = slot;
    stmt.assign_target = target;
    stmt.assign_expr = value;
    return stmt;
}

/// `字段: [T: N] = 值` 这种「带类型的初始化」在 AST 里是 assign 形态（dest 是类型标注，
/// 不是真正的写目标）。这类节点取右值即可，否则会被当成非法赋值目标。
/// 参数：`ast_node` 待检查的 AST 节点。
/// 返回值：真正的值节点（普通赋值原样返回）。
fn exec_lower_unwrap_typed_init(ast_node: &ASTNode) &ASTNode {
    if ast_node == null || ast_node.type != ASTNodeType.AST_ASSIGN || ast_node.assign_dest == null {
        return ast_node;
    }
    const dest: &ASTNode = ast_node.assign_dest;
    if dest.type == ASTNodeType.AST_IDENTIFIER || dest.type == ASTNodeType.AST_MEMBER_ACCESS ||
        dest.type == ASTNodeType.AST_ARRAY_ACCESS || dest.type == ASTNodeType.AST_UNARY_EXPR {
        return ast_node;
    }
    if ast_node.assign_src != null {
        return ast_node.assign_src;
    }
    return ast_node;
}

fn exec_lower_make_dest_expr(ctx: &ExecLowerContext, expr: &ASTNode) &HIRExpr {
    if ctx == null || expr == null {
        return null;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        return exec_lower_expr(ctx, expr);
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        return exec_lower_expr(ctx, expr);
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        return exec_lower_expr(ctx, expr);
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR &&
        expr.unary_expr_operand != null &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_ASTERISK {
        return exec_lower_expr(ctx, expr);
    }
    return exec_lower_fail_expr(expr, "exec: 当前仅支持局部变量/字段/下标赋值" as *byte);
}

fn exec_lower_wrap_block_as_stmt(ctx: &ExecLowerContext, ast_node: &ASTNode, block: &HIRBlock) &HIRStmt {
    const stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, ast_node, HIRStmtKind.HIR_STMT_BLOCK);
    if stmt == null {
        return null;
    }
    stmt.then_block = block;
    return stmt;
}

fn exec_lower_wrap_stmt_node_as_block(ctx: &ExecLowerContext, stmt_node: &ASTNode) &HIRBlock {
    if ctx == null || stmt_node == null {
        return null;
    }
    if stmt_node.type == ASTNodeType.AST_BLOCK {
        return exec_lower_block(ctx, stmt_node);
    }
    const synthetic_block: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
    const synthetic_stmts: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode)) as & & ASTNode;
    if synthetic_block == null || synthetic_stmts == null {
        exec_backend_set_error(stmt_node, "exec: defer/errdefer synthetic block 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(synthetic_block as *byte, 0, @size_of(ASTNode));
    synthetic_block.type = ASTNodeType.AST_BLOCK;
    synthetic_block.line = stmt_node.line;
    synthetic_block.column = stmt_node.column;
    synthetic_block.filename = stmt_node.filename;
    synthetic_block.block_stmts = synthetic_stmts;
    synthetic_block.block_stmt_count = 1;
    synthetic_stmts[0] = stmt_node;
    return exec_lower_block(ctx, synthetic_block);
}

fn exec_lower_make_break_block(ctx: &ExecLowerContext, ast_node: &ASTNode) &HIRBlock {
    const block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, ast_node, 1);
    const stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, ast_node, HIRStmtKind.HIR_STMT_BREAK);
    if block == null || stmt == null {
        exec_backend_set_error(ast_node, "exec: break block 分配失败" as *byte, 0);
        return null;
    }
    block.stmts[1] = stmt;
    return block;
}

/// 合成一个零初始化的 AST 节点（位置信息抄自 `like`）。
/// 参数：`ctx` 上下文；`like` 位置模板（可为 null）；`node_type` 节点类型。
/// 返回值：新节点；失败返回 null。
fn exec_lower_alloc_synth_ast(ctx: &ExecLowerContext, like: &ASTNode, node_type: ASTNodeType) &ASTNode {
    const node: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
    if node == null {
        return null;
    }
    _ = memset(node as *byte, 0, @size_of(ASTNode));
    node.type = node_type;
    if like != null {
        node.line = like.line;
        node.column = like.column;
        node.filename = like.filename;
    }
    return node;
}

/// 合成 `__exec_iter.next()` / `__exec_iter.value()` 这类零参方法调用。
/// 参数：`ctx` 上下文；`like` 位置模板；`method` 方法名。返回值：调用节点。
fn exec_lower_synth_iter_call(ctx: &ExecLowerContext, like: &ASTNode, method: &byte) &ASTNode {
    const recv: &ASTNode = exec_lower_alloc_synth_ast(ctx, like, ASTNodeType.AST_IDENTIFIER);
    const member: &ASTNode = exec_lower_alloc_synth_ast(ctx, like, ASTNodeType.AST_MEMBER_ACCESS);
    const call: &ASTNode = exec_lower_alloc_synth_ast(ctx, like, ASTNodeType.AST_CALL_EXPR);
    if recv == null || member == null || call == null {
        return null;
    }
    recv.identifier_name = "__exec_iter" as &byte;
    member.member_access_object = recv;
    member.member_access_field_name = method;
    call.call_expr_callee = member;
    call.call_expr_arg_count = 0;
    return call;
}

/// 合成 `const <name> = <init>;` 声明。
/// 参数：`ctx` 上下文；`like` 位置模板；`name` 变量名；`init` 初始值表达式。
/// 返回值：声明节点。
fn exec_lower_synth_const_decl(ctx: &ExecLowerContext, like: &ASTNode, name: &byte, init: &ASTNode) &ASTNode {
    const decl: &ASTNode = exec_lower_alloc_synth_ast(ctx, like, ASTNodeType.AST_VAR_DECL);
    if decl == null {
        return null;
    }
    decl.var_decl_name = name;
    decl.var_decl_init = init;
    decl.var_decl_is_const = 1;
    return decl;
}

/// 合成一个 `AST_BLOCK`，语句数组按参数给定的顺序排列。
/// 参数：`ctx` 上下文；`like` 位置模板；`stmts` 语句数组；`count` 语句条数。
/// 返回值：块节点。
fn exec_lower_synth_block(ctx: &ExecLowerContext, like: &ASTNode, stmts: & & ASTNode, count: i32) &ASTNode {
    const block: &ASTNode = exec_lower_alloc_synth_ast(ctx, like, ASTNodeType.AST_BLOCK);
    const stmt_list: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode) * (count as usize)) as & & ASTNode;
    if block == null || (count > 0 && stmt_list == null) {
        return null;
    }
    var i: i32 = 0;
    while i < count {
        stmt_list[i] = stmts[i];
        i = i + 1;
    }
    block.block_stmts = stmt_list;
    block.block_stmt_count = count;
    return block;
}

/// 把 `for iter |v| { ... }` 改写成等价的 while 形状（迭代器协议）。
///
/// 协议来自 checker：迭代器类型有 `next(self: &Self) !void` 和
/// `value(self: &Self) T`；`next` 返回错误表示迭代结束。等价写法是
/// ```
/// const __exec_iter = <iter>;
/// while true {
///     const __exec_ok = __exec_iter.next() catch { break; };
///     const v = __exec_iter.value();
///     <body>
/// }
/// ```
/// 参数：`ctx` 上下文；`stmt_node` 是 `AST_FOR_STMT`。
/// 返回值：改写后的 `AST_BLOCK` 节点；失败返回 null。
fn exec_lower_desugar_iterator_for(ctx: &ExecLowerContext, stmt_node: &ASTNode, value_is_pointer: i32) &ASTNode {
    if ctx == null || stmt_node == null || stmt_node.for_stmt_array == null {
        return null;
    }
    const iter_decl: &ASTNode = exec_lower_synth_const_decl(ctx, stmt_node, "__exec_iter" as &byte,
        stmt_node.for_stmt_array);
    const break_stmt: &ASTNode = exec_lower_alloc_synth_ast(ctx, stmt_node, ASTNodeType.AST_BREAK_STMT);
    if iter_decl == null || break_stmt == null {
        return null;
    }
    const break_stmts: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode)) as & & ASTNode;
    if break_stmts == null {
        return null;
    }
    break_stmts[0] = break_stmt;
    const catch_block: &ASTNode = exec_lower_synth_block(ctx, stmt_node, &break_stmts[0], 1);
    const next_call: &ASTNode = exec_lower_synth_iter_call(ctx, stmt_node, "next" as &byte);
    const catch_expr: &ASTNode = exec_lower_alloc_synth_ast(ctx, stmt_node, ASTNodeType.AST_CATCH_EXPR);
    if catch_block == null || next_call == null || catch_expr == null {
        return null;
    }
    catch_expr.catch_expr_operand = next_call;
    catch_expr.catch_expr_catch_block = catch_block;
    const ok_decl: &ASTNode = exec_lower_synth_const_decl(ctx, stmt_node, "__exec_ok" as &byte, catch_expr);
    if ok_decl == null {
        return null;
    }
    var loop_stmts: [&ASTNode: 4] = [];
    var loop_count: i32 = 1;
    loop_stmts[0] = ok_decl;
    var bind_name: &byte = stmt_node.for_stmt_var_name;
    if bind_name != null && str_equals(bind_name, "_" as &byte) != 0 {
        bind_name = null;
    }
    if bind_name != null {
        const value_call: &ASTNode = exec_lower_synth_iter_call(ctx, stmt_node, "value" as &byte);
        if value_call == null {
            return null;
        }
        if stmt_node.for_stmt_is_ref != 0 && value_is_pointer != 0 {
            // `value()` 已经返回指针：`|&item|` 直接绑定它。
            const ptr_decl: &ASTNode = exec_lower_synth_const_decl(ctx, stmt_node, bind_name, value_call);
            if ptr_decl == null {
                return null;
            }
            loop_stmts[1] = ptr_decl;
            loop_count = 2;
        } else if stmt_node.for_stmt_is_ref != 0 {
            // `|&item|`：先落到一个每轮新建的临时，再绑定它的地址。
            const tmp_decl: &ASTNode = exec_lower_synth_const_decl(ctx, stmt_node,
                "__exec_item" as &byte, value_call);
            const addr: &ASTNode = exec_lower_alloc_synth_ast(ctx, stmt_node, ASTNodeType.AST_UNARY_EXPR);
            const tmp_ident: &ASTNode = exec_lower_alloc_synth_ast(ctx, stmt_node, ASTNodeType.AST_IDENTIFIER);
            if tmp_decl == null || addr == null || tmp_ident == null {
                return null;
            }
            tmp_ident.identifier_name = "__exec_item" as &byte;
            addr.unary_expr_op = TokenType.TOKEN_AMPERSAND;
            addr.unary_expr_operand = tmp_ident;
            const ref_decl: &ASTNode = exec_lower_synth_const_decl(ctx, stmt_node, bind_name, addr);
            if ref_decl == null {
                return null;
            }
            loop_stmts[1] = tmp_decl;
            loop_stmts[2] = ref_decl;
            loop_count = 3;
        } else {
            const bind_decl: &ASTNode = exec_lower_synth_const_decl(ctx, stmt_node, bind_name, value_call);
            if bind_decl == null {
                return null;
            }
            loop_stmts[1] = bind_decl;
            loop_count = 2;
        }
    }
    loop_stmts[loop_count] = stmt_node.for_stmt_body;
    loop_count = loop_count +| 1;
    const loop_block: &ASTNode = exec_lower_synth_block(ctx, stmt_node, &loop_stmts[0], loop_count);
    const cond: &ASTNode = exec_lower_alloc_synth_ast(ctx, stmt_node, ASTNodeType.AST_BOOL);
    const while_node: &ASTNode = exec_lower_alloc_synth_ast(ctx, stmt_node, ASTNodeType.AST_WHILE_STMT);
    if loop_block == null || cond == null || while_node == null {
        return null;
    }
    cond.bool_literal_value = 1;
    while_node.while_stmt_condition = cond;
    while_node.while_stmt_body = loop_block;
    var outer_stmts: [&ASTNode: 2] = [];
    outer_stmts[0] = iter_decl;
    outer_stmts[1] = while_node;
    return exec_lower_synth_block(ctx, stmt_node, &outer_stmts[0], 2);
}

fn exec_lower_make_for_array_stmt(ctx: &ExecLowerContext, stmt_node: &ASTNode) &HIRStmt {
    if ctx == null || stmt_node == null || stmt_node.for_stmt_array == null {
        return null;
    }
    const is_ref_binding: i32 = stmt_node.for_stmt_is_ref;
    const array_expr: &HIRExpr = exec_lower_expr(ctx, stmt_node.for_stmt_array);
    if array_expr == null {
        return null;
    }
    const array_type: Type = array_expr.type_ref.type;
    var element_type: Type = make_void_type();
    if array_type.kind == TypeKind.TYPE_ARRAY && array_type.element_type != null {
        element_type = array_type.element_type[0];
    } else if array_type.kind == TypeKind.TYPE_SLICE && array_type.slice_element_type != null {
        element_type = array_type.slice_element_type[0];
    } else if array_type.kind == TypeKind.TYPE_STRUCT &&
        !(array_type.struct_name != null &&
          find_instance_method_in_struct(ctx.checker.program_node, array_type.struct_name, "next" as *byte) == null) {
        // 迭代器协议（`for iter |v|`）：改写成 while + next/value 调用复用普通降级。
        var value_is_pointer: i32 = 0;
        if array_type.struct_name != null && ctx.checker.program_node != null {
            const value_method: &ASTNode = find_instance_method_in_struct(ctx.checker.program_node,
                array_type.struct_name, "value" as *byte);
            if value_method != null && value_method.fn_decl_return_type != null {
                const value_ret_type: Type = type_from_ast(ctx.checker, value_method.fn_decl_return_type);
                if value_ret_type.kind == TypeKind.TYPE_POINTER {
                    value_is_pointer = 1;
                }
            }
        }
        const desugared: &ASTNode = exec_lower_desugar_iterator_for(ctx, stmt_node, value_is_pointer);
        if desugared == null {
            return null;
        }
        const desugared_block: &HIRBlock = exec_lower_wrap_stmt_node_as_block(ctx, desugared);
        if desugared_block == null {
            return null;
        }
        return exec_lower_wrap_block_as_stmt(ctx, stmt_node, desugared_block);
    } else {
        exec_backend_set_generic_unsupported_error(stmt_node, "exec: for 迭代对象必须是数组或切片" as *byte);
        return null;
    }
    // `|&item|` 绑定的是元素地址（与 C99 的引用迭代一致）。
    var bind_type: Type = copy_type(&element_type);
    if is_ref_binding != 0 {
        bind_type = exec_lower_make_pointer_type_copy(ctx, copy_type(&element_type));
        if bind_type.kind != TypeKind.TYPE_POINTER {
            exec_backend_set_error(stmt_node, "exec: for 引用绑定类型无效" as *byte, 0);
            return null;
        }
    }
    if exec_lower_push_scope(ctx, stmt_node, -1) == 0 {
        return null;
    }
    const array_slot: i32 = exec_lower_append_local(ctx, null, "__exec_for_arr" as *byte, &array_type, 0);
    const index_type: Type = make_i32_type();
    const index_slot: i32 = exec_lower_append_local(ctx, null, "__exec_for_idx" as *byte, &index_type, 0);
    var item_slot: i32 = -1;
    var bind_name: &byte = stmt_node.for_stmt_var_name;
    if bind_name != null && str_equals(bind_name, "_" as &byte) != 0 {
        bind_name = null;
    }
    if bind_name != null {
        item_slot = exec_lower_append_local(ctx, null, bind_name, &bind_type, 0);
    }
    if array_slot < 0 || index_slot < 0 || (bind_name != null && item_slot < 0) {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for 数组槽位不足" as *byte, 0);
        return null;
    }
    // 引用绑定必须写到原数组上：临时局部只是副本，取它的地址会让写回丢失。
    var array_ref_expr: &HIRExpr = null;
    if is_ref_binding != 0 {
        array_ref_expr = exec_lower_make_ref_expr(ctx, stmt_node.for_stmt_array);
    }
    const user_body: &HIRBlock = exec_lower_block(ctx, stmt_node.for_stmt_body);
    if user_body == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    const bool_type: Type = make_bool_type();
    const arr_local_for_len: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, array_slot, &array_type);
    const len_expr: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_LEN, &index_type);
    const index_local_for_cond: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, index_slot, &index_type);
    if arr_local_for_len == null || len_expr == null || index_local_for_cond == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    len_expr.left = arr_local_for_len;
    const cond_expr: &HIRExpr = exec_lower_make_binary_expr(ctx, stmt_node, TokenType.TOKEN_LESS as i32, index_local_for_cond, len_expr, &bool_type);
    if cond_expr == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    var then_body_count: i32 = 1;
    if bind_name != null {
        then_body_count = 2;
    }
    const then_block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, then_body_count);
    const break_block: &HIRBlock = exec_lower_make_break_block(ctx, stmt_node);
    if then_block == null || break_block == null {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for 数组循环块分配失败" as *byte, 0);
        return null;
    }
    var then_index: i32 = 1;
    if bind_name != null {
        const arr_local_for_item: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, array_slot, &array_type);
        const index_local_for_item: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, index_slot, &index_type);
        var item_expr: &HIRExpr = null;
        if is_ref_binding != 0 {
            item_expr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_ADDR, &bind_type);
        } else {
            item_expr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_INDEX, &element_type);
        }
        const bind_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
        if arr_local_for_item == null || index_local_for_item == null || item_expr == null || bind_stmt == null {
            exec_lower_pop_scope(ctx);
            return null;
        }
        var ref_base_expr: &HIRExpr = arr_local_for_item;
        if array_ref_expr != null {
            ref_base_expr = array_ref_expr;
        }
        item_expr.left = ref_base_expr;
        item_expr.right = index_local_for_item;
        bind_stmt.local_slot = item_slot;
        bind_stmt.expr = item_expr;
        then_block.stmts[then_index] = bind_stmt;
        then_index = then_index +| 1;
    }
    const wrapped_user_body: &HIRStmt = exec_lower_wrap_block_as_stmt(ctx, stmt_node.for_stmt_body, user_body);
    const zero_expr: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_CONST, &index_type);
    const index_local_for_inc: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, index_slot, &index_type);
    const one_expr: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_CONST, &index_type);
    if wrapped_user_body == null || zero_expr == null || index_local_for_inc == null || one_expr == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    // 计数器用 -1 起步、循环体开头先自增：`continue` 会跳回循环体开头，
    // 自增必须在那里，否则 continue 会跳过自增导致死循环。
    zero_expr.int_value = -1;
    one_expr.int_value = 1;
    const next_index_expr: &HIRExpr = exec_lower_make_binary_expr(ctx, stmt_node, TokenType.TOKEN_PLUS as i32, index_local_for_inc, one_expr, &index_type);
    const inc_stmt: &HIRStmt = exec_lower_make_assign_stmt(ctx, stmt_node, index_slot, next_index_expr);
    const cond_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_IF);
    const loop_body: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 2);
    const loop_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_LOOP);
    const setup_block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 3);
    const init_array: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
    const init_index: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
    if inc_stmt == null || cond_stmt == null || loop_body == null || loop_stmt == null ||
        setup_block == null || init_array == null || init_index == null {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for 数组循环装配失败" as *byte, 0);
        return null;
    }
    then_block.stmts[then_index] = wrapped_user_body;
    cond_stmt.expr = cond_expr;
    cond_stmt.then_block = then_block;
    cond_stmt.else_block = break_block;
    loop_body.stmts[1] = inc_stmt;
    loop_body.stmts[2] = cond_stmt;
    loop_stmt.loop_body = loop_body;
    init_array.local_slot = array_slot;
    init_array.expr = array_expr;
    init_index.local_slot = index_slot;
    init_index.expr = zero_expr;
    setup_block.stmts[1] = init_array;
    setup_block.stmts[2] = init_index;
    setup_block.stmts[3] = loop_stmt;
    const result_stmt: &HIRStmt = exec_lower_wrap_block_as_stmt(ctx, stmt_node, setup_block);
    exec_lower_pop_scope(ctx);
    return result_stmt;
}

fn exec_lower_is_int_kind(kind: TypeKind) i32 {
    if kind == TypeKind.TYPE_I8 || kind == TypeKind.TYPE_I16 || kind == TypeKind.TYPE_I32 ||
        kind == TypeKind.TYPE_I64 || kind == TypeKind.TYPE_U8 || kind == TypeKind.TYPE_U16 ||
        kind == TypeKind.TYPE_U32 || kind == TypeKind.TYPE_U64 || kind == TypeKind.TYPE_USIZE {
        return 1;
    }
    return 0;
}

fn exec_lower_is_unsigned_int_kind(kind: TypeKind) i32 {
    if kind == TypeKind.TYPE_U8 || kind == TypeKind.TYPE_U16 || kind == TypeKind.TYPE_U32 ||
        kind == TypeKind.TYPE_U64 || kind == TypeKind.TYPE_USIZE {
        return 1;
    }
    return 0;
}

/// 计算 for range 的迭代变量/边界类型。
/// 参数：start_type - 起始边界类型；end_type - 结束边界类型。
/// 返回：两侧都是 i32 时返回 i32；任一侧无符号时返回 usize；否则 i64。
fn exec_lower_for_range_type(start_type: &Type, end_type: &Type) Type {
    if start_type.kind == TypeKind.TYPE_I32 && end_type.kind == TypeKind.TYPE_I32 {
        return make_i32_type();
    }
    if exec_lower_is_unsigned_int_kind(start_type.kind) != 0 ||
        exec_lower_is_unsigned_int_kind(end_type.kind) != 0 {
        return make_usize_type();
    }
    if start_type.kind == TypeKind.TYPE_I64 || end_type.kind == TypeKind.TYPE_I64 {
        return make_i64_type();
    }
    return make_i32_type();
}

/// 把 for range 边界表达式转换成统一的迭代类型（必要时插入 CAST）。
/// 参数：ctx - lowering 上下文；stmt_node - for 语句节点；bound - 边界表达式；target - 目标类型。
/// 返回：转换后的表达式；分配失败返回 null。
fn exec_lower_for_range_bound(ctx: &ExecLowerContext, stmt_node: &ASTNode, bound: &HIRExpr, target: &Type) &HIRExpr {
    if ctx == null || bound == null || target == null {
        return null;
    }
    if type_equals(bound.type_ref.type, target[0]) != 0 {
        return bound;
    }
    const cast: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_CAST, target);
    if cast == null {
        return null;
    }
    cast.left = bound;
    return cast;
}

fn exec_lower_make_for_range_stmt(ctx: &ExecLowerContext, stmt_node: &ASTNode) &HIRStmt {
    if stmt_node == null {
        return null;
    }
    if stmt_node.for_stmt_is_range == 0 {
        return exec_lower_make_for_array_stmt(ctx, stmt_node);
    }
    // 未写迭代变量（`for 0..3 { }`）或写 `_` 时，绑定到内部临时变量即可。
    var iter_bind_name: &byte = stmt_node.for_stmt_var_name;
    if iter_bind_name == null || str_equals(iter_bind_name, "_" as &byte) != 0 {
        iter_bind_name = "__exec_for_iter" as &byte;
    }
    if stmt_node.for_stmt_is_ref != 0 {
        exec_backend_set_generic_unsupported_error(stmt_node, "exec: 当前不支持 for range 引用绑定" as *byte);
        return null;
    }
    if stmt_node.for_stmt_range_end == null {
        exec_backend_set_generic_unsupported_error(stmt_node, "exec: 当前不支持无上界 for range" as *byte);
        return null;
    }
    var start_expr: &HIRExpr = exec_lower_expr(ctx, stmt_node.for_stmt_range_start);
    var end_expr: &HIRExpr = exec_lower_expr(ctx, stmt_node.for_stmt_range_end);
    if start_expr == null || end_expr == null {
        return null;
    }
    if exec_lower_is_int_kind(start_expr.type_ref.type.kind) == 0 ||
        exec_lower_is_int_kind(end_expr.type_ref.type.kind) == 0 {
        exec_backend_set_generic_unsupported_error(stmt_node, "exec: for range 边界须为整数类型" as *byte);
        return null;
    }
    const range_type: Type = exec_lower_for_range_type(&start_expr.type_ref.type, &end_expr.type_ref.type);
    start_expr = exec_lower_for_range_bound(ctx, stmt_node, start_expr, &range_type);
    end_expr = exec_lower_for_range_bound(ctx, stmt_node, end_expr, &range_type);
    if start_expr == null || end_expr == null {
        return null;
    }

    if exec_lower_push_scope(ctx, stmt_node, -1) == 0 {
        return null;
    }
    const iter_type: Type = copy_type(&range_type);
    const iter_slot: i32 = exec_lower_append_local(ctx, null, iter_bind_name, &iter_type, 0);
    const end_slot: i32 = exec_lower_append_local(ctx, null, "__exec_for_end" as *byte, &iter_type, 0);
    if iter_slot < 0 || end_slot < 0 {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for range 槽位不足" as *byte, 0);
        return null;
    }

    const user_body: &HIRBlock = exec_lower_block(ctx, stmt_node.for_stmt_body);
    if user_body == null {
        exec_lower_pop_scope(ctx);
        return null;
    }

    const loop_body: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 2);
    if loop_body == null {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for loop body 分配失败" as *byte, 0);
        return null;
    }

    const iter_local_for_cond: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, iter_slot, &iter_type);
    const end_local_for_cond: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, end_slot, &iter_type);
    const cond_type: Type = make_bool_type();
    const cond_expr: &HIRExpr = exec_lower_make_binary_expr(ctx, stmt_node, TokenType.TOKEN_LESS as i32, iter_local_for_cond, end_local_for_cond, &cond_type);
    const then_block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 1);
    const break_block: &HIRBlock = exec_lower_make_break_block(ctx, stmt_node);
    if cond_expr == null || then_block == null || break_block == null {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for 条件块分配失败" as *byte, 0);
        return null;
    }

    const wrapped_user_body: &HIRStmt = exec_lower_wrap_block_as_stmt(ctx, stmt_node.for_stmt_body, user_body);
    const one_expr: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_CONST, &iter_type);
    const iter_local_for_inc: &HIRExpr = exec_lower_make_local_expr(ctx, stmt_node, iter_slot, &iter_type);
    if wrapped_user_body == null || one_expr == null || iter_local_for_inc == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    one_expr.int_value = 1;
    const next_iter_expr: &HIRExpr = exec_lower_make_binary_expr(ctx, stmt_node, TokenType.TOKEN_PLUS as i32, iter_local_for_inc, one_expr, &iter_type);
    const inc_stmt: &HIRStmt = exec_lower_make_assign_stmt(ctx, stmt_node, iter_slot, next_iter_expr);
    // 计数器从 start-1 起步、循环体开头先自增：`continue` 跳回循环体开头，
    // 自增必须在那里，否则 continue 会跳过自增导致死循环。
    const init_one: &HIRExpr = exec_lower_alloc_expr(ctx, stmt_node, HIRExprKind.HIR_EXPR_CONST, &iter_type);
    if inc_stmt == null || init_one == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    init_one.int_value = 1;
    const start_minus_one: &HIRExpr = exec_lower_make_binary_expr(ctx, stmt_node, TokenType.TOKEN_MINUS as i32, start_expr, init_one, &iter_type);
    if start_minus_one == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    then_block.stmts[1] = wrapped_user_body;

    const cond_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_IF);
    if cond_stmt == null {
        exec_lower_pop_scope(ctx);
        return null;
    }
    cond_stmt.expr = cond_expr;
    cond_stmt.then_block = then_block;
    cond_stmt.else_block = break_block;
    loop_body.stmts[1] = inc_stmt;
    loop_body.stmts[2] = cond_stmt;

    const loop_stmt: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_LOOP);
    const setup_block: &HIRBlock = exec_lower_alloc_scoped_block(ctx, stmt_node, 3);
    const init_iter: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
    const init_end: &HIRStmt = exec_lower_alloc_stmt(ctx, stmt_node, HIRStmtKind.HIR_STMT_VAR_INIT);
    if loop_stmt == null || setup_block == null || init_iter == null || init_end == null {
        exec_lower_pop_scope(ctx);
        exec_backend_set_error(stmt_node, "exec: for setup block 分配失败" as *byte, 0);
        return null;
    }
    loop_stmt.loop_body = loop_body;
    init_iter.local_slot = iter_slot;
    init_iter.expr = start_minus_one;
    init_end.local_slot = end_slot;
    init_end.expr = end_expr;
    setup_block.stmts[1] = init_iter;
    setup_block.stmts[2] = init_end;
    setup_block.stmts[3] = loop_stmt;

    const result_stmt: &HIRStmt = exec_lower_wrap_block_as_stmt(ctx, stmt_node, setup_block);
    exec_lower_pop_scope(ctx);
    return result_stmt;
}

fn exec_lower_global_name(decl: &ASTNode) &byte {
    if decl == null {
        return null;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL {
        return decl.var_decl_name;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return decl.extern_var_decl_name;
    }
    return null;
}

fn exec_lower_global_type_ast(decl: &ASTNode) &ASTNode {
    if decl == null {
        return null;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL {
        return decl.var_decl_type;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return decl.extern_var_decl_var_type;
    }
    return null;
}

fn exec_lower_global_init_ast(decl: &ASTNode) &ASTNode {
    if decl == null {
        return null;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL {
        return decl.var_decl_init;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return decl.extern_var_decl_init_expr;
    }
    return null;
}

fn exec_lower_global_is_const(decl: &ASTNode) i32 {
    if decl == null {
        return 0;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL {
        return decl.var_decl_is_const;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return decl.extern_var_decl_is_const;
    }
    return 0;
}

fn exec_lower_global_is_runtime_decl(decl: &ASTNode) i32 {
    if decl == null {
        return 0;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL {
        return (decl.var_decl_name != null) as i32;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL && decl.extern_var_decl_is_extern == 0 {
        return (decl.extern_var_decl_name != null) as i32;
    }
    return 0;
}

fn exec_lower_decl_is_uya_root_runtime(checker: &TypeChecker, decl: &ASTNode) i32 {
    if checker == null || decl == null || decl.filename == null || checker.uya_root_dir == null {
        return 0;
    }
    const root_len: i32 = strlen(checker.uya_root_dir as *byte) as i32;
    if root_len <= 0 {
        return 0;
    }
    return (strncmp(decl.filename as *byte, checker.uya_root_dir as *byte, root_len) == 0) as i32;
}

fn exec_lower_find_module_export_decl(checker: &TypeChecker, module_name: &byte, item_name: &byte, item_type: i32) &ASTNode {
    if checker == null || module_name == null || item_name == null {
        return null;
    }
    var mh: u32 = hash_string(module_name);
    const mtbl_cap: i32 = checker.module_table.table.capacity;
    var mi: i32 = (mh as i32) % mtbl_cap;
    if mi < 0 {
        mi = mi +% mtbl_cap;
    }
    var i: i32 = 0;
    while i < mtbl_cap {
        const slot: i32 = (mi + i) % mtbl_cap;
        const module: &ModuleInfo = checker_module_slot_at(checker, slot);
        if module == null {
            break;
        }
        if module.module_name != null && str_equals(module.module_name, module_name) != 0 {
            if module.exports != null {
                var ei: i32 = 0;
                while ei < module.export_count {
                    const export_item: &ExportedItem = &module.exports[ei];
                    if export_item.name != null && str_equals(export_item.name, item_name) != 0 {
                        if item_type == 0 || export_item.item_type == item_type {
                            return export_item.decl_node;
                        }
                    }
                    ei = ei + 1;
                }
            }
            break;
        }
        i = i + 1;
    }
    if str_equals(module_name, "libc" as &byte) != 0 {
        var slot_i: i32 = 0;
        while slot_i < mtbl_cap {
            const module2: &ModuleInfo = checker_module_slot_at(checker, slot_i);
            if module2 != null && module2.filename != null &&
                (strstr(module2.filename as *byte, "/lib/libc/" as *byte) != null ||
                 strstr(module2.filename as *byte, "lib/libc/" as *byte) != null ||
                 strstr(module2.filename as *byte, "\\lib\\libc\\" as *byte) != null) {
                if module2.exports != null {
                    var export_i: i32 = 0;
                    while export_i < module2.export_count {
                        const export_item2: &ExportedItem = &module2.exports[export_i];
                        if export_item2.name != null && str_equals(export_item2.name, item_name) != 0 {
                            if item_type == 0 || export_item2.item_type == item_type {
                                return export_item2.decl_node;
                            }
                        }
                        export_i = export_i + 1;
                    }
                }
            }
            slot_i = slot_i + 1;
        }
    }
    return null;
}

fn exec_lower_resolve_imported_decl(checker: &TypeChecker, local_name: &byte, item_type: i32) &ASTNode {
    if checker == null || local_name == null {
        return null;
    }
    const imported_item: &ImportedItem = checker_import_table_lookup_local_name(checker, local_name);
    if imported_item == null || imported_item.item_type == (0 - 1) ||
        imported_item.original_name == null || imported_item.module_name == null {
        return null;
    }
    if item_type != 0 && imported_item.item_type != 0 && imported_item.item_type != item_type {
        return null;
    }
    return exec_lower_find_module_export_decl(checker, imported_item.module_name, imported_item.original_name, item_type);
}

fn exec_lower_resolve_imported_decl_from_file(checker: &TypeChecker, filename: &byte, local_name: &byte, item_type: i32) &ASTNode {
    if checker == null || checker.program_node == null || checker.program_node.type != ASTNodeType.AST_PROGRAM ||
        filename == null || local_name == null {
        return null;
    }
    var i: i32 = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_USE_STMT &&
            decl.filename != null && str_equals(decl.filename, filename) != 0 &&
            decl.use_stmt_item_name != null &&
            decl.use_stmt_path_segments != null && decl.use_stmt_path_segment_count > 0 {
            var local_name_candidate: &byte = decl.use_stmt_alias;
            if local_name_candidate == null {
                local_name_candidate = decl.use_stmt_item_name;
            }
            if local_name_candidate != null && str_equals(local_name_candidate, local_name) != 0 {
                const module_segment_count: i32 = decl.use_stmt_path_segment_count - 1;
                if module_segment_count > 0 {
                    const module_name_len: i32 = exec_lower_joined_module_name_len(decl.use_stmt_path_segments, module_segment_count);
                    if module_name_len > 0 {
                        const module_name: &byte = compiler_arena_alloc(checker.arena, module_name_len as usize + 1 as usize) as &byte;
                        if module_name != null {
                            exec_lower_write_joined_module_name(module_name, decl.use_stmt_path_segments, module_segment_count);
                            const export_decl: &ASTNode = exec_lower_find_module_export_decl(checker, module_name, decl.use_stmt_item_name, item_type);
                            if export_decl != null {
                                return export_decl;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return null;
}

fn exec_lower_resolve_module_self_named_global_from_file(checker: &TypeChecker, filename: &byte, local_name: &byte) &ASTNode {
    if checker == null || filename == null || local_name == null {
        return null;
    }
    const module_name: &byte = exec_lower_resolve_module_alias_from_file(checker, filename, local_name);
    if module_name == null {
        return null;
    }
    return exec_lower_find_module_export_decl(checker, module_name, local_name, 10);
}

fn exec_lower_use_stmt_module_name_equals(use_stmt: &ASTNode, module_name: &byte) i32 {
    if use_stmt == null || use_stmt.type != ASTNodeType.AST_USE_STMT || module_name == null ||
        use_stmt.use_stmt_path_segments == null || use_stmt.use_stmt_path_segment_count <= 0 {
        return 0;
    }
    var i: i32 = 0;
    var module_pos: i32 = 0;
    while i < use_stmt.use_stmt_path_segment_count {
        const segment: &byte = use_stmt.use_stmt_path_segments[i];
        if segment == null {
            return 0;
        }
        var seg_pos: i32 = 0;
        while segment[seg_pos] != 0 as byte {
            if module_name[module_pos] != segment[seg_pos] {
                return 0;
            }
            seg_pos = seg_pos + 1;
            module_pos = module_pos + 1;
        }
        if i + 1 < use_stmt.use_stmt_path_segment_count {
            if module_name[module_pos] != 46 {
                return 0;
            }
            module_pos = module_pos + 1;
        }
        i = i + 1;
    }
    // module_pos 由两分支累加而来，合并后无紧上界；用 local const 快照 + 提前返回，
    // 让指针下标证明能直接建立上界。
    // 用指针遍历代替下标：module_pos 由多个分支累加，汇合后无紧上界，
    // 指针会走出边界时立即停止，行为与原逻辑一致。
    var p: &byte = module_name;
    var k: i32 = 0;
    while k < module_pos && p[0] != 0 as byte {
        p = p + 1;
        k = k + 1;
    }
    return (p[0] == 0 as byte) as i32;
}

fn exec_lower_resolve_module_alias_from_file(checker: &TypeChecker, filename: &byte, local_name: &byte) &byte {
    if checker == null || checker.program_node == null || checker.program_node.type != ASTNodeType.AST_PROGRAM ||
        filename == null || local_name == null {
        return null;
    }
    var i: i32 = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_USE_STMT &&
            decl.filename != null && str_equals(decl.filename, filename) != 0 &&
            decl.use_stmt_item_name == null &&
            decl.use_stmt_path_segments != null && decl.use_stmt_path_segment_count > 0 {
            var local_name_candidate: &byte = decl.use_stmt_alias;
            if local_name_candidate == null {
                local_name_candidate = decl.use_stmt_path_segments[decl.use_stmt_path_segment_count - 1];
            }
            if local_name_candidate != null && str_equals(local_name_candidate, local_name) != 0 {
                const module_name_len: i32 = exec_lower_joined_module_name_len(decl.use_stmt_path_segments, decl.use_stmt_path_segment_count);
                if module_name_len > 0 {
                    const module_name: &byte = compiler_arena_alloc(checker.arena, module_name_len as usize + 1 as usize) as &byte;
                    if module_name != null {
                        exec_lower_write_joined_module_name(module_name, decl.use_stmt_path_segments, decl.use_stmt_path_segment_count);
                        return module_name;
                    }
                }
            }
        }
        i = i + 1;
    }
    return null;
}

fn exec_lower_resolve_module_alias_from_program(checker: &TypeChecker, local_name: &byte) &byte {
    if checker == null || checker.program_node == null || checker.program_node.type != ASTNodeType.AST_PROGRAM ||
        local_name == null {
        return null;
    }
    var i: i32 = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_USE_STMT &&
            decl.use_stmt_item_name == null &&
            decl.use_stmt_path_segments != null && decl.use_stmt_path_segment_count > 0 {
            var local_name_candidate: &byte = decl.use_stmt_alias;
            if local_name_candidate == null {
                local_name_candidate = decl.use_stmt_path_segments[decl.use_stmt_path_segment_count - 1];
            }
            if local_name_candidate != null && str_equals(local_name_candidate, local_name) != 0 {
                const module_name_len: i32 = exec_lower_joined_module_name_len(decl.use_stmt_path_segments, decl.use_stmt_path_segment_count);
                if module_name_len > 0 {
                    const module_name: &byte = compiler_arena_alloc(checker.arena, module_name_len as usize + 1 as usize) as &byte;
                    if module_name != null {
                        exec_lower_write_joined_module_name(module_name, decl.use_stmt_path_segments, decl.use_stmt_path_segment_count);
                        return module_name;
                    }
                }
            }
        }
        i = i + 1;
    }
    return null;
}

fn exec_lower_resolve_member_access_module_name(checker: &TypeChecker, expr: &ASTNode) &byte {
    if checker == null || expr == null || expr.type != ASTNodeType.AST_MEMBER_ACCESS {
        return null;
    }
    if expr.member_access_is_module_access != 0 && expr.member_access_module_name != null {
        return expr.member_access_module_name;
    }
    if expr.member_access_object == null ||
        expr.member_access_object.type != ASTNodeType.AST_IDENTIFIER ||
        expr.member_access_object.identifier_name == null {
        return null;
    }
    const imported_item: &ImportedItem = checker_import_table_lookup_local_name(checker, expr.member_access_object.identifier_name);
    if imported_item != null && imported_item.item_type == (0 - 1) && imported_item.module_name != null {
        return imported_item.module_name;
    }
    if expr.filename != null {
        const file_module_name: &byte = exec_lower_resolve_module_alias_from_file(
            checker, expr.filename, expr.member_access_object.identifier_name);
        if file_module_name != null {
            return file_module_name;
        }
    }
    return exec_lower_resolve_module_alias_from_program(checker, expr.member_access_object.identifier_name);
}

fn exec_lower_joined_module_name_len(segments: & & byte, count: i32) i32 {
    if segments == null || count <= 0 {
        return 0;
    }
    var total: i32 = 0;
    var i: i32 = 0;
    while i < count {
        if segments[i] == null {
            return 0;
        }
        total = total + (strlen(segments[i] as *byte) as i32);
        if i + 1 < count {
            total = total +| 1;
        }
        i = i + 1;
    }
    return total;
}

fn exec_lower_write_joined_module_name(out_name: &byte, segments: & & byte, count: i32) void {
    if out_name == null || segments == null || count <= 0 {
        return;
    }
    var pos: i32 = 0;
    var i: i32 = 0;
    while i < count {
        const segment: &byte = segments[i];
        var si: i32 = 0;
        while segment != null && segment[si] != 0 as byte {
            out_name[pos] = segment[si];
            pos = pos + 1;
            si = si + 1;
        }
        if i + 1 < count {
            out_name[pos] = 46;
            pos = pos + 1;
        }
        i = i + 1;
    }
    out_name[pos] = 0 as byte;
}

fn exec_lower_resolve_function_decl(checker: &TypeChecker, callee_name: &byte) &ASTNode {
    if checker == null || callee_name == null {
        return null;
    }
    var decl: &ASTNode = exec_lower_resolve_imported_decl(checker, callee_name, 1);
    if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null {
        const reachable_decl: &ASTNode = checker_find_reachable_fn_decl_by_name(checker, decl.fn_decl_name);
        if reachable_decl != null && reachable_decl.type == ASTNodeType.AST_FN_DECL {
            return reachable_decl;
        }
        return decl;
    }
    decl = checker_find_reachable_fn_decl_by_name(checker, callee_name);
    if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
        return decl;
    }
    decl = find_fn_decl_from_program(checker.program_node, callee_name);
    if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
        return checker_canonicalize_fn_decl(checker, decl);
    }
    return null;
}

fn exec_lower_prefer_bodyful_function_decl(checker: &TypeChecker, fn_decl: &ASTNode, fn_name: &byte) &ASTNode {
    if checker == null {
        return fn_decl;
    }
    var lookup_name: &byte = fn_name;
    if fn_decl != null && fn_decl.type == ASTNodeType.AST_FN_DECL && fn_decl.fn_decl_name != null {
        lookup_name = fn_decl.fn_decl_name;
        if fn_decl.fn_decl_body != null {
            return checker_canonicalize_fn_decl(checker, fn_decl);
        }
    }
    if lookup_name == null {
        return fn_decl;
    }
    const reachable_decl: &ASTNode = checker_find_reachable_fn_decl_by_name(checker, lookup_name);
    if reachable_decl != null && reachable_decl.type == ASTNodeType.AST_FN_DECL && reachable_decl.fn_decl_body != null {
        return reachable_decl;
    }
    const program_decl: &ASTNode = find_fn_decl_from_program(checker.program_node, lookup_name);
    if program_decl != null && program_decl.type == ASTNodeType.AST_FN_DECL && program_decl.fn_decl_body != null {
        return checker_canonicalize_fn_decl(checker, program_decl);
    }
    return fn_decl;
}

fn exec_lower_find_function_decl_in_file(checker: &TypeChecker, filename: &byte, callee_name: &byte) &ASTNode {
    if checker == null || checker.program_node == null || checker.program_node.type != ASTNodeType.AST_PROGRAM ||
        filename == null || callee_name == null {
        return null;
    }
    var i: i32 = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL &&
            decl.filename != null && str_equals(decl.filename, filename) != 0 &&
            decl.fn_decl_name != null && str_equals(decl.fn_decl_name, callee_name) != 0 {
            return checker_canonicalize_fn_decl(checker, decl);
        }
        i = i + 1;
    }
    return null;
}

// ==== 泛型单态化（exec VM）====
// checker 已把用到的实例登记在 mono_instances；这里按 (函数名, 类型实参) 找到
// 实例序号，用 `名字$m<序号>` 作为 VM 内唯一的函数名。

fn exec_lower_first_type_param_name(fn_decl: &ASTNode) &byte {
    if fn_decl == null || fn_decl.fn_decl_type_params == null || fn_decl.fn_decl_type_param_count <= 0 {
        return null;
    }
    return fn_decl.fn_decl_type_params[0].name;
}

fn exec_lower_find_mono_instance_index(checker: &TypeChecker, generic_name: &byte,
    arg_types: &Type, arg_count: i32) i32 {
    if checker == null || generic_name == null || arg_types == null {
        return -1;
    }
    if checker.mono_instances == null {
        return -1;
    }
    var idx: i32 = 0;
    while idx < checker.mono_instance_count {
        const inst: &MonoInstance = &checker.mono_instances[idx];
        if inst.is_function != 0 && inst.generic_name != null &&
            str_equals(inst.generic_name, generic_name) != 0 &&
            inst.type_arg_count == arg_count && inst.type_args != null {
            var same: i32 = 1;
            var ai: i32 = 0;
            while ai < arg_count {
                if type_equals(inst.type_args[ai], arg_types[ai]) == 0 {
                    same = 0;
                }
                ai = ai + 1;
            }
            if same != 0 {
                return idx;
            }
        }
        idx = idx + 1;
    }
    return -1;
}

fn exec_lower_mono_function_name(arena: &CompilerArena, generic_name: &byte, index: i32) &byte {
    if arena == null || generic_name == null {
        return generic_name;
    }
    const buf: &byte = compiler_arena_alloc(arena, strlen(generic_name as *byte) + 24) as &byte;
    if buf == null {
        return generic_name;
    }
    _ = sprintf(buf as *byte, "%s$m%d" as *byte, generic_name as *byte, index);
    return buf;
}

/// 判断单态实例是否需要在 lowering 前先做 AST 级宏展开。
///
/// 只有「以类型形参作首实参、由 codegen 按具体类型内联展开」的泛型函数
/// （`to_json` / `websocket_conn_write_json` / `async_compute`）属于这一类：
/// checker 在泛型声明处刻意不展开，单态实例必须按具体类型实参重新展开一次。
///
/// 参数：`name` 为泛型函数名。
/// 返回值：需要展开返回 1，否则返回 0。
fn exec_lower_mono_body_needs_macro_expand(name: &byte) i32 {
    if name == null {
        return 0;
    }
    if strcmp(name as *byte, "to_json" as *byte) == 0 ||
        strcmp(name as *byte, "websocket_conn_write_json" as *byte) == 0 ||
        strcmp(name as *byte, "async_compute" as *byte) == 0 {
        return 1;
    }
    return 0;
}

/// 为一个泛型单态实例准备要 lowering 的函数体。
///
/// 与 C99 后端单态分支保持一致：`from_json` 按具体结构体生成字段解码体，
/// `to_json` 等宏型泛型按具体类型实参展开宏调用。
///
/// 参数：`checker` 类型检查器；`fn_decl` 泛型函数声明；`inst` 单态实例。
/// 返回值：替换后的函数体；无需替换时返回 null。
fn exec_lower_mono_body_for_instance(checker: &TypeChecker, fn_decl: &ASTNode, inst: &MonoInstance) &ASTNode {
    if checker == null || fn_decl == null || inst == null || fn_decl.fn_decl_body == null ||
        fn_decl.fn_decl_name == null || inst.type_arg_nodes == null || inst.type_arg_count <= 0 {
        return null;
    }
    const arg0: &ASTNode = inst.type_arg_nodes[0];
    if strcmp(fn_decl.fn_decl_name as *byte, "from_json" as *byte) == 0 && arg0 != null &&
        arg0.type == ASTNodeType.AST_TYPE_NAMED && arg0.type_named_name != null {
        var filename: &byte = null;
        if fn_decl.filename != null {
            filename = fn_decl.filename;
        }
        return build_from_json_reflect_body(checker, arg0, fn_decl.line, fn_decl.column, filename);
    }
    if exec_lower_mono_body_needs_macro_expand(fn_decl.fn_decl_name) == 0 {
        return null;
    }
    return prepare_mono_body_expand_macros(checker, fn_decl.fn_decl_body,
        fn_decl.fn_decl_type_params, fn_decl.fn_decl_type_param_count,
        inst.type_arg_nodes, inst.type_arg_count);
}

fn exec_lower_generic_instances(arena: &CompilerArena, checker: &TypeChecker, fn_decl: &ASTNode,
    globals: &HIRGlobalSlot, global_count: i32, functions: & & HIRFunction, count: &i32,
    seed_decls: & & ASTNode, seed_count: &i32) i32 {
    if fn_decl == null || count == null || functions == null {
        return -1;
    }
    const param_name: &byte = exec_lower_first_type_param_name(fn_decl);
    if param_name == null || checker.mono_instances == null || fn_decl.fn_decl_name == null {
        return 0;
    }
    var idx: i32 = 0;
    var seen: i32 = 0;
    while idx < checker.mono_instance_count {
        const inst: &MonoInstance = &checker.mono_instances[idx];
        if inst.is_function != 0 && inst.generic_name != null && inst.type_args != null &&
            inst.type_arg_count > 0 && str_equals(inst.generic_name, fn_decl.fn_decl_name) != 0 {
            const saved_active: i32 = checker.subst_active;
            const saved_name: &byte = checker.subst_name;
            const saved_type: Type = copy_type(&checker.subst_type);
            const saved_params: &TypeParam = checker.current_type_params;
            const saved_param_count: i32 = checker.current_type_param_count;
            checker.current_type_params = fn_decl.fn_decl_type_params;
            checker.current_type_param_count = fn_decl.fn_decl_type_param_count;
            checker.subst_active = 1;
            checker.subst_name = param_name;
            checker.subst_type = copy_type(&inst.type_args[0]);
            const saved_body: &ASTNode = fn_decl.fn_decl_body;
            const mono_body: &ASTNode = exec_lower_mono_body_for_instance(checker, fn_decl, inst);
            if mono_body != null {
                fn_decl.fn_decl_body = mono_body;
            }
            const lowered: &HIRFunction = exec_lower_function(arena, checker, fn_decl, globals, global_count);
            fn_decl.fn_decl_body = saved_body;
            checker.subst_active = saved_active;
            checker.subst_name = saved_name;
            checker.subst_type = copy_type(&saved_type);
            checker.current_type_params = saved_params;
            checker.current_type_param_count = saved_param_count;
            if lowered == null {
                return -1;
            }
            lowered.name = exec_lower_mono_function_name(arena, fn_decl.fn_decl_name, idx);
            if count[0] < MAX_REACHABLE_FN_DECLS {
                functions[count[0]] = lowered;
                count[0] = count[0] +| 1;
            }
            // 单态体可能通过宏展开引入新的被调函数（to_json -> json_write_*），
            // 这些声明必须登记成新的可达种子，否则下一轮不会为它们降级。
            if lowered.body != null && seed_decls != null && seed_count != null {
                exec_lower_collect_called_decls_from_block(lowered.body, seed_decls, seed_count);
                exec_lower_collect_cleanup_decls_from_function(checker, lowered, seed_decls, seed_count);
            }
            seen = seen + 1;
        }
        idx = idx + 1;
    }
    if seen == 0 {
        // 没有登记实例（例如只有声明）：按非泛型路径降一次，避免缺函数。
        const lowered_plain: &HIRFunction = exec_lower_function(arena, checker, fn_decl, globals, global_count);
        if lowered_plain == null {
            return -1;
        }
        if count[0] < MAX_REACHABLE_FN_DECLS {
            functions[count[0]] = lowered_plain;
            count[0] = count[0] +| 1;
        }
    }
    return 0;
}

fn exec_lower_begin_generic_method(ctx: &ExecLowerContext, expr: &ASTNode, method_decl: &ASTNode) &byte {
    if ctx == null || expr == null || method_decl == null || method_decl.fn_decl_type_param_count <= 0 {
        return null;
    }
    // 类型实参可能挂在调用上（`f<i32>(...)`），也可能挂在接收者类型上
    // （`Box<i32>.wrap(42)`）：后者是泛型类型的关联函数/静态方法调用。
    var type_args: & & ASTNode = expr.call_expr_type_args;
    var arg_count: i32 = expr.call_expr_type_arg_count;
    if arg_count <= 0 && expr.call_expr_callee != null &&
        expr.call_expr_callee.type == ASTNodeType.AST_MEMBER_ACCESS &&
        expr.call_expr_callee.member_access_object != null {
        const recv_ast: &ASTNode = expr.call_expr_callee.member_access_object;
        if recv_ast.type == ASTNodeType.AST_TYPE_NAMED && recv_ast.type_named_type_arg_count > 0 {
            type_args = recv_ast.type_named_type_args;
            arg_count = recv_ast.type_named_type_arg_count;
        }
    }
    if arg_count <= 0 || type_args == null {
        return null;
    }
    const arg_types: &Type = compiler_arena_alloc(ctx.arena, @size_of(Type) * arg_count as usize) as &Type;
    if arg_types == null {
        return null;
    }
    var ai: i32 = 0;
    while ai < arg_count {
        arg_types[ai] = type_from_ast(ctx.checker, type_args[ai]);
        ai = ai + 1;
    }
    const inst_idx: i32 = exec_lower_find_mono_instance_index(ctx.checker, method_decl.fn_decl_name, arg_types, arg_count);
    if inst_idx < 0 {
        return null;
    }
    ctx.checker.subst_active = 1;
    ctx.checker.subst_name = exec_lower_first_type_param_name(method_decl);
    ctx.checker.subst_type = copy_type(&arg_types[0]);
    return exec_lower_mono_function_name(ctx.arena, method_decl.fn_decl_name, inst_idx);
}

fn exec_lower_generic_call_expr(ctx: &ExecLowerContext, expr: &ASTNode, result_type: &Type) &HIRExpr {
    if ctx == null || expr == null || result_type == null {
        return null;
    }
    if expr.call_expr_callee == null || expr.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER ||
        expr.call_expr_callee.identifier_name == null {
        return null;
    }
    const fn_name: &byte = expr.call_expr_callee.identifier_name;
    const fn_decl: &ASTNode = exec_lower_resolve_function_decl_from_file(ctx.checker, expr.filename, fn_name);
    if fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL || fn_decl.fn_decl_type_param_count <= 0 {
        return null;
    }
    const arg_count: i32 = expr.call_expr_type_arg_count;
    if arg_count <= 0 || expr.call_expr_type_args == null {
        return null;
    }
    const arg_types: &Type = compiler_arena_alloc(ctx.arena, @size_of(Type) * arg_count as usize) as &Type;
    if arg_types == null {
        return null;
    }
    var ai: i32 = 0;
    while ai < arg_count {
        arg_types[ai] = type_from_ast(ctx.checker, expr.call_expr_type_args[ai]);
        // 泛型函数体内再调泛型函数：类型实参可能写成外层函数的类型参数 `T`，
        // 单态化期间要按当前替换换成具体类型，否则找不到实例。
        if arg_types[ai].kind == TypeKind.TYPE_GENERIC_PARAM && ctx.checker.subst_active != 0 &&
            ctx.checker.subst_name != null && arg_types[ai].generic_param_name != null &&
            str_equals(arg_types[ai].generic_param_name, ctx.checker.subst_name) != 0 {
            arg_types[ai] = copy_type(&ctx.checker.subst_type);
        }
        ai = ai + 1;
    }
    var inst_idx: i32 = exec_lower_find_mono_instance_index(ctx.checker, fn_name, arg_types, arg_count);
    if inst_idx < 0 {
        // 泛型函数体里的内层泛型调用：checker 只登记了以类型参数为实参的实例，
        // 这里按当前替换后的具体类型补登记，后续单态体降级会把它生成出来。
        inst_idx = register_mono_instance_by_types(ctx.checker, fn_name, arg_types, arg_count, 1);
    }
    if inst_idx < 0 {
        return null;
    }
    const mangled: &byte = exec_lower_mono_function_name(ctx.arena, fn_name, inst_idx);
    const saved_active: i32 = ctx.checker.subst_active;
    const saved_name: &byte = ctx.checker.subst_name;
    const saved_type: Type = ctx.checker.subst_type;
    ctx.checker.subst_active = 1;
    ctx.checker.subst_name = exec_lower_first_type_param_name(fn_decl);
    ctx.checker.subst_type = copy_type(&arg_types[0]);
    const args: & & HIRExpr = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * expr.call_expr_arg_count as usize) as & & HIRExpr;
    var ok: i32 = 1;
    if expr.call_expr_arg_count > 0 && args == null {
        ok = 0;
    }
    var i: i32 = 0;
    while ok != 0 && i < expr.call_expr_arg_count {
        var arg_expr: &HIRExpr = null;
        if fn_decl.fn_decl_params != null && i < fn_decl.fn_decl_param_count &&
            fn_decl.fn_decl_params[i] != null &&
            fn_decl.fn_decl_params[i].type == ASTNodeType.AST_VAR_DECL &&
            fn_decl.fn_decl_params[i].var_decl_type != null {
            // 形参类型里的泛型参数也要按本次实参替换：`ok<i32>(3)` 的形参是 `T`，
            // 不替换就会把实参当成名为 `T` 的结构体去转换。
            const expected_raw: Type = type_from_ast(ctx.checker, fn_decl.fn_decl_params[i].var_decl_type);
            const expected: Type = substitute_generic_type_for_exec(ctx.checker, copy_type(&expected_raw),
                fn_decl.fn_decl_type_params, fn_decl.fn_decl_type_param_count, arg_types, arg_count);
            arg_expr = exec_lower_coerce_expr(ctx, expr.call_expr_args[i], &expected);
        } else {
            arg_expr = exec_lower_expr(ctx, expr.call_expr_args[i]);
        }
        if arg_expr == null {
            ok = 0;
        } else {
            args[i] = arg_expr;
        }
        i = i + 1;
    }
    ctx.checker.subst_active = saved_active;
    ctx.checker.subst_name = saved_name;
    ctx.checker.subst_type = saved_type;
    if ok == 0 {
        return null;
    }
    // 返回类型里的泛型参数要按本次实参替换（`!T` → `!i32`），
    // 否则调用结果会带着未替换的 `T` 继续在降级里传播。
    var call_result_type: Type = copy_type(result_type);
    if fn_decl.fn_decl_return_type != null && fn_decl.fn_decl_type_params != null &&
        fn_decl.fn_decl_type_param_count > 0 {
        const declared_ret: Type = type_from_ast(ctx.checker, fn_decl.fn_decl_return_type);
        call_result_type = substitute_generic_type_for_exec(ctx.checker, copy_type(&declared_ret),
            fn_decl.fn_decl_type_params, fn_decl.fn_decl_type_param_count, arg_types, arg_count);
    }
    const hir: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CALL, &call_result_type);
    if hir == null {
        return null;
    }
    hir.callee_name = mangled;
    hir.callee_decl = fn_decl;
    hir.call_host_id = ExecHostCallId.EXEC_HOST_CALL_NONE;
    hir.call_args = args;
    hir.call_arg_count = expr.call_expr_arg_count;
    return hir;
}

fn exec_lower_resolve_function_decl_from_file(checker: &TypeChecker, filename: &byte, callee_name: &byte) &ASTNode {
    if checker == null || callee_name == null {
        return null;
    }
    if filename != null {
        const file_local_decl: &ASTNode = exec_lower_find_function_decl_in_file(checker, filename, callee_name);
        if file_local_decl != null {
            return exec_lower_prefer_bodyful_function_decl(checker, file_local_decl, callee_name);
        }
        var imported_decl: &ASTNode = exec_lower_resolve_imported_decl_from_file(checker, filename, callee_name, 1);
        if imported_decl != null && imported_decl.type == ASTNodeType.AST_FN_DECL {
            imported_decl = checker_canonicalize_fn_decl(checker, imported_decl);
            return exec_lower_prefer_bodyful_function_decl(checker, imported_decl, callee_name);
        }
    }
    return exec_lower_resolve_function_decl(checker, callee_name);
}

fn exec_lower_resolve_global_decl(checker: &TypeChecker, name: &byte) &ASTNode {
    if checker == null || name == null {
        return null;
    }
    const imported_decl: &ASTNode = exec_lower_resolve_imported_decl(checker, name, 10);
    if imported_decl != null {
        return imported_decl;
    }
    const symbol: &Symbol = symbol_table_lookup(checker, name);
    if symbol != null && exec_lower_global_is_runtime_decl(symbol.decl_node) != 0 {
        return symbol.decl_node;
    }
    return null;
}

fn exec_lower_find_enum_variant_value(enum_decl: &ASTNode, variant_name: &byte) i32 {
    if enum_decl == null || enum_decl.type != ASTNodeType.AST_ENUM_DECL || variant_name == null ||
        enum_decl.enum_decl_variants == null {
        return -1;
    }
    var current_value: i32 = 0;
    var i: i32 = 0;
    while i < enum_decl.enum_decl_variant_count {
        const variant: &EnumVariant = enum_decl.enum_decl_variants + i;
        if variant == null || variant.name == null {
            i = i + 1;
            continue;
        }
        if variant.value != null {
            current_value = atoi(variant.value as *byte);
        }
        if str_equals(variant.name, variant_name) != 0 {
            return current_value;
        }
        current_value = current_value +| 1;
        i = i + 1;
    }
    return -1;
}

fn exec_lower_try_enum_member_const(ctx: &ExecLowerContext, expr: &ASTNode, out_found: &i32) i32 {
    if out_found != null {
        out_found[0] = 0;
    }
    if ctx == null || ctx.checker == null || ctx.checker.program_node == null ||
        expr == null || expr.type != ASTNodeType.AST_MEMBER_ACCESS ||
        expr.member_access_object == null || expr.member_access_field_name == null {
        return -1;
    }
    const object: &ASTNode = expr.member_access_object;
    if object.type != ASTNodeType.AST_IDENTIFIER || object.identifier_name == null {
        return -1;
    }
    const enum_decl: &ASTNode = find_enum_decl_from_program(ctx.checker.program_node, object.identifier_name);
    if enum_decl == null {
        return -1;
    }
    const value: i32 = exec_lower_find_enum_variant_value(enum_decl, expr.member_access_field_name);
    if value < 0 {
        return -1;
    }
    if out_found != null {
        out_found[0] = 1;
    }
    return value;
}

fn exec_lower_eval_int_limit(expr: &ASTNode, fallback_kind: TypeKind, out_ok: &i32) i64 {
    if out_ok != null {
        out_ok[0] = 0;
    }
    if expr == null || expr.type != ASTNodeType.AST_INT_LIMIT {
        return 0;
    }
    var kind: TypeKind = fallback_kind;
    // 存储是编码值 = TypeKind + 1（resolve_int_limit_node），这里 -| 1 解码；
    // 编码前 TYPE_I8 === 0 与「未解析」的 0 哨兵撞车（下方旧注释
    // 「TYPE_I8 的枚举值为 0，不能用 0 当哨兵」正是这条坑的 exec 侧记录）。
    if expr.int_limit_resolved_kind != 0 {
        const kind_tmp: !TypeKind = (expr.int_limit_resolved_kind -| 1) as! TypeKind;
        kind = kind_tmp.value;
    }
    if is_integer_type(kind) == 0 {
        return 0;
    }
    if out_ok != null {
        out_ok[0] = 1;
    }
    if kind == TypeKind.TYPE_I8 {
        if expr.int_limit_is_max != 0 { return 127; }
        return 0 - 128;
    }
    if kind == TypeKind.TYPE_I16 {
        if expr.int_limit_is_max != 0 { return 32767; }
        return 0 - 32768;
    }
    if kind == TypeKind.TYPE_I32 {
        if expr.int_limit_is_max != 0 { return 2147483647; }
        return 0 - 2147483647 - 1;
    }
    if kind == TypeKind.TYPE_I64 {
        if expr.int_limit_is_max != 0 { return 9223372036854775807; }
        return 0 - 9223372036854775807 - 1;
    }
    if kind == TypeKind.TYPE_U8 || kind == TypeKind.TYPE_BYTE {
        if expr.int_limit_is_max != 0 { return 255; }
        return 0;
    }
    if kind == TypeKind.TYPE_U16 {
        if expr.int_limit_is_max != 0 { return 65535; }
        return 0;
    }
    if kind == TypeKind.TYPE_U32 {
        if expr.int_limit_is_max != 0 { return 4294967295; }
        return 0;
    }
    if kind == TypeKind.TYPE_U64 || kind == TypeKind.TYPE_USIZE {
        if expr.int_limit_is_max != 0 { return 0 - 1; }
        return 0;
    }
    if out_ok != null {
        out_ok[0] = 0;
    }
    return 0;
}

fn exec_lower_append_global_slot(checker: &TypeChecker, decl: &ASTNode, globals: &HIRGlobalSlot, out_count: &i32, allow_uya_root_runtime: i32) i32 {
    if checker == null || decl == null || globals == null || out_count == null {
        return -1;
    }
    if allow_uya_root_runtime == 0 && exec_lower_decl_is_uya_root_runtime(checker, decl) != 0 {
        return 0;
    }
    if out_count[0] >= EXEC_MAX_GLOBALS {
        exec_backend_set_error(decl, "exec: global 数量超出上限" as *byte, 0);
        return -1;
    }
    const global_type_ast: &ASTNode = exec_lower_global_type_ast(decl);
    if global_type_ast == null {
        exec_backend_set_error(decl, "exec: global 缺少类型" as *byte, 0);
        return -1;
    }
    const global_type: Type = type_from_ast(checker, global_type_ast);
    if exec_type_is_vm_value_supported(global_type) == 0 {
        if exec_type_uses_simd(global_type) != 0 {
            exec_lower_set_unsupported_reason(decl, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
            return -1;
        }
        exec_lower_set_unsupported(decl, "exec: 当前仅支持 exec VM 可表示的全局变量" as *byte);
        return -1;
    }
    globals[out_count[0]] = HIRGlobalSlot {
        name: exec_lower_global_name(decl),
        decl: decl,
        slot: out_count[0],
        type_ref: exec_lower_make_type_ref(&global_type),
        is_const: exec_lower_global_is_const(decl),
        init_expr: null,
    };
    out_count[0] = out_count[0] +| 1;
    return 0;
}

fn exec_lower_collect_global_slots_from_program(checker: &TypeChecker, program: &ASTNode, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || program == null || globals == null || out_count == null {
        return -1;
    }
    if program.type != ASTNodeType.AST_PROGRAM {
        return 0;
    }
    var decl_idx: i32 = 0;
    while decl_idx < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[decl_idx];
        if decl != null && decl.type == ASTNodeType.AST_PROGRAM {
            if exec_lower_collect_global_slots_from_program(checker, decl, globals, out_count) != 0 {
                return -1;
            }
        } else if exec_lower_global_is_runtime_decl(decl) != 0 {
            if exec_lower_append_global_slot(checker, decl, globals, out_count, 0) != 0 {
                return -1;
            }
        }
        decl_idx = decl_idx + 1;
    }
    return 0;
}

fn exec_lower_collect_global_slots_from_symbols(checker: &TypeChecker, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || globals == null || out_count == null {
        return -1;
    }
    var scope: i32 = 0;
    while scope < @len(checker.scope_heads) {
        var symbol: &Symbol = checker.scope_heads[scope];
        while symbol != null {
            if exec_lower_global_is_runtime_decl(symbol.decl_node) != 0 &&
                exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], symbol.decl_node) < 0 {
                if exec_lower_append_global_slot(checker, symbol.decl_node, globals, out_count, 0) != 0 {
                    return -1;
                }
            }
            symbol = symbol.next_in_scope;
        }
        scope = scope + 1;
    }
    return 0;
}

fn exec_lower_collect_global_slots_from_symbol_table(checker: &TypeChecker, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || globals == null || out_count == null {
        return -1;
    }
    var slot: i32 = 0;
    const stbl_cap: i32 = checker.symbol_table.table.capacity;
    while slot < stbl_cap {
        const symbol: &Symbol = checker_symbol_slot_at(checker, slot);
        if symbol != null &&
            exec_lower_global_is_runtime_decl(symbol.decl_node) != 0 &&
            exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], symbol.decl_node) < 0 {
            if exec_lower_append_global_slot(checker, symbol.decl_node, globals, out_count, 0) != 0 {
                return -1;
            }
        }
        slot = slot + 1;
    }
    return 0;
}

fn exec_lower_collect_global_slots_from_imports(checker: &TypeChecker, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || globals == null || out_count == null {
        return -1;
    }
    var slot: i32 = 0;
    const itbl_cap: i32 = checker.import_table.table.capacity;
    while slot < itbl_cap {
        const import_item: &ImportedItem = checker_import_slot_at(checker, slot);
        if import_item != null && import_item.item_type != (0 - 1) && import_item.local_name != null {
            const decl: &ASTNode = exec_lower_resolve_global_decl(checker, import_item.local_name);
            if decl != null && exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], decl) < 0 {
                if exec_lower_append_global_slot(checker, decl, globals, out_count, 1) != 0 {
                    return -1;
                }
            }
        } else if import_item != null && import_item.item_type == (0 - 1) &&
            import_item.local_name != null && import_item.module_name != null {
            const self_named_decl: &ASTNode = exec_lower_find_module_export_decl(checker, import_item.module_name, import_item.local_name, 10);
            if self_named_decl != null &&
                exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], self_named_decl) < 0 {
                if exec_lower_append_global_slot(checker, self_named_decl, globals, out_count, 1) != 0 {
                    return -1;
                }
            }
        }
        slot = slot + 1;
    }
    if checker.program_node != null && checker.program_node.type == ASTNodeType.AST_PROGRAM {
        var decl_i: i32 = 0;
        while decl_i < checker.program_node.program_decl_count {
            const decl2: &ASTNode = checker.program_node.program_decls[decl_i];
            if decl2 != null && decl2.type == ASTNodeType.AST_USE_STMT &&
                decl2.use_stmt_item_name != null {
                var local_name_candidate2: &byte = decl2.use_stmt_alias;
                if local_name_candidate2 == null {
                    local_name_candidate2 = decl2.use_stmt_item_name;
                }
                if local_name_candidate2 != null {
                    const resolved_decl: &ASTNode = exec_lower_resolve_imported_decl_from_file(checker, decl2.filename, local_name_candidate2, 10);
                    if resolved_decl != null &&
                        exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], resolved_decl) < 0 {
                        if exec_lower_append_global_slot(checker, resolved_decl, globals, out_count, 1) != 0 {
                            return -1;
                        }
                    }
                }
            } else if decl2 != null && decl2.type == ASTNodeType.AST_USE_STMT &&
                decl2.use_stmt_item_name == null {
                var local_name_candidate3: &byte = decl2.use_stmt_alias;
                if local_name_candidate3 == null &&
                    decl2.use_stmt_path_segments != null && decl2.use_stmt_path_segment_count > 0 {
                    local_name_candidate3 = decl2.use_stmt_path_segments[decl2.use_stmt_path_segment_count - 1];
                }
                if local_name_candidate3 != null {
                    const resolved_decl2: &ASTNode = exec_lower_resolve_module_self_named_global_from_file(checker, decl2.filename, local_name_candidate3);
                    if resolved_decl2 != null &&
                        exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], resolved_decl2) < 0 {
                        if exec_lower_append_global_slot(checker, resolved_decl2, globals, out_count, 1) != 0 {
                            return -1;
                        }
                    }
                }
            }
            decl_i = decl_i + 1;
        }
    }
    return 0;
}

fn exec_lower_add_requested_module_global_name(out_names: & & byte, out_count: &i32, name: &byte) void {
    if out_names == null || out_count == null || name == null {
        return;
    }
    var i: i32 = 0;
    while i < out_count[0] {
        if out_names[i] != null && str_equals(out_names[i], name) != 0 {
            return;
        }
        i = i + 1;
    }
    if out_count[0] >= EXEC_MAX_MODULE_GLOBAL_REQUESTS {
        return;
    }
    out_names[out_count[0]] = name;
    out_count[0] = out_count[0] +| 1;
}

fn exec_lower_collect_module_global_use_names_expr(checker: &TypeChecker, expr: &ASTNode, module_name: &byte, out_names: & & byte, out_count: &i32) void {
    if checker == null || expr == null || module_name == null || out_names == null || out_count == null {
        return;
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        const resolved_module_name: &byte = exec_lower_resolve_member_access_module_name(checker, expr);
        if resolved_module_name != null && expr.member_access_field_name != null &&
            str_equals(resolved_module_name, module_name) != 0 {
            exec_lower_add_requested_module_global_name(out_names, out_count, expr.member_access_field_name);
        }
        exec_lower_collect_module_global_use_names_expr(checker, expr.member_access_object, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_CALL_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.call_expr_callee, module_name, out_names, out_count);
        if expr.call_expr_args != null {
            var i: i32 = 0;
            while i < expr.call_expr_arg_count {
                exec_lower_collect_module_global_use_names_expr(checker, expr.call_expr_args[i], module_name, out_names, out_count);
                i = i + 1;
            }
        }
        return;
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        exec_lower_collect_module_global_use_names_expr(checker, expr.array_access_array, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_expr(checker, expr.array_access_index, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.binary_expr_left, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_expr(checker, expr.binary_expr_right, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.unary_expr_operand, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.cast_expr_expr, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.slice_expr_base, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_expr(checker, expr.slice_expr_start_expr, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_expr(checker, expr.slice_expr_len_expr, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_TRY_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.try_expr_operand, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_CATCH_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.catch_expr_operand, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_MATCH_EXPR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.match_expr_expr, module_name, out_names, out_count);
        if expr.match_expr_arms != null {
            var mi: i32 = 0;
            while mi < expr.match_expr_arm_count {
                exec_lower_collect_module_global_use_names_expr(checker, expr.match_expr_arms[mi].result_expr, module_name, out_names, out_count);
                mi = mi + 1;
            }
        }
        return;
    }
    if expr.type == ASTNodeType.AST_STRUCT_INIT && expr.struct_init_field_values != null {
        var si: i32 = 0;
        while si < expr.struct_init_field_count {
            exec_lower_collect_module_global_use_names_expr(checker, expr.struct_init_field_values[si], module_name, out_names, out_count);
            si = si + 1;
        }
        return;
    }
    if expr.type == ASTNodeType.AST_ARRAY_LITERAL && expr.array_literal_elements != null {
        var ai: i32 = 0;
        while ai < expr.array_literal_element_count {
            exec_lower_collect_module_global_use_names_expr(checker, expr.array_literal_elements[ai], module_name, out_names, out_count);
            ai = ai + 1;
        }
        exec_lower_collect_module_global_use_names_expr(checker, expr.array_literal_repeat_count_expr, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_TUPLE_LITERAL && expr.tuple_literal_elements != null {
        var ti: i32 = 0;
        while ti < expr.tuple_literal_element_count {
            exec_lower_collect_module_global_use_names_expr(checker, expr.tuple_literal_elements[ti], module_name, out_names, out_count);
            ti = ti + 1;
        }
        return;
    }
    if expr.type == ASTNodeType.AST_LEN {
        exec_lower_collect_module_global_use_names_expr(checker, expr.len_expr_array, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_PTR_FROM_USIZE {
        exec_lower_collect_module_global_use_names_expr(checker, expr.ptr_from_usize_value, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_USIZE_FROM_PTR {
        exec_lower_collect_module_global_use_names_expr(checker, expr.usize_from_ptr_ptr, module_name, out_names, out_count);
        return;
    }
    if expr.type == ASTNodeType.AST_PRINT || expr.type == ASTNodeType.AST_PRINTLN {
        exec_lower_collect_module_global_use_names_expr(checker, expr.print_expr, module_name, out_names, out_count);
        return;
    }
}

fn exec_lower_collect_module_global_use_names_node(checker: &TypeChecker, node: &ASTNode, module_name: &byte, out_names: & & byte, out_count: &i32) void {
    if checker == null || node == null || module_name == null || out_names == null || out_count == null {
        return;
    }
    exec_lower_collect_module_global_use_names_expr(checker, node, module_name, out_names, out_count);
    if node.type == ASTNodeType.AST_PROGRAM && node.program_decls != null {
        var i: i32 = 0;
        while i < node.program_decl_count {
            exec_lower_collect_module_global_use_names_node(checker, node.program_decls[i], module_name, out_names, out_count);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var bi: i32 = 0;
        while bi < node.block_stmt_count {
            exec_lower_collect_module_global_use_names_node(checker, node.block_stmts[bi], module_name, out_names, out_count);
            bi = bi + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.if_stmt_condition, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.if_stmt_then_branch, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.if_stmt_else_branch, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.while_stmt_condition, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.while_stmt_body, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.for_stmt_range_start, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.for_stmt_range_end, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.for_stmt_array, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.for_stmt_body, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        exec_lower_collect_module_global_use_names_node(checker, node.var_decl_init, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        exec_lower_collect_module_global_use_names_node(checker, node.extern_var_decl_init_expr, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.return_stmt_expr, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        exec_lower_collect_module_global_use_names_node(checker, node.assign_dest, module_name, out_names, out_count);
        exec_lower_collect_module_global_use_names_node(checker, node.assign_src, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.defer_stmt_body, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.errdefer_stmt_body, module_name, out_names, out_count);
        return;
    }
    if node.type == ASTNodeType.AST_TEST_STMT {
        exec_lower_collect_module_global_use_names_node(checker, node.test_stmt_body, module_name, out_names, out_count);
        return;
    }
}

fn exec_lower_collect_global_slots_from_module_import(checker: &TypeChecker, module_name: &byte, requested_names: & & byte, requested_count: i32, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || module_name == null || requested_names == null || globals == null || out_count == null {
        return -1;
    }
    if str_equals(module_name, "libc" as &byte) != 0 {
        exec_lower_add_requested_module_global_name(requested_names, &requested_count, "stdin" as &byte);
        exec_lower_add_requested_module_global_name(requested_names, &requested_count, "stdout" as &byte);
        exec_lower_add_requested_module_global_name(requested_names, &requested_count, "stderr" as &byte);
    }
    var ri: i32 = 0;
    while ri < requested_count {
        if requested_names[ri] != null {
            const export_decl: &ASTNode = exec_lower_find_module_export_decl(checker, module_name, requested_names[ri], 10);
            if export_decl != null &&
                exec_lower_global_is_runtime_decl(export_decl) != 0 &&
                exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], export_decl) < 0 {
                const export_type_ast: &ASTNode = exec_lower_global_type_ast(export_decl);
                if export_type_ast != null {
                    const export_type: Type = type_from_ast(checker, export_type_ast);
                    if exec_type_is_vm_value_supported(export_type) != 0 {
                        if exec_lower_append_global_slot(checker, export_decl, globals, out_count, 1) != 0 {
                            return -1;
                        }
                    }
                }
                if checker.program_node != null && checker.program_node.type == ASTNodeType.AST_PROGRAM && export_decl.filename != null {
                    var decl_i: i32 = 0;
                    while decl_i < checker.program_node.program_decl_count {
                        const decl2: &ASTNode = checker.program_node.program_decls[decl_i];
                        if decl2 != null && decl2.filename != null &&
                            str_equals(decl2.filename, export_decl.filename) != 0 &&
                            exec_lower_global_is_runtime_decl(decl2) != 0 &&
                            exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], decl2) < 0 {
                            const decl2_type_ast: &ASTNode = exec_lower_global_type_ast(decl2);
                            if decl2_type_ast != null {
                                const decl2_type: Type = type_from_ast(checker, decl2_type_ast);
                                if exec_type_is_vm_value_supported(decl2_type) != 0 {
                                    if exec_lower_append_global_slot(checker, decl2, globals, out_count, 1) != 0 {
                                        return -1;
                                    }
                                }
                            }
                        }
                        decl_i = decl_i + 1;
                    }
                }
            }
        }
        ri = ri + 1;
    }
    return 0;
}

fn exec_lower_collect_global_slots_from_module_imports(checker: &TypeChecker, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || globals == null || out_count == null {
        return -1;
    }
    var slot: i32 = 0;
    const itbl_cap: i32 = checker.import_table.table.capacity;
    while slot < itbl_cap {
        const import_item: &ImportedItem = checker_import_slot_at(checker, slot);
        if import_item != null && import_item.module_name != null {
            var requested_names: [&byte: EXEC_MAX_MODULE_GLOBAL_REQUESTS] = [];
            var requested_count: i32 = 0;
            exec_lower_collect_module_global_use_names_node(checker, checker.program_node, import_item.module_name, &requested_names[0] as & & byte, &requested_count);
            // 选择性导入（item_type != -1）：导入项本身可能不是全局变量，但它是该模块的
            // 导出项时，collect_global_slots_from_module_import 会把同文件里的全局变量一并
            // 纳入槽位——模块内部函数引用自己的全局变量依赖这一步。
            if import_item.item_type != (0 - 1) && import_item.original_name != null {
                exec_lower_add_requested_module_global_name(&requested_names[0] as & & byte, &requested_count, import_item.original_name);
            }
            if exec_lower_collect_global_slots_from_module_import(checker, import_item.module_name, &requested_names[0] as & & byte, requested_count, globals, out_count) != 0 {
                return -1;
            }
        }
        slot = slot + 1;
    }
    return 0;
}

fn exec_lower_collect_global_slots_from_use_stmts(checker: &TypeChecker, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || checker.program_node == null || checker.program_node.type != ASTNodeType.AST_PROGRAM ||
        globals == null || out_count == null {
        return -1;
    }
    var decl_i: i32 = 0;
    while decl_i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[decl_i];
        if decl != null && decl.type == ASTNodeType.AST_USE_STMT &&
            decl.use_stmt_item_name == null &&
            decl.use_stmt_path_segments != null && decl.use_stmt_path_segment_count > 0 {
            const module_name_len: i32 = exec_lower_joined_module_name_len(decl.use_stmt_path_segments, decl.use_stmt_path_segment_count);
            if module_name_len > 0 {
                const module_name: &byte = compiler_arena_alloc(checker.arena, module_name_len as usize + 1 as usize) as &byte;
                if module_name != null {
                    exec_lower_write_joined_module_name(module_name, decl.use_stmt_path_segments, decl.use_stmt_path_segment_count);
                    var requested_names: [&byte: EXEC_MAX_MODULE_GLOBAL_REQUESTS] = [];
                    var requested_count: i32 = 0;
                    exec_lower_collect_module_global_use_names_node(checker, checker.program_node, module_name, &requested_names[0] as & & byte, &requested_count);
                    if exec_lower_collect_global_slots_from_module_import(checker, module_name, &requested_names[0] as & & byte, requested_count, globals, out_count) != 0 {
                        return -1;
                    }
                }
            }
            // 选择性导入（use std.testing.assert_eq_i32）：路径末段是导入项，父路径才是模块名。
            // 这里按父路径再查一次，命中导出项后会把该模块文件里的全局变量一并纳入槽位，
            // 否则模块内部函数（如 testing 的 assert 实现）引用自己的全局会找不到槽位。
            if decl.use_stmt_path_segment_count >= 2 {
                const parent_len: i32 = exec_lower_joined_module_name_len(decl.use_stmt_path_segments, decl.use_stmt_path_segment_count - 1);
                if parent_len > 0 {
                    const parent_name: &byte = compiler_arena_alloc(checker.arena, parent_len as usize + 1 as usize) as &byte;
                    if parent_name != null {
                        exec_lower_write_joined_module_name(parent_name, decl.use_stmt_path_segments, decl.use_stmt_path_segment_count - 1);
                        const item_names: & & byte = compiler_arena_alloc(checker.arena, @size_of(&byte)) as & & byte;
                        if item_names != null {
                            item_names[0] = decl.use_stmt_path_segments[decl.use_stmt_path_segment_count - 1];
                            if exec_lower_collect_global_slots_from_module_import(checker, parent_name, item_names, 1, globals, out_count) != 0 {
                                return -1;
                            }
                        }
                    }
                }
            }
        }
        decl_i = decl_i + 1;
    }
    return 0;
}

fn exec_lower_collect_reachable_runtime_globals_expr(checker: &TypeChecker, expr: &ASTNode, owner_filename: &byte, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || expr == null || owner_filename == null || globals == null || out_count == null {
        return 0;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER && expr.identifier_name != null {
        const decl: &ASTNode = exec_lower_resolve_global_decl(checker, expr.identifier_name);
        if decl != null &&
            decl.filename != null &&
            exec_lower_global_is_runtime_decl(decl) != 0 &&
            exec_lower_decl_is_uya_root_runtime(checker, decl) != 0 &&
            str_equals(decl.filename, owner_filename) != 0 &&
            exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], decl) < 0 {
            if exec_lower_append_global_slot(checker, decl, globals, out_count, 1) != 0 {
                return -1;
            }
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.member_access_object, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_CALL_EXPR {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.call_expr_callee, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        if expr.call_expr_args != null {
            var i: i32 = 0;
            while i < expr.call_expr_arg_count {
                if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.call_expr_args[i], owner_filename, globals, out_count) != 0 {
                    return -1;
                }
                i = i + 1;
            }
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.array_access_array, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.array_access_index, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.binary_expr_left, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.binary_expr_right, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.unary_expr_operand, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.cast_expr_expr, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.slice_expr_base, owner_filename, globals, out_count) != 0 ||
            exec_lower_collect_reachable_runtime_globals_expr(checker, expr.slice_expr_start_expr, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.slice_expr_len_expr, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_TRY_EXPR {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.try_expr_operand, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_CATCH_EXPR {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.catch_expr_operand, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_node(checker, expr.catch_expr_catch_block, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_MATCH_EXPR {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.match_expr_expr, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        if expr.match_expr_arms != null {
            var mi: i32 = 0;
            while mi < expr.match_expr_arm_count {
                if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.match_expr_arms[mi].result_expr, owner_filename, globals, out_count) != 0 {
                    return -1;
                }
                mi = mi + 1;
            }
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_STRUCT_INIT && expr.struct_init_field_values != null {
        var si: i32 = 0;
        while si < expr.struct_init_field_count {
            if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.struct_init_field_values[si], owner_filename, globals, out_count) != 0 {
                return -1;
            }
            si = si + 1;
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_ARRAY_LITERAL && expr.array_literal_elements != null {
        var ai: i32 = 0;
        while ai < expr.array_literal_element_count {
            if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.array_literal_elements[ai], owner_filename, globals, out_count) != 0 {
                return -1;
            }
            ai = ai + 1;
        }
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.array_literal_repeat_count_expr, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_TUPLE_LITERAL && expr.tuple_literal_elements != null {
        var ti: i32 = 0;
        while ti < expr.tuple_literal_element_count {
            if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.tuple_literal_elements[ti], owner_filename, globals, out_count) != 0 {
                return -1;
            }
            ti = ti + 1;
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_LEN {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.len_expr_array, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_PTR_FROM_USIZE {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.ptr_from_usize_value, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_USIZE_FROM_PTR {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.usize_from_ptr_ptr, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_PRINT || expr.type == ASTNodeType.AST_PRINTLN {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.print_expr, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_ERROR_ID {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.error_id_operand, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_ERROR_NAME {
        return exec_lower_collect_reachable_runtime_globals_expr(checker, expr.error_name_operand, owner_filename, globals, out_count);
    }
    if expr.type == ASTNodeType.AST_SYSCALL {
        if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.syscall_number, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        if expr.syscall_args != null {
            var si2: i32 = 0;
            while si2 < expr.syscall_arg_count {
                if exec_lower_collect_reachable_runtime_globals_expr(checker, expr.syscall_args[si2], owner_filename, globals, out_count) != 0 {
                    return -1;
                }
                si2 = si2 + 1;
            }
        }
        return 0;
    }
    return 0;
}

fn exec_lower_collect_reachable_runtime_globals_node(checker: &TypeChecker, node: &ASTNode, owner_filename: &byte, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || node == null || owner_filename == null || globals == null || out_count == null {
        return 0;
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var bi: i32 = 0;
        while bi < node.block_stmt_count {
            if exec_lower_collect_reachable_runtime_globals_node(checker, node.block_stmts[bi], owner_filename, globals, out_count) != 0 {
                return -1;
            }
            bi = bi + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        if exec_lower_collect_reachable_runtime_globals_node(checker, node.if_stmt_condition, owner_filename, globals, out_count) != 0 ||
            exec_lower_collect_reachable_runtime_globals_node(checker, node.if_stmt_then_branch, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.if_stmt_else_branch, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        if exec_lower_collect_reachable_runtime_globals_node(checker, node.while_stmt_condition, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.while_stmt_body, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        if exec_lower_collect_reachable_runtime_globals_node(checker, node.for_stmt_range_start, owner_filename, globals, out_count) != 0 ||
            exec_lower_collect_reachable_runtime_globals_node(checker, node.for_stmt_range_end, owner_filename, globals, out_count) != 0 ||
            exec_lower_collect_reachable_runtime_globals_node(checker, node.for_stmt_array, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.for_stmt_body, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.var_decl_init, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.extern_var_decl_init_expr, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.return_stmt_expr, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        if exec_lower_collect_reachable_runtime_globals_node(checker, node.assign_dest, owner_filename, globals, out_count) != 0 {
            return -1;
        }
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.assign_src, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.defer_stmt_body, owner_filename, globals, out_count);
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        return exec_lower_collect_reachable_runtime_globals_node(checker, node.errdefer_stmt_body, owner_filename, globals, out_count);
    }
    return exec_lower_collect_reachable_runtime_globals_expr(checker, node, owner_filename, globals, out_count);
}

fn exec_lower_collect_runtime_fn_decl_index(decls: & & ASTNode, decl_count: i32, target: &ASTNode) i32 {
    if decls == null || target == null {
        return -1;
    }
    var i: i32 = 0;
    while i < decl_count {
        if decls[i] == target {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn exec_lower_collect_exec_reachable_fn_decls(checker: &TypeChecker, out_decls: & & ASTNode, out_count: &i32) i32 {
    if checker == null || out_decls == null || out_count == null {
        return -1;
    }
    out_count[0] = 0;
    const entry_decl: &ASTNode = exec_lower_find_entry_decl(checker);
    if entry_decl == null {
        return 0;
    }
    var queue: [&ASTNode: MAX_REACHABLE_FN_DECLS] = [];
    var head: i32 = 0;
    var tail: i32 = 0;
    out_decls[0] = entry_decl;
    out_count[0] = 1;
    queue[0] = entry_decl;
    tail = 1;
    while head < tail {
        const from_decl: &ASTNode = queue[head];
        head = head + 1;
        var i: i32 = 0;
        while i < checker.fn_call_edge_count {
            if checker.fn_call_edge_from[i] == from_decl {
                const to_decl: &ASTNode = checker.fn_call_edge_to[i];
                if to_decl != null &&
                    exec_lower_collect_runtime_fn_decl_index(out_decls, out_count[0], to_decl) < 0 {
                    if out_count[0] >= MAX_REACHABLE_FN_DECLS || tail >= MAX_REACHABLE_FN_DECLS {
                        exec_backend_set_error(to_decl, "exec: runtime reachable 函数集合超出上限" as *byte, 0);
                        return -1;
                    }
                    out_decls[out_count[0]] = to_decl;
                    out_count[0] = out_count[0] +| 1;
                    queue[tail] = to_decl;
                    tail = tail + 1;
                }
            }
            i = i + 1;
        }
    }
    return 0;
}

fn exec_lower_collect_global_slots_from_reachable_runtime_functions(checker: &TypeChecker, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || globals == null || out_count == null {
        return -1;
    }
    var fn_decls: [&ASTNode: MAX_REACHABLE_FN_DECLS] = [];
    var fn_decl_count: i32 = 0;
    if exec_lower_collect_exec_reachable_fn_decls(checker, &fn_decls[0] as & & ASTNode, &fn_decl_count) != 0 {
        return -1;
    }
    var i: i32 = 0;
    while i < fn_decl_count {
        const fn_decl: &ASTNode = fn_decls[i];
        if fn_decl != null &&
            fn_decl.type == ASTNodeType.AST_FN_DECL &&
            fn_decl.fn_decl_body != null &&
            fn_decl.filename != null &&
            exec_lower_decl_is_uya_root_runtime(checker, fn_decl) != 0 {
            if exec_lower_collect_reachable_runtime_globals_node(checker, fn_decl.fn_decl_body, fn_decl.filename, globals, out_count) != 0 {
                return -1;
            }
        }
        i = i +| 1;
    }
    return 0;
}

fn exec_lower_find_global_slot_by_decl_in_globals(globals: &HIRGlobalSlot, global_count: i32, decl: &ASTNode) i32 {
    if globals == null || decl == null {
        return -1;
    }
    var i: i32 = 0;
    while i < global_count {
        if globals[i].decl == decl {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn exec_lower_collect_file_globals_node(checker: &TypeChecker, node: &ASTNode, filename: &byte, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if node == null {
        return 0;
    }
    if node.type == ASTNodeType.AST_PROGRAM {
        var i: i32 = 0;
        while i < node.program_decl_count {
            if exec_lower_collect_file_globals_node(checker, node.program_decls[i], filename, globals, out_count) != 0 {
                return -1;
            }
            i = i + 1;
        }
        return 0;
    }
    if node.filename == null || filename == null {
        return 0;
    }
    // 先比指针：AST 节点的 `filename` 绝大多数直接指向同一份文件名字符串，
    // 指针相等就能跳过逐字符比较。这个递归会走遍整个文件的每个节点，
    // 逐个 `str_equals` 比完整路径是 callgrind 里的第二大热点（5.3%）。
    if node.filename != filename && str_equals(node.filename, filename) == 0 {
        return 0;
    }
    if exec_lower_global_is_runtime_decl(node) == 0 {
        return 0;
    }
    if exec_lower_find_global_slot_by_decl_in_globals(globals, out_count[0], node) >= 0 {
        return 0;
    }
    const global_type_ast: &ASTNode = exec_lower_global_type_ast(node);
    if global_type_ast == null {
        return 0;
    }
    const global_type: Type = type_from_ast(checker, global_type_ast);
    if exec_type_is_vm_value_supported(global_type) == 0 {
        return 0;
    }
    if exec_lower_append_global_slot(checker, node, globals, out_count, 1) != 0 {
        return -1;
    }
    return 0;
}

/// 已经收集过全局变量的文件名（指针级别去重）。
///
/// `exec_lower_collect_file_globals` 每次调用都要遍历**整个程序 AST** 并按
/// 文件名过滤，而两个调用点都套在「遍历每个可达函数」的循环里 —— 几百个可达
/// 函数、每个来自几十个不同文件，就是 O(函数数 × 总节点数) 的重复扫描。
/// 同一个文件只要收集一次就够，这里按文件名指针记住已经做过的。
const EXEC_COLLECTED_FILES_MAX: i32 = 256;
var g_exec_collected_file_names: [&byte: EXEC_COLLECTED_FILES_MAX] = [];
var g_exec_collected_file_count: i32 = 0;

/// 清空「已收集文件」记录（每轮 program lowering 开始时调用）。
/// 参数：无。返回值：无。
fn exec_lower_reset_collected_files() void {
    g_exec_collected_file_count = 0;
}

/// 带去重的 `exec_lower_collect_file_globals`。
///
/// 参数：`checker` 类型检查器；`filename` 目标文件名；`globals`/`out_count` 全局槽表与计数。
/// 返回值：0 成功；-1 失败。
fn exec_lower_collect_file_globals_once(checker: &TypeChecker, filename: &byte,
    globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if filename == null {
        return 0;
    }
    var fi: i32 = 0;
    while fi < g_exec_collected_file_count && fi < EXEC_COLLECTED_FILES_MAX {
        if g_exec_collected_file_names[fi] == filename {
            return 0;
        }
        fi = fi + 1;
    }
    if exec_lower_collect_file_globals(checker, filename, globals, out_count) != 0 {
        return -1;
    }
    if g_exec_collected_file_count >= 0 && g_exec_collected_file_count < EXEC_COLLECTED_FILES_MAX {
        g_exec_collected_file_names[g_exec_collected_file_count] = filename;
        g_exec_collected_file_count = g_exec_collected_file_count + 1;
    }
    return 0;
}

fn exec_lower_collect_file_globals(checker: &TypeChecker, filename: &byte, globals: &HIRGlobalSlot, out_count: &i32) i32 {
    if checker == null || filename == null || checker.program_node == null {
        return 0;
    }
    return exec_lower_collect_file_globals_node(checker, checker.program_node, filename, globals, out_count);
}

fn exec_lower_collect_global_slots(arena: &CompilerArena, checker: &TypeChecker, program: &ASTNode, out_count: &i32) &HIRGlobalSlot {
    if out_count != null {
        out_count[0] = 0;
    }
    if arena == null || checker == null || program == null || program.type != ASTNodeType.AST_PROGRAM {
        return null;
    }
    const globals: &HIRGlobalSlot = compiler_arena_alloc(arena, @size_of(HIRGlobalSlot) * EXEC_MAX_GLOBALS as usize) as &HIRGlobalSlot;
    if globals == null {
        exec_backend_set_error(program, "exec: global slot 表分配失败" as *byte, 0);
        return null;
    }
    var count: i32 = 0;
    if exec_lower_collect_global_slots_from_program(checker, program, globals, &count) != 0 {
        return null;
    }
    // 库模块（如 std.testing）的全局变量可能只挂在 checker 的合并程序节点上，
    // 而不在调用方传入的 program 里；两者不是同一节点时补扫一遍。
    if checker.program_node != null && checker.program_node != program {
        if exec_lower_collect_global_slots_from_program(checker, checker.program_node, globals, &count) != 0 {
            return null;
        }
    }
    if exec_lower_collect_global_slots_from_symbols(checker, globals, &count) != 0 {
        return null;
    }
    if exec_lower_collect_global_slots_from_symbol_table(checker, globals, &count) != 0 {
        return null;
    }
    if exec_lower_collect_global_slots_from_imports(checker, globals, &count) != 0 {
        return null;
    }
    if exec_lower_collect_global_slots_from_module_imports(checker, globals, &count) != 0 {
        return null;
    }
    if exec_lower_collect_global_slots_from_use_stmts(checker, globals, &count) != 0 {
        return null;
    }
    if exec_lower_collect_global_slots_from_reachable_runtime_functions(checker, globals, &count) != 0 {
        return null;
    }
    if out_count != null {
        out_count[0] = count;
    }
    return globals;
}

fn exec_lower_collect_called_decls_from_expr(expr: &HIRExpr, out_decls: & & ASTNode, out_count: &i32) void {
    if expr == null || out_count == null {
        return;
    }
    if expr.kind == HIRExprKind.HIR_EXPR_CALL && expr.callee_decl != null &&
        expr.callee_decl.type == ASTNodeType.AST_FN_DECL &&
        expr.callee_decl.fn_decl_body != null &&
        expr.call_host_id == ExecHostCallId.EXEC_HOST_CALL_NONE &&
        exec_lower_decl_index(out_decls, out_count[0], expr.callee_decl) < 0 {
        if out_count[0] < MAX_REACHABLE_FN_DECLS {
            out_decls[out_count[0]] = expr.callee_decl;
            out_count[0] = out_count[0] +| 1;
        }
    }
    // `&fn`（函数地址常量）：被引用的函数必须进入可执行函数集，否则回调查不到下标。
    if expr.kind == HIRExprKind.HIR_EXPR_CONST && expr.callee_decl != null &&
        expr.callee_decl.type == ASTNodeType.AST_FN_DECL &&
        expr.callee_decl.fn_decl_body != null &&
        exec_lower_decl_index(out_decls, out_count[0], expr.callee_decl) < 0 {
        if out_count[0] < MAX_REACHABLE_FN_DECLS {
            out_decls[out_count[0]] = expr.callee_decl;
            out_count[0] = out_count[0] +| 1;
        }
    }
    if expr.kind == HIRExprKind.HIR_EXPR_INTERFACE_BOX && expr.dispatch_decls != null {
        var di: i32 = 0;
        while di < expr.dispatch_decl_count {
            const dispatch_decl: &ASTNode = expr.dispatch_decls[di];
            if dispatch_decl != null &&
                exec_lower_decl_index(out_decls, out_count[0], dispatch_decl) < 0 &&
                out_count[0] < MAX_REACHABLE_FN_DECLS {
                out_decls[out_count[0]] = dispatch_decl;
                out_count[0] = out_count[0] +| 1;
            }
            di = di + 1;
        }
    }
    if expr.left != null {
        exec_lower_collect_called_decls_from_expr(expr.left, out_decls, out_count);
    }
    if expr.right != null {
        exec_lower_collect_called_decls_from_expr(expr.right, out_decls, out_count);
    }
    if expr.extra != null {
        exec_lower_collect_called_decls_from_expr(expr.extra, out_decls, out_count);
    }
    if expr.block != null {
        exec_lower_collect_called_decls_from_block(expr.block, out_decls, out_count);
    }
    var i: i32 = 0;
    while i < expr.call_arg_count {
        exec_lower_collect_called_decls_from_expr(expr.call_args[i], out_decls, out_count);
        i = i + 1;
    }
    i = 0;
    while i < expr.item_count {
        exec_lower_collect_called_decls_from_expr(expr.items[i], out_decls, out_count);
        i = i + 1;
    }
    i = 0;
    while i < expr.match_arm_count {
        if expr.match_arms[i].result_block != null {
            exec_lower_collect_called_decls_from_block(expr.match_arms[i].result_block, out_decls, out_count);
        }
        exec_lower_collect_called_decls_from_expr(expr.match_arms[i].result_expr, out_decls, out_count);
        i = i + 1;
    }
}

fn exec_lower_collect_called_decls_from_stmt(stmt: &HIRStmt, out_decls: & & ASTNode, out_count: &i32) void {
    if stmt == null {
        return;
    }
    if stmt.expr != null {
        exec_lower_collect_called_decls_from_expr(stmt.expr, out_decls, out_count);
    }
    if stmt.assign_expr != null {
        exec_lower_collect_called_decls_from_expr(stmt.assign_expr, out_decls, out_count);
    }
    if stmt.assign_target != null {
        exec_lower_collect_called_decls_from_expr(stmt.assign_target, out_decls, out_count);
    }
    if stmt.then_block != null {
        exec_lower_collect_called_decls_from_block(stmt.then_block, out_decls, out_count);
    }
    if stmt.else_block != null {
        exec_lower_collect_called_decls_from_block(stmt.else_block, out_decls, out_count);
    }
    if stmt.loop_body != null {
        exec_lower_collect_called_decls_from_block(stmt.loop_body, out_decls, out_count);
    }
    if stmt.cleanup_block != null {
        exec_lower_collect_called_decls_from_block(stmt.cleanup_block, out_decls, out_count);
    }
}

fn exec_lower_collect_called_decls_from_block(block: &HIRBlock, out_decls: & & ASTNode, out_count: &i32) void {
    if block == null || out_count == null {
        return;
    }
    var i: i32 = 0;
    while i < block.stmt_count {
        exec_lower_collect_called_decls_from_stmt(block.stmts[i], out_decls, out_count);
        i = i + 1;
    }
}

/// 把某个类型的 drop 方法登记成可达种子（类型没有 drop 时跳过）。
/// 参数：`checker` 检查器；`named_type` 类型名；`out_decls`/`out_count` 种子集合。
/// 返回值：无。
fn exec_lower_seed_drop_decl(checker: &TypeChecker, named_type: &byte,
    out_decls: & & ASTNode, out_count: &i32) void {
    if checker == null || named_type == null || out_decls == null || out_count == null {
        return;
    }
    // 只给真正的 struct/union 播种 drop：接口名同样能查到同名方法，但那个方法的
    // `self` 是接口，降级它会把成员访问解析成接口字段而失败。
    if find_struct_decl_from_program(checker.program_node, named_type) == null &&
        find_union_decl_from_program(checker.program_node, named_type) == null {
        return;
    }
    const drop_decl: &ASTNode = exec_lower_find_named_drop_decl(checker, named_type);
    if (drop_decl == null || drop_decl.type != ASTNodeType.AST_FN_DECL || drop_decl.fn_decl_body == null) {
        return;
    }
    if exec_lower_decl_index(out_decls, out_count[0], drop_decl) >= 0 {
        return;
    }
    if out_count[0] >= MAX_REACHABLE_FN_DECLS {
        return;
    }
    out_decls[out_count[0]] = drop_decl;
    out_count[0] = out_count[0] +| 1;
}

/// 登记 union 变体的 drop 方法：作用域退出时 builder 会为活跃变体生成 drop 调用，
/// 那些声明必须先在可执行函数集合里，否则调用会被跳过（资源不释放）。
/// 只处理 union：结构体字段的 drop 走它自己的可达路径，接口/泛型实参名不参与。
/// 参数：`checker` 检查器；`named_type` 类型名；`out_decls`/`out_count` 种子集合。
/// 返回值：无。
fn exec_lower_seed_union_variant_drop_decls(checker: &TypeChecker, named_type: &byte,
    out_decls: & & ASTNode, out_count: &i32) void {
    if checker == null || checker.program_node == null || named_type == null || out_count == null {
        return;
    }
    const union_decl: &ASTNode = find_union_decl_from_program(checker.program_node, named_type);
    if union_decl == null || union_decl.union_decl_variants == null {
        return;
    }
    var vi: i32 = 0;
    while vi < union_decl.union_decl_variant_count {
        const variant_decl: &ASTNode = union_decl.union_decl_variants[vi];
        if variant_decl != null && variant_decl.var_decl_type != null {
            if variant_decl.var_decl_type.type == ASTNodeType.AST_TYPE_NAMED &&
                variant_decl.var_decl_type.type_named_name != null {
                exec_lower_seed_drop_decl(checker, variant_decl.var_decl_type.type_named_name, out_decls, out_count);
            }
        }
        vi = vi + 1;
    }
}

fn exec_lower_collect_cleanup_decls_from_function(checker: &TypeChecker, fn_hir: &HIRFunction, out_decls: & & ASTNode, out_count: &i32) void {
    if checker == null || checker.program_node == null || fn_hir == null || fn_hir.locals == null || out_count == null {
        return;
    }
    var i: i32 = 0;
    while i < fn_hir.local_count {
        const local: &HIRLocalSlot = fn_hir.locals + i;
        var drop_decl: &ASTNode = local.drop_decl;
        if drop_decl == null && local != null && local.decl != null &&
            local.decl.type == ASTNodeType.AST_VAR_DECL &&
            local.decl.var_decl_type != null &&
            local.decl.var_decl_type.type == ASTNodeType.AST_TYPE_NAMED &&
            local.decl.var_decl_type.type_named_name != null {
            drop_decl = exec_lower_find_named_drop_decl(checker, local.decl.var_decl_type.type_named_name);
        }
        if local != null &&
            drop_decl != null &&
            drop_decl.type == ASTNodeType.AST_FN_DECL &&
            drop_decl.fn_decl_body != null &&
            exec_lower_decl_index(out_decls, out_count[0], drop_decl) < 0 &&
            out_count[0] < MAX_REACHABLE_FN_DECLS {
            out_decls[out_count[0]] = drop_decl;
            out_count[0] = out_count[0] +| 1;
        }
        if local != null && local.decl != null {
            if local.decl.type == ASTNodeType.AST_VAR_DECL && local.decl.var_decl_type != null {
                if local.decl.var_decl_type.type == ASTNodeType.AST_TYPE_NAMED &&
                    local.decl.var_decl_type.type_named_name != null {
                    exec_lower_seed_union_variant_drop_decls(checker,
                        local.decl.var_decl_type.type_named_name, out_decls, out_count);
                }
            }
        }
        i = i + 1;
    }
}

fn exec_lower_lower_global_init_exprs(arena: &CompilerArena, checker: &TypeChecker, globals: &HIRGlobalSlot, global_count: i32, seed_decls: & & ASTNode, seed_count: &i32) i32 {
    if arena == null || checker == null || seed_count == null {
        return -1;
    }
    var i: i32 = 0;
    // `ExecLowerContext` 有 12 个 `[T: EXEC_MAX_LOCALS]` / `[T: EXEC_MAX_GLOBALS]`
    // 级别的大数组，`@size_of` 接近 2MB。原来在循环体内每轮都构造一次字面量，
    // 等于每处理一个全局变量就 memset 两 MB —— callgrind 实测这一项占掉
    // 整个编译器 41% 的指令数（exec_lower_lower_global_init_exprs 内的 memset）。
    // 这里把它提到循环外，循环内只重置运行态计数。
    var ctx: ExecLowerContext = ExecLowerContext {
        arena: arena,
        checker: checker,
        function_decl: null,
        global_names: [],
        global_decls: [],
        global_types: null,
        global_is_const: [],
        global_count: 0,
        local_names: [],
        local_slots: [],
        local_types: null,
        local_is_param: [],
        slot_names: [],
        slot_decls: [],
        slot_types: null,
        slot_is_param: [],
        slot_scope_ids: [],
        slot_needs_drop: [],
        slot_drop_decls: [],
        slot_field_drop_indices: [],
        slot_field_drop_decls: [],
        slot_field_drop_count: [],
        active_local_count: 0,
        next_slot: 0,
        max_slot_count: 0,
        next_scope_id: 0,
        scope_markers: [],
        scope_ids: [],
        scope_depth: 0,
        keep_scope_block: null,
        catch_prefix_scope_open: 0,
    };
    while i < global_count {
        const decl: &ASTNode = globals[i].decl;
        const init_expr_ast: &ASTNode = exec_lower_global_init_ast(decl);
        if init_expr_ast != null {
            // 每个全局变量的初始化表达式各自独立：只重置运行态计数和槽位记账，
            // 不重跑整块 ctx 的零初始化（见循环外的注释）。
            ctx.function_decl = decl;
            ctx.active_local_count = 0;
            ctx.next_slot = 0;
            ctx.max_slot_count = 0;
            ctx.next_scope_id = 0;
            ctx.scope_depth = 0;
            ctx.keep_scope_block = null;
            ctx.catch_prefix_scope_open = 0;
            exec_lower_seed_globals(&ctx, globals, global_count);
            const lowered_init: &HIRExpr = exec_lower_coerce_expr(&ctx, init_expr_ast, &globals[i].type_ref.type);
            if lowered_init == null {
                if exec_backend_get_last_error() == null {
                    exec_backend_set_error(decl, "exec: 全局初始化表达式无法 lowering" as *byte, 0);
                }
                return -1;
            }
            globals[i].init_expr = lowered_init;
            exec_lower_collect_called_decls_from_expr(lowered_init, seed_decls, seed_count);
        }
        i = i + 1;
    }
    return 0;
}

/// 判断表达式是否引用了「尚未初始化」的全局槽位。
/// 参数：`expr` 表达式；`globals` 全局槽表；`global_count` 槽数；
///       `emitted` 已初始化标记；`self_slot` 当前正在初始化的槽（自引用不算依赖）。
/// 返回值：1 存在未初始化依赖；0 没有。
fn exec_lower_expr_needs_unemitted_global(expr: &HIRExpr, globals: &HIRGlobalSlot,
    global_count: i32, emitted: &i32, self_slot: i32) i32 {
    if expr == null {
        return 0;
    }
    if expr.kind == HIRExprKind.HIR_EXPR_GLOBAL {
        const slot: i32 = expr.global_slot;
        if slot >= 0 && slot < global_count && slot != self_slot &&
            globals[slot].init_expr != null && emitted[slot] == 0 {
            return 1;
        }
    }
    if expr.left != null &&
        exec_lower_expr_needs_unemitted_global(expr.left, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if expr.right != null &&
        exec_lower_expr_needs_unemitted_global(expr.right, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if expr.extra != null &&
        exec_lower_expr_needs_unemitted_global(expr.extra, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if expr.block != null &&
        exec_lower_block_needs_unemitted_global(expr.block, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    var i: i32 = 0;
    while i < expr.call_arg_count {
        if exec_lower_expr_needs_unemitted_global(expr.call_args[i], globals, global_count, emitted, self_slot) != 0 {
            return 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < expr.item_count {
        if exec_lower_expr_needs_unemitted_global(expr.items[i], globals, global_count, emitted, self_slot) != 0 {
            return 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < expr.match_arm_count {
        if expr.match_arms[i].result_block != null &&
            exec_lower_block_needs_unemitted_global(expr.match_arms[i].result_block, globals, global_count, emitted, self_slot) != 0 {
            return 1;
        }
        if exec_lower_expr_needs_unemitted_global(expr.match_arms[i].result_expr, globals, global_count, emitted, self_slot) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn exec_lower_stmt_needs_unemitted_global(stmt: &HIRStmt, globals: &HIRGlobalSlot,
    global_count: i32, emitted: &i32, self_slot: i32) i32 {
    if stmt == null {
        return 0;
    }
    if stmt.expr != null &&
        exec_lower_expr_needs_unemitted_global(stmt.expr, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if stmt.assign_expr != null &&
        exec_lower_expr_needs_unemitted_global(stmt.assign_expr, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if stmt.assign_target != null &&
        exec_lower_expr_needs_unemitted_global(stmt.assign_target, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if stmt.then_block != null &&
        exec_lower_block_needs_unemitted_global(stmt.then_block, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if stmt.else_block != null &&
        exec_lower_block_needs_unemitted_global(stmt.else_block, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if stmt.loop_body != null &&
        exec_lower_block_needs_unemitted_global(stmt.loop_body, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    if stmt.cleanup_block != null &&
        exec_lower_block_needs_unemitted_global(stmt.cleanup_block, globals, global_count, emitted, self_slot) != 0 {
        return 1;
    }
    return 0;
}

fn exec_lower_block_needs_unemitted_global(block: &HIRBlock, globals: &HIRGlobalSlot,
    global_count: i32, emitted: &i32, self_slot: i32) i32 {
    if block == null {
        return 0;
    }
    var i: i32 = 0;
    while i < block.stmt_count {
        if exec_lower_stmt_needs_unemitted_global(block.stmts[i], globals, global_count, emitted, self_slot) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 把第 `slot` 个全局的初始化表达式包成一条赋值语句写进 `body`。
/// 参数：`arena` 编译器 arena；`body` 初始化函数体；`stmt_idx` 目标语句下标；
///       `globals` 全局槽表；`slot` 全局槽位。
/// 返回值：无。
fn exec_lower_emit_global_init_stmt(arena: &CompilerArena, body: &HIRBlock, stmt_idx: i32,
    globals: &HIRGlobalSlot, slot: i32) void {
    if (arena == null || body == null || globals == null || stmt_idx < 0) {
        return;
    }
    const stmt: &HIRStmt = compiler_arena_alloc(arena, @size_of(HIRStmt)) as &HIRStmt;
    const target: &HIRExpr = compiler_arena_alloc(arena, @size_of(HIRExpr)) as &HIRExpr;
    if stmt == null || target == null {
        exec_backend_set_error(globals[slot].decl, "exec: global init stmt 分配失败" as *byte, 0);
        return;
    }
    _ = memset(stmt as *byte, 0, @size_of(HIRStmt));
    _ = memset(target as *byte, 0, @size_of(HIRExpr));
    stmt.kind = HIRStmtKind.HIR_STMT_ASSIGN;
    stmt.ast_node = globals[slot].decl;
    target.kind = HIRExprKind.HIR_EXPR_GLOBAL;
    target.ast_node = globals[slot].decl;
    target.type_ref = exec_lower_make_type_ref(&globals[slot].type_ref.type);
    target.local_slot = -1;
    target.global_slot = globals[slot].slot;
    stmt.assign_target = target;
    stmt.assign_expr = globals[slot].init_expr;
    body.stmts[stmt_idx] = stmt;
}

fn exec_lower_build_global_init_function(arena: &CompilerArena, globals: &HIRGlobalSlot, global_count: i32) &HIRFunction {
    if arena == null || globals == null || global_count <= 0 {
        return null;
    }
    var stmt_count: i32 = 0;
    var i: i32 = 0;
    while i < global_count {
        if globals[i].init_expr != null {
            stmt_count = stmt_count + 1;
        }
        i = i + 1;
    }
    if stmt_count == 0 {
        return null;
    }
    const body: &HIRBlock = exec_lower_alloc_scoped_block_raw(arena, globals[0].decl, 0, stmt_count);
    const fn_hir: &HIRFunction = compiler_arena_alloc(arena, @size_of(HIRFunction)) as &HIRFunction;
    if body == null || fn_hir == null {
        exec_backend_set_error(globals[0].decl, "exec: global init function 分配失败" as *byte, 0);
        return null;
    }
    _ = memset(fn_hir as *byte, 0, @size_of(HIRFunction));
    // 按**依赖顺序**发射初始化语句：`const M = A | B` 必须排在 A、B 之后，
    // 否则 M 读到的还是零。槽位编号是「首次出现」顺序而不是声明顺序，实测
    // heap.uya 里 `CHUNK_STATE_MASK` 的槽位比它依赖的两个 flag 更小，按槽位
    // 顺序初始化会让 mask 恒为 0（FREE 位永远清不掉，free() 静默丢块）。
    var emitted: [i32: EXEC_MAX_GLOBALS] = [];
    var emitted_count: i32 = 0;
    var stmt_idx: i32 = 1;
    var rounds: i32 = 0;
    while emitted_count < stmt_count && rounds <= global_count && stmt_idx <= stmt_count {
        var progress: i32 = 0;
        i = 0;
        while i < global_count {
            if globals[i].init_expr != null && emitted[i] == 0 &&
                exec_lower_expr_needs_unemitted_global(globals[i].init_expr, globals, global_count,
                    &emitted[0], i) == 0 {
                exec_lower_emit_global_init_stmt(arena, body, stmt_idx, globals, i);
                emitted[i] = 1;
                emitted_count = emitted_count +| 1;
                stmt_idx = stmt_idx + 1;
                progress = 1;
            }
            i = i + 1;
        }
        if progress == 0 {
            // 出现环（`const A = B; const B = A` 这类非法/病态输入）：退回槽位
            // 顺序，避免构造阶段死循环。
            i = 0;
            while i < global_count {
                if globals[i].init_expr != null && emitted[i] == 0 {
                    exec_lower_emit_global_init_stmt(arena, body, stmt_idx, globals, i);
                    emitted[i] = 1;
                    emitted_count = emitted_count +| 1;
                    stmt_idx = stmt_idx + 1;
                }
                i = i + 1;
            }
        }
        rounds = rounds +| 1;
    }
    const void_type: Type = make_void_type();
    fn_hir.name = "__exec_global_init" as &byte;
    fn_hir.decl = globals[0].decl;
    fn_hir.return_type = exec_lower_make_type_ref(&void_type);
    fn_hir.locals = null;
    fn_hir.local_count = 0;
    fn_hir.param_count = 0;
    fn_hir.body = body;
    return fn_hir;
}

fn exec_lower_find_user_main_decl(checker: &TypeChecker) &ASTNode {
    if checker == null {
        return null;
    }
    var i: i32 = 0;
    while i < checker.reachable_fn_decl_count {
        const decl: &ASTNode = checker.reachable_fn_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL &&
            decl.fn_decl_name != null && decl.fn_decl_body != null &&
            decl.fn_decl_is_extern == 0 && decl.fn_decl_param_count == 0 &&
            str_equals(decl.fn_decl_name, "main" as &byte) != 0 {
            return decl;
        }
        i = i + 1;
    }
    return null;
}

fn exec_lower_make_test_fn_decl(arena: &CompilerArena, test_node: &ASTNode, index: i32) &ASTNode {
    if arena == null || test_node == null || test_node.type != ASTNodeType.AST_TEST_STMT {
        return null;
    }
    const fn_decl: &ASTNode = ast_new_node(ASTNodeType.AST_FN_DECL, test_node.line, test_node.column, arena, test_node.filename);
    if fn_decl == null {
        return null;
    }
    const name_buf: &byte = compiler_arena_alloc(arena, 32) as &byte;
    if name_buf == null {
        return null;
    }
    _ = snprintf(name_buf as *byte, 32, "__exec_test_%d" as *byte, index);
    fn_decl.fn_decl_name = name_buf;
    const void_type_node: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_NAMED, test_node.line, test_node.column, arena, test_node.filename);
    if void_type_node != null {
        void_type_node.type_named_name = "void" as *byte;
    }
    const err_union_node: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_ERROR_UNION, test_node.line, test_node.column, arena, test_node.filename);
    if err_union_node != null {
        err_union_node.type_error_union_payload_type = void_type_node;
    }
    fn_decl.fn_decl_return_type = err_union_node;
    fn_decl.fn_decl_body = test_node.test_stmt_body;
    fn_decl.fn_decl_param_count = 0;
    fn_decl.fn_decl_is_extern = 0;
    return fn_decl;
}

fn exec_lower_build_test_entry_decl(arena: &CompilerArena, program: &ASTNode) &ASTNode {
    if arena == null || program == null {
        return null;
    }
    const fn_decl: &ASTNode = ast_new_node(ASTNodeType.AST_FN_DECL, 0, 0, arena, program.filename);
    if fn_decl == null {
        return null;
    }
    fn_decl.fn_decl_name = "__exec_test_entry" as &byte;
    const void_type_node: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_NAMED, 0, 0, arena, program.filename);
    if void_type_node != null {
        void_type_node.type_named_name = "void" as *byte;
    }
    fn_decl.fn_decl_return_type = void_type_node;
    const empty_block: &ASTNode = ast_new_node(ASTNodeType.AST_BLOCK, 0, 0, arena, program.filename);
    if empty_block != null {
        empty_block.block_stmt_count = 0;
        empty_block.block_stmts = null;
    }
    fn_decl.fn_decl_body = empty_block;
    fn_decl.fn_decl_param_count = 0;
    fn_decl.fn_decl_is_extern = 0;
    return fn_decl;
}

fn exec_lower_find_entry_decl(checker: &TypeChecker) &ASTNode {
    if checker == null {
        return null;
    }
    var fallback: &ASTNode = null;
    var i: i32 = 0;
    while i < checker.reachable_fn_decl_count {
        const decl: &ASTNode = checker.reachable_fn_decls[i];
        if decl != null &&
            decl.type == ASTNodeType.AST_FN_DECL &&
            decl.fn_decl_name != null &&
            str_equals(decl.fn_decl_name, "main" as *byte) != 0 &&
            decl.fn_decl_body != null {
            if decl.fn_decl_is_extern == 0 && decl.fn_decl_param_count == 0 {
                return decl;
            }
            if fallback == null {
                fallback = decl;
            }
        }
        i = i + 1;
    }
    return fallback;
}

fn exec_lower_decl_index(decls: & & ASTNode, decl_count: i32, target: &ASTNode) i32 {
    if decls == null || target == null {
        return -1;
    }
    var i: i32 = 0;
    while i < decl_count {
        if decls[i] == target {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// 常量全局替换：把 `const X: T = init` 内联为 init，并按声明类型 T 补一次转换，
// 避免初始化字面量（默认 i32）与声明类型（如 usize）不一致。
// 参数：ctx - lowering 上下文；use_expr - 使用处的标识符节点；decl - 全局声明节点。
// 返回：替换后的表达式；不可替换时返回 null（调用方继续走原有回退路径）。
fn exec_lower_const_global_init_expr(ctx: &ExecLowerContext, use_expr: &ASTNode, decl: &ASTNode) &HIRExpr {
    const init_ast: &ASTNode = exec_lower_global_init_ast(decl);
    if init_ast == null || init_ast == use_expr {
        return null;
    }
    const init_expr: &HIRExpr = exec_lower_expr(ctx, init_ast);
    if init_expr == null {
        return null;
    }
    const type_ast: &ASTNode = exec_lower_global_type_ast(decl);
    if type_ast == null {
        return init_expr;
    }
    var declared_type: Type = type_from_ast(ctx.checker, type_ast);
    if declared_type.kind == TypeKind.TYPE_VOID ||
        type_equals(init_expr.type_ref.type, declared_type) != 0 ||
        exec_type_is_vm_value_supported(declared_type) == 0 {
        return init_expr;
    }
    const cast_expr: &HIRExpr = exec_lower_alloc_expr(ctx, use_expr, HIRExprKind.HIR_EXPR_CAST, &declared_type);
    if cast_expr == null {
        return null;
    }
    cast_expr.left = init_expr;
    return cast_expr;
}

// match 分支结果：void match 把整个分支块按语句执行，结果用 void 零值占位；
// 其余情况按「前缀块 + 尾部取值表达式」拆分。
fn exec_lower_match_arm_value(ctx: &ExecLowerContext, arm: &ASTMatchArm, match_is_void: i32,
                              out_block: & & HIRBlock) &HIRExpr {
    if out_block != null {
        out_block[0] = null;
    }
    if match_is_void != 0 && arm.result_is_block != 0 {
        const arm_block: &HIRBlock = exec_lower_block(ctx, arm.result_expr);
        if arm_block == null {
            return null;
        }
        if out_block != null {
            out_block[0] = arm_block;
        }
        const void_type: Type = make_void_type();
        return exec_lower_make_zero_expr(ctx, arm.result_expr, &void_type);
    }
    if arm.result_is_block != 0 {
        return exec_lower_extract_block_result_expr(ctx, arm.result_expr, out_block, 0);
    }
    return exec_lower_expr(ctx, arm.result_expr);
}

// 错误联合 match：`error.X` 模式按错误 id 分发，变量绑定臂在 ok 时绑定整个错误联合值。
// 参数：ctx - lowering 上下文；expr - match 表达式节点；subject_expr - 已 lowering 的
// 主体表达式；subject_type - 主体的错误联合类型；match_is_void - 1 表示语句位置 match。
// 返回：HIR_EXPR_MATCH 表达式；失败返回 null 并设置错误。
fn exec_lower_error_union_match_expr(ctx: &ExecLowerContext, expr: &ASTNode,
                                     subject_expr: &HIRExpr, subject_type: Type,
                                     match_is_void: i32) &HIRExpr {
    const arms: &HIRMatchArm = compiler_arena_alloc(ctx.arena, @size_of(HIRMatchArm) * expr.match_expr_arm_count as usize) as &HIRMatchArm;
    if arms == null {
        exec_backend_set_error(expr, "exec: 错误联合 match arms 分配失败" as *byte, 0);
        return null;
    }
    var i: i32 = 0;
    while i < expr.match_expr_arm_count {
        const arm: ASTMatchArm = expr.match_expr_arms[i];
        if arm.kind != MatchPatternKind.MATCH_PAT_ERROR &&
            arm.kind != MatchPatternKind.MATCH_PAT_BIND &&
            arm.kind != MatchPatternKind.MATCH_PAT_ELSE &&
            arm.kind != MatchPatternKind.MATCH_PAT_WILDCARD {
            return exec_lower_fail_expr_reason(expr, "exec: 错误联合 match 仅支持 error/绑定/else 模式" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
        }
        var pattern_value: i64 = 0;
        if arm.kind == MatchPatternKind.MATCH_PAT_ERROR {
            if arm.error_name == null {
                return exec_lower_fail_expr_reason(expr, "exec: 错误联合 match 缺少错误名" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
            }
            const error_id: u32 = get_or_add_error_id(ctx.checker, arm.error_name, expr);
            if error_id == 0 {
                return exec_lower_fail_expr_reason(expr, "exec: 错误联合 match 错误 id 无效" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
            }
            pattern_value = error_id as i64;
        }
        var bind_slot: i32 = -1;
        var arm_scope_pushed: i32 = 0;
        if arm.kind == MatchPatternKind.MATCH_PAT_BIND && arm.var_name != null &&
            str_equals(arm.var_name, "_" as *byte) == 0 {
            if exec_lower_push_scope(ctx, arm.result_expr, -1) == 0 {
                return null;
            }
            arm_scope_pushed = 1;
            bind_slot = exec_lower_append_local(ctx, null, arm.var_name, &subject_type, 0);
            if bind_slot < 0 {
                exec_lower_pop_scope(ctx);
                exec_backend_set_error(expr, "exec: 错误联合 match 绑定槽位不足" as *byte, 0);
                return null;
            }
        }
        var arm_result_block: &HIRBlock = null;
        var arm_result_expr: &HIRExpr = null;
        arm_result_expr = exec_lower_match_arm_value(ctx, &arm, match_is_void, &arm_result_block);
        if arm_scope_pushed != 0 {
            exec_lower_pop_scope(ctx);
        }
        if arm_result_expr == null {
            return null;
        }
        arms[i] = HIRMatchArm {
            kind: arm.kind,
            int_value: pattern_value,
            bool_value: 0,
            bind_local_slot: bind_slot,
            result_block: arm_result_block,
            result_expr: arm_result_expr,
        };
        i = i + 1;
    }
    var match_result_type: Type = exec_lower_expr_type(ctx, expr);
    const hir_match: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_MATCH, &match_result_type);
    if hir_match == null {
        return null;
    }
    hir_match.left = subject_expr;
    hir_match.match_arms = arms;
    hir_match.match_arm_count = expr.match_expr_arm_count;
    return hir_match;
}

/// 往插值格式串缓冲里追加一个字节（带容量检查，便于数组越界证明）。
/// 参数：buf 缓冲；off 当前写入位置；cap 容量；b 字节。
/// 返回值：0 成功，-1 越界。
fn exec_lower_interp_put(buf: &byte, off: &i32, cap: i32, b: byte) i32 {
    if buf == null || off == null || off[0] < 0 || off[0] >= cap {
        return -1;
    }
    buf[off[0]] = b;
    off[0] = off[0] +| 1;
    return 0;
}

/// 把 `"a${x}b"` lowering 成「格式串 + 实参列表」，由 BC_STRING_INTERP 渲染。
/// 格式串规则与 C99 后端 emit_printf_fmt_inline 保持一致。
/// 参数：ctx lowering 上下文；expr 插值节点；type 结果类型。
/// 返回值：HIR 表达式；失败返回 null。
fn exec_lower_string_interp_expr(ctx: &ExecLowerContext, expr: &ASTNode, type: &Type) &HIRExpr {
    if ctx == null || expr == null || type == null || ctx.arena == null {
        return null;
    }
    if expr.string_interp_segment_count <= 0 || expr.string_interp_segments == null {
        return exec_lower_fail_expr_reason(expr, "exec: 字符串插值缺少分段" as *byte,
            ExecUnsupportedReason.EXEC_UNSUPPORTED_STRING_INTERP);
    }
    var fmt_buf: [byte: 1024] = [];
    var off: i32 = 0;
    var arg_total: i32 = 0;
    var i: i32 = 0;
    while i < expr.string_interp_segment_count && off < 900 {
        const seg: &ASTStringInterpSegment = &expr.string_interp_segments[i];
        if seg.is_text != 0 {
            if seg.text != null {
                var p: i32 = 0;
                while seg.text[p] != 0 {
                    const ch: byte = seg.text[p];
                    if ch == 37 as byte {
                        if exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 37 as byte) < 0 {
                            break;
                        }
                    }
                    if exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, ch) < 0 {
                        break;
                    }
                    p = p + 1;
                }
            }
        } else {
            if exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 37 as byte) < 0 {
                break;
            }
            if seg.format_spec != null && seg.format_spec[0] != 0 {
                var k: i32 = 0;
                while seg.format_spec[k] != 0 {
                    if exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, seg.format_spec[k]) < 0 {
                        break;
                    }
                    k = k + 1;
                }
            } else if seg.format_kind == 4 || seg.format_kind == 5 {
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 115 as byte);
            } else if seg.format_kind == 3 {
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 103 as byte);
            } else if seg.format_kind == 2 {
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 108 as byte);
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 108 as byte);
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 117 as byte);
            } else {
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 108 as byte);
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 108 as byte);
                _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 100 as byte);
            }
            arg_total = arg_total + 1;
        }
        i = i + 1;
    }
    _ = exec_lower_interp_put(&fmt_buf[0] as &byte, &off, 1024, 0 as byte);
    const fmt_copy: &byte = compiler_arena_alloc(ctx.arena, (off as usize) + 1 as usize) as &byte;
    if fmt_copy == null {
        return null;
    }
    var c: i32 = 0;
    while c < off {
        fmt_copy[c] = fmt_buf[c];
        c = c +| 1;
    }
    fmt_copy[off] = 0 as byte;
    const hir_interp: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_STRING_INTERP, type);
    if hir_interp == null {
        return null;
    }
    hir_interp.string_value = fmt_copy;
    hir_interp.item_count = arg_total;
    if arg_total > 0 {
        hir_interp.items = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * (arg_total as usize)) as & & HIRExpr;
        if hir_interp.items == null {
            return null;
        }
    }
    var arg_index: i32 = 0;
    var j: i32 = 0;
    while j < expr.string_interp_segment_count {
        const seg2: &ASTStringInterpSegment = &expr.string_interp_segments[j];
        if seg2.is_text == 0 && seg2.expr != null && arg_index < arg_total && hir_interp.items != null {
            const arg_hir: &HIRExpr = exec_lower_expr(ctx, seg2.expr);
            if arg_hir == null {
                return null;
            }
            hir_interp.items[arg_index] = arg_hir;
            arg_index = arg_index + 1;
        }
        j = j + 1;
    }
    return hir_interp;
}

fn exec_lower_expr(ctx: &ExecLowerContext, expr: &ASTNode) &HIRExpr {
    const lowered: &HIRExpr = exec_lower_expr_inner(ctx, expr);
    if lowered != null || expr == null {
        return lowered;
    }
    if exec_backend_get_last_error() == null {
        var fallback_msg: [byte: 128] = [];
        _ = snprintf(&fallback_msg[0] as *byte, 128,
            "exec: 表达式节点 lowering 失败但未设置错误信息(type=%d)" as *byte, expr.type as i32);
        exec_backend_set_error(expr, &fallback_msg[0] as &byte, 0);
    }
    return lowered;
}

/// 把 `{ ... }` 当表达式降级：前导语句照常执行，尾表达式的值就是块的值。
///
/// 宏展开（`encode_to_to_json` 一类）会把整个调用替换成这种语句表达式，
/// 所以泛型单态体里必然遇到。
///
/// 参数：`expr` 是 `AST_BLOCK`；`block_type` 是块的值类型。
/// 返回值：`HIR_EXPR_BLOCK`；失败返回 null。
/// 把单条语句包成一个 `AST_BLOCK`，方便复用「块当表达式」的降级路径。
/// 参数：`ctx` 上下文；`stmt` 语句节点。返回值：合成块；失败返回 null。
fn exec_lower_single_stmt_block(ctx: &ExecLowerContext, stmt: &ASTNode) &ASTNode {
    if ctx == null || stmt == null {
        return null;
    }
    const block: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
    const stmts: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode)) as & & ASTNode;
    if block == null || stmts == null {
        return null;
    }
    _ = memset(block as *byte, 0, @size_of(ASTNode));
    block.type = ASTNodeType.AST_BLOCK;
    block.line = stmt.line;
    block.column = stmt.column;
    block.filename = stmt.filename;
    block.block_stmts = stmts;
    block.block_stmt_count = 1;
    stmts[0] = stmt;
    return block;
}

/// 分支值节点是不是跳转语句（`return` / `break` / `continue`）。
/// 参数：`node` 分支值节点。返回值：1 是，0 不是。
fn exec_lower_node_is_jump_stmt(node: &ASTNode) i32 {
    if node == null {
        return 0;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT || node.type == ASTNodeType.AST_BREAK_STMT ||
        node.type == ASTNodeType.AST_CONTINUE_STMT {
        return 1;
    }
    return 0;
}

fn exec_lower_block_expr(ctx: &ExecLowerContext, expr: &ASTNode, block_type: &Type) &HIRExpr {
    if expr == null || expr.block_stmts == null || expr.block_stmt_count <= 0 {
        return exec_lower_make_zero_expr(ctx, expr, block_type);
    }
    const tail_stmt: &ASTNode = expr.block_stmts[expr.block_stmt_count - 1];
    if tail_stmt == null {
        return exec_lower_make_zero_expr(ctx, expr, block_type);
    }
    const blk: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_BLOCK, block_type);
    if blk == null {
        return null;
    }
    if tail_stmt.type == ASTNodeType.AST_RETURN_STMT || tail_stmt.type == ASTNodeType.AST_BREAK_STMT ||
        tail_stmt.type == ASTNodeType.AST_CONTINUE_STMT {
        // 块尾是 `return` / `break` / `continue`：块没有「值」（控制流已经跳走），
        // 整块按语句降级，值位置补零。
        const jump_zero: &HIRExpr = exec_lower_make_zero_expr(ctx, expr, block_type);
        if jump_zero == null {
            return null;
        }
        blk.block = exec_lower_block(ctx, expr);
        if blk.block == null {
            return null;
        }
        blk.extra = jump_zero;
        blk.type_ref = jump_zero.type_ref;
        return blk;
    }
    // 前缀块作用域状态是「本层」的：单语句块没有前缀，绝不能把外层 catch
    // 还没收尾的 prefix 状态继承过来，否则会把外层作用域提前弹掉，
    // 外层 catch 前缀里声明的局部变量就查不到了（`err_id` 一类）。
    const saved_prefix_open: i32 = ctx.catch_prefix_scope_open;
    var prefix_open: i32 = 0;
    if expr.block_stmt_count > 1 {
        blk.block = exec_lower_make_block_prefix(ctx, expr);
        if blk.block == null {
            return null;
        }
        prefix_open = ctx.catch_prefix_scope_open;
    }
    const tail_expr: &HIRExpr = exec_lower_expr(ctx, tail_stmt);
    exec_lower_catch_exit_scopes(ctx, 0, prefix_open);
    ctx.catch_prefix_scope_open = saved_prefix_open;
    if tail_expr == null {
        return null;
    }
    blk.extra = tail_expr;
    blk.type_ref = tail_expr.type_ref;
    return blk;
}

/// 把 `a |> f(x)` 链就地改写成嵌套调用 `f(a, x)`。
///
/// pipeline 链的每一段右侧都是一次普通调用，管道值作为该调用的**第一个**实参。
/// 改写后节点类型变成 `AST_CALL_EXPR`，后续复用普通调用 lowering
/// （泛型单态、方法调用、可变参数都在那里处理）。
///
/// 参数：`ctx` 用于 arena 分配；`expr` 是最外层 pipeline 节点。
/// 返回值：改写后的最外层调用节点；结构不合法返回 null。
fn exec_lower_desugar_pipeline(ctx: &ExecLowerContext, expr: &ASTNode) &ASTNode {
    if ctx == null || expr == null || expr.type != ASTNodeType.AST_PIPELINE_EXPR {
        return null;
    }
    var chain_len: i32 = 0;
    var walk: &ASTNode = expr;
    while walk != null && walk.type == ASTNodeType.AST_PIPELINE_EXPR {
        chain_len = chain_len + 1;
        walk = walk.pipeline_expr_left;
    }
    if walk == null || chain_len <= 0 {
        return null;
    }
    const nodes: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode) * (chain_len as usize)) as & & ASTNode;
    const calls: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode) * (chain_len as usize)) as & & ASTNode;
    if nodes == null || calls == null {
        return null;
    }
    var idx: i32 = 0;
    walk = expr;
    while walk != null && walk.type == ASTNodeType.AST_PIPELINE_EXPR && idx < chain_len {
        nodes[idx] = walk;
        calls[idx] = walk.pipeline_expr_right;
        walk = walk.pipeline_expr_left;
        idx = idx + 1;
    }
    if idx != chain_len {
        return null;
    }
    var piped: &ASTNode = walk;
    // 最左段是错误联合（`!Pipeline`）时，C 端会按 try 语义在这里向当前函数返回错误；
    // 这里包一层 TRY 节点复用同样的 lowering。
    if piped != null {
        const piped_left_type: Type = exec_lower_expr_type(ctx, piped);
        if piped_left_type.kind == TypeKind.TYPE_ERROR_UNION {
            const try_wrap_node: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
            if try_wrap_node == null {
                return null;
            }
            try_wrap_node[0] = piped[0];
            try_wrap_node.type = ASTNodeType.AST_TRY_EXPR;
            try_wrap_node.try_expr_is_checked_arith = 0;
            try_wrap_node.try_expr_operand = piped;
            piped = try_wrap_node;
        }
    }
    var k: i32 = chain_len - 1;
    while k >= 0 {
        const right_call: &ASTNode = calls[k];
        if right_call == null || right_call.type != ASTNodeType.AST_CALL_EXPR {
            return null;
        }
        const old_count: i32 = right_call.call_expr_arg_count;
        const new_count: i32 = old_count +| 1;
        const new_args: & & ASTNode = compiler_arena_alloc(ctx.arena, @size_of(&ASTNode) * (new_count as usize)) as & & ASTNode;
        if new_args == null {
            return null;
        }
        new_args[0] = piped;
        var ai: i32 = 0;
        while ai < old_count {
            new_args[ai +| 1] = right_call.call_expr_args[ai];
            ai = ai + 1;
        }
        const seg: &ASTNode = nodes[k];
        seg.type = ASTNodeType.AST_CALL_EXPR;
        seg.call_expr_callee = right_call.call_expr_callee;
        seg.call_expr_args = new_args;
        seg.call_expr_arg_count = new_count;
        seg.call_expr_has_ellipsis_forward = right_call.call_expr_has_ellipsis_forward;
        seg.call_expr_type_args = right_call.call_expr_type_args;
        seg.call_expr_type_arg_count = right_call.call_expr_type_arg_count;
        piped = seg;
        k = k - 1;
    }
    return piped;
}

fn exec_lower_expr_inner(ctx: &ExecLowerContext, expr: &ASTNode) &HIRExpr {
    if ctx == null || expr == null {
        return null;
    }
    if expr.type == ASTNodeType.AST_PIPELINE_EXPR {
        const desugared_pipeline: &ASTNode = exec_lower_desugar_pipeline(ctx, expr);
        if desugared_pipeline == null {
            return exec_lower_fail_expr(expr, "exec: pipeline 表达式改写成调用失败" as *byte);
        }
        return exec_lower_expr(ctx, desugared_pipeline);
    }
    if expr.type == ASTNodeType.AST_TRY_EXPR {
        if expr.try_expr_is_checked_arith != 0 {
            // checked 整数算术：`try (a + b)` 溢出/除零时把错误联合原样返回。
            var try_payload_checked: Type = exec_lower_type_from_kind_code(expr.try_expr_checked_kind);
            if try_payload_checked.kind == TypeKind.TYPE_VOID {
                try_payload_checked = exec_lower_expr_type(ctx, expr.try_expr_operand);
            }
            const hir_checked_try: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CHECKED_CATCH, &try_payload_checked);
            if hir_checked_try == null {
                return null;
            }
            hir_checked_try.left = exec_lower_checked_arith_tree(ctx, expr.try_expr_operand, &try_payload_checked);
            if hir_checked_try.left == null {
                return null;
            }
            hir_checked_try.bool_value = 1;
            hir_checked_try.int_value = get_or_add_error_id(ctx.checker, "Overflow" as &byte, expr) as i64;
            hir_checked_try.global_slot = get_or_add_error_id(ctx.checker, "DivisionByZero" as &byte, expr) as i32;
            return hir_checked_try;
        }
        const operand_try_early: &HIRExpr = exec_lower_expr(ctx, expr.try_expr_operand);
        if operand_try_early == null {
            return null;
        }
        var try_payload_type: Type = make_void_type();
        if operand_try_early.type_ref.type.kind == TypeKind.TYPE_ERROR_UNION &&
            operand_try_early.type_ref.type.error_union_payload_type != null {
            try_payload_type = copy_type(&operand_try_early.type_ref.type.error_union_payload_type[0]);
        } else if expr.try_expr_operand.type == ASTNodeType.AST_MATCH_EXPR &&
            operand_try_early.type_ref.type.kind != TypeKind.TYPE_VOID {
            // `try match … { .obj(o) => 解码块, else => error.WrongType }`：
            // JSON 解码宏把「载荷 / 错误值」写成 match 的两个分支，运行时的
            // IS_ERR/UNWRAP_OK 本来就能区分裸错误值与载荷，这里只需把 match
            // 的类型当作载荷类型。
            try_payload_type = copy_type(&operand_try_early.type_ref.type);
        } else {
            var try_msg_early: [byte: 160] = [];
            _ = snprintf(&try_msg_early[0] as *byte, 160,
                "exec: try 操作数不是错误联合(kind=%d ast=%d)" as *byte,
                operand_try_early.type_ref.type.kind as i32, expr.try_expr_operand.type as i32);
            return exec_lower_fail_expr_reason(expr, &try_msg_early[0] as &byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_TRY_EXPR);
        }
        if ctx.function_decl != null && ctx.function_decl.fn_decl_is_async != 0 {
            // async 函数里的 `try`：错误要提前返回，且返回的是包装成 Future 的值。
            return exec_lower_make_async_try_catch(ctx, expr, operand_try_early, copy_type(&try_payload_type));
        }
        const hir_try_early: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_TRY, &try_payload_type);
        if hir_try_early == null {
            return null;
        }
        hir_try_early.left = operand_try_early;
        return hir_try_early;
    }
    if expr.type == ASTNodeType.AST_CATCH_EXPR {
        var catch_bind_slot_early: i32 = -1;
        var catch_bind_scope_early: i32 = 0;
        if expr.catch_expr_err_name != null &&
            str_equals(expr.catch_expr_err_name, "_" as *byte) == 0 {
            var catch_err_type_early: Type = make_void_type();
            catch_err_type_early.kind = TypeKind.TYPE_ERROR;
            if exec_lower_push_scope(ctx, expr, -1) == 0 {
                return null;
            }
            catch_bind_scope_early = 1;
            catch_bind_slot_early = exec_lower_append_local(ctx, null, expr.catch_expr_err_name, &catch_err_type_early, 0);
            if catch_bind_slot_early < 0 {
                exec_lower_pop_scope(ctx);
                exec_backend_set_error(expr, "exec: catch 错误绑定槽位不足" as *byte, 0);
                return null;
            }
        }
        var catch_payload_type: Type = make_void_type();
        var catch_is_checked_early: i32 = 0;
        var operand_catch_early: &HIRExpr = null;
        if expr.catch_expr_is_checked_arith != 0 {
            // checked 整数算术：`(a + b) catch { ... }` 就地处理溢出，不要求错误联合。
            // 载荷类型用 checker 记录的 checked_kind：lowering 期 checker 作用域已退出，
            // 现推会退化成字面量默认的 i32，把 i64/u64 运算截断。
            catch_payload_type = exec_lower_type_from_kind_code(expr.catch_expr_checked_kind);
            catch_is_checked_early = 1;
            operand_catch_early = exec_lower_checked_arith_tree(ctx, expr.catch_expr_operand, &catch_payload_type);
        } else {
            operand_catch_early = exec_lower_expr(ctx, expr.catch_expr_operand);
        }
        if operand_catch_early == null {
            if catch_bind_scope_early != 0 {
                exec_lower_pop_scope(ctx);
            }
            return null;
        }
        if catch_is_checked_early != 0 {
            if catch_payload_type.kind == TypeKind.TYPE_VOID {
                if catch_bind_scope_early != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return exec_lower_fail_expr_reason(expr, "exec: catch 的算术操作数不是整数类型" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_CATCH_EXPR);
            }
        } else if operand_catch_early.type_ref.type.kind != TypeKind.TYPE_ERROR_UNION ||
            operand_catch_early.type_ref.type.error_union_payload_type == null {
            if catch_bind_scope_early != 0 {
                exec_lower_pop_scope(ctx);
            }
            return exec_lower_fail_expr_reason(expr, "exec: catch 操作数不是错误联合" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_CATCH_EXPR);
        } else {
            catch_payload_type = operand_catch_early.type_ref.type.error_union_payload_type[0];
        }
        var catch_hir_kind_early: HIRExprKind = HIRExprKind.HIR_EXPR_CATCH;
        if catch_is_checked_early != 0 {
            catch_hir_kind_early = HIRExprKind.HIR_EXPR_CHECKED_CATCH;
        }
        const hir_catch_early: &HIRExpr = exec_lower_alloc_expr(ctx, expr, catch_hir_kind_early, &catch_payload_type);
        if catch_is_checked_early != 0 {
            // catch 分支要按真实错误 id 绑定 `|e|`，id 与 checker 注册的一致。
            hir_catch_early.int_value = get_or_add_error_id(ctx.checker, "Overflow" as &byte, expr) as i64;
            hir_catch_early.global_slot = get_or_add_error_id(ctx.checker, "DivisionByZero" as &byte, expr) as i32;
        }
        if hir_catch_early == null {
            if catch_bind_scope_early != 0 {
                exec_lower_pop_scope(ctx);
            }
            return null;
        }
        hir_catch_early.left = operand_catch_early;
        hir_catch_early.local_slot = catch_bind_slot_early;
        const catch_block_early: &ASTNode = expr.catch_expr_catch_block;
        const catch_last_stmt_early: &ASTNode = exec_lower_block_last_stmt(catch_block_early);
        if catch_last_stmt_early == null {
            hir_catch_early.right = exec_lower_make_zero_expr(ctx, catch_block_early, &catch_payload_type);
            if hir_catch_early.right == null {
                if catch_bind_scope_early != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return null;
            }
            if catch_bind_scope_early != 0 {
                exec_lower_pop_scope(ctx);
            }
            return hir_catch_early;
        }
        // `x catch { break; }`：catch 块以 break/continue 收尾时没有「结果值」，
        // 整块按语句降级，结果给零值占位。
        const catch_tail_jumps: i32 = (catch_last_stmt_early.type == ASTNodeType.AST_BREAK_STMT ||
            catch_last_stmt_early.type == ASTNodeType.AST_CONTINUE_STMT) as i32;
        if (catch_payload_type.kind == TypeKind.TYPE_VOID || catch_tail_jumps != 0) &&
            catch_last_stmt_early.type != ASTNodeType.AST_RETURN_STMT {
            hir_catch_early.block = exec_lower_block(ctx, catch_block_early);
            if hir_catch_early.block == null {
                if catch_bind_scope_early != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return null;
            }
            hir_catch_early.right = exec_lower_make_zero_expr(ctx, catch_block_early, &catch_payload_type);
            if hir_catch_early.right == null {
                if catch_bind_scope_early != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return null;
            }
            if catch_bind_scope_early != 0 {
                exec_lower_pop_scope(ctx);
            }
            return hir_catch_early;
        }
        hir_catch_early.block = exec_lower_make_block_prefix(ctx, catch_block_early);
        const catch_prefix_scope_early: i32 = ctx.catch_prefix_scope_open;
        if catch_last_stmt_early.type == ASTNodeType.AST_RETURN_STMT {
            const return_stmt_early: &ASTNode = catch_last_stmt_early;
            if return_stmt_early.return_stmt_expr != null {
                if ctx.function_decl != null && ctx.function_decl.fn_decl_return_type != null {
                    const catch_return_type_early: Type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
                    hir_catch_early.extra = exec_lower_wrap_catch_return(ctx, expr,
                        exec_lower_coerce_expr(ctx, return_stmt_early.return_stmt_expr, &catch_return_type_early),
                        copy_type(&catch_return_type_early));
                } else {
                    hir_catch_early.extra = exec_lower_expr(ctx, return_stmt_early.return_stmt_expr);
                }
                if hir_catch_early.extra == null {
                    exec_lower_catch_exit_scopes(ctx, catch_bind_scope_early, catch_prefix_scope_early);
                    return null;
                }
            } else {
                hir_catch_early.extra = exec_lower_make_bare_return_expr(ctx, return_stmt_early);
                if hir_catch_early.extra == null {
                    exec_lower_catch_exit_scopes(ctx, catch_bind_scope_early, catch_prefix_scope_early);
                    return null;
                }
            }
            exec_lower_catch_exit_scopes(ctx, catch_bind_scope_early, catch_prefix_scope_early);
            return hir_catch_early;
        }
        const fallback_expr_early: &HIRExpr = exec_lower_expr(ctx, catch_last_stmt_early);
        if fallback_expr_early == null {
            exec_lower_catch_exit_scopes(ctx, catch_bind_scope_early, catch_prefix_scope_early);
            return null;
        }
        hir_catch_early.right = fallback_expr_early;
        exec_lower_catch_exit_scopes(ctx, catch_bind_scope_early, catch_prefix_scope_early);
        return hir_catch_early;
    }
    const expr_type: Type = exec_lower_expr_type(ctx, expr);
    if expr.type == ASTNodeType.AST_SIZEOF || expr.type == ASTNodeType.AST_ALIGNOF {
        const folded_value: i32 = exec_lower_eval_size_align_builtin(ctx, expr);
        if folded_value < 0 {
            const fallback_value: i32 = checker_eval_const_expr(ctx.checker, expr);
            if fallback_value < 0 {
                var fold_fail_msg: [byte: 224] = [];
                var fold_target_kind: i32 = -1;
                var fold_target_name: &byte = "(none)" as &byte;
                if expr.type == ASTNodeType.AST_SIZEOF && expr.sizeof_expr_target != null {
                    fold_target_kind = expr.sizeof_expr_target.type as i32;
                    if expr.sizeof_expr_target.identifier_name != null {
                        fold_target_name = expr.sizeof_expr_target.identifier_name;
                    }
                }
                var fold_target_type_kind: i32 = -1;
                var fold_target_param: &byte = "(none)" as &byte;
                if expr.type == ASTNodeType.AST_SIZEOF && expr.sizeof_expr_target != null {
                    const fold_probe_type: Type = exec_lower_expr_type(ctx, expr.sizeof_expr_target);
                    fold_target_type_kind = fold_probe_type.kind as i32;
                    if fold_probe_type.generic_param_name != null {
                        fold_target_param = fold_probe_type.generic_param_name;
                    }
                    if fold_probe_type.struct_name != null {
                        fold_target_param = fold_probe_type.struct_name;
                    }
                }
                _ = snprintf(&fold_fail_msg[0] as *byte, 224,
                    "exec: 编译期 builtin 折叠失败(target=%d name=%s kind=%d tkind=%d tparam=%s)" as *byte,
                    fold_target_kind, fold_target_name as *byte, expr_type.kind as i32,
                    fold_target_type_kind, fold_target_param as *byte);
                return exec_lower_fail_expr(expr, &fold_fail_msg[0]);
            }
            return exec_lower_make_int_const_expr(ctx, expr, &expr_type, fallback_value as i64);
        }
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, folded_value as i64);
    }
    if expr.type == ASTNodeType.AST_SRC_NAME {
        return exec_lower_make_string_const_expr(ctx, expr, &expr_type, exec_lower_basename(expr.filename));
    }
    if expr.type == ASTNodeType.AST_SRC_PATH {
        var source_path: &byte = expr.filename;
        if source_path == null {
            source_path = "(unknown)" as &byte;
        }
        return exec_lower_make_string_const_expr(ctx, expr, &expr_type, source_path);
    }
    if expr.type == ASTNodeType.AST_SRC_LINE {
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, expr.line as i64);
    }
    if expr.type == ASTNodeType.AST_SRC_COL {
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, expr.column as i64);
    }
    if expr.type == ASTNodeType.AST_FUNC_NAME {
        var func_name: &byte = "(unknown)" as &byte;
        if ctx.function_decl != null && ctx.function_decl.fn_decl_name != null {
            func_name = ctx.function_decl.fn_decl_name;
        }
        return exec_lower_make_string_const_expr(ctx, expr, &expr_type, func_name);
    }
    if expr.type == ASTNodeType.AST_ASM_TARGET {
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, exec_lower_host_asm_target_value() as i64);
    }
    if expr.type == ASTNodeType.AST_INT_LIMIT {
        var int_limit_ok: i32 = 0;
        const int_limit_value: i64 = exec_lower_eval_int_limit(expr, expr_type.kind, &int_limit_ok);
        if int_limit_ok == 0 {
            return exec_lower_fail_expr(expr, "exec: @max/@min 尚未解析为可表示的整数类型" as *byte);
        }
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, int_limit_value);
    }
    if expr.type == ASTNodeType.AST_NUMBER {
        if expr_type.kind != TypeKind.TYPE_I8 &&
            expr_type.kind != TypeKind.TYPE_I16 &&
            expr_type.kind != TypeKind.TYPE_I32 &&
            expr_type.kind != TypeKind.TYPE_U32 &&
            expr_type.kind != TypeKind.TYPE_I64 &&
            expr_type.kind != TypeKind.TYPE_U64 &&
            expr_type.kind != TypeKind.TYPE_U8 &&
            expr_type.kind != TypeKind.TYPE_U16 &&
            expr_type.kind != TypeKind.TYPE_USIZE {
            return exec_lower_fail_expr(expr, "exec: 仅支持 exec VM 可表示的整数数字字面量" as *byte);
        }
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, expr.number_value_i64);
    }
    if expr.type == ASTNodeType.AST_FLOAT {
        if expr_type.kind != TypeKind.TYPE_F32 && expr_type.kind != TypeKind.TYPE_F64 {
            return exec_lower_fail_expr(expr, "exec: 当前仅支持 f32/f64 浮点字面量" as *byte);
        }
        return exec_lower_make_float_const_expr(ctx, expr, &expr_type, expr.float_literal_value);
    }
    if expr.type == ASTNodeType.AST_BOOL {
        const hir: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CONST, &expr_type);
        if hir == null {
            return null;
        }
        hir.bool_value = expr.bool_literal_value;
        return hir;
    }
    if expr.type == ASTNodeType.AST_CHAR {
        const hir: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CONST, &expr_type);
        if hir == null {
            return null;
        }
        hir.int_value = expr.char_literal_value as i64;
        return hir;
    }
    if expr.type == ASTNodeType.AST_STRING {
        return exec_lower_make_string_const_expr(ctx, expr, &expr_type, expr.string_literal_value);
    }
    if expr.type == ASTNodeType.AST_STRING_INTERP {
        return exec_lower_string_interp_expr(ctx, expr, &expr_type);
    }
    if expr.type == ASTNodeType.AST_ERROR_VALUE {
        return exec_lower_make_int_const_expr(ctx, expr, &expr_type, expr_type.error_error_id as i64);
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        if expr.identifier_name != null &&
            str_equals(expr.identifier_name, "null" as &byte) != 0 {
            var null_type: Type = copy_type(&expr_type);
            if null_type.kind != TypeKind.TYPE_POINTER {
                null_type = exec_lower_make_void_pointer_type();
            }
            return exec_lower_make_int_const_expr(ctx, expr, &null_type, 0);
        }
        const slot: i32 = exec_lower_find_slot(ctx, expr.identifier_name);
        if slot >= 0 {
            var local_type: Type = copy_type(&expr_type);
            if slot >= 0 && slot < EXEC_MAX_LOCALS {
                local_type = exec_lower_type_slot(ctx, 0, slot, EXEC_MAX_LOCALS)[0];
            }
            const hir_local: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_LOCAL, &local_type);
            if hir_local == null {
                return null;
            }
            hir_local.local_slot = slot;
            return hir_local;
        }
        var imported_global_decl: &ASTNode = exec_lower_resolve_global_decl(ctx.checker, expr.identifier_name);
        if imported_global_decl == null && expr.filename != null {
            imported_global_decl = exec_lower_resolve_imported_decl_from_file(ctx.checker, expr.filename, expr.identifier_name, 10);
        }
        if imported_global_decl == null && expr.filename != null {
            imported_global_decl = exec_lower_resolve_module_self_named_global_from_file(ctx.checker, expr.filename, expr.identifier_name);
        }
        if imported_global_decl != null {
            const global_slot_by_decl: i32 = exec_lower_find_global_slot_by_decl(ctx, imported_global_decl);
            var resolved_global_slot_by_decl: i32 = global_slot_by_decl;
            if resolved_global_slot_by_decl < 0 && expr.identifier_name != null {
                resolved_global_slot_by_decl = exec_lower_find_global_slot(ctx, expr.identifier_name);
            }
            if resolved_global_slot_by_decl >= 0 {
                var global_type_by_decl: Type = copy_type(&expr_type);
                if resolved_global_slot_by_decl >= 0 && resolved_global_slot_by_decl < EXEC_MAX_GLOBALS {
                    global_type_by_decl = exec_lower_type_slot(ctx, 2, resolved_global_slot_by_decl, EXEC_MAX_GLOBALS)[0];
                }
                const hir_global_by_decl: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_GLOBAL, &global_type_by_decl);
                if hir_global_by_decl == null {
                    return null;
                }
                hir_global_by_decl.global_slot = resolved_global_slot_by_decl;
                return hir_global_by_decl;
            }
            if exec_lower_global_is_const(imported_global_decl) != 0 {
                const const_value: &HIRExpr = exec_lower_const_global_init_expr(ctx, expr, imported_global_decl);
                if const_value != null {
                    return const_value;
                }
            }
            if imported_global_decl != null {
                const global_type_ast2: &ASTNode = exec_lower_global_type_ast(imported_global_decl);
                if global_type_ast2 != null {
                    const global_type2: Type = type_from_ast(ctx.checker, global_type_ast2);
                    if exec_type_is_vm_value_supported(global_type2) == 0 {
                        if exec_type_uses_simd(global_type2) != 0 {
                            return exec_lower_fail_expr_reason(expr, "exec: 当前不支持 SIMD 全局变量" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
                        }
                        return exec_lower_fail_expr(expr, "exec: 当前仅支持 exec VM 可表示的全局变量" as *byte);
                    }
                }
            }
        }
        const global_slot: i32 = exec_lower_find_global_slot(ctx, expr.identifier_name);
        if global_slot >= 0 {
            var global_type: Type = copy_type(&expr_type);
            if global_slot >= 0 && global_slot < EXEC_MAX_GLOBALS {
                global_type = exec_lower_type_slot(ctx, 2, global_slot, EXEC_MAX_GLOBALS)[0];
            }
            const hir_global: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_GLOBAL, &global_type);
            if hir_global == null {
                return null;
            }
            hir_global.global_slot = global_slot;
            return hir_global;
        }
        if expr.identifier_name != null && str_equals(expr.identifier_name, "undefined" as &byte) != 0 &&
            expr_type.kind != TypeKind.TYPE_VOID {
            return exec_lower_make_zero_expr(ctx, expr, &expr_type);
        }
        if expr.identifier_name != null && str_equals(expr.identifier_name, "null" as &byte) != 0 {
            // null 字面量在 AST 里是标识符（parser 用名字标记），exec 侧按零值指针处理。
            var null_type: Type = copy_type(&expr_type);
            if null_type.kind == TypeKind.TYPE_VOID {
                const void_pointee: Type = make_void_type();
                null_type = make_pointer_type(ctx.arena, &void_pointee, 0);
            }
            return exec_lower_make_zero_expr(ctx, expr, &null_type);
        }
        if expr.identifier_name != null {
            // 裸函数名当值用（`pthread_create(..., thread_main, arg)` 一类）：
            // 解释器里没有可执行地址，给一个稳定的非零占位指针。
            const bare_fn_decl: &ASTNode = exec_lower_resolve_function_decl_from_file(ctx.checker, expr.filename, expr.identifier_name);
            if bare_fn_decl != null && bare_fn_decl.type == ASTNodeType.AST_FN_DECL {
                var fn_addr_type: Type = copy_type(&expr_type);
                if (exec_type_is_vm_value_supported(fn_addr_type) == 0 ||
                    fn_addr_type.kind == TypeKind.TYPE_VOID) &&
                    str_equals(expr.identifier_name, "null" as *byte) == 0 {
                    const fn_void_pointee: Type = make_void_type();
                    fn_addr_type = make_pointer_type(ctx.arena, &fn_void_pointee, 0);
                }
                const fn_addr_value: i64 = 4096 + (hash_string(expr.identifier_name) & 0xFFF) as i64;
                return exec_lower_make_int_const_expr(ctx, expr, &fn_addr_type, fn_addr_value);
            }
            var libc_const: i64 = 0;
            if exec_lower_libc_macro(expr.identifier_name, &libc_const) != 0 {
                var libc_type: Type = copy_type(&expr_type);
                if libc_type.kind == TypeKind.TYPE_VOID {
                    libc_type = make_i32_type();
                }
                return exec_lower_make_int_const_expr(ctx, expr, &libc_type, libc_const);
            }
            // `extern var` 全局：C99 里由链接器/编译器提供存储（例如 async_frame 的
            // descriptor 表）。解释器没有对应存储，按「零值」处理——表为空、
            // 计数为 0、指针为 null，正好等于「运行期没有注册任何异步帧」。
            var extern_var_decl: &ASTNode = null;
            const extern_symbol: &Symbol = symbol_table_lookup(ctx.checker, expr.identifier_name);
            if extern_symbol != null {
                extern_var_decl = extern_symbol.decl_node;
            }
            if extern_var_decl != null && extern_var_decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
                const extern_type_ast: &ASTNode = exec_lower_global_type_ast(extern_var_decl);
                if extern_type_ast != null {
                    var extern_type: Type = type_from_ast(ctx.checker, extern_type_ast);
                    if exec_type_is_vm_value_supported(extern_type) != 0 {
                        return exec_lower_make_zero_expr(ctx, expr, &extern_type);
                    }
                }
            }
            // 宿主 libc 的 `errno`：C99 后端把标识符 `libc_errno` 直接映射成 C 的
            // `errno`（见 `src/codegen/c99/global.uya` 的全局标识符改名），解释器
            // 没有对应的宿主存储。这里按 0 处理，与上面 `extern var` 分支的
            // 「解释器无存储 → 零值」策略一致；用到它的代码都是「宿主调用刚失败、
            // 看是不是 EAGAIN」的错误路径。
            if str_equals(expr.identifier_name, "libc_errno" as *byte) != 0 {
                const errno_type_i32: Type = exec_lower_type_from_kind_code(TypeKind.TYPE_I32 as i32);
                return exec_lower_make_int_const_expr(ctx, expr, &errno_type_i32, 0);
            }
            var unknown_ident_msg: [byte: 192] = [];
            _ = snprintf(&unknown_ident_msg[0] as *byte, 192, "exec: 当前仅支持局部变量/参数/全局标识符(%s)" as *byte, expr.identifier_name as *byte);
            return exec_lower_fail_expr(expr, &unknown_ident_msg[0]);
        }
        return exec_lower_fail_expr(expr, "exec: 当前仅支持局部变量/参数/全局标识符" as *byte);
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        var enum_found: i32 = 0;
        const enum_value: i32 = exec_lower_try_enum_member_const(ctx, expr, &enum_found);
        if enum_found != 0 {
            return exec_lower_make_int_const_expr(ctx, expr, &expr_type, enum_value as i64);
        }
        // `Kind.Closed`：类型名 + 空载荷变体 当作联合体值构造（无实参版本）。
        const union_member_value: &HIRExpr = exec_lower_try_union_member_value(ctx, expr, &expr_type);
        if union_member_value != null {
            return union_member_value;
        }
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        if expr.cast_expr_is_force_cast != 0 {
            if expr.cast_expr_expr != null &&
                expr.cast_expr_expr.type == ASTNodeType.AST_SYSCALL &&
                expr_type.kind == TypeKind.TYPE_ERROR_UNION &&
                expr_type.error_union_payload_type != null {
                const syscall_payload_type: Type = expr_type.error_union_payload_type[0];
                if exec_type_is_vm_value_supported(syscall_payload_type) == 0 {
                    return exec_lower_fail_expr(expr, "exec: @syscall as! 目标类型当前不可被 exec VM 表示" as *byte);
                }
                if expr.cast_expr_expr.syscall_number == null {
                    return exec_lower_fail_expr(expr, "exec: @syscall 缺少系统调用号" as *byte);
                }
                const syscall_nr_expr: &HIRExpr = exec_lower_expr(ctx, expr.cast_expr_expr.syscall_number);
                if syscall_nr_expr == null {
                    return null;
                }
                const syscall_args_hir: & & HIRExpr = exec_lower_alloc_items(ctx, expr.cast_expr_expr.syscall_arg_count);
                if expr.cast_expr_expr.syscall_arg_count > 0 && syscall_args_hir == null {
                    exec_backend_set_error(expr, "exec: @syscall 参数分配失败" as *byte, 0);
                    return null;
                }
                var si: i32 = 0;
                while si < expr.cast_expr_expr.syscall_arg_count {
                    const lowered_arg: &HIRExpr = exec_lower_expr(ctx, expr.cast_expr_expr.syscall_args[si]);
                    if lowered_arg == null {
                        return null;
                    }
                    syscall_args_hir[si] = lowered_arg;
                    si = si + 1;
                }
                const hir_syscall_cast: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_SYSCALL, &expr_type);
                if hir_syscall_cast == null {
                    return null;
                }
                hir_syscall_cast.left = syscall_nr_expr;
                hir_syscall_cast.items = syscall_args_hir;
                hir_syscall_cast.item_count = expr.cast_expr_expr.syscall_arg_count;
                hir_syscall_cast.int_value = syscall_payload_type.kind as i64;
                hir_syscall_cast.unary_op = exec_lower_pointer_pointee_kind(&syscall_payload_type);
                return hir_syscall_cast;
            }
            if expr_type.kind != TypeKind.TYPE_ERROR_UNION || expr_type.error_union_payload_type == null {
                return exec_lower_fail_expr_reason(expr, "exec: as! 目标类型无效" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_GENERIC);
            }
            const force_payload_type: Type = expr_type.error_union_payload_type[0];
            if exec_type_is_vm_value_supported(force_payload_type) == 0 {
                return exec_lower_fail_expr(expr, "exec: as! 载荷类型当前不可被 exec VM 表示" as *byte);
            }
            const force_payload_operand: &HIRExpr = exec_lower_coerce_expr(ctx, expr.cast_expr_expr, &force_payload_type);
            if force_payload_operand == null {
                return null;
            }
            // as! 是数值/指针转换，必须真正发射 cast：直接复用操作数会让 f64 的位模式
            // 被当成目标整数读取（例如 3.14 as! i32 得到 1374389535）。
            const force_payload_expr: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CAST, &force_payload_type);
            if force_payload_expr == null {
                return null;
            }
            force_payload_expr.left = force_payload_operand;
            const hir_force_ok: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_MAKE_OK, &expr_type);
            if hir_force_ok == null {
                return null;
            }
            hir_force_ok.left = force_payload_expr;
            return hir_force_ok;
        }
        if exec_type_is_vm_value_supported(expr_type) == 0 {
            return exec_lower_fail_expr(expr, "exec: cast 目标类型当前不可被 exec VM 表示" as *byte);
        }
        // `"..." as &[byte]`：字符串字面量要补上长度，否则拿到的是个裸指针。
        if expr_type.kind == TypeKind.TYPE_SLICE && expr.cast_expr_expr != null &&
            expr.cast_expr_expr.type == ASTNodeType.AST_STRING &&
            expr.cast_expr_expr.string_literal_value != null {
            const slice_from_string: &HIRExpr = exec_lower_string_as_slice(ctx, expr, &expr_type);
            if slice_from_string != null {
                return slice_from_string;
            }
        }
        // 字面量直接按目标整数类型取值：否则大字面量会先被当成 i32 截断
        // （`3000000000 as i64` 会得到 1705032704，与 C99 后端不一致）。
        if expr.cast_expr_expr != null && is_integer_type(expr_type.kind) != 0 {
            if expr.cast_expr_expr.type == ASTNodeType.AST_NUMBER {
                return exec_lower_make_int_const_expr(ctx, expr, &expr_type, expr.cast_expr_expr.number_value_i64);
            }
            if expr.cast_expr_expr.type == ASTNodeType.AST_CHAR {
                return exec_lower_make_int_const_expr(ctx, expr, &expr_type, expr.cast_expr_expr.char_literal_value as i64);
            }
        }
        const cast_operand: &HIRExpr = exec_lower_expr(ctx, expr.cast_expr_expr);
        if cast_operand == null {
            return null;
        }
        const hir_cast: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CAST, &expr_type);
        if hir_cast == null {
            return null;
        }
        hir_cast.left = cast_operand;
        return hir_cast;
    }
    if expr.type == ASTNodeType.AST_PTR_FROM_USIZE {
        const ptr_operand: &HIRExpr = exec_lower_expr(ctx, expr.ptr_from_usize_value);
        if ptr_operand == null {
            return null;
        }
        const hir_ptr: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CAST, &expr_type);
        if hir_ptr == null {
            return null;
        }
        hir_ptr.left = ptr_operand;
        return hir_ptr;
    }
    if expr.type == ASTNodeType.AST_USIZE_FROM_PTR {
        const usize_operand: &HIRExpr = exec_lower_expr(ctx, expr.usize_from_ptr_ptr);
        if usize_operand == null {
            return null;
        }
        const hir_usize: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CAST, &expr_type);
        if hir_usize == null {
            return null;
        }
        hir_usize.left = usize_operand;
        return hir_usize;
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        if (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND {
            // `&f`（f 是函数）：解释器里没有可执行地址，给个非零占位指针即可，
            // 语义上只用于「取到函数地址」这类可达性/注册场景。
            const fn_addr_expr: &HIRExpr = exec_lower_make_fn_addr_expr(ctx, expr, expr.unary_expr_operand);
            if fn_addr_expr != null {
                return fn_addr_expr;
            }
            return exec_lower_make_ref_expr(ctx, expr.unary_expr_operand);
        }
        if (expr.unary_expr_op as TokenType) == TokenType.TOKEN_ASTERISK {
            const base_expr: &HIRExpr = exec_lower_expr(ctx, expr.unary_expr_operand);
            const zero_index_type: Type = make_i32_type();
            const zero_index_expr: &HIRExpr = exec_lower_make_int_const_expr(ctx, expr, &zero_index_type, 0);
            if base_expr == null || zero_index_expr == null {
                return null;
            }
            const deref_expr: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_INDEX, &expr_type);
            if deref_expr == null {
                return null;
            }
            deref_expr.left = base_expr;
            deref_expr.right = zero_index_expr;
            // `*p` 的元素字节数：原生指针（`&EpollEvent`、`&FILE`）解引用时 VM 靠它
            // 才知道 C 布局步长，否则会退化成旁路表槽位引用，字段访问拿不到原生基址。
            deref_expr.int_value = exec_lower_size_align_of_type(ctx, copy_type(&expr_type), 1) as i64;
            return deref_expr;
        }
        if exec_type_is_scalar_supported(expr_type) == 0 {
            if exec_type_uses_simd(expr_type) != 0 {
                return exec_lower_fail_expr_reason(expr, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
            }
            return exec_lower_fail_expr(expr, "exec: 不支持的 unary 结果类型" as *byte);
        }
        const operand: &HIRExpr = exec_lower_expr(ctx, expr.unary_expr_operand);
        if operand == null {
            return null;
        }
        const hir: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_UNARY, &expr_type);
        if hir == null {
            return null;
        }
        hir.unary_op = expr.unary_expr_op;
        hir.left = operand;
        return hir;
    }
    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        if exec_type_is_scalar_supported(expr_type) == 0 &&
            expr_type.kind != TypeKind.TYPE_BOOL {
            if exec_type_uses_simd(expr_type) != 0 {
                return exec_lower_fail_expr_reason(expr, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
            }
            return exec_lower_fail_expr(expr, "exec: 不支持的 binary 结果类型" as *byte);
        }
        const left: &HIRExpr = exec_lower_expr(ctx, expr.binary_expr_left);
        if left == null {
            return null;
        }
        const right: &HIRExpr = exec_lower_expr(ctx, expr.binary_expr_right);
        if right == null {
            return null;
        }
        const hir: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_BINARY, &expr_type);
        if hir == null {
            return null;
        }
        hir.binary_op = expr.binary_expr_op;
        hir.left = left;
        hir.right = right;
        return hir;
    }
    if expr.type == ASTNodeType.AST_CALL_EXPR {
        const union_ctor: &HIRExpr = exec_lower_try_union_ctor_expr(ctx, expr, &expr_type);
        if union_ctor != null {
            return union_ctor;
        }
        // `@vector.<op>(...)`：解析器把它建成 `@vector` 标识符的成员调用，
        // 这里直接降成向量内建节点，交给 VM 的 BC_VECTOR_OP 执行。
        if expr.call_expr_callee != null && expr.call_expr_callee.type == ASTNodeType.AST_MEMBER_ACCESS &&
            expr.call_expr_callee.member_access_object != null &&
            expr.call_expr_callee.member_access_object.type == ASTNodeType.AST_IDENTIFIER &&
            expr.call_expr_callee.member_access_object.identifier_name != null &&
            str_equals(expr.call_expr_callee.member_access_object.identifier_name, "@vector" as &byte) != 0 &&
            expr.call_expr_callee.member_access_field_name != null {
            var vec_args: & & HIRExpr = null;
            if expr.call_expr_arg_count > 0 {
                vec_args = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * expr.call_expr_arg_count as usize) as & & HIRExpr;
                if vec_args == null {
                    exec_backend_set_error(expr, "exec: @vector 参数分配失败" as *byte, 0);
                    return null;
                }
            }
            var vai: i32 = 0;
            while vai < expr.call_expr_arg_count {
                const lowered_varg: &HIRExpr = exec_lower_expr(ctx, expr.call_expr_args[vai]);
                if lowered_varg == null {
                    return null;
                }
                vec_args[vai] = lowered_varg;
                vai = vai + 1;
            }
            // 未绑定的 `@vector.splat(...)` 自身没有具体类型，checker 会把目标向量类型
            // 记在 simd_splat_target_type 上（`a + @vector.splat(1)` 这类上下文）。
            var vec_result_type: Type = copy_type(&expr_type);
            if (vec_result_type.kind != TypeKind.TYPE_VECTOR && vec_result_type.kind != TypeKind.TYPE_MASK) &&
                expr.simd_splat_target_type != null {
                vec_result_type = type_from_ast(ctx.checker, expr.simd_splat_target_type);
            }
            const hir_vec: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_VECTOR_OP, &vec_result_type);
            if hir_vec == null {
                return null;
            }
            hir_vec.callee_name = expr.call_expr_callee.member_access_field_name;
            hir_vec.call_args = vec_args;
            hir_vec.call_arg_count = expr.call_expr_arg_count;
            return hir_vec;
        }
        if expr.call_expr_has_ellipsis_forward != 0 {
            return exec_lower_fail_expr(expr, "exec: 当前不支持 varargs 转发" as *byte);
        }
        _ = exec_lower_rewrite_module_qualified_callee(ctx, expr);
        if expr.call_expr_type_arg_count > 0 &&
            expr.call_expr_callee != null && expr.call_expr_callee.type == ASTNodeType.AST_IDENTIFIER {
            const generic_call: &HIRExpr = exec_lower_generic_call_expr(ctx, expr, &expr_type);
            if generic_call != null {
                return generic_call;
            }
            return exec_lower_fail_expr(expr, "exec: 当前不支持这个泛型调用" as *byte);
        }
        if expr.call_expr_arg_count > EXEC_MAX_CALL_ARGS {
            return exec_lower_fail_expr(expr, "exec: 调用参数过多" as *byte);
        }
        if exec_type_is_vm_value_supported(expr_type) == 0 {
            if exec_type_uses_simd(expr_type) != 0 {
                return exec_lower_fail_expr_reason(expr, "exec: 当前不支持 SIMD" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_SIMD);
            }
            return exec_lower_fail_expr(expr, "exec: 当前仅支持标量/错误联合函数返回值" as *byte);
        }
        if expr.call_expr_callee != null && expr.call_expr_callee.type == ASTNodeType.AST_MEMBER_ACCESS &&
            expr.call_expr_callee.member_access_object != null &&
            expr.call_expr_callee.member_access_field_name != null {
            const object_ast: &ASTNode = expr.call_expr_callee.member_access_object;
            const method_name: &byte = expr.call_expr_callee.member_access_field_name;
            const owner_type: Type = exec_lower_member_base_type(ctx, object_ast);
            if method_name != null && str_equals(method_name, "get" as &byte) != 0 {
            }
            // 静态方法调用 `TypeName.method(...)`：接收者是类型名而不是值，
            // 上面的类型推断会得到 void，这里按类型名找关联的静态方法当普通函数调用。
            if owner_type.kind == TypeKind.TYPE_VOID &&
                ((object_ast.type == ASTNodeType.AST_IDENTIFIER && object_ast.identifier_name != null) ||
                 (object_ast.type == ASTNodeType.AST_TYPE_NAMED && object_ast.type_named_name != null)) {
                var owner_name: &byte = object_ast.identifier_name;
                if object_ast.type == ASTNodeType.AST_TYPE_NAMED {
                    owner_name = object_ast.type_named_name;
                }
                const alias_decl: &ASTNode = find_type_alias_from_program(ctx.checker.program_node, owner_name);
                if alias_decl != null && alias_decl.type_alias_target_type != null &&
                    alias_decl.type_alias_target_type.type == ASTNodeType.AST_TYPE_NAMED &&
                    alias_decl.type_alias_target_type.type_named_name != null {
                    owner_name = alias_decl.type_alias_target_type.type_named_name;
                }
                var static_decl: &ASTNode = null;
                if find_struct_decl_from_program(ctx.checker.program_node, owner_name) != null {
                    static_decl = find_static_method_in_struct(ctx.checker.program_node, owner_name, method_name);
                } else if find_union_decl_from_program(ctx.checker.program_node, owner_name) != null {
                    static_decl = find_static_method_in_union(ctx.checker.program_node, owner_name, method_name);
                }
                // `Type.method(recv, ...)`：把实例方法当普通函数调用（接收者显式传参）。
                if static_decl == null {
                    if find_struct_decl_from_program(ctx.checker.program_node, owner_name) != null {
                        static_decl = find_instance_method_in_struct(ctx.checker.program_node, owner_name, method_name);
                    } else if find_union_decl_from_program(ctx.checker.program_node, owner_name) != null {
                        static_decl = find_instance_method_in_union(ctx.checker.program_node, owner_name, method_name);
                    }
                }
                if static_decl != null {
                    const static_owner_type: Type = exec_lower_static_receiver_type(ctx, expr);
                    const static_specialized: &ASTNode = exec_lower_specialize_struct_method(
                        ctx, static_decl, static_owner_type.struct_name, &static_owner_type);
                    if static_specialized != null && static_specialized != static_decl {
                        static_decl = static_specialized;
                    }
                    const generic_static_name: &byte = exec_lower_begin_generic_method(ctx, expr, static_decl);
                    const static_args: & & HIRExpr = null;
                    var static_args_mut: & & HIRExpr = static_args;
                    if expr.call_expr_arg_count > 0 {
                        static_args_mut = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * expr.call_expr_arg_count as usize) as & & HIRExpr;
                        if static_args_mut == null {
                            exec_backend_set_error(expr, "exec: 静态方法调用参数分配失败" as *byte, 0);
                            return null;
                        }
                    }
                    var sai: i32 = 0;
                    while sai < expr.call_expr_arg_count {
                        var lowered_sarg: &HIRExpr = null;
                        if static_decl.fn_decl_params != null && sai < static_decl.fn_decl_param_count &&
                            static_decl.fn_decl_params[sai] != null &&
                            static_decl.fn_decl_params[sai].type == ASTNodeType.AST_VAR_DECL &&
                            static_decl.fn_decl_params[sai].var_decl_type != null {
                            const expected_sarg: Type = type_from_ast(ctx.checker, static_decl.fn_decl_params[sai].var_decl_type);
                            lowered_sarg = exec_lower_coerce_expr(ctx, expr.call_expr_args[sai], &expected_sarg);
                        } else {
                            lowered_sarg = exec_lower_expr(ctx, expr.call_expr_args[sai]);
                        }
                        if lowered_sarg == null {
                            return null;
                        }
                        static_args_mut[sai] = lowered_sarg;
                        sai = sai + 1;
                    }
                    const static_call: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CALL, &expr_type);
                    if static_call == null {
                        return null;
                    }
                    if generic_static_name != null {
                        ctx.checker.subst_active = 0;
                        ctx.checker.subst_name = null;
                    }
                    static_call.callee_name = static_decl.fn_decl_name;
                    if generic_static_name != null {
                        static_call.callee_name = generic_static_name;
                    }
                    static_call.callee_decl = static_decl;
                    static_call.call_host_id = ExecHostCallId.EXEC_HOST_CALL_NONE;
                    static_call.call_args = static_args_mut;
                    static_call.call_arg_count = expr.call_expr_arg_count;
                    return static_call;
                }
            }
            if owner_type.kind == TypeKind.TYPE_INTERFACE && owner_type.interface_name != null {
                const method_sig: &ASTNode = find_interface_method_sig(ctx.checker.program_node, owner_type.interface_name, method_name);
                const method_index: i32 = exec_lower_interface_method_index(ctx, &owner_type, method_name);
                if method_sig == null || method_index < 0 {
                    return exec_lower_fail_expr(expr, "exec: 无法解析 interface 方法调用" as *byte);
                }
                if expr.call_expr_arg_count + 1 > EXEC_MAX_CALL_ARGS {
                    return exec_lower_fail_expr(expr, "exec: interface 方法调用参数过多" as *byte);
                }
                const args_iface: & & HIRExpr = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * expr.call_expr_arg_count as usize) as & & HIRExpr;
                if expr.call_expr_arg_count > 0 && args_iface == null {
                    exec_backend_set_error(expr, "exec: interface 调用参数分配失败" as *byte, 0);
                    return null;
                }
                var ia: i32 = 0;
                while ia < expr.call_expr_arg_count {
                    var lowered_arg_iface: &HIRExpr = null;
                    if method_sig.fn_decl_params != null && ia + 1 < method_sig.fn_decl_param_count &&
                        method_sig.fn_decl_params[ia + 1] != null &&
                        method_sig.fn_decl_params[ia + 1].type == ASTNodeType.AST_VAR_DECL &&
                        method_sig.fn_decl_params[ia + 1].var_decl_type != null {
                        const expected_iface: Type = type_from_ast(ctx.checker, method_sig.fn_decl_params[ia + 1].var_decl_type);
                        lowered_arg_iface = exec_lower_coerce_expr(ctx, expr.call_expr_args[ia], &expected_iface);
                    } else {
                        lowered_arg_iface = exec_lower_expr(ctx, expr.call_expr_args[ia]);
                    }
                    if lowered_arg_iface == null {
                        return null;
                    }
                    args_iface[ia] = lowered_arg_iface;
                    ia = ia + 1;
                }
                const object_expr: &HIRExpr = exec_lower_expr(ctx, object_ast);
                if object_expr == null {
                    return null;
                }
                var iface_method_sigs: [&ASTNode: EXEC_MAX_INTERFACE_METHODS] = [];
                var iface_method_count: i32 = 0;
                if exec_lower_collect_interface_method_sigs(ctx, &owner_type, &iface_method_sigs[0] as & & ASTNode, &iface_method_count) != 0 {
                    return exec_lower_fail_expr(expr, "exec: interface 方法表索引计算失败" as *byte);
                }
                const iface_call: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_IMETHOD_CALL, &expr_type);
                if iface_call == null {
                    return null;
                }
                iface_call.left = object_expr;
                iface_call.int_value = method_index as i64;
                iface_call.callee_name = method_name;
                iface_call.call_args = args_iface;
                iface_call.call_arg_count = expr.call_expr_arg_count;
                iface_call.callee_decl = method_sig;
                iface_call.dispatch_decl_count = iface_method_count;
                return iface_call;
            }
            var method_decl: &ASTNode = null;
            if owner_type.kind == TypeKind.TYPE_STRUCT && owner_type.struct_name != null {
                method_decl = find_instance_method_in_struct(ctx.checker.program_node, owner_type.struct_name, method_name);
            } else if owner_type.kind == TypeKind.TYPE_UNION && owner_type.union_name != null {
                method_decl = find_instance_method_in_union(ctx.checker.program_node, owner_type.union_name, method_name);
            }
            if method_decl != null {
                // 泛型结构体实例上的方法：换成该实例的单态副本（`@size_of(T)` 一类
                // 需要具体类型才能折叠）。
                const specialized_decl: &ASTNode = exec_lower_specialize_struct_method(
                    ctx, method_decl, owner_type.struct_name, &owner_type);
                if specialized_decl != null && specialized_decl != method_decl {
                    method_decl = specialized_decl;
                }
                var call_return_type: Type = copy_type(&expr_type);
                const mono_return_type: Type = exec_lower_resolve_mono_method_type(ctx, method_decl, &owner_type);
                if mono_return_type.kind != TypeKind.TYPE_VOID {
                    call_return_type = mono_return_type;
                }
                const generic_method_name: &byte = exec_lower_begin_generic_method(ctx, expr, method_decl);
                const total_arg_count: i32 = expr.call_expr_arg_count + 1;
                if total_arg_count > EXEC_MAX_CALL_ARGS {
                    return exec_lower_fail_expr(expr, "exec: 方法调用参数过多" as *byte);
                }
                const args_method: & & HIRExpr = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * total_arg_count as usize) as & & HIRExpr;
                if total_arg_count > 0 && args_method == null {
                    exec_backend_set_error(expr, "exec: 方法调用参数分配失败" as *byte, 0);
                    return null;
                }
                const receiver_arg: &HIRExpr = exec_lower_method_receiver_expr(ctx, object_ast, method_decl);
                if receiver_arg == null {
                    return exec_lower_fail_expr(expr, "exec: 当前无法为方法 receiver 构造引用" as *byte);
                }
                args_method[0] = receiver_arg;
                var ma: i32 = 0;
                while ma < expr.call_expr_arg_count {
                    var lowered_arg_method: &HIRExpr = null;
                    if method_decl.fn_decl_params != null && ma + 1 < method_decl.fn_decl_param_count &&
                        method_decl.fn_decl_params[ma + 1] != null &&
                        method_decl.fn_decl_params[ma + 1].type == ASTNodeType.AST_VAR_DECL &&
                        method_decl.fn_decl_params[ma + 1].var_decl_type != null {
                        const expected_method: Type = type_from_ast(ctx.checker, method_decl.fn_decl_params[ma + 1].var_decl_type);
                        lowered_arg_method = exec_lower_coerce_expr(ctx, expr.call_expr_args[ma], &expected_method);
                    } else {
                        lowered_arg_method = exec_lower_expr(ctx, expr.call_expr_args[ma]);
                    }
                    if lowered_arg_method == null {
                        return null;
                    }
                    args_method[ma + 1] = lowered_arg_method;
                    ma = ma + 1;
                }
                if generic_method_name != null {
                    ctx.checker.subst_active = 0;
                    ctx.checker.subst_name = null;
                }
                const call_method: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CALL, &call_return_type);
                if call_method == null {
                    return null;
                }
                call_method.callee_name = method_decl.fn_decl_name;
                if generic_method_name != null {
                    call_method.callee_name = generic_method_name;
                }
                call_method.callee_decl = method_decl;
                call_method.call_host_id = ExecHostCallId.EXEC_HOST_CALL_NONE;
                call_method.call_args = args_method;
                call_method.call_arg_count = total_arg_count;
                return call_method;
            }
            // `@frame(fn)` 的合成帧在 VM 里已经同步执行完：`stop()` 这类帧控制方法
            // 没有 AST 声明，按空操作处理（返回 void 零值）。
            if owner_type.kind == TypeKind.TYPE_STRUCT && owner_type.struct_name != null &&
                exec_lower_name_has_prefix(owner_type.struct_name, "uya_async_" as &byte) != 0 {
                const frame_noop_type: Type = make_void_type();
                return exec_lower_make_zero_expr(ctx, expr, &frame_noop_type);
            }
            var method_msg: [byte: 224] = [];
            _ = snprintf(&method_msg[0] as *byte, 224, "exec: 无法解析成员方法调用(kind=%d name=%s obj=%s)" as *byte,
                owner_type.kind as i32, method_name as *byte,
                object_ast.identifier_name as *byte);
            return exec_lower_fail_expr(expr, &method_msg[0]);
        }
        if expr.call_expr_callee == null || expr.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER {
            return exec_lower_fail_expr(expr, "exec: 当前仅支持直接函数调用" as *byte);
        }
        const callee_decl: &ASTNode = exec_lower_resolve_function_decl_from_file(ctx.checker, expr.filename, expr.call_expr_callee.identifier_name);
        // `use std.mem.memcpy;` 一类「名字来自 C 头文件」的隐式 libc 调用没有 Uya
        // 声明节点，但 VM 对 memcpy/memset/strlen 这些有原生实现，按名字直接接上。
        if callee_decl == null && expr.call_expr_callee.identifier_name != null {
            const named_host_call: ExecHostCallId = exec_lower_match_host_call_name(
                expr.call_expr_callee.identifier_name, expr.call_expr_arg_count, expr.call_expr_arg_count);
            if named_host_call != ExecHostCallId.EXEC_HOST_CALL_NONE {
                const named_args: & & HIRExpr = exec_lower_alloc_items(ctx, expr.call_expr_arg_count);
                if expr.call_expr_arg_count > 0 && named_args == null {
                    exec_backend_set_error(expr, "exec: 调用参数分配失败" as *byte, 0);
                    return null;
                }
                var nai: i32 = 0;
                while nai < expr.call_expr_arg_count {
                    const lowered_named_arg: &HIRExpr = exec_lower_expr(ctx, expr.call_expr_args[nai]);
                    if lowered_named_arg == null {
                        return null;
                    }
                    named_args[nai] = lowered_named_arg;
                    nai = nai + 1;
                }
                const named_call: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CALL, &expr_type);
                if named_call == null {
                    return null;
                }
                named_call.callee_name = expr.call_expr_callee.identifier_name;
                named_call.call_host_id = named_host_call;
                named_call.call_args = named_args;
                named_call.call_arg_count = expr.call_expr_arg_count;
                return named_call;
            }
        }
        // 编译器合成宿主符号：exec 侧没有 native worker 入口，语义与 C99 代码生成器
        // 内联的常量一致（entry.uya 用 `>= 0` 判断是否已被 worker 接管）。
        if callee_decl != null && callee_decl.type == ASTNodeType.AST_FN_DECL &&
            callee_decl.fn_decl_is_extern != 0 && expr.call_expr_arg_count == 0 &&
            callee_decl.fn_decl_name != null &&
            str_equals(callee_decl.fn_decl_name, "uya_pipeline_worker_dispatch" as &byte) != 0 {
            const worker_type: Type = make_i32_type();
            return exec_lower_make_int_const_expr(ctx, expr, &worker_type, -1 as i64);
        }
        var host_call_id: ExecHostCallId = ExecHostCallId.EXEC_HOST_CALL_NONE;
        // `setjmp`/`sigsetjmp` 是 `@naked_fn`（内联汇编保存寄存器现场），不是 extern，
        // 但解释器同样没有寄存器/栈现场可用，按宿主实现处理。
        var naked_host_call: i32 = 0;
        if callee_decl != null && callee_decl.type == ASTNodeType.AST_FN_DECL &&
            callee_decl.fn_decl_name != null &&
            (str_equals(callee_decl.fn_decl_name, "setjmp" as *byte) != 0 ||
             str_equals(callee_decl.fn_decl_name, "_setjmp" as *byte) != 0 ||
             str_equals(callee_decl.fn_decl_name, "sigsetjmp" as *byte) != 0) {
            naked_host_call = 1;
        }
        if callee_decl != null &&
            callee_decl.type == ASTNodeType.AST_FN_DECL &&
            (callee_decl.fn_decl_is_extern != 0 || naked_host_call != 0) {
            var extern_can_run: i32 = exec_lower_extern_can_run_in_vm(ctx.checker, callee_decl);
            if naked_host_call != 0 {
                extern_can_run = 0;
            }
            var matched_host_call: ExecHostCallId =
                exec_lower_match_host_call(callee_decl, expr.call_expr_arg_count);
            if naked_host_call != 0 {
                matched_host_call = exec_lower_match_host_call_name(callee_decl.fn_decl_name,
                    callee_decl.fn_decl_param_count, expr.call_expr_arg_count);
            }
            if extern_can_run == 0 || exec_lower_host_call_overrides_body(callee_decl, matched_host_call) != 0 {
                host_call_id = matched_host_call;
            }
            if host_call_id == ExecHostCallId.EXEC_HOST_CALL_NONE &&
                extern_can_run == 0 {
                // varargs 且没有 body、也不在宿主桥登记表里：语义无法等价，
                // 必须稳定拒绝（`tests/verify_exec_vm_extern_bridge.sh` 盯着
                // 「原因码 extern_abi + 当前不支持 extern ABI」这条消息）。
                if callee_decl.fn_decl_is_varargs != 0 {
                    var extern_varargs_msg: [byte: 160] = [];
                    if callee_decl.fn_decl_name != null {
                        _ = snprintf(&extern_varargs_msg[0] as *byte, 160,
                            "exec: 当前不支持 extern ABI: %s/%d" as *byte,
                            callee_decl.fn_decl_name as *byte, callee_decl.fn_decl_param_count);
                        return exec_lower_fail_expr_reason(expr, &extern_varargs_msg[0], ExecUnsupportedReason.EXEC_UNSUPPORTED_EXTERN_ABI);
                    }
                    return exec_lower_fail_expr_reason(expr, "exec: 当前不支持 extern ABI" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_EXTERN_ABI);
                }
                // 固定参数的环境调用（`sigaction`/`tcgetpgrp` 一类）：按
                // 「无副作用 + 返回零值」的桩处理。硬失败会让整程序编译不过，
                // 而这些调用在解释器里本来也无法真做。
                return exec_lower_make_zero_expr(ctx, expr, &expr_type);
            }
        }
        const args: & & HIRExpr = compiler_arena_alloc(ctx.arena, @size_of(&HIRExpr) * expr.call_expr_arg_count as usize) as & & HIRExpr;
        if expr.call_expr_arg_count > 0 && args == null {
            exec_backend_set_error(expr, "exec: 调用参数分配失败" as *byte, 0);
            return null;
        }
        var i: i32 = 0;
        while i < expr.call_expr_arg_count {
            var arg_expr: &HIRExpr = null;
            if callee_decl != null && callee_decl.type == ASTNodeType.AST_FN_DECL &&
                callee_decl.fn_decl_params != null && i < callee_decl.fn_decl_param_count &&
                callee_decl.fn_decl_params[i] != null &&
                callee_decl.fn_decl_params[i].type == ASTNodeType.AST_VAR_DECL &&
                callee_decl.fn_decl_params[i].var_decl_type != null {
