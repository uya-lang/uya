        // `LOAD_FIELD 字段越界(idx=1 kind=14 pointee=16)`。
        var native_layout_type: Type = copy_type(&base_type);
        if native_layout_type.kind == TypeKind.TYPE_POINTER && native_layout_type.pointer_to != null {
            native_layout_type = copy_type(&native_layout_type.pointer_to[0]);
        }
        if native_layout_type.kind == TypeKind.TYPE_STRUCT {
            _ = exec_lower_native_field_layout(ctx, native_layout_type, field_index,
                &native_offset, &native_kind, &native_pointee, &native_count);
        }
        const hir_field: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_FIELD, &expr_type);
        if hir_field == null {
            return null;
        }
        hir_field.left = base_expr;
        hir_field.int_value = field_index as i64;
        hir_field.unary_op = native_offset;
        hir_field.binary_op = native_kind | (native_pointee << 8);
        hir_field.bool_value = native_count;
        return hir_field;
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        const base_expr2: &HIRExpr = exec_lower_expr(ctx, expr.array_access_array);
        const index_expr: &HIRExpr = exec_lower_expr(ctx, expr.array_access_index);
        if base_expr2 == null || index_expr == null {
            return null;
        }
        const hir_index: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_INDEX, &expr_type);
        if hir_index == null {
            return null;
        }
        hir_index.left = base_expr2;
        hir_index.right = index_expr;
        // 元素字节数：原生指针（`&EpollEvent`、`&FILE` 这类）做下标时，
        // VM 拿不到 C 布局步长（`exec_vm_type_kind_size(STRUCT) == 0`），
        // 只能由编译期把元素尺寸带过去。
        //
        // 这里的元素类型要**从基表达式自己的类型推**，不能直接用 checker 给的
        // `expr_type`：`q.slots[i]` 在单态化体里会被推断成声明形态
        // （`TaskQueueSlot<T>`，实参还是 `T`），`@size_of` 折叠不出尺寸，
        // 步长就退化成 0，按下标访问原生数组全部错位
        // （`test_async_task_queue_dynamic_growth` 的调度循环因此永远读不到
        // active，空转到超时）。
        var elem_type_probe: Type = exec_lower_resolve_exact_type(ctx, expr.array_access_array);
        if elem_type_probe.kind == TypeKind.TYPE_POINTER && elem_type_probe.pointer_to != null {
            elem_type_probe = copy_type(&elem_type_probe.pointer_to[0]);
        } else if elem_type_probe.kind == TypeKind.TYPE_ARRAY && elem_type_probe.element_type != null {
            elem_type_probe = copy_type(&elem_type_probe.element_type[0]);
        } else if elem_type_probe.kind == TypeKind.TYPE_SLICE && elem_type_probe.slice_element_type != null {
            elem_type_probe = copy_type(&elem_type_probe.slice_element_type[0]);
        } else {
            elem_type_probe = make_void_type();
        }
        var index_elem_type: Type = copy_type(&expr_type);
        if elem_type_probe.kind != TypeKind.TYPE_VOID {
            index_elem_type = elem_type_probe;
        }
        hir_index.int_value = exec_lower_size_align_of_type(ctx, index_elem_type, 1) as i64;
        return hir_index;
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        const base_expr3: &HIRExpr = exec_lower_expr(ctx, expr.slice_expr_base);
        const start_expr: &HIRExpr = exec_lower_expr(ctx, expr.slice_expr_start_expr);
        const len_expr: &HIRExpr = exec_lower_expr(ctx, expr.slice_expr_len_expr);
        if base_expr3 == null || start_expr == null || len_expr == null {
            return null;
        }
        const hir_slice: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_SLICE, &expr_type);
        if hir_slice == null {
            return null;
        }
        hir_slice.left = base_expr3;
        hir_slice.right = start_expr;
        hir_slice.extra = len_expr;
        return hir_slice;
    }
    if expr.type == ASTNodeType.AST_EMBED_DIR {
        // `@embed_dir("dir")`：检查阶段已经把所有条目的相对路径、内容、长度
        // 分别读进 `embed_dir_paths` / `embed_dir_data` / `embed_dir_sizes`，
        // 条目数在 `embed_dir_entry_count`。VM 里直接拼成 `&[EmbedDirEntry]`
        // 常量（每个条目是 `{ path: &[const byte], data: &[const byte] }`）。
        if expr.embed_dir_paths == null && ctx.checker != null {
            _ = checker_infer_type(ctx.checker, expr);
        }
        if expr.embed_dir_paths == null {
            return exec_lower_fail_expr_reason(expr, "exec: @embed_dir 未解析出目录内容" as *byte,
                ExecUnsupportedReason.EXEC_UNSUPPORTED_GENERIC);
        }
        var dir_type: Type = copy_type(&expr_type);
        const hir_dir: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_EMBED_DIR, &dir_type);
        if hir_dir == null {
            return null;
        }
        return hir_dir;
    }
    if expr.type == ASTNodeType.AST_EMBED {
        // `@embed("path")` 在编译期把文件内容读进 `expr.embed_data`（长度
        // `expr.embed_size`）。VM 里把它当成一块原生字节数组常量再包成
        // `&[const byte]` 切片。内容可能含 NUL，所以不能走 `string_value`
        // 那条「NUL 结尾」的路径（`exec_make_string` 会按 strlen 截断）：
        // 这里用 `string_value` 存指针、`int_value` 存字节数、`bool_value`
        // 标记「按长度构造的二进制切片」，由 builder 侧负责分配与拷贝。
        if expr.embed_data == null && ctx.checker != null {
            // 检查阶段可能还没解析（例如宏展开体里的 embed）：就地补一次。
            _ = checker_infer_type(ctx.checker, expr);
        }
        if expr.embed_data == null {
            return exec_lower_fail_expr_reason(expr, "exec: @embed 未解析出文件内容" as *byte,
                ExecUnsupportedReason.EXEC_UNSUPPORTED_GENERIC);
        }
        var embed_elem: Type = make_u8_type();
        var embed_type: Type = copy_type(&expr_type);
        if embed_type.kind != TypeKind.TYPE_SLICE {
            embed_type = make_slice_type(ctx.arena, &embed_elem);
        } else if embed_type.slice_element_type != null {
            embed_elem = copy_type(&embed_type.slice_element_type[0]);
        }
        const hir_embed: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CONST, &embed_type);
        if hir_embed == null {
            return null;
        }
        hir_embed.string_value = expr.embed_data;
        hir_embed.int_value = expr.embed_size as i64;
        hir_embed.bool_value = 1;
        return hir_embed;
    }
    if expr.type == ASTNodeType.AST_PRINT || expr.type == ASTNodeType.AST_PRINTLN {
        const inner: &HIRExpr = exec_lower_expr(ctx, expr.print_expr);
        if inner == null {
            return null;
        }
        const hir: &HIRExpr = exec_lower_alloc_expr(ctx, expr,
            HIRExprKind.HIR_EXPR_PRINT,
            &expr_type);
        if hir == null {
            return null;
        }
        if expr.type == ASTNodeType.AST_PRINTLN {
            hir.kind = HIRExprKind.HIR_EXPR_PRINTLN;
        }
        hir.left = inner;
        return hir;
    }
    if expr.type == ASTNodeType.AST_ERROR_ID {
        const operand_literal: &ASTNode = exec_lower_named_error_literal(expr.error_id_operand);
        if operand_literal != null {
            const literal_type: Type = exec_lower_expr_type(ctx, operand_literal);
            return exec_lower_make_int_const_expr(ctx, expr, &expr_type, literal_type.error_error_id as i64);
        }
        const operand_error_id: &HIRExpr = exec_lower_expr(ctx, expr.error_id_operand);
        if operand_error_id == null {
            return null;
        }
        const hir_error_id: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_ERROR_ID, &expr_type);
        if hir_error_id == null {
            return null;
        }
        hir_error_id.left = operand_error_id;
        return hir_error_id;
    }
    if expr.type == ASTNodeType.AST_ERROR_NAME {
        const operand_name_literal: &ASTNode = exec_lower_named_error_literal(expr.error_name_operand);
        if operand_name_literal != null {
            return exec_lower_make_string_const_expr(ctx, expr, &expr_type, operand_name_literal.error_value_name);
        }
        const operand_error_name: &HIRExpr = exec_lower_expr(ctx, expr.error_name_operand);
        if operand_error_name == null {
            return null;
        }
        const hir_error_name: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_ERROR_NAME, &expr_type);
        if hir_error_name == null {
            return null;
        }
        hir_error_name.left = operand_error_name;
        return hir_error_name;
    }
    if expr.type == ASTNodeType.AST_TRY_EXPR {
        if expr.try_expr_is_checked_arith != 0 {
            // checked 整数算术：`try (a + b)` 溢出/除零时把错误联合原样返回。
            var try_payload2: Type = exec_lower_type_from_kind_code(expr.try_expr_checked_kind);
            if try_payload2.kind == TypeKind.TYPE_VOID {
                try_payload2 = copy_type(&expr_type);
            }
            const hir_checked_try2: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_CHECKED_CATCH, &try_payload2);
            if hir_checked_try2 == null {
                return null;
            }
            hir_checked_try2.left = exec_lower_checked_arith_tree(ctx, expr.try_expr_operand, &try_payload2);
            if hir_checked_try2.left == null {
                return null;
            }
            hir_checked_try2.bool_value = 1;
            hir_checked_try2.int_value = get_or_add_error_id(ctx.checker, "Overflow" as &byte, expr) as i64;
            hir_checked_try2.global_slot = get_or_add_error_id(ctx.checker, "DivisionByZero" as &byte, expr) as i32;
            return hir_checked_try2;
        }
        const operand: &HIRExpr = exec_lower_expr(ctx, expr.try_expr_operand);
        if operand == null {
            return null;
        }
        if operand.type_ref.type.kind != TypeKind.TYPE_ERROR_UNION {
            var try_msg: [byte: 160] = [];
            _ = snprintf(&try_msg[0] as *byte, 160,
                "exec: try 操作数不是错误联合(kind=%d ast=%d)" as *byte,
                operand.type_ref.type.kind as i32, expr.try_expr_operand.type as i32);
            return exec_lower_fail_expr_reason(expr, &try_msg[0] as &byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_TRY_EXPR);
        }
        if ctx.function_decl != null && ctx.function_decl.fn_decl_is_async != 0 {
            // async 函数里的 `try`：错误要提前返回——而且返回的是
            // `Future{ state: Poll.Ready(err) }`（接口装箱后的形态），
            // 所以这里降级成 `catch { return <包装后的错误联合> }` 的形状：
            // HIR_EXPR_CATCH 绑定整个错误联合（int_value=1 表示不要 UNWRAP_ERR），
            // extra 是「把这个错误联合包成 Future」的表达式。
            return exec_lower_make_async_try_catch(ctx, expr, operand, copy_type(&expr_type));
        }
        const hir_try: &HIRExpr = exec_lower_alloc_expr(ctx, expr, HIRExprKind.HIR_EXPR_TRY, &expr_type);
        if hir_try == null {
            return null;
        }
        hir_try.left = operand;
        return hir_try;
    }
    if expr.type == ASTNodeType.AST_CATCH_EXPR {
        var catch_bind_slot: i32 = -1;
        var catch_bind_scope: i32 = 0;
        if expr.catch_expr_err_name != null &&
            str_equals(expr.catch_expr_err_name, "_" as *byte) == 0 {
            var catch_err_type: Type = make_void_type();
            catch_err_type.kind = TypeKind.TYPE_ERROR;
            if exec_lower_push_scope(ctx, expr, -1) == 0 {
                return null;
            }
            catch_bind_scope = 1;
            catch_bind_slot = exec_lower_append_local(ctx, null, expr.catch_expr_err_name, &catch_err_type, 0);
            if catch_bind_slot < 0 {
                exec_lower_pop_scope(ctx);
                exec_backend_set_error(expr, "exec: catch 错误绑定槽位不足" as *byte, 0);
                return null;
            }
        }
        var catch_is_checked: i32 = 0;
        var operand2: &HIRExpr = null;
        if expr.catch_expr_is_checked_arith != 0 {
            // checked 整数算术：`(a + b) catch { ... }` 就地处理溢出。
            catch_is_checked = 1;
            var checked_payload: Type = exec_lower_type_from_kind_code(expr.catch_expr_checked_kind);
            if checked_payload.kind == TypeKind.TYPE_VOID {
                checked_payload = copy_type(&expr_type);
            }
            operand2 = exec_lower_checked_arith_tree(ctx, expr.catch_expr_operand, &checked_payload);
        } else {
            operand2 = exec_lower_expr(ctx, expr.catch_expr_operand);
        }
        if operand2 == null {
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return null;
        }
        if catch_is_checked == 0 && operand2.type_ref.type.kind != TypeKind.TYPE_ERROR_UNION {
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return exec_lower_fail_expr_reason(expr, "exec: catch 操作数不是错误联合" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_CATCH_EXPR);
        }
        var catch_hir_kind: HIRExprKind = HIRExprKind.HIR_EXPR_CATCH;
        if catch_is_checked != 0 {
            catch_hir_kind = HIRExprKind.HIR_EXPR_CHECKED_CATCH;
        }
        const hir_catch: &HIRExpr = exec_lower_alloc_expr(ctx, expr, catch_hir_kind, &expr_type);
        if catch_is_checked != 0 {
            hir_catch.int_value = get_or_add_error_id(ctx.checker, "Overflow" as &byte, expr) as i64;
            hir_catch.global_slot = get_or_add_error_id(ctx.checker, "DivisionByZero" as &byte, expr) as i32;
        }
        if hir_catch == null {
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return null;
        }
        hir_catch.left = operand2;
        hir_catch.local_slot = catch_bind_slot;
        const catch_block: &ASTNode = expr.catch_expr_catch_block;
        const catch_last_stmt: &ASTNode = exec_lower_block_last_stmt(catch_block);
        if catch_last_stmt == null {
            hir_catch.right = exec_lower_make_zero_expr(ctx, catch_block, &expr_type);
            if hir_catch.right == null {
                if catch_bind_scope != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return null;
            }
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return hir_catch;
        }
        if expr_type.kind == TypeKind.TYPE_VOID && catch_last_stmt.type != ASTNodeType.AST_RETURN_STMT {
            hir_catch.block = exec_lower_block(ctx, catch_block);
            if hir_catch.block == null {
                if catch_bind_scope != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return null;
            }
            hir_catch.right = exec_lower_make_zero_expr(ctx, catch_block, &expr_type);
            if hir_catch.right == null {
                if catch_bind_scope != 0 {
                    exec_lower_pop_scope(ctx);
                }
                return null;
            }
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return hir_catch;
        }
        hir_catch.block = exec_lower_make_block_prefix(ctx, catch_block);
        if catch_last_stmt.type == ASTNodeType.AST_RETURN_STMT {
            const return_stmt: &ASTNode = catch_last_stmt;
            if return_stmt.return_stmt_expr != null {
                if ctx.function_decl != null && ctx.function_decl.fn_decl_return_type != null {
                    const catch_return_type: Type = type_from_ast(ctx.checker, ctx.function_decl.fn_decl_return_type);
                    hir_catch.extra = exec_lower_wrap_catch_return(ctx, expr,
                        exec_lower_coerce_expr(ctx, return_stmt.return_stmt_expr, &catch_return_type),
                        copy_type(&catch_return_type));
                } else {
                    hir_catch.extra = exec_lower_expr(ctx, return_stmt.return_stmt_expr);
                }
                if hir_catch.extra == null {
                    if catch_bind_scope != 0 {
                        exec_lower_pop_scope(ctx);
                    }
                    return null;
                }
            } else {
                hir_catch.extra = exec_lower_make_bare_return_expr(ctx, return_stmt);
                if hir_catch.extra == null {
                    if catch_bind_scope != 0 {
                        exec_lower_pop_scope(ctx);
                    }
                    return null;
                }
            }
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return hir_catch;
        }
        const fallback_expr: &HIRExpr = exec_lower_expr(ctx, catch_last_stmt);
        if fallback_expr == null {
            if catch_bind_scope != 0 {
                exec_lower_pop_scope(ctx);
            }
            return null;
        }
        hir_catch.right = fallback_expr;
        if catch_bind_scope != 0 {
            exec_lower_pop_scope(ctx);
        }
        return hir_catch;
    }
    if expr.type == ASTNodeType.AST_MATCH_EXPR {
        if expr.match_expr_expr == null || expr.match_expr_arms == null || expr.match_expr_arm_count <= 0 {
            return exec_lower_fail_expr_reason(expr, "exec: match 结构无效" as *byte, ExecUnsupportedReason.EXEC_UNSUPPORTED_MATCH_EXPR);
        }
