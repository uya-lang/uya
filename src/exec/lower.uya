// exec/lower.uya - checked AST to minimal Exec HIR lowering

use libc;
use ast;

const EXEC_MAX_LOCALS: i32 = 1024;
// 保持平铺数组查找的热路径简单，同时给编译器本体 staged smoke 留足全局槽位。
const EXEC_MAX_GLOBALS: i32 = 1024;
// `else if` 会在 AST 中嵌套成深链；编译器本体的 SIMD codegen 路径会明显超过 64 层。
const EXEC_MAX_SCOPE_DEPTH: i32 = 512;
const EXEC_MAX_INTERFACE_METHODS: i32 = 64;
const EXEC_MAX_MODULE_GLOBAL_REQUESTS: i32 = 256;
// 泛型结构体方法的单态副本缓存：解释器按「方法声明 + 类型实参」生成一份
// 带具体类型的函数体，调用点按接收者的类型实参取同名副本。
const EXEC_MAX_MONO_STRUCT_DECLS: i32 = 128;
var g_mono_struct_src: [&ASTNode: EXEC_MAX_MONO_STRUCT_DECLS] = [];
var g_mono_struct_out: [&ASTNode: EXEC_MAX_MONO_STRUCT_DECLS] = [];
var g_mono_struct_owner: [&ASTNode: EXEC_MAX_MONO_STRUCT_DECLS] = [];
var g_mono_struct_arg: [Type: EXEC_MAX_MONO_STRUCT_DECLS] = [];
var g_mono_struct_count: i32 = 0;
var g_mono_struct_pending: i32 = 0;
// 正在降级的单态副本序号：方法体里的 `self.grow_if_needed()` 这类调用
// receiver 类型是 `&Self`（没有类型实参），需要继承当前副本的实例。
var g_mono_struct_current: i32 = -1;

struct ExecLowerContext {
    arena: &CompilerArena,
    checker: &TypeChecker,
    function_decl: &ASTNode,
    global_names: [&byte: EXEC_MAX_GLOBALS],
    global_decls: [&ASTNode: EXEC_MAX_GLOBALS],
    // 这三个 `[Type: …]` 每个约 200KB，是 `ExecLowerContext` 819KB 栈帧的主体。
    // 改成按需分配（见 `exec_lower_type_array`），没用到就不清。
    global_types: &Type,
    global_is_const: [i32: EXEC_MAX_GLOBALS],
    global_count: i32,
    local_names: [&byte: EXEC_MAX_LOCALS],
    local_slots: [i32: EXEC_MAX_LOCALS],
    local_types: &Type,
    local_is_param: [i32: EXEC_MAX_LOCALS],
    slot_names: [&byte: EXEC_MAX_LOCALS],
    slot_decls: [&ASTNode: EXEC_MAX_LOCALS],
    slot_types: &Type,
    slot_is_param: [i32: EXEC_MAX_LOCALS],
    slot_scope_ids: [i32: EXEC_MAX_LOCALS],
    slot_needs_drop: [i32: EXEC_MAX_LOCALS],
    slot_drop_decls: [&ASTNode: EXEC_MAX_LOCALS],
    slot_field_drop_indices: [i32: EXEC_MAX_LOCALS * 4],
    slot_field_drop_decls: [&ASTNode: EXEC_MAX_LOCALS * 4],
    slot_field_drop_count: [i32: EXEC_MAX_LOCALS],
    active_local_count: i32,
    next_slot: i32,
    max_slot_count: i32,
    next_scope_id: i32,
    scope_markers: [i32: EXEC_MAX_SCOPE_DEPTH],
    scope_ids: [i32: EXEC_MAX_SCOPE_DEPTH],
    scope_depth: i32,
    // 指定某个 block 降完后**不弹出**自己的作用域（catch 前缀块专用：
    // 尾语句要能看到前缀里声明的局部变量）。null 表示正常弹栈。
    keep_scope_block: &ASTNode,
    // 上一次 exec_lower_make_block_prefix 是否留下了未弹出的作用域。
    catch_prefix_scope_open: i32,
}

/// 取 `exec_lower_type_slot(ctx, 0, idx, EXEC_MAX_LOCALS)[0]` / `local_types` / `global_types` 的槽位地址，
/// 数组没用到时先行分配。
///
/// 这三个数组每个约 200KB（`Type` 结构体），是 `ExecLowerContext` 819KB 栈帧
/// 的主体；把 ctx 字面量放栈上会让每次函数 lowering 白清 600KB
/// （callgrind 实测 `memset'exec_lower_function` 占编译器 6.4% 的指令数）。
///
/// 参数：`ctx` lowering 上下文；`which` 0=slot_types 1=local_types 2=global_types；
///       `idx` 元素下标；`cap` 该数组的上限。
/// 返回值：元素地址；下标越界或分配失败返回 null。
fn exec_lower_type_slot(ctx: &ExecLowerContext, which: i32, idx: i32, cap: i32) &Type {
    if ctx == null || idx < 0 || idx >= cap {
        return null;
    }
    var target: & & Type = &ctx.slot_types;
    if which == 1 {
        target = &ctx.local_types;
    } else if which == 2 {
        target = &ctx.global_types;
    }
    if target[0] == null {
        const fresh: &Type = compiler_arena_alloc(ctx.arena, @size_of(Type) * cap as usize) as &Type;
        if fresh == null {
            return null;
        }
        target[0] = fresh;
    }
    return &target[0][idx];
}

fn exec_lower_set_unsupported(node: &ASTNode, reason: &byte) i32 {
    exec_backend_set_unsupported_error(node, reason, ExecUnsupportedReason.EXEC_UNSUPPORTED_GENERIC);
    return 2;
}

fn exec_lower_set_unsupported_reason(node: &ASTNode, reason: &byte, code: ExecUnsupportedReason) i32 {
    exec_backend_set_unsupported_error(node, reason, code);
    return 2;
}

fn exec_lower_fail_expr(node: &ASTNode, reason: &byte) &HIRExpr {
    _ = exec_lower_set_unsupported(node, reason);
    return null;
}

fn exec_lower_fail_expr_reason(node: &ASTNode, reason: &byte, code: ExecUnsupportedReason) &HIRExpr {
    _ = exec_lower_set_unsupported_reason(node, reason, code);
    return null;
}

fn exec_lower_fail_block(node: &ASTNode, reason: &byte) &HIRBlock {
    _ = exec_lower_set_unsupported(node, reason);
    return null;
}

fn exec_lower_fail_block_reason(node: &ASTNode, reason: &byte, code: ExecUnsupportedReason) &HIRBlock {
    _ = exec_lower_set_unsupported_reason(node, reason, code);
    return null;
}

fn exec_lower_get_env_byte(name: &byte) &byte {
    if name == null {
        return null;
    }
    const raw: *byte = getenv(name as *byte);
    if raw == null || raw[0] == 0 {
        return null;
    }
    return raw as &byte;
}

fn exec_lower_detect_host_os_token() &byte {
    const host_os: &byte = exec_lower_get_env_byte("HOST_OS" as *byte);
    if host_os != null {
        return host_os;
    }
    const os_type: &byte = exec_lower_get_env_byte("OSTYPE" as *byte);
    if os_type != null {
        return os_type;
    }
    const mach_type: &byte = exec_lower_get_env_byte("MACHTYPE" as *byte);
    if mach_type != null {
        return mach_type;
    }
    return "linux" as &byte;
}

fn exec_lower_detect_host_arch_token() &byte {
    const host_arch: &byte = exec_lower_get_env_byte("HOST_ARCH" as *byte);
    if host_arch != null {
        return host_arch;
    }
    const host_type: &byte = exec_lower_get_env_byte("HOSTTYPE" as *byte);
    if host_type != null {
        return host_type;
    }
    const mach_type: &byte = exec_lower_get_env_byte("MACHTYPE" as *byte);
    if mach_type != null {
        return mach_type;
    }
    return "x86_64" as &byte;
}

fn exec_lower_host_asm_target_value() i32 {
    const os_token: &byte = exec_lower_detect_host_os_token();
    const arch_token: &byte = exec_lower_detect_host_arch_token();
    const is_linux: i32 = (strstr(os_token as *byte, "linux" as *byte) != null) as i32;
    const is_macos: i32 =
        ((strstr(os_token as *byte, "darwin" as *byte) != null) as i32) |
        ((strstr(os_token as *byte, "macos" as *byte) != null) as i32);
    const is_windows: i32 =
        ((strstr(os_token as *byte, "win" as *byte) != null) as i32) |
        ((strstr(os_token as *byte, "mingw" as *byte) != null) as i32) |
        ((strstr(os_token as *byte, "msys" as *byte) != null) as i32) |
        ((strstr(os_token as *byte, "cygwin" as *byte) != null) as i32);
    const is_x86_64: i32 =
        ((strstr(arch_token as *byte, "x86_64" as *byte) != null) as i32) |
        ((strstr(arch_token as *byte, "amd64" as *byte) != null) as i32);
    const is_arm64: i32 =
        ((strstr(arch_token as *byte, "aarch64" as *byte) != null) as i32) |
        ((strstr(arch_token as *byte, "arm64" as *byte) != null) as i32);
    const is_riscv64: i32 = (strstr(arch_token as *byte, "riscv64" as *byte) != null) as i32;
    if is_x86_64 != 0 {
        if is_macos != 0 { return 1; }
        if is_windows != 0 { return 2; }
        return 0;
    }
    if is_arm64 != 0 {
        if is_macos != 0 { return 4; }
        if is_windows != 0 { return 5; }
        return 3;
    }
    if is_riscv64 != 0 {
        return 6;
    }
    if is_linux != 0 {
        return 0;
    }
    return 0;
}

fn exec_type_is_scalar_supported(type: Type) i32 {
    // SIMD 值在 VM 里按「元素类型的定长缓冲 + 通道数」表示，属于一等标量。
    if type.kind == TypeKind.TYPE_VECTOR || type.kind == TypeKind.TYPE_MASK {
        return 1;
    }
    if type.kind == TypeKind.TYPE_ATOMIC {
        const inner: &Type = type_get_atomic_inner(&type);
        if inner != null {
            return exec_type_is_scalar_supported(inner[0]);
        }
        return 0;
    }
    if type.kind == TypeKind.TYPE_I8 ||
        type.kind == TypeKind.TYPE_I16 ||
        type.kind == TypeKind.TYPE_I32 ||
        type.kind == TypeKind.TYPE_I64 ||
        type.kind == TypeKind.TYPE_U8 ||
        type.kind == TypeKind.TYPE_U16 ||
        type.kind == TypeKind.TYPE_U32 ||
        type.kind == TypeKind.TYPE_U64 ||
        type.kind == TypeKind.TYPE_USIZE ||
        type.kind == TypeKind.TYPE_F32 ||
        type.kind == TypeKind.TYPE_F64 ||
        type.kind == TypeKind.TYPE_BOOL ||
        type.kind == TypeKind.TYPE_BYTE ||
        type.kind == TypeKind.TYPE_ENUM ||
        type.kind == TypeKind.TYPE_VOID {
        return 1;
    }
    return 0;
}

fn exec_lower_type_ast_size_bytes(checker: &TypeChecker, type_ast: &ASTNode, program_node: &ASTNode) i32 {
    if checker == null || type_ast == null || program_node == null {
        return -1;
    }
    const resolved: Type = type_from_ast(checker, type_ast);
    return get_type_size_bytes_v2(checker, &resolved, program_node);
}

fn exec_lower_type_ast_align_bytes(checker: &TypeChecker, type_ast: &ASTNode, program_node: &ASTNode) i32 {
    if checker == null || type_ast == null || program_node == null {
        return -1;
    }
    const resolved: Type = type_from_ast(checker, type_ast);
    return get_type_align_bytes_v2(checker, &resolved, program_node);
}

/// 空结构体（零字段）在 C 兼容布局下尺寸/对齐都是 1，但共享的
/// `get_type_size_bytes_v2` 对零字段结构体返回 -1，这里补上。
///
/// 参数：`checker` 类型检查器；`name` 类型名；`program_node` 程序根节点。
/// 返回值：1 表示是零字段结构体，否则 0。
fn exec_lower_is_empty_struct_decl(checker: &TypeChecker, name: &byte, program_node: &ASTNode) i32 {
    if checker == null || name == null || program_node == null {
        return 0;
    }
    const decl: &ASTNode = find_struct_decl_from_program(program_node, name);
    if decl == null || decl.type != ASTNodeType.AST_STRUCT_DECL {
        return 0;
    }
    if decl.struct_decl_field_count > 0 {
        return 0;
    }
    return 1;
}

fn exec_lower_named_decl_size_bytes(checker: &TypeChecker, name: &byte, program_node: &ASTNode) i32 {
    if checker == null || name == null || program_node == null {
        return -1;
    }
    if exec_lower_is_empty_struct_decl(checker, name, program_node) != 0 {
        return 1;
    }
    if find_struct_decl_from_program(program_node, name) != null {
        const named_struct: Type = make_named_type(TypeKind.TYPE_STRUCT, name);
        return get_type_size_bytes_v2(checker, &named_struct, program_node);
    }
    if find_union_decl_from_program(program_node, name) != null {
        const named_union: Type = make_named_type(TypeKind.TYPE_UNION, name);
        return get_type_size_bytes_v2(checker, &named_union, program_node);
    }
    if find_interface_decl_from_program(program_node, name) != null {
        const named_iface: Type = make_named_type(TypeKind.TYPE_INTERFACE, name);
        return get_type_size_bytes_v2(checker, &named_iface, program_node);
    }
    if find_enum_decl_from_program(program_node, name) != null {
        const named_enum: Type = make_named_type(TypeKind.TYPE_ENUM, name);
        return get_type_size_bytes_v2(checker, &named_enum, program_node);
    }
    return -1;
}

fn exec_lower_named_decl_align_bytes(checker: &TypeChecker, name: &byte, program_node: &ASTNode) i32 {
    if checker == null || name == null || program_node == null {
        return -1;
    }
    if exec_lower_is_empty_struct_decl(checker, name, program_node) != 0 {
        return 1;
    }
    if find_struct_decl_from_program(program_node, name) != null {
        const named_struct: Type = make_named_type(TypeKind.TYPE_STRUCT, name);
        return get_type_align_bytes_v2(checker, &named_struct, program_node);
    }
    if find_union_decl_from_program(program_node, name) != null {
        const named_union: Type = make_named_type(TypeKind.TYPE_UNION, name);
        return get_type_align_bytes_v2(checker, &named_union, program_node);
    }
    if find_interface_decl_from_program(program_node, name) != null {
        const named_iface: Type = make_named_type(TypeKind.TYPE_INTERFACE, name);
        return get_type_align_bytes_v2(checker, &named_iface, program_node);
    }
    if find_enum_decl_from_program(program_node, name) != null {
        const named_enum: Type = make_named_type(TypeKind.TYPE_ENUM, name);
        return get_type_align_bytes_v2(checker, &named_enum, program_node);
    }
    return -1;
}

/// 求泛型结构体实例某个字段的**具体类型**。
///
/// `FutureSlot<i32>` 的声明里字段写的是 `slot: [T: 1]`，直接用
/// `type_from_ast` 只会得到未替换的 `T`（后续按名字找结构体必然失败）。
/// 这里在解析期间装好 `current_type_params` + `subst`，和
/// `exec_lower_size_align_of_type` 用的是同一套上下文。
///
/// 参数：`checker` 类型检查器；`struct_type` 结构体实例类型（带类型实参）；
///       `struct_decl` 结构体声明；`field_decl` 字段声明。
/// 返回值：字段的具体类型。
fn exec_lower_subst_struct_field_type(checker: &TypeChecker, struct_type: &Type,
    struct_decl: &ASTNode, field_decl: &ASTNode) Type {
    if checker == null || field_decl == null || field_decl.var_decl_type == null {
        return make_void_type();
    }
    if struct_type == null || struct_decl == null ||
        struct_type.struct_type_args == null || struct_type.struct_type_arg_count <= 0 ||
        struct_decl.struct_decl_type_params == null || struct_decl.struct_decl_type_param_count <= 0 {
        return type_from_ast(checker, field_decl.var_decl_type);
    }
    var replacements: i32 = struct_type.struct_type_arg_count;
    if replacements > struct_decl.struct_decl_type_param_count {
        replacements = struct_decl.struct_decl_type_param_count;
    }
    const saved_params: &TypeParam = checker.current_type_params;
    const saved_param_count: i32 = checker.current_type_param_count;
    const saved_active: i32 = checker.subst_active;
    const saved_name: &byte = checker.subst_name;
    const saved_type: Type = copy_type(&checker.subst_type);
    checker.current_type_params = struct_decl.struct_decl_type_params;
    checker.current_type_param_count = struct_decl.struct_decl_type_param_count;
    checker.subst_active = 1;
    checker.subst_name = struct_decl.struct_decl_type_params[0].name;
    checker.subst_type = copy_type(&struct_type.struct_type_args[0]);
    var result: Type = type_from_ast(checker, field_decl.var_decl_type);
    // 多类型参数：当前 subst 上下文只有一个槽位，其余实参按名字逐个替换。
    var ri: i32 = 1;
    while ri < replacements {
        if result.kind == TypeKind.TYPE_GENERIC_PARAM && result.generic_param_name != null &&
            str_equals(result.generic_param_name, struct_decl.struct_decl_type_params[ri].name) != 0 {
            result = copy_type(&struct_type.struct_type_args[ri]);
        }
        ri = ri + 1;
    }
    checker.current_type_params = saved_params;
    checker.current_type_param_count = saved_param_count;
    checker.subst_active = saved_active;
    checker.subst_name = saved_name;
    checker.subst_type = copy_type(&saved_type);
    return result;
}

/// 求某个类型的字节数或对齐（结构体带类型实参时先装好替换上下文）。
///
/// 参数：`ctx` lowering 上下文；`target_type` 目标类型；`want_size` 1 求字节数、0 求对齐。
/// 返回值：字节数/对齐；无法确定返回 -1。
fn exec_lower_size_align_of_type(ctx: &ExecLowerContext, target_type: Type, want_size: i32) i32 {
    if ctx == null || ctx.checker == null {
        return -1;
    }
    // 泛型结构体实例 `Box<i32>`：字段类型里的 `T` 要靠 current_type_params +
    // subst 才能换成具体类型，否则算不出字段尺寸。
    var struct_name: &byte = null;
    if target_type.kind == TypeKind.TYPE_STRUCT {
        struct_name = target_type.struct_name;
    } else if target_type.kind == TypeKind.TYPE_UNION {
        struct_name = target_type.union_name;
    }
    if struct_name == null || target_type.struct_type_args == null ||
        target_type.struct_type_arg_count <= 0 {
        if want_size != 0 {
            return get_type_size_bytes_v2(ctx.checker, &target_type, ctx.checker.program_node);
        }
        return get_type_align_bytes_v2(ctx.checker, &target_type, ctx.checker.program_node);
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(ctx.checker.program_node, struct_name);
    if struct_decl == null || struct_decl.struct_decl_type_params == null ||
        struct_decl.struct_decl_type_param_count <= 0 {
        if want_size != 0 {
            return get_type_size_bytes_v2(ctx.checker, &target_type, ctx.checker.program_node);
        }
        return get_type_align_bytes_v2(ctx.checker, &target_type, ctx.checker.program_node);
    }
    const saved_params: &TypeParam = ctx.checker.current_type_params;
    const saved_param_count: i32 = ctx.checker.current_type_param_count;
    const saved_active: i32 = ctx.checker.subst_active;
    const saved_name: &byte = ctx.checker.subst_name;
    const saved_type: Type = copy_type(&ctx.checker.subst_type);
    ctx.checker.current_type_params = struct_decl.struct_decl_type_params;
    ctx.checker.current_type_param_count = struct_decl.struct_decl_type_param_count;
    ctx.checker.subst_active = 1;
    ctx.checker.subst_name = struct_decl.struct_decl_type_params[0].name;
    ctx.checker.subst_type = copy_type(&target_type.struct_type_args[0]);
    var result: i32 = -1;
    if want_size != 0 {
        result = get_type_size_bytes_v2(ctx.checker, &target_type, ctx.checker.program_node);
    } else {
        result = get_type_align_bytes_v2(ctx.checker, &target_type, ctx.checker.program_node);
    }
    ctx.checker.current_type_params = saved_params;
    ctx.checker.current_type_param_count = saved_param_count;
    ctx.checker.subst_active = saved_active;
    ctx.checker.subst_name = saved_name;
    ctx.checker.subst_type = copy_type(&saved_type);
    return result;
}

fn exec_lower_eval_size_align_builtin(ctx: &ExecLowerContext, expr: &ASTNode) i32 {
    if ctx == null || expr == null {
        return -1;
    }
    if expr.type != ASTNodeType.AST_SIZEOF && expr.type != ASTNodeType.AST_ALIGNOF {
        return -1;
    }
    var target: &ASTNode = expr.sizeof_expr_target;
    var is_type_expr: i32 = expr.sizeof_expr_is_type;
    if expr.type == ASTNodeType.AST_ALIGNOF {
        target = expr.alignof_expr_target;
        is_type_expr = expr.alignof_expr_is_type;
    }
    // `@size_of(Box<i32>)`：带类型实参的类型写法在 parser 里不会标 is_type，
    // 但节点本身就是类型节点，按类型形态解析。
    if target != null && (target.type == ASTNodeType.AST_TYPE_NAMED ||
        target.type == ASTNodeType.AST_TYPE_POINTER ||
        target.type == ASTNodeType.AST_TYPE_ARRAY ||
        target.type == ASTNodeType.AST_TYPE_SLICE ||
        target.type == ASTNodeType.AST_TYPE_ERROR_UNION) {
        is_type_expr = 1;
    }
    if target == null {
        return -1;
    }
    if is_type_expr != 0 && target.type == ASTNodeType.AST_TYPE_FRAME {
        if expr.type == ASTNodeType.AST_SIZEOF {
            return get_async_frame_size_bytes(ctx.checker, target);
        }
        return get_async_frame_align_bytes(ctx.checker, target);
    }
    if target.type == ASTNodeType.AST_IDENTIFIER && target.identifier_name != null {
        if expr.type == ASTNodeType.AST_SIZEOF {
            const named_size: i32 = exec_lower_named_decl_size_bytes(ctx.checker, target.identifier_name, ctx.checker.program_node);
            if named_size >= 0 {
                return named_size;
            }
        } else {
            const named_align: i32 = exec_lower_named_decl_align_bytes(ctx.checker, target.identifier_name, ctx.checker.program_node);
            if named_align >= 0 {
                return named_align;
            }
        }
    }
    // 操作数是表达式（如 `@size_of(x)` 的局部变量）时要用带作用域重建的类型推断：
    // 直接调用 checker 推断会因为 lowering 期的 checker 作用域已退出而拿不到局部变量类型。
    var target_type: Type = exec_lower_expr_type(ctx, target);
    if is_type_expr != 0 {
        target_type = type_from_ast(ctx.checker, target);
    } else if target.type == ASTNodeType.AST_IDENTIFIER && target.identifier_name != null {
        if find_struct_decl_from_program(ctx.checker.program_node, target.identifier_name) != null {
            target_type = make_named_type(TypeKind.TYPE_STRUCT, target.identifier_name);
        } else if find_union_decl_from_program(ctx.checker.program_node, target.identifier_name) != null {
            target_type = make_named_type(TypeKind.TYPE_UNION, target.identifier_name);
        } else if find_interface_decl_from_program(ctx.checker.program_node, target.identifier_name) != null {
            target_type = make_named_type(TypeKind.TYPE_INTERFACE, target.identifier_name);
        }
    }
    // 泛型参数（`@size_of(T)`）在表达式推断下会得到 void/泛型参数，
    // 单态体里要按类型再解析一次才能拿到具体结构体。
    // `@size_of(sample[0])` 这类元素类型是泛型参数的表达式：单态化期间按当前替换取具体类型。
    if target_type.kind == TypeKind.TYPE_GENERIC_PARAM && ctx.checker.subst_active != 0 &&
        ctx.checker.subst_name != null && target_type.generic_param_name != null {
        if str_equals(target_type.generic_param_name, ctx.checker.subst_name) != 0 {
            target_type = copy_type(&ctx.checker.subst_type);
        }
    }
    if target.type == ASTNodeType.AST_IDENTIFIER && target.identifier_name != null {
        var needs_type_form_size: i32 = 0;
        if target_type.kind == TypeKind.TYPE_GENERIC_PARAM || target_type.kind == TypeKind.TYPE_VOID {
            needs_type_form_size = 1;
        }
        if needs_type_form_size != 0 {
            // 标识符按「类型名」再解析一次：合成一个 AST_TYPE_NAMED 节点，
            // 让 type_from_ast 走泛型替换/结构体声明查找。
            const named_target_node: &ASTNode = compiler_arena_alloc(ctx.arena, @size_of(ASTNode)) as &ASTNode;
            var generic_target_type: Type = make_void_type();
            if named_target_node != null {
                named_target_node[0] = target[0];
                named_target_node.type = ASTNodeType.AST_TYPE_NAMED;
                named_target_node.type_named_name = target.identifier_name;
                named_target_node.type_named_type_args = null;
                named_target_node.type_named_type_arg_count = 0;
                generic_target_type = type_from_ast(ctx.checker, named_target_node);
            }
            var generic_size_usable: i32 = 1;
            if generic_target_type.kind == TypeKind.TYPE_VOID || generic_target_type.kind == TypeKind.TYPE_GENERIC_PARAM {
                generic_size_usable = 0;
            }
            if generic_size_usable != 0 {
                target_type = generic_target_type;
            }
        }
    }
    // SIMD：向量按「元素尺寸 × 通道数」计大小，掩码按位集 i64 计。
    // 目标写成类型别名（`type V4 = @vector(i32,4)`）时，上面按表达式推断会得到
    // void，这里再按类型节点解析一次。
    if target_type.kind != TypeKind.TYPE_VECTOR && target_type.kind != TypeKind.TYPE_MASK {
        const alt_type: Type = type_from_ast(ctx.checker, target);
        if alt_type.kind == TypeKind.TYPE_VECTOR || alt_type.kind == TypeKind.TYPE_MASK {
            target_type = alt_type;
        }
    }
    if target_type.kind != TypeKind.TYPE_VECTOR && target_type.kind != TypeKind.TYPE_MASK &&
        target.type == ASTNodeType.AST_IDENTIFIER && target.identifier_name != null {
        const alias_decl: &ASTNode = find_type_alias_from_program(ctx.checker.program_node, target.identifier_name);
        if alias_decl != null && alias_decl.type_alias_target_type != null {
            const alias_type: Type = type_from_ast(ctx.checker, alias_decl.type_alias_target_type);
            if alias_type.kind == TypeKind.TYPE_VECTOR || alias_type.kind == TypeKind.TYPE_MASK {
                target_type = alias_type;
            }
        }
    }
    if target_type.kind == TypeKind.TYPE_VECTOR && target_type.element_type != null {
        const elem_size: i32 = get_type_size_bytes_v2(ctx.checker, &target_type.element_type[0], ctx.checker.program_node);
        const elem_align: i32 = get_type_align_bytes_v2(ctx.checker, &target_type.element_type[0], ctx.checker.program_node);
        if expr.type == ASTNodeType.AST_SIZEOF {
            if elem_size > 0 && target_type.array_size > 0 {
                return elem_size *| target_type.array_size;
            }
            return -1;
        }
        return elem_align;
    }
    if target_type.kind == TypeKind.TYPE_MASK {
        if expr.type == ASTNodeType.AST_SIZEOF {
            return @size_of(i64) as i32;
        }
        return @size_of(i64) as i32;
    }
    // `va_list` 是平台相关内置类型：x86-64 SysV 下是 24 字节、8 字节对齐。
    if target.type == ASTNodeType.AST_IDENTIFIER && target.identifier_name != null &&
        str_equals(target.identifier_name, "va_list" as &byte) != 0 &&
        (target_type.kind == TypeKind.TYPE_VOID || target_type.kind == TypeKind.TYPE_VA_LIST) {
        if expr.type == ASTNodeType.AST_SIZEOF {
            return 24;
        }
        return 8;
    }
    // 空结构体（零字段）的尺寸/对齐按 C 兼容取 1；共享 layout 对零字段返回 -1。
    if target_type.kind == TypeKind.TYPE_STRUCT && target_type.struct_name != null &&
        exec_lower_is_empty_struct_decl(ctx.checker, target_type.struct_name, ctx.checker.program_node) != 0 {
        return 1;
    }
    // `[Empty: N]` 同理：元素 1 字节，总长就是元素个数。
    if target_type.kind == TypeKind.TYPE_ARRAY && target_type.element_type != null &&
        target_type.element_type[0].kind == TypeKind.TYPE_STRUCT &&
        target_type.element_type[0].struct_name != null &&
        exec_lower_is_empty_struct_decl(ctx.checker, target_type.element_type[0].struct_name,
            ctx.checker.program_node) != 0 {
        if expr.type == ASTNodeType.AST_SIZEOF {
            return target_type.array_size;
        }
        return 1;
    }
    const want_size: i32 = (expr.type == ASTNodeType.AST_SIZEOF) as i32;
    return exec_lower_size_align_of_type(ctx, target_type, want_size);
}

fn exec_lower_checker_infer_type_quiet(ctx: &ExecLowerContext, expr: &ASTNode) Type {
    if ctx == null || ctx.checker == null {
        return make_void_type();
    }
    const saved_suppress: i32 = ctx.checker.suppress_codegen_diagnostics;
    const saved_safety_proof: i32 = ctx.checker.enable_safety_proof;
    const saved_proof_steps: i32 = ctx.checker.proof_step_count;
    ctx.checker.suppress_codegen_diagnostics = 1;
    ctx.checker.enable_safety_proof = 0;
    ctx.checker.proof_step_count = 0;
    const inferred: Type = checker_infer_type(ctx.checker, expr);
    ctx.checker.proof_step_count = saved_proof_steps;
    ctx.checker.enable_safety_proof = saved_safety_proof;
    ctx.checker.suppress_codegen_diagnostics = saved_suppress;
    return inferred;
}

fn exec_type_is_string_pointer_supported(type: Type) i32 {
    if type.kind != TypeKind.TYPE_POINTER || type.pointer_to == null {
        return 0;
    }
    if type.pointer_to.kind == TypeKind.TYPE_BYTE {
        return 1;
    }
    return 0;
}

/// 隐式 libc 常量（`use libc.WNOHANG;` 这类 C 宏）的解释器取值。
///
/// Uya 侧没有它们的声明节点：C99 后端把名字原样发射到 C 输出，靠 `<sys/wait.h>`
/// 之类的头文件展开。解释器里得有一张表，否则 `WNOHANG | ...` 会以
/// 「当前仅支持局部变量/参数/全局标识符」失败。取值按 Linux/POSIX；表里缺的
/// 常量请连同目标平台一起补，不要用 0 兜底（0 会静默改变语义）。
///
/// 参数：`name` 标识符名字。
/// 返回值：命中返回 1 并写入 `out_value`；未命中返回 0。
fn exec_lower_libc_macro(name: &byte, out_value: &i64) i32 {
    if name == null || out_value == null {
        return 0;
    }
    if str_equals(name, "WNOHANG" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "WUNTRACED" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "WCONTINUED" as &byte) != 0 { out_value[0] = 8; return 1; }
    if str_equals(name, "O_RDONLY" as &byte) != 0 { out_value[0] = 0; return 1; }
    if str_equals(name, "O_WRONLY" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "O_RDWR" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "O_CREAT" as &byte) != 0 { out_value[0] = 64; return 1; }
    if str_equals(name, "O_EXCL" as &byte) != 0 { out_value[0] = 128; return 1; }
    if str_equals(name, "O_TRUNC" as &byte) != 0 { out_value[0] = 512; return 1; }
    if str_equals(name, "O_APPEND" as &byte) != 0 { out_value[0] = 1024; return 1; }
    if str_equals(name, "O_NONBLOCK" as &byte) != 0 { out_value[0] = 2048; return 1; }
    if str_equals(name, "O_CLOEXEC" as &byte) != 0 { out_value[0] = 524288; return 1; }
    if str_equals(name, "F_GETFL" as &byte) != 0 { out_value[0] = 3; return 1; }
    if str_equals(name, "F_SETFL" as &byte) != 0 { out_value[0] = 4; return 1; }
    if str_equals(name, "F_DUPFD_CLOEXEC" as &byte) != 0 { out_value[0] = 1030; return 1; }
    if str_equals(name, "PROT_NONE" as &byte) != 0 { out_value[0] = 0; return 1; }
    if str_equals(name, "PROT_READ" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "PROT_WRITE" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "PROT_EXEC" as &byte) != 0 { out_value[0] = 4; return 1; }
    if str_equals(name, "MAP_SHARED" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "MAP_PRIVATE" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "MAP_ANONYMOUS" as &byte) != 0 { out_value[0] = 32; return 1; }
    if str_equals(name, "MAP_ANON" as &byte) != 0 { out_value[0] = 32; return 1; }
    if str_equals(name, "IPPROTO_TCP" as &byte) != 0 { out_value[0] = 6; return 1; }
    if str_equals(name, "TCP_NODELAY" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "SOL_SOCKET" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "SO_REUSEADDR" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "AF_INET" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "AF_INET6" as &byte) != 0 { out_value[0] = 10; return 1; }
    if str_equals(name, "SOCK_STREAM" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "SOCK_DGRAM" as &byte) != 0 { out_value[0] = 2; return 1; }
    if str_equals(name, "CLOCK_REALTIME" as &byte) != 0 { out_value[0] = 0; return 1; }
    if str_equals(name, "CLOCK_MONOTONIC" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "EINTR" as &byte) != 0 { out_value[0] = 4; return 1; }
    // libc 头文件里的 `errno` 常量在 Uya 侧常写成 `libc_EAGAIN` 这种全名前缀形式，
    // C99 后端靠头文件展开；解释器按同值补上。
    if str_equals(name, "libc_EAGAIN" as &byte) != 0 { out_value[0] = 11; return 1; }
    if str_equals(name, "libc_EWOULDBLOCK" as &byte) != 0 { out_value[0] = 11; return 1; }
    if str_equals(name, "libc_EINPROGRESS" as &byte) != 0 { out_value[0] = 115; return 1; }
    if str_equals(name, "libc_EALREADY" as &byte) != 0 { out_value[0] = 114; return 1; }
    if str_equals(name, "libc_EINTR" as &byte) != 0 { out_value[0] = 4; return 1; }
    if str_equals(name, "libc_ECONNRESET" as &byte) != 0 { out_value[0] = 104; return 1; }
    if str_equals(name, "libc_ECONNREFUSED" as &byte) != 0 { out_value[0] = 111; return 1; }
    if str_equals(name, "libc_AGAIN" as &byte) != 0 { out_value[0] = 11; return 1; }
    // 编译器注入的编译期开关：`--async-frame-heap=on` 时 C99 才发成 1，
    // 默认和解释器里的取值都是 0。
    if str_equals(name, "_uya_async_frame_heap_fallback" as &byte) != 0 { out_value[0] = 0; return 1; }
    if str_equals(name, "EAGAIN" as &byte) != 0 { out_value[0] = 11; return 1; }
    if str_equals(name, "EWOULDBLOCK" as &byte) != 0 { out_value[0] = 11; return 1; }
    if str_equals(name, "EPIPE" as &byte) != 0 { out_value[0] = 32; return 1; }
    if str_equals(name, "SIG_IGN" as &byte) != 0 { out_value[0] = 1; return 1; }
    if str_equals(name, "SIG_ERR" as &byte) != 0 { out_value[0] = 0 - 1; return 1; }
    return 0;
}

fn exec_lower_is_supported_extern_lib(fn_decl: &ASTNode) i32 {
    if fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    if fn_decl.fn_decl_extern_lib_name == null {
        return 1;
    }
    if str_equals(fn_decl.fn_decl_extern_lib_name, "libc" as &byte) != 0 {
        return 1;
    }
    return 0;
}

fn exec_lower_is_exact_scalar_type(type: Type, kind: TypeKind) i32 {
    if type.kind == kind {
        return 1;
    }
    return 0;
}

fn exec_lower_match_host_call(fn_decl: &ASTNode, call_arg_count: i32) ExecHostCallId {
    if fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return ExecHostCallId.EXEC_HOST_CALL_NONE;
    }
    if fn_decl.fn_decl_is_extern == 0 {
        return ExecHostCallId.EXEC_HOST_CALL_NONE;
    }
    if fn_decl.fn_decl_name == null || fn_decl.fn_decl_return_type == null {
        return ExecHostCallId.EXEC_HOST_CALL_NONE;
    }
    return exec_lower_match_host_call_impl(fn_decl.fn_decl_name, fn_decl.fn_decl_param_count,
        call_arg_count, fn_decl.fn_decl_is_varargs);
}

/// 只有名字（没有声明）时的宿主调用匹配：`use std.mem.memcpy;` 这种
/// 「名字来自 C 头文件」的隐式 libc 调用在 Uya 侧没有声明节点。
///
/// 参数：`fn_name` 函数名；`param_count` 期望参数个数；`call_arg_count` 实参个数。
/// 返回值：命中的宿主调用 id；没命中返回 NONE。
/// 判断函数名是否属于「一元 libm」族（`f64 -> f64`）。
///
/// 参数：`fn_name` 函数名。
/// 返回值：1 命中；0 不命中。
fn exec_lower_is_libm_unary_name(fn_name: &byte) i32 {
    if fn_name == null {
        return 0;
    }
    // 常见一元函数（`fabs`/`sqrt`/`exp`/`log`/三角/取整族）。
    if str_equals(fn_name, "fabs" as &byte) != 0 || str_equals(fn_name, "sqrt" as &byte) != 0 ||
        str_equals(fn_name, "cbrt" as &byte) != 0 || str_equals(fn_name, "exp" as &byte) != 0 ||
        str_equals(fn_name, "exp2" as &byte) != 0 || str_equals(fn_name, "log" as &byte) != 0 ||
        str_equals(fn_name, "log2" as &byte) != 0 || str_equals(fn_name, "log10" as &byte) != 0 {
        return 1;
    }
    if str_equals(fn_name, "sin" as &byte) != 0 || str_equals(fn_name, "cos" as &byte) != 0 ||
        str_equals(fn_name, "tan" as &byte) != 0 || str_equals(fn_name, "asin" as &byte) != 0 ||
        str_equals(fn_name, "acos" as &byte) != 0 || str_equals(fn_name, "atan" as &byte) != 0 {
        return 1;
    }
    if str_equals(fn_name, "sinh" as &byte) != 0 || str_equals(fn_name, "cosh" as &byte) != 0 ||
        str_equals(fn_name, "tanh" as &byte) != 0 || str_equals(fn_name, "floor" as &byte) != 0 ||
        str_equals(fn_name, "ceil" as &byte) != 0 || str_equals(fn_name, "round" as &byte) != 0 ||
        str_equals(fn_name, "trunc" as &byte) != 0 {
        return 1;
    }
    return 0;
}

/// 判断函数名是否属于「二元 libm」族（`(f64, f64) -> f64`）。
///
/// 参数：`fn_name` 函数名。
/// 返回值：1 命中；0 不命中。
fn exec_lower_is_libm_binary_name(fn_name: &byte) i32 {
    if fn_name == null {
        return 0;
    }
    if str_equals(fn_name, "pow" as &byte) != 0 || str_equals(fn_name, "fmod" as &byte) != 0 ||
        str_equals(fn_name, "atan2" as &byte) != 0 || str_equals(fn_name, "hypot" as &byte) != 0 ||
        str_equals(fn_name, "copysign" as &byte) != 0 || str_equals(fn_name, "fmin" as &byte) != 0 ||
        str_equals(fn_name, "fmax" as &byte) != 0 {
        return 1;
    }
    return 0;
}

fn exec_lower_match_host_call_name(fn_name: &byte, param_count: i32, call_arg_count: i32) ExecHostCallId {
    return exec_lower_match_host_call_impl(fn_name, param_count, call_arg_count, 0);
}

fn exec_lower_match_host_call_impl(fn_name: &byte, param_count: i32, call_arg_count: i32,
    is_varargs: i32) ExecHostCallId {
    if fn_name == null {
        return ExecHostCallId.EXEC_HOST_CALL_NONE;
    }
    // 格式化 I/O 族（printf / fprintf / sprintf / snprintf / sscanf）必须放在
    // 下面 `is_varargs == 0` 块**之前**：那个块以自己的 `return
    // EXEC_HOST_CALL_NONE` 收尾，而查名字的入口
    // （`exec_lower_match_host_call_name`）传的就是 `is_varargs = 0`，把这些分支
    // 放在块后面永远不可达 —— 实测 `sscanf` / `sprintf` 因此一直匹配不到宿主实现，
    // 落到 Uya 实现体的 `@va_start` 路径上报「无法解析被调用函数」。
    if str_equals(fn_name, "fprintf" as &byte) != 0 && call_arg_count >= 2 {
        return ExecHostCallId.EXEC_HOST_CALL_FPRINTF_FIXED;
    }
    if str_equals(fn_name, "printf" as &byte) != 0 && call_arg_count >= 1 {
        return ExecHostCallId.EXEC_HOST_CALL_PRINTF_FIXED;
    }
    if str_equals(fn_name, "sprintf" as &byte) != 0 && call_arg_count >= 2 {
        return ExecHostCallId.EXEC_HOST_CALL_SPRINTF_FIXED;
    }
    if str_equals(fn_name, "snprintf" as &byte) != 0 && call_arg_count >= 3 {
        return ExecHostCallId.EXEC_HOST_CALL_SNPRINTF_FIXED;
    }
    if str_equals(fn_name, "sscanf" as &byte) != 0 && call_arg_count >= 2 {
        return ExecHostCallId.EXEC_HOST_CALL_SSCANF_FIXED;
    }
    if is_varargs == 0 {
        // 内存 / 字符串族：protobuf、tflm、process 等模块只声明不带体的
        // `extern "libc"`，VM 必须自己按原生指针实现，否则这些模块整体不可用。
        // 带 Uya 体的版本（lib/libc/mem.uya）仍走解释执行，不受影响。
        if param_count == 0 && call_arg_count == 0 &&
            str_equals(fn_name, "uya_pipeline_worker_main_if_requested" as &byte) != 0 {
            return ExecHostCallId.EXEC_HOST_CALL_SYNTH_ZERO;
        }
        if param_count == 0 && call_arg_count == 0 &&
            str_equals(fn_name, "uya_pipeline_image_anchor" as &byte) != 0 {
            return ExecHostCallId.EXEC_HOST_CALL_IMAGE_ANCHOR;
        }
        if str_equals(fn_name, "exit" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_EXIT;
        }
        if str_equals(fn_name, "isatty" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_ISATTY;
        }
        if str_equals(fn_name, "pthread_sigmask" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_SIGMASK;
        }
        // 同步解释器没有真线程：这几个 pthread 入口在 VM 里按「顺序执行 + 状态表」模拟，
        // 语义比跑 Uya 实现体（clone 系统调用）更接近调用点的期望。
        if str_equals(fn_name, "pthread_create" as &byte) != 0 &&
            param_count == 4 && call_arg_count == 4 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_CREATE;
        }
        if str_equals(fn_name, "pthread_join" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_JOIN;
        }
        if str_equals(fn_name, "pthread_detach" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_DETACH;
        }
        if str_equals(fn_name, "pthread_self" as &byte) != 0 &&
            param_count == 0 && call_arg_count == 0 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_SELF;
        }
        if str_equals(fn_name, "pthread_equal" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_EQUAL;
        }
        if str_equals(fn_name, "pthread_once" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ONCE;
        }
        if str_equals(fn_name, "pthread_exit" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_EXIT;
        }
        if str_equals(fn_name, "pthread_attr_init" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_INIT;
        }
        if str_equals(fn_name, "pthread_attr_getstacksize" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETSTACKSIZE;
        }
        if str_equals(fn_name, "pthread_attr_setstacksize" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_SETSTACKSIZE;
        }
        if str_equals(fn_name, "pthread_attr_getdetachstate" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_GETDETACHSTATE;
        }
        if str_equals(fn_name, "pthread_attr_setdetachstate" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_ATTR_SETDETACHSTATE;
        }
        if str_equals(fn_name, "pthread_cond_timedwait" as &byte) != 0 &&
            param_count == 3 && call_arg_count == 3 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_COND_TIMEDWAIT;
        }
        if str_equals(fn_name, "pthread_mutexattr_init" as &byte) != 0 &&
            param_count == 1 && call_arg_count == 1 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_INIT;
        }
        if str_equals(fn_name, "pthread_mutexattr_settype" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
            return ExecHostCallId.EXEC_HOST_CALL_PTHREAD_MUTEXATTR_SETTYPE;
        }
        if str_equals(fn_name, "pthread_mutexattr_gettype" as &byte) != 0 &&
            param_count == 2 && call_arg_count == 2 {
