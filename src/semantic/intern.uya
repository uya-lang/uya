// semantic/intern.uya - Dynamic string interning for SemanticDb names.

use libc;

const SEMANTIC_INTERN_MIN_CAPACITY: usize = 8usize;
const SEMANTIC_INTERN_MAX_BYTES: usize = 9223372036854775807usize;
const SEMANTIC_INTERN_MAX_ID: usize = 2147483647usize;
const SEMANTIC_INTERN_EMPTY: i32 = 0;
const SEMANTIC_INTERN_FILLED: i32 = 1;

/// 功能说明：字符串 intern 表中的开放寻址 entry。
/// 参数说明：无；由 `SemanticInternTable` 内部维护。
/// 返回值说明：无。
export struct SemanticInternEntry {
    hash: usize,
    name: &byte,
    len: usize,
    id: i32,
    state: i32,
}

/// 功能说明：动态扩容的字符串 intern 表。
/// 参数说明：无；调用 `semantic_intern_init` 后使用。
/// 返回值说明：无。
export struct SemanticInternTable {
    entries: &SemanticInternEntry,
    count: usize,
    capacity: usize,
    bytes: usize,
    realloc_count: i32,
    string_bytes: usize,
}

fn semantic_intern_add_overflows(a: usize, b: usize) i32 {
    if b > SEMANTIC_INTERN_MAX_BYTES {
        return 1;
    }
    if a > SEMANTIC_INTERN_MAX_BYTES - b {
        return 1;
    }
    return 0;
}

fn semantic_intern_mul_overflows(a: usize, b: usize) i32 {
    if a == 0usize || b == 0usize {
        return 0;
    }
    if a > SEMANTIC_INTERN_MAX_BYTES / b {
        return 1;
    }
    return 0;
}

fn semantic_intern_next_capacity(current: usize, min_capacity: usize) usize {
    var next: usize = current;
    if next < SEMANTIC_INTERN_MIN_CAPACITY {
        next = SEMANTIC_INTERN_MIN_CAPACITY;
    }
    while next < min_capacity {
        if next > SEMANTIC_INTERN_MAX_BYTES / 2usize {
            return min_capacity;
        }
        next = next * 2usize;
    }
    return next;
}

fn semantic_intern_strlen(name: &byte) usize {
    if name == null {
        return 0usize;
    }
    var len: usize = 0usize;
    while name[len] != 0 as byte {
        len = len + 1usize;
    }
    return len;
}

fn semantic_intern_hash_bytes(name: &byte, len: usize) usize {
    var hash: usize = 1469598103usize;
    var i: usize = 0usize;
    while i < len {
        hash = hash ^ (name[i] as usize);
        hash = hash * 16777619usize;
        i = i + 1usize;
    }
    if hash == 0usize {
        return 1usize;
    }
    return hash;
}

fn semantic_intern_bytes_equal(a: &byte, b: &byte, len: usize) i32 {
    if a == null || b == null {
        return 0;
    }
    var i: usize = 0usize;
    while i < len {
        if a[i] != b[i] {
            return 0;
        }
        i = i + 1usize;
    }
    return 1;
}

fn semantic_intern_load_limit(capacity: usize) usize {
    if capacity == 0usize {
        return 0usize;
    }
    return capacity - (capacity / 4usize);
}

fn semantic_intern_find_slot(
    entries: &SemanticInternEntry,
    capacity: usize,
    hash: usize,
    name: &byte,
    len: usize,
    found: &i32,
) usize {
    if entries == null || capacity == 0usize || found == null {
        return capacity;
    }
    var idx: usize = hash % capacity;
    var probes: usize = 0usize;
    while probes < capacity {
        const entry: &SemanticInternEntry = &entries[idx];
        if entry.state == SEMANTIC_INTERN_EMPTY {
            found[0] = 0;
            return idx;
        }
        if entry.state == SEMANTIC_INTERN_FILLED && entry.hash == hash && entry.len == len &&
            semantic_intern_bytes_equal(entry.name, name, len) != 0 {
            found[0] = 1;
            return idx;
        }
        idx = idx + 1usize;
        if idx >= capacity {
            idx = 0usize;
        }
        probes = probes + 1usize;
    }
    found[0] = 0;
    return capacity;
}

fn semantic_intern_put_existing(entries: &SemanticInternEntry, capacity: usize, entry: &SemanticInternEntry) i32 {
    if entries == null || entry == null {
        return -1;
    }
    var found: i32 = 0;
    const slot: usize = semantic_intern_find_slot(entries, capacity, entry.hash, entry.name, entry.len, &found);
    if slot >= capacity {
        return -1;
    }
    entries[slot] = entry[0];
    return 0;
}

fn semantic_intern_copy_name(name: &byte, len: usize) &byte {
    if name == null {
        return null;
    }
    if semantic_intern_add_overflows(len, 1usize) != 0 {
        return null;
    }
    const total: usize = len + 1usize;
    const copy: &byte = malloc(total) as &byte;
    if copy == null {
        return null;
    }
    _ = memcpy(copy as *byte, name as *const byte, len);
    copy[len] = 0 as byte;
    return copy;
}

/// 功能说明：初始化字符串 intern 表。
/// 参数说明：`table` 为待初始化 intern 表。
/// 返回值说明：无。
export fn semantic_intern_init(table: &SemanticInternTable) void {
    if table == null {
        return;
    }
    table.entries = null;
    table.count = 0usize;
    table.capacity = 0usize;
    table.bytes = 0usize;
    table.realloc_count = 0;
    table.string_bytes = 0usize;
}

/// 功能说明：将 intern 表 bucket 容量至少扩到 `min_capacity`。
/// 参数说明：`table` 为目标 intern 表，`min_capacity` 为所需最小 bucket 数。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn semantic_intern_reserve(table: &SemanticInternTable, min_capacity: usize) i32 {
    if table == null {
        return -1;
    }
    if min_capacity <= table.capacity {
        return 0;
    }
    const next_capacity: usize = semantic_intern_next_capacity(table.capacity, min_capacity);
    if semantic_intern_mul_overflows(next_capacity, @size_of(SemanticInternEntry)) != 0 {
        return -1;
    }
    const new_bytes: usize = next_capacity * @size_of(SemanticInternEntry);
    const new_entries: &SemanticInternEntry = realloc(null, new_bytes) as &SemanticInternEntry;
    if new_entries == null {
        return -1;
    }
    _ = memset(new_entries as *byte, 0, new_bytes);

    var i: usize = 0usize;
    while i < table.capacity {
        const entry: &SemanticInternEntry = &table.entries[i];
        if entry.state == SEMANTIC_INTERN_FILLED {
            if semantic_intern_put_existing(new_entries, next_capacity, entry) != 0 {
                free(new_entries as &void);
                return -1;
            }
        }
        i = i + 1usize;
    }

    if table.entries != null {
        free(table.entries as &void);
    }
    table.entries = new_entries;
    table.capacity = next_capacity;
    table.bytes = new_bytes;
    table.realloc_count = table.realloc_count + 1;
    return 0;
}

/// 功能说明：确保 intern 表能再插入一个名字且不超过负载因子阈值。
/// 参数说明：`table` 为目标 intern 表。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn semantic_intern_ensure_insert_capacity(table: &SemanticInternTable) i32 {
    if table == null {
        return -1;
    }
    if semantic_intern_add_overflows(table.count, 1usize) != 0 {
        return -1;
    }
    const next_count: usize = table.count + 1usize;
    if table.capacity == 0usize || next_count >= semantic_intern_load_limit(table.capacity) {
        var min_capacity: usize = SEMANTIC_INTERN_MIN_CAPACITY;
        if table.capacity > 0usize {
            if table.capacity > SEMANTIC_INTERN_MAX_BYTES / 2usize {
                return -1;
            }
            min_capacity = table.capacity * 2usize;
        }
        return semantic_intern_reserve(table, min_capacity);
    }
    return 0;
}

/// 功能说明：查找已 intern 的名字。
/// 参数说明：`table` 为 intern 表，`name` 为以 `\0` 结尾的名字。
/// 返回值说明：命中返回非负 ID，未命中或参数无效返回 `-1`。
export fn semantic_intern_find(table: &SemanticInternTable, name: &byte) i32 {
    if table == null || name == null || table.entries == null || table.capacity == 0usize {
        return -1;
    }
    const len: usize = semantic_intern_strlen(name);
    const hash: usize = semantic_intern_hash_bytes(name, len);
    var found: i32 = 0;
    const slot: usize = semantic_intern_find_slot(table.entries, table.capacity, hash, name, len, &found);
    if found == 0 || slot >= table.capacity {
        return -1;
    }
    return table.entries[slot].id;
}

/// 功能说明：查找或插入一个 interned name。
/// 参数说明：`table` 为 intern 表，`name` 为以 `\0` 结尾的名字。
/// 返回值说明：成功返回非负 ID，分配失败、容量溢出或参数无效返回 `-1`。
export fn semantic_intern_get_or_put(table: &SemanticInternTable, name: &byte) i32 {
    if table == null || name == null {
        return -1;
    }
    const len: usize = semantic_intern_strlen(name);
    const hash: usize = semantic_intern_hash_bytes(name, len);
    if table.entries != null && table.capacity > 0usize {
        var found: i32 = 0;
        const existing_slot: usize = semantic_intern_find_slot(table.entries, table.capacity, hash, name, len, &found);
        if found != 0 && existing_slot < table.capacity {
            return table.entries[existing_slot].id;
        }
    }
    if table.count > SEMANTIC_INTERN_MAX_ID {
        return -1;
    }
    if semantic_intern_ensure_insert_capacity(table) != 0 {
        return -1;
    }
    const copy: &byte = semantic_intern_copy_name(name, len);
    if copy == null {
        return -1;
    }
    var found2: i32 = 0;
    const slot: usize = semantic_intern_find_slot(table.entries, table.capacity, hash, copy, len, &found2);
    if slot >= table.capacity {
        free(copy as &void);
        return -1;
    }
    const id_tmp: !i32 = table.count as! i32;
    const id: i32 = id_tmp catch {
        free(copy as &void);
        return -1;
    };
    table.entries[slot].hash = hash;
    table.entries[slot].name = copy;
    table.entries[slot].len = len;
    table.entries[slot].id = id;
    table.entries[slot].state = SEMANTIC_INTERN_FILLED;
    table.count = table.count + 1usize;
    if semantic_intern_add_overflows(table.string_bytes, len + 1usize) != 0 {
        return id;
    }
    table.string_bytes = table.string_bytes + len + 1usize;
    return id;
}

/// 功能说明：按 ID 取回 interned name。
/// 参数说明：`table` 为 intern 表，`id` 为 `semantic_intern_get_or_put` 返回的 ID。
/// 返回值说明：命中返回名字指针，未命中或参数无效返回 null。
export fn semantic_intern_name(table: &SemanticInternTable, id: i32) &byte {
    if table == null || id < 0 || table.entries == null {
        return null;
    }
    var i: usize = 0usize;
    while i < table.capacity {
        const entry: &SemanticInternEntry = &table.entries[i];
        if entry.state == SEMANTIC_INTERN_FILLED && entry.id == id {
            return entry.name;
        }
        i = i + 1usize;
    }
    return null;
}

/// 功能说明：返回 intern 表 bucket 重分配次数。
/// 参数说明：`table` 为 intern 表。
/// 返回值说明：返回 `realloc_count`；参数无效时返回 `0`。
export fn semantic_intern_realloc_count(table: &SemanticInternTable) i32 {
    if table == null {
        return 0;
    }
    return table.realloc_count;
}

/// 功能说明：清空 intern 表内容但保留 bucket 容量。
/// 参数说明：`table` 为 intern 表。
/// 返回值说明：无。
export fn semantic_intern_reset(table: &SemanticInternTable) void {
    if table == null {
        return;
    }
    if table.entries != null {
        var i: usize = 0usize;
        while i < table.capacity {
            if table.entries[i].state == SEMANTIC_INTERN_FILLED && table.entries[i].name != null {
                free(table.entries[i].name as &void);
            }
            i = i + 1usize;
        }
        if table.bytes > 0usize {
            _ = memset(table.entries as *byte, 0, table.bytes);
        }
    }
    table.count = 0usize;
    table.string_bytes = 0usize;
}

/// 功能说明：释放 intern 表 bucket 和字符串存储。
/// 参数说明：`table` 为 intern 表。
/// 返回值说明：无。
export fn semantic_intern_free(table: &SemanticInternTable) void {
    if table == null {
        return;
    }
    semantic_intern_reset(table);
    if table.entries != null {
        free(table.entries as &void);
    }
    semantic_intern_init(table);
}

/// 功能说明：释放 intern 表；与 `semantic_intern_free` 等价。
/// 参数说明：`table` 为 intern 表。
/// 返回值说明：无。
export fn semantic_intern_release(table: &SemanticInternTable) void {
    semantic_intern_free(table);
}
