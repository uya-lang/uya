// semantic/build.uya - Build a SemanticDb from the merged AST root.

fn semantic_db_cstr_equals(a: &byte, b: &byte) i32 {
    if a == null || b == null {
        return 0;
    }
    var i: usize = 0usize;
    while a[i] != 0 as byte && b[i] != 0 as byte {
        if a[i] != b[i] {
            return 0;
        }
        i = i + 1usize;
    }
    if a[i] == b[i] {
        return 1;
    }
    return 0;
}

fn semantic_db_decl_primary_name(decl: &ASTNode) &byte {
    if decl == null {
        return null;
    }
    if decl.type == ASTNodeType.AST_FN_DECL {
        return decl.fn_decl_name;
    } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
        return decl.struct_decl_name;
    } else if decl.type == ASTNodeType.AST_UNION_DECL {
        return decl.union_decl_name;
    } else if decl.type == ASTNodeType.AST_INTERFACE_DECL {
        return decl.interface_decl_name;
    } else if decl.type == ASTNodeType.AST_ENUM_DECL {
        return decl.enum_decl_name;
    } else if decl.type == ASTNodeType.AST_TYPE_ALIAS {
        return decl.type_alias_name;
    } else if decl.type == ASTNodeType.AST_VAR_DECL {
        return decl.var_decl_name;
    } else if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return decl.extern_var_decl_name;
    } else if decl.type == ASTNodeType.AST_ERROR_DECL {
        return decl.error_decl_name;
    } else if decl.type == ASTNodeType.AST_MACRO_DECL {
        return decl.macro_decl_name;
    }
    return null;
}

fn semantic_db_filename_seen_before(program: &ASTNode, limit: i32, filename: &byte) i32 {
    if program == null || filename == null {
        return 0;
    }
    if semantic_db_cstr_equals(program.filename, filename) != 0 {
        return 1;
    }
    var i: i32 = 0;
    while i < limit {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && semantic_db_cstr_equals(decl.filename, filename) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_count_unique_files(program: &ASTNode) i32 {
    if program == null {
        return 0;
    }
    var count: i32 = 0;
    if program.filename != null {
        count = 1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.filename != null &&
            semantic_db_filename_seen_before(program, i, decl.filename) == 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn semantic_db_prepare_for_build(db: &SemanticDb) void {
    if db == null {
        return;
    }
    if db.decl_records.item_size != @size_of(SemanticDeclRecord) ||
        db.symbol_records.item_size != @size_of(SemanticSymbolRecord) ||
        db.name_ranges.item_size != @size_of(SemanticNameRange) ||
        db.name_range_index.capacity < db.name_range_index.count {
        semantic_db_init(db);
        return;
    }
    semantic_db_reset(db);
}

/// 功能说明：按 DeclId 取回顶层声明 AST 节点。
/// 参数说明：`db` 为目标 SemanticDb，`decl_id` 为构建阶段分配的声明 ID。
/// 返回值说明：命中返回 AST 节点指针；参数无效或越界时返回 null。
export fn semantic_db_decl_ast_node(db: &SemanticDb, decl_id: i32) &ASTNode {
    if db == null || decl_id < 0 {
        return null;
    }
    const record_ptr: &byte = semantic_vector_item_ptr(&db.decl_records, decl_id as usize);
    if record_ptr == null {
        return null;
    }
    const record: &SemanticDeclRecord = record_ptr as &SemanticDeclRecord;
    if record.ast_node == null {
        return null;
    }
    return record.ast_node as &ASTNode;
}

fn semantic_db_append_named_symbol(db: &SemanticDb, decl_id: i32, kind: i32) i32 {
    if db == null || decl_id < 0 {
        return -1;
    }
    const name_id: i32 = db.interned_name_count;
    const symbol_id: i32 = semantic_db_append_symbol_record(db, name_id, decl_id, kind);
    if symbol_id < 0 {
        return -1;
    }
    if semantic_db_append_name_range(db, name_id, symbol_id, 1) < 0 {
        return -1;
    }
    db.symbol_count = db.symbol_count + 1;
    db.interned_name_count = db.interned_name_count + 1;
    return name_id;
}

fn semantic_db_count_method_symbols(db: &SemanticDb, methods: & & ASTNode, method_count: i32, owner_decl_id: i32) i32 {
    if db == null || methods == null || method_count <= 0 {
        return 0;
    }
    var i: i32 = 0;
    while i < method_count {
        const method: &ASTNode = methods[i];
        if method != null && method.type == ASTNodeType.AST_FN_DECL {
            db.function_count = db.function_count + 1;
            if method.fn_decl_name != null {
                if semantic_db_append_named_symbol(db, owner_decl_id, method.type as i32) < 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_count_decl(db: &SemanticDb, decl: &ASTNode) i32 {
    if db == null || decl == null {
        return 0;
    }
    const primary_name: &byte = semantic_db_decl_primary_name(decl);
    var primary_name_id: i32 = -1;
    if primary_name != null {
        primary_name_id = db.interned_name_count;
    }

    const decl_id: i32 = semantic_db_append_decl_record(db, decl as &void, primary_name_id, decl.type as i32, 0, 0);
    if decl_id < 0 {
        return -1;
    }
    db.decl_count = db.decl_count + 1;

    if primary_name != null {
        if semantic_db_append_named_symbol(db, decl_id, decl.type as i32) < 0 {
            return -1;
        }
    }

    if decl.type == ASTNodeType.AST_FN_DECL {
        db.function_count = db.function_count + 1;
    } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_count_method_symbols(db, decl.struct_decl_methods, decl.struct_decl_method_count, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_UNION_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_count_method_symbols(db, decl.union_decl_methods, decl.union_decl_method_count, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_INTERFACE_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_count_method_symbols(db, decl.interface_decl_method_sigs, decl.interface_decl_method_sig_count, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_ENUM_DECL {
        db.type_count = db.type_count + 1;
    } else if decl.type == ASTNodeType.AST_TYPE_ALIAS {
        db.type_count = db.type_count + 1;
    } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
        if semantic_db_count_method_symbols(db, decl.method_block_methods, decl.method_block_method_count, decl_id) != 0 {
            return -1;
        }
    }
    return 0;
}

fn semantic_db_update_estimated_bytes(db: &SemanticDb) void {
    if db == null {
        return;
    }
    db.estimated_bytes = semantic_db_storage_bytes(db);
}

/// 功能说明：从已合并的 `AST_PROGRAM` 根节点构建 SemanticDb 基础计数。
/// 参数说明：`db` 为输出数据库，`program` 为 `ast_merge_programs` 后的程序根。
/// 返回值说明：成功返回 `0`；参数无效或输入不是 merged program 时返回 `-1`。
export fn semantic_db_build_from_merged_ast(db: &SemanticDb, program: &ASTNode) i32 {
    if db == null || program == null || program.type != ASTNodeType.AST_PROGRAM {
        return -1;
    }
    if program.program_decl_count > 0 && program.program_decls == null {
        return -1;
    }

    semantic_db_prepare_for_build(db);
    if program.program_decl_count > 0 {
        if semantic_vector_ensure_capacity(&db.decl_records, program.program_decl_count as usize) != 0 {
            return -1;
        }
    }
    db.file_count = semantic_db_count_unique_files(program);
    db.module_count = db.file_count;

    var i: i32 = 0;
    while i < program.program_decl_count {
        if semantic_db_count_decl(db, program.program_decls[i]) != 0 {
            semantic_db_reset(db);
            return -1;
        }
        i = i + 1;
    }
    semantic_db_update_estimated_bytes(db);
    return 0;
}
