// semantic/build.uya - Build a SemanticDb from the merged AST root.

fn semantic_db_cstr_equals(a: &byte, b: &byte) i32 {
    if a == null || b == null {
        return 0;
    }
    var i: usize = 0usize;
    while a[i] != 0 as byte && b[i] != 0 as byte {
        if a[i] != b[i] {
            return 0;
        }
        i = i + 1usize;
    }
    if a[i] == b[i] {
        return 1;
    }
    return 0;
}

fn semantic_db_decl_primary_name(decl: &ASTNode) &byte {
    if decl == null {
        return null;
    }
    if decl.type == ASTNodeType.AST_FN_DECL {
        return decl.fn_decl_name;
    } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
        return decl.struct_decl_name;
    } else if decl.type == ASTNodeType.AST_UNION_DECL {
        return decl.union_decl_name;
    } else if decl.type == ASTNodeType.AST_INTERFACE_DECL {
        return decl.interface_decl_name;
    } else if decl.type == ASTNodeType.AST_ENUM_DECL {
        return decl.enum_decl_name;
    } else if decl.type == ASTNodeType.AST_TYPE_ALIAS {
        return decl.type_alias_name;
    } else if decl.type == ASTNodeType.AST_VAR_DECL {
        return decl.var_decl_name;
    } else if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        return decl.extern_var_decl_name;
    } else if decl.type == ASTNodeType.AST_ERROR_DECL {
        return decl.error_decl_name;
    } else if decl.type == ASTNodeType.AST_MACRO_DECL {
        return decl.macro_decl_name;
    }
    return null;
}

fn semantic_db_filename_seen_before(program: &ASTNode, limit: i32, filename: &byte) i32 {
    if program == null || filename == null {
        return 0;
    }
    if semantic_db_cstr_equals(program.filename, filename) != 0 {
        return 1;
    }
    var i: i32 = 0;
    while i < limit {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && semantic_db_cstr_equals(decl.filename, filename) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_count_unique_files(program: &ASTNode) i32 {
    if program == null {
        return 0;
    }
    var count: i32 = 0;
    if program.filename != null {
        count = 1;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.filename != null &&
            semantic_db_filename_seen_before(program, i, decl.filename) == 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn semantic_db_prepare_for_build(db: &SemanticDb) void {
    if db == null {
        return;
    }
    if db.file_records.item_size != @size_of(SemanticFileRecord) ||
        db.module_records.item_size != @size_of(SemanticModuleRecord) ||
        db.decl_records.item_size != @size_of(SemanticDeclRecord) ||
        db.symbol_records.item_size != @size_of(SemanticSymbolRecord) ||
        db.name_ranges.item_size != @size_of(SemanticNameRange) ||
        db.name_range_index.capacity < db.name_range_index.count ||
        db.decl_ranges.item_size != @size_of(SemanticDeclRange) ||
        db.decl_range_ids.item_size != @size_of(i32) ||
        db.decls_by_name.capacity < db.decls_by_name.count ||
        db.function_ranges.item_size != @size_of(SemanticFunctionOverloadRange) ||
        db.function_range_decl_ids.item_size != @size_of(i32) ||
        db.functions_by_name.capacity < db.functions_by_name.count ||
        db.type_ranges.item_size != @size_of(SemanticTypeDeclRange) ||
        db.type_range_decl_ids.item_size != @size_of(i32) ||
        db.types_by_name.capacity < db.types_by_name.count ||
        db.enum_variant_records.item_size != @size_of(SemanticEnumVariantRecord) ||
        db.enum_variant_ranges.item_size != @size_of(SemanticEnumVariantRange) ||
        db.enum_variant_range_record_ids.item_size != @size_of(i32) ||
        db.enum_variants_by_name.capacity < db.enum_variants_by_name.count ||
        db.import_bindings.item_size != @size_of(SemanticImportBinding) ||
        db.export_bindings.item_size != @size_of(SemanticExportBinding) ||
        db.exports_by_module_name.capacity < db.exports_by_module_name.count ||
        db.aliases_by_file_name.capacity < db.aliases_by_file_name.count {
        semantic_db_init(db);
        return;
    }
    semantic_db_reset(db);
}

/// 功能说明：按 DeclId 取回顶层声明 AST 节点。
/// 参数说明：`db` 为目标 SemanticDb，`decl_id` 为构建阶段分配的声明 ID。
/// 返回值说明：命中返回 AST 节点指针；参数无效或越界时返回 null。
export fn semantic_db_decl_ast_node(db: &SemanticDb, decl_id: i32) &ASTNode {
    if db == null || decl_id < 0 {
        return null;
    }
    const record_ptr: &byte = semantic_vector_item_ptr(&db.decl_records, decl_id as usize);
    if record_ptr == null {
        return null;
    }
    const record: &SemanticDeclRecord = record_ptr as &SemanticDeclRecord;
    if record.ast_node == null {
        return null;
    }
    return record.ast_node as &ASTNode;
}

fn semantic_db_find_file_id(db: &SemanticDb, filename: &byte) i32 {
    if db == null || filename == null {
        return -1;
    }
    var i: i32 = 0;
    while i < semantic_db_file_record_count(db) {
        if semantic_db_cstr_equals(semantic_db_file_name(db, i), filename) != 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn semantic_db_add_file_module(db: &SemanticDb, filename: &byte) i32 {
    if db == null || filename == null {
        return -1;
    }
    const existing: i32 = semantic_db_find_file_id(db, filename);
    if existing >= 0 {
        return existing;
    }
    const file_id: i32 = semantic_db_append_file_record(db, filename);
    if file_id < 0 {
        return -1;
    }
    const module_id: i32 = semantic_db_append_module_record(db, filename, file_id);
    if module_id < 0 {
        return -1;
    }
    return file_id;
}

fn semantic_db_build_file_module_ids(db: &SemanticDb, program: &ASTNode) i32 {
    if db == null || program == null {
        return -1;
    }
    if program.filename != null {
        if semantic_db_add_file_module(db, program.filename) < 0 {
            return -1;
        }
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl != null && decl.filename != null {
            if semantic_db_add_file_module(db, decl.filename) < 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    db.file_count = semantic_db_file_record_count(db);
    db.module_count = semantic_db_module_record_count(db);
    return 0;
}

fn semantic_db_use_binding_name(decl: &ASTNode) &byte {
    if decl == null || decl.type != ASTNodeType.AST_USE_STMT {
        return null;
    }
    if decl.use_stmt_alias != null {
        return decl.use_stmt_alias;
    }
    if decl.use_stmt_item_name != null {
        return decl.use_stmt_item_name;
    }
    if decl.use_stmt_path_segments != null && decl.use_stmt_path_segment_count > 0 {
        const last_index: i32 = decl.use_stmt_path_segment_count - 1;
        return decl.use_stmt_path_segments[last_index];
    }
    return null;
}

fn semantic_db_append_named_symbol(db: &SemanticDb, name_id: i32, decl_id: i32, kind: i32) i32 {
    if db == null || name_id < 0 || decl_id < 0 {
        return -1;
    }
    const symbol_id: i32 = semantic_db_append_symbol_record(db, name_id, decl_id, kind);
    if symbol_id < 0 {
        return -1;
    }
    if semantic_db_append_name_range(db, name_id, symbol_id, 1) < 0 {
        return -1;
    }
    db.symbol_count = db.symbol_count + 1;
    return symbol_id;
}

fn semantic_db_count_method_symbols(db: &SemanticDb, methods: & & ASTNode, method_count: i32, owner_decl_id: i32) i32 {
    if db == null || methods == null || method_count <= 0 {
        return 0;
    }
    var i: i32 = 0;
    while i < method_count {
        const method: &ASTNode = methods[i];
        if method != null && method.type == ASTNodeType.AST_FN_DECL {
            db.function_count = db.function_count + 1;
            if method.fn_decl_name != null {
                const name_id: i32 = semantic_intern_get_or_put(&db.name_intern, method.fn_decl_name);
                if name_id < 0 {
                    return -1;
                }
                if semantic_db_append_named_symbol(db, name_id, owner_decl_id, method.type as i32) < 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_append_enum_variant_records(db: &SemanticDb, decl: &ASTNode, enum_decl_id: i32) i32 {
    if db == null || decl == null || decl.type != ASTNodeType.AST_ENUM_DECL {
        return 0;
    }
    if enum_decl_id < 0 {
        return -1;
    }
    if decl.enum_decl_variant_count <= 0 {
        return 0;
    }
    if decl.enum_decl_variants == null {
        return -1;
    }
    var i: i32 = 0;
    while i < decl.enum_decl_variant_count {
        const variant_name: &byte = decl.enum_decl_variants[i].name;
        if variant_name != null {
            const name_id: i32 = semantic_intern_get_or_put(&db.name_intern, variant_name);
            if name_id < 0 {
                return -1;
            }
            if semantic_db_append_enum_variant_record(db, name_id, enum_decl_id, i) < 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_count_decl(db: &SemanticDb, decl: &ASTNode, file_id: i32, module_id: i32) i32 {
    if db == null || decl == null {
        return 0;
    }
    const primary_name: &byte = semantic_db_decl_primary_name(decl);
    var primary_name_id: i32 = -1;
    if primary_name != null {
        primary_name_id = semantic_intern_get_or_put(&db.name_intern, primary_name);
        if primary_name_id < 0 {
            return -1;
        }
    }

    const decl_id: i32 = semantic_db_append_decl_record(db, decl as &void, primary_name_id, decl.type as i32, file_id, module_id);
    if decl_id < 0 {
        return -1;
    }
    db.decl_count = db.decl_count + 1;

    if decl.type == ASTNodeType.AST_USE_STMT {
        const import_name: &byte = semantic_db_use_binding_name(decl);
        if import_name != null {
            if semantic_db_append_import_binding(db, file_id, module_id, import_name, decl as &void) < 0 {
                return -1;
            }
        }
    }

    if primary_name != null {
        const symbol_id: i32 = semantic_db_append_named_symbol(db, primary_name_id, decl_id, decl.type as i32);
        if symbol_id < 0 {
            return -1;
        }
        if semantic_db_append_export_binding(db, file_id, module_id, primary_name, decl_id, symbol_id) < 0 {
            return -1;
        }
    }

    if decl.type == ASTNodeType.AST_FN_DECL {
        db.function_count = db.function_count + 1;
    } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_count_method_symbols(db, decl.struct_decl_methods, decl.struct_decl_method_count, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_UNION_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_count_method_symbols(db, decl.union_decl_methods, decl.union_decl_method_count, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_INTERFACE_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_count_method_symbols(db, decl.interface_decl_method_sigs, decl.interface_decl_method_sig_count, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_ENUM_DECL {
        db.type_count = db.type_count + 1;
        if semantic_db_append_enum_variant_records(db, decl, decl_id) != 0 {
            return -1;
        }
    } else if decl.type == ASTNodeType.AST_TYPE_ALIAS {
        db.type_count = db.type_count + 1;
    } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
        if semantic_db_count_method_symbols(db, decl.method_block_methods, decl.method_block_method_count, decl_id) != 0 {
            return -1;
        }
    }
    return 0;
}

fn semantic_db_i32_from_usize(value: usize) i32 {
    const converted_tmp: !i32 = value as! i32;
    const converted: i32 = converted_tmp catch {
        return -1;
    };
    return converted;
}

fn semantic_db_decl_range_ptr(db: &SemanticDb, range_id: i32) &SemanticDeclRange {
    if db == null || range_id < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.decl_ranges, range_id as usize);
    if ptr == null {
        return null;
    }
    return ptr as &SemanticDeclRange;
}

fn semantic_db_decl_id_slot(db: &SemanticDb, index: i32) &i32 {
    if db == null || index < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.decl_range_ids, index as usize);
    if ptr == null {
        return null;
    }
    return ptr as &i32;
}

fn semantic_db_count_decl_range_name(db: &SemanticDb, name_id: i32) i32 {
    if db == null || name_id < 0 {
        return -1;
    }
    var range_id: i32 = -1;
    if semantic_hash_get(&db.decls_by_name, name_id as i64, &range_id) == 0 {
        if semantic_db_append_decl_range(db, name_id, 0, 1) < 0 {
            return -1;
        }
        return 0;
    }
    const range: &SemanticDeclRange = semantic_db_decl_range_ptr(db, range_id);
    if range == null {
        return -1;
    }
    range.decl_count = range.decl_count + 1;
    return 0;
}

fn semantic_db_collect_decl_range_counts(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{ ast_node: null, name_id: -1, kind: -1, file_id: -1, module_id: -1 };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 {
            if semantic_db_count_decl_range_name(db, record.name_id) != 0 {
                return -1;
            }
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_prefix_decl_ranges(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var start: i32 = 0;
    var range_id: i32 = 0;
    while range_id < semantic_db_decl_range_count(db) {
        const range: &SemanticDeclRange = semantic_db_decl_range_ptr(db, range_id);
        if range == null {
            return -1;
        }
        range.decl_start = start;
        start = start + range.decl_count;
        range_id = range_id + 1;
    }

    var placeholder: i32 = -1;
    var i: i32 = 0;
    while i < start {
        if semantic_vector_append(&db.decl_range_ids, &placeholder as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_build_decl_range_cursors(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    semantic_vector_init(cursors, @size_of(i32));
    var zero: i32 = 0;
    var i: i32 = 0;
    while i < semantic_db_decl_range_count(db) {
        if semantic_vector_append(cursors, &zero as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_cursor_ptr(cursors: &SemanticVector, range_id: i32) &i32 {
    if cursors == null || range_id < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(cursors, range_id as usize);
    if ptr == null {
        return null;
    }
    return ptr as &i32;
}

fn semantic_db_fill_decl_ranges(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{ ast_node: null, name_id: -1, kind: -1, file_id: -1, module_id: -1 };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 {
            var range_id: i32 = -1;
            if semantic_hash_get(&db.decls_by_name, record.name_id as i64, &range_id) == 0 {
                return -1;
            }
            const range: &SemanticDeclRange = semantic_db_decl_range_ptr(db, range_id);
            const cursor: &i32 = semantic_db_cursor_ptr(cursors, range_id);
            if range == null || cursor == null {
                return -1;
            }
            const slot_index: i32 = range.decl_start + cursor[0];
            const slot: &i32 = semantic_db_decl_id_slot(db, slot_index);
            if slot == null {
                return -1;
            }
            slot[0] = decl_id;
            cursor[0] = cursor[0] + 1;
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_rebuild_decls_by_name(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    semantic_vector_reset(&db.decl_ranges);
    semantic_vector_reset(&db.decl_range_ids);
    semantic_hash_reset(&db.decls_by_name);
    if semantic_db_collect_decl_range_counts(db) != 0 {
        return -1;
    }
    if semantic_db_prefix_decl_ranges(db) != 0 {
        return -1;
    }

    var cursors: SemanticVector = SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
    if semantic_db_build_decl_range_cursors(db, &cursors) != 0 {
        semantic_vector_release(&cursors);
        return -1;
    }
    const filled: i32 = semantic_db_fill_decl_ranges(db, &cursors);
    semantic_vector_release(&cursors);
    return filled;
}

fn semantic_db_function_range_ptr(db: &SemanticDb, range_id: i32) &SemanticFunctionOverloadRange {
    if db == null || range_id < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.function_ranges, range_id as usize);
    if ptr == null {
        return null;
    }
    return ptr as &SemanticFunctionOverloadRange;
}

fn semantic_db_function_decl_id_slot(db: &SemanticDb, index: i32) &i32 {
    if db == null || index < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.function_range_decl_ids, index as usize);
    if ptr == null {
        return null;
    }
    return ptr as &i32;
}

fn semantic_db_count_function_range_name(db: &SemanticDb, name_id: i32) i32 {
    if db == null || name_id < 0 {
        return -1;
    }
    var range_id: i32 = -1;
    if semantic_hash_get(&db.functions_by_name, name_id as i64, &range_id) == 0 {
        if semantic_db_append_function_overload_range(db, name_id, 0, 1) < 0 {
            return -1;
        }
        return 0;
    }
    const range: &SemanticFunctionOverloadRange = semantic_db_function_range_ptr(db, range_id);
    if range == null {
        return -1;
    }
    range.function_count = range.function_count + 1;
    return 0;
}

fn semantic_db_collect_function_range_counts(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{ ast_node: null, name_id: -1, kind: -1, file_id: -1, module_id: -1 };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 && record.kind == ASTNodeType.AST_FN_DECL as i32 {
            if semantic_db_count_function_range_name(db, record.name_id) != 0 {
                return -1;
            }
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_prefix_function_ranges(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var start: i32 = 0;
    var range_id: i32 = 0;
    while range_id < semantic_db_function_overload_range_count(db) {
        const range: &SemanticFunctionOverloadRange = semantic_db_function_range_ptr(db, range_id);
        if range == null {
            return -1;
        }
        range.function_start = start;
        start = start + range.function_count;
        range_id = range_id + 1;
    }

    var placeholder: i32 = -1;
    var i: i32 = 0;
    while i < start {
        if semantic_vector_append(&db.function_range_decl_ids, &placeholder as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_build_function_range_cursors(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    semantic_vector_init(cursors, @size_of(i32));
    var zero: i32 = 0;
    var i: i32 = 0;
    while i < semantic_db_function_overload_range_count(db) {
        if semantic_vector_append(cursors, &zero as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_fill_function_ranges(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{ ast_node: null, name_id: -1, kind: -1, file_id: -1, module_id: -1 };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 && record.kind == ASTNodeType.AST_FN_DECL as i32 {
            var range_id: i32 = -1;
            if semantic_hash_get(&db.functions_by_name, record.name_id as i64, &range_id) == 0 {
                return -1;
            }
            const range: &SemanticFunctionOverloadRange = semantic_db_function_range_ptr(db, range_id);
            const cursor: &i32 = semantic_db_cursor_ptr(cursors, range_id);
            if range == null || cursor == null {
                return -1;
            }
            const slot_index: i32 = range.function_start + cursor[0];
            const slot: &i32 = semantic_db_function_decl_id_slot(db, slot_index);
            if slot == null {
                return -1;
            }
            slot[0] = decl_id;
            cursor[0] = cursor[0] + 1;
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_rebuild_functions_by_name(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    semantic_vector_reset(&db.function_ranges);
    semantic_vector_reset(&db.function_range_decl_ids);
    semantic_hash_reset(&db.functions_by_name);
    if semantic_db_collect_function_range_counts(db) != 0 {
        return -1;
    }
    if semantic_db_prefix_function_ranges(db) != 0 {
        return -1;
    }

    var cursors: SemanticVector = SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
    if semantic_db_build_function_range_cursors(db, &cursors) != 0 {
        semantic_vector_release(&cursors);
        return -1;
    }
    const filled: i32 = semantic_db_fill_function_ranges(db, &cursors);
    semantic_vector_release(&cursors);
    return filled;
}

fn semantic_db_is_type_decl_kind(kind: i32) i32 {
    if kind == ASTNodeType.AST_STRUCT_DECL as i32 ||
        kind == ASTNodeType.AST_UNION_DECL as i32 ||
        kind == ASTNodeType.AST_INTERFACE_DECL as i32 ||
        kind == ASTNodeType.AST_ENUM_DECL as i32 ||
        kind == ASTNodeType.AST_TYPE_ALIAS as i32 {
        return 1;
    }
    return 0;
}

fn semantic_db_type_range_ptr(db: &SemanticDb, range_id: i32) &SemanticTypeDeclRange {
    if db == null || range_id < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.type_ranges, range_id as usize);
    if ptr == null {
        return null;
    }
    return ptr as &SemanticTypeDeclRange;
}

fn semantic_db_type_decl_id_slot(db: &SemanticDb, index: i32) &i32 {
    if db == null || index < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.type_range_decl_ids, index as usize);
    if ptr == null {
        return null;
    }
    return ptr as &i32;
}

fn semantic_db_count_type_range_name(db: &SemanticDb, name_id: i32) i32 {
    if db == null || name_id < 0 {
        return -1;
    }
    var range_id: i32 = -1;
    if semantic_hash_get(&db.types_by_name, name_id as i64, &range_id) == 0 {
        if semantic_db_append_type_decl_range(db, name_id, 0, 1) < 0 {
            return -1;
        }
        return 0;
    }
    const range: &SemanticTypeDeclRange = semantic_db_type_range_ptr(db, range_id);
    if range == null {
        return -1;
    }
    range.type_count = range.type_count + 1;
    return 0;
}

fn semantic_db_collect_type_range_counts(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{ ast_node: null, name_id: -1, kind: -1, file_id: -1, module_id: -1 };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 && semantic_db_is_type_decl_kind(record.kind) != 0 {
            if semantic_db_count_type_range_name(db, record.name_id) != 0 {
                return -1;
            }
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_prefix_type_ranges(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var start: i32 = 0;
    var range_id: i32 = 0;
    while range_id < semantic_db_type_decl_range_count(db) {
        const range: &SemanticTypeDeclRange = semantic_db_type_range_ptr(db, range_id);
        if range == null {
            return -1;
        }
        range.type_start = start;
        start = start + range.type_count;
        range_id = range_id + 1;
    }

    var placeholder: i32 = -1;
    var i: i32 = 0;
    while i < start {
        if semantic_vector_append(&db.type_range_decl_ids, &placeholder as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_build_type_range_cursors(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    semantic_vector_init(cursors, @size_of(i32));
    var zero: i32 = 0;
    var i: i32 = 0;
    while i < semantic_db_type_decl_range_count(db) {
        if semantic_vector_append(cursors, &zero as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_fill_type_ranges(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{ ast_node: null, name_id: -1, kind: -1, file_id: -1, module_id: -1 };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 && semantic_db_is_type_decl_kind(record.kind) != 0 {
            var range_id: i32 = -1;
            if semantic_hash_get(&db.types_by_name, record.name_id as i64, &range_id) == 0 {
                return -1;
            }
            const range: &SemanticTypeDeclRange = semantic_db_type_range_ptr(db, range_id);
            const cursor: &i32 = semantic_db_cursor_ptr(cursors, range_id);
            if range == null || cursor == null {
                return -1;
            }
            const slot_index: i32 = range.type_start + cursor[0];
            const slot: &i32 = semantic_db_type_decl_id_slot(db, slot_index);
            if slot == null {
                return -1;
            }
            slot[0] = decl_id;
            cursor[0] = cursor[0] + 1;
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_rebuild_types_by_name(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    semantic_vector_reset(&db.type_ranges);
    semantic_vector_reset(&db.type_range_decl_ids);
    semantic_hash_reset(&db.types_by_name);
    if semantic_db_collect_type_range_counts(db) != 0 {
        return -1;
    }
    if semantic_db_prefix_type_ranges(db) != 0 {
        return -1;
    }

    var cursors: SemanticVector = SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
    if semantic_db_build_type_range_cursors(db, &cursors) != 0 {
        semantic_vector_release(&cursors);
        return -1;
    }
    const filled: i32 = semantic_db_fill_type_ranges(db, &cursors);
    semantic_vector_release(&cursors);
    return filled;
}

fn semantic_db_enum_variant_range_ptr(db: &SemanticDb, range_id: i32) &SemanticEnumVariantRange {
    if db == null || range_id < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.enum_variant_ranges, range_id as usize);
    if ptr == null {
        return null;
    }
    return ptr as &SemanticEnumVariantRange;
}

fn semantic_db_enum_variant_record_id_slot(db: &SemanticDb, index: i32) &i32 {
    if db == null || index < 0 {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.enum_variant_range_record_ids, index as usize);
    if ptr == null {
        return null;
    }
    return ptr as &i32;
}

fn semantic_db_count_enum_variant_range_name(db: &SemanticDb, name_id: i32) i32 {
    if db == null || name_id < 0 {
        return -1;
    }
    var range_id: i32 = -1;
    if semantic_hash_get(&db.enum_variants_by_name, name_id as i64, &range_id) == 0 {
        if semantic_db_append_enum_variant_range(db, name_id, 0, 1) < 0 {
            return -1;
        }
        return 0;
    }
    const range: &SemanticEnumVariantRange = semantic_db_enum_variant_range_ptr(db, range_id);
    if range == null {
        return -1;
    }
    range.variant_count = range.variant_count + 1;
    return 0;
}

fn semantic_db_collect_enum_variant_range_counts(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var record_id: i32 = 0;
    while record_id < semantic_db_enum_variant_record_count(db) {
        var record: SemanticEnumVariantRecord = SemanticEnumVariantRecord{ name_id: -1, enum_decl_id: -1, variant_index: -1 };
        if semantic_db_enum_variant_record_get(db, record_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 {
            if semantic_db_count_enum_variant_range_name(db, record.name_id) != 0 {
                return -1;
            }
        }
        record_id = record_id + 1;
    }
    return 0;
}

fn semantic_db_prefix_enum_variant_ranges(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    var start: i32 = 0;
    var range_id: i32 = 0;
    while range_id < semantic_db_enum_variant_range_count(db) {
        const range: &SemanticEnumVariantRange = semantic_db_enum_variant_range_ptr(db, range_id);
        if range == null {
            return -1;
        }
        range.variant_start = start;
        start = start + range.variant_count;
        range_id = range_id + 1;
    }

    var placeholder: i32 = -1;
    var i: i32 = 0;
    while i < start {
        if semantic_vector_append(&db.enum_variant_range_record_ids, &placeholder as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_build_enum_variant_range_cursors(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    semantic_vector_init(cursors, @size_of(i32));
    var zero: i32 = 0;
    var i: i32 = 0;
    while i < semantic_db_enum_variant_range_count(db) {
        if semantic_vector_append(cursors, &zero as &const void) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn semantic_db_fill_enum_variant_ranges(db: &SemanticDb, cursors: &SemanticVector) i32 {
    if db == null || cursors == null {
        return -1;
    }
    var record_id: i32 = 0;
    while record_id < semantic_db_enum_variant_record_count(db) {
        var record: SemanticEnumVariantRecord = SemanticEnumVariantRecord{ name_id: -1, enum_decl_id: -1, variant_index: -1 };
        if semantic_db_enum_variant_record_get(db, record_id, &record) == 0 {
            return -1;
        }
        if record.name_id >= 0 {
            var range_id: i32 = -1;
            if semantic_hash_get(&db.enum_variants_by_name, record.name_id as i64, &range_id) == 0 {
                return -1;
            }
            const range: &SemanticEnumVariantRange = semantic_db_enum_variant_range_ptr(db, range_id);
            const cursor: &i32 = semantic_db_cursor_ptr(cursors, range_id);
            if range == null || cursor == null {
                return -1;
            }
            const slot_index: i32 = range.variant_start + cursor[0];
            const slot: &i32 = semantic_db_enum_variant_record_id_slot(db, slot_index);
            if slot == null {
                return -1;
            }
            slot[0] = record_id;
            cursor[0] = cursor[0] + 1;
        }
        record_id = record_id + 1;
    }
    return 0;
}

fn semantic_db_rebuild_enum_variants_by_name(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    semantic_vector_reset(&db.enum_variant_ranges);
    semantic_vector_reset(&db.enum_variant_range_record_ids);
    semantic_hash_reset(&db.enum_variants_by_name);
    if semantic_db_collect_enum_variant_range_counts(db) != 0 {
        return -1;
    }
    if semantic_db_prefix_enum_variant_ranges(db) != 0 {
        return -1;
    }

    var cursors: SemanticVector = SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
    if semantic_db_build_enum_variant_range_cursors(db, &cursors) != 0 {
        semantic_vector_release(&cursors);
        return -1;
    }
    const filled: i32 = semantic_db_fill_enum_variant_ranges(db, &cursors);
    semantic_vector_release(&cursors);
    return filled;
}

fn semantic_db_rebuild_exports_by_module_name(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    semantic_hash_reset(&db.exports_by_module_name);
    var binding_id: i32 = 0;
    while binding_id < semantic_db_export_binding_count(db) {
        var binding: SemanticExportBinding = SemanticExportBinding{
            file_id: -1,
            module_id: -1,
            name: null,
            decl_id: -1,
            symbol_id: -1,
        };
        if semantic_db_export_binding_get(db, binding_id, &binding) == 0 {
            return -1;
        }
        const name_id: i32 = semantic_intern_find(&db.name_intern, binding.name);
        if name_id < 0 {
            return -1;
        }
        if semantic_db_append_export_symbol_index(db, binding.module_id, name_id, binding.symbol_id) != 0 {
            return -1;
        }
        binding_id = binding_id + 1;
    }
    return 0;
}

fn semantic_db_rebuild_aliases_by_file_name(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    semantic_hash_reset(&db.aliases_by_file_name);
    var decl_id: i32 = 0;
    while decl_id < semantic_db_decl_record_count(db) {
        var record: SemanticDeclRecord = SemanticDeclRecord{
            ast_node: null,
            name_id: -1,
            kind: -1,
            file_id: -1,
            module_id: -1,
        };
        if semantic_db_decl_record_get(db, decl_id, &record) == 0 {
            return -1;
        }
        if record.kind == ASTNodeType.AST_TYPE_ALIAS as i32 && record.file_id >= 0 && record.name_id >= 0 {
            if semantic_db_append_file_alias_index(db, record.file_id, record.name_id, decl_id) != 0 {
                return -1;
            }
        }
        decl_id = decl_id + 1;
    }
    return 0;
}

fn semantic_db_refresh_interned_name_count(db: &SemanticDb) i32 {
    if db == null {
        return -1;
    }
    const count: i32 = semantic_db_i32_from_usize(db.name_intern.count);
    if count < 0 {
        return -1;
    }
    db.interned_name_count = count;
    return 0;
}

fn semantic_db_update_estimated_bytes(db: &SemanticDb) void {
    if db == null {
        return;
    }
    db.estimated_bytes = semantic_db_storage_bytes(db);
}

/// 功能说明：从已合并的 `AST_PROGRAM` 根节点构建 SemanticDb 基础计数。
/// 参数说明：`db` 为输出数据库，`program` 为 `ast_merge_programs` 后的程序根。
/// 返回值说明：成功返回 `0`；参数无效或输入不是 merged program 时返回 `-1`。
export fn semantic_db_build_from_merged_ast(db: &SemanticDb, program: &ASTNode) i32 {
    if db == null || program == null || program.type != ASTNodeType.AST_PROGRAM {
        return -1;
    }
    if program.program_decl_count > 0 && program.program_decls == null {
        return -1;
    }

    semantic_db_prepare_for_build(db);
    if program.program_decl_count > 0 {
        if semantic_vector_ensure_capacity(&db.decl_records, program.program_decl_count as usize) != 0 {
            return -1;
        }
    }
    if semantic_db_build_file_module_ids(db, program) != 0 {
        semantic_db_reset(db);
        return -1;
    }

    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        var file_id: i32 = -1;
        if decl != null && decl.filename != null {
            file_id = semantic_db_find_file_id(db, decl.filename);
        }
        const module_id: i32 = file_id;
        if semantic_db_count_decl(db, decl, file_id, module_id) != 0 {
            semantic_db_reset(db);
            return -1;
        }
        i = i + 1;
    }
    if semantic_db_refresh_interned_name_count(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    if semantic_db_rebuild_decls_by_name(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    if semantic_db_rebuild_functions_by_name(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    if semantic_db_rebuild_types_by_name(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    if semantic_db_rebuild_enum_variants_by_name(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    if semantic_db_rebuild_exports_by_module_name(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    if semantic_db_rebuild_aliases_by_file_name(db) != 0 {
        semantic_db_reset(db);
        return -1;
    }
    semantic_db_update_estimated_bytes(db);
    return 0;
}
