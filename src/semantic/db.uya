// semantic/db.uya - SemanticDb root state for the 1-second compiler pipeline.

/// 功能说明：保存 DeclId 对应的紧凑声明记录。
/// 参数说明：无；记录由 SemanticDb 构建阶段追加。
/// 返回值说明：无。
export struct SemanticDeclRecord {
    ast_node: &void,
    name_id: i32,
    kind: i32,
    file_id: i32,
    module_id: i32,
}

/// 功能说明：保存 SymbolId 对应的紧凑符号记录。
/// 参数说明：无；记录由 SemanticDb 构建阶段追加。
/// 返回值说明：无。
export struct SemanticSymbolRecord {
    name_id: i32,
    decl_id: i32,
    kind: i32,
}

/// 功能说明：保存一个名字在符号数组中的连续 range。
/// 参数说明：无；`symbol_start` 和 `symbol_count` 指向 `symbol_records`。
/// 返回值说明：无。
export struct SemanticNameRange {
    name_id: i32,
    symbol_start: i32,
    symbol_count: i32,
}

/// 功能说明：保存一个名字在 DeclId 数组中的连续 range。
/// 参数说明：无；`decl_start` 和 `decl_count` 指向 `decl_range_ids`。
/// 返回值说明：无。
export struct SemanticDeclRange {
    name_id: i32,
    decl_start: i32,
    decl_count: i32,
}

/// 功能说明：保存一个名字在函数 DeclId 数组中的连续 overload range。
/// 参数说明：无；`function_start` 和 `function_count` 指向 `function_range_decl_ids`。
/// 返回值说明：无。
export struct SemanticFunctionOverloadRange {
    name_id: i32,
    function_start: i32,
    function_count: i32,
}

/// 功能说明：保存一个名字在类型 DeclId 数组中的连续 range。
/// 参数说明：无；`type_start` 和 `type_count` 指向 `type_range_decl_ids`。
/// 返回值说明：无。
export struct SemanticTypeDeclRange {
    name_id: i32,
    type_start: i32,
    type_count: i32,
}

/// 功能说明：保存一个 enum variant 对应的紧凑记录。
/// 参数说明：无；`enum_decl_id` 指向所属 enum 声明，`variant_index` 为 enum 内 variant 下标。
/// 返回值说明：无。
export struct SemanticEnumVariantRecord {
    name_id: i32,
    enum_decl_id: i32,
    variant_index: i32,
}

/// 功能说明：保存一个名字在 enum variant 记录 ID 数组中的连续 range。
/// 参数说明：无；`variant_start` 和 `variant_count` 指向 `enum_variant_range_record_ids`。
/// 返回值说明：无。
export struct SemanticEnumVariantRange {
    name_id: i32,
    variant_start: i32,
    variant_count: i32,
}

/// 功能说明：保存 FileId 对应的源文件记录。
/// 参数说明：无；`filename` 指向 AST 中稳定存在的文件名字符串。
/// 返回值说明：无。
export struct SemanticFileRecord {
    filename: &byte,
}

/// 功能说明：保存 ModuleId 对应的模块记录。
/// 参数说明：无；当前基础阶段用源文件名作为模块名占位。
/// 返回值说明：无。
export struct SemanticModuleRecord {
    name: &byte,
    file_id: i32,
}

/// 功能说明：保存 use 语句导入绑定。
/// 参数说明：无；`name` 为 alias 或导入项名，`ast_node` 指向原始 use AST。
/// 返回值说明：无。
export struct SemanticImportBinding {
    file_id: i32,
    module_id: i32,
    name: &byte,
    ast_node: &void,
}

/// 功能说明：保存模块对外可索引的顶层声明绑定。
/// 参数说明：无；`decl_id` 指向对应顶层声明记录。
/// 返回值说明：无。
export struct SemanticExportBinding {
    file_id: i32,
    module_id: i32,
    name: &byte,
    decl_id: i32,
    symbol_id: i32,
}

/// 功能说明：保存 SemanticDb 的顶层计数、估算字节数和紧凑记录数组。
/// 参数说明：无；调用 `semantic_db_init` 后使用。
/// 返回值说明：无。
export struct SemanticDb {
    file_count: i32,
    module_count: i32,
    interned_name_count: i32,
    decl_count: i32,
    symbol_count: i32,
    scope_count: i32,
    type_count: i32,
    expr_count: i32,
    function_count: i32,
    mono_instance_count: i32,
    estimated_bytes: usize,
    name_intern: SemanticInternTable,
    file_records: SemanticVector,
    module_records: SemanticVector,
    decl_records: SemanticVector,
    symbol_records: SemanticVector,
    name_ranges: SemanticVector,
    name_range_index: SemanticHash,
    decl_ranges: SemanticVector,
    decl_range_ids: SemanticVector,
    decls_by_name: SemanticHash,
    function_ranges: SemanticVector,
    function_range_decl_ids: SemanticVector,
    functions_by_name: SemanticHash,
    type_ranges: SemanticVector,
    type_range_decl_ids: SemanticVector,
    types_by_name: SemanticHash,
    enum_variant_records: SemanticVector,
    enum_variant_ranges: SemanticVector,
    enum_variant_range_record_ids: SemanticVector,
    enum_variants_by_name: SemanticHash,
    import_bindings: SemanticVector,
    export_bindings: SemanticVector,
    exports_by_module_name: SemanticHash,
    aliases_by_file_name: SemanticHash,
}

fn semantic_db_clear_counts(db: &SemanticDb) void {
    if db == null {
        return;
    }
    db.file_count = 0;
    db.module_count = 0;
    db.interned_name_count = 0;
    db.decl_count = 0;
    db.symbol_count = 0;
    db.scope_count = 0;
    db.type_count = 0;
    db.expr_count = 0;
    db.function_count = 0;
    db.mono_instance_count = 0;
    db.estimated_bytes = 0usize;
}

fn semantic_db_usize_to_i32(value: usize) i32 {
    const converted_tmp: !i32 = value as! i32;
    const converted: i32 = converted_tmp catch {
        return -1;
    };
    return converted;
}

const SEMANTIC_DB_MODULE_NAME_KEY_STRIDE: i64 = 2147483648;

fn semantic_db_module_name_key(module_id: i32, name_id: i32) i64 {
    if module_id < 0 || name_id < 0 {
        return -1;
    }
    return (module_id as i64) * SEMANTIC_DB_MODULE_NAME_KEY_STRIDE + (name_id as i64);
}

fn semantic_db_file_name_key(file_id: i32, name_id: i32) i64 {
    return semantic_db_module_name_key(file_id, name_id);
}

/// 功能说明：初始化 SemanticDb 顶层状态和紧凑动态数组。
/// 参数说明：`db` 为待初始化 SemanticDb。
/// 返回值说明：无。
export fn semantic_db_init(db: &SemanticDb) void {
    if db == null {
        return;
    }
    semantic_db_clear_counts(db);
    semantic_intern_init(&db.name_intern);
    semantic_vector_init(&db.file_records, @size_of(SemanticFileRecord));
    semantic_vector_init(&db.module_records, @size_of(SemanticModuleRecord));
    semantic_vector_init(&db.decl_records, @size_of(SemanticDeclRecord));
    semantic_vector_init(&db.symbol_records, @size_of(SemanticSymbolRecord));
    semantic_vector_init(&db.name_ranges, @size_of(SemanticNameRange));
    semantic_hash_init(&db.name_range_index);
    semantic_vector_init(&db.decl_ranges, @size_of(SemanticDeclRange));
    semantic_vector_init(&db.decl_range_ids, @size_of(i32));
    semantic_hash_init(&db.decls_by_name);
    semantic_vector_init(&db.function_ranges, @size_of(SemanticFunctionOverloadRange));
    semantic_vector_init(&db.function_range_decl_ids, @size_of(i32));
    semantic_hash_init(&db.functions_by_name);
    semantic_vector_init(&db.type_ranges, @size_of(SemanticTypeDeclRange));
    semantic_vector_init(&db.type_range_decl_ids, @size_of(i32));
    semantic_hash_init(&db.types_by_name);
    semantic_vector_init(&db.enum_variant_records, @size_of(SemanticEnumVariantRecord));
    semantic_vector_init(&db.enum_variant_ranges, @size_of(SemanticEnumVariantRange));
    semantic_vector_init(&db.enum_variant_range_record_ids, @size_of(i32));
    semantic_hash_init(&db.enum_variants_by_name);
    semantic_vector_init(&db.import_bindings, @size_of(SemanticImportBinding));
    semantic_vector_init(&db.export_bindings, @size_of(SemanticExportBinding));
    semantic_hash_init(&db.exports_by_module_name);
    semantic_hash_init(&db.aliases_by_file_name);
}

/// 功能说明：重置 SemanticDb 以支持同进程多次编译。
/// 参数说明：`db` 为待重置 SemanticDb。
/// 返回值说明：无。
export fn semantic_db_reset(db: &SemanticDb) void {
    if db == null {
        return;
    }
    semantic_db_clear_counts(db);
    semantic_intern_reset(&db.name_intern);
    semantic_vector_reset(&db.file_records);
    semantic_vector_reset(&db.module_records);
    semantic_vector_reset(&db.decl_records);
    semantic_vector_reset(&db.symbol_records);
    semantic_vector_reset(&db.name_ranges);
    semantic_hash_reset(&db.name_range_index);
    semantic_vector_reset(&db.decl_ranges);
    semantic_vector_reset(&db.decl_range_ids);
    semantic_hash_reset(&db.decls_by_name);
    semantic_vector_reset(&db.function_ranges);
    semantic_vector_reset(&db.function_range_decl_ids);
    semantic_hash_reset(&db.functions_by_name);
    semantic_vector_reset(&db.type_ranges);
    semantic_vector_reset(&db.type_range_decl_ids);
    semantic_hash_reset(&db.types_by_name);
    semantic_vector_reset(&db.enum_variant_records);
    semantic_vector_reset(&db.enum_variant_ranges);
    semantic_vector_reset(&db.enum_variant_range_record_ids);
    semantic_hash_reset(&db.enum_variants_by_name);
    semantic_vector_reset(&db.import_bindings);
    semantic_vector_reset(&db.export_bindings);
    semantic_hash_reset(&db.exports_by_module_name);
    semantic_hash_reset(&db.aliases_by_file_name);
}

/// 功能说明：释放 SemanticDb 内部动态数组并清空状态。
/// 参数说明：`db` 为待释放 SemanticDb。
/// 返回值说明：无。
export fn semantic_db_release(db: &SemanticDb) void {
    if db == null {
        return;
    }
    semantic_intern_release(&db.name_intern);
    semantic_vector_release(&db.file_records);
    semantic_vector_release(&db.module_records);
    semantic_vector_release(&db.decl_records);
    semantic_vector_release(&db.symbol_records);
    semantic_vector_release(&db.name_ranges);
    semantic_hash_release(&db.name_range_index);
    semantic_vector_release(&db.decl_ranges);
    semantic_vector_release(&db.decl_range_ids);
    semantic_hash_release(&db.decls_by_name);
    semantic_vector_release(&db.function_ranges);
    semantic_vector_release(&db.function_range_decl_ids);
    semantic_hash_release(&db.functions_by_name);
    semantic_vector_release(&db.type_ranges);
    semantic_vector_release(&db.type_range_decl_ids);
    semantic_hash_release(&db.types_by_name);
    semantic_vector_release(&db.enum_variant_records);
    semantic_vector_release(&db.enum_variant_ranges);
    semantic_vector_release(&db.enum_variant_range_record_ids);
    semantic_hash_release(&db.enum_variants_by_name);
    semantic_vector_release(&db.import_bindings);
    semantic_vector_release(&db.export_bindings);
    semantic_hash_release(&db.exports_by_module_name);
    semantic_hash_release(&db.aliases_by_file_name);
    semantic_db_clear_counts(db);
}

/// 功能说明：估算 SemanticDb 当前结构和动态存储占用字节数。
/// 参数说明：`db` 为目标 SemanticDb。
/// 返回值说明：返回结构体本体、紧凑 vector 和动态 hash bucket 的估算字节数；参数无效时返回 `0`。
export fn semantic_db_storage_bytes(db: &SemanticDb) usize {
    if db == null {
        return 0usize;
    }
    return @size_of(SemanticDb) +
        db.name_intern.bytes +
        db.name_intern.string_bytes +
        db.file_records.bytes +
        db.module_records.bytes +
        db.decl_records.bytes +
        db.symbol_records.bytes +
        db.name_ranges.bytes +
        db.name_range_index.bytes +
        db.decl_ranges.bytes +
        db.decl_range_ids.bytes +
        db.decls_by_name.bytes +
        db.function_ranges.bytes +
        db.function_range_decl_ids.bytes +
        db.functions_by_name.bytes +
        db.type_ranges.bytes +
        db.type_range_decl_ids.bytes +
        db.types_by_name.bytes +
        db.enum_variant_records.bytes +
        db.enum_variant_ranges.bytes +
        db.enum_variant_range_record_ids.bytes +
        db.enum_variants_by_name.bytes +
        db.import_bindings.bytes +
        db.export_bindings.bytes +
        db.exports_by_module_name.bytes +
        db.aliases_by_file_name.bytes;
}

/// 功能说明：追加 FileId 对应的文件记录。
/// 参数说明：`db` 为目标库，`filename` 为源文件名。
/// 返回值说明：成功返回新 FileId；失败返回 `-1`。
export fn semantic_db_append_file_record(db: &SemanticDb, filename: &byte) i32 {
    if db == null || filename == null {
        return -1;
    }
    const file_id: i32 = semantic_db_usize_to_i32(db.file_records.count);
    if file_id < 0 {
        return -1;
    }
    var record: SemanticFileRecord = SemanticFileRecord{
        filename: filename,
    };
    if semantic_vector_append(&db.file_records, &record as &const void) != 0 {
        return -1;
    }
    return file_id;
}

/// 功能说明：追加 ModuleId 对应的模块记录。
/// 参数说明：`db` 为目标库，`name` 为模块名，`file_id` 为所属文件 ID。
/// 返回值说明：成功返回新 ModuleId；失败返回 `-1`。
export fn semantic_db_append_module_record(db: &SemanticDb, name: &byte, file_id: i32) i32 {
    if db == null || name == null || file_id < 0 {
        return -1;
    }
    const module_id: i32 = semantic_db_usize_to_i32(db.module_records.count);
    if module_id < 0 {
        return -1;
    }
    var record: SemanticModuleRecord = SemanticModuleRecord{
        name: name,
        file_id: file_id,
    };
    if semantic_vector_append(&db.module_records, &record as &const void) != 0 {
        return -1;
    }
    return module_id;
}

/// 功能说明：追加 use 导入绑定记录。
/// 参数说明：`db` 为目标库，`file_id/module_id` 指明所属位置，`name` 为导入名，`ast_node` 为 use AST。
/// 返回值说明：成功返回新 binding 下标；失败返回 `-1`。
export fn semantic_db_append_import_binding(
    db: &SemanticDb,
    file_id: i32,
    module_id: i32,
    name: &byte,
    ast_node: &void,
) i32 {
    if db == null || file_id < 0 || module_id < 0 || name == null || ast_node == null {
        return -1;
    }
    const binding_id: i32 = semantic_db_usize_to_i32(db.import_bindings.count);
    if binding_id < 0 {
        return -1;
    }
    var record: SemanticImportBinding = SemanticImportBinding{
        file_id: file_id,
        module_id: module_id,
        name: name,
        ast_node: ast_node,
    };
    if semantic_vector_append(&db.import_bindings, &record as &const void) != 0 {
        return -1;
    }
    return binding_id;
}

/// 功能说明：追加模块导出绑定记录。
/// 参数说明：`db` 为目标库，`file_id/module_id` 指明所属位置，`name` 为导出名，`decl_id` 为声明 ID，`symbol_id` 为导出符号 ID。
/// 返回值说明：成功返回新 binding 下标；失败返回 `-1`。
export fn semantic_db_append_export_binding(
    db: &SemanticDb,
    file_id: i32,
    module_id: i32,
    name: &byte,
    decl_id: i32,
    symbol_id: i32,
) i32 {
    if db == null || file_id < 0 || module_id < 0 || name == null || decl_id < 0 || symbol_id < 0 {
        return -1;
    }
    const binding_id: i32 = semantic_db_usize_to_i32(db.export_bindings.count);
    if binding_id < 0 {
        return -1;
    }
    var record: SemanticExportBinding = SemanticExportBinding{
        file_id: file_id,
        module_id: module_id,
        name: name,
        decl_id: decl_id,
        symbol_id: symbol_id,
    };
    if semantic_vector_append(&db.export_bindings, &record as &const void) != 0 {
        return -1;
    }
    return binding_id;
}

/// 功能说明：向模块导出索引追加或更新 `(ModuleId, InternedNameId) -> SymbolId` 映射。
/// 参数说明：`db` 为目标库，`module_id/name_id` 组成复合 key，`symbol_id` 为导出符号 ID。
/// 返回值说明：成功返回 `0`；参数无效、key 溢出或 hash 插入失败返回 `-1`。
export fn semantic_db_append_export_symbol_index(db: &SemanticDb, module_id: i32, name_id: i32, symbol_id: i32) i32 {
    if db == null || module_id < 0 || name_id < 0 || symbol_id < 0 {
        return -1;
    }
    const key: i64 = semantic_db_module_name_key(module_id, name_id);
    if key < 0 {
        return -1;
    }
    return semantic_hash_insert(&db.exports_by_module_name, key, symbol_id);
}

/// 功能说明：按模块 ID 和 intern 名字 ID 查询导出 SymbolId。
/// 参数说明：`db` 为目标库，`module_id/name_id` 组成复合 key，`out_symbol_id` 接收命中的 SymbolId。
/// 返回值说明：命中返回 `1`，未命中或参数无效返回 `0`。
export fn semantic_db_find_export_symbol(db: &SemanticDb, module_id: i32, name_id: i32, out_symbol_id: &i32) i32 {
    if db == null || out_symbol_id == null || module_id < 0 || name_id < 0 {
        return 0;
    }
    const key: i64 = semantic_db_module_name_key(module_id, name_id);
    if key < 0 {
        return 0;
    }
    return semantic_hash_get(&db.exports_by_module_name, key, out_symbol_id);
}

/// 功能说明：向文件局部 type alias 索引追加或更新 `(FileId, InternedNameId) -> DeclId` 映射。
/// 参数说明：`db` 为目标库，`file_id/name_id` 组成复合 key，`decl_id` 为 type alias 声明 ID。
/// 返回值说明：成功返回 `0`；参数无效、key 溢出或 hash 插入失败返回 `-1`。
export fn semantic_db_append_file_alias_index(db: &SemanticDb, file_id: i32, name_id: i32, decl_id: i32) i32 {
    if db == null || file_id < 0 || name_id < 0 || decl_id < 0 {
        return -1;
    }
    const key: i64 = semantic_db_file_name_key(file_id, name_id);
    if key < 0 {
        return -1;
    }
    return semantic_hash_insert(&db.aliases_by_file_name, key, decl_id);
}

/// 功能说明：按文件 ID 和 intern 名字 ID 查询 type alias DeclId。
/// 参数说明：`db` 为目标库，`file_id/name_id` 组成复合 key，`out_decl_id` 接收命中的 DeclId。
/// 返回值说明：命中返回 `1`，未命中或参数无效返回 `0`。
export fn semantic_db_find_file_alias_decl(db: &SemanticDb, file_id: i32, name_id: i32, out_decl_id: &i32) i32 {
    if db == null || out_decl_id == null || file_id < 0 || name_id < 0 {
        return 0;
    }
    const key: i64 = semantic_db_file_name_key(file_id, name_id);
    if key < 0 {
        return 0;
    }
    return semantic_hash_get(&db.aliases_by_file_name, key, out_decl_id);
}

/// 功能说明：追加 DeclId 对应的紧凑声明记录。
/// 参数说明：`db` 为目标库，其余参数为声明 AST 指针、名字 ID、种类、文件 ID 和模块 ID。
/// 返回值说明：成功返回新 DeclId；失败返回 `-1`。
export fn semantic_db_append_decl_record(
    db: &SemanticDb,
    ast_node: &void,
    name_id: i32,
    kind: i32,
    file_id: i32,
    module_id: i32,
) i32 {
    if db == null || ast_node == null {
        return -1;
    }
    const decl_id: i32 = semantic_db_usize_to_i32(db.decl_records.count);
    if decl_id < 0 {
        return -1;
    }
    var record: SemanticDeclRecord = SemanticDeclRecord{
        ast_node: ast_node,
        name_id: name_id,
        kind: kind,
        file_id: file_id,
        module_id: module_id,
    };
    if semantic_vector_append(&db.decl_records, &record as &const void) != 0 {
        return -1;
    }
    return decl_id;
}

/// 功能说明：按 DeclId 复制紧凑声明记录。
/// 参数说明：`db` 为目标库，`decl_id` 为声明 ID，`out_record` 接收记录副本。
/// 返回值说明：命中返回 `1`，未命中或参数无效返回 `0`。
export fn semantic_db_decl_record_get(db: &SemanticDb, decl_id: i32, out_record: &SemanticDeclRecord) i32 {
    if db == null || out_record == null || decl_id < 0 {
        return 0;
    }
    const record_ptr: &byte = semantic_vector_item_ptr(&db.decl_records, decl_id as usize);
    if record_ptr == null {
        return 0;
    }
    const record: &SemanticDeclRecord = record_ptr as &SemanticDeclRecord;
    out_record[0] = record[0];
    return 1;
}

/// 功能说明：追加 SymbolId 对应的紧凑符号记录。
/// 参数说明：`db` 为目标库，`name_id` 为名字 ID，`decl_id` 为声明 ID，`kind` 为符号种类。
/// 返回值说明：成功返回新 SymbolId；失败返回 `-1`。
export fn semantic_db_append_symbol_record(db: &SemanticDb, name_id: i32, decl_id: i32, kind: i32) i32 {
    if db == null || name_id < 0 || decl_id < 0 {
        return -1;
    }
    const symbol_id: i32 = semantic_db_usize_to_i32(db.symbol_records.count);
    if symbol_id < 0 {
        return -1;
    }
    var record: SemanticSymbolRecord = SemanticSymbolRecord{
        name_id: name_id,
        decl_id: decl_id,
        kind: kind,
    };
    if semantic_vector_append(&db.symbol_records, &record as &const void) != 0 {
        return -1;
    }
    return symbol_id;
}

/// 功能说明：按 SymbolId 复制紧凑符号记录。
/// 参数说明：`db` 为目标库，`symbol_id` 为符号 ID，`out_record` 接收记录副本。
/// 返回值说明：命中返回 `1`，未命中或参数无效返回 `0`。
export fn semantic_db_symbol_record_get(db: &SemanticDb, symbol_id: i32, out_record: &SemanticSymbolRecord) i32 {
    if db == null || out_record == null || symbol_id < 0 {
        return 0;
    }
    const record_ptr: &byte = semantic_vector_item_ptr(&db.symbol_records, symbol_id as usize);
    if record_ptr == null {
        return 0;
    }
    const record: &SemanticSymbolRecord = record_ptr as &SemanticSymbolRecord;
    out_record[0] = record[0];
    return 1;
}

/// 功能说明：追加一个名字到紧凑符号数组的 range。
/// 参数说明：`db` 为目标库，`name_id` 为名字 ID，`symbol_start/count` 为连续符号段。
/// 返回值说明：成功返回新 range 下标；失败返回 `-1`。
export fn semantic_db_append_name_range(db: &SemanticDb, name_id: i32, symbol_start: i32, symbol_count: i32) i32 {
    if db == null || name_id < 0 || symbol_start < 0 || symbol_count < 0 {
        return -1;
    }
    const range_id: i32 = semantic_db_usize_to_i32(db.name_ranges.count);
    if range_id < 0 {
        return -1;
    }
    var record: SemanticNameRange = SemanticNameRange{
        name_id: name_id,
        symbol_start: symbol_start,
        symbol_count: symbol_count,
    };
    if semantic_vector_append(&db.name_ranges, &record as &const void) != 0 {
        return -1;
    }
    if semantic_hash_insert(&db.name_range_index, name_id as i64, range_id) != 0 {
        return -1;
    }
    return range_id;
}

/// 功能说明：按名字 ID 查询对应的紧凑 name range 下标。
/// 参数说明：`db` 为目标库，`name_id` 为名字 ID，`out_range_id` 接收 range 下标。
/// 返回值说明：命中返回 `1`，未命中或参数无效返回 `0`。
export fn semantic_db_find_name_range(db: &SemanticDb, name_id: i32, out_range_id: &i32) i32 {
    if db == null || out_range_id == null || name_id < 0 {
        return 0;
    }
    return semantic_hash_get(&db.name_range_index, name_id as i64, out_range_id);
}

/// 功能说明：查找已 intern 的名字 ID。
/// 参数说明：`db` 为目标库，`name` 为以 `\0` 结尾的名字。
/// 返回值说明：命中返回非负 InternedNameId，未命中或参数无效返回 `-1`。
export fn semantic_db_find_interned_name(db: &SemanticDb, name: &byte) i32 {
    if db == null || name == null {
        return -1;
    }
    return semantic_intern_find(&db.name_intern, name);
}

/// 功能说明：追加一个名字到紧凑 DeclId 数组的 range。
/// 参数说明：`db` 为目标库，`name_id` 为名字 ID，`decl_start/count` 为连续 DeclId 段。
/// 返回值说明：成功返回新 range 下标；失败返回 `-1`。
export fn semantic_db_append_decl_range(db: &SemanticDb, name_id: i32, decl_start: i32, decl_count: i32) i32 {
    if db == null || name_id < 0 || decl_start < 0 || decl_count < 0 {
        return -1;
    }
    const range_id: i32 = semantic_db_usize_to_i32(db.decl_ranges.count);
    if range_id < 0 {
        return -1;
    }
    var record: SemanticDeclRange = SemanticDeclRange{
        name_id: name_id,
        decl_start: decl_start,
        decl_count: decl_count,
    };
    if semantic_vector_append(&db.decl_ranges, &record as &const void) != 0 {
        return -1;
    }
    if semantic_hash_insert(&db.decls_by_name, name_id as i64, range_id) != 0 {
        return -1;
    }
    return range_id;
}

/// 功能说明：按名字 ID 查询声明 range。
/// 参数说明：`db` 为目标库，`name_id` 为名字 ID，`out_range` 接收 range 副本。
/// 返回值说明：命中返回 `1`，未命中或参数无效返回 `0`。
export fn semantic_db_find_decl_range(db: &SemanticDb, name_id: i32, out_range: &SemanticDeclRange) i32 {
    if db == null || out_range == null || name_id < 0 {
        return 0;
    }
    var range_id: i32 = -1;
    if semantic_hash_get(&db.decls_by_name, name_id as i64, &range_id) == 0 {
        return 0;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.decl_ranges, range_id as usize);
    if ptr == null {
        return 0;
    }
    const range: &SemanticDeclRange = ptr as &SemanticDeclRange;
    out_range[0] = range[0];
    return 1;
}

/// 功能说明：读取 DeclRange 中指定 offset 对应的 DeclId。
/// 参数说明：`db` 为目标库，`range` 为声明 range，`offset` 为 range 内偏移。
/// 返回值说明：命中返回 DeclId；参数无效或越界返回 `-1`。
export fn semantic_db_decl_range_decl_id(db: &SemanticDb, range: &SemanticDeclRange, offset: i32) i32 {
    if db == null || range == null || offset < 0 || offset >= range.decl_count {
        return -1;
    }
    const index: i32 = range.decl_start + offset;
    if index < 0 {
        return -1;
    }
    const ptr: &byte = semantic_vector_item_ptr(&db.decl_range_ids, index as usize);
    if ptr == null {
        return -1;
    }
    const decl_id: &i32 = ptr as &i32;
    return decl_id[0];
}

