    var work: LowerWorkItem = LowerWorkItem{
        kind: LOWER_WORK_ITEM_ASYNC_FRAME,
        primary_id: item.function_id,
        secondary_id: item.frame_type_id,
    };
    return lowered_program_append_work_item(program, &work);
}

/// 功能说明：收敛一个 drop/defer 收尾计划闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为已收敛的 DropDeferPlan。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 (owner_function_id, scope_id) 去重。
export fn lowered_program_close_drop_defer_plan(program: &LoweredProgram, item: &DropDeferPlan) i32 {
    if program == null || item == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < program.drop_defer_plans.count {
        const existing: &DropDeferPlan = semantic_vector_item_ptr(&program.drop_defer_plans, i) as &DropDeferPlan;
        if existing != null && existing.owner_function_id == item.owner_function_id && existing.scope_id == item.scope_id {
            return 0;
        }
        i = i + 1usize;
    }
    if lowered_program_append_drop_defer_plan(program, item) != 0 {
        return -1;
    }
    var work: LowerWorkItem = LowerWorkItem{
        kind: LOWER_WORK_ITEM_DROP_DEFER,
        primary_id: item.owner_function_id,
        secondary_id: item.scope_id,
    };
    return lowered_program_append_work_item(program, &work);
}

/// 功能说明：收敛一个 vtable/interface 方法计划闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为已收敛的 InterfacePlan。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 (type_id, symbol_id) 去重。
export fn lowered_program_close_interface_method_plan(program: &LoweredProgram, item: &InterfacePlan) i32 {
    if program == null || item == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < program.interfaces.count {
        const existing: &InterfacePlan = semantic_vector_item_ptr(&program.interfaces, i) as &InterfacePlan;
        if existing != null && existing.type_id == item.type_id && existing.symbol_id == item.symbol_id {
            return 0;
        }
        i = i + 1usize;
    }
    if lowered_program_append_interface(program, item) != 0 {
        return -1;
    }
    var work: LowerWorkItem = LowerWorkItem{
        kind: LOWER_WORK_ITEM_INTERFACE,
        primary_id: item.type_id,
        secondary_id: item.symbol_id,
    };
    return lowered_program_append_work_item(program, &work);
}

/// 功能说明：收敛一个 runtime helper 需求闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为已收敛的 RuntimeHelper。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 helper_id 去重。
export fn lowered_program_close_runtime_helper_requirement(program: &LoweredProgram, item: &RuntimeHelper) i32 {
    if program == null || item == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < program.helpers.count {
        const existing: &RuntimeHelper = semantic_vector_item_ptr(&program.helpers, i) as &RuntimeHelper;
        if existing != null && existing.helper_id == item.helper_id {
            return 0;
        }
        i = i + 1usize;
    }
    if lowered_program_append_helper(program, item) != 0 {
        return -1;
    }
    var work: LowerWorkItem = LowerWorkItem{
        kind: LOWER_WORK_ITEM_RUNTIME_HELPER,
        primary_id: item.helper_id,
        secondary_id: item.name_id,
    };
    return lowered_program_append_work_item(program, &work);
}

// ---- Phase 5: 输出稳定排序 ----

fn lowered_program_swap_items(vec: &SemanticVector, i: usize, j: usize) void {
    var tmp: [byte: 64] = [];
    const pa: &byte = semantic_vector_item_ptr(vec, i);
    const pb: &byte = semantic_vector_item_ptr(vec, j);
    if pa == null || pb == null {
        return;
    }
    const sz: usize = vec.item_size;
    _ = memcpy(&tmp[0] as *byte, pa as *const byte, sz);
    _ = memcpy(pa as *byte, pb as *const byte, sz);
    _ = memcpy(pb as *byte, &tmp[0] as *const byte, sz);
}

/// 功能说明：按 function_id 对 ConcreteFunction 表做稳定插入排序。
export fn lowered_program_sort_functions(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.functions;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &ConcreteFunction = semantic_vector_item_ptr(vec, j - 1usize) as &ConcreteFunction;
            const b: &ConcreteFunction = semantic_vector_item_ptr(vec, j) as &ConcreteFunction;
            if a == null || b == null {
                return -1;
            }
            if a.function_id <= b.function_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 global_id 对 GlobalObject 表做稳定插入排序。
export fn lowered_program_sort_globals(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.globals;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &GlobalObject = semantic_vector_item_ptr(vec, j - 1usize) as &GlobalObject;
            const b: &GlobalObject = semantic_vector_item_ptr(vec, j) as &GlobalObject;
            if a == null || b == null {
                return -1;
            }
            if a.global_id <= b.global_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 type_id 对 ConcreteType 表做稳定插入排序。
export fn lowered_program_sort_types(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.types;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &ConcreteType = semantic_vector_item_ptr(vec, j - 1usize) as &ConcreteType;
            const b: &ConcreteType = semantic_vector_item_ptr(vec, j) as &ConcreteType;
            if a == null || b == null {
                return -1;
            }
            if a.type_id <= b.type_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 (type_id, symbol_id) 对 InterfacePlan 表做稳定插入排序。
export fn lowered_program_sort_interfaces(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.interfaces;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &InterfacePlan = semantic_vector_item_ptr(vec, j - 1usize) as &InterfacePlan;
            const b: &InterfacePlan = semantic_vector_item_ptr(vec, j) as &InterfacePlan;
            if a == null || b == null {
                return -1;
            }
            var greater: i32 = 0;
            if a.type_id > b.type_id {
                greater = 1;
            } else if a.type_id == b.type_id && a.symbol_id > b.symbol_id {
                greater = 1;
            }
            if greater == 0 {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 type_id 对 ErrorUnionLayout 表做稳定插入排序。
export fn lowered_program_sort_err_unions(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.err_unions;
    var i: usize = 1usize;
    while i < vec.count {
