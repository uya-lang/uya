/// 功能说明：对 LoweredProgram 所有输出表和 lowering worklist 按稳定 ID 排序，保证后端确定性输出。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：成功返回 `0`，任一子表排序失败返回 `-1`。
export fn lowered_program_sort_stable(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    if lowered_program_sort_functions(program) != 0 {
        return -1;
    }
    if lowered_program_sort_globals(program) != 0 {
        return -1;
    }
    if lowered_program_sort_types(program) != 0 {
        return -1;
    }
    if lowered_program_sort_interfaces(program) != 0 {
        return -1;
    }
    if lowered_program_sort_err_unions(program) != 0 {
        return -1;
    }
    if lowered_program_sort_async_frames(program) != 0 {
        return -1;
    }
    if lowered_program_sort_drop_defer_plans(program) != 0 {
        return -1;
    }
    if lowered_program_sort_helpers(program) != 0 {
        return -1;
    }
    if lowered_program_sort_work_items(program) != 0 {
        return -1;
    }
    if lowered_program_sort_core_bodies(program) != 0 {
        return -1;
    }
    if lowered_program_sort_core_stmts(program) != 0 {
        return -1;
    }
    if lowered_program_sort_core_exprs(program) != 0 {
        return -1;
    }
    if lowered_program_sort_core_places(program) != 0 {
        return -1;
    }
    if lowered_program_sort_core_cleanup_edges(program) != 0 {
        return -1;
    }
    if lowered_program_sort_core_semantic_facts(program) != 0 {
        return -1;
    }
    return 0;
}

// ---- Phase 5B: CoreIR verifier ----

fn lowered_program_coreir_verify_ok_result() CoreVerifierResult {
    return CoreVerifierResult{
        ok: 1,
        error_code: COREIR_VERIFY_OK,
        body_id: CORE_BODY_INVALID_ID,
        stmt_id: CORE_STMT_INVALID_ID,
        expr_id: CORE_EXPR_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_id: CORE_CLEANUP_EDGE_INVALID_ID,
        fact_id: CORE_SEMANTIC_FACT_INVALID_ID,
        source_span_id: TYPED_PROGRAM_INVALID_ID,
    };
}

fn lowered_program_coreir_verify_reset(result: &CoreVerifierResult) void {
    if result == null {
        return;
    }
    result[0] = lowered_program_coreir_verify_ok_result();
}

fn lowered_program_coreir_verify_fail(
    result: &CoreVerifierResult,
    error_code: i32,
    body_id: CoreBodyId,
    stmt_id: CoreStmtId,
    expr_id: CoreExprId,
    place_id: CorePlaceId,
    edge_id: CoreCleanupEdgeId,
    fact_id: CoreSemanticFactId,
    source_span_id: i32
) i32 {
    if result != null {
        result.ok = 0;
        result.error_code = error_code;
        result.body_id = body_id;
        result.stmt_id = stmt_id;
        result.expr_id = expr_id;
        result.place_id = place_id;
        result.cleanup_edge_id = edge_id;
        result.fact_id = fact_id;
        result.source_span_id = source_span_id;
    }
    return -1;
}

fn lowered_program_coreir_verify_range(start: i32, count: i32, table_count: usize) i32 {
    if count < 0 {
        return 0;
    }
    if count == 0 {
        return 1;
    }
    if start < 0 {
        return 0;
    }
    const start_index: usize = lowered_program_i32_to_usize(start);
    const count_index: usize = lowered_program_i32_to_usize(count);
    if start_index == 9223372036854775807usize || count_index == 9223372036854775807usize {
        return 0;
    }
    if start_index > table_count {
        return 0;
    }
    if count_index > table_count - start_index {
        return 0;
    }
    return 1;
}

fn lowered_program_coreir_find_function(program: &LoweredProgram, function_id: FunctionId, decl_id: DeclId) &ConcreteFunction {
    if program == null || function_id == TYPED_PROGRAM_INVALID_ID {
        return null;
    }
    var i: usize = 0usize;
    while i < program.functions.count {
        const item: &ConcreteFunction = semantic_vector_item_ptr(&program.functions, i) as &ConcreteFunction;
        if item != null && item.function_id == function_id {
            if decl_id == TYPED_PROGRAM_INVALID_ID || item.decl_id == decl_id {
                return item;
            }
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_coreir_find_body_for_function(program: &LoweredProgram, function_id: FunctionId, decl_id: DeclId) &CoreBody {
    if program == null || function_id == TYPED_PROGRAM_INVALID_ID {
        return null;
    }
    var i: usize = 0usize;
    while i < program.core_bodies.count {
        const body: &CoreBody = semantic_vector_item_ptr(&program.core_bodies, i) as &CoreBody;
        if body != null && body.function_id == function_id {
            if decl_id == TYPED_PROGRAM_INVALID_ID || body.decl_id == decl_id {
                return body;
            }
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_coreir_find_stmt(program: &LoweredProgram, body_id: CoreBodyId, stmt_id: CoreStmtId) &CoreStmt {
    if program == null || body_id < 0 || stmt_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < program.core_stmts.count {
        const stmt: &CoreStmt = semantic_vector_item_ptr(&program.core_stmts, i) as &CoreStmt;
        if stmt != null && stmt.body_id == body_id && stmt.stmt_id == stmt_id {
            return stmt;
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_coreir_find_expr(program: &LoweredProgram, body_id: CoreBodyId, expr_id: CoreExprId) &CoreExpr {
    if program == null || body_id < 0 || expr_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < program.core_exprs.count {
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, i) as &CoreExpr;
        if expr != null && expr.body_id == body_id && expr.expr_id == expr_id {
            return expr;
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_coreir_find_place(program: &LoweredProgram, body_id: CoreBodyId, place_id: CorePlaceId) &CorePlace {
    if program == null || body_id < 0 || place_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < program.core_places.count {
        const place: &CorePlace = semantic_vector_item_ptr(&program.core_places, i) as &CorePlace;
        if place != null && place.body_id == body_id && place.place_id == place_id {
            return place;
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_coreir_find_cleanup_edge(program: &LoweredProgram, body_id: CoreBodyId, edge_id: CoreCleanupEdgeId) &CoreCleanupEdge {
    if program == null || body_id < 0 || edge_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < program.core_cleanup_edges.count {
        const edge: &CoreCleanupEdge = semantic_vector_item_ptr(&program.core_cleanup_edges, i) as &CoreCleanupEdge;
        if edge != null && edge.body_id == body_id && edge.edge_id == edge_id {
            return edge;
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_coreir_get_body_fact(program: &LoweredProgram, body: &CoreBody, offset: i32) &CoreSemanticFact {
    if program == null || body == null || offset < 0 || offset >= body.semantic_fact_count {
        return null;
    }
    const index: usize = lowered_program_i32_to_usize(body.semantic_fact_start + offset);
    if index >= program.core_semantic_facts.count {
        return null;
    }
    return semantic_vector_item_ptr(&program.core_semantic_facts, index) as &CoreSemanticFact;
}

fn lowered_program_coreir_is_known_fact_kind(kind: i32) i32 {
    if kind == CORE_SEMANTIC_FACT_RESOLVED_CALL { return 1; }
    if kind == CORE_SEMANTIC_FACT_METHOD_DISPATCH { return 1; }
    if kind == CORE_SEMANTIC_FACT_FIELD_ID { return 1; }
    if kind == CORE_SEMANTIC_FACT_TYPE_ID { return 1; }
    if kind == CORE_SEMANTIC_FACT_PROOF_RESULT { return 1; }
    if kind == CORE_SEMANTIC_FACT_SOURCE_SPAN { return 1; }
    if kind == CORE_SEMANTIC_FACT_CLEANUP { return 1; }
    if kind == CORE_SEMANTIC_FACT_CAPABILITY { return 1; }
    return 0;
}

fn lowered_program_coreir_stmt_kind_is_dumped_and_verified(kind: i32) i32 {
    if kind == CORE_STMT_KIND_RETURN { return 1; }
    if kind == CORE_STMT_KIND_ASM { return 1; }
    if kind == CORE_STMT_KIND_DEFER { return 1; }
    if kind == CORE_STMT_KIND_ERRDEFER { return 1; }
    if kind == CORE_STMT_KIND_DROP { return 1; }
    if kind == CORE_STMT_KIND_ERROR_PROPAGATION { return 1; }
    if kind == CORE_STMT_KIND_LOCAL_DECL { return 1; }
    if kind == CORE_STMT_KIND_IF { return 1; }
    if kind == CORE_STMT_KIND_ASSIGN { return 1; }
    if kind == CORE_STMT_KIND_EXPR { return 1; }
    if kind == CORE_STMT_KIND_WHILE { return 1; }
    if kind == CORE_STMT_KIND_BLOCK { return 1; }
    if kind == CORE_STMT_KIND_BREAK { return 1; }
    if kind == CORE_STMT_KIND_CONTINUE { return 1; }
    return 0;
}

fn lowered_program_coreir_expr_kind_is_dumped_and_verified(kind: i32) i32 {
    if kind == CORE_EXPR_KIND_CALL { return 1; }
    if kind == CORE_EXPR_KIND_INDEX { return 1; }
    if kind == CORE_EXPR_KIND_SLICE { return 1; }
    if kind == CORE_EXPR_KIND_ATOMIC { return 1; }
    if kind == CORE_EXPR_KIND_VECTOR { return 1; }
    if kind == CORE_EXPR_KIND_MASK { return 1; }
    if kind == CORE_EXPR_KIND_INT_LITERAL { return 1; }
    if kind == CORE_EXPR_KIND_LOCAL_REF { return 1; }
    if kind == CORE_EXPR_KIND_I32_NE { return 1; }
    if kind == CORE_EXPR_KIND_I32_ADD { return 1; }
    if kind == CORE_EXPR_KIND_I32_LE { return 1; }
    return 0;
}

fn lowered_program_coreir_place_kind_is_dumped_and_verified(kind: i32) i32 {
    if kind == CORE_PLACE_KIND_FIELD { return 1; }
    if kind == CORE_PLACE_KIND_INDEX { return 1; }
    if kind == CORE_PLACE_KIND_SLICE { return 1; }
    if kind == CORE_PLACE_KIND_LOCAL { return 1; }
    return 0;
}

fn lowered_program_coreir_cleanup_kind_is_dumped_and_verified(kind: i32) i32 {
    if kind == CORE_CLEANUP_EDGE_KIND_RETURN { return 1; }
    return 0;
}

fn lowered_program_coreir_call_payload_is_frozen(fact: &CoreSemanticFact) i32 {
    if fact == null || fact.call_target_kind == TYPED_CALL_TARGET_UNKNOWN {
        return 0;
    }
    if fact.arg_count < 0 {
        return 0;
    }
    if fact.target_function_id == TYPED_PROGRAM_INVALID_ID &&
        fact.target_decl_id == TYPED_PROGRAM_INVALID_ID &&
        fact.target_symbol_id == TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    return 1;
}

fn lowered_program_coreir_proof_payload_is_frozen(fact: &CoreSemanticFact) i32 {
    if fact == null || fact.proof_result_id == TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.proof_status == TYPED_PROOF_OK {
        return 1;
    }
    if fact.proof_status == TYPED_PROOF_ERROR && fact.proof_error_id != TYPED_PROGRAM_INVALID_ID {
        return 1;
    }
    return 0;
}

fn lowered_program_coreir_capability_is_requirement_only(fact: &CoreSemanticFact) i32 {
    if fact == null || fact.capability_id <= 0 {
        return 0;
    }
    if fact.flags != 0 {
        return 0;
    }
    if fact.call_target_kind != TYPED_CALL_TARGET_UNKNOWN {
        return 0;
    }
    if fact.target_function_id != TYPED_PROGRAM_INVALID_ID || fact.target_decl_id != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.target_symbol_id != TYPED_PROGRAM_INVALID_ID || fact.mono_instance_id != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.receiver_type_id != TYPED_PROGRAM_INVALID_ID || fact.method_symbol_id != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.interface_symbol_id != TYPED_PROGRAM_INVALID_ID || fact.vtable_slot != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.field_id != TYPED_PROGRAM_INVALID_ID || fact.type_id != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.proof_result_id != TYPED_PROGRAM_INVALID_ID || fact.proof_status != TYPED_PROOF_UNKNOWN {
        return 0;
    }
    if fact.proof_error_id != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    if fact.drop_defer_plan_id != TYPED_PROGRAM_INVALID_ID || fact.cleanup_scope_id != TYPED_PROGRAM_INVALID_ID {
        return 0;
    }
    return 1;
}

fn lowered_program_coreir_body_find_type_fact(program: &LoweredProgram, body: &CoreBody, expr_id: CoreExprId) &CoreSemanticFact {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_TYPE_ID && fact.expr_id == expr_id {
            return fact;
        }
        offset = offset + 1;
    }
    return null;
}

fn lowered_program_coreir_body_has_type_fact(program: &LoweredProgram, body: &CoreBody, expr_id: CoreExprId) i32 {
    const fact: &CoreSemanticFact = lowered_program_coreir_body_find_type_fact(program, body, expr_id);
    if fact != null && fact.type_id != TYPED_PROGRAM_INVALID_ID {
        return 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_expr_type(program: &LoweredProgram, body: &CoreBody, expr: &CoreExpr, result: &CoreVerifierResult) i32 {
    const fact: &CoreSemanticFact = lowered_program_coreir_body_find_type_fact(program, body, expr.expr_id);
    if expr.type_id == TYPED_PROGRAM_INVALID_ID {
        if fact == null || fact.type_id == TYPED_PROGRAM_INVALID_ID {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_TYPE,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        return 0;
    }
    if fact != null {
        if fact.type_id == TYPED_PROGRAM_INVALID_ID {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_TYPE,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
        }
        if fact.type_id != expr.type_id {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_TYPE_MISMATCH,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
        }
    }
    return 0;
}

fn lowered_program_coreir_body_has_call_fact(program: &LoweredProgram, body: &CoreBody, expr_id: CoreExprId) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_RESOLVED_CALL && fact.expr_id == expr_id {
            return lowered_program_coreir_call_payload_is_frozen(fact);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_body_has_field_fact(program: &LoweredProgram, body: &CoreBody, place_id: CorePlaceId) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_FIELD_ID && fact.place_id == place_id {
            if fact.field_id != TYPED_PROGRAM_INVALID_ID {
                return 1;
            }
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_body_has_proof_fact(program: &LoweredProgram, body: &CoreBody, expr_id: CoreExprId) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_PROOF_RESULT && fact.expr_id == expr_id {
            return lowered_program_coreir_proof_payload_is_frozen(fact);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_body_has_cleanup_fact(program: &LoweredProgram, body: &CoreBody, edge_id: CoreCleanupEdgeId) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_CLEANUP && fact.cleanup_edge_id == edge_id {
            if fact.drop_defer_plan_id != TYPED_PROGRAM_INVALID_ID && fact.cleanup_scope_id != TYPED_PROGRAM_INVALID_ID {
                return 1;
            }
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_body_has_capability_fact(program: &LoweredProgram, body: &CoreBody, expr_id: CoreExprId) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_CAPABILITY && fact.expr_id == expr_id {
            return lowered_program_coreir_capability_is_requirement_only(fact);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_body_has_capability_id(program: &LoweredProgram, body: &CoreBody, capability_id: i32) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_CAPABILITY && fact.capability_id == capability_id {
            return lowered_program_coreir_capability_is_requirement_only(fact);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_naked_forbidden_body_flags(body: &CoreBody) i32 {
    const forbidden: i32 = CORE_BODY_FLAG_ASYNC | CORE_BODY_FLAG_CLEANUP | CORE_BODY_FLAG_DROP |
        CORE_BODY_FLAG_ERROR_PROPAGATION | CORE_BODY_FLAG_IMPLICIT_RETURN;
    if (body.flags & forbidden) != 0 {
        return 1;
    }
    return 0;
}

fn lowered_program_coreir_naked_forbidden_stmt_flags(stmt: &CoreStmt) i32 {
    const forbidden: i32 = CORE_STMT_FLAG_LOCAL_STACK_SLOT | CORE_STMT_FLAG_CLEANUP |
        CORE_STMT_FLAG_DROP | CORE_STMT_FLAG_ASYNC | CORE_STMT_FLAG_ERROR_PROPAGATION |
        CORE_STMT_FLAG_IMPLICIT_RETURN;
    if (stmt.flags & forbidden) != 0 {
        return 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_function_flags(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    const function: &ConcreteFunction = lowered_program_coreir_find_function(program, body.function_id, body.decl_id);
    if function == null || (function.flags & CORE_FUNCTION_FLAG_NAKED) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_stmt(body: &CoreBody, stmt: &CoreStmt, result: &CoreVerifierResult) i32 {
    if stmt == null || stmt.kind != CORE_STMT_KIND_ASM ||
       stmt.child_stmt_count != 0 || stmt.expr_id != CORE_EXPR_INVALID_ID ||
       stmt.place_id != CORE_PLACE_INVALID_ID || stmt.cleanup_edge_count != 0 ||
       lowered_program_coreir_naked_forbidden_stmt_flags(stmt) != 0 {
        var stmt_id: CoreStmtId = CORE_STMT_INVALID_ID;
        var source_span_id: i32 = body.source_span_id;
        if stmt != null {
            stmt_id = stmt.stmt_id;
            source_span_id = stmt.source_span_id;
        }
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
            body.body_id, stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, source_span_id);
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_stmts(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.root_stmt_count {
        const index: usize = lowered_program_i32_to_usize(body.root_stmt_start + offset);
        const stmt: &CoreStmt = semantic_vector_item_ptr(&program.core_stmts, index) as &CoreStmt;
        if lowered_program_coreir_verify_naked_stmt(body, stmt, result) != 0 {
            return -1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_exprs(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.expr_count {
        const index: usize = lowered_program_i32_to_usize(body.expr_start + offset);
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, index) as &CoreExpr;
        if expr == null || (expr.flags & CORE_EXPR_FLAG_ERROR_PROPAGATION) != 0 ||
           (expr.flags & CORE_EXPR_FLAG_NAKED_ASM_OPERAND) == 0 {
            var expr_id: CoreExprId = CORE_EXPR_INVALID_ID;
            var source_span_id: i32 = body.source_span_id;
            if expr != null {
                expr_id = expr.expr_id;
                source_span_id = expr.source_span_id;
            }
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
                body.body_id, CORE_STMT_INVALID_ID, expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, source_span_id);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_places(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.place_count {
        const index: usize = lowered_program_i32_to_usize(body.place_start + offset);
        const place: &CorePlace = semantic_vector_item_ptr(&program.core_places, index) as &CorePlace;
        if place == null || (place.flags & CORE_PLACE_FLAG_STACK_SLOT) != 0 ||
           (place.flags & CORE_PLACE_FLAG_NAKED_ASM_OPERAND) == 0 {
            var place_id: CorePlaceId = CORE_PLACE_INVALID_ID;
            var source_span_id: i32 = body.source_span_id;
            if place != null {
                place_id = place.place_id;
                source_span_id = place.source_span_id;
            }
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, source_span_id);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_facts(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact != null && fact.kind == CORE_SEMANTIC_FACT_CLEANUP {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
                body.body_id, fact.stmt_id, fact.expr_id, fact.place_id,
                fact.cleanup_edge_id, fact.fact_id, fact.source_span_id);
        }
        offset = offset + 1;
    }
    if lowered_program_coreir_body_has_capability_id(program, body, CORE_CAPABILITY_NAKED_FUNCTION) == 0 ||
       lowered_program_coreir_body_has_capability_id(program, body, CORE_CAPABILITY_INLINE_ASM) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    return 0;
}

fn lowered_program_coreir_verify_naked_body(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    if (body.flags & CORE_BODY_FLAG_NAKED) == 0 {
        return 0;
    }
    if lowered_program_coreir_verify_naked_function_flags(program, body, result) != 0 { return -1; }
    if body.root_stmt_count <= 0 || body.cleanup_edge_count != 0 ||
       lowered_program_coreir_naked_forbidden_body_flags(body) != 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if lowered_program_coreir_verify_naked_facts(program, body, result) != 0 { return -1; }
    if lowered_program_coreir_verify_naked_stmts(program, body, result) != 0 { return -1; }
    if lowered_program_coreir_verify_naked_exprs(program, body, result) != 0 { return -1; }
    if lowered_program_coreir_verify_naked_places(program, body, result) != 0 { return -1; }
    return 0;
}

fn lowered_program_coreir_verify_function_bodies(program: &LoweredProgram, result: &CoreVerifierResult) i32 {
    var i: usize = 0usize;
    while i < program.functions.count {
        const item: &ConcreteFunction = semantic_vector_item_ptr(&program.functions, i) as &ConcreteFunction;
        if item == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
        }
        if item.body_count > 0 {
            const body: &CoreBody = lowered_program_coreir_find_body_for_function(program, item.function_id, item.decl_id);
            if body == null {
                return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_MISSING_CORE_BODY,
                    CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                    CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
            }
            if (item.flags & CORE_FUNCTION_FLAG_NAKED) != 0 && (body.flags & CORE_BODY_FLAG_NAKED) == 0 {
                return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
                    body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                    CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
            }
        }
        i = i + 1usize;
    }
    return 0;
}

fn lowered_program_coreir_verify_body_ranges(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    if body.body_id < 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if lowered_program_coreir_verify_range(body.root_stmt_start, body.root_stmt_count, program.core_stmts.count) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if lowered_program_coreir_verify_range(body.expr_start, body.expr_count, program.core_exprs.count) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if lowered_program_coreir_verify_range(body.place_start, body.place_count, program.core_places.count) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if lowered_program_coreir_verify_range(body.cleanup_edge_start, body.cleanup_edge_count, program.core_cleanup_edges.count) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if lowered_program_coreir_verify_range(body.semantic_fact_start, body.semantic_fact_count, program.core_semantic_facts.count) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    if program.functions.count > 0usize {
        if lowered_program_coreir_find_function(program, body.function_id, body.decl_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
    }
    if (body.flags & CORE_BODY_FLAG_SOURCE_BODY) != 0 && body.root_stmt_count <= 0 {
        if (body.flags & CORE_BODY_FLAG_NAKED) != 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_NAKED_BODY,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
    }
    return 0;
}

fn lowered_program_coreir_verify_fact_refs(program: &LoweredProgram, body: &CoreBody, fact: &CoreSemanticFact, result: &CoreVerifierResult) i32 {
    if fact.fact_id < 0 || fact.body_id != body.body_id || lowered_program_coreir_is_known_fact_kind(fact.kind) == 0 {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
    }
    if fact.stmt_id != CORE_STMT_INVALID_ID && lowered_program_coreir_find_stmt(program, body.body_id, fact.stmt_id) == null {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
            body.body_id, fact.stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
    }
    if fact.expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, fact.expr_id) == null {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
            body.body_id, CORE_STMT_INVALID_ID, fact.expr_id, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
    }
    if fact.place_id != CORE_PLACE_INVALID_ID && lowered_program_coreir_find_place(program, body.body_id, fact.place_id) == null {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, fact.place_id,
            CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
    }
    if fact.cleanup_edge_id != CORE_CLEANUP_EDGE_INVALID_ID && lowered_program_coreir_find_cleanup_edge(program, body.body_id, fact.cleanup_edge_id) == null {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
            body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            fact.cleanup_edge_id, fact.fact_id, fact.source_span_id);
    }
    return 0;
}

fn lowered_program_coreir_verify_fact_payload(body: &CoreBody, fact: &CoreSemanticFact, result: &CoreVerifierResult) i32 {
    if fact.kind == CORE_SEMANTIC_FACT_TYPE_ID {
        if fact.expr_id == CORE_EXPR_INVALID_ID || fact.type_id == TYPED_PROGRAM_INVALID_ID {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_TYPE,
                body.body_id, CORE_STMT_INVALID_ID, fact.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
        }
    } else if fact.kind == CORE_SEMANTIC_FACT_RESOLVED_CALL {
        if fact.expr_id == CORE_EXPR_INVALID_ID || lowered_program_coreir_call_payload_is_frozen(fact) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_CALL,
                body.body_id, CORE_STMT_INVALID_ID, fact.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
        }
    } else if fact.kind == CORE_SEMANTIC_FACT_FIELD_ID {
        if fact.field_id == TYPED_PROGRAM_INVALID_ID ||
            (fact.expr_id == CORE_EXPR_INVALID_ID && fact.place_id == CORE_PLACE_INVALID_ID) {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_FIELD,
                body.body_id, CORE_STMT_INVALID_ID, fact.expr_id, fact.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
        }
    } else if fact.kind == CORE_SEMANTIC_FACT_PROOF_RESULT {
        if lowered_program_coreir_proof_payload_is_frozen(fact) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_PROOF,
                body.body_id, CORE_STMT_INVALID_ID, fact.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, fact.fact_id, fact.source_span_id);
        }
    } else if fact.kind == CORE_SEMANTIC_FACT_CLEANUP {
        if fact.cleanup_edge_id == CORE_CLEANUP_EDGE_INVALID_ID ||
            fact.drop_defer_plan_id == TYPED_PROGRAM_INVALID_ID ||
            fact.cleanup_scope_id == TYPED_PROGRAM_INVALID_ID {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, fact.stmt_id, fact.expr_id, CORE_PLACE_INVALID_ID,
                fact.cleanup_edge_id, fact.fact_id, fact.source_span_id);
        }
    } else if fact.kind == CORE_SEMANTIC_FACT_CAPABILITY {
        if lowered_program_coreir_capability_is_requirement_only(fact) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_CAPABILITY_SEMANTICS,
                body.body_id, fact.stmt_id, fact.expr_id, fact.place_id,
                fact.cleanup_edge_id, fact.fact_id, fact.source_span_id);
        }
    }
    return 0;
}

fn lowered_program_coreir_verify_body_facts(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.semantic_fact_count {
        const fact: &CoreSemanticFact = lowered_program_coreir_get_body_fact(program, body, offset);
        if fact == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
        if lowered_program_coreir_verify_fact_refs(program, body, fact, result) != 0 {
            return -1;
        }
        if lowered_program_coreir_verify_fact_payload(body, fact, result) != 0 {
            return -1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_body_stmts(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.root_stmt_count {
        const index: usize = lowered_program_i32_to_usize(body.root_stmt_start + offset);
        const stmt: &CoreStmt = semantic_vector_item_ptr(&program.core_stmts, index) as &CoreStmt;
        if stmt == null || stmt.stmt_id < 0 || stmt.body_id != body.body_id {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, body.root_stmt_start + offset, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
        if lowered_program_coreir_stmt_kind_is_dumped_and_verified(stmt.kind) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNDUMPED_BODY_SEMANTIC,
                body.body_id, stmt.stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, stmt.source_span_id);
        }
        if stmt.expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, stmt.expr_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, stmt.stmt_id, stmt.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, stmt.source_span_id);
        }
        if stmt.place_id != CORE_PLACE_INVALID_ID && lowered_program_coreir_find_place(program, body.body_id, stmt.place_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, stmt.stmt_id, CORE_EXPR_INVALID_ID, stmt.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, stmt.source_span_id);
        }
        if lowered_program_coreir_verify_range(stmt.first_child_stmt, stmt.child_stmt_count, program.core_stmts.count) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_BODY_RANGE,
                body.body_id, stmt.stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, stmt.source_span_id);
        }
        if lowered_program_coreir_verify_range(stmt.cleanup_edge_start, stmt.cleanup_edge_count, program.core_cleanup_edges.count) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, stmt.stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, stmt.source_span_id);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_body_exprs(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.expr_count {
        const index: usize = lowered_program_i32_to_usize(body.expr_start + offset);
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, index) as &CoreExpr;
        if expr == null || expr.expr_id < 0 || expr.body_id != body.body_id {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, body.expr_start + offset, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
        if lowered_program_coreir_expr_kind_is_dumped_and_verified(expr.kind) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNDUMPED_BODY_SEMANTIC,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        if lowered_program_coreir_verify_expr_type(program, body, expr, result) != 0 { return -1; }
        if expr.kind == CORE_EXPR_KIND_CALL && lowered_program_coreir_body_has_call_fact(program, body, expr.expr_id) == 0 {
            if expr.target_function_id == TYPED_PROGRAM_INVALID_ID &&
                expr.target_decl_id == TYPED_PROGRAM_INVALID_ID {
                return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_CALL,
                    body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                    CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
            }
        }
        if expr.place_id != CORE_PLACE_INVALID_ID && lowered_program_coreir_find_place(program, body.body_id, expr.place_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, expr.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        if expr.lhs_expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, expr.lhs_expr_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        if expr.rhs_expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, expr.rhs_expr_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        if expr.callee_expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, expr.callee_expr_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        if expr.proof_result_id != TYPED_PROGRAM_INVALID_ID &&
            lowered_program_coreir_body_has_proof_fact(program, body, expr.expr_id) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_PROOF,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        if expr.capability_id > 0 && lowered_program_coreir_body_has_capability_fact(program, body, expr.expr_id) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_CAPABILITY_SEMANTICS,
                body.body_id, CORE_STMT_INVALID_ID, expr.expr_id, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, expr.source_span_id);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_body_places(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.place_count {
        const index: usize = lowered_program_i32_to_usize(body.place_start + offset);
        const place: &CorePlace = semantic_vector_item_ptr(&program.core_places, index) as &CorePlace;
        if place == null || place.place_id < 0 || place.body_id != body.body_id {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, body.place_start + offset,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
        if lowered_program_coreir_place_kind_is_dumped_and_verified(place.kind) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNDUMPED_BODY_SEMANTIC,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, place.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, place.source_span_id);
        }
        if place.type_id == TYPED_PROGRAM_INVALID_ID {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_TYPE,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, place.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, place.source_span_id);
        }
        if place.kind == CORE_PLACE_KIND_FIELD && place.field_id == TYPED_PROGRAM_INVALID_ID {
            if lowered_program_coreir_body_has_field_fact(program, body, place.place_id) == 0 {
                return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNFROZEN_FIELD,
                    body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, place.place_id,
                    CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, place.source_span_id);
            }
        }
        if place.base_place_id != CORE_PLACE_INVALID_ID && lowered_program_coreir_find_place(program, body.body_id, place.base_place_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, place.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, place.source_span_id);
        }
        if place.index_expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, place.index_expr_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                body.body_id, CORE_STMT_INVALID_ID, place.index_expr_id, place.place_id,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, place.source_span_id);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_body_cleanups(program: &LoweredProgram, body: &CoreBody, result: &CoreVerifierResult) i32 {
    var offset: i32 = 0;
    while offset < body.cleanup_edge_count {
        const index: usize = lowered_program_i32_to_usize(body.cleanup_edge_start + offset);
        const edge: &CoreCleanupEdge = semantic_vector_item_ptr(&program.core_cleanup_edges, index) as &CoreCleanupEdge;
        if edge == null || edge.edge_id < 0 || edge.body_id != body.body_id {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, body.source_span_id);
        }
        if lowered_program_coreir_cleanup_kind_is_dumped_and_verified(edge.kind) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_UNDUMPED_BODY_SEMANTIC,
                body.body_id, edge.from_stmt_id, edge.payload_expr_id, CORE_PLACE_INVALID_ID,
                edge.edge_id, CORE_SEMANTIC_FACT_INVALID_ID, edge.source_span_id);
        }
        if lowered_program_coreir_find_stmt(program, body.body_id, edge.from_stmt_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, edge.from_stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                edge.edge_id, CORE_SEMANTIC_FACT_INVALID_ID, edge.source_span_id);
        }
        if edge.to_stmt_id != CORE_STMT_INVALID_ID && lowered_program_coreir_find_stmt(program, body.body_id, edge.to_stmt_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, edge.to_stmt_id, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                edge.edge_id, CORE_SEMANTIC_FACT_INVALID_ID, edge.source_span_id);
        }
        if edge.payload_expr_id != CORE_EXPR_INVALID_ID && lowered_program_coreir_find_expr(program, body.body_id, edge.payload_expr_id) == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, edge.from_stmt_id, edge.payload_expr_id, CORE_PLACE_INVALID_ID,
                edge.edge_id, CORE_SEMANTIC_FACT_INVALID_ID, edge.source_span_id);
        }
        if edge.cleanup_scope_id == TYPED_PROGRAM_INVALID_ID || edge.drop_defer_plan_id == TYPED_PROGRAM_INVALID_ID {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, edge.from_stmt_id, edge.payload_expr_id, CORE_PLACE_INVALID_ID,
                edge.edge_id, CORE_SEMANTIC_FACT_INVALID_ID, edge.source_span_id);
        }
        if lowered_program_coreir_body_has_cleanup_fact(program, body, edge.edge_id) == 0 {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP,
                body.body_id, edge.from_stmt_id, edge.payload_expr_id, CORE_PLACE_INVALID_ID,
                edge.edge_id, CORE_SEMANTIC_FACT_INVALID_ID, edge.source_span_id);
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_coreir_verify_bodies(program: &LoweredProgram, result: &CoreVerifierResult) i32 {
    var i: usize = 0usize;
    while i < program.core_bodies.count {
        const body: &CoreBody = semantic_vector_item_ptr(&program.core_bodies, i) as &CoreBody;
        if body == null {
            return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_REFERENCE,
                CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
                CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
        }
        if lowered_program_coreir_verify_body_ranges(program, body, result) != 0 { return -1; }
        if lowered_program_coreir_verify_body_facts(program, body, result) != 0 { return -1; }
        if lowered_program_coreir_verify_naked_body(program, body, result) != 0 { return -1; }
        if lowered_program_coreir_verify_body_stmts(program, body, result) != 0 { return -1; }
        if lowered_program_coreir_verify_body_exprs(program, body, result) != 0 { return -1; }
        if lowered_program_coreir_verify_body_places(program, body, result) != 0 { return -1; }
        if lowered_program_coreir_verify_body_cleanups(program, body, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn lowered_program_coreir_verify_counts(program: &LoweredProgram, result: &CoreVerifierResult) i32 {
    if program.function_count != program.functions.count || program.core_body_count != program.core_bodies.count {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_PROGRAM,
            CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
    }
    if program.core_stmt_count != program.core_stmts.count || program.core_expr_count != program.core_exprs.count {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_PROGRAM,
            CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
    }
    if program.core_place_count != program.core_places.count || program.core_cleanup_edge_count != program.core_cleanup_edges.count {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_PROGRAM,
            CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
    }
    if program.core_semantic_fact_count != program.core_semantic_facts.count {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_PROGRAM,
            CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
    }
    return 0;
}

/// 功能说明：验证 frozen CoreIR / CoreBody 合同并返回首个稳定诊断。
/// 参数说明：`program` 为目标 LoweredProgram，`result` 接收错误码、source span 和相关 CoreIR ID。
/// 返回值说明：验证通过返回 `0` 并写入 ok 结果；失败返回 `-1` 并写入首个错误。
export fn lowered_program_verify_coreir_result(program: &LoweredProgram, result: &CoreVerifierResult) i32 {
    if result == null {
        return -1;
    }
    lowered_program_coreir_verify_reset(result);
    if program == null {
        return lowered_program_coreir_verify_fail(result, COREIR_VERIFY_ERR_INVALID_PROGRAM,
            CORE_BODY_INVALID_ID, CORE_STMT_INVALID_ID, CORE_EXPR_INVALID_ID, CORE_PLACE_INVALID_ID,
            CORE_CLEANUP_EDGE_INVALID_ID, CORE_SEMANTIC_FACT_INVALID_ID, TYPED_PROGRAM_INVALID_ID);
    }
    if lowered_program_coreir_verify_counts(program, result) != 0 { return -1; }
    if lowered_program_coreir_verify_function_bodies(program, result) != 0 { return -1; }
    if lowered_program_coreir_verify_bodies(program, result) != 0 { return -1; }
    result.ok = 1;
    result.error_code = COREIR_VERIFY_OK;
    return 0;
}

/// 功能说明：验证 frozen CoreIR / CoreBody 合同的便捷入口。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：验证通过返回 `0`；失败返回 `-1`，详细错误可使用 `lowered_program_verify_coreir_result` 获取。
export fn lowered_program_verify_coreir(program: &LoweredProgram) i32 {
    var result: CoreVerifierResult = lowered_program_coreir_verify_ok_result();
    return lowered_program_verify_coreir_result(program, &result);
}

/// 功能说明：检查 PortableMIR lowering 输入是否只依赖已冻结的 LoweredProgram/CoreBody 合同。
/// 参数说明：`input` 包含 LoweredProgram 和目标 CoreBodyId；不接收 TypeChecker 或 TypedProgram。
/// 返回值说明：输入存在、CoreBody 存在且 CoreIR verifier 通过时返回 `1`，否则返回 `0`。
export fn portable_mir_core_input_is_frozen(input: &PortableMirCoreInput) i32 {
    if input == null || input.program == null {
        return 0;
    }
    if lowered_program_find_core_body(input.program, input.body_id) == null {
        return 0;
    }
    if lowered_program_verify_coreir(input.program) != 0 {
        return 0;
    }
    return 1;
}

// ---- Phase 5: debug dump ----

fn lowered_program_dump_enabled() i32 {
    const value: *byte = getenv("UYA_DUMP_LOWERED_PROGRAM" as *byte);
    if value == null {
        return 0;
    }
    if value[0] == 49 as byte && value[1] == 0 as byte {
        return 1;
    }
    return 0;
}

fn lowered_program_coreir_dump_enabled() i32 {
    const value: *byte = getenv("UYA_DUMP_COREIR" as *byte);
    if value == null {
        return 0;
    }
    if value[0] == 49 as byte && value[1] == 0 as byte {
        return 1;
    }
    return 0;
}

fn lowered_program_dump_coreir_bodies(program: &LoweredProgram) void {
    var i: usize = 0usize;
    while i < program.core_bodies.count {
        const body: &CoreBody = semantic_vector_item_ptr(&program.core_bodies, i) as &CoreBody;
        if body != null {
            fprintf(libc.stderr, "body #%d function=%d decl=%d roots=%d+%d exprs=%d+%d places=%d+%d cleanups=%d+%d facts=%d+%d source=%d flags=%d\n" as *byte,
                body.body_id, body.function_id, body.decl_id, body.root_stmt_start, body.root_stmt_count,
                body.expr_start, body.expr_count, body.place_start, body.place_count,
                body.cleanup_edge_start, body.cleanup_edge_count, body.semantic_fact_start,
                body.semantic_fact_count, body.source_span_id, body.flags);
        }
        i = i + 1usize;
    }
}

fn lowered_program_dump_coreir_stmts(program: &LoweredProgram) void {
    var i: usize = 0usize;
    while i < program.core_stmts.count {
        const stmt: &CoreStmt = semantic_vector_item_ptr(&program.core_stmts, i) as &CoreStmt;
        if stmt != null {
            fprintf(libc.stderr, "stmt #%d body=%d kind=%d parent=%d children=%d+%d expr=%d place=%d cleanup=%d+%d source=%d scope=%d flags=%d\n" as *byte,
                stmt.stmt_id, stmt.body_id, stmt.kind, stmt.parent_stmt_id, stmt.first_child_stmt,
                stmt.child_stmt_count, stmt.expr_id, stmt.place_id, stmt.cleanup_edge_start,
                stmt.cleanup_edge_count, stmt.source_span_id, stmt.cleanup_scope_id, stmt.flags);
        }
        i = i + 1usize;
    }
}

fn lowered_program_dump_coreir_exprs(program: &LoweredProgram) void {
    var i: usize = 0usize;
    while i < program.core_exprs.count {
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, i) as &CoreExpr;
        if expr != null {
            fprintf(libc.stderr, "expr #%d body=%d kind=%d source_expr=%d type=%d literal=%ld lhs=%d rhs=%d callee=%d place=%d target_fn=%d target_decl=%d field=%d proof=%d capability=%d source=%d flags=%d\n" as *byte,
                expr.expr_id, expr.body_id, expr.kind, expr.source_expr_id, expr.type_id,
                expr.literal_i64, expr.lhs_expr_id, expr.rhs_expr_id, expr.callee_expr_id, expr.place_id,
                expr.target_function_id, expr.target_decl_id, expr.field_id, expr.proof_result_id,
                expr.capability_id, expr.source_span_id, expr.flags);
        }
        i = i + 1usize;
    }
}

fn lowered_program_dump_coreir_places(program: &LoweredProgram) void {
    var i: usize = 0usize;
    while i < program.core_places.count {
        const place: &CorePlace = semantic_vector_item_ptr(&program.core_places, i) as &CorePlace;
        if place != null {
            fprintf(libc.stderr, "place #%d body=%d kind=%d source_expr=%d type=%d base=%d index=%d field=%d symbol=%d source=%d flags=%d\n" as *byte,
                place.place_id, place.body_id, place.kind, place.source_expr_id, place.type_id,
                place.base_place_id, place.index_expr_id, place.field_id, place.symbol_id,
                place.source_span_id, place.flags);
        }
        i = i + 1usize;
    }
}

fn lowered_program_dump_coreir_cleanups(program: &LoweredProgram) void {
    var i: usize = 0usize;
    while i < program.core_cleanup_edges.count {
        const edge: &CoreCleanupEdge = semantic_vector_item_ptr(&program.core_cleanup_edges, i) as &CoreCleanupEdge;
        if edge != null {
            fprintf(libc.stderr, "cleanup #%d body=%d kind=%d from=%d to=%d scope=%d drop_defer=%d payload=%d source=%d flags=%d\n" as *byte,
                edge.edge_id, edge.body_id, edge.kind, edge.from_stmt_id, edge.to_stmt_id,
                edge.cleanup_scope_id, edge.drop_defer_plan_id, edge.payload_expr_id,
                edge.source_span_id, edge.flags);
        }
        i = i + 1usize;
    }
}

fn lowered_program_dump_coreir_facts(program: &LoweredProgram) void {
    var i: usize = 0usize;
    while i < program.core_semantic_facts.count {
        const fact: &CoreSemanticFact = semantic_vector_item_ptr(&program.core_semantic_facts, i) as &CoreSemanticFact;
        if fact != null {
            fprintf(libc.stderr, "fact #%d kind=%d body=%d stmt=%d expr=%d source_expr=%d place=%d cleanup=%d\n" as *byte,
                fact.fact_id, fact.kind, fact.body_id, fact.stmt_id, fact.expr_id,
                fact.source_expr_id, fact.place_id, fact.cleanup_edge_id);
            fprintf(libc.stderr, "  call kind=%d target_fn=%d target_decl=%d target_symbol=%d mono=%d arg_count=%d receiver_type=%d method_symbol=%d interface_symbol=%d slot=%d\n" as *byte,
                fact.call_target_kind, fact.target_function_id, fact.target_decl_id, fact.target_symbol_id,
                fact.mono_instance_id, fact.arg_count, fact.receiver_type_id, fact.method_symbol_id,
                fact.interface_symbol_id, fact.vtable_slot);
            fprintf(libc.stderr, "  meta field=%d type=%d proof=%d proof_status=%d proof_error=%d source=%d drop_defer=%d scope=%d capability=%d flags=%d\n" as *byte,
                fact.field_id, fact.type_id, fact.proof_result_id, fact.proof_status, fact.proof_error_id,
                fact.source_span_id, fact.drop_defer_plan_id, fact.cleanup_scope_id, fact.capability_id,
                fact.flags);
        }
        i = i + 1usize;
    }
}

/// 功能说明：在设置 `UYA_DUMP_LOWERED_PROGRAM=1` 时向 stderr 打印 LoweredProgram 摘要。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：无；默认关闭，不计入性能/内存 KPI。
export fn lowered_program_maybe_dump_summary(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    if lowered_program_dump_enabled() == 0 {
        return;
    }
    const stats: LoweredProgramStats = lowered_program_stats(program);
    fprintf(libc.stderr, "=== lowered program ===\n" as *byte);
    fprintf(libc.stderr, "functions=%zu body_ops=%zu core_bodies=%zu core_stmts=%zu core_exprs=%zu core_places=%zu core_cleanup_edges=%zu core_semantic_facts=%zu globals=%zu types=%zu interfaces=%zu err_unions=%zu async_frames=%zu drop_defers=%zu helpers=%zu work_items=%zu\n" as *byte,
        program.function_count, program.body_op_count, program.core_body_count, program.core_stmt_count,
        program.core_expr_count, program.core_place_count, program.core_cleanup_edge_count,
        program.core_semantic_fact_count, program.global_count, program.type_count, program.interface_count,
        program.err_union_count, program.async_frame_count, program.drop_defer_count, program.helper_count,
        program.work_item_count);
    fprintf(libc.stderr, "tables=%d table_items=%zu table_capacity=%zu table_bytes=%zu table_reallocs=%d\n" as *byte,
        stats.table_count, stats.table_items, stats.table_capacity, stats.table_bytes, stats.table_realloc_count);
    fprintf(libc.stderr, "estimated_bytes=%zu peak_bytes=%zu\n" as *byte,
        lowered_program_estimated_bytes(program), lowered_program_peak_bytes(program));
    fprintf(libc.stderr, "=== lowered program end ===\n" as *byte);
}

/// 功能说明：在设置 `UYA_DUMP_COREIR=1` 时向 stderr 打印稳定 CoreIR / CoreBody 文本摘要。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：无；默认关闭，不计入性能/内存 KPI，输出只包含 CoreIR 稳定 ID 和 metadata。
export fn lowered_program_maybe_dump_coreir(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    if lowered_program_coreir_dump_enabled() == 0 {
        return;
    }
    fprintf(libc.stderr, "=== coreir ===\n" as *byte);
    fprintf(libc.stderr, "core_bodies=%zu core_stmts=%zu core_exprs=%zu core_places=%zu core_cleanup_edges=%zu core_semantic_facts=%zu\n" as *byte,
        program.core_body_count, program.core_stmt_count, program.core_expr_count, program.core_place_count,
        program.core_cleanup_edge_count, program.core_semantic_fact_count);
    lowered_program_dump_coreir_bodies(program);
    lowered_program_dump_coreir_stmts(program);
    lowered_program_dump_coreir_exprs(program);
    lowered_program_dump_coreir_places(program);
    lowered_program_dump_coreir_cleanups(program);
    lowered_program_dump_coreir_facts(program);
    fprintf(libc.stderr, "=== coreir end ===\n" as *byte);
}
