export const CORE_PLACE_FLAG_NAKED_ASM_OPERAND: i32 = 2;
export const CORE_CLEANUP_EDGE_KIND_RETURN: i32 = 2;
export const CORE_SEMANTIC_FACT_RESOLVED_CALL: i32 = 1;
export const CORE_SEMANTIC_FACT_METHOD_DISPATCH: i32 = 2;
export const CORE_SEMANTIC_FACT_FIELD_ID: i32 = 3;
export const CORE_SEMANTIC_FACT_TYPE_ID: i32 = 4;
export const CORE_SEMANTIC_FACT_PROOF_RESULT: i32 = 5;
