        if existing != null && existing.type_id == item.type_id {
            return 0;
        }
        i = i + 1usize;
    }
    if lowered_program_append_error_union(program, item) != 0 {
        return -1;
    }
    var work: LowerWorkItem = LowerWorkItem{
        kind: LOWER_WORK_ITEM_ERR_UNION,
        primary_id: item.type_id,
        secondary_id: item.payload_type_id,
    };
    return lowered_program_append_work_item(program, &work);
}

