        while j > 0usize {
            const a: &ErrorUnionLayout = semantic_vector_item_ptr(vec, j - 1usize) as &ErrorUnionLayout;
            const b: &ErrorUnionLayout = semantic_vector_item_ptr(vec, j) as &ErrorUnionLayout;
            if a == null || b == null {
                return -1;
            }
            if a.type_id <= b.type_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 function_id 对 AsyncFramePlan 表做稳定插入排序。
