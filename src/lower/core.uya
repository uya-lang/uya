/// 功能说明：追加 async frame 计划。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为待追加 frame 计划。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn lowered_program_append_async_frame(program: &LoweredProgram, item: &AsyncFramePlan) i32 {
    if program == null || item == null {
        return -1;
    }
    if semantic_vector_append(&program.async_frames, item as &const void) != 0 {
