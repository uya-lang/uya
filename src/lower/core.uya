            const b: &AsyncFramePlan = semantic_vector_item_ptr(vec, j) as &AsyncFramePlan;
            if a == null || b == null {
                return -1;
            }
            if a.function_id <= b.function_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 (owner_function_id, scope_id) 对 DropDeferPlan 表做稳定插入排序。
export fn lowered_program_sort_drop_defer_plans(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.drop_defer_plans;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &DropDeferPlan = semantic_vector_item_ptr(vec, j - 1usize) as &DropDeferPlan;
            const b: &DropDeferPlan = semantic_vector_item_ptr(vec, j) as &DropDeferPlan;
            if a == null || b == null {
                return -1;
            }
            var greater: i32 = 0;
            if a.owner_function_id > b.owner_function_id {
                greater = 1;
            } else if a.owner_function_id == b.owner_function_id && a.scope_id > b.scope_id {
                greater = 1;
            }
            if greater == 0 {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：按 helper_id 对 RuntimeHelper 表做稳定插入排序。
export fn lowered_program_sort_helpers(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.helpers;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &RuntimeHelper = semantic_vector_item_ptr(vec, j - 1usize) as &RuntimeHelper;
            const b: &RuntimeHelper = semantic_vector_item_ptr(vec, j) as &RuntimeHelper;
            if a == null || b == null {
                return -1;
            }
            if a.helper_id <= b.helper_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：对 LoweredProgram 所有输出表按稳定 ID 排序，保证后端确定性输出。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：成功返回 `0`，任一子表排序失败返回 `-1`。
export fn lowered_program_sort_stable(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    if lowered_program_sort_functions(program) != 0 {
        return -1;
    }
    if lowered_program_sort_globals(program) != 0 {
        return -1;
    }
    if lowered_program_sort_types(program) != 0 {
        return -1;
    }
    if lowered_program_sort_interfaces(program) != 0 {
        return -1;
    }
    if lowered_program_sort_err_unions(program) != 0 {
        return -1;
    }
    if lowered_program_sort_async_frames(program) != 0 {
        return -1;
    }
    if lowered_program_sort_drop_defer_plans(program) != 0 {
        return -1;
    }
    if lowered_program_sort_helpers(program) != 0 {
        return -1;
    }
    return 0;
}

// ---- Phase 5: debug dump ----

fn lowered_program_dump_enabled() i32 {
    const value: *byte = getenv("UYA_DUMP_LOWERED_PROGRAM" as *byte);
    if value == null {
        return 0;
    }
    if value[0] == 49 as byte && value[1] == 0 as byte {
        return 1;
    }
    return 0;
}

/// 功能说明：在设置 `UYA_DUMP_LOWERED_PROGRAM=1` 时向 stderr 打印 LoweredProgram 摘要。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：无；默认关闭，不计入性能/内存 KPI。
export fn lowered_program_maybe_dump_summary(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    if lowered_program_dump_enabled() == 0 {
        return;
    }
    const stats: LoweredProgramStats = lowered_program_stats(program);
    fprintf(libc.stderr, "=== lowered program ===\n" as *byte);
    fprintf(libc.stderr, "functions=%zu body_ops=%zu globals=%zu types=%zu interfaces=%zu err_unions=%zu async_frames=%zu drop_defers=%zu helpers=%zu work_items=%zu\n" as *byte,
        program.function_count, program.body_op_count, program.global_count, program.type_count, program.interface_count,
        program.err_union_count, program.async_frame_count, program.drop_defer_count, program.helper_count, program.work_item_count);
    fprintf(libc.stderr, "tables=%d table_items=%zu table_capacity=%zu table_bytes=%zu table_reallocs=%d\n" as *byte,
        stats.table_count, stats.table_items, stats.table_capacity, stats.table_bytes, stats.table_realloc_count);
    fprintf(libc.stderr, "estimated_bytes=%zu peak_bytes=%zu\n" as *byte,
        lowered_program_estimated_bytes(program), lowered_program_peak_bytes(program));
    fprintf(libc.stderr, "=== lowered program end ===\n" as *byte);
}
