export const COREIR_VERIFY_ERR_UNDUMPED_BODY_SEMANTIC: i32 = 12;
export const COREIR_VERIFY_ERR_TYPE_MISMATCH: i32 = 13;
export const LOWER_WORK_ITEM_FUNCTION: i32 = 1;
export const LOWER_WORK_ITEM_TYPE: i32 = 2;
export const LOWER_WORK_ITEM_ERR_UNION: i32 = 3;
export const LOWER_WORK_ITEM_ASYNC_FRAME: i32 = 4;
export const LOWER_WORK_ITEM_RUNTIME_HELPER: i32 = 5;
export const LOWER_WORK_ITEM_INTERFACE: i32 = 6;
export const LOWER_WORK_ITEM_DROP_DEFER: i32 = 7;
export const LOWERED_RUNTIME_HELPER_UNKNOWN: i32 = 0;
export const LOWERED_BODY_OP_NOP: i32 = 0;
export const LOWERED_BODY_OP_RETURN_CONST_I32: i32 = 1;
export const LOWERED_BODY_OP_RETURN_CALL: i32 = 2;
export const LOWERED_BODY_OP_ADD_I32: i32 = 3;
export const LOWERED_BODY_OP_LOCAL_CALL_I32: i32 = 4;
export const LOWERED_BODY_OP_RETURN_LOCAL_I32: i32 = 5;
export const LOWERED_BODY_OP_LOCAL_CALL_CONST1_I32: i32 = 6;
export const LOWERED_BODY_OP_RETURN_PARAM_I32: i32 = 7;
export const LOWERED_BODY_OP_LOCAL_CALL_CONST2_I32: i32 = 8;
export const LOWERED_BODY_OP_RETURN_ADD_PARAMS_I32: i32 = 9;
export const LOWERED_BODY_OP_LOCAL_I32_CONST: i32 = 10;
export const LOWERED_BODY_OP_LOCAL_CALL_ADDR1_I32: i32 = 11;
export const LOWERED_BODY_OP_STORE_PARAM0_CONST_I32: i32 = 12;
export const LOWERED_BODY_OP_STORE_PARAMS01_CONST_I32: i32 = 13;
export const LOWERED_BODY_OP_LOCAL_CALL_ADDR2_I32: i32 = 14;
export const LOWERED_BODY_OP_RETURN_ARGC_I32: i32 = 15;
export const LOWERED_BODY_OP_LOCAL_ARGC_I32: i32 = 16;
export const LOWERED_BODY_OP_LOCAL_ARGV_PTR: i32 = 17;
export const LOWERED_BODY_OP_RETURN_ARGV_BYTE_I32: i32 = 18;
export const LOWERED_BODY_OP_LOCAL_CALL_PARSE11_I32: i32 = 19;
export const LOWERED_BODY_OP_STORE_PARAM_CONST_I32: i32 = 20;
export const LOWERED_BODY_OP_IF_LOCAL_EQ_CONST_RETURN_I32: i32 = 21;
export const LOWERED_BODY_OP_IF_LOCAL_NE_CONST_RETURN_I32: i32 = 22;
export const LOWERED_BODY_OP_IF_LOCAL_LE_CONST_ASSIGN_CONST_I32: i32 = 23;
export const LOWERED_BODY_OP_SET_STACK_LIMIT_BYTES: i32 = 24;
export const LOWERED_BODY_COMPAT_OPCODE_COUNT: i32 = 25;
export const LOWERED_BODY_COMPAT_MAX_OPCODE: i32 = LOWERED_BODY_OP_SET_STACK_LIMIT_BYTES;

/// 功能说明：判断 body op opcode 是否属于冻结的过渡兼容集合。
/// 参数说明：`opcode` 为待检查的 LoweredBodyOp opcode。
/// 返回值说明：属于现有兼容集合返回 `1`，未知或未来新增 opcode 返回 `0`。
export fn lowered_body_op_is_transition_compat_opcode(opcode: i32) i32 {
    if opcode == LOWERED_BODY_OP_NOP { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_CONST_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_CALL { return 1; }
    if opcode == LOWERED_BODY_OP_ADD_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_CALL_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_LOCAL_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_CALL_CONST1_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_PARAM_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_CALL_CONST2_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_ADD_PARAMS_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_I32_CONST { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_CALL_ADDR1_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_STORE_PARAM0_CONST_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_STORE_PARAMS01_CONST_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_CALL_ADDR2_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_ARGC_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_ARGC_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_ARGV_PTR { return 1; }
    if opcode == LOWERED_BODY_OP_RETURN_ARGV_BYTE_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_LOCAL_CALL_PARSE11_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_STORE_PARAM_CONST_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_IF_LOCAL_EQ_CONST_RETURN_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_IF_LOCAL_NE_CONST_RETURN_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_IF_LOCAL_LE_CONST_ASSIGN_CONST_I32 { return 1; }
    if opcode == LOWERED_BODY_OP_SET_STACK_LIMIT_BYTES { return 1; }
    return 0;
}

/// 功能说明：记录一个已经收敛到具体实例的函数。
/// 参数说明：无；字段均为 SemanticDb/TypedProgram 阶段分配的稳定整数 ID 或 range。
/// 返回值说明：无。
export struct ConcreteFunction {
    function_id: FunctionId,
    decl_id: DeclId,
    mono_instance_id: MonoInstanceId,
    body_start: i32,
    body_count: i32,
    flags: i32,
}

/// 功能说明：记录一个 concrete function 的结构化 Core-level 函数体入口。
/// 参数说明：无；字段用稳定 ID 和 range 指向后续 CoreStmt/CoreExpr/CorePlace/CleanupEdge 表。
/// 返回值说明：无。
export struct CoreBody {
    body_id: CoreBodyId,
    function_id: FunctionId,
    decl_id: DeclId,
    root_stmt_start: CoreStmtId,
    root_stmt_count: i32,
    expr_start: CoreExprId,
    expr_count: i32,
    place_start: CorePlaceId,
    place_count: i32,
    cleanup_edge_start: CoreCleanupEdgeId,
    cleanup_edge_count: i32,
    semantic_fact_start: CoreSemanticFactId,
    semantic_fact_count: i32,
    source_span_id: i32,
    flags: i32,
}

/// 功能说明：记录 CoreBody 内一条结构化 Core-level statement。
/// 参数说明：无；字段保存 statement kind、树形子 statement range、关联表达式/位置和 cleanup edge range。
/// 返回值说明：无。
export struct CoreStmt {
    stmt_id: CoreStmtId,
    kind: i32,
    body_id: CoreBodyId,
    parent_stmt_id: CoreStmtId,
    first_child_stmt: CoreStmtId,
    child_stmt_count: i32,
    expr_id: CoreExprId,
    place_id: CorePlaceId,
    cleanup_edge_start: CoreCleanupEdgeId,
    cleanup_edge_count: i32,
    source_span_id: i32,
    cleanup_scope_id: i32,
    flags: i32,
}

/// 功能说明：记录 CoreBody 内一条 typed Core-level expression。
/// 参数说明：无；字段保存源 ExprId、TypeId、子表达式、已解析目标占位和 proof/capability/source metadata。
/// 返回值说明：无。
export struct CoreExpr {
    expr_id: CoreExprId,
    kind: i32,
    body_id: CoreBodyId,
    source_expr_id: ExprId,
    type_id: TypeId,
    literal_i64: i64,
    lhs_expr_id: CoreExprId,
    rhs_expr_id: CoreExprId,
    callee_expr_id: CoreExprId,
    place_id: CorePlaceId,
    target_function_id: FunctionId,
    target_decl_id: DeclId,
    field_id: i32,
    proof_result_id: i32,
    capability_id: i32,
    source_span_id: i32,
    flags: i32,
}

/// 功能说明：记录 CoreBody 内一个可寻址位置。
/// 参数说明：无；字段保存 local/param/global/field/index/slice/deref 等 place 的稳定引用信息。
/// 返回值说明：无。
export struct CorePlace {
    place_id: CorePlaceId,
    kind: i32,
    body_id: CoreBodyId,
    source_expr_id: ExprId,
    type_id: TypeId,
    base_place_id: CorePlaceId,
    index_expr_id: CoreExprId,
    field_id: i32,
    symbol_id: SymbolId,
    source_span_id: i32,
    flags: i32,
}

/// 功能说明：记录 CoreBody 中控制流离开作用域时必须经过的 cleanup edge。
/// 参数说明：无；字段保存 edge kind、from/to statement、cleanup scope、drop/defer plan 和关联 payload expression。
/// 返回值说明：无。
export struct CoreCleanupEdge {
    edge_id: CoreCleanupEdgeId,
    kind: i32,
    body_id: CoreBodyId,
    from_stmt_id: CoreStmtId,
    to_stmt_id: CoreStmtId,
    cleanup_scope_id: i32,
    drop_defer_plan_id: i32,
    payload_expr_id: CoreExprId,
    source_span_id: i32,
    flags: i32,
}

/// 功能说明：记录 CoreBody 已冻结、可直接交给 PortableMIR 消费的语义事实。
/// 参数说明：无；`kind` 区分 call、method dispatch、field/type/proof/source/cleanup/capability 等 metadata。
/// 返回值说明：无。
export struct CoreSemanticFact {
    fact_id: CoreSemanticFactId,
    kind: i32,
    body_id: CoreBodyId,
    stmt_id: CoreStmtId,
    expr_id: CoreExprId,
    source_expr_id: ExprId,
    place_id: CorePlaceId,
    cleanup_edge_id: CoreCleanupEdgeId,
    call_target_kind: i32,
    target_function_id: FunctionId,
    target_decl_id: DeclId,
    target_symbol_id: SymbolId,
    mono_instance_id: MonoInstanceId,
    arg_count: i32,
    receiver_type_id: TypeId,
    method_symbol_id: SymbolId,
    interface_symbol_id: SymbolId,
    vtable_slot: i32,
    field_id: FieldId,
    type_id: TypeId,
    proof_result_id: i32,
    proof_status: i32,
    proof_error_id: i32,
    source_span_id: i32,
    drop_defer_plan_id: i32,
    cleanup_scope_id: i32,
    capability_id: i32,
    flags: i32,
}

/// 功能说明：记录一个已经收敛到具体布局的类型。
/// 参数说明：无；字段保存类型、声明、布局和方法 range 的稳定整数 ID。
/// 返回值说明：无。
export struct ConcreteType {
    type_id: TypeId,
    decl_id: DeclId,
    layout_id: i32,
    method_range_start: i32,
    method_range_count: i32,
}

/// 功能说明：记录一个全局对象及其初始化来源。
/// 参数说明：无；字段保存全局、声明、类型和初始化表达式的稳定整数 ID。
/// 返回值说明：无。
export struct GlobalObject {
    global_id: i32,
    decl_id: DeclId,
    type_id: TypeId,
    init_expr_id: ExprId,
}

/// 功能说明：记录接口派发计划。
/// 参数说明：无；字段保存接口类型、符号和方法 range 的稳定整数 ID。
/// 返回值说明：无。
export struct InterfacePlan {
    type_id: TypeId,
    symbol_id: SymbolId,
    method_range_start: i32,
    method_range_count: i32,
}

/// 功能说明：记录运行时 helper 需求。
/// 参数说明：无；`kind` 标识 helper 类型，`name_id` 指向 intern 后的 helper 名称。
/// 返回值说明：无。
export struct RuntimeHelper {
    helper_id: i32,
    kind: i32,
    name_id: InternedNameId,
}

/// 功能说明：记录 error union 的具体布局。
/// 参数说明：无；字段保存 error union、payload 和 error tag 的类型 ID。
/// 返回值说明：无。
export struct ErrorUnionLayout {
    type_id: TypeId,
    payload_type_id: TypeId,
    error_type_id: TypeId,
}

/// 功能说明：记录 async 函数的 frame 计划。
/// 参数说明：无；字段保存函数、frame 类型和 frame slot range。
/// 返回值说明：无。
export struct AsyncFramePlan {
    function_id: FunctionId,
    frame_type_id: TypeId,
    slot_start: i32,
    slot_count: i32,
}

/// 功能说明：记录一个 drop/defer 收尾计划。
/// 参数说明：无；字段保存类型、drop 函数、归属函数、作用域和 defer/errdefer range 的稳定整数 ID。
/// 返回值说明：无。
export struct DropDeferPlan {
    type_id: TypeId,
    drop_function_id: FunctionId,
    owner_function_id: FunctionId,
    scope_id: i32,
    defer_start: i32,
    defer_count: i32,
    errdefer_start: i32,
    errdefer_count: i32,
}

/// 功能说明：记录 lowering worklist 中的一项待收敛工作。
/// 参数说明：无；`kind` 标识工作类型，其余 ID 含义由 kind 决定。
/// 返回值说明：无。
export struct LowerWorkItem {
    kind: i32,
    primary_id: i32,
    secondary_id: i32,
}

/// 功能说明：记录 LoweredProgram 中一条过渡兼容函数体操作。
/// 参数说明：无；字段为冻结兼容 opcode、寄存器/临时值 ID、目标 ID、立即数和标志。
/// 返回值说明：无。
export struct LoweredBodyOp {
    opcode: i32,
    dst: i32,
    src0: i32,
    src1: i32,
    target_id: i32,
    imm: i64,
    flags: i32,
}

/// 功能说明：聚合 LoweredProgram 所有动态表的统计摘要。
/// 参数说明：无；由 `lowered_program_stats` 返回。
/// 返回值说明：无。
export struct LoweredProgramStats {
    table_count: i32,
    table_items: usize,
    table_capacity: usize,
    table_bytes: usize,
    table_realloc_count: i32,
}

/// 功能说明：记录 LoweredProgram 生命周期窗口内的常驻内存统计。
/// 参数说明：无；字段由 `lowered_program_lifetime_stats` 返回。
/// 返回值说明：无。
export struct LoweredProgramLifetimeStats {
    current_bytes: usize,
    peak_bytes: usize,
    lifecycle_state: i32,
}

/// 功能说明：记录 CoreIR verifier 的首个稳定诊断位置和错误码。
/// 参数说明：无；字段保存出错的 CoreBody/节点/metadata ID，未命中字段使用 invalid ID。
/// 返回值说明：无。
export struct CoreVerifierResult {
    ok: i32,
    error_code: i32,
    body_id: CoreBodyId,
    stmt_id: CoreStmtId,
    expr_id: CoreExprId,
    place_id: CorePlaceId,
    cleanup_edge_id: CoreCleanupEdgeId,
    fact_id: CoreSemanticFactId,
    source_span_id: i32,
}

/// 功能说明：checker 之后、emitter 之前共享的闭包收敛 IR。
/// 参数说明：无；调用 `lowered_program_init` 后使用。
/// 返回值说明：无。
export struct LoweredProgram {
    arena: &CompilerArena,
    function_count: usize,
    global_count: usize,
    type_count: usize,
    interface_count: usize,
    err_union_count: usize,
    async_frame_count: usize,
    drop_defer_count: usize,
    helper_count: usize,
    work_item_count: usize,
    body_op_count: usize,
    core_body_count: usize,
    core_stmt_count: usize,
    core_expr_count: usize,
    core_place_count: usize,
    core_cleanup_edge_count: usize,
    core_semantic_fact_count: usize,
    estimated_bytes: usize,
    resident_peak_bytes: usize,
    lifecycle_state: i32,
    functions: SemanticVector,
    body_ops: SemanticVector,
    core_bodies: SemanticVector,
    core_stmts: SemanticVector,
    core_exprs: SemanticVector,
    core_places: SemanticVector,
    core_cleanup_edges: SemanticVector,
    core_semantic_facts: SemanticVector,
    globals: SemanticVector,
    types: SemanticVector,
    interfaces: SemanticVector,
    err_unions: SemanticVector,
    async_frames: SemanticVector,
    drop_defer_plans: SemanticVector,
    helpers: SemanticVector,
    worklist: SemanticVector,
}

/// 功能说明：记录 PortableMIR lowering 允许消费的 frozen CoreIR 输入边界。
/// 参数说明：无；`program` 是已冻结 LoweredProgram，`body_id` 指向其中一个已验证 CoreBody。
/// 返回值说明：无。
export struct PortableMirCoreInput {
    program: &LoweredProgram,
    body_id: CoreBodyId,
    target_profile_id: i32,
    flags: i32,
}

fn lowered_program_clear_counts(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    program.function_count = 0usize;
    program.global_count = 0usize;
    program.type_count = 0usize;
    program.interface_count = 0usize;
    program.err_union_count = 0usize;
    program.async_frame_count = 0usize;
    program.drop_defer_count = 0usize;
    program.helper_count = 0usize;
    program.work_item_count = 0usize;
    program.body_op_count = 0usize;
    program.core_body_count = 0usize;
    program.core_stmt_count = 0usize;
    program.core_expr_count = 0usize;
    program.core_place_count = 0usize;
    program.core_cleanup_edge_count = 0usize;
    program.core_semantic_fact_count = 0usize;
    program.estimated_bytes = 0usize;
}

fn lowered_program_refresh_bytes(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    const current_bytes: usize = lowered_program_storage_bytes(program);
    program.estimated_bytes = current_bytes;
    if current_bytes > program.resident_peak_bytes {
        program.resident_peak_bytes = current_bytes;
    }
}

fn lowered_program_stats_add(stats: &LoweredProgramStats, table: &SemanticVector) void {
    if stats == null || table == null {
        return;
    }
    stats.table_count = stats.table_count + 1;
    stats.table_items = stats.table_items + table.count;
    stats.table_capacity = stats.table_capacity + table.capacity;
    stats.table_bytes = stats.table_bytes + table.bytes;
    stats.table_realloc_count = stats.table_realloc_count + table.realloc_count;
}

/// 功能说明：初始化 LoweredProgram 动态表和独立 lowering arena 句柄。
/// 参数说明：`program` 为目标 LoweredProgram，`arena` 为 lowering 阶段专用 arena。
/// 返回值说明：无。
export fn lowered_program_init(program: &LoweredProgram, arena: &CompilerArena) void {
    if program == null {
        return;
    }
    lowered_program_clear_counts(program);
    program.arena = arena;
    program.resident_peak_bytes = 0usize;
    program.lifecycle_state = LOWERED_PROGRAM_LIFECYCLE_ACTIVE;
    semantic_vector_init(&program.functions, @size_of(ConcreteFunction));
    semantic_vector_init(&program.body_ops, @size_of(LoweredBodyOp));
    semantic_vector_init(&program.core_bodies, @size_of(CoreBody));
    semantic_vector_init(&program.core_stmts, @size_of(CoreStmt));
    semantic_vector_init(&program.core_exprs, @size_of(CoreExpr));
    semantic_vector_init(&program.core_places, @size_of(CorePlace));
    semantic_vector_init(&program.core_cleanup_edges, @size_of(CoreCleanupEdge));
    semantic_vector_init(&program.core_semantic_facts, @size_of(CoreSemanticFact));
    semantic_vector_init(&program.globals, @size_of(GlobalObject));
    semantic_vector_init(&program.types, @size_of(ConcreteType));
    semantic_vector_init(&program.interfaces, @size_of(InterfacePlan));
    semantic_vector_init(&program.err_unions, @size_of(ErrorUnionLayout));
    semantic_vector_init(&program.async_frames, @size_of(AsyncFramePlan));
    semantic_vector_init(&program.drop_defer_plans, @size_of(DropDeferPlan));
    semantic_vector_init(&program.helpers, @size_of(RuntimeHelper));
    semantic_vector_init(&program.worklist, @size_of(LowerWorkItem));
    lowered_program_refresh_bytes(program);
}

/// 功能说明：重置 LoweredProgram 内容并保留已分配容量。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：无。
export fn lowered_program_reset(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    lowered_program_clear_counts(program);
    program.lifecycle_state = LOWERED_PROGRAM_LIFECYCLE_ACTIVE;
    semantic_vector_reset(&program.functions);
    semantic_vector_reset(&program.body_ops);
    semantic_vector_reset(&program.core_bodies);
    semantic_vector_reset(&program.core_stmts);
    semantic_vector_reset(&program.core_exprs);
    semantic_vector_reset(&program.core_places);
    semantic_vector_reset(&program.core_cleanup_edges);
    semantic_vector_reset(&program.core_semantic_facts);
    semantic_vector_reset(&program.globals);
    semantic_vector_reset(&program.types);
    semantic_vector_reset(&program.interfaces);
    semantic_vector_reset(&program.err_unions);
    semantic_vector_reset(&program.async_frames);
    semantic_vector_reset(&program.drop_defer_plans);
    semantic_vector_reset(&program.helpers);
    semantic_vector_reset(&program.worklist);
    lowered_program_refresh_bytes(program);
}

/// 功能说明：释放 LoweredProgram 动态表。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：无。
export fn lowered_program_release(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    if program.lifecycle_state == LOWERED_PROGRAM_LIFECYCLE_ACTIVE {
        lowered_program_refresh_bytes(program);
    }
    semantic_vector_release(&program.functions);
    semantic_vector_release(&program.body_ops);
    semantic_vector_release(&program.core_bodies);
    semantic_vector_release(&program.core_stmts);
    semantic_vector_release(&program.core_exprs);
    semantic_vector_release(&program.core_places);
    semantic_vector_release(&program.core_cleanup_edges);
    semantic_vector_release(&program.core_semantic_facts);
    semantic_vector_release(&program.globals);
    semantic_vector_release(&program.types);
    semantic_vector_release(&program.interfaces);
    semantic_vector_release(&program.err_unions);
    semantic_vector_release(&program.async_frames);
    semantic_vector_release(&program.drop_defer_plans);
    semantic_vector_release(&program.helpers);
    semantic_vector_release(&program.worklist);
    lowered_program_clear_counts(program);
    program.arena = null;
    program.lifecycle_state = LOWERED_PROGRAM_LIFECYCLE_RELEASED;
}

/// 功能说明：读取 LoweredProgram 使用的 lowering arena 句柄。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回初始化时传入的 arena；无效或释放后返回 null。
export fn lowered_program_arena(program: &LoweredProgram) &CompilerArena {
    if program == null {
        return null;
    }
    return program.arena;
}

/// 功能说明：追加具体函数。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为待追加函数记录。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn lowered_program_append_function(program: &LoweredProgram, item: &ConcreteFunction) i32 {
    if program == null || item == null {
        return -1;
    }
    if semantic_vector_append(&program.functions, item as &const void) != 0 {
        return -1;
    }
    program.function_count = program.functions.count;
    lowered_program_refresh_bytes(program);
    return 0;
}

/// 功能说明：追加一条已冻结兼容 opcode 的函数体操作到 LoweredProgram body op 表。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为待追加 body op。
/// 返回值说明：成功返回 `0`，参数无效、未知 opcode 或追加失败返回 `-1`。
export fn lowered_program_append_body_op(program: &LoweredProgram, item: &LoweredBodyOp) i32 {
    if program == null || item == null {
        return -1;
    }
    if lowered_body_op_is_transition_compat_opcode(item.opcode) == 0 {
        return -1;
    }
    if semantic_vector_append(&program.body_ops, item as &const void) != 0 {
        return -1;
    }
    program.body_op_count = program.body_ops.count;
    lowered_program_refresh_bytes(program);
    return 0;
}

