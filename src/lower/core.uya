    if program == null || item == null {
        return -1;
    }
    if semantic_vector_append(&program.interfaces, item as &const void) != 0 {
        return -1;
    }
    program.interface_count = program.interfaces.count;
    lowered_program_refresh_bytes(program);
    return 0;
