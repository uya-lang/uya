}

/// 功能说明：追加 drop/defer 收尾计划。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为待追加 drop/defer 计划。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn lowered_program_append_drop_defer_plan(program: &LoweredProgram, item: &DropDeferPlan) i32 {
