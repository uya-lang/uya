            const b: &ConcreteType = semantic_vector_item_ptr(vec, j) as &ConcreteType;
            if a == null || b == null {
                return -1;
            }
            if a.type_id <= b.type_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
