export const COREIR_VERIFY_ERR_UNFROZEN_TYPE: i32 = 5;
export const COREIR_VERIFY_ERR_UNFROZEN_CALL: i32 = 6;
export const COREIR_VERIFY_ERR_UNFROZEN_FIELD: i32 = 7;
export const COREIR_VERIFY_ERR_UNFROZEN_PROOF: i32 = 8;
export const COREIR_VERIFY_ERR_INCOMPLETE_CLEANUP: i32 = 9;
