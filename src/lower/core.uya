        while j > 0usize {
            const a: &GlobalObject = semantic_vector_item_ptr(vec, j - 1usize) as &GlobalObject;
            const b: &GlobalObject = semantic_vector_item_ptr(vec, j) as &GlobalObject;
            if a == null || b == null {
                return -1;
            }
            if a.global_id <= b.global_id {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

