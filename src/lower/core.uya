/// 功能说明：追加 error union 布局。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为待追加布局记录。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn lowered_program_append_error_union(program: &LoweredProgram, item: &ErrorUnionLayout) i32 {
    if program == null || item == null {
        return -1;
    }
    if semantic_vector_append(&program.err_unions, item as &const void) != 0 {
