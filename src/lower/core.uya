export const CORE_STMT_KIND_EXPR: i32 = 19;
export const CORE_STMT_KIND_WHILE: i32 = 20;
export const CORE_STMT_KIND_BLOCK: i32 = 21;
export const CORE_STMT_KIND_BREAK: i32 = 22;
