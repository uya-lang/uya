/// 功能说明：按 (kind, primary_id, secondary_id) 对 LowerWorkItem worklist 做稳定插入排序。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：成功返回 `0`，参数无效或表项无效返回 `-1`。
export fn lowered_program_sort_work_items(program: &LoweredProgram) i32 {
    if program == null {
        return -1;
    }
    const vec: &SemanticVector = &program.worklist;
    var i: usize = 1usize;
    while i < vec.count {
        var j: usize = i;
        while j > 0usize {
            const a: &LowerWorkItem = semantic_vector_item_ptr(vec, j - 1usize) as &LowerWorkItem;
            const b: &LowerWorkItem = semantic_vector_item_ptr(vec, j) as &LowerWorkItem;
            if a == null || b == null {
                return -1;
            }
            var greater: i32 = 0;
            if a.kind > b.kind {
                greater = 1;
            } else if a.kind == b.kind && a.primary_id > b.primary_id {
                greater = 1;
            } else if a.kind == b.kind && a.primary_id == b.primary_id && a.secondary_id > b.secondary_id {
                greater = 1;
            }
            if greater == 0 {
                break;
            }
            lowered_program_swap_items(vec, j - 1usize, j);
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    return 0;
}

