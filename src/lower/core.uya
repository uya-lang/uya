fn lowered_program_i32_to_usize(value: i32) usize {
    if value < 0 {
        return 9223372036854775807usize;
    }
    const converted_tmp: !usize = value as! usize;
    const converted: usize = converted_tmp catch {
        return 9223372036854775807usize;
    };
    return converted;
}

fn lowered_program_usize_to_i32(value: usize) i32 {
    const converted_tmp: !i32 = value as! i32;
    const converted: i32 = converted_tmp catch {
        return -1;
    };
    return converted;
}

fn lowered_program_find_core_body(program: &LoweredProgram, body_id: CoreBodyId) &CoreBody {
    if program == null || body_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < program.core_bodies.count {
        const body: &CoreBody = semantic_vector_item_ptr(&program.core_bodies, i) as &CoreBody;
        if body != null && body.body_id == body_id {
            return body;
        }
        i = i + 1usize;
    }
    return null;
}

fn lowered_program_empty_semantic_fact(program: &LoweredProgram, body_id: CoreBodyId, kind: i32) CoreSemanticFact {
    return CoreSemanticFact{
        fact_id: lowered_program_usize_to_i32(program.core_semantic_facts.count),
        kind: kind,
        body_id: body_id,
        stmt_id: CORE_STMT_INVALID_ID,
        expr_id: CORE_EXPR_INVALID_ID,
        source_expr_id: TYPED_PROGRAM_INVALID_ID,
        place_id: CORE_PLACE_INVALID_ID,
        cleanup_edge_id: CORE_CLEANUP_EDGE_INVALID_ID,
        call_target_kind: TYPED_CALL_TARGET_UNKNOWN,
        target_function_id: TYPED_PROGRAM_INVALID_ID,
        target_decl_id: TYPED_PROGRAM_INVALID_ID,
        target_symbol_id: TYPED_PROGRAM_INVALID_ID,
        mono_instance_id: TYPED_PROGRAM_INVALID_ID,
        arg_count: 0,
        receiver_type_id: TYPED_PROGRAM_INVALID_ID,
        method_symbol_id: TYPED_PROGRAM_INVALID_ID,
        interface_symbol_id: TYPED_PROGRAM_INVALID_ID,
        vtable_slot: TYPED_PROGRAM_INVALID_ID,
        field_id: TYPED_PROGRAM_INVALID_ID,
        type_id: TYPED_PROGRAM_INVALID_ID,
        proof_result_id: TYPED_PROGRAM_INVALID_ID,
        proof_status: TYPED_PROOF_UNKNOWN,
        proof_error_id: TYPED_PROGRAM_INVALID_ID,
        source_span_id: TYPED_PROGRAM_INVALID_ID,
        drop_defer_plan_id: TYPED_PROGRAM_INVALID_ID,
        cleanup_scope_id: TYPED_PROGRAM_INVALID_ID,
        capability_id: TYPED_PROGRAM_INVALID_ID,
        flags: 0,
    };
}

fn lowered_program_append_expr_type_fact(program: &LoweredProgram, typed: &TypedProgram, body_id: CoreBodyId, expr: &CoreExpr) i32 {
    var type_id: TypeId = TYPED_PROGRAM_INVALID_ID;
    if typed_program_get_expr_type(typed, expr.source_expr_id, &type_id) == 0 {
        return 0;
    }
    var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body_id, CORE_SEMANTIC_FACT_TYPE_ID);
    fact.expr_id = expr.expr_id;
    fact.source_expr_id = expr.source_expr_id;
    fact.type_id = type_id;
    fact.source_span_id = expr.source_span_id;
    return lowered_program_append_core_semantic_fact(program, &fact);
}

fn lowered_program_append_expr_call_fact(program: &LoweredProgram, typed: &TypedProgram, body_id: CoreBodyId, expr: &CoreExpr) i32 {
    var target: TypedCallTarget = TypedCallTarget{
        kind: TYPED_CALL_TARGET_UNKNOWN,
        function_id: TYPED_PROGRAM_INVALID_ID,
        decl_id: TYPED_PROGRAM_INVALID_ID,
        symbol_id: TYPED_PROGRAM_INVALID_ID,
        mono_instance_id: TYPED_PROGRAM_INVALID_ID,
    };
    if typed_program_get_call_target(typed, expr.source_expr_id, &target) == 0 {
        return 0;
    }
    var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body_id, CORE_SEMANTIC_FACT_RESOLVED_CALL);
    fact.expr_id = expr.expr_id;
    fact.source_expr_id = expr.source_expr_id;
    fact.call_target_kind = target.kind;
    fact.target_function_id = target.function_id;
    fact.target_decl_id = target.decl_id;
    fact.target_symbol_id = target.symbol_id;
    fact.mono_instance_id = target.mono_instance_id;
    fact.source_span_id = expr.source_span_id;
    return lowered_program_append_core_semantic_fact(program, &fact);
}

fn lowered_program_append_expr_method_fact(program: &LoweredProgram, typed: &TypedProgram, body_id: CoreBodyId, expr: &CoreExpr) i32 {
    var dispatch: TypedMethodDispatch = TypedMethodDispatch{
        receiver_type_id: TYPED_PROGRAM_INVALID_ID,
        method_symbol_id: TYPED_PROGRAM_INVALID_ID,
        interface_symbol_id: TYPED_PROGRAM_INVALID_ID,
        vtable_slot: TYPED_PROGRAM_INVALID_ID,
    };
    if typed_program_get_method_dispatch(typed, expr.source_expr_id, &dispatch) == 0 {
        return 0;
    }
    var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body_id, CORE_SEMANTIC_FACT_METHOD_DISPATCH);
    fact.expr_id = expr.expr_id;
    fact.source_expr_id = expr.source_expr_id;
    fact.receiver_type_id = dispatch.receiver_type_id;
    fact.method_symbol_id = dispatch.method_symbol_id;
    fact.interface_symbol_id = dispatch.interface_symbol_id;
    fact.vtable_slot = dispatch.vtable_slot;
    fact.source_span_id = expr.source_span_id;
    return lowered_program_append_core_semantic_fact(program, &fact);
}

fn lowered_program_append_expr_field_fact(program: &LoweredProgram, typed: &TypedProgram, body_id: CoreBodyId, expr: &CoreExpr) i32 {
    var field_id: FieldId = TYPED_PROGRAM_INVALID_ID;
    if typed_program_get_field_access(typed, expr.source_expr_id, &field_id) == 0 {
        return 0;
    }
    var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body_id, CORE_SEMANTIC_FACT_FIELD_ID);
    fact.expr_id = expr.expr_id;
    fact.source_expr_id = expr.source_expr_id;
    fact.place_id = expr.place_id;
    fact.field_id = field_id;
    fact.source_span_id = expr.source_span_id;
    return lowered_program_append_core_semantic_fact(program, &fact);
}

fn lowered_program_append_expr_source_fact(program: &LoweredProgram, body_id: CoreBodyId, expr: &CoreExpr) i32 {
    if expr.source_span_id < 0 {
        return 0;
    }
    var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body_id, CORE_SEMANTIC_FACT_SOURCE_SPAN);
    fact.expr_id = expr.expr_id;
    fact.source_expr_id = expr.source_expr_id;
    fact.source_span_id = expr.source_span_id;
    return lowered_program_append_core_semantic_fact(program, &fact);
}

fn lowered_program_append_expr_capability_fact(program: &LoweredProgram, body_id: CoreBodyId, expr: &CoreExpr) i32 {
    if expr.capability_id <= 0 {
        return 0;
    }
    var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body_id, CORE_SEMANTIC_FACT_CAPABILITY);
    fact.expr_id = expr.expr_id;
    fact.source_expr_id = expr.source_expr_id;
    fact.capability_id = expr.capability_id;
    fact.source_span_id = expr.source_span_id;
    return lowered_program_append_core_semantic_fact(program, &fact);
}

fn lowered_program_freeze_expr_semantics(program: &LoweredProgram, typed: &TypedProgram, body: &CoreBody) i32 {
    var offset: i32 = 0;
    while offset < body.expr_count {
        const index: usize = lowered_program_i32_to_usize(body.expr_start + offset);
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, index) as &CoreExpr;
        if expr == null {
            return -1;
        }
        if lowered_program_append_expr_type_fact(program, typed, body.body_id, expr) != 0 { return -1; }
        if lowered_program_append_expr_call_fact(program, typed, body.body_id, expr) != 0 { return -1; }
        if lowered_program_append_expr_method_fact(program, typed, body.body_id, expr) != 0 { return -1; }
        if lowered_program_append_expr_field_fact(program, typed, body.body_id, expr) != 0 { return -1; }
        if lowered_program_append_expr_source_fact(program, body.body_id, expr) != 0 { return -1; }
        if lowered_program_append_expr_capability_fact(program, body.body_id, expr) != 0 { return -1; }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_body_contains_source_expr(program: &LoweredProgram, body: &CoreBody, expr_id: ExprId) i32 {
    var offset: i32 = 0;
    while offset < body.expr_count {
        const index: usize = lowered_program_i32_to_usize(body.expr_start + offset);
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, index) as &CoreExpr;
        if expr != null && expr.source_expr_id == expr_id {
            return 1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_find_core_expr_for_source(program: &LoweredProgram, body: &CoreBody, expr_id: ExprId) CoreExprId {
    var offset: i32 = 0;
    while offset < body.expr_count {
        const index: usize = lowered_program_i32_to_usize(body.expr_start + offset);
        const expr: &CoreExpr = semantic_vector_item_ptr(&program.core_exprs, index) as &CoreExpr;
        if expr != null && expr.source_expr_id == expr_id {
            return expr.expr_id;
        }
        offset = offset + 1;
    }
    return CORE_EXPR_INVALID_ID;
}

fn lowered_program_freeze_proof_semantics(program: &LoweredProgram, typed: &TypedProgram, body: &CoreBody) i32 {
    var i: usize = 0usize;
    while i < typed.proof_results.count {
        const proof: &TypedProofResult = semantic_vector_item_ptr(&typed.proof_results, i) as &TypedProofResult;
        if proof == null {
            return -1;
        }
        if lowered_program_body_contains_source_expr(program, body, proof.expr_id) != 0 {
            var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body.body_id, CORE_SEMANTIC_FACT_PROOF_RESULT);
            fact.expr_id = lowered_program_find_core_expr_for_source(program, body, proof.expr_id);
            fact.source_expr_id = proof.expr_id;
            fact.proof_result_id = lowered_program_usize_to_i32(i);
            fact.proof_status = proof.status;
            fact.proof_error_id = proof.error_id;
            if lowered_program_append_core_semantic_fact(program, &fact) != 0 {
                return -1;
            }
        }
        i = i + 1usize;
    }
    return 0;
}

fn lowered_program_freeze_stmt_source_semantics(program: &LoweredProgram, body: &CoreBody) i32 {
    var offset: i32 = 0;
    while offset < body.root_stmt_count {
        const index: usize = lowered_program_i32_to_usize(body.root_stmt_start + offset);
        const stmt: &CoreStmt = semantic_vector_item_ptr(&program.core_stmts, index) as &CoreStmt;
        if stmt == null {
            return -1;
        }
        var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body.body_id, CORE_SEMANTIC_FACT_SOURCE_SPAN);
        fact.stmt_id = stmt.stmt_id;
        fact.source_span_id = stmt.source_span_id;
        fact.cleanup_scope_id = stmt.cleanup_scope_id;
        if lowered_program_append_core_semantic_fact(program, &fact) != 0 {
            return -1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_freeze_place_source_semantics(program: &LoweredProgram, body: &CoreBody) i32 {
    var offset: i32 = 0;
    while offset < body.place_count {
        const index: usize = lowered_program_i32_to_usize(body.place_start + offset);
        const place: &CorePlace = semantic_vector_item_ptr(&program.core_places, index) as &CorePlace;
        if place == null {
            return -1;
        }
        var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body.body_id, CORE_SEMANTIC_FACT_SOURCE_SPAN);
        fact.place_id = place.place_id;
        fact.field_id = place.field_id;
        fact.type_id = place.type_id;
        fact.source_span_id = place.source_span_id;
        if lowered_program_append_core_semantic_fact(program, &fact) != 0 {
            return -1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn lowered_program_freeze_cleanup_semantics(program: &LoweredProgram, body: &CoreBody) i32 {
    var offset: i32 = 0;
    while offset < body.cleanup_edge_count {
        const index: usize = lowered_program_i32_to_usize(body.cleanup_edge_start + offset);
        const edge: &CoreCleanupEdge = semantic_vector_item_ptr(&program.core_cleanup_edges, index) as &CoreCleanupEdge;
        if edge == null {
            return -1;
        }
        var fact: CoreSemanticFact = lowered_program_empty_semantic_fact(program, body.body_id, CORE_SEMANTIC_FACT_CLEANUP);
        fact.cleanup_edge_id = edge.edge_id;
        fact.stmt_id = edge.from_stmt_id;
        fact.expr_id = edge.payload_expr_id;
        fact.drop_defer_plan_id = edge.drop_defer_plan_id;
        fact.cleanup_scope_id = edge.cleanup_scope_id;
        fact.source_span_id = edge.source_span_id;
        fact.flags = edge.flags;
        if lowered_program_append_core_semantic_fact(program, &fact) != 0 {
            return -1;
        }
        offset = offset + 1;
    }
    return 0;
}

/// 功能说明：把一个 CoreBody 需要的 TypedProgram 语义事实一次性冻结到 CoreSemanticFact 表。
/// 参数说明：`program` 为目标 LoweredProgram，`typed` 为 checker 输出，`body_id` 为待冻结 CoreBody。
/// 返回值说明：成功返回 `0`，参数无效或追加失败返回 `-1`；冻结后更新 CoreBody 的 metadata range。
export fn lowered_program_freeze_core_body_semantics_from_typed(program: &LoweredProgram, typed: &TypedProgram, body_id: CoreBodyId) i32 {
    const body: &CoreBody = lowered_program_find_core_body(program, body_id);
    if program == null || typed == null || body == null {
        return -1;
    }
    const start: i32 = lowered_program_usize_to_i32(program.core_semantic_facts.count);
    if start < 0 {
        return -1;
    }
    body.semantic_fact_start = start;
    if lowered_program_freeze_expr_semantics(program, typed, body) != 0 { return -1; }
    if lowered_program_freeze_proof_semantics(program, typed, body) != 0 { return -1; }
    if lowered_program_freeze_stmt_source_semantics(program, body) != 0 { return -1; }
    if lowered_program_freeze_place_source_semantics(program, body) != 0 { return -1; }
    if lowered_program_freeze_cleanup_semantics(program, body) != 0 { return -1; }
    body.semantic_fact_count = lowered_program_usize_to_i32(program.core_semantic_facts.count) - start;
    return 0;
}

/// 功能说明：把所有已存在 CoreBody 的 TypedProgram 语义事实冻结到 CoreSemanticFact 表。
/// 参数说明：`program` 为目标 LoweredProgram，`typed` 为 checker 输出。
/// 返回值说明：成功返回 `0`，任一 CoreBody 冻结失败返回 `-1`。
export fn lowered_program_freeze_core_semantics_from_typed(program: &LoweredProgram, typed: &TypedProgram) i32 {
    if program == null || typed == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < program.core_bodies.count {
        const body: &CoreBody = semantic_vector_item_ptr(&program.core_bodies, i) as &CoreBody;
        if body == null {
            return -1;
        }
        if lowered_program_freeze_core_body_semantics_from_typed(program, typed, body.body_id) != 0 {
            return -1;
        }
        i = i + 1usize;
    }
    return 0;
}

fn lowered_program_reset_worklist(program: &LoweredProgram) void {
    if program == null {
        return;
    }
    semantic_vector_reset(&program.worklist);
    program.work_item_count = 0usize;
    lowered_program_refresh_bytes(program);
}

/// 功能说明：用 TypedProgram 的 reachable roots 初始化 lowering worklist。
/// 参数说明：`program` 为目标 LoweredProgram，`typed` 为 checker 输出的 TypedProgram。
/// 返回值说明：成功返回 `0`，参数无效或追加失败返回 `-1`。
export fn lowered_program_init_worklist_roots(program: &LoweredProgram, typed: &TypedProgram) i32 {
    if program == null || typed == null {
        return -1;
    }
    lowered_program_reset_worklist(program);
    var i: usize = 0usize;
    while i < typed.reachable_roots.count {
        const root: &FunctionId = semantic_vector_item_ptr(&typed.reachable_roots, i) as &FunctionId;
        if root == null {
            return -1;
        }
        var item: LowerWorkItem = LowerWorkItem{
            kind: LOWER_WORK_ITEM_FUNCTION,
            primary_id: root[0],
            secondary_id: 0,
        };
        if lowered_program_append_work_item(program, &item) != 0 {
            return -1;
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：估算 LoweredProgram 当前结构和动态存储占用字节数。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回结构体本体和所有动态表容量字节数；参数无效时返回 `0`。
export fn lowered_program_storage_bytes(program: &LoweredProgram) usize {
    if program == null {
        return 0usize;
    }
    return @size_of(LoweredProgram) +
        program.functions.bytes +
        program.body_ops.bytes +
        program.core_bodies.bytes +
        program.core_stmts.bytes +
        program.core_exprs.bytes +
        program.core_places.bytes +
        program.core_cleanup_edges.bytes +
        program.core_semantic_facts.bytes +
        program.globals.bytes +
        program.types.bytes +
        program.interfaces.bytes +
        program.err_unions.bytes +
        program.async_frames.bytes +
        program.drop_defer_plans.bytes +
        program.helpers.bytes +
        program.worklist.bytes;
}

/// 功能说明：读取 LoweredProgram 当前估算字节数。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回最近一次 init/reset/append 后记录的估算字节数。
export fn lowered_program_estimated_bytes(program: &LoweredProgram) usize {
    if program == null {
        return 0usize;
    }
    return program.estimated_bytes;
}

/// 功能说明：读取 LoweredProgram 当前常驻字节数。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回当前生命周期窗口内仍常驻的估算字节数；释放后返回 `0`。
export fn lowered_program_current_bytes(program: &LoweredProgram) usize {
    return lowered_program_estimated_bytes(program);
}

/// 功能说明：读取 LoweredProgram 生命周期窗口内的峰值常驻字节数。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回最近一次 init/reset 到 release 期间观察到的最大估算字节数。
export fn lowered_program_peak_bytes(program: &LoweredProgram) usize {
    if program == null {
        return 0usize;
    }
    return program.resident_peak_bytes;
}

/// 功能说明：读取 LoweredProgram 当前生命周期状态。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回 `LOWERED_PROGRAM_LIFECYCLE_*` 常量之一；参数无效时返回 uninitialized。
export fn lowered_program_lifecycle_state(program: &LoweredProgram) i32 {
    if program == null {
        return LOWERED_PROGRAM_LIFECYCLE_UNINITIALIZED;
    }
    return program.lifecycle_state;
}

/// 功能说明：读取 LoweredProgram 当前常驻、峰值和生命周期状态摘要。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回当前 bytes、峰值 bytes 和生命周期状态；参数无效时返回全零摘要。
export fn lowered_program_lifetime_stats(program: &LoweredProgram) LoweredProgramLifetimeStats {
    if program == null {
        return LoweredProgramLifetimeStats{
            current_bytes: 0usize,
            peak_bytes: 0usize,
            lifecycle_state: LOWERED_PROGRAM_LIFECYCLE_UNINITIALIZED,
        };
    }
    return LoweredProgramLifetimeStats{
        current_bytes: lowered_program_current_bytes(program),
        peak_bytes: lowered_program_peak_bytes(program),
        lifecycle_state: lowered_program_lifecycle_state(program),
    };
}

/// 功能说明：读取 LoweredProgram 所有动态表的聚合统计。
/// 参数说明：`program` 为目标 LoweredProgram。
/// 返回值说明：返回 table 数量、项数、容量、字节数和重分配次数摘要。
export fn lowered_program_stats(program: &LoweredProgram) LoweredProgramStats {
    var stats: LoweredProgramStats = LoweredProgramStats{
        table_count: 0,
        table_items: 0usize,
        table_capacity: 0usize,
        table_bytes: 0usize,
        table_realloc_count: 0,
    };
    if program == null {
        return stats;
    }
    lowered_program_stats_add(&stats, &program.functions);
    lowered_program_stats_add(&stats, &program.body_ops);
    lowered_program_stats_add(&stats, &program.core_bodies);
    lowered_program_stats_add(&stats, &program.core_stmts);
    lowered_program_stats_add(&stats, &program.core_exprs);
    lowered_program_stats_add(&stats, &program.core_places);
    lowered_program_stats_add(&stats, &program.core_cleanup_edges);
    lowered_program_stats_add(&stats, &program.core_semantic_facts);
    lowered_program_stats_add(&stats, &program.globals);
    lowered_program_stats_add(&stats, &program.types);
    lowered_program_stats_add(&stats, &program.interfaces);
    lowered_program_stats_add(&stats, &program.err_unions);
    lowered_program_stats_add(&stats, &program.async_frames);
    lowered_program_stats_add(&stats, &program.drop_defer_plans);
    lowered_program_stats_add(&stats, &program.helpers);
    lowered_program_stats_add(&stats, &program.worklist);
    return stats;
}

// ---- Phase 5: 闭包收敛 ----

fn lowered_program_has_function_mono(program: &LoweredProgram, mono_id: MonoInstanceId) i32 {
    var i: usize = 0usize;
    while i < program.functions.count {
        const fn_ptr: &ConcreteFunction = semantic_vector_item_ptr(&program.functions, i) as &ConcreteFunction;
        if fn_ptr != null && fn_ptr.mono_instance_id == mono_id {
            return 1;
        }
        i = i + 1usize;
    }
    return 0;
}

fn lowered_program_close_call_instances(program: &LoweredProgram, typed: &TypedProgram, want_kind: i32) i32 {
    if program == null || typed == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < typed.call_targets.count {
        const target: &TypedCallTarget = semantic_vector_item_ptr(&typed.call_targets, i) as &TypedCallTarget;
        if target == null {
            return -1;
        }
        if target.kind == want_kind && target.mono_instance_id != TYPED_PROGRAM_INVALID_ID {
            if lowered_program_has_function_mono(program, target.mono_instance_id) == 0 {
                var fn_item: ConcreteFunction = ConcreteFunction{
                    function_id: target.function_id,
                    decl_id: target.decl_id,
                    mono_instance_id: target.mono_instance_id,
                    body_start: 0,
                    body_count: 0,
                    flags: 0,
                };
                if lowered_program_append_function(program, &fn_item) != 0 {
                    return -1;
                }
                var work: LowerWorkItem = LowerWorkItem{
                    kind: LOWER_WORK_ITEM_FUNCTION,
                    primary_id: target.function_id,
                    secondary_id: target.mono_instance_id,
                };
                if lowered_program_append_work_item(program, &work) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：从 TypedProgram 函数调用目标收敛泛型函数实例闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`typed` 为 checker 输出的 TypedProgram。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 mono_instance_id 去重，可重复调用保持幂等。
export fn lowered_program_close_generic_function_instances(program: &LoweredProgram, typed: &TypedProgram) i32 {
    return lowered_program_close_call_instances(program, typed, TYPED_CALL_TARGET_FUNCTION);
}

/// 功能说明：从 TypedProgram 方法调用目标收敛泛型方法实例闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`typed` 为 checker 输出的 TypedProgram。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 mono_instance_id 去重，可重复调用保持幂等。
export fn lowered_program_close_generic_method_instances(program: &LoweredProgram, typed: &TypedProgram) i32 {
    return lowered_program_close_call_instances(program, typed, TYPED_CALL_TARGET_METHOD);
}

/// 功能说明：收敛一个泛型结构体实例闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为已收敛的 ConcreteType。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 type_id 去重。
export fn lowered_program_close_generic_struct_instance(program: &LoweredProgram, item: &ConcreteType) i32 {
    if program == null || item == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < program.types.count {
        const existing: &ConcreteType = semantic_vector_item_ptr(&program.types, i) as &ConcreteType;
        if existing != null && existing.type_id == item.type_id {
            return 0;
        }
        i = i + 1usize;
    }
    if lowered_program_append_type(program, item) != 0 {
        return -1;
    }
    var work: LowerWorkItem = LowerWorkItem{
        kind: LOWER_WORK_ITEM_TYPE,
        primary_id: item.type_id,
        secondary_id: item.decl_id,
    };
    return lowered_program_append_work_item(program, &work);
}

/// 功能说明：收敛一个 error union 类型闭包。
/// 参数说明：`program` 为目标 LoweredProgram，`item` 为已收敛的 ErrorUnionLayout。
/// 返回值说明：成功返回 `0`，失败返回 `-1`；按 type_id 去重。
