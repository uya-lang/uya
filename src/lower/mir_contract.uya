export const MIR_ATOMIC_RMW_XOR: i32 = 5;

/// 功能说明：记录 `LoweredProgram + CoreBody` 到 PortableMIR 的完整语言 lowering 合同。
/// 参数说明：无；字段保存 frozen Core 输入、必需 feature mask、当前支持 mask 和首轮缺失 mask。
/// 返回值说明：无。
export struct PortableMirLoweringContract {
    input: PortableMirCoreInput,
    required_feature_mask: i32,
    supported_feature_mask: i32,
    missing_feature_mask: i32,
    lowered_feature_mask: i32,
    flags: i32,
}

/// 功能说明：记录 PortableMIR 并行 worker 的只读输入合同。
/// 参数说明：无；字段保存 frozen Core 输入、稳定函数序号、worker ID 和 flags。
/// 返回值说明：无。
export struct PortableMirParallelWorkerInput {
    core_input: PortableMirCoreInput,
    stable_function_index: i32,
    worker_id: i32,
    flags: i32,
}

/// 功能说明：记录 PortableMIR 并行构造后的稳定归并合同。
/// 参数说明：无；字段保存函数/worker 数量、输出 mask、merge order mask 和禁止行为 mask。
/// 返回值说明：无。
export struct PortableMirParallelMergeContract {
    function_count: i32,
    worker_count: i32,
    output_mask: i32,
    merge_order_mask: i32,
    forbidden_mask: i32,
    flags: i32,
}

/// 功能说明：判断 feature mask 是否包含指定 PortableMIR lowering feature。
/// 参数说明：`mask` 为 feature mask，`feature` 为单个 feature bit。
/// 返回值说明：包含返回 `1`，否则返回 `0`。
export fn portable_mir_lowering_mask_has(mask: i32, feature: i32) i32 {
    if feature == 0 {
        return 0;
    }
    if (mask & feature) != 0 {
        return 1;
    }
    return 0;
}

/// 功能说明：返回并行 MIR 构造必须稳定归并的输出集合。
/// 参数说明：无。
/// 返回值说明：返回 MIR functions、diagnostics、dump 和 backend fragments 的 bit mask。
export fn portable_mir_parallel_required_output_mask() i32 {
    return MIR_PARALLEL_OUTPUT_MIR_FUNCTIONS + MIR_PARALLEL_OUTPUT_DIAGNOSTICS +
        MIR_PARALLEL_OUTPUT_DUMP + MIR_PARALLEL_OUTPUT_BACKEND_FRAGMENTS;
}

/// 功能说明：返回并行 MIR worker 禁止执行的非确定性行为集合。
/// 参数说明：无。
/// 返回值说明：返回禁止共享 module 写入、hash 顺序决定输出和修改闭包的 bit mask。
export fn portable_mir_parallel_required_forbidden_mask() i32 {
    return MIR_PARALLEL_FORBID_SHARED_MODULE_WRITE + MIR_PARALLEL_FORBID_HASH_ORDER +
        MIR_PARALLEL_FORBID_CLOSURE_MUTATION;
}

/// 功能说明：判断 PortableMIR 并行 worker 输入是否只消费 frozen CoreIR。
/// 参数说明：`input` 为待检查 worker 输入。
/// 返回值说明：Core 输入已冻结且 stable function index / worker ID 合法时返回 `1`，否则返回 `0`。
export fn portable_mir_parallel_worker_input_is_valid(input: &PortableMirParallelWorkerInput) i32 {
    if input == null {
        return 0;
    }
    if input.stable_function_index < 0 || input.worker_id < 0 {
        return 0;
    }
    return portable_mir_core_input_is_frozen(&input.core_input);
}

/// 功能说明：初始化 PortableMIR 并行稳定归并合同。
/// 参数说明：`contract` 为输出合同，`function_count` 为 stable function 数量，`worker_count` 为 worker 数量。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn portable_mir_parallel_merge_contract_init(contract: &PortableMirParallelMergeContract,
    function_count: i32, worker_count: i32) i32 {
    if contract == null || function_count < 0 || worker_count <= 0 {
        return -1;
    }
    contract.function_count = function_count;
    contract.worker_count = worker_count;
    contract.output_mask = portable_mir_parallel_required_output_mask();
    contract.merge_order_mask = MIR_PARALLEL_MERGE_STABLE_FUNCTION_ORDER;
    contract.forbidden_mask = portable_mir_parallel_required_forbidden_mask();
    contract.flags = 0;
    return 0;
}

/// 功能说明：判断 PortableMIR 并行归并合同是否保证确定性输出。
/// 参数说明：`contract` 为已初始化的归并合同。
/// 返回值说明：覆盖稳定函数顺序、必需输出和禁止行为时返回 `1`，否则返回 `0`。
export fn portable_mir_parallel_merge_contract_is_deterministic(contract: &PortableMirParallelMergeContract) i32 {
    if contract == null || contract.function_count < 0 || contract.worker_count <= 0 {
        return 0;
    }
    const required_outputs: i32 = portable_mir_parallel_required_output_mask();
    const required_forbidden: i32 = portable_mir_parallel_required_forbidden_mask();
    if (contract.output_mask & required_outputs) != required_outputs {
        return 0;
    }
    if portable_mir_lowering_mask_has(contract.merge_order_mask, MIR_PARALLEL_MERGE_STABLE_FUNCTION_ORDER) == 0 {
        return 0;
    }
    if (contract.forbidden_mask & required_forbidden) != required_forbidden {
        return 0;
    }
    return 1;
}

/// 功能说明：判断 PortableMIR lowering metadata 缺口是否必须回补 CoreIR 合同。
/// 参数说明：`gap_kind` 为 MIR metadata gap 常量。
/// 返回值说明：已知 source/proof/capability/layout/call/field/cleanup 缺口返回 `1`，未知缺口返回 `0`。
export fn portable_mir_metadata_gap_requires_coreir_backfill(gap_kind: i32) i32 {
    if gap_kind == MIR_METADATA_GAP_SOURCE_SPAN { return 1; }
    if gap_kind == MIR_METADATA_GAP_PROOF { return 1; }
    if gap_kind == MIR_METADATA_GAP_CAPABILITY { return 1; }
    if gap_kind == MIR_METADATA_GAP_LAYOUT { return 1; }
    if gap_kind == MIR_METADATA_GAP_CALL_TARGET { return 1; }
    if gap_kind == MIR_METADATA_GAP_FIELD_ID { return 1; }
    if gap_kind == MIR_METADATA_GAP_CLEANUP { return 1; }
    return 0;
}

/// 功能说明：返回完整语言 CoreBody 到 PortableMIR lowering 必须覆盖的 feature mask。
/// 参数说明：无。
/// 返回值说明：返回 expressions、statements、control flow、memory/address、atomic、vector/mask、call/return/branch、aggregate address、copy/move/drop 和 cleanup path 的并集。
export fn portable_mir_lowering_contract_required_features() i32 {
    var mask: i32 = MIR_LOWER_FEATURE_EXPRESSIONS;
    mask = mask + MIR_LOWER_FEATURE_STATEMENTS;
    mask = mask + MIR_LOWER_FEATURE_CONTROL_FLOW;
    mask = mask + MIR_LOWER_FEATURE_LOAD_STORE_ADDRESS;
    mask = mask + MIR_LOWER_FEATURE_ATOMIC;
    mask = mask + MIR_LOWER_FEATURE_VECTOR_MASK;
    mask = mask + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    mask = mask + MIR_LOWER_FEATURE_FIELD_INDEX_SLICE_ADDRESS;
    mask = mask + MIR_LOWER_FEATURE_COPY_MOVE_DROP;
    mask = mask + MIR_LOWER_FEATURE_CLEANUP_PATH;
    return mask;
}

/// 功能说明：构造空 PortableMIR lowering 合同值，便于测试和调用方初始化。
/// 参数说明：无。
/// 返回值说明：返回未绑定 Core 输入且 feature mask 清零的合同值。
export fn portable_mir_lowering_contract_empty() PortableMirLoweringContract {
    return PortableMirLoweringContract{
        input: PortableMirCoreInput{
            program: null,
            body_id: CORE_BODY_INVALID_ID,
            target_profile_id: 0,
            flags: 0,
        },
        required_feature_mask: 0,
        supported_feature_mask: 0,
        missing_feature_mask: 0,
        lowered_feature_mask: 0,
        flags: 0,
    };
}

fn portable_mir_lowering_contract_missing_features(supported_feature_mask: i32) i32 {
    var missing: i32 = 0;
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_EXPRESSIONS) == 0 {
        missing = missing + MIR_LOWER_FEATURE_EXPRESSIONS;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_STATEMENTS) == 0 {
        missing = missing + MIR_LOWER_FEATURE_STATEMENTS;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_CONTROL_FLOW) == 0 {
        missing = missing + MIR_LOWER_FEATURE_CONTROL_FLOW;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_LOAD_STORE_ADDRESS) == 0 {
        missing = missing + MIR_LOWER_FEATURE_LOAD_STORE_ADDRESS;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_ATOMIC) == 0 {
        missing = missing + MIR_LOWER_FEATURE_ATOMIC;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_VECTOR_MASK) == 0 {
        missing = missing + MIR_LOWER_FEATURE_VECTOR_MASK;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_CALL_RETURN_BRANCH) == 0 {
        missing = missing + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_FIELD_INDEX_SLICE_ADDRESS) == 0 {
        missing = missing + MIR_LOWER_FEATURE_FIELD_INDEX_SLICE_ADDRESS;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_COPY_MOVE_DROP) == 0 {
        missing = missing + MIR_LOWER_FEATURE_COPY_MOVE_DROP;
    }
    if portable_mir_lowering_mask_has(supported_feature_mask, MIR_LOWER_FEATURE_CLEANUP_PATH) == 0 {
        missing = missing + MIR_LOWER_FEATURE_CLEANUP_PATH;
    }
    return missing;
}

/// 功能说明：判断当前 PortableMIR lowering 合同是否声明支持指定 feature。
/// 参数说明：`contract` 为已初始化合同，`feature` 为单个 feature bit。
/// 返回值说明：合同有效且支持该 feature 返回 `1`，否则返回 `0`。
export fn portable_mir_lowering_contract_accepts_feature(contract: &PortableMirLoweringContract, feature: i32) i32 {
    if contract == null {
        return 0;
    }
    if portable_mir_lowering_mask_has(contract.required_feature_mask, feature) == 0 {
        return 0;
    }
    return portable_mir_lowering_mask_has(contract.supported_feature_mask, feature);
}

/// 功能说明：把 CoreStmt kind 映射为 PortableMIR lowering feature mask。
/// 参数说明：`kind` 为 CoreStmt kind 常量。
/// 返回值说明：返回该 statement lowering 需要的 feature mask；未知 kind 返回 `0`。
export fn portable_mir_lowering_feature_for_stmt_kind(kind: i32) i32 {
    if kind == CORE_STMT_KIND_RETURN {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_CONTROL_FLOW + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    if kind == CORE_STMT_KIND_ASM {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    if kind == CORE_STMT_KIND_DEFER || kind == CORE_STMT_KIND_ERRDEFER {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_CLEANUP_PATH;
    }
    if kind == CORE_STMT_KIND_DROP {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_COPY_MOVE_DROP + MIR_LOWER_FEATURE_CLEANUP_PATH;
    }
    if kind == CORE_STMT_KIND_ERROR_PROPAGATION {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_CONTROL_FLOW + MIR_LOWER_FEATURE_CLEANUP_PATH;
    }
    if kind == CORE_STMT_KIND_LOCAL_DECL {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_EXPRESSIONS;
    }
    if kind == CORE_STMT_KIND_IF {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_CONTROL_FLOW + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    if kind == CORE_STMT_KIND_WHILE {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_CONTROL_FLOW + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    if kind == CORE_STMT_KIND_ASSIGN {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_COPY_MOVE_DROP;
    }
    if kind == CORE_STMT_KIND_EXPR {
        return MIR_LOWER_FEATURE_STATEMENTS + MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    return 0;
}

/// 功能说明：把 CoreExpr kind 映射为 PortableMIR lowering feature mask。
/// 参数说明：`kind` 为 CoreExpr kind 常量。
/// 返回值说明：返回该 expression lowering 需要的 feature mask；未知 kind 返回 `0`。
export fn portable_mir_lowering_feature_for_expr_kind(kind: i32) i32 {
    if kind == CORE_EXPR_KIND_CALL {
        return MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH;
    }
    if kind == CORE_EXPR_KIND_INDEX || kind == CORE_EXPR_KIND_SLICE {
        return MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_LOAD_STORE_ADDRESS +
            MIR_LOWER_FEATURE_FIELD_INDEX_SLICE_ADDRESS;
    }
    if kind == CORE_EXPR_KIND_ATOMIC {
        return MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_LOAD_STORE_ADDRESS +
            MIR_LOWER_FEATURE_ATOMIC;
    }
    if kind == CORE_EXPR_KIND_VECTOR || kind == CORE_EXPR_KIND_MASK {
        return MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_VECTOR_MASK;
    }
    if kind == CORE_EXPR_KIND_INT_LITERAL {
        return MIR_LOWER_FEATURE_EXPRESSIONS;
    }
    if kind == CORE_EXPR_KIND_LOCAL_REF {
        return MIR_LOWER_FEATURE_EXPRESSIONS;
    }
    if kind == CORE_EXPR_KIND_I32_NE || kind == CORE_EXPR_KIND_I32_ADD {
        return MIR_LOWER_FEATURE_EXPRESSIONS;
    }
    if kind == CORE_EXPR_KIND_I32_LE {
        return MIR_LOWER_FEATURE_EXPRESSIONS + MIR_LOWER_FEATURE_CONTROL_FLOW;
    }
    return 0;
}

/// 功能说明：把 CorePlace kind 映射为 PortableMIR lowering feature mask。
/// 参数说明：`kind` 为 CorePlace kind 常量。
/// 返回值说明：返回该 place lowering 需要的 feature mask；未知 kind 返回 `0`。
export fn portable_mir_lowering_feature_for_place_kind(kind: i32) i32 {
    if kind == CORE_PLACE_KIND_FIELD || kind == CORE_PLACE_KIND_INDEX || kind == CORE_PLACE_KIND_SLICE {
        return MIR_LOWER_FEATURE_LOAD_STORE_ADDRESS + MIR_LOWER_FEATURE_FIELD_INDEX_SLICE_ADDRESS;
    }
    return 0;
}

/// 功能说明：把 CoreCleanupEdge kind 映射为 PortableMIR lowering feature mask。
/// 参数说明：`kind` 为 CoreCleanupEdge kind 常量。
/// 返回值说明：返回该 cleanup edge lowering 需要的 feature mask；未知 kind 返回 `0`。
export fn portable_mir_lowering_feature_for_cleanup_kind(kind: i32) i32 {
    if kind == CORE_CLEANUP_EDGE_KIND_RETURN {
        return MIR_LOWER_FEATURE_CONTROL_FLOW + MIR_LOWER_FEATURE_CALL_RETURN_BRANCH +
            MIR_LOWER_FEATURE_CLEANUP_PATH;
    }
    return 0;
}

/// 功能说明：初始化 `LoweredProgram + CoreBody` 到 PortableMIR 的 lowering 合同。
/// 参数说明：`contract` 为输出合同，`input` 为 frozen CoreIR 输入，`supported_feature_mask` 为当前 lowering 实现声明支持的 feature。
/// 返回值说明：输入通过 CoreIR verifier 且 feature 覆盖完整返回 `0`，否则返回 `-1` 并记录缺失 feature mask。
export fn portable_mir_lowering_contract_init(
    contract: &PortableMirLoweringContract,
    input: &PortableMirCoreInput,
    supported_feature_mask: i32,
) i32 {
    if contract == null {
        return -1;
    }
    contract.required_feature_mask = portable_mir_lowering_contract_required_features();
    contract.supported_feature_mask = supported_feature_mask;
    contract.missing_feature_mask = portable_mir_lowering_contract_missing_features(supported_feature_mask);
    contract.lowered_feature_mask = 0;
    contract.flags = 0;
    if input == null {
        contract.input.program = null;
        contract.input.body_id = CORE_BODY_INVALID_ID;
        contract.input.target_profile_id = 0;
        contract.input.flags = 0;
        return -1;
    }
    contract.input.program = input.program;
    contract.input.body_id = input.body_id;
    contract.input.target_profile_id = input.target_profile_id;
    contract.input.flags = input.flags;
    if portable_mir_core_input_is_frozen(input) == 0 {
        return -1;
    }
    if contract.missing_feature_mask != 0 {
        return -1;
    }
    return 0;
}
