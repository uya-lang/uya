/// 功能说明：追加一条 PortableMIR successor 记录。
/// 参数说明：`module` 为目标 MIR module，`item` 为待追加 control-flow successor。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn portable_mir_append_successor(module: &PortableMirModule, item: &MirSuccessor) i32 {
    if module == null || item == null {
        return -1;
    }
    if portable_mir_append_item(&module.successors, item as &const void) != 0 {
        return -1;
    }
    module.successor_count = module.successors.count;
    return 0;
}

/// 功能说明：追加一条 PortableMIR debug location 记录。
/// 参数说明：`module` 为目标 MIR module，`item` 为待追加 source location。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn portable_mir_append_debug_loc(module: &PortableMirModule, item: &MirDebugLoc) i32 {
    if module == null || item == null {
        return -1;
    }
    if portable_mir_append_item(&module.debug_locs, item as &const void) != 0 {
        return -1;
    }
    module.debug_loc_count = module.debug_locs.count;
    return 0;
}

/// 功能说明：追加一条 PortableMIR capability requirement 记录。
/// 参数说明：`module` 为目标 MIR module，`item` 为待追加 capability requirement。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn portable_mir_append_capability_req(module: &PortableMirModule, item: &MirCapabilityReq) i32 {
    if module == null || item == null {
        return -1;
    }
    if portable_mir_append_item(&module.capability_reqs, item as &const void) != 0 {
        return -1;
    }
    module.capability_req_count = module.capability_reqs.count;
    return 0;
}

/// 功能说明：释放 PortableMIR module 的所有动态表。
/// 参数说明：`module` 为目标 MIR module。
/// 返回值说明：无。
export fn portable_mir_module_release(module: &PortableMirModule) void {
    if module == null {
        return;
    }
    if module.lifecycle_state == PORTABLE_MIR_LIFECYCLE_ACTIVE {
        semantic_vector_release(&module.functions);
        semantic_vector_release(&module.blocks);
        semantic_vector_release(&module.values);
        semantic_vector_release(&module.types);
        semantic_vector_release(&module.locals);
        semantic_vector_release(&module.insts);
        semantic_vector_release(&module.terminators);
        semantic_vector_release(&module.operands);
        semantic_vector_release(&module.block_params);
        semantic_vector_release(&module.successors);
        semantic_vector_release(&module.debug_locs);
        semantic_vector_release(&module.capability_reqs);
    }
    portable_mir_module_clear_counts(module);
    module.arena = null;
    module.lifecycle_state = PORTABLE_MIR_LIFECYCLE_RELEASED;
}
