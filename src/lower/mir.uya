    MIR_RUNTIME_CAP_SYSCALL;

/// 功能说明：判断 PortableMIR type kind 是否为整数标量。
/// 参数说明：`kind` 为待分类的 MIR type kind。
/// 返回值说明：整数标量返回 1，否则返回 0。
export fn portable_mir_type_kind_is_integer(kind: i32) i32 {
    if kind == MIR_TYPE_KIND_I8 || kind == MIR_TYPE_KIND_U8 ||
       kind == MIR_TYPE_KIND_I16 || kind == MIR_TYPE_KIND_U16 ||
       kind == MIR_TYPE_KIND_I32 || kind == MIR_TYPE_KIND_U32 ||
       kind == MIR_TYPE_KIND_I64 || kind == MIR_TYPE_KIND_U64 ||
       kind == MIR_TYPE_KIND_ISIZE || kind == MIR_TYPE_KIND_USIZE ||
       kind == MIR_TYPE_KIND_BYTE {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR type kind 是否为浮点标量。
/// 参数说明：`kind` 为待分类的 MIR type kind。
/// 返回值说明：f32/f64 浮点标量返回 1，否则返回 0。
export fn portable_mir_type_kind_is_float(kind: i32) i32 {
    if kind == MIR_TYPE_KIND_F32 || kind == MIR_TYPE_KIND_F64 {
        return 1;
    }
    return 0;
}

/// 功能说明：根据 PortableMIR type kind 计算默认 ABI class。
/// 参数说明：`kind` 为待分类的 MIR type kind。
/// 返回值说明：返回 `MIR_ABI_CLASS_*` 常量；未知 kind 返回 `0`。
export fn portable_mir_abi_class_for_type_kind(kind: i32) i32 {
    if kind == MIR_TYPE_KIND_VOID {
        return MIR_ABI_CLASS_VOID;
    }
    if portable_mir_type_kind_is_integer(kind) != 0 || kind == MIR_TYPE_KIND_BOOL {
        return MIR_ABI_CLASS_INTEGER;
    }
    if kind == MIR_TYPE_KIND_POINTER || kind == MIR_TYPE_KIND_FUNCTION_POINTER {
        return MIR_ABI_CLASS_POINTER;
    }
    if kind == MIR_TYPE_KIND_F32 {
        return MIR_ABI_CLASS_FLOAT;
    }
    if kind == MIR_TYPE_KIND_F64 {
        return MIR_ABI_CLASS_DOUBLE;
    }
    if kind == MIR_TYPE_KIND_STRUCT || kind == MIR_TYPE_KIND_UNION ||
       kind == MIR_TYPE_KIND_ENUM || kind == MIR_TYPE_KIND_ARRAY ||
       kind == MIR_TYPE_KIND_SLICE {
        return MIR_ABI_CLASS_AGGREGATE;
    }
    if kind == MIR_TYPE_KIND_ERROR_UNION {
        return MIR_ABI_CLASS_ERROR_UNION;
    }
    if kind == MIR_TYPE_KIND_FUNCTION {
        return MIR_ABI_CLASS_FUNCTION;
    }
    return 0;
}

/// 功能说明：根据参数数量计算 call ABI metadata flag。
/// 参数说明：`param_count` 为 function signature 的显式参数数量。
/// 返回值说明：多参数 call 返回 `MIR_CALL_FLAG_MULTI_PARAM`，否则返回 `0`。
export fn portable_mir_call_flag_for_param_count(param_count: i32) i32 {
    if param_count > 1 {
        return MIR_CALL_FLAG_MULTI_PARAM;
    }
    return 0;
}

/// 功能说明：根据返回类型计算 call ABI metadata flag。
/// 参数说明：`kind` 为 callee signature 的返回 type kind。
/// 返回值说明：返回 aggregate/error-union/float ABI 相关 flags；无特殊 ABI 时返回 `0`。
export fn portable_mir_call_flag_for_return_type(kind: i32) i32 {
    if kind == MIR_TYPE_KIND_STRUCT || kind == MIR_TYPE_KIND_UNION ||
       kind == MIR_TYPE_KIND_ENUM || kind == MIR_TYPE_KIND_ARRAY ||
       kind == MIR_TYPE_KIND_SLICE {
        return MIR_CALL_FLAG_AGGREGATE_RETURN + MIR_CALL_FLAG_OUT_PARAM_WRITEBACK;
    }
    if kind == MIR_TYPE_KIND_ERROR_UNION {
        return MIR_CALL_FLAG_ERROR_UNION_RETURN;
    }
    if kind == MIR_TYPE_KIND_F32 || kind == MIR_TYPE_KIND_F64 {
        return MIR_CALL_FLAG_FLOAT_ABI;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为整数一元表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：整数一元 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_integer_unary(op: i32) i32 {
    if op >= MIR_INST_OP_INT_UNARY_MIN && op <= MIR_INST_OP_INT_UNARY_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为整数算术表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：整数算术 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_integer_arithmetic(op: i32) i32 {
    if op == MIR_INST_OP_I32_ADD {
        return 1;
    }
    if op >= MIR_INST_OP_INT_ARITH_MIN && op <= MIR_INST_OP_INT_ARITH_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为整数比较表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：整数比较 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_integer_compare(op: i32) i32 {
    if op == MIR_INST_OP_I32_LE {
        return 1;
    }
    if op >= MIR_INST_OP_INT_CMP_MIN && op <= MIR_INST_OP_INT_CMP_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为 bool 逻辑表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：bool 逻辑 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_logic(op: i32) i32 {
    if op >= MIR_INST_OP_LOGIC_MIN && op <= MIR_INST_OP_LOGIC_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为显式转换表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：conversion opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_conversion(op: i32) i32 {
    if op >= MIR_INST_OP_CONVERT_MIN && op <= MIR_INST_OP_CONVERT_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为浮点算术表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：f32/f64 算术 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_float_arithmetic(op: i32) i32 {
    if op >= MIR_INST_OP_FLOAT_ARITH_MIN && op <= MIR_INST_OP_FLOAT_ARITH_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为浮点比较表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：f32/f64 比较 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_float_compare(op: i32) i32 {
    if op >= MIR_INST_OP_FLOAT_CMP_MIN && op <= MIR_INST_OP_FLOAT_CMP_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为浮点常量表达式。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：f32/f64 常量 opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_float_constant(op: i32) i32 {
    if op >= MIR_INST_OP_FLOAT_CONST_MIN && op <= MIR_INST_OP_FLOAT_CONST_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为取址指令。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：local/global/param address opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_address(op: i32) i32 {
    if op >= MIR_INST_OP_ADDRESS_MIN && op <= MIR_INST_OP_ADDRESS_MAX {
        return 1;
    }
    if op == MIR_INST_OP_INDEX_ADDR ||
       op == MIR_INST_OP_SLICE_PTR_ADDR ||
       op == MIR_INST_OP_SLICE_LEN_ADDR ||
       op == MIR_INST_OP_SLICE_INDEX_ADDR {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为字段 place 访问指令。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：field address/load/store opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_field_place(op: i32) i32 {
    if op >= MIR_INST_OP_FIELD_MIN && op <= MIR_INST_OP_FIELD_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为数组索引 place 访问指令。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：index address/load/store opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_index_place(op: i32) i32 {
    if op >= MIR_INST_OP_INDEX_MIN && op <= MIR_INST_OP_INDEX_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为 slice place 访问指令。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：slice ptr/len/index opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_slice_place(op: i32) i32 {
    if op >= MIR_INST_OP_SLICE_MIN && op <= MIR_INST_OP_SLICE_MAX {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为 pointer offset 指令。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：pointer offset opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_pointer_offset(op: i32) i32 {
    if op == MIR_INST_OP_POINTER_OFFSET {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR opcode 是否为 aggregate copy/move 指令。
/// 参数说明：`op` 为待分类的 MIR instruction opcode。
/// 返回值说明：aggregate copy 或 move opcode 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_aggregate_copy_move(op: i32) i32 {
    if op == MIR_INST_OP_AGGREGATE_COPY || op == MIR_INST_OP_AGGREGATE_MOVE {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR 指令 opcode 是否为显式 drop 操作。
/// 参数说明：`op` 为待分类的 MIR 指令 opcode。
/// 返回值说明：drop value/drop in place 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_drop(op: i32) i32 {
    if op == MIR_INST_OP_DROP_VALUE || op == MIR_INST_OP_DROP_IN_PLACE {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR 指令 opcode 是否为 error-union 操作。
/// 参数说明：`op` 为待分类的 MIR 指令 opcode。
/// 返回值说明：error-union 构造、判别和提取操作返回 1，否则返回 0。
export fn portable_mir_inst_op_is_error_union(op: i32) i32 {
    if op == MIR_INST_OP_ERROR_UNION_OK || op == MIR_INST_OP_ERROR_UNION_ERR ||
       op == MIR_INST_OP_ERROR_UNION_IS_ERR || op == MIR_INST_OP_ERROR_UNION_PAYLOAD ||
       op == MIR_INST_OP_ERROR_UNION_ERROR {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR 指令 opcode 是否为显式 atomic 操作。
/// 参数说明：`op` 为待分类的 MIR 指令 opcode。
/// 返回值说明：atomic init/load/store/RMW/CMPXCHG 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_atomic(op: i32) i32 {
    if op == MIR_INST_OP_ATOMIC_INIT || op == MIR_INST_OP_ATOMIC_LOAD ||
       op == MIR_INST_OP_ATOMIC_STORE || op == MIR_INST_OP_ATOMIC_RMW ||
       op == MIR_INST_OP_ATOMIC_CMPXCHG {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 PortableMIR 指令 opcode 是否为显式 vector/mask 操作。
/// 参数说明：`op` 为待分类的 MIR 指令 opcode。
/// 返回值说明：vector splat/load/store/select 返回 1，否则返回 0。
export fn portable_mir_inst_op_is_vector_mask(op: i32) i32 {
    if op == MIR_INST_OP_VECTOR_SPLAT || op == MIR_INST_OP_VECTOR_LOAD ||
       op == MIR_INST_OP_VECTOR_STORE || op == MIR_INST_OP_VECTOR_SELECT {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 MIR operand kind 是否为 call target 表达形式。
/// 参数说明：`kind` 为待分类的 MIR operand kind。
/// 返回值说明：direct/extern/method instance/function pointer callee 返回 1，否则返回 0。
export fn portable_mir_operand_kind_is_call_target(kind: i32) i32 {
    if kind == MIR_OPERAND_KIND_CALL_TARGET_DIRECT ||
       kind == MIR_OPERAND_KIND_CALL_TARGET_EXTERN ||
       kind == MIR_OPERAND_KIND_CALL_TARGET_METHOD_INSTANCE ||
       kind == MIR_OPERAND_KIND_CALL_TARGET_FUNCTION_POINTER {
        return 1;
    }
    return 0;
}

/// 功能说明：记录 PortableMIR target profile 中与后端无关的基础能力边界。
/// 参数说明：无；字段保存 profile ID、pointer/layout 形态、runtime mode、call ABI profile、address/call/capability masks 和 feature flags。
/// 返回值说明：无。
export struct MirTargetProfile {
    profile_id: i32,
    pointer_size: i32,
    endianness: i32,
    default_address_space: i32,
    runtime_mode: i32,
    call_abi_profile: i32,
    supported_address_spaces: i32,
    supported_calling_conventions: i32,
    runtime_capability_mask: i32,
    feature_flags: i32,
}

/// 功能说明：记录 MIR operand 对 value/local/type/capability 等 ID 的统一引用。
/// 参数说明：无；`kind` 决定实际引用字段语义。
/// 返回值说明：无。
export struct MirOperand {
    operand_id: MirOperandId,
    kind: i32,
    value_id: MirValueId,
    local_id: MirLocalId,
    type_id: MirTypeId,
    capability_req_id: MirCapabilityReqId,
    immediate_i32: i32,
    flags: i32,
}

/// 功能说明：记录 block parameter 的稳定 ID、类型和 source 位置。
/// 参数说明：无；`value_id` 指向该参数对应的 MirValue。
/// 返回值说明：无。
export struct MirBlockParam {
    param_id: MirBlockParamId,
    block_id: MirBlockId,
    value_id: MirValueId,
    type_id: MirTypeId,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 terminator successor 和传给目标 block 的参数范围。
/// 参数说明：无；`arg_start/count` 指向 module operands 表。
/// 返回值说明：无。
export struct MirSuccessor {
    successor_id: MirSuccessorId,
    block_id: MirBlockId,
    arg_start: i32,
    arg_count: i32,
    flags: i32,
}

/// 功能说明：记录 MIR dump/verifier/backend 共用的 source location ID。
/// 参数说明：无；字段保存来自 CoreIR 的 source span 和可选文件行列。
/// 返回值说明：无。
export struct MirDebugLoc {
    debug_loc_id: MirDebugLocId,
    source_span_id: i32,
    file_id: FileId,
    line: i32,
    column: i32,
}

/// 功能说明：记录 MIR 构造后、backend 发射前必须验证的 capability requirement。
/// 参数说明：无；字段保存 capability ID、触发函数/指令和 source 位置。
/// 返回值说明：无。
export struct MirCapabilityReq {
    capability_req_id: MirCapabilityReqId,
    capability_id: i32,
    function_id: MirFunctionId,
    inst_id: MirInstId,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 aggregate type 的字段布局，供 MIR verifier 和后端直接消费。
/// 参数说明：无；字段保存 owner type、field 顺序、field type、byte offset、size、align 和 flags。
/// 返回值说明：无。
export struct MirFieldLayout {
    field_layout_id: MirFieldLayoutId,
    owner_type_id: MirTypeId,
    field_index: i32,
    field_type_id: MirTypeId,
    offset_bytes: usize,
    size_bytes: usize,
    align_bytes: usize,
    flags: i32,
}

/// 功能说明：记录 function type 的参数类型和 ABI class。
/// 参数说明：无；字段保存 owner function type、参数顺序、参数类型、ABI class 和 flags。
/// 返回值说明：无。
export struct MirFunctionParamType {
    function_param_type_id: MirFunctionParamTypeId,
    owner_type_id: MirTypeId,
    param_index: i32,
    type_id: MirTypeId,
    abi_class: i32,
    flags: i32,
}

/// 功能说明：记录 PortableMIR 中的 lowered concrete type 和 layout metadata。
/// 参数说明：无；字段保存 kind、layout、ABI、address space、element/pointee、lane 和 field range。
/// 返回值说明：无。
export struct MirType {
    type_id: MirTypeId,
    kind: i32,
    source_type_id: TypeId,
    size_bytes: usize,
    align_bytes: usize,
    layout_id: i32,
    tag_offset_bytes: usize,
    payload_offset_bytes: usize,
    atomic_align_bytes: usize,
    element_type_id: MirTypeId,
    pointee_type_id: MirTypeId,
    field_start: i32,
    field_count: i32,
    lane_count: i32,
    lane_stride_bytes: usize,
    mask_representation: i32,
    abi_class: i32,
    address_space: i32,
    flags: i32,
}

/// 功能说明：记录 PortableMIR 显式 local storage。
/// 参数说明：无；字段保存所属函数、类型、source symbol、alignment 和地址空间。
/// 返回值说明：无。
export struct MirLocal {
    local_id: MirLocalId,
    function_id: MirFunctionId,
    type_id: MirTypeId,
    source_symbol_id: SymbolId,
    address_space: i32,
    alignment: usize,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 PortableMIR typed value。
/// 参数说明：无；字段保存所属函数/block、类型、定义指令、local/param 关联和 source expr。
/// 返回值说明：无。
export struct MirValue {
    value_id: MirValueId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    type_id: MirTypeId,
    defining_inst_id: MirInstId,
    local_id: MirLocalId,
    param_index: i32,
    source_expr_id: ExprId,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 PortableMIR instruction。
/// 参数说明：无；字段保存 opcode、结果类型/value、operand range、ABI/capability/address metadata 和 source 位置。
/// 返回值说明：无。
export struct MirInst {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    op: i32,
    type_id: MirTypeId,
    result_value_id: MirValueId,
    operand_start: i32,
    operand_count: i32,
    calling_convention: i32,
    runtime_capability_mask: i32,
    address_space: i32,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 PortableMIR block terminator。
/// 参数说明：无；字段保存 terminator kind、operand/successor range 和 source 位置。
/// 返回值说明：无。
export struct MirTerminator {
    terminator_id: MirTerminatorId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    kind: i32,
    operand_start: i32,
    operand_count: i32,
    successor_start: i32,
    successor_count: i32,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 PortableMIR basic block。
/// 参数说明：无；字段保存 block params、instruction range、terminator 和 source 位置。
/// 返回值说明：无。
export struct MirBlock {
    block_id: MirBlockId,
    function_id: MirFunctionId,
    param_start: i32,
    param_count: i32,
    inst_start: i32,
    inst_count: i32,
    terminator_id: MirTerminatorId,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 PortableMIR function。
/// 参数说明：无；字段保存 CoreIR 来源、签名/参数/local/block ranges、entry block、naked body 合同、ABI、address space 和 capabilities。
/// 返回值说明：无。
export struct MirFunction {
    function_id: MirFunctionId,
    lowered_function_id: FunctionId,
    decl_id: DeclId,
    source_core_body_id: CoreBodyId,
    symbol_id: SymbolId,
    signature_type_id: MirTypeId,
    param_start: i32,
    param_count: i32,
    local_start: i32,
    local_count: i32,
    block_start: i32,
    block_count: i32,
    entry_block_id: MirBlockId,
    cleanup_model: i32,
    capability_req_start: i32,
    capability_req_count: i32,
    calling_convention: i32,
    runtime_capability_mask: i32,
    required_address_space_mask: i32,
    body_kind: i32,
    naked_asm_inst_start: i32,
    naked_asm_inst_count: i32,
    naked_forbidden_lowering_mask: i32,
    debug_loc_id: MirDebugLocId,
    flags: i32,
}

/// 功能说明：记录 PortableMIR module 的所有动态表和生命周期。
/// 参数说明：无；调用 `portable_mir_module_init` 后使用。
/// 返回值说明：无。
export struct PortableMirModule {
    arena: &CompilerArena,
    lifecycle_state: i32,
    target_profile: MirTargetProfile,
    function_count: usize,
    block_count: usize,
    value_count: usize,
    type_count: usize,
    local_count: usize,
    inst_count: usize,
    terminator_count: usize,
    operand_count: usize,
    block_param_count: usize,
    successor_count: usize,
    debug_loc_count: usize,
    capability_req_count: usize,
    field_layout_count: usize,
    function_param_type_count: usize,
    functions: SemanticVector,
    blocks: SemanticVector,
    values: SemanticVector,
    types: SemanticVector,
    locals: SemanticVector,
    insts: SemanticVector,
    terminators: SemanticVector,
    operands: SemanticVector,
    block_params: SemanticVector,
    successors: SemanticVector,
    debug_locs: SemanticVector,
    capability_reqs: SemanticVector,
    field_layouts: SemanticVector,
    function_param_types: SemanticVector,
}

/// 功能说明：返回 hosted native 使用的 PortableMIR target profile。
/// 参数说明：无。
/// 返回值说明：返回 Linux x86_64 hosted native 第一阶段 profile，支持 Uya/C 调用和 hosted libc/C extern capability。
export fn portable_mir_target_profile_hosted_native() MirTargetProfile {
    return MirTargetProfile{
        profile_id: MIR_TARGET_PROFILE_HOSTED_NATIVE,
        pointer_size: 0,
        endianness: 0,
        default_address_space: MIR_ADDRESS_SPACE_GENERIC,
        runtime_mode: MIR_RUNTIME_MODE_HOSTED,
        call_abi_profile: MIR_CALL_ABI_PROFILE_HOSTED_SYSV,
        supported_address_spaces: MIR_ADDRESS_SPACE_GENERIC + MIR_ADDRESS_SPACE_HOST,
        supported_calling_conventions: MIR_PROFILE_CALL_CONV_HOSTED_NATIVE,
        runtime_capability_mask: MIR_PROFILE_RUNTIME_CAP_HOSTED_NATIVE,
        feature_flags: 0,
    };
}

/// 功能说明：返回 freestanding native 使用的 PortableMIR target profile。
/// 参数说明：无。
/// 返回值说明：返回 nostdlib/build-seed profile，只支持 Uya/syscall 调用和 freestanding runtime capability。
export fn portable_mir_target_profile_freestanding_native() MirTargetProfile {
    return MirTargetProfile{
        profile_id: MIR_TARGET_PROFILE_FREESTANDING_NATIVE,
        pointer_size: 0,
        endianness: 0,
        default_address_space: MIR_ADDRESS_SPACE_GENERIC,
        runtime_mode: MIR_RUNTIME_MODE_FREESTANDING,
        call_abi_profile: MIR_CALL_ABI_PROFILE_FREESTANDING_SYSCALL,
        supported_address_spaces: MIR_ADDRESS_SPACE_GENERIC,
        supported_calling_conventions: MIR_PROFILE_CALL_CONV_FREESTANDING_NATIVE,
        runtime_capability_mask: MIR_PROFILE_RUNTIME_CAP_FREESTANDING_NATIVE,
        feature_flags: 0,
    };
}

fn portable_mir_default_target_profile() MirTargetProfile {
    return portable_mir_target_profile_hosted_native();
}

/// 功能说明：判断 target profile 是否支持指定 call ABI profile。
/// 参数说明：`profile` 为待检查 profile，`call_abi_profile` 为 `MIR_CALL_ABI_PROFILE_*` 常量。
/// 返回值说明：profile 的 call ABI 与请求一致时返回 `1`，否则返回 `0`。
export fn portable_mir_target_profile_supports_call_abi(profile: &MirTargetProfile,
    call_abi_profile: i32) i32 {
    if profile == null || call_abi_profile == 0 {
        return 0;
    }
    if profile.call_abi_profile == call_abi_profile {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 target profile 是否支持指定 runtime capability mask。
/// 参数说明：`profile` 为待检查 profile，`capability_mask` 为一个或多个 runtime capability bit。
/// 返回值说明：capability mask 被完整覆盖时返回 `1`，否则返回 `0`。
export fn portable_mir_target_profile_supports_runtime_capability(profile: &MirTargetProfile,
    capability_mask: i32) i32 {
    if profile == null {
        return 0;
    }
    if capability_mask == 0 {
        return 1;
    }
    if (profile.runtime_capability_mask & capability_mask) == capability_mask {
        return 1;
    }
    return 0;
}

/// 功能说明：返回 naked 函数禁止进入的普通 lowering 阶段集合。
/// 参数说明：无。
/// 返回值说明：返回 prologue/epilogue、stack slot、cleanup、drop、async 和 implicit return 的 bit mask。
export fn portable_mir_naked_forbidden_lowering_mask() i32 {
    return MIR_NAKED_FORBID_PROLOGUE_EPILOGUE + MIR_NAKED_FORBID_STACK_SLOT +
        MIR_NAKED_FORBID_CLEANUP + MIR_NAKED_FORBID_DROP + MIR_NAKED_FORBID_ASYNC +
        MIR_NAKED_FORBID_IMPLICIT_RETURN;
}

/// 功能说明：判断 MIR function 是否携带 naked flag。
/// 参数说明：`function` 为待检查的 MIR function。
/// 返回值说明：携带 `MIR_FUNCTION_FLAG_NAKED` 返回 `1`，否则返回 `0`。
export fn portable_mir_function_has_naked_flag(function: &MirFunction) i32 {
    if function == null {
        return 0;
    }
    if (function.flags & MIR_FUNCTION_FLAG_NAKED) != 0 {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 naked MIR function 是否声明拒绝指定普通 lowering 阶段。
/// 参数说明：`function` 为待检查函数，`lowering_mask` 为一个或多个 `MIR_NAKED_FORBID_*` bit。
/// 返回值说明：函数为 naked 且 mask 完全覆盖请求阶段时返回 `1`，否则返回 `0`。
export fn portable_mir_function_rejects_naked_lowering(function: &MirFunction, lowering_mask: i32) i32 {
    if function == null || lowering_mask == 0 {
        return 0;
    }
    if portable_mir_function_has_naked_flag(function) == 0 {
        return 0;
    }
    if (function.naked_forbidden_lowering_mask & lowering_mask) == lowering_mask {
        return 1;
    }
    return 0;
}

/// 功能说明：判断 MIR function 是否满足 asm-only naked body 合同。
/// 参数说明：`function` 为待检查的 MIR function。
/// 返回值说明：函数有 naked flag、asm-only body、无普通 block/local/cleanup，并拒绝全部普通 lowering 时返回 `1`。
export fn portable_mir_function_has_asm_only_naked_body(function: &MirFunction) i32 {
    if portable_mir_function_has_naked_flag(function) == 0 {
        return 0;
    }
    if function.body_kind != MIR_FUNCTION_BODY_KIND_ASM_ONLY_NAKED {
        return 0;
    }
    if function.naked_asm_inst_start < 0 || function.naked_asm_inst_count <= 0 {
        return 0;
    }
    if function.local_count != 0 || function.block_count != 0 {
        return 0;
    }
    if function.entry_block_id != MIR_BLOCK_INVALID_ID || function.cleanup_model != 0 {
        return 0;
    }
    return portable_mir_function_rejects_naked_lowering(function, portable_mir_naked_forbidden_lowering_mask());
}

fn portable_mir_module_clear_counts(module: &PortableMirModule) void {
    if module == null {
        return;
    }
    module.function_count = 0usize;
    module.block_count = 0usize;
    module.value_count = 0usize;
    module.type_count = 0usize;
    module.local_count = 0usize;
    module.inst_count = 0usize;
    module.terminator_count = 0usize;
    module.operand_count = 0usize;
    module.block_param_count = 0usize;
    module.successor_count = 0usize;
    module.debug_loc_count = 0usize;
    module.capability_req_count = 0usize;
    module.field_layout_count = 0usize;
    module.function_param_type_count = 0usize;
}

/// 功能说明：初始化 PortableMIR module 的动态表和生命周期。
/// 参数说明：`module` 为目标 MIR module，`arena` 为 MIR 构造阶段共享 arena。
/// 返回值说明：无。
export fn portable_mir_module_init(module: &PortableMirModule, arena: &CompilerArena) void {
    if module == null {
        return;
    }
    portable_mir_module_clear_counts(module);
    module.arena = arena;
    module.lifecycle_state = PORTABLE_MIR_LIFECYCLE_ACTIVE;
    module.target_profile = portable_mir_default_target_profile();
    semantic_vector_init(&module.functions, @size_of(MirFunction));
    semantic_vector_init(&module.blocks, @size_of(MirBlock));
    semantic_vector_init(&module.values, @size_of(MirValue));
    semantic_vector_init(&module.types, @size_of(MirType));
    semantic_vector_init(&module.locals, @size_of(MirLocal));
    semantic_vector_init(&module.insts, @size_of(MirInst));
    semantic_vector_init(&module.terminators, @size_of(MirTerminator));
    semantic_vector_init(&module.operands, @size_of(MirOperand));
    semantic_vector_init(&module.block_params, @size_of(MirBlockParam));
    semantic_vector_init(&module.successors, @size_of(MirSuccessor));
    semantic_vector_init(&module.debug_locs, @size_of(MirDebugLoc));
    semantic_vector_init(&module.capability_reqs, @size_of(MirCapabilityReq));
    semantic_vector_init(&module.field_layouts, @size_of(MirFieldLayout));
    semantic_vector_init(&module.function_param_types, @size_of(MirFunctionParamType));
}

fn portable_mir_append_item(vec: &SemanticVector, item: &const void) i32 {
    if vec == null || item == null {
        return -1;
    }
    if semantic_vector_append(vec, item) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：追加一条 PortableMIR function 记录。
/// 参数说明：`module` 为目标 MIR module，`item` 为待追加函数。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn portable_mir_append_function(module: &PortableMirModule, item: &MirFunction) i32 {
    if module == null || item == null {
        return -1;
    }
    if portable_mir_append_item(&module.functions, item as &const void) != 0 {
        return -1;
    }
    module.function_count = module.functions.count;
    return 0;
}

/// 功能说明：追加一条 PortableMIR block 记录。
