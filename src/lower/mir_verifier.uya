// lower/mir_verifier.uya - Linear PortableMIR verifier shared by future backends.

export const MIR_VERIFY_OK: i32 = 0;
export const MIR_VERIFY_ERR_INVALID_MODULE: i32 = 1;
export const MIR_VERIFY_ERR_COUNT_MISMATCH: i32 = 2;
export const MIR_VERIFY_ERR_INVALID_FUNCTION: i32 = 3;
export const MIR_VERIFY_ERR_INVALID_BLOCK: i32 = 4;
export const MIR_VERIFY_ERR_MISSING_TERMINATOR: i32 = 5;
export const MIR_VERIFY_ERR_INVALID_VALUE: i32 = 6;
export const MIR_VERIFY_ERR_TYPE_MISMATCH: i32 = 7;
export const MIR_VERIFY_ERR_INVALID_ADDRESS: i32 = 8;
export const MIR_VERIFY_ERR_INVALID_ATOMIC: i32 = 9;
export const MIR_VERIFY_ERR_INVALID_VECTOR_MASK: i32 = 10;
export const MIR_VERIFY_ERR_INVALID_CLEANUP: i32 = 11;
export const MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY: i32 = 12;
export const MIR_VERIFY_ERR_INVALID_NAKED_BODY: i32 = 13;
export const MIR_VERIFY_ERR_UNDEFINED_USE: i32 = 14;
export const MIR_VERIFY_ERR_INVALID_OPERAND: i32 = 15;
export const MIR_VERIFY_ERR_INVALID_LAYOUT: i32 = 16;

const MIR_VERIFY_ATOMIC_OP_MIN: i32 = 17;
const MIR_VERIFY_ATOMIC_OP_MAX: i32 = 20;
const MIR_VERIFY_VECTOR_OP_MIN: i32 = 21;
const MIR_VERIFY_VECTOR_OP_MAX: i32 = 24;

/// 功能说明：记录 PortableMIR verifier 的首个稳定 diagnostic。
/// 参数说明：无；字段保存错误码和触发错误的 MIR ID。
/// 返回值说明：无。
export struct MirVerifierResult {
    error_code: i32,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    inst_id: MirInstId,
    value_id: MirValueId,
    type_id: MirTypeId,
    operand_id: MirOperandId,
    capability_req_id: MirCapabilityReqId,
    debug_loc_id: MirDebugLocId,
}

/// 功能说明：初始化 MIR verifier result。
/// 参数说明：`result` 为待初始化的 result 指针。
/// 返回值说明：无。
export fn portable_mir_verifier_result_init(result: &MirVerifierResult) void {
    if result == null {
        return;
    }
    result.error_code = MIR_VERIFY_OK;
    result.function_id = MIR_FUNCTION_INVALID_ID;
    result.block_id = MIR_BLOCK_INVALID_ID;
    result.inst_id = MIR_INST_INVALID_ID;
    result.value_id = MIR_VALUE_INVALID_ID;
    result.type_id = MIR_TYPE_INVALID_ID;
    result.operand_id = -1;
    result.capability_req_id = MIR_CAPABILITY_REQ_INVALID_ID;
    result.debug_loc_id = MIR_DEBUG_LOC_INVALID_ID;
}

fn portable_mir_verify_fail(result: &MirVerifierResult, error_code: i32, function_id: MirFunctionId,
    block_id: MirBlockId, inst_id: MirInstId, value_id: MirValueId, type_id: MirTypeId,
    operand_id: MirOperandId, capability_req_id: MirCapabilityReqId, debug_loc_id: MirDebugLocId) i32 {
    if result != null && result.error_code == MIR_VERIFY_OK {
        result.error_code = error_code;
        result.function_id = function_id;
        result.block_id = block_id;
        result.inst_id = inst_id;
        result.value_id = value_id;
        result.type_id = type_id;
        result.operand_id = operand_id;
        result.capability_req_id = capability_req_id;
        result.debug_loc_id = debug_loc_id;
    }
    return -1;
}

fn portable_mir_verify_range(start: i32, count: i32, total: usize) i32 {
    if start < 0 || count < 0 {
        return 0;
    }
    if (start as usize) > total {
        return 0;
    }
    if (count as usize) > total - (start as usize) {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_count_pair(expected: usize, actual: usize, result: &MirVerifierResult) i32 {
    if expected == actual {
        return 0;
    }
    return portable_mir_verify_fail(result, MIR_VERIFY_ERR_COUNT_MISMATCH, MIR_FUNCTION_INVALID_ID,
        MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID,
        -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
}

fn portable_mir_verify_count(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    if portable_mir_verify_count_pair(module.function_count, module.functions.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.block_count, module.blocks.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.value_count, module.values.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.type_count, module.types.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.local_count, module.locals.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.inst_count, module.insts.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.terminator_count, module.terminators.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.operand_count, module.operands.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.capability_req_count, module.capability_reqs.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.field_layout_count, module.field_layouts.count, result) != 0 { return -1; }
    if portable_mir_verify_count_pair(module.function_param_type_count, module.function_param_types.count, result) != 0 { return -1; }
    return 0;
}

fn portable_mir_verify_has_mask(mask: i32, required: i32) i32 {
    if required == 0 {
        return 1;
    }
    if (mask & required) == required {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_address_supported(module: &PortableMirModule, address_space: i32) i32 {
    return portable_mir_verify_has_mask(module.target_profile.supported_address_spaces, address_space);
}

fn portable_mir_verify_call_abi_supported(module: &PortableMirModule, calling_convention: i32) i32 {
    if module == null {
        return 0;
    }
    if portable_mir_verify_has_mask(module.target_profile.supported_calling_conventions,
        calling_convention) == 0 {
        return 0;
    }
    if module.target_profile.runtime_mode == MIR_RUNTIME_MODE_HOSTED {
        return portable_mir_target_profile_supports_call_abi(&module.target_profile,
            MIR_CALL_ABI_PROFILE_HOSTED_SYSV);
    }
    if module.target_profile.runtime_mode == MIR_RUNTIME_MODE_FREESTANDING {
        return portable_mir_target_profile_supports_call_abi(&module.target_profile,
            MIR_CALL_ABI_PROFILE_FREESTANDING_SYSCALL);
    }
    return 0;
}

fn portable_mir_verify_runtime_capability_supported(module: &PortableMirModule,
    capability_mask: i32) i32 {
    if module == null {
        return 0;
    }
    return portable_mir_target_profile_supports_runtime_capability(&module.target_profile,
        capability_mask);
}

fn portable_mir_expected_scalar_size_align(typ: &MirType) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_BOOL {
        if typ.size_bytes == 1usize && typ.align_bytes == 1usize { return 1; }
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_I8 || typ.kind == MIR_TYPE_KIND_U8 || typ.kind == MIR_TYPE_KIND_BYTE {
        if typ.size_bytes == 1usize && typ.align_bytes == 1usize { return 1; }
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_I16 || typ.kind == MIR_TYPE_KIND_U16 {
        if typ.size_bytes == 2usize && typ.align_bytes == 2usize { return 1; }
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_I32 || typ.kind == MIR_TYPE_KIND_U32 || typ.kind == MIR_TYPE_KIND_F32 {
        if typ.size_bytes == 4usize && typ.align_bytes == 4usize { return 1; }
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_I64 || typ.kind == MIR_TYPE_KIND_U64 || typ.kind == MIR_TYPE_KIND_ISIZE || typ.kind == MIR_TYPE_KIND_USIZE || typ.kind == MIR_TYPE_KIND_F64 {
        if typ.size_bytes == 8usize && typ.align_bytes == 8usize { return 1; }
        return 0;
    }
    return 1;
}

fn portable_mir_verify_array_slice_layout(module: &PortableMirModule, typ: &MirType) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind != MIR_TYPE_KIND_ARRAY && typ.kind != MIR_TYPE_KIND_SLICE {
        return 1;
    }
    const element_type: &MirType = portable_mir_verify_type_ptr(module, typ.element_type_id);
    if element_type == null {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_ARRAY {
        if typ.field_count <= 0 {
            return 0;
        }
        return 1;
    }
    if typ.pointee_type_id != MIR_TYPE_INVALID_ID &&
       portable_mir_verify_type_ptr(module, typ.pointee_type_id) == null {
        return 0;
    }
    if typ.field_count <= 0 || typ.lane_count < typ.field_count {
        return 0;
    }
    if typ.payload_offset_bytes <= typ.tag_offset_bytes {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_error_union_layout(typ: &MirType) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind != MIR_TYPE_KIND_ERROR_UNION {
        return 1;
    }
    if typ.payload_offset_bytes <= typ.tag_offset_bytes {
        return 0;
    }
    if typ.abi_class != MIR_ABI_CLASS_ERROR_UNION {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_abi_class_matches_type(typ: &MirType, abi_class: i32) i32 {
    if typ == null {
        return 0;
    }
    if abi_class == MIR_ABI_CLASS_OUT_PARAM_POINTER {
        if typ.kind == MIR_TYPE_KIND_POINTER {
            return 1;
        }
        return 0;
    }
    if abi_class == portable_mir_abi_class_for_type_kind(typ.kind) {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_function_ptr(module: &PortableMirModule, id: MirFunctionId) &MirFunction {
    if module == null || id < 0 || (id as usize) >= module.functions.count { return null; }
    return semantic_vector_item_ptr(&module.functions, id as usize) as &MirFunction;
}

fn portable_mir_verify_block_ptr(module: &PortableMirModule, id: MirBlockId) &MirBlock {
    if module == null || id < 0 || (id as usize) >= module.blocks.count { return null; }
    return semantic_vector_item_ptr(&module.blocks, id as usize) as &MirBlock;
}

fn portable_mir_verify_value_ptr(module: &PortableMirModule, id: MirValueId) &MirValue {
    if module == null || id < 0 || (id as usize) >= module.values.count { return null; }
    return semantic_vector_item_ptr(&module.values, id as usize) as &MirValue;
}

fn portable_mir_verify_type_ptr(module: &PortableMirModule, id: MirTypeId) &MirType {
    if module == null || id < 0 || (id as usize) >= module.types.count { return null; }
    return semantic_vector_item_ptr(&module.types, id as usize) as &MirType;
}

fn portable_mir_verify_local_ptr(module: &PortableMirModule, id: MirLocalId) &MirLocal {
    if module == null || id < 0 || (id as usize) >= module.locals.count { return null; }
    return semantic_vector_item_ptr(&module.locals, id as usize) as &MirLocal;
}

fn portable_mir_verify_inst_ptr(module: &PortableMirModule, id: MirInstId) &MirInst {
    if module == null || id < 0 || (id as usize) >= module.insts.count { return null; }
    return semantic_vector_item_ptr(&module.insts, id as usize) as &MirInst;
}

fn portable_mir_verify_terminator_ptr(module: &PortableMirModule, id: MirTerminatorId) &MirTerminator {
    if module == null || id < 0 || (id as usize) >= module.terminators.count { return null; }
    return semantic_vector_item_ptr(&module.terminators, id as usize) as &MirTerminator;
}

fn portable_mir_verify_operand_ptr(module: &PortableMirModule, id: MirOperandId) &MirOperand {
    if module == null || id < 0 || (id as usize) >= module.operands.count { return null; }
    return semantic_vector_item_ptr(&module.operands, id as usize) as &MirOperand;
}

fn portable_mir_verify_capability_ptr(module: &PortableMirModule, id: MirCapabilityReqId) &MirCapabilityReq {
    if module == null || id < 0 || (id as usize) >= module.capability_reqs.count { return null; }
    return semantic_vector_item_ptr(&module.capability_reqs, id as usize) as &MirCapabilityReq;
}

fn portable_mir_verify_field_layout_ptr(module: &PortableMirModule, id: MirFieldLayoutId) &MirFieldLayout {
    if module == null || id < 0 || (id as usize) >= module.field_layouts.count { return null; }
    return semantic_vector_item_ptr(&module.field_layouts, id as usize) as &MirFieldLayout;
}

fn portable_mir_verify_function_param_type_ptr(module: &PortableMirModule,
    id: MirFunctionParamTypeId) &MirFunctionParamType {
    if module == null || id < 0 || (id as usize) >= module.function_param_types.count { return null; }
    return semantic_vector_item_ptr(&module.function_param_types, id as usize) as &MirFunctionParamType;
}

fn portable_mir_verify_function_param_type(module: &PortableMirModule,
    param: &MirFunctionParamType, index: usize, result: &MirVerifierResult) i32 {
    if param == null || param.function_param_type_id != index as i32 ||
       portable_mir_verify_type_ptr(module, param.owner_type_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
            MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1,
            MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    const param_type: &MirType = portable_mir_verify_type_ptr(module, param.type_id);
    if param_type == null ||
       portable_mir_verify_abi_class_matches_type(param_type, param.abi_class) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
            MIR_VALUE_INVALID_ID, param.owner_type_id, -1,
            MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    return 0;
}

fn portable_mir_verify_function_param_types(module: &PortableMirModule,
    result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.function_param_types.count {
        const param: &MirFunctionParamType =
            semantic_vector_item_ptr(&module.function_param_types, i) as &MirFunctionParamType;
        if portable_mir_verify_function_param_type(module, param, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_field_layout(module: &PortableMirModule, field: &MirFieldLayout,
    index: usize, result: &MirVerifierResult) i32 {
    if field == null || field.field_layout_id != index as i32 ||
       portable_mir_verify_type_ptr(module, field.owner_type_id) == null ||
       portable_mir_verify_type_ptr(module, field.field_type_id) == null ||
       field.size_bytes == 0usize || field.align_bytes == 0usize {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
            MIR_VALUE_INVALID_ID, field.owner_type_id, -1,
            MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    return 0;
}

fn portable_mir_verify_field_layouts(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.field_layouts.count {
        const field: &MirFieldLayout = semantic_vector_item_ptr(&module.field_layouts, i) as &MirFieldLayout;
        if portable_mir_verify_field_layout(module, field, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_aggregate_field_layout(module: &PortableMirModule,
    owner: &MirType, result: &MirVerifierResult) i32 {
    if owner == null {
        return -1;
    }
    if owner.kind != MIR_TYPE_KIND_STRUCT && owner.kind != MIR_TYPE_KIND_UNION && owner.kind != MIR_TYPE_KIND_ENUM {
        return 0;
    }
    if owner.field_count <= 0 ||
       portable_mir_verify_range(owner.field_start, owner.field_count, module.field_layouts.count) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
            MIR_VALUE_INVALID_ID, owner.type_id, -1,
            MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    var offset: i32 = 0;
    var previous_offset: usize = 0usize;
    while offset < owner.field_count {
        const field: &MirFieldLayout = portable_mir_verify_field_layout_ptr(module,
            owner.field_start + offset);
        if field == null || field.owner_type_id != owner.type_id || field.field_index != offset {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
                MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
                MIR_VALUE_INVALID_ID, owner.type_id, -1,
                MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
        }
        if owner.kind == MIR_TYPE_KIND_STRUCT && offset > 0 && field.offset_bytes < previous_offset {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
                MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
                MIR_VALUE_INVALID_ID, owner.type_id, -1,
                MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
        }
        previous_offset = field.offset_bytes;
        offset = offset + 1;
    }
    return 0;
}

fn portable_mir_verify_function_type_layout(module: &PortableMirModule,
    typ: &MirType, result: &MirVerifierResult) i32 {
    if typ == null {
        return -1;
    }
    if typ.kind != MIR_TYPE_KIND_FUNCTION && typ.kind != MIR_TYPE_KIND_FUNCTION_POINTER {
        return 0;
    }
    const return_type: &MirType = portable_mir_verify_type_ptr(module, typ.element_type_id);
    if return_type == null ||
       portable_mir_verify_abi_class_matches_type(typ, typ.abi_class) == 0 ||
       portable_mir_verify_call_abi_supported(module, typ.flags) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
            MIR_VALUE_INVALID_ID, typ.type_id, -1,
            MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if typ.field_count < 0 ||
       portable_mir_verify_range(typ.field_start, typ.field_count,
        module.function_param_types.count) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
            MIR_VALUE_INVALID_ID, typ.type_id, -1,
            MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    var offset: i32 = 0;
    while offset < typ.field_count {
        const param: &MirFunctionParamType =
            portable_mir_verify_function_param_type_ptr(module, typ.field_start + offset);
        if param == null || param.owner_type_id != typ.type_id || param.param_index != offset {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
                MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
                MIR_VALUE_INVALID_ID, typ.type_id, -1,
                MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
        }
        offset = offset + 1;
    }
    if typ.kind == MIR_TYPE_KIND_FUNCTION_POINTER {
        const target: &MirType = portable_mir_verify_type_ptr(module, typ.pointee_type_id);
        if target == null || target.kind != MIR_TYPE_KIND_FUNCTION {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
                MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID,
                MIR_VALUE_INVALID_ID, typ.type_id, -1,
                MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
        }
    }
    return 0;
}

fn portable_mir_verify_type(module: &PortableMirModule, typ: &MirType, index: usize, result: &MirVerifierResult) i32 {
    if typ == null || typ.type_id != index as i32 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, index as i32, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if typ.kind != MIR_TYPE_KIND_VOID && (typ.size_bytes == 0usize || typ.align_bytes == 0usize) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if portable_mir_expected_scalar_size_align(typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    const expected_abi_class: i32 = portable_mir_abi_class_for_type_kind(typ.kind);
    if expected_abi_class != 0 && typ.abi_class != expected_abi_class {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if portable_mir_verify_array_slice_layout(module, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if portable_mir_verify_error_union_layout(typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if portable_mir_verify_function_type_layout(module, typ, result) != 0 {
        return -1;
    }
    if portable_mir_verify_aggregate_field_layout(module, typ, result) != 0 {
        return -1;
    }
    if typ.kind == MIR_TYPE_KIND_POINTER && portable_mir_verify_type_ptr(module, typ.pointee_type_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if typ.kind == MIR_TYPE_KIND_ATOMIC && typ.atomic_align_bytes == 0usize {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ATOMIC, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if typ.kind == MIR_TYPE_KIND_VECTOR && (typ.lane_count <= 0 || typ.lane_stride_bytes == 0usize) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_VECTOR_MASK, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if typ.kind == MIR_TYPE_KIND_MASK && (typ.lane_count <= 0 || typ.mask_representation == 0) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_VECTOR_MASK, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if typ.address_space != 0 && portable_mir_verify_address_supported(module, typ.address_space) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ADDRESS, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, typ.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    return 0;
}

fn portable_mir_verify_types(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.types.count {
        const typ: &MirType = semantic_vector_item_ptr(&module.types, i) as &MirType;
        if portable_mir_verify_type(module, typ, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_local(module: &PortableMirModule, local: &MirLocal, index: usize, result: &MirVerifierResult) i32 {
    if local == null || local.local_id != index as i32 ||
       portable_mir_verify_function_ptr(module, local.function_id) == null ||
       portable_mir_verify_type_ptr(module, local.type_id) == null || local.alignment == 0usize {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ADDRESS, local.function_id, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, local.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, local.debug_loc_id);
    }
    if portable_mir_verify_address_supported(module, local.address_space) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ADDRESS, local.function_id, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, local.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, local.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_locals(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.locals.count {
        const local: &MirLocal = semantic_vector_item_ptr(&module.locals, i) as &MirLocal;
        if portable_mir_verify_local(module, local, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_value(module: &PortableMirModule, value: &MirValue, index: usize, result: &MirVerifierResult) i32 {
    if value == null || value.value_id != index as i32 ||
       portable_mir_verify_type_ptr(module, value.type_id) == null ||
       portable_mir_verify_function_ptr(module, value.function_id) == null ||
       portable_mir_verify_block_ptr(module, value.block_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_VALUE, value.function_id, value.block_id, value.defining_inst_id, value.value_id, value.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, value.debug_loc_id);
    }
    if value.defining_inst_id == MIR_INST_INVALID_ID && (value.flags & MIR_VALUE_FLAG_PARAM) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNDEFINED_USE, value.function_id, value.block_id, MIR_INST_INVALID_ID, value.value_id, value.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, value.debug_loc_id);
    }
    if value.defining_inst_id != MIR_INST_INVALID_ID &&
       portable_mir_verify_inst_ptr(module, value.defining_inst_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_VALUE, value.function_id, value.block_id, value.defining_inst_id, value.value_id, value.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, value.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_values(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.values.count {
        const value: &MirValue = semantic_vector_item_ptr(&module.values, i) as &MirValue;
        if portable_mir_verify_value(module, value, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_operand_use(module: &PortableMirModule, inst: &MirInst, operand: &MirOperand,
    result: &MirVerifierResult) i32 {
    if operand == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if operand.value_id != MIR_VALUE_INVALID_ID {
        const value: &MirValue = portable_mir_verify_value_ptr(module, operand.value_id);
        if value == null {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, operand.value_id, operand.type_id, operand.operand_id, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
        }
        if value.block_id != inst.block_id {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNDEFINED_USE, inst.function_id, inst.block_id, inst.inst_id, value.value_id, value.type_id, operand.operand_id, MIR_CAPABILITY_REQ_INVALID_ID, value.debug_loc_id);
        }
        if value.defining_inst_id == MIR_INST_INVALID_ID && (value.flags & MIR_VALUE_FLAG_PARAM) == 0 {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNDEFINED_USE, inst.function_id, inst.block_id, inst.inst_id, value.value_id, value.type_id, operand.operand_id, MIR_CAPABILITY_REQ_INVALID_ID, value.debug_loc_id);
        }
        if value.defining_inst_id != MIR_INST_INVALID_ID && value.defining_inst_id >= inst.inst_id {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNDEFINED_USE, inst.function_id, inst.block_id, inst.inst_id, value.value_id, value.type_id, operand.operand_id, MIR_CAPABILITY_REQ_INVALID_ID, value.debug_loc_id);
        }
    }
    if operand.local_id != MIR_LOCAL_INVALID_ID && (operand.local_id < 0 || (operand.local_id as usize) >= module.locals.count) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, operand.value_id, operand.type_id, operand.operand_id, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if operand.type_id != MIR_TYPE_INVALID_ID && portable_mir_verify_type_ptr(module, operand.type_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, operand.value_id, operand.type_id, operand.operand_id, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_type_kind(module: &PortableMirModule, type_id: MirTypeId,
    expected_kind: i32) i32 {
    const typ: &MirType = portable_mir_verify_type_ptr(module, type_id);
    if typ != null && typ.kind == expected_kind {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_operand_type_kind(module: &PortableMirModule,
    operand: &MirOperand, expected_kind: i32) i32 {
    if operand != null &&
       portable_mir_verify_type_kind(module, operand.type_id, expected_kind) != 0 {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_operand_type_id(module: &PortableMirModule,
    operand: &MirOperand, expected_type_id: MirTypeId) i32 {
    if operand != null && operand.type_id == expected_type_id &&
       portable_mir_verify_type_ptr(module, expected_type_id) != null {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_operand_integer_type(module: &PortableMirModule,
    operand: &MirOperand) i32 {
    if operand == null {
        return 0;
    }
    const typ: &MirType = portable_mir_verify_type_ptr(module, operand.type_id);
    if typ != null && portable_mir_type_kind_is_integer(typ.kind) != 0 {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_address_result_value(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if inst == null || typ == null || typ.kind != MIR_TYPE_KIND_POINTER ||
       inst.result_value_id == MIR_VALUE_INVALID_ID {
        return 0;
    }
    const value: &MirValue = portable_mir_verify_value_ptr(module,
        inst.result_value_id);
    if value == null || value.defining_inst_id != inst.inst_id ||
       value.type_id != inst.type_id || value.local_id != MIR_LOCAL_INVALID_ID ||
       (value.flags & MIR_VALUE_FLAG_ADDRESS) == 0 {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_address_source_lifetime(module: &PortableMirModule,
    inst: &MirInst, source: &MirOperand, pointer_type: &MirType) i32 {
    if module == null || inst == null || source == null || pointer_type == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_ADDR_OF_LOCAL {
        const local: &MirLocal = portable_mir_verify_local_ptr(module,
            source.local_id);
        if local == null || local.function_id != inst.function_id ||
           local.type_id != pointer_type.pointee_type_id ||
           (local.flags & MIR_LOCAL_FLAG_ADDRESS_TAKEN) == 0 ||
           source.value_id != MIR_VALUE_INVALID_ID {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_ADDR_OF_PARAM {
        const value: &MirValue = portable_mir_verify_value_ptr(module,
            source.value_id);
        if value == null || value.function_id != inst.function_id ||
           value.type_id != pointer_type.pointee_type_id ||
           (value.flags & MIR_VALUE_FLAG_PARAM) == 0 ||
           value.param_index < 0 ||
           source.local_id != MIR_LOCAL_INVALID_ID {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_ADDR_OF_GLOBAL {
        if source.immediate_i32 < 0 ||
           source.value_id != MIR_VALUE_INVALID_ID ||
           source.local_id != MIR_LOCAL_INVALID_ID ||
           source.type_id != pointer_type.pointee_type_id {
            return 0;
        }
        return 1;
    }
    return 0;
}

fn portable_mir_verify_address_value_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_address(inst.op) == 0 {
        return 1;
    }
    if inst.op == MIR_INST_OP_FIELD_ADDR || inst.op == MIR_INST_OP_INDEX_ADDR ||
       portable_mir_inst_op_is_slice_place(inst.op) != 0 {
        return 1;
    }
    if inst.operand_count != 1 ||
       portable_mir_verify_address_result_value(module, inst, typ) == 0 {
        return 0;
    }
    const source: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    return portable_mir_verify_address_source_lifetime(module, inst, source, typ);
}

fn portable_mir_verify_field_descriptor(module: &PortableMirModule,
    field_descriptor: &MirOperand) &MirFieldLayout {
    if module == null || field_descriptor == null ||
       field_descriptor.immediate_i32 < 0 ||
       field_descriptor.value_id != MIR_VALUE_INVALID_ID ||
       field_descriptor.local_id != MIR_LOCAL_INVALID_ID {
        return null;
    }
    const owner: &MirType = portable_mir_verify_type_ptr(module,
        field_descriptor.type_id);
    if owner == null ||
       (owner.kind != MIR_TYPE_KIND_STRUCT && owner.kind != MIR_TYPE_KIND_UNION &&
        owner.kind != MIR_TYPE_KIND_ENUM) ||
       field_descriptor.immediate_i32 >= owner.field_count {
        return null;
    }
    const field: &MirFieldLayout = portable_mir_verify_field_layout_ptr(module,
        owner.field_start + field_descriptor.immediate_i32);
    if field == null || field.owner_type_id != owner.type_id ||
       field.field_index != field_descriptor.immediate_i32 ||
       portable_mir_verify_type_ptr(module, field.field_type_id) == null {
        return null;
    }
    return field;
}

fn portable_mir_verify_field_base_operand(module: &PortableMirModule,
    base: &MirOperand, field_descriptor: &MirOperand) i32 {
    if module == null || base == null || field_descriptor == null {
        return 0;
    }
    const pointer_type: &MirType = portable_mir_verify_type_ptr(module,
        base.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER ||
       pointer_type.pointee_type_id != field_descriptor.type_id {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_field_result_or_store(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType, field: &MirFieldLayout) i32 {
    if module == null || inst == null || field == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_FIELD_ADDR {
        if inst.operand_count != 2 ||
           portable_mir_verify_address_result_value(module, inst, typ) == 0 ||
           typ.pointee_type_id != field.field_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_FIELD_LOAD {
        if inst.operand_count != 2 ||
           inst.result_value_id == MIR_VALUE_INVALID_ID ||
           inst.type_id != field.field_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_FIELD_STORE {
        if inst.operand_count != 3 ||
           inst.result_value_id != MIR_VALUE_INVALID_ID ||
           inst.type_id != field.field_type_id {
            return 0;
        }
        const source: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start + 2);
        return portable_mir_verify_operand_type_id(module, source,
            field.field_type_id);
    }
    return 0;
}

fn portable_mir_verify_field_place_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_field_place(inst.op) == 0 {
        return 1;
    }
    if inst.operand_count < 2 {
        return 0;
    }
    const base: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    const field_descriptor: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 1);
    const field: &MirFieldLayout = portable_mir_verify_field_descriptor(module,
        field_descriptor);
    if field == null ||
       portable_mir_verify_field_base_operand(module, base,
        field_descriptor) == 0 {
        return 0;
    }
    return portable_mir_verify_field_result_or_store(module, inst, typ, field);
}

fn portable_mir_verify_index_base_operand(module: &PortableMirModule,
    base: &MirOperand) &MirType {
    if module == null || base == null {
        return null;
    }
    const pointer_type: &MirType = portable_mir_verify_type_ptr(module,
        base.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER {
        return null;
    }
    const array_type: &MirType = portable_mir_verify_type_ptr(module,
        pointer_type.pointee_type_id);
    if array_type == null || array_type.kind != MIR_TYPE_KIND_ARRAY ||
       portable_mir_verify_type_ptr(module, array_type.element_type_id) == null ||
       array_type.field_count <= 0 {
        return null;
    }
    return array_type;
}

fn portable_mir_verify_index_operand_bounds(module: &PortableMirModule,
    inst: &MirInst, index_operand: &MirOperand, array_type: &MirType) i32 {
    if module == null || inst == null || index_operand == null ||
       array_type == null {
        return 0;
    }
    if portable_mir_verify_operand_integer_type(module, index_operand) == 0 {
        return 0;
    }
    if index_operand.value_id != MIR_VALUE_INVALID_ID ||
       index_operand.local_id != MIR_LOCAL_INVALID_ID {
        if (inst.flags & MIR_INST_FLAG_BOUNDS_CHECKED) != 0 {
            return 1;
        }
        return 0;
    }
    if index_operand.immediate_i32 >= 0 &&
       index_operand.immediate_i32 < array_type.field_count {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_index_result_or_store(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType, array_type: &MirType) i32 {
    if module == null || inst == null || array_type == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_INDEX_ADDR {
        if inst.operand_count != 2 ||
           portable_mir_verify_address_result_value(module, inst, typ) == 0 ||
           typ.pointee_type_id != array_type.element_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_INDEX_LOAD {
        if inst.operand_count != 2 ||
           inst.result_value_id == MIR_VALUE_INVALID_ID ||
           inst.type_id != array_type.element_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_INDEX_STORE {
        if inst.operand_count != 3 ||
           inst.result_value_id != MIR_VALUE_INVALID_ID ||
           inst.type_id != array_type.element_type_id {
            return 0;
        }
        const source: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start + 2);
        return portable_mir_verify_operand_type_id(module, source,
            array_type.element_type_id);
    }
    return 0;
}

fn portable_mir_verify_index_place_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_index_place(inst.op) == 0 {
        return 1;
    }
    if inst.operand_count < 2 {
        return 0;
    }
    const base: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    const index_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 1);
    const array_type: &MirType = portable_mir_verify_index_base_operand(module,
        base);
    if array_type == null ||
       portable_mir_verify_index_operand_bounds(module, inst, index_operand,
        array_type) == 0 {
        return 0;
    }
    return portable_mir_verify_index_result_or_store(module, inst, typ,
        array_type);
}

fn portable_mir_verify_slice_base_operand(module: &PortableMirModule,
    base: &MirOperand) &MirType {
    if module == null || base == null {
        return null;
    }
    const pointer_type: &MirType = portable_mir_verify_type_ptr(module,
        base.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER {
        return null;
    }
    const slice_type: &MirType = portable_mir_verify_type_ptr(module,
        pointer_type.pointee_type_id);
    if slice_type == null || slice_type.kind != MIR_TYPE_KIND_SLICE ||
       portable_mir_verify_type_ptr(module, slice_type.element_type_id) == null ||
       portable_mir_verify_type_ptr(module, slice_type.pointee_type_id) == null {
        return null;
    }
    return slice_type;
}

fn portable_mir_verify_slice_index_bounds(module: &PortableMirModule,
    inst: &MirInst, index_operand: &MirOperand) i32 {
    if module == null || inst == null || index_operand == null {
        return 0;
    }
    if portable_mir_verify_operand_integer_type(module, index_operand) == 0 {
        return 0;
    }
    if (inst.flags & MIR_INST_FLAG_BOUNDS_CHECKED) != 0 {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_pointer_to_type_kind(module: &PortableMirModule,
    typ: &MirType, expected_kind: i32) i32 {
    if module == null || typ == null || typ.kind != MIR_TYPE_KIND_POINTER {
        return 0;
    }
    const pointee: &MirType = portable_mir_verify_type_ptr(module,
        typ.pointee_type_id);
    if pointee != null && pointee.kind == expected_kind {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_slice_result_or_store(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType, slice_type: &MirType) i32 {
    if module == null || inst == null || slice_type == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_SLICE_PTR_ADDR {
        if inst.operand_count != 1 ||
           portable_mir_verify_address_result_value(module, inst, typ) == 0 ||
           typ.pointee_type_id != slice_type.pointee_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_SLICE_PTR_LOAD {
        if inst.operand_count != 1 ||
           inst.result_value_id == MIR_VALUE_INVALID_ID ||
           inst.type_id != slice_type.pointee_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_SLICE_LEN_ADDR {
        if inst.operand_count != 1 ||
           portable_mir_verify_address_result_value(module, inst, typ) == 0 ||
           portable_mir_verify_pointer_to_type_kind(module, typ,
            MIR_TYPE_KIND_USIZE) == 0 {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_SLICE_LEN_LOAD {
        if inst.operand_count != 1 ||
           inst.result_value_id == MIR_VALUE_INVALID_ID ||
           typ == null || typ.kind != MIR_TYPE_KIND_USIZE {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_SLICE_INDEX_ADDR {
        if inst.operand_count != 2 ||
           portable_mir_verify_address_result_value(module, inst, typ) == 0 ||
           typ.pointee_type_id != slice_type.element_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_SLICE_INDEX_LOAD {
        if inst.operand_count != 2 ||
           inst.result_value_id == MIR_VALUE_INVALID_ID ||
           inst.type_id != slice_type.element_type_id {
            return 0;
        }
        return 1;
    }
    if inst.op == MIR_INST_OP_SLICE_INDEX_STORE {
        if inst.operand_count != 3 ||
           inst.result_value_id != MIR_VALUE_INVALID_ID ||
           inst.type_id != slice_type.element_type_id {
            return 0;
        }
        const source: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start + 2);
        return portable_mir_verify_operand_type_id(module, source,
            slice_type.element_type_id);
    }
    return 0;
}

fn portable_mir_verify_slice_place_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_slice_place(inst.op) == 0 {
        return 1;
    }
    if inst.operand_count < 1 {
        return 0;
    }
    const base: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    const slice_type: &MirType = portable_mir_verify_slice_base_operand(module,
        base);
    if slice_type == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_SLICE_INDEX_ADDR ||
       inst.op == MIR_INST_OP_SLICE_INDEX_LOAD ||
       inst.op == MIR_INST_OP_SLICE_INDEX_STORE {
        const index_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start + 1);
        if portable_mir_verify_slice_index_bounds(module, inst,
            index_operand) == 0 {
            return 0;
        }
    }
    return portable_mir_verify_slice_result_or_store(module, inst, typ,
        slice_type);
}

fn portable_mir_verify_pointer_offset_base(module: &PortableMirModule,
    base: &MirOperand, pointer_type: &MirType) i32 {
    if module == null || base == null || pointer_type == null ||
       pointer_type.kind != MIR_TYPE_KIND_POINTER {
        return 0;
    }
    const base_type: &MirType = portable_mir_verify_type_ptr(module,
        base.type_id);
    const pointee: &MirType = portable_mir_verify_type_ptr(module,
        pointer_type.pointee_type_id);
    if base_type == null || base_type.kind != MIR_TYPE_KIND_POINTER ||
       base_type.type_id != pointer_type.type_id ||
       pointee == null || pointee.size_bytes == 0usize {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_pointer_offset_amount(module: &PortableMirModule,
    inst: &MirInst, offset: &MirOperand) i32 {
    if module == null || inst == null || offset == null {
        return 0;
    }
    if portable_mir_verify_operand_integer_type(module, offset) == 0 {
        return 0;
    }
    if (inst.flags & MIR_INST_FLAG_OVERFLOW_CHECKED) == 0 {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_pointer_offset_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_pointer_offset(inst.op) == 0 {
        return 1;
    }
    if inst.operand_count != 2 ||
       portable_mir_verify_address_result_value(module, inst, typ) == 0 {
        return 0;
    }
    const base: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    const offset: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 1);
    if portable_mir_verify_pointer_offset_base(module, base, typ) == 0 {
        return 0;
    }
    return portable_mir_verify_pointer_offset_amount(module, inst, offset);
}

fn portable_mir_verify_aggregate_copy_move_layout(typ: &MirType) i32 {
    if typ == null || typ.size_bytes == 0usize || typ.align_bytes == 0usize {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_STRUCT || typ.kind == MIR_TYPE_KIND_ARRAY ||
       typ.kind == MIR_TYPE_KIND_UNION || typ.kind == MIR_TYPE_KIND_ENUM ||
       typ.kind == MIR_TYPE_KIND_ERROR_UNION {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_aggregate_copy_move_operand(module: &PortableMirModule,
    operand: &MirOperand, typ: &MirType) i32 {
    if module == null || operand == null || typ == null {
        return 0;
    }
    const pointer_type: &MirType = portable_mir_verify_type_ptr(module,
        operand.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER ||
       pointer_type.pointee_type_id != typ.type_id {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_aggregate_copy_move_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_aggregate_copy_move(inst.op) == 0 {
        return 1;
    }
    if inst.operand_count != 2 ||
       inst.result_value_id != MIR_VALUE_INVALID_ID ||
       (inst.flags & MIR_INST_FLAG_NO_OVERLAP) == 0 ||
       portable_mir_verify_aggregate_copy_move_layout(typ) == 0 {
        return 0;
    }
    const dest: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    const source: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 1);
    if portable_mir_verify_aggregate_copy_move_operand(module, dest, typ) == 0 {
        return 0;
    }
    return portable_mir_verify_aggregate_copy_move_operand(module, source, typ);
}

fn portable_mir_verify_conversion_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_conversion(inst.op) == 0 {
        return 1;
    }
    if inst.operand_count != 1 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
       typ == null {
        return 0;
    }
    const operand: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
    if operand == null {
        return 0;
    }
    const operand_type: &MirType = portable_mir_verify_type_ptr(module, operand.type_id);
    if operand_type == null {
        return 0;
    }
    if (inst.op == MIR_INST_OP_SIGN_EXTEND || inst.op == MIR_INST_OP_ZERO_EXTEND) &&
       portable_mir_type_kind_is_integer(typ.kind) != 0 &&
       portable_mir_type_kind_is_integer(operand_type.kind) != 0 &&
       typ.size_bytes > operand_type.size_bytes {
        return 1;
    }
    if inst.op == MIR_INST_OP_TRUNCATE &&
       portable_mir_type_kind_is_integer(typ.kind) != 0 &&
       portable_mir_type_kind_is_integer(operand_type.kind) != 0 &&
       typ.size_bytes < operand_type.size_bytes {
        return 1;
    }
    if (inst.op == MIR_INST_OP_INT_TO_F32 || inst.op == MIR_INST_OP_INT_TO_F64) &&
       portable_mir_type_kind_is_float(typ.kind) != 0 &&
       portable_mir_type_kind_is_integer(operand_type.kind) != 0 {
        return 1;
    }
    if (inst.op == MIR_INST_OP_F32_TO_INT || inst.op == MIR_INST_OP_F64_TO_INT) &&
       portable_mir_type_kind_is_integer(typ.kind) != 0 &&
       portable_mir_type_kind_is_float(operand_type.kind) != 0 {
        return 1;
    }
    if inst.op == MIR_INST_OP_F32_TO_F64 &&
       typ.kind == MIR_TYPE_KIND_F64 &&
       operand_type.kind == MIR_TYPE_KIND_F32 {
        return 1;
    }
    if inst.op == MIR_INST_OP_F64_TO_F32 &&
       typ.kind == MIR_TYPE_KIND_F32 &&
       operand_type.kind == MIR_TYPE_KIND_F64 {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_integer_arith_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if inst.operand_count != 2 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
       typ == null || portable_mir_type_kind_is_integer(typ.kind) == 0 {
        return 0;
    }
    const lhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
    const rhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start + 1);
    if portable_mir_verify_operand_type_id(module, lhs, inst.type_id) == 0 ||
       portable_mir_verify_operand_type_id(module, rhs, inst.type_id) == 0 {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_integer_compare_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if inst.operand_count != 2 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
       typ == null || typ.kind != MIR_TYPE_KIND_BOOL {
        return 0;
    }
    const lhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
    const rhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start + 1);
    if lhs == null || rhs == null || lhs.type_id != rhs.type_id ||
       portable_mir_verify_operand_integer_type(module, lhs) == 0 ||
       portable_mir_verify_operand_integer_type(module, rhs) == 0 {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_integer_unary_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if inst.operand_count != 1 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
       typ == null || portable_mir_type_kind_is_integer(typ.kind) == 0 {
        return 0;
    }
    const operand: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
    return portable_mir_verify_operand_type_id(module, operand, inst.type_id);
}

fn portable_mir_verify_logic_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if inst.result_value_id == MIR_VALUE_INVALID_ID ||
       typ == null || typ.kind != MIR_TYPE_KIND_BOOL {
        return 0;
    }
    if inst.op == MIR_INST_OP_BOOL_NOT {
        if inst.operand_count != 1 {
            return 0;
        }
        const operand: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start);
        return portable_mir_verify_operand_type_kind(module, operand,
            MIR_TYPE_KIND_BOOL);
    }
    if inst.operand_count != 2 {
        return 0;
    }
    const lhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
    const rhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start + 1);
    if portable_mir_verify_operand_type_kind(module, lhs, MIR_TYPE_KIND_BOOL) == 0 ||
       portable_mir_verify_operand_type_kind(module, rhs, MIR_TYPE_KIND_BOOL) == 0 {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_integer_value_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_integer_arithmetic(inst.op) != 0 {
        return portable_mir_verify_integer_arith_inst(module, inst, typ);
    }
    if portable_mir_inst_op_is_integer_compare(inst.op) != 0 {
        return portable_mir_verify_integer_compare_inst(module, inst, typ);
    }
    if portable_mir_inst_op_is_integer_unary(inst.op) != 0 {
        return portable_mir_verify_integer_unary_inst(module, inst, typ);
    }
    if portable_mir_inst_op_is_logic(inst.op) != 0 {
        return portable_mir_verify_logic_inst(module, inst, typ);
    }
    if portable_mir_inst_op_is_conversion(inst.op) != 0 {
        return portable_mir_verify_conversion_inst(module, inst, typ);
    }
    return 1;
}

fn portable_mir_verify_float_value_inst(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType) i32 {
    if portable_mir_inst_op_is_float_arithmetic(inst.op) != 0 {
        if inst.operand_count != 2 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
           typ == null || portable_mir_type_kind_is_float(typ.kind) == 0 {
            return 0;
        }
        const lhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
        const rhs: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start + 1);
        if portable_mir_verify_operand_type_id(module, lhs, inst.type_id) == 0 ||
           portable_mir_verify_operand_type_id(module, rhs, inst.type_id) == 0 {
            return 0;
        }
        return 1;
    }
    if portable_mir_inst_op_is_float_compare(inst.op) != 0 {
        if inst.operand_count != 2 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
           typ == null || typ.kind != MIR_TYPE_KIND_BOOL {
            return 0;
        }
        const lhs_cmp: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start);
        const rhs_cmp: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start + 1);
        if lhs_cmp == null || rhs_cmp == null || lhs_cmp.type_id != rhs_cmp.type_id {
            return 0;
        }
        const operand_type: &MirType = portable_mir_verify_type_ptr(module, lhs_cmp.type_id);
        if operand_type == null || portable_mir_type_kind_is_float(operand_type.kind) == 0 {
            return 0;
        }
        return 1;
    }
    if portable_mir_inst_op_is_float_constant(inst.op) != 0 {
        if inst.operand_count != 0 || inst.result_value_id == MIR_VALUE_INVALID_ID ||
           typ == null || portable_mir_type_kind_is_float(typ.kind) == 0 {
            return 0;
        }
        return 1;
    }
    return 1;
}

fn portable_mir_verify_print_helper_callee(module: &PortableMirModule,
    inst: &MirInst, result: &MirVerifierResult) i32 {
    const call_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    if call_operand == null ||
       call_operand.value_id != MIR_VALUE_INVALID_ID ||
       portable_mir_verify_operand_type_kind(module, call_operand,
        MIR_TYPE_KIND_VOID) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, inst.operand_start, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    const callee: &MirFunction = portable_mir_verify_function_ptr(module,
        call_operand.immediate_i32);
    if callee == null || callee.decl_id != inst.flags ||
       (callee.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 ||
       (callee.flags & MIR_FUNCTION_FLAG_NAKED) != 0 ||
       callee.calling_convention != MIR_CALL_CONV_C {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_FUNCTION,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, inst.operand_start, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_print_helper_args(module: &PortableMirModule,
    inst: &MirInst, result: &MirVerifierResult) i32 {
    if inst.flags == MIR_EXTERN_HOSTED_HELPER_UYA_WRITE_NEWLINE {
        if inst.operand_count != 2 {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND,
                inst.function_id, inst.block_id, inst.inst_id,
                inst.result_value_id, inst.type_id, inst.operand_start,
                MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
        }
        const fd_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start + 1);
        if portable_mir_verify_operand_type_kind(module, fd_operand,
            MIR_TYPE_KIND_I32) == 0 {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH,
                inst.function_id, inst.block_id, inst.inst_id,
                inst.result_value_id, inst.type_id, inst.operand_start + 1,
                MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
        }
        return 0;
    }
    if inst.operand_count != 4 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, inst.operand_start, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    const fd_operand2: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 1);
    const ptr_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 2);
    const len_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 3);
    if portable_mir_verify_operand_type_kind(module, fd_operand2,
        MIR_TYPE_KIND_I32) == 0 ||
       portable_mir_verify_operand_type_kind(module, ptr_operand,
        MIR_TYPE_KIND_POINTER) == 0 ||
       portable_mir_verify_operand_type_kind(module, len_operand,
        MIR_TYPE_KIND_I32) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, inst.operand_start, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_print_helper_call_abi(module: &PortableMirModule,
    inst: &MirInst, typ: &MirType, result: &MirVerifierResult) i32 {
    if inst.flags != MIR_EXTERN_HOSTED_HELPER_UYA_WRITE &&
       inst.flags != MIR_EXTERN_HOSTED_HELPER_UYA_WRITE_STR &&
       inst.flags != MIR_EXTERN_HOSTED_HELPER_UYA_WRITE_NEWLINE {
        return 0;
    }
    if inst.op != MIR_INST_OP_CALL || inst.result_value_id == MIR_VALUE_INVALID_ID ||
       typ == null || typ.kind != MIR_TYPE_KIND_I32 ||
       inst.calling_convention != MIR_CALL_CONV_C ||
       (inst.runtime_capability_mask & MIR_RUNTIME_CAP_C_EXTERN) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_print_helper_callee(module, inst, result) != 0 {
        return -1;
    }
    return portable_mir_verify_print_helper_args(module, inst, result);
}

fn portable_mir_verify_direct_call_target(module: &PortableMirModule,
    target: &MirOperand) i32 {
    if module == null || target == null ||
       target.kind != MIR_OPERAND_KIND_CALL_TARGET_DIRECT ||
       target.value_id != MIR_VALUE_INVALID_ID {
        return 0;
    }
    const callee: &MirFunction = portable_mir_verify_function_ptr(module,
        target.immediate_i32);
    if callee == null || (callee.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 ||
       callee.calling_convention != MIR_CALL_CONV_UYA {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_extern_call_target(module: &PortableMirModule,
    target: &MirOperand) i32 {
    if module == null || target == null ||
       target.kind != MIR_OPERAND_KIND_CALL_TARGET_EXTERN ||
       target.value_id != MIR_VALUE_INVALID_ID {
        return 0;
    }
    const callee: &MirFunction = portable_mir_verify_function_ptr(module,
        target.immediate_i32);
    if callee == null || (callee.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 ||
       callee.calling_convention != MIR_CALL_CONV_C {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_method_instance_call_target(module: &PortableMirModule,
    target: &MirOperand) i32 {
    if module == null || target == null ||
       target.kind != MIR_OPERAND_KIND_CALL_TARGET_METHOD_INSTANCE ||
       target.value_id != MIR_VALUE_INVALID_ID ||
       target.flags < 0 {
        return 0;
    }
    const callee: &MirFunction = portable_mir_verify_function_ptr(module,
        target.immediate_i32);
    if callee == null || (callee.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 ||
       callee.calling_convention != MIR_CALL_CONV_UYA {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_function_pointer_call_target(module: &PortableMirModule,
    target: &MirOperand) i32 {
    if module == null || target == null ||
       target.kind != MIR_OPERAND_KIND_CALL_TARGET_FUNCTION_POINTER ||
       target.value_id == MIR_VALUE_INVALID_ID {
        return 0;
    }
    const typ: &MirType = portable_mir_verify_type_ptr(module,
        target.type_id);
    if typ == null || typ.kind != MIR_TYPE_KIND_FUNCTION_POINTER {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_call_target_operand(module: &PortableMirModule,
    inst: &MirInst, result: &MirVerifierResult) i32 {
    if inst.op != MIR_INST_OP_CALL || inst.operand_count <= 0 {
        return 0;
    }
    const target: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    if target == null ||
       portable_mir_operand_kind_is_call_target(target.kind) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, inst.operand_start, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    if portable_mir_verify_direct_call_target(module, target) != 0 ||
       portable_mir_verify_extern_call_target(module, target) != 0 ||
       portable_mir_verify_method_instance_call_target(module, target) != 0 ||
       portable_mir_verify_function_pointer_call_target(module, target) != 0 {
        return 0;
    }
    return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_FUNCTION,
        inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
        inst.type_id, inst.operand_start, MIR_CAPABILITY_REQ_INVALID_ID,
        inst.debug_loc_id);
}

fn portable_mir_verify_function_return_type(module: &PortableMirModule,
    function: &MirFunction) MirTypeId {
    if function == null {
        return MIR_TYPE_INVALID_ID;
    }
    const signature: &MirType = portable_mir_verify_type_ptr(module,
        function.signature_type_id);
    if signature == null || signature.kind != MIR_TYPE_KIND_FUNCTION {
        return MIR_TYPE_INVALID_ID;
    }
    return signature.element_type_id;
}

fn portable_mir_verify_call_signature_type(module: &PortableMirModule,
    inst: &MirInst) &MirType {
    if inst == null || inst.op != MIR_INST_OP_CALL || inst.operand_count <= 0 {
        return null;
    }
    const callee_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    if callee_operand == null {
        return null;
    }
    if callee_operand.kind == MIR_OPERAND_KIND_CALL_TARGET_FUNCTION_POINTER {
        const function_pointer_type: &MirType = portable_mir_verify_type_ptr(module,
            callee_operand.type_id);
        if function_pointer_type == null ||
           function_pointer_type.kind != MIR_TYPE_KIND_FUNCTION_POINTER {
            return null;
        }
        const pointee_type: &MirType = portable_mir_verify_type_ptr(module,
            function_pointer_type.pointee_type_id);
        if pointee_type == null || pointee_type.kind != MIR_TYPE_KIND_FUNCTION {
            return null;
        }
        return pointee_type;
    }
    if callee_operand.value_id != MIR_VALUE_INVALID_ID {
        return null;
    }
    const callee: &MirFunction = portable_mir_verify_function_ptr(module,
        callee_operand.immediate_i32);
    if callee == null {
        return null;
    }
    const signature: &MirType = portable_mir_verify_type_ptr(module,
        callee.signature_type_id);
    if signature == null || signature.kind != MIR_TYPE_KIND_FUNCTION {
        return null;
    }
    return signature;
}

fn portable_mir_verify_call_out_param_writeback(module: &PortableMirModule,
    inst: &MirInst, expected_flags: i32) i32 {
    if (expected_flags & MIR_CALL_FLAG_OUT_PARAM_WRITEBACK) == 0 {
        return 1;
    }
    if inst.operand_count < 2 {
        return 0;
    }
    const out_param: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start + 1);
    if out_param == null {
        return 0;
    }
    const out_param_type: &MirType = portable_mir_verify_type_ptr(module,
        out_param.type_id);
    if out_param_type == null || out_param_type.kind != MIR_TYPE_KIND_POINTER ||
       (out_param.flags & MIR_CALL_FLAG_OUT_PARAM_WRITEBACK) == 0 {
        return 0;
    }
    return 1;
}

fn portable_mir_verify_call_abi_metadata(module: &PortableMirModule,
    inst: &MirInst, result: &MirVerifierResult) i32 {
    if inst.op != MIR_INST_OP_CALL || inst.flags < 0 {
        return 0;
    }
    const signature: &MirType = portable_mir_verify_call_signature_type(module, inst);
    if signature == null {
        return 0;
    }
    const return_type: &MirType = portable_mir_verify_type_ptr(module,
        signature.element_type_id);
    if return_type == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            signature.element_type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    const expected_flags: i32 = portable_mir_call_flag_for_param_count(
        signature.field_count) + portable_mir_call_flag_for_return_type(return_type.kind);
    if expected_flags != 0 && (inst.flags & expected_flags) != expected_flags {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_call_out_param_writeback(module, inst, expected_flags) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            inst.type_id, inst.operand_start + 1, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    if (expected_flags & MIR_CALL_FLAG_FLOAT_ABI) != 0 &&
       return_type.abi_class != MIR_ABI_CLASS_FLOAT &&
       return_type.abi_class != MIR_ABI_CLASS_DOUBLE {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT,
            inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id,
            return_type.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID,
            inst.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_call_result_signature(module: &PortableMirModule,
    inst: &MirInst) i32 {
    if inst.op != MIR_INST_OP_CALL || inst.result_value_id == MIR_VALUE_INVALID_ID ||
       inst.operand_count <= 0 {
        return 1;
    }
    const callee_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
        inst.operand_start);
    if callee_operand == null || callee_operand.value_id != MIR_VALUE_INVALID_ID {
        return 1;
    }
    const callee: &MirFunction = portable_mir_verify_function_ptr(module,
        callee_operand.immediate_i32);
    const return_type_id: MirTypeId = portable_mir_verify_function_return_type(module,
        callee);
    if return_type_id == MIR_TYPE_INVALID_ID {
        return 1;
    }
    if return_type_id == inst.type_id {
        return 1;
    }
    return 0;
}

fn portable_mir_verify_inst_shape(module: &PortableMirModule, inst: &MirInst, result: &MirVerifierResult) i32 {
    const typ: &MirType = portable_mir_verify_type_ptr(module, inst.type_id);
    if inst.op == MIR_INST_OP_LOAD && (inst.operand_count <= 0 || inst.result_value_id == MIR_VALUE_INVALID_ID) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op == MIR_INST_OP_STORE && inst.operand_count < 2 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_integer_value_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_float_value_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_address_value_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ADDRESS, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_field_place_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_index_place_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_slice_place_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_pointer_offset_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ADDRESS, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_aggregate_copy_move_inst(module, inst, typ) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_LAYOUT, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op == MIR_INST_OP_LOCAL_SET &&
       (inst.operand_count != 2 || inst.result_value_id != MIR_VALUE_INVALID_ID ||
        typ == null || typ.kind == MIR_TYPE_KIND_VOID) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op == MIR_INST_OP_LOCAL_SET {
        const dest_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start);
        const source_operand: &MirOperand = portable_mir_verify_operand_ptr(module,
            inst.operand_start + 1);
        if dest_operand == null || dest_operand.local_id == MIR_LOCAL_INVALID_ID ||
           dest_operand.value_id != MIR_VALUE_INVALID_ID ||
           source_operand == null ||
           (source_operand.value_id == MIR_VALUE_INVALID_ID &&
            source_operand.local_id == MIR_LOCAL_INVALID_ID) {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
        }
    }
    if (inst.op == MIR_INST_OP_LOAD || inst.op == MIR_INST_OP_STORE ||
        portable_mir_inst_op_is_address(inst.op) != 0) &&
       portable_mir_verify_address_supported(module, inst.address_space) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ADDRESS, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op >= MIR_VERIFY_ATOMIC_OP_MIN && inst.op <= MIR_VERIFY_ATOMIC_OP_MAX &&
       (typ == null || typ.kind != MIR_TYPE_KIND_ATOMIC) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_ATOMIC, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op >= MIR_VERIFY_VECTOR_OP_MIN && inst.op <= MIR_VERIFY_VECTOR_OP_MAX &&
       (typ == null || (typ.kind != MIR_TYPE_KIND_VECTOR && typ.kind != MIR_TYPE_KIND_MASK)) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_VECTOR_MASK, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op == MIR_INST_OP_CALL && portable_mir_verify_call_abi_supported(module, inst.calling_convention) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.op == MIR_INST_OP_CALL &&
       portable_mir_verify_print_helper_call_abi(module, inst, typ, result) != 0 {
        return -1;
    }
    if inst.op == MIR_INST_OP_CALL &&
       portable_mir_verify_call_target_operand(module, inst, result) != 0 {
        return -1;
    }
    if inst.op == MIR_INST_OP_CALL &&
       portable_mir_verify_call_abi_metadata(module, inst, result) != 0 {
        return -1;
    }
    if portable_mir_verify_call_result_signature(module, inst) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if portable_mir_verify_runtime_capability_supported(module, inst.runtime_capability_mask) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_inst(module: &PortableMirModule, inst: &MirInst, index: usize, result: &MirVerifierResult) i32 {
    if inst == null || inst.inst_id != index as i32 ||
       portable_mir_verify_function_ptr(module, inst.function_id) == null ||
       portable_mir_verify_block_ptr(module, inst.block_id) == null ||
       portable_mir_verify_type_ptr(module, inst.type_id) == null ||
       portable_mir_verify_range(inst.operand_start, inst.operand_count, module.operands.count) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_OPERAND, inst.function_id, inst.block_id, index as i32, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
    }
    if inst.result_value_id != MIR_VALUE_INVALID_ID {
        const result_value: &MirValue = portable_mir_verify_value_ptr(module, inst.result_value_id);
        if result_value == null || result_value.type_id != inst.type_id {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH, inst.function_id, inst.block_id, inst.inst_id, inst.result_value_id, inst.type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, inst.debug_loc_id);
        }
    }
    if portable_mir_verify_inst_shape(module, inst, result) != 0 { return -1; }
    var offset: i32 = 0;
    while offset < inst.operand_count {
        const operand: &MirOperand = portable_mir_verify_operand_ptr(module, inst.operand_start + offset);
        if portable_mir_verify_operand_use(module, inst, operand, result) != 0 { return -1; }
        offset = offset + 1;
    }
    return 0;
}

fn portable_mir_verify_insts(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = semantic_vector_item_ptr(&module.insts, i) as &MirInst;
        if portable_mir_verify_inst(module, inst, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_terminator(module: &PortableMirModule, term: &MirTerminator, index: usize,
    result: &MirVerifierResult) i32 {
    if term == null || term.terminator_id != index as i32 ||
       portable_mir_verify_function_ptr(module, term.function_id) == null ||
       portable_mir_verify_block_ptr(module, term.block_id) == null ||
       portable_mir_verify_range(term.operand_start, term.operand_count, module.operands.count) == 0 ||
       portable_mir_verify_range(term.successor_start, term.successor_count, module.successors.count) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_MISSING_TERMINATOR, term.function_id, term.block_id, index as i32, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, MIR_CAPABILITY_REQ_INVALID_ID, term.debug_loc_id);
    }
    if term.kind == MIR_TERMINATOR_KIND_RETURN && term.operand_count > 0 {
        const function: &MirFunction = portable_mir_verify_function_ptr(module,
            term.function_id);
        const return_type_id: MirTypeId = portable_mir_verify_function_return_type(module,
            function);
        if return_type_id != MIR_TYPE_INVALID_ID {
            const operand: &MirOperand = portable_mir_verify_operand_ptr(module,
                term.operand_start);
            if operand == null || operand.type_id != return_type_id {
                var value_id: MirValueId = MIR_VALUE_INVALID_ID;
                if operand != null {
                    value_id = operand.value_id;
                }
                return portable_mir_verify_fail(result, MIR_VERIFY_ERR_TYPE_MISMATCH,
                    term.function_id, term.block_id, MIR_INST_INVALID_ID,
                    value_id, return_type_id, term.operand_start,
                    MIR_CAPABILITY_REQ_INVALID_ID, term.debug_loc_id);
            }
        }
    }
    return 0;
}

fn portable_mir_verify_terminators(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.terminators.count {
        const term: &MirTerminator = semantic_vector_item_ptr(&module.terminators, i) as &MirTerminator;
        if portable_mir_verify_terminator(module, term, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_block(module: &PortableMirModule, block: &MirBlock, index: usize, result: &MirVerifierResult) i32 {
    if block == null || block.block_id != index as i32 ||
       portable_mir_verify_function_ptr(module, block.function_id) == null ||
       portable_mir_verify_range(block.inst_start, block.inst_count, module.insts.count) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_BLOCK, block.function_id, index as i32, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, MIR_CAPABILITY_REQ_INVALID_ID, block.debug_loc_id);
    }
    if block.terminator_id == MIR_TERMINATOR_INVALID_ID ||
       portable_mir_verify_terminator_ptr(module, block.terminator_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_MISSING_TERMINATOR, block.function_id, block.block_id, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, MIR_CAPABILITY_REQ_INVALID_ID, block.debug_loc_id);
    }
    const function: &MirFunction = portable_mir_verify_function_ptr(module, block.function_id);
    if (block.flags & MIR_BLOCK_FLAG_CLEANUP) != 0 && (function == null || function.cleanup_model == 0) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_CLEANUP, block.function_id, block.block_id, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, MIR_CAPABILITY_REQ_INVALID_ID, block.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_blocks(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.blocks.count {
        const block: &MirBlock = semantic_vector_item_ptr(&module.blocks, i) as &MirBlock;
        if portable_mir_verify_block(module, block, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_capability(module: &PortableMirModule, cap: &MirCapabilityReq, index: usize,
    result: &MirVerifierResult) i32 {
    if cap == null || cap.capability_req_id != index as i32 ||
       portable_mir_verify_function_ptr(module, cap.function_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY, cap.function_id, MIR_BLOCK_INVALID_ID, cap.inst_id, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, index as i32, cap.debug_loc_id);
    }
    if cap.inst_id != MIR_INST_INVALID_ID && portable_mir_verify_inst_ptr(module, cap.inst_id) == null {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY, cap.function_id, MIR_BLOCK_INVALID_ID, cap.inst_id, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, index as i32, cap.debug_loc_id);
    }
    if portable_mir_verify_runtime_capability_supported(module, cap.capability_id) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY, cap.function_id, MIR_BLOCK_INVALID_ID, cap.inst_id, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, index as i32, cap.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_capabilities(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.capability_reqs.count {
        const cap: &MirCapabilityReq = semantic_vector_item_ptr(&module.capability_reqs, i) as &MirCapabilityReq;
        if portable_mir_verify_capability(module, cap, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

fn portable_mir_verify_function_has_cleanup_block(module: &PortableMirModule, function: &MirFunction) i32 {
    var offset: i32 = 0;
    while offset < function.block_count {
        const block: &MirBlock = portable_mir_verify_block_ptr(module, function.block_start + offset);
        if block != null && (block.flags & MIR_BLOCK_FLAG_CLEANUP) != 0 {
            return 1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn portable_mir_verify_function(module: &PortableMirModule, function: &MirFunction, index: usize,
    result: &MirVerifierResult) i32 {
    if function == null || function.function_id != index as i32 ||
       portable_mir_verify_type_ptr(module, function.signature_type_id) == null ||
       portable_mir_verify_range(function.local_start, function.local_count, module.locals.count) == 0 ||
       portable_mir_verify_range(function.block_start, function.block_count, module.blocks.count) == 0 ||
       portable_mir_verify_range(function.capability_req_start, function.capability_req_count, module.capability_reqs.count) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_FUNCTION, index as i32, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, function.signature_type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, function.debug_loc_id);
    }
    if portable_mir_verify_call_abi_supported(module, function.calling_convention) == 0 ||
       portable_mir_verify_runtime_capability_supported(module, function.runtime_capability_mask) == 0 ||
       portable_mir_verify_has_mask(module.target_profile.supported_address_spaces, function.required_address_space_mask) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_UNSUPPORTED_TARGET_CAPABILITY, function.function_id, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, function.signature_type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, function.debug_loc_id);
    }
    if portable_mir_function_has_naked_flag(function) != 0 {
        if portable_mir_function_has_asm_only_naked_body(function) == 0 {
            return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_NAKED_BODY, function.function_id, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, function.signature_type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, function.debug_loc_id);
        }
        return 0;
    }
    if (function.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 &&
       (function.body_kind != MIR_FUNCTION_BODY_KIND_NORMAL || function.entry_block_id == MIR_BLOCK_INVALID_ID ||
        portable_mir_verify_block_ptr(module, function.entry_block_id) == null) {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_FUNCTION, function.function_id, function.entry_block_id, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, function.signature_type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, function.debug_loc_id);
    }
    if function.cleanup_model != 0 && portable_mir_verify_function_has_cleanup_block(module, function) == 0 {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_CLEANUP, function.function_id, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, function.signature_type_id, -1, MIR_CAPABILITY_REQ_INVALID_ID, function.debug_loc_id);
    }
    return 0;
}

fn portable_mir_verify_functions(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    var i: usize = 0usize;
    while i < module.functions.count {
        const function: &MirFunction = semantic_vector_item_ptr(&module.functions, i) as &MirFunction;
        if portable_mir_verify_function(module, function, i, result) != 0 { return -1; }
        i = i + 1usize;
    }
    return 0;
}

/// 功能说明：线性验证 PortableMIR module 是否满足 backend 入口合同。
/// 参数说明：`module` 为待验证 MIR module，`result` 接收首个稳定 diagnostic。
/// 返回值说明：验证通过返回 `0`，失败返回 `-1` 并填充 `result.error_code`。
export fn portable_mir_verify_module(module: &PortableMirModule, result: &MirVerifierResult) i32 {
    if result != null {
        portable_mir_verifier_result_init(result);
    }
    if module == null || module.lifecycle_state != PORTABLE_MIR_LIFECYCLE_ACTIVE {
        return portable_mir_verify_fail(result, MIR_VERIFY_ERR_INVALID_MODULE, MIR_FUNCTION_INVALID_ID, MIR_BLOCK_INVALID_ID, MIR_INST_INVALID_ID, MIR_VALUE_INVALID_ID, MIR_TYPE_INVALID_ID, -1, MIR_CAPABILITY_REQ_INVALID_ID, MIR_DEBUG_LOC_INVALID_ID);
    }
    if portable_mir_verify_count(module, result) != 0 { return -1; }
    if portable_mir_verify_field_layouts(module, result) != 0 { return -1; }
    if portable_mir_verify_function_param_types(module, result) != 0 { return -1; }
    if portable_mir_verify_types(module, result) != 0 { return -1; }
    if portable_mir_verify_functions(module, result) != 0 { return -1; }
    if portable_mir_verify_blocks(module, result) != 0 { return -1; }
    if portable_mir_verify_locals(module, result) != 0 { return -1; }
    if portable_mir_verify_values(module, result) != 0 { return -1; }
    if portable_mir_verify_insts(module, result) != 0 { return -1; }
    if portable_mir_verify_terminators(module, result) != 0 { return -1; }
    if portable_mir_verify_capabilities(module, result) != 0 { return -1; }
    return 0;
}
