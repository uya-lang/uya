// src/lower/async.uya - 异步状态机 lowering 分析层
// 职责：在 C99 codegen 之前对 @async_fn 做 AST 级别的分析与决策。
// 当前包含：保守逃逸分析、async 调用识别。

extern fn resolve_async_callee_fn_decl(checker: &TypeChecker, callee: &ASTNode) &ASTNode;
extern fn compiler_arena_alloc(arena: &CompilerArena, size: usize) &byte;
extern fn checker_infer_type(checker: &TypeChecker, expr: &ASTNode) Type;
extern fn type_to_ast(checker: &TypeChecker, t: &Type, line: i32, column: i32, filename: &byte) &ASTNode;

const ASYNC_LOWER_INITIAL_PLAN_CAPACITY: i32 = 64;

export struct AsyncLowerAwaitPoint {
    source_stmt: &ASTNode,
    split_try_expr: &ASTNode,
    split_await_expr: &ASTNode,
    operand: &ASTNode,
    resume_state: i32,
    bind_name: &byte,
    bind_type: &ASTNode,
    parent_block: &ASTNode,
    stmt_index: i32,
    enclosing_while: &ASTNode,
    enclosing_for: &ASTNode,
    cleanup_region: i32,
    is_return_await: i32,
}

export struct AsyncLowerCleanupRegion {
    block: &ASTNode,
    parent_region: i32,
    defer_stmts: & & ASTNode,
    defer_count: i32,
    errdefer_stmts: & & ASTNode,
    errdefer_count: i32,
}

export struct AsyncLowerPlan {
    await_points: &AsyncLowerAwaitPoint,
    await_count: i32,
    await_capacity: i32,
    cleanup_regions: &AsyncLowerCleanupRegion,
    cleanup_region_count: i32,
    cleanup_region_capacity: i32,
    root_cleanup_region: i32,
    prefix_stmt_count: i32,
    terminal_state: i32,
    return_stmt: &ASTNode,
    return_expr: &ASTNode,
    has_loop: i32,
}

// 使用 checker/async_frame_meta.uya 中已定义的 AsyncFrameEscapeClass
// ESCAPE_STACK_CANDIDATE / ESCAPE_POOL_REQUIRED / ESCAPE_HEAP_DEBUG_ONLY

// 判断表达式是否为对 @async_fn 的调用
export fn async_lower_expr_is_async_call(checker: &TypeChecker, node: &ASTNode) i32 {
    if checker == null || node == null || node.type != ASTNodeType.AST_CALL_EXPR {
        return 0;
    }
    const callee: &ASTNode = node.call_expr_callee;
    if callee == null { return 0; }
    const fn_decl: &ASTNode = resolve_async_callee_fn_decl(checker, callee);
    if fn_decl != null { return 1; }
    return 0;
}

// 保守逃逸分析：遍历函数体 AST，发现 async 调用出现在非 @await 上下文时标记为逃逸
export fn async_lower_analyze_escape_node(checker: &TypeChecker, node: &ASTNode, in_await: i32, escaped: &i32) void {
    if node == null || escaped == null || *escaped != 0 { return; }

    if node.type == ASTNodeType.AST_AWAIT_EXPR {
        if node.await_expr_operand != null {
            async_lower_analyze_escape_node(checker, node.await_expr_operand, 1, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_TRY_EXPR {
        if node.try_expr_operand != null {
            async_lower_analyze_escape_node(checker, node.try_expr_operand, in_await, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_CALL_EXPR {
        if in_await == 0 && async_lower_expr_is_async_call(checker, node) != 0 {
            *escaped = 1;
            return;
        }
        if node.call_expr_callee != null {
            async_lower_analyze_escape_node(checker, node.call_expr_callee, 0, escaped);
            if *escaped != 0 { return; }
        }
        if node.call_expr_args != null {
            var i: i32 = 0;
            while i < node.call_expr_arg_count {
                async_lower_analyze_escape_node(checker, node.call_expr_args[i], 0, escaped);
                if *escaped != 0 { return; }
                i = i + 1;
            }
        }
        return;
    }

    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            async_lower_analyze_escape_node(checker, node.block_stmts[i], 0, escaped);
            if *escaped != 0 { return; }
            i = i + 1;
        }
        return;
    }

    if node.type == ASTNodeType.AST_IF_STMT {
        if node.if_stmt_condition != null {
            async_lower_analyze_escape_node(checker, node.if_stmt_condition, 0, escaped);
        }
        if *escaped == 0 && node.if_stmt_then_branch != null {
            async_lower_analyze_escape_node(checker, node.if_stmt_then_branch, 0, escaped);
        }
        if *escaped == 0 && node.if_stmt_else_branch != null {
            async_lower_analyze_escape_node(checker, node.if_stmt_else_branch, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_WHILE_STMT {
        if node.while_stmt_condition != null {
            async_lower_analyze_escape_node(checker, node.while_stmt_condition, 0, escaped);
        }
        if *escaped == 0 && node.while_stmt_body != null {
            async_lower_analyze_escape_node(checker, node.while_stmt_body, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_FOR_STMT {
        if node.for_stmt_range_start != null {
            async_lower_analyze_escape_node(checker, node.for_stmt_range_start, 0, escaped);
        }
        if *escaped == 0 && node.for_stmt_range_end != null {
            async_lower_analyze_escape_node(checker, node.for_stmt_range_end, 0, escaped);
        }
        if *escaped == 0 && node.for_stmt_array != null {
            async_lower_analyze_escape_node(checker, node.for_stmt_array, 0, escaped);
        }
        if *escaped == 0 && node.for_stmt_body != null {
            async_lower_analyze_escape_node(checker, node.for_stmt_body, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_RETURN_STMT {
        if node.return_stmt_expr != null {
            async_lower_analyze_escape_node(checker, node.return_stmt_expr, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_ASSIGN {
        if node.assign_src != null {
            async_lower_analyze_escape_node(checker, node.assign_src, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_VAR_DECL {
        if node.var_decl_init != null {
            async_lower_analyze_escape_node(checker, node.var_decl_init, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_BINARY_EXPR {
        if node.binary_expr_left != null {
            async_lower_analyze_escape_node(checker, node.binary_expr_left, 0, escaped);
        }
        if *escaped == 0 && node.binary_expr_right != null {
            async_lower_analyze_escape_node(checker, node.binary_expr_right, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_UNARY_EXPR {
        if node.unary_expr_operand != null {
            async_lower_analyze_escape_node(checker, node.unary_expr_operand, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        if node.member_access_object != null {
            async_lower_analyze_escape_node(checker, node.member_access_object, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        if node.array_access_array != null {
            async_lower_analyze_escape_node(checker, node.array_access_array, 0, escaped);
        }
        if *escaped == 0 && node.array_access_index != null {
            async_lower_analyze_escape_node(checker, node.array_access_index, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_CAST_EXPR {
        if node.cast_expr_expr != null {
            async_lower_analyze_escape_node(checker, node.cast_expr_expr, 0, escaped);
        }
        return;
    }

    if node.type == ASTNodeType.AST_STRUCT_INIT {
        if node.struct_init_field_values != null {
            var i: i32 = 0;
            while i < node.struct_init_field_count {
                async_lower_analyze_escape_node(checker, node.struct_init_field_values[i], 0, escaped);
                if *escaped != 0 { return; }
                i = i + 1;
            }
        }
        return;
    }

    if node.type == ASTNodeType.AST_ARRAY_LITERAL {
        if node.array_literal_elements != null {
            var i: i32 = 0;
            while i < node.array_literal_element_count {
                async_lower_analyze_escape_node(checker, node.array_literal_elements[i], 0, escaped);
                if *escaped != 0 { return; }
                i = i + 1;
            }
        }
        return;
    }

    if node.type == ASTNodeType.AST_TUPLE_LITERAL {
        if node.tuple_literal_elements != null {
            var i: i32 = 0;
            while i < node.tuple_literal_element_count {
                async_lower_analyze_escape_node(checker, node.tuple_literal_elements[i], 0, escaped);
                if *escaped != 0 { return; }
                i = i + 1;
            }
        }
        return;
    }

    if node.type == ASTNodeType.AST_MATCH_EXPR {
        if node.match_expr_expr != null {
            async_lower_analyze_escape_node(checker, node.match_expr_expr, 0, escaped);
        }
        if *escaped == 0 && node.match_expr_arms != null {
            var i: i32 = 0;
            while i < node.match_expr_arm_count {
                if node.match_expr_arms[i].result_expr != null {
                    async_lower_analyze_escape_node(checker, node.match_expr_arms[i].result_expr, 0, escaped);
                    if *escaped != 0 { return; }
                }
                i = i + 1;
            }
        }
        return;
    }

    if node.type == ASTNodeType.AST_CATCH_EXPR {
        if node.catch_expr_operand != null {
            async_lower_analyze_escape_node(checker, node.catch_expr_operand, 0, escaped);
        }
        if *escaped == 0 && node.catch_expr_catch_block != null {
            async_lower_analyze_escape_node(checker, node.catch_expr_catch_block, 0, escaped);
        }
        return;
    }
}

// 对函数体做逃逸分析，返回建议的 escape class
export fn async_lower_analyze_escape_class(checker: &TypeChecker, fn_body: &ASTNode) AsyncFrameEscapeClass {
    if fn_body == null { return AsyncFrameEscapeClass.ESCAPE_POOL_REQUIRED; }
    var escaped: i32 = 0;
    async_lower_analyze_escape_node(checker, fn_body, 0, &escaped);
    if escaped != 0 {
        return AsyncFrameEscapeClass.ESCAPE_POOL_REQUIRED;
    }
    return AsyncFrameEscapeClass.ESCAPE_STACK_CANDIDATE;
}

fn async_lower_ensure_plan_capacity(plan: &AsyncLowerPlan, arena: &CompilerArena, needed: i32) i32 {
    if plan == null || arena == null || needed <= 0 {
        return -1;
    }
    if plan.await_capacity >= needed && plan.await_points != null {
        return 0;
    }
    var new_cap: i32 = plan.await_capacity;
    if new_cap < ASYNC_LOWER_INITIAL_PLAN_CAPACITY {
        new_cap = ASYNC_LOWER_INITIAL_PLAN_CAPACITY;
    }
    while new_cap < needed {
        new_cap = new_cap * 2;
        if new_cap <= 0 {
            return -1;
        }
    }
    const new_points: &AsyncLowerAwaitPoint = compiler_arena_alloc(
        arena, @size_of(AsyncLowerAwaitPoint) * new_cap as usize) as &AsyncLowerAwaitPoint;
    if new_points == null {
        return -1;
    }
    if plan.await_points != null {
        var i: i32 = 0;
        while i < plan.await_count && i < plan.await_capacity {
            new_points[i] = plan.await_points[i];
            i = i + 1;
        }
    }
    plan.await_points = new_points;
    plan.await_capacity = new_cap;
    return 0;
}

fn async_lower_ensure_cleanup_region_capacity(plan: &AsyncLowerPlan, arena: &CompilerArena, needed: i32) i32 {
    if plan == null || arena == null || needed <= 0 {
        return -1;
    }
    if plan.cleanup_region_capacity >= needed && plan.cleanup_regions != null {
        return 0;
    }
    var new_cap: i32 = plan.cleanup_region_capacity;
    if new_cap < ASYNC_LOWER_INITIAL_PLAN_CAPACITY {
        new_cap = ASYNC_LOWER_INITIAL_PLAN_CAPACITY;
    }
    while new_cap < needed {
        new_cap = new_cap * 2;
        if new_cap <= 0 {
            return -1;
        }
    }
    const new_regions: &AsyncLowerCleanupRegion = compiler_arena_alloc(
        arena, @size_of(AsyncLowerCleanupRegion) * new_cap as usize) as &AsyncLowerCleanupRegion;
    if new_regions == null {
        return -1;
    }
    if plan.cleanup_regions != null {
        var i: i32 = 0;
        while i < plan.cleanup_region_count && i < plan.cleanup_region_capacity {
            new_regions[i] = plan.cleanup_regions[i];
            i = i + 1;
        }
    }
    plan.cleanup_regions = new_regions;
    plan.cleanup_region_capacity = new_cap;
    return 0;
}

fn async_lower_collect_cleanup_stmt_list(
    arena: &CompilerArena,
    block: &ASTNode,
    is_errdefer: i32,
    out_count: &i32
) & & ASTNode {
    if out_count != null {
        out_count[0] = 0;
    }
    if arena == null || block == null || block.type != ASTNodeType.AST_BLOCK || block.block_stmts == null {
        return null;
    }
    var count: i32 = 0;
    var i: i32 = 0;
    while i < block.block_stmt_count {
        const stmt: &ASTNode = block.block_stmts[i];
        if stmt != null {
            if is_errdefer != 0 {
                if stmt.type == ASTNodeType.AST_ERRDEFER_STMT {
                    count = count + 1;
                }
            } else if stmt.type == ASTNodeType.AST_DEFER_STMT {
                count = count + 1;
            }
        }
        i = i + 1;
    }
    if out_count != null {
        out_count[0] = count;
    }
    if count <= 0 {
        return null;
    }
    const stmts: & & ASTNode = compiler_arena_alloc(arena, @size_of(&ASTNode) * count as usize) as & & ASTNode;
    if stmts == null {
        if out_count != null {
            out_count[0] = 0;
        }
        return null;
    }
    var write_i: i32 = 0;
    i = 0;
    while i < block.block_stmt_count && write_i < count {
        const stmt2: &ASTNode = block.block_stmts[i];
        if stmt2 != null {
            if is_errdefer != 0 {
                if stmt2.type == ASTNodeType.AST_ERRDEFER_STMT {
                    stmts[write_i] = stmt2;
                    write_i = write_i + 1;
                }
            } else if stmt2.type == ASTNodeType.AST_DEFER_STMT {
                stmts[write_i] = stmt2;
                write_i = write_i + 1;
            }
        }
        i = i + 1;
    }
    return stmts;
}

fn async_lower_register_cleanup_region(
    plan: &AsyncLowerPlan,
    arena: &CompilerArena,
    block: &ASTNode,
    parent_region: i32
) i32 {
    if plan == null || block == null || block.type != ASTNodeType.AST_BLOCK {
        return parent_region;
    }
    const idx: i32 = plan.cleanup_region_count;
    if async_lower_ensure_cleanup_region_capacity(plan, arena, idx + 1) != 0 {
        return parent_region;
    }
    plan.cleanup_region_count = idx + 1;
    const region: &AsyncLowerCleanupRegion = &plan.cleanup_regions[idx];
    region.block = block;
    region.parent_region = parent_region;
    region.defer_stmts = async_lower_collect_cleanup_stmt_list(arena, block, 0, &region.defer_count);
    region.errdefer_stmts = async_lower_collect_cleanup_stmt_list(arena, block, 1, &region.errdefer_count);
    return idx;
}

fn async_lower_claim_await_slot(plan: &AsyncLowerPlan, arena: &CompilerArena) i32 {
    if plan == null {
        return -1;
    }
    const idx: i32 = plan.await_count;
    if async_lower_ensure_plan_capacity(plan, arena, idx + 1) != 0 {
        return -1;
    }
    plan.await_count = idx + 1;
    return idx;
}

fn async_lower_note_prefix_stmt_count(plan: &AsyncLowerPlan, root_stmt_index: i32) void {
    if plan == null || root_stmt_index < 0 {
        return;
    }
    if plan.prefix_stmt_count < 0 || root_stmt_index < plan.prefix_stmt_count {
        plan.prefix_stmt_count = root_stmt_index;
    }
}

fn async_lower_assign_state_numbers(plan: &AsyncLowerPlan) void {
    if plan == null {
        return;
    }
    var next_state: i32 = 1;
    var i: i32 = 0;
    while i < plan.await_count && plan.await_points != null {
        plan.await_points[i].resume_state = next_state;
        next_state = next_state + 1;
        i = i + 1;
    }
    plan.terminal_state = next_state;
}

fn async_lower_infer_compound_bind_type(checker: &TypeChecker, node: &ASTNode, try_expr: &ASTNode) &ASTNode {
    if checker == null {
        return null;
    }
    if node != null && node.type == ASTNodeType.AST_VAR_DECL && node.var_decl_type != null {
        return node.var_decl_type;
    }
    if node != null && node.type == ASTNodeType.AST_ASSIGN && node.assign_dest != null {
        const dest_type: Type = checker_infer_type(checker, node.assign_dest);
        if dest_type.kind != TypeKind.TYPE_VOID {
            return type_to_ast(checker, &dest_type, node.line, node.column, node.filename);
        }
    }
    if try_expr == null {
        return null;
    }
    const try_type: Type = checker_infer_type(checker, try_expr);
    if try_type.kind == TypeKind.TYPE_VOID {
        return null;
    }
    return type_to_ast(checker, &try_type, try_expr.line, try_expr.column, try_expr.filename);
}

fn async_lower_await_expr_result_type(checker: &TypeChecker, await_expr: &ASTNode) &ASTNode {
    if checker == null || await_expr == null {
        return null;
    }
    const await_type: Type = checker_infer_type(checker, await_expr);
    if await_type.kind == TypeKind.TYPE_VOID {
        return null;
    }
    return type_to_ast(checker, &await_type, await_expr.line, await_expr.column, await_expr.filename);
}

fn async_lower_find_raw_await_bind_type(checker: &TypeChecker, node: &ASTNode, await_expr: &ASTNode) &ASTNode {
    if checker == null || node == null || await_expr == null {
        return null;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        if node.var_decl_init != null &&
            @usize_from_ptr(node.var_decl_init as &void) == @usize_from_ptr(await_expr as &void) {
            return node.var_decl_type;
        }
        return async_lower_find_raw_await_bind_type(checker, node.var_decl_init, await_expr);
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        return async_lower_find_raw_await_bind_type(checker, node.return_stmt_expr, await_expr);
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        if node.assign_src != null &&
            @usize_from_ptr(node.assign_src as &void) == @usize_from_ptr(await_expr as &void) &&
            node.assign_dest != null {
            const dest_type: Type = checker_infer_type(checker, node.assign_dest);
            if dest_type.kind != TypeKind.TYPE_VOID {
                return type_to_ast(checker, &dest_type, node.line, node.column, node.filename);
            }
        }
        const from_dest: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.assign_dest, await_expr);
        if from_dest != null {
            return from_dest;
        }
        return async_lower_find_raw_await_bind_type(checker, node.assign_src, await_expr);
    }
    if node.type == ASTNodeType.AST_TRY_EXPR {
        return async_lower_find_raw_await_bind_type(checker, node.try_expr_operand, await_expr);
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var bi: i32 = 0;
        while bi < node.block_stmt_count {
            const found_block: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.block_stmts[bi], await_expr);
            if found_block != null {
                return found_block;
            }
            bi = bi + 1;
        }
        return null;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        const found_cond: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.if_stmt_condition, await_expr);
        if found_cond != null {
            return found_cond;
        }
        const found_then: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.if_stmt_then_branch, await_expr);
        if found_then != null {
            return found_then;
        }
        return async_lower_find_raw_await_bind_type(checker, node.if_stmt_else_branch, await_expr);
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        const found_while_cond: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.while_stmt_condition, await_expr);
        if found_while_cond != null {
            return found_while_cond;
        }
        return async_lower_find_raw_await_bind_type(checker, node.while_stmt_body, await_expr);
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        const found_range_start: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.for_stmt_range_start, await_expr);
        if found_range_start != null {
            return found_range_start;
        }
        const found_range_end: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.for_stmt_range_end, await_expr);
        if found_range_end != null {
            return found_range_end;
        }
        const found_array: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.for_stmt_array, await_expr);
        if found_array != null {
            return found_array;
        }
        return async_lower_find_raw_await_bind_type(checker, node.for_stmt_body, await_expr);
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        const found_callee: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.call_expr_callee, await_expr);
        if found_callee != null {
            return found_callee;
        }
        if node.call_expr_args != null {
            var ai: i32 = 0;
            while ai < node.call_expr_arg_count {
                const found_arg: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.call_expr_args[ai], await_expr);
                if found_arg != null {
                    return found_arg;
                }
                ai = ai + 1;
            }
        }
        return null;
    }
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        return async_lower_find_raw_await_bind_type(checker, node.member_access_object, await_expr);
    }
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        const found_array_expr: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.array_access_array, await_expr);
        if found_array_expr != null {
            return found_array_expr;
        }
        return async_lower_find_raw_await_bind_type(checker, node.array_access_index, await_expr);
    }
    if node.type == ASTNodeType.AST_SLICE_EXPR {
        const found_base: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.slice_expr_base, await_expr);
        if found_base != null {
            return found_base;
        }
        const found_start: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.slice_expr_start_expr, await_expr);
        if found_start != null {
            return found_start;
        }
        return async_lower_find_raw_await_bind_type(checker, node.slice_expr_len_expr, await_expr);
    }
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        const found_left: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.binary_expr_left, await_expr);
        if found_left != null {
            return found_left;
        }
        return async_lower_find_raw_await_bind_type(checker, node.binary_expr_right, await_expr);
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR {
        return async_lower_find_raw_await_bind_type(checker, node.unary_expr_operand, await_expr);
    }
    if node.type == ASTNodeType.AST_CAST_EXPR {
        return async_lower_find_raw_await_bind_type(checker, node.cast_expr_expr, await_expr);
    }
    if node.type == ASTNodeType.AST_CATCH_EXPR {
        const found_catch_operand: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.catch_expr_operand, await_expr);
        if found_catch_operand != null {
            return found_catch_operand;
        }
        return async_lower_find_raw_await_bind_type(checker, node.catch_expr_catch_block, await_expr);
    }
    if node.type == ASTNodeType.AST_MATCH_EXPR && node.match_expr_arms != null {
        const found_match_expr: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.match_expr_expr, await_expr);
        if found_match_expr != null {
            return found_match_expr;
        }
        var mi: i32 = 0;
        while mi < node.match_expr_arm_count {
            const found_arm: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.match_expr_arms[mi].result_expr, await_expr);
            if found_arm != null {
                return found_arm;
            }
            mi = mi + 1;
        }
        return null;
    }
    if node.type == ASTNodeType.AST_STRUCT_INIT && node.struct_init_field_values != null {
        var fi: i32 = 0;
        while fi < node.struct_init_field_count {
            const found_field: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.struct_init_field_values[fi], await_expr);
            if found_field != null {
                return found_field;
            }
            fi = fi + 1;
        }
        return null;
    }
    if node.type == ASTNodeType.AST_ARRAY_LITERAL && node.array_literal_elements != null {
        var ei: i32 = 0;
        while ei < node.array_literal_element_count {
            const found_elem: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.array_literal_elements[ei], await_expr);
            if found_elem != null {
                return found_elem;
            }
            ei = ei + 1;
        }
        return null;
    }
    if node.type == ASTNodeType.AST_TUPLE_LITERAL && node.tuple_literal_elements != null {
        var ti: i32 = 0;
        while ti < node.tuple_literal_element_count {
            const found_tuple: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.tuple_literal_elements[ti], await_expr);
            if found_tuple != null {
                return found_tuple;
            }
            ti = ti + 1;
        }
        return null;
    }
    if node.type == ASTNodeType.AST_PRINT || node.type == ASTNodeType.AST_PRINTLN {
        return async_lower_find_raw_await_bind_type(checker, node.print_expr, await_expr);
    }
    if node.type == ASTNodeType.AST_SYSCALL {
        const found_syscall_nr: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.syscall_number, await_expr);
        if found_syscall_nr != null {
            return found_syscall_nr;
        }
        if node.syscall_args != null {
            var si2: i32 = 0;
            while si2 < node.syscall_arg_count {
                const found_syscall_arg: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.syscall_args[si2], await_expr);
                if found_syscall_arg != null {
                    return found_syscall_arg;
                }
                si2 = si2 + 1;
            }
        }
        return null;
    }
    if node.type == ASTNodeType.AST_STRING_INTERP && node.string_interp_segments != null {
        var si3: i32 = 0;
        while si3 < node.string_interp_segment_count {
            const seg: &ASTStringInterpSegment = &node.string_interp_segments[si3];
            if seg != null && seg.is_text == 0 && seg.expr != null {
                const found_interp: &ASTNode = async_lower_find_raw_await_bind_type(checker, seg.expr, await_expr);
                if found_interp != null {
                    return found_interp;
                }
            }
            si3 = si3 + 1;
        }
        return null;
    }
    if node.type == ASTNodeType.AST_SIZEOF {
        return async_lower_find_raw_await_bind_type(checker, node.sizeof_expr_target, await_expr);
    }
    if node.type == ASTNodeType.AST_LEN {
        return async_lower_find_raw_await_bind_type(checker, node.len_expr_array, await_expr);
    }
    if node.type == ASTNodeType.AST_ALIGNOF {
        return async_lower_find_raw_await_bind_type(checker, node.alignof_expr_target, await_expr);
    }
    if node.type == ASTNodeType.AST_PTR_FROM_USIZE {
        return async_lower_find_raw_await_bind_type(checker, node.ptr_from_usize_value, await_expr);
    }
    if node.type == ASTNodeType.AST_USIZE_FROM_PTR {
        return async_lower_find_raw_await_bind_type(checker, node.usize_from_ptr_ptr, await_expr);
    }
    if node.type == ASTNodeType.AST_ERROR_ID {
        return async_lower_find_raw_await_bind_type(checker, node.error_id_operand, await_expr);
    }
    if node.type == ASTNodeType.AST_ERROR_NAME {
        return async_lower_find_raw_await_bind_type(checker, node.error_name_operand, await_expr);
    }
    if node.type == ASTNodeType.AST_VA_START {
        const found_va_start_ap: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.va_start_ap, await_expr);
        if found_va_start_ap != null {
            return found_va_start_ap;
        }
        return async_lower_find_raw_await_bind_type(checker, node.va_start_last_param, await_expr);
    }
    if node.type == ASTNodeType.AST_VA_END {
        return async_lower_find_raw_await_bind_type(checker, node.va_end_ap, await_expr);
    }
    if node.type == ASTNodeType.AST_VA_ARG {
        const found_va_arg_ap: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.va_arg_ap, await_expr);
        if found_va_arg_ap != null {
            return found_va_arg_ap;
        }
        return async_lower_find_raw_await_bind_type(checker, node.va_arg_arg_type, await_expr);
    }
    if node.type == ASTNodeType.AST_VA_COPY {
        const found_va_copy_dest: &ASTNode = async_lower_find_raw_await_bind_type(checker, node.va_copy_dest, await_expr);
        if found_va_copy_dest != null {
            return found_va_copy_dest;
        }
        return async_lower_find_raw_await_bind_type(checker, node.va_copy_src, await_expr);
    }
    return null;
}

fn async_lower_find_first_split_await_expr(
    node: &ASTNode,
    out_await_expr: &&ASTNode,
    out_try_expr: &&ASTNode
) i32 {
    if node == null || out_await_expr == null || out_try_expr == null {
        return 0;
    }
    if node.type == ASTNodeType.AST_TRY_EXPR && node.try_expr_operand != null {
        if node.try_expr_operand.type == ASTNodeType.AST_AWAIT_EXPR && node.try_expr_operand.await_expr_operand != null {
            out_await_expr[0] = node.try_expr_operand;
            out_try_expr[0] = node;
            return 1;
        }
        if async_lower_find_first_split_await_expr(node.try_expr_operand, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_AWAIT_EXPR && node.await_expr_operand != null {
        out_await_expr[0] = node;
        out_try_expr[0] = null;
        return 1;
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var bi: i32 = 0;
        while bi < node.block_stmt_count {
            if async_lower_find_first_split_await_expr(node.block_stmts[bi], out_await_expr, out_try_expr) != 0 {
                return 1;
            }
            bi = bi + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        return async_lower_find_first_split_await_expr(node.var_decl_init, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        return async_lower_find_first_split_await_expr(node.return_stmt_expr, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        if async_lower_find_first_split_await_expr(node.assign_dest, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.assign_src, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        if async_lower_find_first_split_await_expr(node.if_stmt_condition, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        if async_lower_find_first_split_await_expr(node.if_stmt_then_branch, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.if_stmt_else_branch, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        if async_lower_find_first_split_await_expr(node.while_stmt_condition, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.while_stmt_body, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        if async_lower_find_first_split_await_expr(node.for_stmt_range_start, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        if async_lower_find_first_split_await_expr(node.for_stmt_range_end, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        if async_lower_find_first_split_await_expr(node.for_stmt_array, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.for_stmt_body, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        if async_lower_find_first_split_await_expr(node.call_expr_callee, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        if node.call_expr_args != null {
            var ai: i32 = 0;
            while ai < node.call_expr_arg_count {
                if async_lower_find_first_split_await_expr(node.call_expr_args[ai], out_await_expr, out_try_expr) != 0 {
                    return 1;
                }
                ai = ai + 1;
            }
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        return async_lower_find_first_split_await_expr(node.member_access_object, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        if async_lower_find_first_split_await_expr(node.array_access_array, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.array_access_index, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_SLICE_EXPR {
        if async_lower_find_first_split_await_expr(node.slice_expr_base, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        if async_lower_find_first_split_await_expr(node.slice_expr_start_expr, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.slice_expr_len_expr, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        if async_lower_find_first_split_await_expr(node.binary_expr_left, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.binary_expr_right, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR {
        return async_lower_find_first_split_await_expr(node.unary_expr_operand, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_CAST_EXPR {
        return async_lower_find_first_split_await_expr(node.cast_expr_expr, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_CATCH_EXPR {
        if async_lower_find_first_split_await_expr(node.catch_expr_operand, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.catch_expr_catch_block, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_MATCH_EXPR && node.match_expr_arms != null {
        if async_lower_find_first_split_await_expr(node.match_expr_expr, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        var mi: i32 = 0;
        while mi < node.match_expr_arm_count {
            if async_lower_find_first_split_await_expr(node.match_expr_arms[mi].result_expr, out_await_expr, out_try_expr) != 0 {
                return 1;
            }
            mi = mi + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_STRUCT_INIT && node.struct_init_field_values != null {
        var fi: i32 = 0;
        while fi < node.struct_init_field_count {
            if async_lower_find_first_split_await_expr(node.struct_init_field_values[fi], out_await_expr, out_try_expr) != 0 {
                return 1;
            }
            fi = fi + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_ARRAY_LITERAL && node.array_literal_elements != null {
        var ei: i32 = 0;
        while ei < node.array_literal_element_count {
            if async_lower_find_first_split_await_expr(node.array_literal_elements[ei], out_await_expr, out_try_expr) != 0 {
                return 1;
            }
            ei = ei + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_TUPLE_LITERAL && node.tuple_literal_elements != null {
        var ti: i32 = 0;
        while ti < node.tuple_literal_element_count {
            if async_lower_find_first_split_await_expr(node.tuple_literal_elements[ti], out_await_expr, out_try_expr) != 0 {
                return 1;
            }
            ti = ti + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_PRINT || node.type == ASTNodeType.AST_PRINTLN {
        return async_lower_find_first_split_await_expr(node.print_expr, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_SYSCALL {
        if async_lower_find_first_split_await_expr(node.syscall_number, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        if node.syscall_args != null {
            var si2: i32 = 0;
            while si2 < node.syscall_arg_count {
                if async_lower_find_first_split_await_expr(node.syscall_args[si2], out_await_expr, out_try_expr) != 0 {
                    return 1;
                }
                si2 = si2 + 1;
            }
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_STRING_INTERP && node.string_interp_segments != null {
        var si3: i32 = 0;
        while si3 < node.string_interp_segment_count {
            const seg: &ASTStringInterpSegment = &node.string_interp_segments[si3];
            if seg != null && seg.is_text == 0 && seg.expr != null &&
                async_lower_find_first_split_await_expr(seg.expr, out_await_expr, out_try_expr) != 0 {
                return 1;
            }
            si3 = si3 + 1;
        }
        return 0;
    }
    if node.type == ASTNodeType.AST_SIZEOF {
        return async_lower_find_first_split_await_expr(node.sizeof_expr_target, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_LEN {
        return async_lower_find_first_split_await_expr(node.len_expr_array, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_ALIGNOF {
        return async_lower_find_first_split_await_expr(node.alignof_expr_target, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_PTR_FROM_USIZE {
        return async_lower_find_first_split_await_expr(node.ptr_from_usize_value, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_USIZE_FROM_PTR {
        return async_lower_find_first_split_await_expr(node.usize_from_ptr_ptr, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_ERROR_ID {
        return async_lower_find_first_split_await_expr(node.error_id_operand, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_ERROR_NAME {
        return async_lower_find_first_split_await_expr(node.error_name_operand, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_VA_START {
        if async_lower_find_first_split_await_expr(node.va_start_ap, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.va_start_last_param, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_VA_END {
        return async_lower_find_first_split_await_expr(node.va_end_ap, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_VA_ARG {
        if async_lower_find_first_split_await_expr(node.va_arg_ap, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.va_arg_arg_type, out_await_expr, out_try_expr);
    }
    if node.type == ASTNodeType.AST_VA_COPY {
        if async_lower_find_first_split_await_expr(node.va_copy_dest, out_await_expr, out_try_expr) != 0 {
            return 1;
        }
        return async_lower_find_first_split_await_expr(node.va_copy_src, out_await_expr, out_try_expr);
    }
    return 0;
}

export fn async_lower_find_first_try_await_expr(node: &ASTNode, out_try_expr: &&ASTNode) i32 {
    if node == null || out_try_expr == null {
        return 0;
    }
    var await_expr: &ASTNode = null;
    var try_expr: &ASTNode = null;
    if async_lower_find_first_split_await_expr(node, &await_expr, &try_expr) != 0 && try_expr != null {
        out_try_expr[0] = try_expr;
        return 1;
    }
    return 0;
}

export fn async_lower_stmt_contains_await(node: &ASTNode) i32 {
    if node == null { return 0; }

    if node.type == ASTNodeType.AST_AWAIT_EXPR { return 1; }

    if node.type == ASTNodeType.AST_TRY_EXPR && node.try_expr_operand != null {
        return async_lower_stmt_contains_await(node.try_expr_operand);
    }

    if node.type == ASTNodeType.AST_VAR_DECL && node.var_decl_init != null {
        return async_lower_stmt_contains_await(node.var_decl_init);
    }

    if node.type == ASTNodeType.AST_RETURN_STMT && node.return_stmt_expr != null {
        return async_lower_stmt_contains_await(node.return_stmt_expr);
    }

    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            if async_lower_stmt_contains_await(node.block_stmts[i]) != 0 { return 1; }
            i = i + 1;
        }
    }

    if node.type == ASTNodeType.AST_WHILE_STMT {
        if node.while_stmt_body != null && async_lower_stmt_contains_await(node.while_stmt_body) != 0 { return 1; }
    }

    if node.type == ASTNodeType.AST_FOR_STMT {
        if node.for_stmt_body != null && async_lower_stmt_contains_await(node.for_stmt_body) != 0 { return 1; }
    }

    if node.type == ASTNodeType.AST_IF_STMT {
        if node.if_stmt_then_branch != null && async_lower_stmt_contains_await(node.if_stmt_then_branch) != 0 { return 1; }
        if node.if_stmt_else_branch != null && async_lower_stmt_contains_await(node.if_stmt_else_branch) != 0 { return 1; }
    }

    if node.type == ASTNodeType.AST_ASSIGN {
        if async_lower_stmt_contains_await(node.assign_dest) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.assign_src);
    }

    if node.type == ASTNodeType.AST_CALL_EXPR {
        if async_lower_stmt_contains_await(node.call_expr_callee) != 0 { return 1; }
        if node.call_expr_args != null {
            var ai: i32 = 0;
            while ai < node.call_expr_arg_count {
                if async_lower_stmt_contains_await(node.call_expr_args[ai]) != 0 { return 1; }
                ai = ai + 1;
            }
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        return async_lower_stmt_contains_await(node.member_access_object);
    }

    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        if async_lower_stmt_contains_await(node.array_access_array) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.array_access_index);
    }

    if node.type == ASTNodeType.AST_SLICE_EXPR {
        if async_lower_stmt_contains_await(node.slice_expr_base) != 0 { return 1; }
        if async_lower_stmt_contains_await(node.slice_expr_start_expr) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.slice_expr_len_expr);
    }

    if node.type == ASTNodeType.AST_BINARY_EXPR {
        if async_lower_stmt_contains_await(node.binary_expr_left) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.binary_expr_right);
    }

    if node.type == ASTNodeType.AST_UNARY_EXPR {
        return async_lower_stmt_contains_await(node.unary_expr_operand);
    }

    if node.type == ASTNodeType.AST_CAST_EXPR {
        return async_lower_stmt_contains_await(node.cast_expr_expr);
    }

    if node.type == ASTNodeType.AST_CATCH_EXPR {
        if async_lower_stmt_contains_await(node.catch_expr_operand) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.catch_expr_catch_block);
    }

    if node.type == ASTNodeType.AST_MATCH_EXPR && node.match_expr_arms != null {
        if async_lower_stmt_contains_await(node.match_expr_expr) != 0 { return 1; }
        var mi: i32 = 0;
        while mi < node.match_expr_arm_count {
            if async_lower_stmt_contains_await(node.match_expr_arms[mi].result_expr) != 0 { return 1; }
            mi = mi + 1;
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_STRUCT_INIT && node.struct_init_field_values != null {
        var fi: i32 = 0;
        while fi < node.struct_init_field_count {
            if async_lower_stmt_contains_await(node.struct_init_field_values[fi]) != 0 { return 1; }
            fi = fi + 1;
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_ARRAY_LITERAL && node.array_literal_elements != null {
        var ei: i32 = 0;
        while ei < node.array_literal_element_count {
            if async_lower_stmt_contains_await(node.array_literal_elements[ei]) != 0 { return 1; }
            ei = ei + 1;
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_TUPLE_LITERAL && node.tuple_literal_elements != null {
        var ti: i32 = 0;
        while ti < node.tuple_literal_element_count {
            if async_lower_stmt_contains_await(node.tuple_literal_elements[ti]) != 0 { return 1; }
            ti = ti + 1;
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_PRINT || node.type == ASTNodeType.AST_PRINTLN {
        return async_lower_stmt_contains_await(node.print_expr);
    }

    if node.type == ASTNodeType.AST_SYSCALL {
        if async_lower_stmt_contains_await(node.syscall_number) != 0 { return 1; }
        if node.syscall_args != null {
            var si2: i32 = 0;
            while si2 < node.syscall_arg_count {
                if async_lower_stmt_contains_await(node.syscall_args[si2]) != 0 { return 1; }
                si2 = si2 + 1;
            }
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_STRING_INTERP && node.string_interp_segments != null {
        var si3: i32 = 0;
        while si3 < node.string_interp_segment_count {
            const seg: &ASTStringInterpSegment = &node.string_interp_segments[si3];
            if seg != null && seg.is_text == 0 && seg.expr != null && async_lower_stmt_contains_await(seg.expr) != 0 {
                return 1;
            }
            si3 = si3 + 1;
        }
        return 0;
    }

    if node.type == ASTNodeType.AST_SIZEOF {
        return async_lower_stmt_contains_await(node.sizeof_expr_target);
    }

    if node.type == ASTNodeType.AST_LEN {
        return async_lower_stmt_contains_await(node.len_expr_array);
    }

    if node.type == ASTNodeType.AST_ALIGNOF {
        return async_lower_stmt_contains_await(node.alignof_expr_target);
    }

    if node.type == ASTNodeType.AST_PTR_FROM_USIZE {
        return async_lower_stmt_contains_await(node.ptr_from_usize_value);
    }

    if node.type == ASTNodeType.AST_USIZE_FROM_PTR {
        return async_lower_stmt_contains_await(node.usize_from_ptr_ptr);
    }

    if node.type == ASTNodeType.AST_ERROR_ID {
        return async_lower_stmt_contains_await(node.error_id_operand);
    }

    if node.type == ASTNodeType.AST_ERROR_NAME {
        return async_lower_stmt_contains_await(node.error_name_operand);
    }

    if node.type == ASTNodeType.AST_VA_START {
        if async_lower_stmt_contains_await(node.va_start_ap) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.va_start_last_param);
    }

    if node.type == ASTNodeType.AST_VA_END {
        return async_lower_stmt_contains_await(node.va_end_ap);
    }

    if node.type == ASTNodeType.AST_VA_ARG {
        if async_lower_stmt_contains_await(node.va_arg_ap) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.va_arg_arg_type);
    }

    if node.type == ASTNodeType.AST_VA_COPY {
        if async_lower_stmt_contains_await(node.va_copy_dest) != 0 { return 1; }
        return async_lower_stmt_contains_await(node.va_copy_src);
    }

    return 0;
}

fn async_lower_collect_plan_node(
    plan: &AsyncLowerPlan,
    arena: &CompilerArena,
    checker: &TypeChecker,
    node: &ASTNode,
    parent_block: &ASTNode,
    parent_stmt_index: i32,
    enclosing_while: &ASTNode,
    enclosing_for: &ASTNode,
    root_stmt_index: i32,
    current_cleanup_region: i32
) void {
    if node == null {
        return;
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        const block_region: i32 = async_lower_register_cleanup_region(plan, arena, node, current_cleanup_region);
        var i: i32 = 0;
        while i < node.block_stmt_count {
            async_lower_collect_plan_node(plan, arena, checker, node.block_stmts[i], node, i, enclosing_while, enclosing_for, root_stmt_index, block_region);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT && node.while_stmt_body != null {
        plan.has_loop = 1;
        async_lower_collect_plan_node(plan, arena, checker, node.while_stmt_body, null, -1, node, enclosing_for, root_stmt_index, current_cleanup_region);
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        if node.if_stmt_then_branch != null {
            async_lower_collect_plan_node(plan, arena, checker, node.if_stmt_then_branch, null, -1, enclosing_while, enclosing_for, root_stmt_index, current_cleanup_region);
        }
        if node.if_stmt_else_branch != null {
            async_lower_collect_plan_node(plan, arena, checker, node.if_stmt_else_branch, null, -1, enclosing_while, enclosing_for, root_stmt_index, current_cleanup_region);
        }
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT && node.for_stmt_body != null {
        plan.has_loop = 1;
        async_lower_collect_plan_node(plan, arena, checker, node.for_stmt_body, null, -1, enclosing_while, node, root_stmt_index, current_cleanup_region);
        return;
    }
    if node.type == ASTNodeType.AST_VAR_DECL && node.var_decl_init != null {
        const init: &ASTNode = node.var_decl_init;
        if init.type == ASTNodeType.AST_AWAIT_EXPR && init.await_expr_operand != null {
            const idx_plain: i32 = async_lower_claim_await_slot(plan, arena);
            if idx_plain >= 0 {
                async_lower_note_prefix_stmt_count(plan, root_stmt_index);
                plan.await_points[idx_plain].source_stmt = node;
                plan.await_points[idx_plain].split_try_expr = null;
                plan.await_points[idx_plain].split_await_expr = null;
                plan.await_points[idx_plain].operand = init.await_expr_operand;
                plan.await_points[idx_plain].bind_name = node.var_decl_name;
                plan.await_points[idx_plain].bind_type = node.var_decl_type;
                plan.await_points[idx_plain].parent_block = parent_block;
                plan.await_points[idx_plain].stmt_index = parent_stmt_index;
                plan.await_points[idx_plain].enclosing_while = enclosing_while;
                plan.await_points[idx_plain].enclosing_for = enclosing_for;
                plan.await_points[idx_plain].cleanup_region = current_cleanup_region;
                plan.await_points[idx_plain].is_return_await = 0;
            }
            return;
        }
        if init.type == ASTNodeType.AST_TRY_EXPR && init.try_expr_operand != null {
            const op: &ASTNode = init.try_expr_operand;
            if op.type == ASTNodeType.AST_AWAIT_EXPR && op.await_expr_operand != null {
                const idx_decl: i32 = async_lower_claim_await_slot(plan, arena);
                if idx_decl >= 0 {
                    async_lower_note_prefix_stmt_count(plan, root_stmt_index);
                    plan.await_points[idx_decl].source_stmt = node;
                    plan.await_points[idx_decl].split_try_expr = init;
                    plan.await_points[idx_decl].split_await_expr = null;
                    plan.await_points[idx_decl].operand = op.await_expr_operand;
                    plan.await_points[idx_decl].bind_name = node.var_decl_name;
                    plan.await_points[idx_decl].bind_type = node.var_decl_type;
                    plan.await_points[idx_decl].parent_block = parent_block;
                    plan.await_points[idx_decl].stmt_index = parent_stmt_index;
                    plan.await_points[idx_decl].enclosing_while = enclosing_while;
                    plan.await_points[idx_decl].enclosing_for = enclosing_for;
                    plan.await_points[idx_decl].cleanup_region = current_cleanup_region;
                    plan.await_points[idx_decl].is_return_await = 0;
                }
                return;
            }
        }
    } else if node.type == ASTNodeType.AST_RETURN_STMT {
        const ret_expr: &ASTNode = node.return_stmt_expr;
        if ret_expr != null && ret_expr.type == ASTNodeType.AST_AWAIT_EXPR && ret_expr.await_expr_operand != null {
            const idx_ret_plain: i32 = async_lower_claim_await_slot(plan, arena);
            if idx_ret_plain >= 0 {
                async_lower_note_prefix_stmt_count(plan, root_stmt_index);
                plan.await_points[idx_ret_plain].source_stmt = node;
                plan.await_points[idx_ret_plain].split_try_expr = null;
                plan.await_points[idx_ret_plain].split_await_expr = null;
                plan.await_points[idx_ret_plain].operand = ret_expr.await_expr_operand;
                plan.await_points[idx_ret_plain].bind_name = null;
                plan.await_points[idx_ret_plain].bind_type = null;
                plan.await_points[idx_ret_plain].parent_block = parent_block;
                plan.await_points[idx_ret_plain].stmt_index = parent_stmt_index;
                plan.await_points[idx_ret_plain].enclosing_while = enclosing_while;
                plan.await_points[idx_ret_plain].enclosing_for = enclosing_for;
                plan.await_points[idx_ret_plain].cleanup_region = current_cleanup_region;
                plan.await_points[idx_ret_plain].is_return_await = 1;
                plan.return_stmt = node;
                plan.return_expr = null;
            }
            return;
        }
        if ret_expr != null && ret_expr.type == ASTNodeType.AST_TRY_EXPR && ret_expr.try_expr_operand != null {
            const ret_op: &ASTNode = ret_expr.try_expr_operand;
            if ret_op.type == ASTNodeType.AST_AWAIT_EXPR && ret_op.await_expr_operand != null {
                const idx_ret_try: i32 = async_lower_claim_await_slot(plan, arena);
                if idx_ret_try >= 0 {
                    async_lower_note_prefix_stmt_count(plan, root_stmt_index);
                    plan.await_points[idx_ret_try].source_stmt = node;
                    plan.await_points[idx_ret_try].split_try_expr = ret_expr;
                    plan.await_points[idx_ret_try].split_await_expr = null;
                    plan.await_points[idx_ret_try].operand = ret_op.await_expr_operand;
                    plan.await_points[idx_ret_try].bind_name = null;
                    plan.await_points[idx_ret_try].bind_type = null;
                    plan.await_points[idx_ret_try].parent_block = parent_block;
                    plan.await_points[idx_ret_try].stmt_index = parent_stmt_index;
                    plan.await_points[idx_ret_try].enclosing_while = enclosing_while;
                    plan.await_points[idx_ret_try].enclosing_for = enclosing_for;
                    plan.await_points[idx_ret_try].cleanup_region = current_cleanup_region;
                    plan.await_points[idx_ret_try].is_return_await = 1;
                    plan.return_stmt = node;
                    plan.return_expr = null;
                }
                return;
            }
        }
        plan.return_stmt = node;
        plan.return_expr = ret_expr;
    }

    if node.type != ASTNodeType.AST_BLOCK && node.type != ASTNodeType.AST_IF_STMT &&
        node.type != ASTNodeType.AST_WHILE_STMT && node.type != ASTNodeType.AST_FOR_STMT {
        var nested_await: &ASTNode = null;
        var nested_try: &ASTNode = null;
        if async_lower_find_first_split_await_expr(node, &nested_await, &nested_try) != 0 &&
            nested_await != null && nested_await.await_expr_operand != null {
            const idx_nested: i32 = async_lower_claim_await_slot(plan, arena);
            if idx_nested >= 0 {
                async_lower_note_prefix_stmt_count(plan, root_stmt_index);
                plan.await_points[idx_nested].source_stmt = node;
                plan.await_points[idx_nested].split_try_expr = nested_try;
                if nested_try != null {
                    plan.await_points[idx_nested].split_await_expr = null;
                } else {
                    plan.await_points[idx_nested].split_await_expr = nested_await;
                }
                plan.await_points[idx_nested].operand = nested_await.await_expr_operand;
                plan.await_points[idx_nested].bind_name = null;
                if nested_try != null {
                    plan.await_points[idx_nested].bind_type = async_lower_infer_compound_bind_type(checker, node, nested_try);
                } else {
                    plan.await_points[idx_nested].bind_type = async_lower_find_raw_await_bind_type(checker, node, nested_await);
                    if plan.await_points[idx_nested].bind_type == null {
                        plan.await_points[idx_nested].bind_type = async_lower_await_expr_result_type(checker, nested_await);
                    }
                }
                plan.await_points[idx_nested].parent_block = parent_block;
                plan.await_points[idx_nested].stmt_index = parent_stmt_index;
                plan.await_points[idx_nested].enclosing_while = enclosing_while;
                plan.await_points[idx_nested].enclosing_for = enclosing_for;
                plan.await_points[idx_nested].cleanup_region = current_cleanup_region;
                plan.await_points[idx_nested].is_return_await = 0;
            }
            return;
        }
    }
}

export fn async_lower_build_plan(
    plan: &AsyncLowerPlan,
    arena: &CompilerArena,
    checker: &TypeChecker,
    body: &ASTNode
) i32 {
    if plan == null {
        return -1;
    }
    plan.await_points = null;
    plan.await_count = 0;
    plan.await_capacity = 0;
    plan.cleanup_regions = null;
    plan.cleanup_region_count = 0;
    plan.cleanup_region_capacity = 0;
    plan.root_cleanup_region = -1;
    plan.prefix_stmt_count = -1;
    plan.terminal_state = 1;
    plan.return_stmt = null;
    plan.return_expr = null;
    plan.has_loop = 0;
    if body == null {
        return 0;
    }
    if body.type == ASTNodeType.AST_BLOCK && body.block_stmts != null {
        plan.root_cleanup_region = async_lower_register_cleanup_region(plan, arena, body, -1);
        var i: i32 = 0;
        while i < body.block_stmt_count {
            async_lower_collect_plan_node(plan, arena, checker, body.block_stmts[i], body, i, null, null, i, plan.root_cleanup_region);
            i = i + 1;
        }
    } else {
        async_lower_collect_plan_node(plan, arena, checker, body, null, -1, null, null, 0, -1);
    }
    async_lower_assign_state_numbers(plan);
    if plan.prefix_stmt_count < 0 {
        if body.type == ASTNodeType.AST_BLOCK && body.block_stmts != null {
            plan.prefix_stmt_count = body.block_stmt_count;
        } else {
            plan.prefix_stmt_count = 0;
        }
    }
    return 0;
}
