use compiler_driver;
use microapp;
use std.runtime.get_argc;
use std.runtime.get_argv;
use libc;

fn microapp_print_usage(program_name: &byte) void {
    var name: &byte = program_name;
    if name == null {
        name = "uya microapp" as *byte;
    }
    fprintf(libc.stderr, "Uya microapp CLI\n" as *byte);
    fprintf(libc.stderr, "用法:\n" as *byte);
    fprintf(libc.stderr, "  %s build <file> -o <out.pobj|out.uapp> [options]\n" as *byte, name as *byte);
    fprintf(libc.stderr, "  %s pack <in.pobj> -o <out.uapp>\n" as *byte, name as *byte);
    fprintf(libc.stderr, "  %s inspect <in.pobj|in.uapp>\n" as *byte, name as *byte);
    fprintf(libc.stderr, "  %s verify <in.pobj|in.uapp>\n" as *byte, name as *byte);
    fprintf(libc.stderr, "  %s run <file> [options] [-- <args>...]\n" as *byte, name as *byte);
    fprintf(libc.stderr, "\n选项:\n" as *byte);
    fprintf(libc.stderr, "  --microapp-profile <name>  覆盖 microapp target profile\n" as *byte);
    fprintf(libc.stderr, "  --c99                      build 时输出 C99\n" as *byte);
    fprintf(libc.stderr, "  --no-safety-proof          build/run 时禁用安全证明\n" as *byte);
    fprintf(libc.stderr, "  -o <file>                  指定输出文件\n" as *byte);
    fprintf(libc.stderr, "\n微应用环境变量:\n" as *byte);
    fprintf(libc.stderr, "  MICROAPP_TARGET_PROFILE=linux_x86_64_hardvm\n" as *byte);
    fprintf(libc.stderr, "  MICROAPP_TARGET_ARCH=x86_64\n" as *byte);
    fprintf(libc.stderr, "  MICROAPP_TARGET_GCC / TARGET_GCC\n" as *byte);
    fprintf(libc.stderr, "  默认 profile 推导优先级：--microapp-profile > MICROAPP_TARGET_PROFILE > MICROAPP_TARGET_ARCH(+TARGET_OS) > TARGET_OS/TARGET_ARCH > HOST_OS/HOST_ARCH > linux_x86_64_hardvm\n" as *byte);
}

fn microapp_arg_is_help(arg: &byte) i32 {
    if arg == null {
        return 0;
    }
    if strcmp(arg as *byte, "--help" as *byte) == 0 || strcmp(arg as *byte, "-h" as *byte) == 0 {
        return 1;
    }
    return 0;
}

fn microapp_unknown_option(subcommand: &byte, arg: &byte) i32 {
    fprintf(libc.stderr, "错误: microapp %s 不支持参数 %s\n" as *byte, subcommand as *byte, arg as *byte);
    return 1;
}

fn microapp_pack_cli() i32 {
    const argc: i32 = get_argc();
    var input_path: &byte = null;
    var output_path: &byte = null;
    var i: i32 = 2;
    while i < argc {
        const arg: &byte = get_argv(i);
        if arg == null {
            fprintf(libc.stderr, "错误: 无法获取 microapp pack 参数（索引 %d）\n" as *byte, i);
            return 1;
        }
        if strcmp(arg as *byte, "-o" as *byte) == 0 {
            if i + 1 >= argc {
                fprintf(libc.stderr, "错误: microapp pack 需要 -o 指定输出 .uapp 路径\n" as *byte);
                return 1;
            }
            i = i + 1;
            output_path = get_argv(i);
            if output_path == null {
                fprintf(libc.stderr, "错误: 无法获取 microapp pack 输出路径\n" as *byte);
                return 1;
            }
        } else if arg[0] == 45 as byte {
            return microapp_unknown_option("pack" as &byte, arg);
        } else {
            if input_path != null {
                fprintf(libc.stderr, "错误: microapp pack 只接受一个 .pobj 输入文件\n" as *byte);
                return 1;
            }
            input_path = arg;
        }
        i = i + 1;
    }
    if input_path == null {
        fprintf(libc.stderr, "错误: microapp pack 需要一个 .pobj 输入文件\n" as *byte);
        return 1;
    }
    if output_path == null {
        fprintf(libc.stderr, "错误: microapp pack 需要 -o 指定输出 .uapp 路径\n" as *byte);
        return 1;
    }
    const result: i32 = pack_microapp_pobj_to_uapp(input_path, output_path);
    if result != 0 {
        return result;
    }
    fprintf(libc.stderr, "microapp pack 完成: %s -> %s\n" as *byte, input_path as *byte, output_path as *byte);
    return 0;
}

fn microapp_inspect_cli() i32 {
    const argc: i32 = get_argc();
    var input_path: &byte = null;
    var i: i32 = 2;
    while i < argc {
        const arg: &byte = get_argv(i);
        if arg == null {
            fprintf(libc.stderr, "错误: 无法获取 microapp inspect 参数（索引 %d）\n" as *byte, i);
            return 1;
        }
        if arg[0] == 45 as byte {
            return microapp_unknown_option("inspect" as &byte, arg);
        }
        if input_path != null {
            fprintf(libc.stderr, "错误: microapp inspect 只接受一个输入文件\n" as *byte);
            return 1;
        }
        input_path = arg;
        i = i + 1;
    }
    if input_path == null {
        fprintf(libc.stderr, "错误: microapp inspect 需要一个 .pobj 或 .uapp 输入文件\n" as *byte);
        return 1;
    }
    return inspect_microapp_image(input_path);
}

fn microapp_verify_cli() i32 {
    const argc: i32 = get_argc();
    var input_path: &byte = null;
    var i: i32 = 2;
    while i < argc {
        const arg: &byte = get_argv(i);
        if arg == null {
            fprintf(libc.stderr, "错误: 无法获取 microapp verify 参数（索引 %d）\n" as *byte, i);
            return 1;
        }
        if arg[0] == 45 as byte {
            return microapp_unknown_option("verify" as &byte, arg);
        }
        if input_path != null {
            fprintf(libc.stderr, "错误: microapp verify 只接受一个输入文件\n" as *byte);
            return 1;
        }
        input_path = arg;
        i = i + 1;
    }
    if input_path == null {
        fprintf(libc.stderr, "错误: microapp verify 需要一个 .pobj 或 .uapp 输入文件\n" as *byte);
        return 1;
    }
    return verify_microapp_image(input_path);
}

fn microapp_cli_main() i32 {
    const argc: i32 = get_argc();
    const program_name: &byte = get_argv(0);
    if argc <= 1 {
        microapp_print_usage(program_name);
        return 1;
    }
    const subcommand: &byte = get_argv(1);
    if subcommand == null {
        microapp_print_usage(program_name);
        return 1;
    }
    if strcmp(subcommand as *byte, "--help" as *byte) == 0 || strcmp(subcommand as *byte, "-h" as *byte) == 0 {
        microapp_print_usage(program_name);
        return 0;
    }
    if argc == 3 && microapp_arg_is_help(get_argv(2)) != 0 {
        microapp_print_usage(program_name);
        return 0;
    }
    if strcmp(subcommand as *byte, "build" as *byte) == 0 {
        return compiler_driver_microapp_build_main();
    }
    if strcmp(subcommand as *byte, "pack" as *byte) == 0 {
        return microapp_pack_cli();
    }
    if strcmp(subcommand as *byte, "inspect" as *byte) == 0 {
        return microapp_inspect_cli();
    }
    if strcmp(subcommand as *byte, "verify" as *byte) == 0 {
        return microapp_verify_cli();
    }
    if strcmp(subcommand as *byte, "run" as *byte) == 0 {
        return compiler_driver_microapp_run_main();
    }
    fprintf(libc.stderr, "错误: 未知 microapp 子命令: %s\n" as *byte, subcommand as *byte);
    microapp_print_usage(program_name);
    return 1;
}

/// `cmd/microapp` 独立可执行入口。
/// 参数说明：无，直接读取进程 argv。
/// 返回值说明：返回 microapp CLI 的退出码。
export fn main() i32 {
    return microapp_cli_main();
}
