// checker/lookup.uya - 声明查找函数
// 从 checker/main.uya 拆分

const CHECKER_LOOKUP_CACHE_BITS: i32 = 11;
const CHECKER_LOOKUP_CACHE_SIZE: i32 = 2048;
const CHECKER_LOOKUP_CACHE_MASK: i32 = 2047;

var g_lookup_cached_program: &ASTNode = null;
var g_lookup_cached_decl_count: i32 = -1;
var g_lookup_cache_initialized: i32 = 0;
var g_lookup_semantic_program: &ASTNode = null;
var g_lookup_semantic_db: &SemanticDb = null;
var g_lookup_semantic_oracle_checked: i32 = 0;
var g_lookup_semantic_oracle_active: i32 = 0;
var g_lookup_enum_decl_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_struct_decl_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_type_alias_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_union_decl_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_interface_decl_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_fn_decl_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_method_block_struct_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];
var g_lookup_method_block_union_cache: [&ASTNode: CHECKER_LOOKUP_CACHE_SIZE] = [];

fn reset_program_lookup_caches() void {
    var i: i32 = 0;
    while i < CHECKER_LOOKUP_CACHE_SIZE {
        g_lookup_enum_decl_cache[i] = null;
        g_lookup_struct_decl_cache[i] = null;
        g_lookup_type_alias_cache[i] = null;
        g_lookup_union_decl_cache[i] = null;
        g_lookup_interface_decl_cache[i] = null;
        g_lookup_fn_decl_cache[i] = null;
        g_lookup_method_block_struct_cache[i] = null;
        g_lookup_method_block_union_cache[i] = null;
        i = i + 1;
    }
    g_lookup_cached_program = null;
    g_lookup_cached_decl_count = -1;
    g_lookup_cache_initialized = 0;
}

fn checker_clear_semantic_lookup_db() void {
    g_lookup_semantic_program = null;
    g_lookup_semantic_db = null;
}

fn checker_register_semantic_lookup_db(program_node: &ASTNode, db: &SemanticDb) void {
    if program_node == null || db == null || program_node.type != ASTNodeType.AST_PROGRAM {
        g_lookup_semantic_program = null;
        g_lookup_semantic_db = null;
        return;
    }
    g_lookup_semantic_program = program_node;
    g_lookup_semantic_db = db;
}

fn lookup_decl_cache_slot(name: &byte) i32 {
    if name == null {
        return 0;
    }
    return (hash_string(name) & CHECKER_LOOKUP_CACHE_MASK) as i32;
}

fn lookup_name_matches_exact_or_generic_base(decl_name: &byte, query_name: &byte) i32 {
    if decl_name == null || query_name == null {
        return 0;
    }
    if str_equals(decl_name, query_name) != 0 {
        return 1;
    }
    const qlen_tmp: !i32 = strlen(query_name as *byte) as! i32;
    const dlen_tmp: !i32 = strlen(decl_name as *byte) as! i32;
    const qlen: i32 = qlen_tmp.value;
    const dlen: i32 = dlen_tmp.value;
    const decl_ptr: *byte = decl_name as *byte;
    if dlen > qlen && strncmp(decl_name as *byte, query_name as *byte, qlen) == 0 && decl_ptr[qlen] == 60 {
        return 1;
    }
    return 0;
}

fn lookup_semantic_lookup_active(program_node: &ASTNode) i32 {
    if program_node != null && g_lookup_semantic_program == program_node && g_lookup_semantic_db != null {
        return 1;
    }
    return 0;
}

fn lookup_semantic_oracle_enabled() i32 {
    if g_lookup_semantic_oracle_checked != 0 {
        return g_lookup_semantic_oracle_active;
    }
    g_lookup_semantic_oracle_checked = 1;
    const value: *byte = getenv("UYA_SEMANTIC_LOOKUP_ORACLE" as *byte);
    if value == null {
        return 0;
    }
    if value[0] == 49 as byte && value[1] == 0 as byte {
        g_lookup_semantic_oracle_active = 1;
    }
    return g_lookup_semantic_oracle_active;
}

fn lookup_debug_name(value: &byte) &byte {
    if value == null {
        return "(null)" as &byte;
    }
    return value;
}

fn lookup_ast_addr(node: &ASTNode) usize {
    if node == null {
        return 0 as usize;
    }
    return @usize_from_ptr(node as &void);
}

fn lookup_report_decl_oracle_mismatch(kind: &byte, name: &byte, semantic_decl: &ASTNode, oracle_decl: &ASTNode) void {
    fprintf(libc.stderr,
        "semantic_lookup_oracle mismatch kind=%s name=%s semantic=%zu oracle=%zu\n" as *byte,
        kind as *byte,
        lookup_debug_name(name) as *byte,
        lookup_ast_addr(semantic_decl),
        lookup_ast_addr(oracle_decl));
}

fn lookup_compare_decl_oracle(kind: &byte, name: &byte, semantic_decl: &ASTNode, oracle_decl: &ASTNode) void {
    if semantic_decl == oracle_decl {
        return;
    }
    lookup_report_decl_oracle_mismatch(kind, name, semantic_decl, oracle_decl);
}

fn lookup_compare_enum_variant_oracle(name: &byte, semantic_value: i32, oracle_value: i32) void {
    if semantic_value == oracle_value {
        return;
    }
    fprintf(libc.stderr,
        "semantic_lookup_oracle mismatch kind=enum_variant name=%s semantic=%d oracle=%d\n" as *byte,
        lookup_debug_name(name) as *byte,
        semantic_value,
        oracle_value);
}

fn ensure_program_lookup_caches(program_node: &ASTNode) void {
    if program_node == null || program_node.type != ASTNodeType.AST_PROGRAM {
        return;
    }
    if g_lookup_cache_initialized != 0 &&
        g_lookup_cached_program == program_node &&
        g_lookup_cached_decl_count == program_node.program_decl_count {
        return;
    }
    reset_program_lookup_caches();
    var i: i32 = 0;
    while i < program_node.program_decl_count {
        const decl: &ASTNode = program_node.program_decls[i];
        if decl == null {
            i = i + 1;
            continue;
        }
        if decl.type == ASTNodeType.AST_ENUM_DECL && decl.enum_decl_name != null {
            const enum_slot: i32 = lookup_decl_cache_slot(decl.enum_decl_name);
            if enum_slot >= 0 && enum_slot < CHECKER_LOOKUP_CACHE_SIZE {
                g_lookup_enum_decl_cache[enum_slot] = decl;
            }
        } else if decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_name != null {
            const struct_slot: i32 = lookup_decl_cache_slot(decl.struct_decl_name);
            if struct_slot >= 0 && struct_slot < CHECKER_LOOKUP_CACHE_SIZE {
                g_lookup_struct_decl_cache[struct_slot] = decl;
            }
        } else if decl.type == ASTNodeType.AST_TYPE_ALIAS && decl.type_alias_name != null {
            const type_alias_slot: i32 = lookup_decl_cache_slot(decl.type_alias_name);
            if type_alias_slot >= 0 && type_alias_slot < CHECKER_LOOKUP_CACHE_SIZE {
                g_lookup_type_alias_cache[type_alias_slot] = decl;
            }
        } else if decl.type == ASTNodeType.AST_UNION_DECL && decl.union_decl_name != null {
            const union_slot: i32 = lookup_decl_cache_slot(decl.union_decl_name);
            if union_slot >= 0 && union_slot < CHECKER_LOOKUP_CACHE_SIZE {
                g_lookup_union_decl_cache[union_slot] = decl;
            }
        } else if decl.type == ASTNodeType.AST_INTERFACE_DECL && decl.interface_decl_name != null {
            const interface_slot: i32 = lookup_decl_cache_slot(decl.interface_decl_name);
            if interface_slot >= 0 && interface_slot < CHECKER_LOOKUP_CACHE_SIZE {
                g_lookup_interface_decl_cache[interface_slot] = decl;
            }
        } else if decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null {
            const fn_slot: i32 = lookup_decl_cache_slot(decl.fn_decl_name);
            if fn_slot >= 0 && fn_slot < CHECKER_LOOKUP_CACHE_SIZE {
                g_lookup_fn_decl_cache[fn_slot] = decl;
            }
        } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
            if decl.method_block_struct_name != null {
                const method_block_struct_slot: i32 = lookup_decl_cache_slot(decl.method_block_struct_name);
                if method_block_struct_slot >= 0 && method_block_struct_slot < CHECKER_LOOKUP_CACHE_SIZE {
                    g_lookup_method_block_struct_cache[method_block_struct_slot] = decl;
                }
            }
            if decl.method_block_union_name != null {
                const method_block_union_slot: i32 = lookup_decl_cache_slot(decl.method_block_union_name);
                if method_block_union_slot >= 0 && method_block_union_slot < CHECKER_LOOKUP_CACHE_SIZE {
                    g_lookup_method_block_union_cache[method_block_union_slot] = decl;
                }
            }
        }
        i = i + 1;
    }
    g_lookup_cached_program = program_node;
    g_lookup_cached_decl_count = program_node.program_decl_count;
    g_lookup_cache_initialized = 1;
}

// ===== 枚举查找 =====

fn lookup_find_enum_decl_from_semantic_db(program_node: &ASTNode, enum_name: &byte) &ASTNode {
    if program_node == null || enum_name == null ||
        g_lookup_semantic_program != program_node || g_lookup_semantic_db == null {
        return null;
    }
    const name_id: i32 = semantic_db_find_interned_name(g_lookup_semantic_db, enum_name);
    if name_id < 0 {
        return null;
    }
    var range: SemanticTypeDeclRange = SemanticTypeDeclRange{
        name_id: -1,
        type_start: -1,
        type_count: -1,
    };
    if semantic_db_find_type_decl_range(g_lookup_semantic_db, name_id, &range) == 0 {
        return null;
    }
    var offset: i32 = 0;
    while offset < range.type_count {
        const decl_id: i32 = semantic_db_type_range_decl_id(g_lookup_semantic_db, &range, offset);
        if decl_id >= 0 {
            const decl: &ASTNode = semantic_db_decl_ast_node(g_lookup_semantic_db, decl_id);
            if decl != null && decl.type == ASTNodeType.AST_ENUM_DECL &&
                decl.enum_decl_name != null && str_equals(decl.enum_decl_name, enum_name) != 0 {
                return decl;
            }
        }
        offset = offset + 1;
    }
    return null;
}

fn lookup_scan_enum_decl_from_program(program_node: &ASTNode, enum_name: &byte) &ASTNode {
    var i: i32 = 0;
    while i < program_node.program_decl_count {
        const decl: &ASTNode = program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_ENUM_DECL {
            if decl.enum_decl_name != null && str_equals(decl.enum_decl_name, enum_name) != 0 {
                return decl;
            }
        }
        i = i + 1;
    }
    return null;
}

// 从程序节点中查找枚举声明
fn find_enum_decl_from_program(program_node: &ASTNode, enum_name: &byte) &ASTNode {
    if program_node == null || program_node.type != ASTNodeType.AST_PROGRAM || enum_name == null {
        return null;
    }
    const semantic_enum: &ASTNode = lookup_find_enum_decl_from_semantic_db(program_node, enum_name);
    if lookup_semantic_oracle_enabled() != 0 && lookup_semantic_lookup_active(program_node) != 0 {
        const oracle_enum: &ASTNode = lookup_scan_enum_decl_from_program(program_node, enum_name);
        lookup_compare_decl_oracle("enum" as &byte, enum_name, semantic_enum, oracle_enum);
        if semantic_enum != null {
            return semantic_enum;
        }
        return oracle_enum;
    }
    if semantic_enum != null {
        return semantic_enum;
    }
    if lookup_semantic_lookup_active(program_node) != 0 {
        return null;
    }
    ensure_program_lookup_caches(program_node);
    var cached: &ASTNode = null;
    const enum_slot: i32 = lookup_decl_cache_slot(enum_name);
    if enum_slot >= 0 && enum_slot < CHECKER_LOOKUP_CACHE_SIZE {
        cached = g_lookup_enum_decl_cache[enum_slot];
    }
    if cached != null && cached.type == ASTNodeType.AST_ENUM_DECL &&
        cached.enum_decl_name != null && str_equals(cached.enum_decl_name, enum_name) != 0 {
        return cached;
    }
    return lookup_scan_enum_decl_from_program(program_node, enum_name);
}

// 检查 name 是否是程序中任意枚举的变体名
fn lookup_is_enum_variant_name_from_semantic_db(program_node: &ASTNode, name: &byte) i32 {
    if program_node == null || name == null ||
        g_lookup_semantic_program != program_node || g_lookup_semantic_db == null {
        return 0;
    }
    const name_id: i32 = semantic_db_find_interned_name(g_lookup_semantic_db, name);
    if name_id < 0 {
        return 0;
    }
    var range: SemanticEnumVariantRange = SemanticEnumVariantRange{
        name_id: -1,
        variant_start: -1,
        variant_count: -1,
    };
    if semantic_db_find_enum_variant_range(g_lookup_semantic_db, name_id, &range) == 0 {
        return 0;
    }
    var offset: i32 = 0;
    while offset < range.variant_count {
        const record_id: i32 = semantic_db_enum_variant_range_record_id(g_lookup_semantic_db, &range, offset);
        if record_id >= 0 {
            var record: SemanticEnumVariantRecord = SemanticEnumVariantRecord{
                name_id: -1,
                enum_decl_id: -1,
                variant_index: -1,
            };
            if semantic_db_enum_variant_record_get(g_lookup_semantic_db, record_id, &record) != 0 &&
                record.name_id == name_id {
                return 1;
            }
        }
        offset = offset + 1;
    }
    return 0;
}

fn lookup_scan_is_enum_variant_name_in_program(program_node: &ASTNode, name: &byte) i32 {
    var i: i32 = 0;
    while i < program_node.program_decl_count {
        const decl: &ASTNode = program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_ENUM_DECL && decl.enum_decl_variants != null {
            var j: i32 = 0;
            while j < decl.enum_decl_variant_count {
                if decl.enum_decl_variants[j].name != null &&
                    str_equals(decl.enum_decl_variants[j].name, name) != 0 {
                    return 1;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn is_enum_variant_name_in_program(program_node: &ASTNode, name: &byte) i32 {
    if program_node == null || program_node.type != ASTNodeType.AST_PROGRAM || name == null {
        return 0;
    }
    const semantic_variant: i32 = lookup_is_enum_variant_name_from_semantic_db(program_node, name);
    if lookup_semantic_oracle_enabled() != 0 && lookup_semantic_lookup_active(program_node) != 0 {
        const oracle_variant: i32 = lookup_scan_is_enum_variant_name_in_program(program_node, name);
        lookup_compare_enum_variant_oracle(name, semantic_variant, oracle_variant);
        if semantic_variant != 0 {
            return 1;
        }
        return oracle_variant;
    }
    if semantic_variant != 0 {
        return 1;
    }
    if lookup_semantic_lookup_active(program_node) != 0 {
        return 0;
    }
    return lookup_scan_is_enum_variant_name_in_program(program_node, name);
}

// ===== 结构体查找 =====

fn lookup_find_struct_decl_from_semantic_db(program_node: &ASTNode, struct_name: &byte) &ASTNode {
    if program_node == null || struct_name == null ||
        g_lookup_semantic_program != program_node || g_lookup_semantic_db == null {
        return null;
    }
    const name_id: i32 = semantic_db_find_interned_name(g_lookup_semantic_db, struct_name);
    if name_id < 0 {
        return null;
    }
    var range: SemanticTypeDeclRange = SemanticTypeDeclRange{
        name_id: -1,
        type_start: -1,
        type_count: -1,
    };
    if semantic_db_find_type_decl_range(g_lookup_semantic_db, name_id, &range) == 0 {
        return null;
    }
    var offset: i32 = 0;
    while offset < range.type_count {
        const decl_id: i32 = semantic_db_type_range_decl_id(g_lookup_semantic_db, &range, offset);
        if decl_id >= 0 {
            const decl: &ASTNode = semantic_db_decl_ast_node(g_lookup_semantic_db, decl_id);
            if decl != null && decl.type == ASTNodeType.AST_STRUCT_DECL &&
                lookup_name_matches_exact_or_generic_base(decl.struct_decl_name, struct_name) != 0 {
                return decl;
            }
        }
        offset = offset + 1;
    }
    return null;
}

fn lookup_scan_struct_decl_from_program(program_node: &ASTNode, struct_name: &byte) &ASTNode {
    var i: i32 = 0;
    while i < program_node.program_decl_count {
        const decl: &ASTNode = program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_name != null {
            if lookup_name_matches_exact_or_generic_base(decl.struct_decl_name, struct_name) != 0 {
                return decl;
            }
        }
        i = i + 1;
    }
    return null;
}

// 从程序节点中查找结构体声明（精确匹配 "Future" 或基名匹配 "Future<T>"）；codegen 用其预注册 from_json 内层 err_union
export fn find_struct_decl_from_program(program_node: &ASTNode, struct_name: &byte) &ASTNode {
    if program_node == null || program_node.type != ASTNodeType.AST_PROGRAM || struct_name == null {
        return null;
    }
    const semantic_struct: &ASTNode = lookup_find_struct_decl_from_semantic_db(program_node, struct_name);
    if lookup_semantic_oracle_enabled() != 0 && lookup_semantic_lookup_active(program_node) != 0 {
        const oracle_struct: &ASTNode = lookup_scan_struct_decl_from_program(program_node, struct_name);
        lookup_compare_decl_oracle("struct" as &byte, struct_name, semantic_struct, oracle_struct);
        if semantic_struct != null {
            return semantic_struct;
        }
        return oracle_struct;
    }
    if semantic_struct != null {
        return semantic_struct;
    }
    ensure_program_lookup_caches(program_node);
    var cached: &ASTNode = null;
    const struct_slot: i32 = lookup_decl_cache_slot(struct_name);
    if struct_slot >= 0 && struct_slot < CHECKER_LOOKUP_CACHE_SIZE {
        cached = g_lookup_struct_decl_cache[struct_slot];
    }
    if cached != null && cached.type == ASTNodeType.AST_STRUCT_DECL &&
        lookup_name_matches_exact_or_generic_base(cached.struct_decl_name, struct_name) != 0 {
        return cached;
    }
    return lookup_scan_struct_decl_from_program(program_node, struct_name);
}

// ===== 类型别名查找 =====

fn lookup_find_type_alias_from_semantic_db(program_node: &ASTNode, alias_name: &byte) &ASTNode {
    if program_node == null || alias_name == null ||
        g_lookup_semantic_program != program_node || g_lookup_semantic_db == null {
        return null;
    }
    const name_id: i32 = semantic_db_find_interned_name(g_lookup_semantic_db, alias_name);
    if name_id < 0 {
        return null;
    }
    var range: SemanticTypeDeclRange = SemanticTypeDeclRange{
        name_id: -1,
        type_start: -1,
        type_count: -1,
    };
    if semantic_db_find_type_decl_range(g_lookup_semantic_db, name_id, &range) == 0 {
        return null;
    }
    var offset: i32 = 0;
    while offset < range.type_count {
        const decl_id: i32 = semantic_db_type_range_decl_id(g_lookup_semantic_db, &range, offset);
        if decl_id >= 0 {
            const decl: &ASTNode = semantic_db_decl_ast_node(g_lookup_semantic_db, decl_id);
            if decl != null && decl.type == ASTNodeType.AST_TYPE_ALIAS &&
                decl.type_alias_name != null && str_equals(decl.type_alias_name, alias_name) != 0 {
                return decl;
            }
        }
        offset = offset + 1;
    }
    return null;
}

fn lookup_scan_type_alias_from_program(program_node: &ASTNode, alias_name: &byte) &ASTNode {
    var i: i32 = 0;
    while i < program_node.program_decl_count {
        const decl: &ASTNode = program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_TYPE_ALIAS {
            if decl.type_alias_name != null && str_equals(decl.type_alias_name, alias_name) != 0 {
                return decl;
            }
        }
        i = i + 1;
    }
    return null;
}

// 从程序节点中查找类型别名声明
fn find_type_alias_from_program(program_node: &ASTNode, alias_name: &byte) &ASTNode {
    if program_node == null || program_node.type != ASTNodeType.AST_PROGRAM || alias_name == null {
        return null;
    }
    const semantic_alias: &ASTNode = lookup_find_type_alias_from_semantic_db(program_node, alias_name);
    if lookup_semantic_oracle_enabled() != 0 && lookup_semantic_lookup_active(program_node) != 0 {
        const oracle_alias: &ASTNode = lookup_scan_type_alias_from_program(program_node, alias_name);
        lookup_compare_decl_oracle("type_alias" as &byte, alias_name, semantic_alias, oracle_alias);
        if semantic_alias != null {
            return semantic_alias;
        }
        return oracle_alias;
    }
    if semantic_alias != null {
        return semantic_alias;
    }
    if lookup_semantic_lookup_active(program_node) != 0 {
        return null;
    }
    ensure_program_lookup_caches(program_node);
    var cached: &ASTNode = null;
    const type_alias_slot: i32 = lookup_decl_cache_slot(alias_name);
    if type_alias_slot >= 0 && type_alias_slot < CHECKER_LOOKUP_CACHE_SIZE {
        cached = g_lookup_type_alias_cache[type_alias_slot];
    }
    if cached != null && cached.type == ASTNodeType.AST_TYPE_ALIAS &&
        cached.type_alias_name != null && str_equals(cached.type_alias_name, alias_name) != 0 {
        return cached;
    }
    return lookup_scan_type_alias_from_program(program_node, alias_name);
}

