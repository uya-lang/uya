fn checker_ast_node_ref_at(vec: &SemanticVector, idx: i32) &AstNodeRefEntry {
    if vec == null || idx < 0 {
        return null;
    }
    const index: usize = idx as usize;
    if index >= vec.count {
        return null;
    }
    return semantic_vector_item_ptr(vec, index) as &AstNodeRefEntry;
}

fn checker_fn_root_decl_at(checker: &TypeChecker, idx: i32) &ASTNode {
    if checker == null {
        return null;
    }
    const entry: &AstNodeRefEntry = checker_ast_node_ref_at(&checker.fn_root_decls, idx);
    if entry == null {
        return null;
    }
    return entry.decl;
}

fn checker_reachable_fn_decl_at(checker: &TypeChecker, idx: i32) &ASTNode {
    if checker == null {
        return null;
    }
    const entry: &AstNodeRefEntry = checker_ast_node_ref_at(&checker.reachable_fn_decls, idx);
    if entry == null {
        return null;
    }
    return entry.decl;
}

fn checker_ast_node_ref_append(vec: &SemanticVector, decl: &ASTNode) i32 {
    if vec == null || decl == null {
        return -1;
    }
    var entry: AstNodeRefEntry = AstNodeRefEntry{
        decl: decl,
    };
    return semantic_vector_append(vec, &entry as &const void);
}

fn checker_empty_vector() SemanticVector {
    return SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
}

// ===== 初始化函数 =====

fn checker_semantic_cache_has_layout(checker: &TypeChecker) i32 {
    if checker == null {
        return 0;
    }
    if checker.semantic_db.file_records.item_size != @size_of(SemanticFileRecord) {
        return 0;
    }
    if checker.semantic_db.module_records.item_size != @size_of(SemanticModuleRecord) {
        return 0;
    }
    if checker.semantic_db.decl_records.item_size != @size_of(SemanticDeclRecord) {
        return 0;
    }
    if checker.semantic_db.symbol_records.item_size != @size_of(SemanticSymbolRecord) {
        return 0;
    }
    if checker.semantic_db.name_ranges.item_size != @size_of(SemanticNameRange) {
        return 0;
    }
    if checker.semantic_db.decl_ranges.item_size != @size_of(SemanticDeclRange) {
        return 0;
    }
    if checker.semantic_db.decl_range_ids.item_size != @size_of(i32) {
        return 0;
    }
    if checker.semantic_db.function_ranges.item_size != @size_of(SemanticFunctionOverloadRange) {
        return 0;
    }
    if checker.semantic_db.function_range_decl_ids.item_size != @size_of(i32) {
        return 0;
    }
    if checker.semantic_db.type_ranges.item_size != @size_of(SemanticTypeDeclRange) {
        return 0;
    }
    if checker.semantic_db.type_range_decl_ids.item_size != @size_of(i32) {
        return 0;
    }
    if checker.semantic_db.global_var_ranges.item_size != @size_of(SemanticGlobalVarRange) {
        return 0;
    }
    if checker.semantic_db.global_var_range_decl_ids.item_size != @size_of(i32) {
        return 0;
    }
    if checker.semantic_db.enum_variant_records.item_size != @size_of(SemanticEnumVariantRecord) {
        return 0;
    }
    if checker.semantic_db.enum_variant_ranges.item_size != @size_of(SemanticEnumVariantRange) {
        return 0;
    }
    if checker.semantic_db.enum_variant_range_record_ids.item_size != @size_of(i32) {
        return 0;
    }
    if checker.semantic_db.import_bindings.item_size != @size_of(SemanticImportBinding) {
        return 0;
    }
    if checker.semantic_db.export_bindings.item_size != @size_of(SemanticExportBinding) {
        return 0;
    }
    if checker.semantic_db.name_range_index.capacity < checker.semantic_db.name_range_index.count {
        return 0;
    }
    if checker.semantic_db.decls_by_name.capacity < checker.semantic_db.decls_by_name.count {
        return 0;
    }
    if checker.semantic_db.functions_by_name.capacity < checker.semantic_db.functions_by_name.count {
        return 0;
    }
    if checker.semantic_db.types_by_name.capacity < checker.semantic_db.types_by_name.count {
        return 0;
    }
    if checker.semantic_db.global_vars_by_name.capacity < checker.semantic_db.global_vars_by_name.count {
        return 0;
    }
    if checker.semantic_db.enum_variants_by_name.capacity < checker.semantic_db.enum_variants_by_name.count {
        return 0;
    }
    if checker.semantic_db.exports_by_module_name.capacity < checker.semantic_db.exports_by_module_name.count {
        return 0;
    }
    if checker.semantic_db.aliases_by_file_name.capacity < checker.semantic_db.aliases_by_file_name.count {
        return 0;
    }
    if checker.semantic_db.use_items_by_file_name.capacity < checker.semantic_db.use_items_by_file_name.count {
        return 0;
    }
    return 1;
}

fn checker_typed_program_has_layout(checker: &TypeChecker) i32 {
    if checker == null {
        return 0;
    }
    if checker.typed_program.expr_types.item_size != @size_of(TypeId) {
        return 0;
    }
    if checker.typed_program.identifier_bindings.item_size != @size_of(SymbolId) {
        return 0;
    }
    if checker.typed_program.call_targets.item_size != @size_of(TypedCallTarget) {
        return 0;
    }
    if checker.typed_program.method_dispatch.item_size != @size_of(TypedMethodDispatch) {
        return 0;
    }
    if checker.typed_program.field_access.item_size != @size_of(FieldId) {
        return 0;
    }
    if checker.typed_program.global_init_order.item_size != @size_of(GlobalId) {
        return 0;
    }
    if checker.typed_program.reachable_roots.item_size != @size_of(FunctionId) {
        return 0;
    }
    if checker.typed_program.proof_results.item_size != @size_of(TypedProofResult) {
        return 0;
    }
    if checker.typed_type_records.item_size != @size_of(Type) {
        return 0;
    }
    return 1;
}

fn checker_reset_semantic_cache(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    checker_clear_semantic_lookup_db();
    if checker_semantic_cache_has_layout(checker) != 0 {
        semantic_db_reset(&checker.semantic_db);
    } else {
        semantic_db_init(&checker.semantic_db);
    }
    if checker_typed_program_has_layout(checker) != 0 {
        typed_program_reset(&checker.typed_program);
        semantic_vector_reset(&checker.typed_type_records);
    } else {
        typed_program_init(&checker.typed_program);
        semantic_vector_init(&checker.typed_type_records, @size_of(Type));
    }
    checker.typed_backend_reentry_count = 0;
}

fn checker_semantic_dump_enabled() i32 {
    const value: *byte = getenv("UYA_DUMP_SEMANTIC_DB" as *byte);
    if value == null {
        return 0;
    }
    if value[0] == 49 as byte && value[1] == 0 as byte {
        return 1;
    }
    return 0;
}

fn checker_semantic_dump_name(value: &byte) &byte {
    if value == null {
        return "(null)" as &byte;
    }
    return value;
}

fn checker_dump_semantic_db_records(db: &SemanticDb) void {
    if db == null {
        return;
    }
    var i: i32 = 0;
    while i < semantic_db_file_record_count(db) && i < 8 {
        fprintf(libc.stderr, "  file[%d]=%s\n" as *byte, i, checker_semantic_dump_name(semantic_db_file_name(db, i)) as *byte);
        i = i + 1;
    }
    i = 0;
    while i < semantic_db_import_binding_count(db) && i < 8 {
        var import_binding: SemanticImportBinding = SemanticImportBinding{ file_id: -1, module_id: -1, name: null, ast_node: null };
        if semantic_db_import_binding_get(db, i, &import_binding) != 0 {
            fprintf(libc.stderr, "  import[%d] file=%d module=%d name=%s\n" as *byte,
                i, import_binding.file_id, import_binding.module_id, checker_semantic_dump_name(import_binding.name) as *byte);
        }
        i = i + 1;
    }
    i = 0;
    while i < semantic_db_export_binding_count(db) && i < 8 {
        var export_binding: SemanticExportBinding = SemanticExportBinding{
            file_id: -1,
            module_id: -1,
            name: null,
            decl_id: -1,
            symbol_id: -1,
        };
        if semantic_db_export_binding_get(db, i, &export_binding) != 0 {
            fprintf(libc.stderr, "  export[%d] file=%d module=%d decl=%d symbol=%d name=%s\n" as *byte,
                i, export_binding.file_id, export_binding.module_id, export_binding.decl_id,
                export_binding.symbol_id, checker_semantic_dump_name(export_binding.name) as *byte);
        }
        i = i + 1;
    }
}

const CHECKER_SEMANTIC_LOAD_PPM_SCALE: usize = 1000000usize;

fn checker_semantic_load_ppm(count: usize, capacity: usize) usize {
    if capacity == 0usize {
        return 0usize;
    }
    if count > 9223372036854775807usize / CHECKER_SEMANTIC_LOAD_PPM_SCALE {
        return 9223372036854775807usize;
    }
    return (count * CHECKER_SEMANTIC_LOAD_PPM_SCALE) / capacity;
}

fn checker_dump_semantic_phase2_index(name: &byte, hash: &SemanticHash) void {
    if name == null || hash == null {
        return;
    }
    fprintf(libc.stderr, "phase2_index name=%s count=%zu capacity=%zu load_ppm=%zu reallocs=%d bytes=%zu\n" as *byte,
        name as *byte,
        hash.count,
        hash.capacity,
        checker_semantic_load_ppm(hash.count, hash.capacity),
        hash.realloc_count,
        hash.bytes);
}

fn checker_dump_semantic_phase2_indexes(db: &SemanticDb) void {
    if db == null {
        return;
    }
    checker_dump_semantic_phase2_index("decls_by_name" as &byte, &db.decls_by_name);
    checker_dump_semantic_phase2_index("functions_by_name" as &byte, &db.functions_by_name);
    checker_dump_semantic_phase2_index("types_by_name" as &byte, &db.types_by_name);
    checker_dump_semantic_phase2_index("global_vars_by_name" as &byte, &db.global_vars_by_name);
    checker_dump_semantic_phase2_index("enum_variants_by_name" as &byte, &db.enum_variants_by_name);
    checker_dump_semantic_phase2_index("exports_by_module_name" as &byte, &db.exports_by_module_name);
    checker_dump_semantic_phase2_index("aliases_by_file_name" as &byte, &db.aliases_by_file_name);
    checker_dump_semantic_phase2_index("use_items_by_file_name" as &byte, &db.use_items_by_file_name);
}

fn checker_dump_semantic_db(db: &SemanticDb) void {
    if db == null {
        return;
    }
    fprintf(libc.stderr, "=== semantic db ===\n" as *byte);
    fprintf(libc.stderr, "files=%d modules=%d decls=%d symbols=%d name_ranges=%d imports=%d exports=%d bytes=%zu\n" as *byte,
        semantic_db_file_record_count(db),
        semantic_db_module_record_count(db),
        semantic_db_decl_record_count(db),
        semantic_db_symbol_record_count(db),
        semantic_db_name_range_count(db),
        semantic_db_import_binding_count(db),
        semantic_db_export_binding_count(db),
        semantic_db_estimated_bytes(db));
    fprintf(libc.stderr, "table file=%zu/%zu module=%zu/%zu decl=%zu/%zu symbol=%zu/%zu name_range=%zu/%zu hash=%zu/%zu import=%zu/%zu export=%zu/%zu export_hash=%zu/%zu alias_hash=%zu/%zu use_hash=%zu/%zu reallocs=%d\n" as *byte,
        db.file_records.count, db.file_records.capacity,
        db.module_records.count, db.module_records.capacity,
        db.decl_records.count, db.decl_records.capacity,
        db.symbol_records.count, db.symbol_records.capacity,
        db.name_ranges.count, db.name_ranges.capacity,
        db.name_range_index.count, db.name_range_index.capacity,
        db.import_bindings.count, db.import_bindings.capacity,
        db.export_bindings.count, db.export_bindings.capacity,
        db.exports_by_module_name.count, db.exports_by_module_name.capacity,
        db.aliases_by_file_name.count, db.aliases_by_file_name.capacity,
        db.use_items_by_file_name.count, db.use_items_by_file_name.capacity,
        db.file_records.realloc_count + db.module_records.realloc_count + db.decl_records.realloc_count +
            db.symbol_records.realloc_count + db.name_ranges.realloc_count + db.name_range_index.realloc_count +
            db.import_bindings.realloc_count + db.export_bindings.realloc_count +
            db.exports_by_module_name.realloc_count + db.aliases_by_file_name.realloc_count +
            db.use_items_by_file_name.realloc_count);
    fprintf(libc.stderr, "global_var_range=%zu/%zu global_var_ids=%zu/%zu global_hash=%zu/%zu\n" as *byte,
        db.global_var_ranges.count, db.global_var_ranges.capacity,
        db.global_var_range_decl_ids.count, db.global_var_range_decl_ids.capacity,
        db.global_vars_by_name.count, db.global_vars_by_name.capacity);
    checker_dump_semantic_phase2_indexes(db);
    checker_dump_semantic_db_records(db);
    fprintf(libc.stderr, "=== semantic db end ===\n" as *byte);
}

fn checker_maybe_dump_semantic_db(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    if checker_semantic_dump_enabled() != 0 {
        checker_dump_semantic_db(&checker.semantic_db);
    }
}

// 初始化 TypeChecker
fn checker_init(checker: &TypeChecker, arena: &CompilerArena, default_filename: &byte) i32 {
    if checker == null || arena == null {
        return -1;
    }

    // `uya` 可能在同一进程里连续做两次完整编译（例如 exec unsupported 后回退 C99）。
    // 这些全局缓存若不清空，会因 arena 地址复用把上一轮 AST/Type 结果错误复用到下一轮。
    reset_program_lookup_caches();
    type_from_ast_reset_cache();
    mono_instance_index_reset();
    checker_capacity_warning_reset();
    checker_reset_semantic_cache(checker);
    checker.function_scope_index = function_scope_index_empty();
    if function_scope_index_init(&checker.function_scope_index) != 0 {
        return -1;
    }
    
    checker.arena = arena;
    
    checker_symbol_table_init(&checker.symbol_table);
    checker_function_table_init(&checker.function_table);
    checker_module_table_init(&checker.module_table);
    checker_import_table_init(&checker.import_table);

    // 初始化字符串池（所有桶设为null）
    var i: i32 = 0;
    while i < STRING_POOL_SIZE {
        checker.string_pool.buckets[i] = null;
        i = i + 1;
    }
    checker.string_pool.count = 0;

    // 初始化作用域链表头数组
    i = 0;
    while i < @len(checker.scope_heads) {
        checker.scope_heads[i] = null;
        i = i + 1;
    }
    semantic_vector_init(&checker.async_call_edges, @size_of(AsyncCallEdge));
    checker.async_call_edge_count = 0;
    semantic_vector_init(&checker.fn_call_edges, @size_of(FnCallEdge));
    checker.fn_call_edge_count = 0;
    semantic_vector_init(&checker.fn_root_decls, @size_of(AstNodeRefEntry));
    checker.fn_root_count = 0;
    semantic_vector_init(&checker.reachable_fn_decls, @size_of(AstNodeRefEntry));
    checker.reachable_fn_decl_count = 0;
    semantic_hash_init(&checker.reachability_visit_index);
    checker.reachability_visit_count = 0;

    checker.scope_level = 0;
    checker.loop_depth = 0;
    checker.program_node = null;
    checker.error_count = 0;
    checker.diagnostic_format_count = 0;
    checker.last_reported_error_filename = null;
    checker.last_reported_error_message = null;
    checker.last_reported_error_line = 0;
    checker.last_reported_error_column = 0;
    checker.default_filename = default_filename;
    checker.current_return_type.kind = TypeKind.TYPE_VOID;
    checker.in_function = 0;
    checker.in_defer_or_errdefer = 0;
    checker.current_function_decl = null;
    checker.current_self_type_name = null;
    checker.current_self_is_union = 0;
    semantic_vector_init(&checker.error_names, @size_of(ErrorNameEntry));
    checker.error_name_count = 0;
    semantic_vector_init(&checker.moved_names, @size_of(MovedNameEntry));
    checker.moved_count = 0;
    checker.module_root_dir = null;
    checker.uya_root_dir = null;
    
    // 初始化泛型相关字段
    checker.current_type_params = null;
    checker.current_type_param_count = 0;
    semantic_vector_init(&checker.mono_instances, @size_of(MonoInstance));
    checker.mono_instance_count = 0;
    
    if checker_proof_tables_init(checker) != 0 {
        return -1;
    }
    
    // 与 uya CLI 默认一致；compile_files 会按参数覆盖
    checker.enable_safety_proof = 1;
    checker.container_mode = 0;  // 默认 kernel 模式（允许 @asm/extern）

    // 证明超时机制：默认限制 1000 步
    checker.proof_step_limit = 1000;
    checker.proof_step_count = 0;
    checker.suppress_codegen_diagnostics = 0;
    
    return 0;
}

fn checker_find_reachable_fn_decl_by_name(checker: &TypeChecker, name: &byte) &ASTNode {
    if checker == null || name == null || checker.program_node == null ||
        checker.program_node.type != ASTNodeType.AST_PROGRAM {
        return null;
    }
    var i: i32 = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null &&
            str_equals(decl.fn_decl_name, name) != 0 && decl.fn_decl_body != null {
            return decl;
        }
        i = i + 1;
    }
    i = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null &&
            str_equals(decl.fn_decl_name, name) != 0 {
            return decl;
        }
        i = i + 1;
    }
    return null;
}

fn checker_canonicalize_fn_decl(checker: &TypeChecker, fn_decl: &ASTNode) &ASTNode {
    if checker == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL ||
        fn_decl.fn_decl_name == null || checker.program_node == null ||
        checker.program_node.type != ASTNodeType.AST_PROGRAM {
        return fn_decl;
    }
    var exact_i: i32 = 0;
    while exact_i < checker.program_node.program_decl_count {
        if checker.program_node.program_decls[exact_i] == fn_decl {
            return fn_decl;
        }
        exact_i = exact_i + 1;
    }
    var fn_has_body: i32 = 0;
    if fn_decl.fn_decl_body != null {
        fn_has_body = 1;
    }
    var i: i32 = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null &&
            str_equals(decl.fn_decl_name, fn_decl.fn_decl_name) != 0 &&
            decl.fn_decl_is_extern == fn_decl.fn_decl_is_extern {
            var decl_has_body: i32 = 0;
            if decl.fn_decl_body != null {
                decl_has_body = 1;
            }
            if decl_has_body == fn_has_body {
                return decl;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < checker.program_node.program_decl_count {
        const decl: &ASTNode = checker.program_node.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL && decl.fn_decl_name != null &&
            str_equals(decl.fn_decl_name, fn_decl.fn_decl_name) != 0 {
            return decl;
        }
        i = i + 1;
    }
    return fn_decl;
}

fn checker_scope_head_at(checker: &TypeChecker, idx: i32) &Symbol {
    if checker == null {
        return null;
    }
    if idx >= 0 && idx < 64 {
        return checker.scope_heads[idx];
    }
    return null;
}

fn checker_scope_head_set(checker: &TypeChecker, idx: i32, value: &Symbol) void {
    if checker == null {
        return;
    }
    if idx >= 0 && idx < 64 {
        checker.scope_heads[idx] = value;
    }
}

fn checker_add_function_root_decl(checker: &TypeChecker, fn_decl: &ASTNode) i32 {
    const canonical_fn_decl: &ASTNode = checker_canonicalize_fn_decl(checker, fn_decl);
    if checker == null || canonical_fn_decl == null || canonical_fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    var i: i32 = 0;
    while i < checker.fn_root_count {
        if checker_fn_root_decl_at(checker, i) == canonical_fn_decl {
            return 1;
        }
        i = i + 1;
    }
    if checker_ast_node_ref_append(&checker.fn_root_decls, canonical_fn_decl) != 0 {
        checker_report_error(checker, canonical_fn_decl, "顶层函数 root 表分配失败" as *byte);
        return 0;
    }
    checker.fn_root_count = checker.fn_root_decls.count as i32;
    return 1;
}

fn checker_add_function_root_by_name(checker: &TypeChecker, name: &byte) i32 {
    const fn_decl: &ASTNode = checker_find_reachable_fn_decl_by_name(checker, name);
    if fn_decl == null {
        return 0;
    }
    return checker_add_function_root_decl(checker, fn_decl);
}

fn checker_add_function_edge(checker: &TypeChecker, from_decl: &ASTNode, to_decl: &ASTNode) i32 {
    const canonical_from_decl: &ASTNode = checker_canonicalize_fn_decl(checker, from_decl);
    const canonical_to_decl: &ASTNode = checker_canonicalize_fn_decl(checker, to_decl);
    if checker == null || canonical_from_decl == null || canonical_to_decl == null ||
        canonical_from_decl.type != ASTNodeType.AST_FN_DECL || canonical_to_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    var i: i32 = 0;
    while i < checker.fn_call_edge_count {
        const existing_edge: &FnCallEdge = checker_fn_call_edge_at(checker, i);
        if existing_edge != null &&
            existing_edge.from_decl == canonical_from_decl && existing_edge.to_decl == canonical_to_decl {
            return 1;
        }
        i = i + 1;
    }
    var edge: FnCallEdge = FnCallEdge{
        from_decl: canonical_from_decl,
        to_decl: canonical_to_decl,
    };
    if semantic_vector_append(&checker.fn_call_edges, &edge as &const void) != 0 {
        checker_report_error(checker, canonical_from_decl, "顶层函数 call edge 表分配失败" as *byte);
        return 0;
    }
    checker.fn_call_edge_count = checker.fn_call_edges.count as i32;
    return 1;
}

fn checker_mark_reachability_node_visited(checker: &TypeChecker, node: &ASTNode) i32 {
    if checker == null || node == null {
        return 0;
    }
    const key: i64 = (@usize_from_ptr(node as &void) / 8usize) as i64;
    var value: i32 = 0;
    if semantic_hash_get(&checker.reachability_visit_index, key, &value) != 0 {
        return 0;
    }
    if semantic_hash_insert(&checker.reachability_visit_index, key, 1) != 0 {
        return 1;
    }
    checker.reachability_visit_count = checker.reachability_visit_index.count as i32;
    return 1;
}

fn checker_reset_reachability_visit_cache(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    semantic_hash_reset(&checker.reachability_visit_index);
    checker.reachability_visit_count = 0;
}

fn checker_is_function_reachable(checker: &TypeChecker, fn_decl: &ASTNode) i32 {
    if checker == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    var i: i32 = 0;
    while i < checker.reachable_fn_decl_count {
        if checker_reachable_fn_decl_at(checker, i) == fn_decl {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn checker_compute_function_reachability(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    semantic_vector_reset(&checker.reachable_fn_decls);
    checker.reachable_fn_decl_count = 0;
    var queue: SemanticVector = checker_empty_vector();
    semantic_vector_init(&queue, @size_of(AstNodeRefEntry));
    var head: i32 = 0;
    var tail: i32 = 0;
    var i: i32 = 0;
    while i < checker.fn_root_count {
        const root_decl: &ASTNode = checker_fn_root_decl_at(checker, i);
        if root_decl != null && checker_is_function_reachable(checker, root_decl) == 0 {
            if checker_ast_node_ref_append(&checker.reachable_fn_decls, root_decl) != 0 {
                checker_report_error(checker, root_decl, "顶层函数 reachable 集合分配失败" as *byte);
                semantic_vector_release(&queue);
                return;
            }
            checker.reachable_fn_decl_count = checker.reachable_fn_decls.count as i32;
            if checker_ast_node_ref_append(&queue, root_decl) != 0 {
                checker_report_error(checker, root_decl, "顶层函数 reachable 队列分配失败" as *byte);
                semantic_vector_release(&queue);
                return;
            }
            tail = tail + 1;
        }
        i = i + 1;
    }

    while head < tail {
        const queue_entry: &AstNodeRefEntry = checker_ast_node_ref_at(&queue, head);
        var from_decl: &ASTNode = null;
        if queue_entry != null {
            from_decl = queue_entry.decl;
        }
        head = head + 1;
        i = 0;
        while i < checker.fn_call_edge_count {
            const edge: &FnCallEdge = checker_fn_call_edge_at(checker, i);
            if edge != null && edge.from_decl == from_decl {
                const to_decl: &ASTNode = edge.to_decl;
                if to_decl != null && checker_is_function_reachable(checker, to_decl) == 0 {
                    if checker_ast_node_ref_append(&checker.reachable_fn_decls, to_decl) != 0 {
                        checker_report_error(checker, to_decl, "顶层函数 reachable 集合分配失败" as *byte);
                        semantic_vector_release(&queue);
                        return;
                    }
                    checker.reachable_fn_decl_count = checker.reachable_fn_decls.count as i32;
                    if checker_ast_node_ref_append(&queue, to_decl) != 0 {
                        checker_report_error(checker, to_decl, "顶层函数 reachable 队列分配失败" as *byte);
                        semantic_vector_release(&queue);
                        return;
                    }
                    tail = tail + 1;
                }
            }
            i = i + 1;
        }
    }
    semantic_vector_release(&queue);
}

// 获取错误计数
fn checker_get_error_count(checker: &TypeChecker) i32 {
    if checker == null {
        return 0;
    }
    return checker.error_count;
}

// ===== 符号表操作 =====

// 符号表查找函数（支持作用域查找，返回最内层匹配的符号）
// 优化：使用作用域链表，从当前作用域向外查找
fn symbol_table_lookup(checker: &TypeChecker, name: &byte) &Symbol {
    if checker == null || name == null {
        return null;
    }

    // 从当前作用域开始向外查找
    var scope: i32 = checker.scope_level;
    while scope >= 0 {
        const scope_idx: i32 = scope;
        if scope_idx < 0 {
            break;
        }
        if scope_idx >= @len(checker.scope_heads) {
            scope = scope - 1;
            continue;
        }
        var symbol: &Symbol = checker_scope_head_at(checker, scope_idx);
        while symbol != null {
            // 使用优化的 str_equals（先比较指针）
            if str_equals(symbol.name, name) != 0 {
                return symbol;  // 找到最内层匹配
            }
            symbol = symbol.next_in_scope;
        }
        scope = scope - 1;
    }

    return null;
}

fn symbol_table_remove_entry(checker: &TypeChecker, symbol: &Symbol) void {
    if checker == null || symbol == null || symbol.name == null {
        return;
    }
    const key: i64 = checker_table_key(symbol.name);
    var current_idx: i32 = -1;
    if semantic_hash_get(&checker.symbol_table.index, key, &current_idx) == 0 {
        return;
    }
    var prev_idx: i32 = -1;
    while current_idx >= 0 {
        const entry: &SymbolTableEntry = checker_symbol_entry_at(&checker.symbol_table, current_idx);
        if entry == null {
            break;
        }
        if entry.symbol == symbol {
            if prev_idx < 0 {
                _ = semantic_hash_insert(&checker.symbol_table.index, key, entry.next);
            } else {
                const prev: &SymbolTableEntry = checker_symbol_entry_at(&checker.symbol_table, prev_idx);
                if prev != null {
                    prev.next = entry.next;
                }
            }
            entry.name = null;
            entry.symbol = null;
            entry.next = -1;
            if checker.symbol_table.count > 0 {
                checker.symbol_table.count = checker.symbol_table.count - 1;
            }
            return;
        }
        prev_idx = current_idx;
        current_idx = entry.next;
    }
}

// 符号表插入函数
// 同时将符号添加到当前作用域的链表
fn symbol_table_insert(checker: &TypeChecker, symbol: &Symbol) i32 {
    if checker == null || symbol == null || symbol.name == null {
        return -1;
    }
    
    const existing: &Symbol = symbol_table_lookup(checker, symbol.name);
    if existing != null && existing.scope_level == symbol.scope_level {
        return -1;
    }

    const key: i64 = checker_table_key(symbol.name);
    var head_idx: i32 = -1;
    _ = semantic_hash_get(&checker.symbol_table.index, key, &head_idx);
    const entry_idx: i32 = checker.symbol_table.entries.count as i32;
    var entry: SymbolTableEntry = SymbolTableEntry{
        name: symbol.name,
        symbol: symbol,
        next: head_idx,
    };
    if semantic_vector_append(&checker.symbol_table.entries, &entry as &const void) != 0 {
        return -1;
    }
    if semantic_hash_insert(&checker.symbol_table.index, key, entry_idx) != 0 {
        return -1;
    }
    checker.symbol_table.count = checker.symbol_table.count + 1;

    // 添加到当前作用域的链表头部
    const scope: i32 = symbol.scope_level;
    if scope >= 0 {
        if scope < @len(checker.scope_heads) {
            symbol.next_in_scope = checker_scope_head_at(checker, scope);
            checker_scope_head_set(checker, scope, symbol);
        }
    }

    return 0;
}

// ===== 函数表操作 =====

// 函数表查找函数
fn function_table_lookup(checker: &TypeChecker, name: &byte) &FunctionSignature {
    if checker == null || name == null {
        return null;
    }

    const key: i64 = checker_table_key(name);
    var current_idx: i32 = -1;
    if semantic_hash_get(&checker.function_table.index, key, &current_idx) == 0 {
        return null;
    }
    while current_idx >= 0 {
        const entry: &FunctionTableEntry = checker_function_entry_at(&checker.function_table, current_idx);
        if entry == null {
            break;
        }
        const sig: &FunctionSignature = entry.sig;
        if sig != null && sig.name != null && str_equals(sig.name, name) != 0 {
            return sig;
        }
        current_idx = entry.next;
    }

    return null;
}

// 函数表插入函数（动态 hash + entry 链表，保留同名 extern 合并语义）
fn function_table_insert(checker: &TypeChecker, sig: &FunctionSignature) i32 {
    if checker == null || sig == null || sig.name == null {
        return -1;
    }

    const key: i64 = checker_table_key(sig.name);
    var head_idx: i32 = -1;
    _ = semantic_hash_get(&checker.function_table.index, key, &head_idx);
    var current_idx: i32 = head_idx;
    while current_idx >= 0 {
        const entry: &FunctionTableEntry = checker_function_entry_at(&checker.function_table, current_idx);
        if entry == null {
            break;
        }
        const existing: &FunctionSignature = entry.sig;
        if existing != null && existing.name != null && str_equals(existing.name, sig.name) != 0 {
            if existing.is_extern != 0 && sig.is_extern != 0 {
                if existing.param_count == sig.param_count &&
                    type_equals(existing.return_type, sig.return_type) != 0 &&
                    existing.is_varargs == sig.is_varargs {
                    return 0;
                } else {
                    return -1;
                }
            } else if existing.is_extern == 0 && sig.is_extern == 0 {
                return -1;
            } else {
                if existing.is_extern != 0 {
                    entry.name = sig.name;
                    entry.sig = sig;
                    return 0;
                } else {
                    return 0;
                }
            }
        }
        current_idx = entry.next;
    }

    const entry_idx: i32 = checker.function_table.entries.count as i32;
    var new_entry: FunctionTableEntry = FunctionTableEntry{
        name: sig.name,
        sig: sig,
        next: head_idx,
    };
    if semantic_vector_append(&checker.function_table.entries, &new_entry as &const void) != 0 {
        return -1;
    }
    if semantic_hash_insert(&checker.function_table.index, key, entry_idx) != 0 {
        return -1;
    }
    checker.function_table.count = checker.function_table.count + 1;
    return 0;
}

// ===== 作用域管理 =====

// 进入作用域
fn checker_enter_scope(checker: &TypeChecker) void {
    if checker != null {
        checker.scope_level = checker.scope_level + 1;
    }
}

// 退出作用域
// 优化：使用作用域链表快速清理，避免遍历整个符号表
fn checker_exit_scope(checker: &TypeChecker) void {
    if checker == null || checker.scope_level <= 0 {
        return;
    }
    
    const current_scope: i32 = checker.scope_level;

    // 使用作用域链表遍历当前作用域的所有符号
    if current_scope >= 0 {
        const scope_idx: i32 = current_scope;
        if scope_idx < 0 {
            return;
        }
        if scope_idx >= @len(checker.scope_heads) {
            return;
        }
        var symbol: &Symbol = checker_scope_head_at(checker, scope_idx);
        while symbol != null {
            symbol_table_remove_entry(checker, symbol);
            const next: &Symbol = symbol.next_in_scope;
            symbol.next_in_scope = null;
            symbol = next;
        }
        checker_scope_head_set(checker, scope_idx, null);
    }
    
    checker.scope_level = checker.scope_level - 1;
}

// ===== 字符串工具 =====

// 字符串比较辅助函数（Uya 没有 strcmp）
// 优化：先比较指针，相同则直接返回
fn str_equals(s1: &byte, s2: &byte) i32 {
    if s1 == null && s2 == null {
        return 1;
    }
    if s1 == null || s2 == null {
        return 0;
    }
    // 快速路径：指针相同，字符串必定相同
    if s1 == s2 {
        return 1;
    }
    var i: i32 = 0;
    while true {
        const c1: byte = s1[i] as byte;
        const c2: byte = s2[i] as byte;
        if c1 != c2 {
            return 0;
        }
        if c1 == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ===== 字符串池（String Interning）=====

// 字符串池：查找或插入字符串
// 如果字符串已存在，返回现有指针；否则创建新条目
fn string_pool_intern(pool: &StringPool, arena: &CompilerArena, str: &byte) &byte {
    if pool == null || arena == null || str == null {
        return str;
    }

    const hash: i32 = hash_string(str);
    const bucket_idx: i32 = hash % STRING_POOL_SIZE;
    if bucket_idx < 0 {
        return str;
    }
    if bucket_idx >= STRING_POOL_SIZE {
        return str;
    }

    // 查找现有条目
    var entry: &StringPoolEntry = pool.buckets[bucket_idx];
    while entry != null {
        // 快速检查：哈希值相同才比较字符串
        if entry.hash == hash && entry.str != null {
            // 指针比较：如果字符串已在池中
            if entry.str == str {
                return entry.str;
            }
            // 字符串比较
            if str_equals(entry.str, str) != 0 {
                return entry.str;  // 返回已存在的字符串指针
            }
        }
        entry = entry.next;
    }

    // 创建新条目
    const n: usize = strlen(str as *byte) + 1;
    const new_str: &byte = compiler_arena_alloc(arena, n) as &byte;
    if new_str == null {
        return str;
    }
    memcpy(new_str as *void, str as *void, n);

    const new_entry: &StringPoolEntry = compiler_arena_alloc(arena, @size_of(StringPoolEntry) as usize) as &StringPoolEntry;
    if new_entry == null {
        return new_str;
    }
    new_entry.str = new_str;
    new_entry.hash = hash;
    new_entry.next = pool.buckets[bucket_idx];
    pool.buckets[bucket_idx] = new_entry;
    pool.count = pool.count + 1;

    return new_str;
}

// 从 Arena 复制字符串（不使用字符串池）
fn checker_arena_strdup(arena: &CompilerArena, src: &byte) &byte {
    if arena == null || src == null {
        return null;
    }
    const n: usize = strlen(src as *byte) + 1;
    const result: &byte = compiler_arena_alloc(arena, n) as &byte;
    if result == null {
        return null;
    }
    memcpy(result as *void, src as *void, n);
    return result;
}

// 从 Arena 复制字符串（使用字符串池，优化版本）
// 如果字符串已存在，返回现有指针；否则创建新条目
fn checker_intern_strdup(checker: &TypeChecker, src: &byte) &byte {
    if checker == null || src == null {
        return null;
    }
    return string_pool_intern(&checker.string_pool, checker.arena, src);
}

// ===== 移动语义 =====

// 已移动集合检查
fn moved_set_contains(checker: &TypeChecker, name: &byte) i32 {
    if checker == null || name == null {
        return 0;
    }
    var i: i32 = 0;
    const count: i32 = checker.moved_count;
    while i < count {
        const entry: &MovedNameEntry = checker_moved_entry_at(checker, i);
        if entry != null && entry.name != null && str_equals(entry.name, name) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// 检查是否有活跃指针指向变量
// 优化：只遍历当前作用域及内层作用域的符号
fn has_active_pointer_to(checker: &TypeChecker, var_name: &byte) i32 {
    if checker == null || var_name == null {
        return 0;
    }
    // 遍历所有作用域的符号
    var scope: i32 = checker.scope_level;
    while scope >= 0 {
        if scope < @len(checker.scope_heads) {
            var s: &Symbol = checker_scope_head_at(checker, scope);
            while s != null {
                if s.pointee_of != null && str_equals(s.pointee_of, var_name) != 0 {
                    return 1;
                }
                s = s.next_in_scope;
            }
        }
        scope = scope - 1;
    }
    return 0;
}

// 标记变量已移动
fn checker_mark_moved(checker: &TypeChecker, node: &ASTNode, var_name: &byte, struct_name: &byte) void {
    if checker == null || var_name == null || struct_name == null {
        return;
    }
    // 不标记 match 等引入的绑定变量（无 decl_node），避免误报「变量已被移动」
    const sym: &Symbol = symbol_table_lookup(checker, var_name);
    if sym != null && sym.decl_node == null {
        return;
    }
    var err_node: &ASTNode = node;
    if node == null {
        err_node = checker.current_function_decl;
    }
    if has_active_pointer_to(checker, var_name) != 0 {
        checker_report_error(checker, err_node, "变量存在活跃指针，不能移动" as *byte);
        return;
    }
    if checker.loop_depth > 0 {
        checker_report_error(checker, err_node, "循环中的变量不能移动" as *byte);
        return;
    }
    const copy: &byte = checker_intern_strdup(checker, var_name);
    if copy != null {
        var entry: MovedNameEntry = MovedNameEntry {
            name: copy,
        };
        if semantic_vector_append(&checker.moved_names, &entry as &const void) != 0 {
            checker_report_error(checker, err_node, "checker moved name table 分配失败" as *byte);
            return;
        }
        checker.moved_count = checker.moved_names.count as i32;
    }
    // 写回 VAR_DECL 的 was_moved
    if sym != null && sym.decl_node != null && sym.decl_node.type == ASTNodeType.AST_VAR_DECL {
        sym.decl_node.var_decl_was_moved = 1;
    }
}

// 标记调用参数已移动
fn checker_mark_moved_call_args(checker: &TypeChecker, node: &ASTNode) void {
    if checker == null || node == null || node.type != ASTNodeType.AST_CALL_EXPR {
        return;
    }
    if checker_is_manual_drop_call(checker, node) != 0 {
        return;
    }
    const callee: &ASTNode = node.call_expr_callee;
    const n: i32 = node.call_expr_arg_count;
    const args: & & ASTNode = node.call_expr_args;
    if args == null {
        return;
    }
    if callee.type == ASTNodeType.AST_MEMBER_ACCESS {
        var owner_is_union: i32 = 0;
        const owner_name: &byte = checker_type_namespace_owner_name(checker, callee.member_access_object, &owner_is_union);
        if owner_name != null {
            var static_method: &ASTNode = null;
            var instance_method: &ASTNode = null;
            if owner_is_union != 0 {
                static_method = find_static_method_in_union(checker.program_node, owner_name, callee.member_access_field_name);
                instance_method = find_instance_method_in_union(checker.program_node, owner_name, callee.member_access_field_name);
            } else {
                static_method = find_static_method_in_struct(checker.program_node, owner_name, callee.member_access_field_name);
                instance_method = find_instance_method_in_struct(checker.program_node, owner_name, callee.member_access_field_name);
            }
            if static_method != null && static_method.type == ASTNodeType.AST_FN_DECL && static_method.fn_decl_params != null {
                var i_static: i32 = 0;
                while i_static < n && i_static < static_method.fn_decl_param_count {
                    const arg_static: &ASTNode = args[i_static];
                    if arg_static != null && arg_static.type == ASTNodeType.AST_IDENTIFIER {
                        const param_static: &ASTNode = static_method.fn_decl_params[i_static];
                        if param_static != null && param_static.type == ASTNodeType.AST_VAR_DECL && param_static.var_decl_type != null {
                            const pt_static: Type = type_from_ast(checker, param_static.var_decl_type);
                            if pt_static.kind == TypeKind.TYPE_STRUCT && pt_static.struct_name != null {
                                checker_mark_moved(checker, arg_static, arg_static.identifier_name, pt_static.struct_name);
                            }
                        }
                    }
                    i_static = i_static + 1;
                }
                return;
            }
            if instance_method != null && instance_method.type == ASTNodeType.AST_FN_DECL && instance_method.fn_decl_params != null {
                var i_inst: i32 = 1;
                while i_inst < n && i_inst < instance_method.fn_decl_param_count {
                    const arg_inst: &ASTNode = args[i_inst];
                    if arg_inst != null && arg_inst.type == ASTNodeType.AST_IDENTIFIER {
                        const param_inst: &ASTNode = instance_method.fn_decl_params[i_inst];
                        if param_inst != null && param_inst.type == ASTNodeType.AST_VAR_DECL && param_inst.var_decl_type != null {
                            const pt_inst: Type = type_from_ast(checker, param_inst.var_decl_type);
                            if pt_inst.kind == TypeKind.TYPE_STRUCT && pt_inst.struct_name != null {
                                checker_mark_moved(checker, arg_inst, arg_inst.identifier_name, pt_inst.struct_name);
                            }
                        }
                    }
                    i_inst = i_inst + 1;
                }
                return;
            }
        }
        var object_type: Type = checker_infer_type(checker, callee.member_access_object);
        if object_type.kind == TypeKind.TYPE_POINTER && object_type.pointer_to != null {
            object_type = object_type.pointer_to[0];
        }
        if object_type.kind == TypeKind.TYPE_STRUCT && object_type.struct_name != null && checker.program_node != null {
            const m: &ASTNode = find_instance_method_in_struct(checker.program_node, object_type.struct_name, callee.member_access_field_name);
            if m != null && m.type == ASTNodeType.AST_FN_DECL && m.fn_decl_params != null {
                var i: i32 = 0;
                while i < n && i + 1 < m.fn_decl_param_count {
                    const arg: &ASTNode = args[i];
                    if arg != null && arg.type == ASTNodeType.AST_IDENTIFIER {
                        const param: &ASTNode = m.fn_decl_params[i + 1];
                        if param != null && param.type == ASTNodeType.AST_VAR_DECL && param.var_decl_type != null {
                            const pt: Type = type_from_ast(checker, param.var_decl_type);
                            if pt.kind == TypeKind.TYPE_STRUCT && pt.struct_name != null {
                                checker_mark_moved(checker, arg, arg.identifier_name, pt.struct_name);
                            }
                        }
                    }
                    i = i + 1;
                }
            }
        }
        return;
    }
    if callee.type != ASTNodeType.AST_IDENTIFIER {
        return;
    }
    const sig: &FunctionSignature = function_table_lookup(checker, callee.identifier_name);
    if sig == null || sig.param_types == null {
        return;
    }
    var i: i32 = 0;
    while i < n && i < sig.param_count {
        if args[i] != null && args[i].type == ASTNodeType.AST_IDENTIFIER &&
            sig.param_types[i].kind == TypeKind.TYPE_STRUCT && sig.param_types[i].struct_name != null {
            checker_mark_moved(checker, args[i], args[i].identifier_name, sig.param_types[i].struct_name);
        }
        i = i + 1;
    }
}

// ===== 错误ID管理 =====

// hash(error_name)，0 保留；djb2 算法
fn hash_error_name(name: &byte) u32 {
    var h: u32 = 5381;
    var i: i32 = 0;
    while name[i] != 0 {
        const c: u32 = (name[i] as byte) as u32;
        h = ((h * 32) + h) + c;
        i = i + 1;
    }
    if h == 0 { return 1; }
    return h;
}

// 获取或添加错误 ID
fn get_or_add_error_id(checker: &TypeChecker, name: &byte, node: &ASTNode) u32 {
    if checker == null || name == null {
        return 0;
    }
    const h: u32 = hash_error_name(name);
    var i: i32 = 0;
    const count: i32 = checker.error_name_count;
    while i < count {
        const entry: &ErrorNameEntry = checker_error_entry_at(checker, i);
        if entry != null && entry.name != null && str_equals(entry.name, name) != 0 {
            return entry.hash;
        }
        if entry != null && entry.hash == h && entry.name != null && str_equals(entry.name, name) == 0 {
            checker_report_error(checker, node, "error_id 冲突: 请重命名其一" as *byte);
            return 0;
        }
        i = i + 1;
    }
    const copy: &byte = checker_intern_strdup(checker, name);
    if copy == null {
        return 0;
    }
    var new_entry: ErrorNameEntry = ErrorNameEntry {
        name: copy,
        hash: h,
    };
    if semantic_vector_append(&checker.error_names, &new_entry as &const void) != 0 {
        checker_report_error(checker, node, "checker error name table 分配失败" as *byte);
        return 0;
    }
    checker.error_name_count = checker.error_names.count as i32;
    return h;
}
