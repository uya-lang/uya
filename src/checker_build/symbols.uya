// checker/symbols.uya - 符号表操作和工具函数
// 从 checker/main.uya 拆分

// ===== 哈希函数 =====

// 哈希函数（djb2算法，用于字符串哈希）
// 注意：Uya Mini 不支持位运算符 <<，使用乘法代替
fn hash_string(str: &byte) i32 {
    // 使用 u32 避免有符号整数溢出 UB
    var hash: u32 = 5381;
    var i: i32 = 0;
    while str[i] != 0 {
        const c: u8 = str[i] as u8;
        hash = ((hash * 32) + hash) + (c as u32); // hash * 33 + c (等价于 hash << 5 + hash)
        i = i + 1;
    }
    return hash as i32; // 返回时转换为 i32，保持 API 兼容
}

fn checker_table_key(name: &byte) i64 {
    if name == null {
        return -1;
    }
    return hash_string(name) as i64;
}

fn checker_symbol_table_init(table: &SymbolTable) void {
    if table == null {
        return;
    }
    semantic_vector_init(&table.entries, @size_of(SymbolTableEntry));
    semantic_hash_init(&table.index);
    table.count = 0;
}

fn checker_function_table_init(table: &FunctionTable) void {
    if table == null {
        return;
    }
    semantic_vector_init(&table.entries, @size_of(FunctionTableEntry));
    semantic_hash_init(&table.index);
    table.count = 0;
}

fn checker_module_table_init(table: &ModuleTable) void {
    if table == null {
        return;
    }
    semantic_vector_init(&table.entries, @size_of(ModuleTableEntry));
    semantic_hash_init(&table.index);
    table.count = 0;
}

fn checker_import_table_init(table: &ImportTable) void {
    if table == null {
        return;
    }
    semantic_vector_init(&table.entries, @size_of(ImportTableEntry));
    semantic_hash_init(&table.index);
    table.count = 0;
}

fn checker_symbol_entry_at(table: &SymbolTable, idx: i32) &SymbolTableEntry {
    if table == null || idx < 0 {
        return null;
    }
    const index: usize = idx as usize;
    if index >= table.entries.count {
        return null;
    }
    return semantic_vector_item_ptr(&table.entries, index) as &SymbolTableEntry;
}

fn checker_function_entry_at(table: &FunctionTable, idx: i32) &FunctionTableEntry {
