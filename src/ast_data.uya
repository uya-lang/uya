// ast_data.uya - ASTNode 优化数据结构定义
// 渐进式迁移：与 ast.uya 中的旧结构共存
//
// 注意：union 变体不能包含引用类型 &T，必须使用 FFI 指针 *T
// 注意：使用 *void 代替 *ASTNode 避免循环依赖

// ========================================
// 简单节点数据结构
// ========================================

struct ASTIdentifierDataNew {
    name: *byte,
}

struct ASTNumberDataNew {
    value: i32,
}

struct ASTFloatDataNew {
    value: f64,
}

struct ASTBoolDataNew {
    value: i32,
}

struct ASTStringDataNew {
    value: *byte,
}

// ========================================
// 表达式节点数据结构（使用 *void 代替 *ASTNode）
// ========================================

struct ASTBinaryExprDataNew {
    left: *void,
    op: i32,
    right: *void,
}

struct ASTUnaryExprDataNew {
    op: i32,
    operand: *void,
}

struct ASTCallExprDataNew {
    callee: *void,
    args: *void,
    arg_count: i32,
    has_ellipsis_forward: i32,
    type_args: *void,
    type_arg_count: i32,
}

struct ASTMemberAccessDataNew {
    object: *void,
    field_name: *byte,
    is_module_access: i32,
    module_name: *byte,
}

// ========================================
// 声明节点数据结构（使用 *void 代替 *ASTNode）
// ========================================

struct ASTVarDeclDataNew {
    name: *byte,
    var_type: *void,
    init: *void,
    is_const: i32,
    was_moved: i32,
    is_export: i32,
}

struct ASTFnDeclDataNew {
    name: *byte,
    type_params: *void,
    type_param_count: i32,
    params: *void,
    param_count: i32,
    return_type: *void,
    body: *void,
    is_varargs: i32,
    is_export: i32,
    is_extern: i32,
    is_async: i32,
    extern_lib_name: *byte,
}

// ========================================
// 语句节点数据结构（使用 *void 代替 *ASTNode）
// ========================================

struct ASTIfStmtDataNew {
    condition: *void,
    then_branch: *void,
    else_branch: *void,
}

struct ASTWhileStmtDataNew {
    condition: *void,
    body: *void,
}

struct ASTBlockDataNew {
    stmts: *void,
    stmt_count: i32,
}

// ========================================
// 更多语句节点数据结构
// ========================================

struct ASTReturnStmtDataNew {
    expr: *void,
}

struct ASTAssignDataNew {
    dest: *void,
    src: *void,
}

struct ASTForStmtDataNew {
    init: *void,
    condition: *void,
    update: *void,
    body: *void,
    is_range: i32,
    range_var: *byte,
    range_start: *void,
    range_end: *void,
    range_is_ref: i32,
}

struct ASTDeferStmtDataNew {
    body: *void,
    is_errdefer: i32,
}

struct ASTErrdeferStmtDataNew {
    body: *void,
}

// ========================================
// 更多表达式节点数据结构
// ========================================

struct ASTArrayAccessDataNew {
    array: *void,
    index: *void,
}

struct ASTSliceExprDataNew {
    base: *void,
    start: *void,
    len: *void,
}

struct ASTCastExprDataNew {
    expr: *void,
    target_type: *void,
    is_force_cast: i32,
}

struct ASTStructInitDataNew {
    type_name: *byte,
    fields: *void,
    field_count: i32,
    type_args: *void,
    type_arg_count: i32,
}

struct ASTArrayLiteralDataNew {
    elements: *void,
    element_count: i32,
    repeat_count_expr: *void,
}

struct ASTTupleLiteralDataNew {
    elements: *void,
    element_count: i32,
}

struct ASTMatchExprDataNew {
    expr: *void,
    arms: *void,
    arm_count: i32,
}

struct ASTTryExprDataNew {
    operand: *void,
}

struct ASTCatchExprDataNew {
    operand: *void,
    error_var: *byte,
    catch_block: *void,
}

struct ASTErrorValueDataNew {
    name: *byte,
    error_id: u32,
}

// ========================================
// 声明节点数据结构
// ========================================

struct ASTProgramDataNew {
    decls: *void,
    decl_count: i32,
}

struct ASTEnumDeclDataNew {
    name: *byte,
    variants: *void,
    variant_count: i32,
    is_export: i32,
}

struct ASTStructDeclDataNew {
    name: *byte,
    type_params: *void,
    type_param_count: i32,
    interface_names: *void,
    interface_count: i32,
    fields: *void,
    field_count: i32,
    methods: *void,
    method_count: i32,
    is_export: i32,
}

struct ASTUnionDeclDataNew {
    name: *byte,
    variants: *void,
    variant_count: i32,
    methods: *void,
    method_count: i32,
    is_extern: i32,
    is_export: i32,
}

struct ASTInterfaceDeclDataNew {
    name: *byte,
    type_params: *void,
    type_param_count: i32,
    composed_interfaces: *void,
    composed_count: i32,
    method_sigs: *void,
    method_sig_count: i32,
    is_export: i32,
}

// ========================================
// 更多声明节点数据结构
// ========================================

struct ASTErrorDeclDataNew {
    name: *byte,
    is_export: i32,
}

struct ASTMethodBlockDataNew {
    struct_name: *byte,
    union_name: *byte,
    methods: *void,
    method_count: i32,
}

struct ASTMacroDeclDataNew {
    name: *byte,
    params: *void,
    param_count: i32,
    return_tag: *byte,
    body: *void,
    is_export: i32,
}

struct ASTTypeAliasDataNew {
    name: *byte,
    target_type: *void,
    is_export: i32,
}

struct ASTExternVarDeclDataNew {
    name: *byte,
    var_type: *void,
    init_expr: *void,
    is_const: i32,
    is_extern: i32,
    is_export: i32,
    extern_lib_name: *byte,
}

struct ASTDestructureDeclDataNew {
    names: *void,
    name_count: i32,
    is_const: i32,
    init: *void,
}

struct ASTUseStmtDataNew {
    path_segments: *void,
    path_segment_count: i32,
    item_name: *byte,
    alias: *byte,
}

// ========================================
// 更多语句节点数据结构
// ========================================

struct ASTBreakStmtDataNew {
    // 无额外数据
}

struct ASTContinueStmtDataNew {
    // 无额外数据
}

struct ASTTestStmtDataNew {
    description: *byte,
    body: *void,
}

struct ASTExprStmtDataNew {
    expr: *void,
}

// ========================================
// 空数据节点（underscore, params, src_*, func_name）
// ========================================

struct ASTEmptyDataNew {
    // 无额外数据
}

// ========================================
// 内置表达式数据结构
// ========================================

struct ASTSizeofExprDataNew {
    target: *void,
    is_type: i32,
}

struct ASTLenExprDataNew {
    array: *void,
}

struct ASTAlignofExprDataNew {
    target: *void,
    is_type: i32,
}

struct ASTStringInterpDataNew {
    segments: *void,
    segment_count: i32,
    computed_size: i32,
}

struct ASTAwaitExprDataNew {
    operand: *void,
}

struct ASTSyscallDataNew {
    number: *void,
    args: *void,
    arg_count: i32,
}

struct ASTPtrFromUsizeDataNew {
    value: *void,
}

struct ASTUsizeFromPtrDataNew {
    ptr: *void,
}

struct ASTVaStartDataNew {
    ap: *void,
    last_param: *void,
}

struct ASTVaEndDataNew {
    ap: *void,
}

struct ASTVaArgDataNew {
    ap: *void,
    arg_type: *void,
}

struct ASTIntLimitDataNew {
    is_max: i32,
    resolved_kind: i32,
}

// 宏内建表达式（mc_*）
struct ASTMcEvalDataNew {
    operand: *void,
}

struct ASTMcCodeDataNew {
    operand: *void,
}

struct ASTMcAstDataNew {
    operand: *void,
}

struct ASTMcErrorDataNew {
    operand: *void,
}

struct ASTMcInterpDataNew {
    operand: *void,
}

struct ASTMcTypeDataNew {
    operand: *void,
}

// 源信息表达式（@src_*）
// 无额外数据，可用空结构体

// ========================================
// 类型节点数据结构
// ========================================

struct ASTTypeNamedDataNew {
    name: *byte,
    type_args: *void,
    type_arg_count: i32,
}

struct ASTTypePointerDataNew {
    pointed_type: *void,
    is_ffi_pointer: i32,
    is_const: i32,
}

struct ASTTypeArrayDataNew {
    element_type: *void,
    size_expr: *void,
}

struct ASTTypeSliceDataNew {
    element_type: *void,
    size_expr: *void,
}

struct ASTTypeTupleDataNew {
    element_types: *void,
    element_count: i32,
}

struct ASTTypeErrorUnionDataNew {
    payload_type: *void,
}

struct ASTTypeAtomicDataNew {
    inner_type: *void,
}

// ========================================
// Union 组合所有数据结构
// ========================================

union ASTNodeDataNew {
    // 字面量和标识符
    identifier: ASTIdentifierDataNew,
    number: ASTNumberDataNew,
    float_literal: ASTFloatDataNew,
    bool_literal: ASTBoolDataNew,
    string_literal: ASTStringDataNew,
    int_limit: ASTIntLimitDataNew,
    underscore: ASTEmptyDataNew,
    // 表达式
    binary_expr: ASTBinaryExprDataNew,
    unary_expr: ASTUnaryExprDataNew,
    call_expr: ASTCallExprDataNew,
    member_access: ASTMemberAccessDataNew,
    array_access: ASTArrayAccessDataNew,
    slice_expr: ASTSliceExprDataNew,
    cast_expr: ASTCastExprDataNew,
    struct_init: ASTStructInitDataNew,
    array_literal: ASTArrayLiteralDataNew,
    tuple_literal: ASTTupleLiteralDataNew,
    match_expr: ASTMatchExprDataNew,
    try_expr: ASTTryExprDataNew,
    catch_expr: ASTCatchExprDataNew,
    error_value: ASTErrorValueDataNew,
    await_expr: ASTAwaitExprDataNew,
    sizeof_expr: ASTSizeofExprDataNew,
    len_expr: ASTLenExprDataNew,
    alignof_expr: ASTAlignofExprDataNew,
    string_interp: ASTStringInterpDataNew,
    params: ASTEmptyDataNew,
    // 内置表达式
    syscall: ASTSyscallDataNew,
    ptr_from_usize: ASTPtrFromUsizeDataNew,
    usize_from_ptr: ASTUsizeFromPtrDataNew,
    va_start: ASTVaStartDataNew,
    va_end: ASTVaEndDataNew,
    va_arg: ASTVaArgDataNew,
    // 宏内建表达式
    mc_eval: ASTMcEvalDataNew,
    mc_code: ASTMcCodeDataNew,
    mc_ast: ASTMcAstDataNew,
    mc_error: ASTMcErrorDataNew,
    mc_interp: ASTMcInterpDataNew,
    mc_type: ASTMcTypeDataNew,
    // 源信息表达式（无额外数据）
    src_name: ASTEmptyDataNew,
    src_path: ASTEmptyDataNew,
    src_line: ASTEmptyDataNew,
    src_col: ASTEmptyDataNew,
    func_name: ASTEmptyDataNew,
    // 声明
    program: ASTProgramDataNew,
    enum_decl: ASTEnumDeclDataNew,
    error_decl: ASTErrorDeclDataNew,
    struct_decl: ASTStructDeclDataNew,
    union_decl: ASTUnionDeclDataNew,
    interface_decl: ASTInterfaceDeclDataNew,
    method_block: ASTMethodBlockDataNew,
    fn_decl: ASTFnDeclDataNew,
    macro_decl: ASTMacroDeclDataNew,
    type_alias: ASTTypeAliasDataNew,
    var_decl: ASTVarDeclDataNew,
    extern_var_decl: ASTExternVarDeclDataNew,
    destructure_decl: ASTDestructureDeclDataNew,
    use_stmt: ASTUseStmtDataNew,
    // 语句
    if_stmt: ASTIfStmtDataNew,
    while_stmt: ASTWhileStmtDataNew,
    for_stmt: ASTForStmtDataNew,
    break_stmt: ASTBreakStmtDataNew,
    continue_stmt: ASTContinueStmtDataNew,
    return_stmt: ASTReturnStmtDataNew,
    defer_stmt: ASTDeferStmtDataNew,
    errdefer_stmt: ASTErrdeferStmtDataNew,
    test_stmt: ASTTestStmtDataNew,
    assign: ASTAssignDataNew,
    expr_stmt: ASTExprStmtDataNew,
    block: ASTBlockDataNew,
    // 类型节点
    type_named: ASTTypeNamedDataNew,
    type_pointer: ASTTypePointerDataNew,
    type_array: ASTTypeArrayDataNew,
    type_slice: ASTTypeSliceDataNew,
    type_tuple: ASTTypeTupleDataNew,
    type_error_union: ASTTypeErrorUnionDataNew,
    type_atomic: ASTTypeAtomicDataNew,
}

// ========================================
// 优化后的 ASTNode 结构
// ========================================

struct OptimizedASTNode {
    type: ASTNodeType,
    line: i32,
    column: i32,
    filename: *byte,
    data: ASTNodeDataNew,
}
