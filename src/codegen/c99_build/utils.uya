// utils.uya - C99 代码生成器工具函数模块
// 提供初始化、输出、字符串处理等工具函数
//
// 注意：需要先包含 internal.uya（包含类型定义和函数声明）
// 由于 Uya Mini 不支持模块系统，这里假设相关类型已经定义

// ===== 外部函数声明 =====
// C 标准库函数（在 extern_decls.uya 中声明）
extern fn mkdir(pathname: *byte, mode: i32) i32;
extern fn fopen(filename: *byte, mode: *byte) *void;
extern fn fclose(stream: *void) i32;
extern fn snprintf(buf: *byte, size: usize, format: *byte, ...) i32;
extern fn fputc(c: i32, stream: *void) i32;
extern fn fprintf(stream: *void, format: *byte, ...) i32;
extern fn fputs(s: *byte, stream: *void) i32;
extern fn fwrite(ptr: *void, size: usize, nmemb: usize, stream: *void) usize;
extern fn rename(oldpath: *byte, newpath: *byte) i32;
extern fn unlink(path: *byte) i32;
extern fn fflush(stream: *void) i32;
extern fn fread(ptr: *void, size: usize, nmemb: usize, stream: *void) usize;

use libc;

var g_c99_codegen_has_error: i32 = 0;

// ===== codegen 声明查询剖析（UYA_PROFILE_QUERIES=1，默认关、不计入 KPI）=====
// 量化 perf 给不了的绝对调用次数与命中率：揭示 find_*_c99 被调多少次、其中多少是
// 否定查找（hit=0，需回退线性扫描），为"消除重复查询 / 否定缓存 / SemanticDb 短路"提供依据。
const QP_KIND_COUNT: i32 = 5;
const QP_ENUM_CTX: i32 = 0;   // c99_find_enum_decl_in_context（上下文敏感，3 次线性扫描）
const QP_STRUCT: i32 = 1;     // find_struct_decl_c99
const QP_UNION: i32 = 2;      // find_union_decl_c99
const QP_ENUM: i32 = 3;       // find_enum_decl_c99
const QP_IFACE: i32 = 4;      // find_interface_decl_c99
var g_qp_enabled: i32 = 0;
var g_qp_calls: [i64: QP_KIND_COUNT] = [];
var g_qp_hits: [i64: QP_KIND_COUNT] = [];

/// 功能说明：从 UYA_PROFILE_QUERIES 初始化查询剖析开关并清零计数器。codegen 入口调用一次。
/// 参数说明：无。返回值说明：无。
export fn c99_qprof_init() void {
    const p: &byte = getenv("UYA_PROFILE_QUERIES" as &byte);
    var on: i32 = 0;
    if p != null && p[0] != 0 as byte {
        on = 1;
    }
    g_qp_enabled = on;
    var i: i32 = 0;
    while i < QP_KIND_COUNT {
        g_qp_calls[i] = 0i64;
        g_qp_hits[i] = 0i64;
        i = i + 1;
    }
}

/// 功能说明：查询剖析是否启用（启用时 find 包装才记账）。
/// 参数说明：无。返回值说明：启用返回 1，否则 0。
export fn c99_qprof_enabled() i32 {
    return g_qp_enabled;
}

/// 功能说明：记一次声明查询：kind 类计数 +1，命中（返回非 null）时命中计数 +1。
/// 参数说明：`kind` 为 QP_* 类别；`hit` 非 0 表示本次查询命中。返回值说明：无。
export fn c99_qprof_bump(kind: i32, hit: i32) void {
    if g_qp_enabled == 0 {
        return;
    }
    if kind < 0 || kind >= QP_KIND_COUNT {
        return;
    }
    g_qp_calls[kind] = g_qp_calls[kind] + 1i64;
    if hit != 0 {
        g_qp_hits[kind] = g_qp_hits[kind] + 1i64;
    }
}

/// 功能说明：codegen 结束时打印各 find_*_c99 的 calls/hits（命中率），仅启用时输出。
/// 参数说明：无。返回值说明：无。
export fn c99_qprof_dump() void {
    if g_qp_enabled == 0 {
        return;
    }
    fprintf(libc.stderr, "[UYA_PROFILE_QUERIES] enum_ctx calls=%ld hits=%ld | struct calls=%ld hits=%ld | union calls=%ld hits=%ld | enum calls=%ld hits=%ld | iface calls=%ld hits=%ld\n" as *byte,
        g_qp_calls[QP_ENUM_CTX], g_qp_hits[QP_ENUM_CTX],
        g_qp_calls[QP_STRUCT], g_qp_hits[QP_STRUCT],
        g_qp_calls[QP_UNION], g_qp_hits[QP_UNION],
        g_qp_calls[QP_ENUM], g_qp_hits[QP_ENUM],
        g_qp_calls[QP_IFACE], g_qp_hits[QP_IFACE]);
}

/// 功能说明：用 SemanticDb 类型声明索引按 (精确 intern 名, AST 节点类型) O(1) 查找声明。
///           range 按 intern name_id 组织，命中即精确名匹配；未 intern / 无 type range / 无同类型项
///           返回 null。供 codegen 否定查找短路替代全程序线性扫描。
/// 参数说明：`codegen`；`name` 待查名；`kind` 期望 AST 节点类型。返回值说明：命中返回节点，否则 null。
export fn c99_semantic_find_type_decl_by_kind(codegen: &C99CodeGenerator, name: &byte, kind: ASTNodeType) &ASTNode {
    if codegen == null || name == null || codegen.checker == null {
        return null;
    }
    const db: &SemanticDb = &codegen.checker.semantic_db;
    const name_id: i32 = semantic_db_find_interned_name(db, name);
    if name_id < 0 {
        return null;
    }
    var range: SemanticTypeDeclRange = SemanticTypeDeclRange{
        name_id: -1,
        type_start: -1,
        type_count: -1,
    };
    if semantic_db_find_type_decl_range(db, name_id, &range) == 0 {
        return null;
    }
    var offset: i32 = 0;
    while offset < range.type_count {
        const decl_id: i32 = semantic_db_type_range_decl_id(db, &range, offset);
        if decl_id >= 0 {
            const decl: &ASTNode = semantic_db_decl_ast_node(db, decl_id);
            if decl != null && decl.type == kind {
                return decl;
            }
        }
        offset = offset + 1;
    }
    return null;
}

/// 功能说明：是否启用查找 oracle（UYA_C99_LOOKUP_ORACLE=1）：短路决策与原全表扫描对照，不一致则报警。
/// 参数说明：无。返回值说明：启用返回 1，否则 0。
export fn c99_lookup_oracle_enabled() i32 {
    const p: &byte = getenv("UYA_C99_LOOKUP_ORACLE" as &byte);
    if p != null && p[0] != 0 as byte {
        return 1;
    }
    return 0;
}

/// 功能说明：在 SemanticDb 文件记录里按 filename 反查 file_id（遍历文件数 ~86，远小于全程序声明数 ~3828）。
/// 参数说明：`db` SemanticDb；`filename` 目标文件名。返回值说明：命中返回 file_id(>=0)，未登记返回 -1。
export fn c99_semantic_file_id_for(db: &SemanticDb, filename: &byte) i32 {
    if db == null || filename == null {
        return -1;
    }
    const n: i32 = semantic_db_file_record_count(db);
    var i: i32 = 0;
    while i < n {
        const fname: &byte = semantic_db_file_name(db, i);
        if fname != null && strcmp(fname as *byte, filename as *byte) == 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// 功能说明：用 SemanticDb (FileId,NameId) 索引保守判定 (context_filename, enum_name) 是否可能在
///           alias-in-file / enum-in-file / use-in-file 三处命中，供 c99_find_enum_decl_in_context 否定短路。
///           alias/use 用 (file,name) 索引存在性（命中超集，保守偏 1）；enum 用 decl range + file_id 精确判定。
/// 参数说明：`codegen`；`enum_name`；`context_filename`。
/// 返回值说明：1=可能命中（需扫描），0=三处确定都不存在（可短路），-1=无法判定（保守需扫描）。
export fn c99_enum_ctx_name_present_in_file(codegen: &C99CodeGenerator, enum_name: &byte, context_filename: &byte) i32 {
    if codegen == null || codegen.checker == null || enum_name == null || context_filename == null {
        return -1;
    }
    const db: &SemanticDb = &codegen.checker.semantic_db;
    const file_id: i32 = c99_semantic_file_id_for(db, context_filename);
    if file_id < 0 {
        return -1;
    }
    const name_id: i32 = semantic_db_find_interned_name(db, enum_name);
    if name_id < 0 {
        return 0;
    }
    var alias_id: i32 = -1;
    if semantic_db_find_file_alias_decl(db, file_id, name_id, &alias_id) != 0 {
        return 1;
    }
    var binding_id: i32 = -1;
    if semantic_db_find_file_use_item_binding(db, file_id, name_id, &binding_id) != 0 {
        return 1;
    }
    var range: SemanticDeclRange = SemanticDeclRange{
        name_id: -1,
        decl_start: -1,
        decl_count: -1,
    };
    if semantic_db_find_decl_range(db, name_id, &range) != 0 {
        var off: i32 = 0;
        while off < range.decl_count {
            const did: i32 = semantic_db_decl_range_decl_id(db, &range, off);
            if did >= 0 {
                var rec: SemanticDeclRecord = SemanticDeclRecord{
                    ast_node: null,
                    name_id: -1,
                    kind: -1,
                    file_id: -1,
                    module_id: -1,
                };
                if semantic_db_decl_record_get(db, did, &rec) != 0 && rec.file_id == file_id {
                    const d: &ASTNode = semantic_db_decl_ast_node(db, did);
                    if d != null && d.type == ASTNodeType.AST_ENUM_DECL {
                        return 1;
                    }
                }
            }
            off = off + 1;
        }
    }
    return 0;
}

fn c99_codegen_report_capacity_error(node: &ASTNode, table_name: &byte, count: i32, limit: i32) void {
    g_c99_codegen_has_error = 1;
    var name: &byte = table_name;
    if name == null {
        name = "unknown table" as &byte;
    }
    if node != null && node.filename != null {
        fprintf(libc.stderr as *void, "%s:(%d:%d): 错误: C99 codegen %s 超出固定上限 (%d/%d)\n" as *byte,
            node.filename as *byte, node.line, node.column, name as *byte, count, limit);
        return;
    }
    fprintf(libc.stderr as *void, "错误: C99 codegen %s 超出固定上限 (%d/%d)\n" as *byte,
        name as *byte, count, limit);
}

fn c99_path_buf_char_at(buf: &byte, idx: i32) byte {
    if buf == null {
        return 0 as byte;
    }
    if idx < 0 {
        return 0 as byte;
    }
    if idx >= 1024 {
        return 0 as byte;
    }
    return buf[idx];
}
extern fn getcwd(buf: *byte, size: usize) *byte;
extern fn strstr(haystack: *byte, needle: *byte) *byte;
extern fn add_struct_definition(codegen: &C99CodeGenerator, struct_name: &byte) void;

extern fn hash_string(str: &byte) i32;

const C99_SAFE_IDENT_CACHE_BITS: i32 = 11;
const C99_SAFE_IDENT_CACHE_SIZE: i32 = 2048;
const C99_SAFE_IDENT_CACHE_MASK: i32 = 2047;

var g_c99_utils_cached_codegen: &C99CodeGenerator = null;
var g_c99_safe_ident_keys: [&byte: C99_SAFE_IDENT_CACHE_SIZE] = [];
var g_c99_safe_ident_values: [&byte: C99_SAFE_IDENT_CACHE_SIZE] = [];

fn c99_utils_reset_caches(codegen: &C99CodeGenerator) void {
    var i: i32 = 0;
    while i < C99_SAFE_IDENT_CACHE_SIZE {
        g_c99_safe_ident_keys[i] = null;
        g_c99_safe_ident_values[i] = null;
        i = i + 1;
    }
    g_c99_utils_cached_codegen = codegen;
}

fn c99_utils_cache_ensure(codegen: &C99CodeGenerator) void {
    if codegen == null {
        return;
    }
    if g_c99_utils_cached_codegen == codegen {
        return;
    }
    c99_utils_reset_caches(codegen);
}

fn c99_safe_ident_cache_store(codegen: &C99CodeGenerator, name: &byte, safe_name: &byte) void {
    if codegen == null || name == null || safe_name == null {
        return;
    }
    c99_utils_cache_ensure(codegen);
    const slot: i32 = (hash_string(name) & C99_SAFE_IDENT_CACHE_MASK) as i32;
    const name_copy: &byte = c99_arena_strdup(codegen.arena, name);
    if name_copy != null {
        g_c99_safe_ident_keys[slot] = name_copy;
    } else {
        g_c99_safe_ident_keys[slot] = name;
    }
    g_c99_safe_ident_values[slot] = safe_name;
}

fn c99_string_const_cache_store(codegen: &C99CodeGenerator, value: &byte, const_name: &byte) void {
    if codegen == null || value == null || const_name == null {
        return;
    }
    c99_utils_cache_ensure(codegen);
}

fn c99_output_buffer_reset_stats(codegen: &C99CodeGenerator) void {
    if codegen == null {
        return;
    }
    codegen.c99_output_buffer_active_streams = 0;
    codegen.c99_output_buffer_peak_streams = 0;
    codegen.c99_output_buffer_peak_bytes = 0usize;
}

fn c99_output_buffer_note_open(codegen: &C99CodeGenerator, stream: &void) void {
    if codegen == null || stream == null {
        return;
    }
    codegen.c99_output_buffer_active_streams = codegen.c99_output_buffer_active_streams + 1;
    if codegen.c99_output_buffer_active_streams > codegen.c99_output_buffer_peak_streams {
        codegen.c99_output_buffer_peak_streams = codegen.c99_output_buffer_active_streams;
        codegen.c99_output_buffer_peak_bytes = (codegen.c99_output_buffer_peak_streams as usize) * C99_OUTPUT_STREAM_BUFFER_BYTES;
    }
}

fn c99_output_buffer_note_close(codegen: &C99CodeGenerator, stream: &void) void {
    if codegen == null || stream == null {
        return;
    }
    if codegen.c99_output_buffer_active_streams > 0 {
        codegen.c99_output_buffer_active_streams = codegen.c99_output_buffer_active_streams - 1;
    }
}

/// 功能说明：返回 C99 输出流全缓冲区的峰值字节数。
/// 参数说明：`codegen` 为 C99 生成器；为空时返回 0。
/// 返回值说明：返回同时打开的 C99 输出流峰值乘以固定 64KiB FILE 缓冲大小。
export fn c99_codegen_output_buffer_peak_bytes(codegen: &C99CodeGenerator) usize {
    if codegen == null {
        return 0usize;
    }
    return codegen.c99_output_buffer_peak_bytes;
}

// 创建 C99 代码生成器
// split_root: 非空时启用多文件输出（uya_part1.c + uya_part2.c 或镜像多 .c），忽略 output（可传 null）
// split_mirror: 1=镜像分 TU（--split-c-dir 时默认开启）：uya_common.c + 按源路径镜像 .c（无 uya_part2.c）；0=uya_part1+part2
// is_nostdlib: 1=使用 syscall，0=使用标准库
// freestanding: 1=不包含头文件，0=按需包含头文件
fn c99_codegen_new(codegen: &C99CodeGenerator, arena: &CompilerArena, output: &void, module_name: &byte, emit_line_directives: i32, is_nostdlib: i32, stack_size: i32, split_root: &byte, split_mirror: i32, async_frame_heap_fallback: i32) i32 {
    if codegen == null || arena == null || module_name == null {
        return -1;
    }

    var out_file: &void = output;
    var part2_handle: &void = null;
    var types_h: &void = null;
    if split_root != null && split_root[0] != 0 as byte {
        _ = mkdir(split_root as *byte, 493);
        var path1: [byte: 1024] = [];
        var path2: [byte: 1024] = [];
        const n1: i32 = snprintf(&path1[0] as *byte, 1024, "%s/uya_part1.c" as *byte, split_root as *byte);
        if n1 <= 0 || n1 >= 1024 {
            return -1;
        }
        out_file = fopen(&path1[0] as *byte, "w" as *byte);
        if out_file == null {
            return -1;
        }
        if split_mirror != 0 {
            var pth: [byte: 1024] = [];
            const nth: i32 = snprintf(&pth[0] as *byte, 1024, "%s/uya_part1_types.h" as *byte, split_root as *byte);
            if nth > 0 && nth < 1024 {
                types_h = fopen(&pth[0] as *byte, "w" as *byte) as &void;
                if types_h == null {
                    _ = fclose(out_file as *void);
                    return -1;
                }
            } else {
                _ = fclose(out_file as *void);
                return -1;
            }
        }
        if split_mirror == 0 {
            const n2: i32 = snprintf(&path2[0] as *byte, 1024, "%s/uya_part2.c" as *byte, split_root as *byte);
            if n2 <= 0 || n2 >= 1024 {
                _ = fclose(out_file as *void);
                return -1;
            }
            part2_handle = fopen(&path2[0] as *byte, "w" as *byte);
            if part2_handle == null {
                _ = fclose(out_file as *void);
                return -1;
            }
            var pj: i32 = 0;
            while pj < 1023 && pj < @len(path2) {
                if pj >= 0 && pj < @len(path2) && path2[pj] != 0 as byte {
                    if pj >= 0 && pj < @len(codegen.split_part2_path) {
                        codegen.split_part2_path[pj] = path2[pj];
                    }
                    pj = pj + 1;
                } else {
                    break;
                }
            }
            if pj >= 0 && pj < @len(codegen.split_part2_path) {
                codegen.split_part2_path[pj] = 0 as byte;
            }
        } else {
            codegen.split_part2_path[0] = 0 as byte;
        }
    } else {
        if out_file == null {
            return -1;
        }
    }

    // 初始化字段
    c99_utils_reset_caches(codegen);
    c99_ident_ref_cache_reset();
    codegen.arena = arena;
    codegen.checker = null;
    codegen.output = out_file;
    codegen.emit_stream = out_file;
    c99_output_buffer_reset_stats(codegen);
    c99_output_buffer_note_open(codegen, out_file);
    c99_output_buffer_note_open(codegen, types_h);
    c99_output_buffer_note_open(codegen, part2_handle);
    g_c99_codegen_has_error = 0;
    if split_root != null && split_root[0] != 0 as byte && split_mirror != 0 && types_h != null {
        codegen.split_part1_types_h = types_h;
        codegen.emit_stream = types_h;
    }
    if split_root != null && split_root[0] != 0 as byte {
        codegen.split_enabled = 1;
        codegen.split_part2_out = part2_handle;
        codegen.split_body_started = 0;
        codegen.split_dir = c99_arena_strdup(arena, split_root);
        if split_mirror != 0 {
            codegen.split_mirror = 1;
        } else {
            codegen.split_mirror = 0;
        }
    } else {
        codegen.split_enabled = 0;
        codegen.split_part2_out = null;
        codegen.split_body_started = 0;
        codegen.split_dir = null;
        codegen.split_part2_path[0] = 0 as byte;
        codegen.split_mirror = 0;
    }
    var sm_init: i32 = 0;
    while sm_init < 128 {
        codegen.split_mirror_keys[sm_init] = null;
        codegen.split_mirror_handles[sm_init] = null;
        sm_init = sm_init + 1;
    }
    codegen.split_mirror_count = 0;
    codegen.split_mirror_lcp = 0;
    codegen.split_common_out = null;
    codegen.split_protos_out = null;
    codegen.indent_level = 0;
    codegen.module_name = module_name;

    // 初始化表
    semantic_vector_init(&codegen.string_constants, @size_of(StringConstant));
    codegen.string_constant_count = 0;
    codegen.string_constants_emitted_count = 0;
    codegen.embedded_constant_count = 0;
    codegen.embedded_constants_emitted_count = 0;
    codegen.embedded_dir_table_count = 0;
    codegen.embedded_dir_tables_emitted_count = 0;
    codegen.struct_definition_count = 0;
    codegen.enum_definition_count = 0;
    codegen.function_declaration_count = 0;
    codegen.reachable_function_decl_count = 0;
    codegen.global_variable_count = 0;
    codegen.local_variable_count = 0;
    codegen.current_depth = 0;
    codegen.loop_stack_depth = 0;
    codegen.program_node = null;
    codegen.current_function_return_type = null;
    codegen.current_function_decl = null;
    codegen.current_method_struct_name = null;
    codegen.emitting_assign_lhs = 0;
    codegen.atomic_member_plain_lvalue = 0;
    codegen.current_line = 0;  // 当前行号（用于优化 #line 指令）
    codegen.current_filename = null;  // 当前文件名（用于优化 #line 指令）
    codegen.emit_line_directives = emit_line_directives;  // 是否生成 #line 指令
    codegen.string_interp_buf = null;
    codegen.interp_temp_counter = 0;
    codegen.interp_fill_counter = 0;
    var ii: i32 = 0;
    while ii < C99_MAX_CALL_ARGS {
        codegen.interp_arg_temp_names[ii] = null;
        ii = ii + 1;
    }
    codegen.error_count = 0;
    codegen.defer_stack_depth = 0;
    codegen.current_drop_scope = -1;
    codegen.slice_struct_count = 0;
    codegen.err_union_struct_count = 0;
    var eu_z: i32 = 0;
    while eu_z < C99_MAX_ERR_UNION_STRUCTS {
        codegen.err_union_body_emitted[eu_z] = 0;
        eu_z = eu_z + 1;
    }
    codegen.simd_struct_count = 0;
    codegen.simd_vector_struct_reg_count = 0;
    codegen.simd_max_lanes_i8 = 0;
    codegen.simd_max_lanes_u8 = 0;
    codegen.simd_max_lanes_i64 = 0;
    codegen.simd_max_lanes_u64 = 0;
    codegen.simd_max_lanes_i16 = 0;
    codegen.simd_max_lanes_u16 = 0;
    codegen.simd_max_lanes_f64 = 0;
    codegen.simd_max_lanes_i32 = 0;
    codegen.simd_max_lanes_u32 = 0;
    codegen.simd_max_lanes_f32 = 0;
    codegen.simd_emit_select_i32x2 = 0;
    codegen.simd_emit_select_u32x2 = 0;
    codegen.simd_emit_select_f32x2 = 0;
    codegen.simd_emit_select_i32x4 = 0;
    codegen.simd_emit_select_u32x4 = 0;
    codegen.simd_emit_select_f32x4 = 0;
    codegen.simd_emit_reduce_add_i32x2 = 0;
    codegen.simd_emit_reduce_add_u32x2 = 0;
    codegen.simd_emit_reduce_add_f32x2 = 0;
    codegen.simd_emit_reduce_add_i32x4 = 0;
    codegen.simd_emit_reduce_add_u32x4 = 0;
    codegen.simd_emit_reduce_add_f32x4 = 0;
    codegen.simd_emit_reduce_mul_i32x2 = 0;
    codegen.simd_emit_reduce_mul_u32x2 = 0;
    codegen.simd_emit_reduce_mul_f32x2 = 0;
    codegen.simd_emit_reduce_mul_i32x4 = 0;
    codegen.simd_emit_reduce_mul_u32x4 = 0;
    codegen.simd_emit_reduce_mul_f32x4 = 0;
    codegen.simd_emit_reduce_min_i32x2 = 0;
    codegen.simd_emit_reduce_min_u32x2 = 0;
    codegen.simd_emit_reduce_min_f32x2 = 0;
    codegen.simd_emit_reduce_min_i32x4 = 0;
    codegen.simd_emit_reduce_min_u32x4 = 0;
    codegen.simd_emit_reduce_min_f32x4 = 0;
    codegen.simd_emit_reduce_max_i32x2 = 0;
    codegen.simd_emit_reduce_max_u32x2 = 0;
    codegen.simd_emit_reduce_max_f32x2 = 0;
    codegen.simd_emit_reduce_max_i32x4 = 0;
    codegen.simd_emit_reduce_max_u32x4 = 0;
    codegen.simd_emit_reduce_max_f32x4 = 0;
    codegen.test_count = 0;  // 初始化测试计数为 0
    ii = 0;
    while ii < C99_MAX_DEFER_STACK {
        codegen.defer_count[ii] = 0;
        codegen.errdefer_count[ii] = 0;
        ii = ii + 1;
    }

    // 初始化 C99 emitter start 稳定性快照字段
    codegen.emitter_start_mono_instance_count = -1;
    codegen.emitter_start_err_union_struct_count = -1;
    codegen.emitter_start_async_frame_meta_count = -1;
    codegen.emitter_start_string_constant_count = -1;
    codegen.emitter_start_slice_struct_count = -1;
    codegen.emitter_start_simd_struct_count = -1;
    codegen.emitter_start_embedded_constant_count = -1;
    codegen.emitter_start_embedded_dir_table_count = -1;

    // 初始化泛型单态化相关字段
    codegen.mono_instance_count = 0;
    ii = 0;
    while ii < C99_MAX_MONO_INSTANCES {
        codegen.reachable_mono_instances[ii] = 0;
        ii = ii + 1;
    }
    codegen.current_type_params = null;
    codegen.current_type_param_count = 0;
    codegen.current_type_args = null;
    codegen.current_type_arg_count = 0;
    codegen.struct_type_params = null;
    codegen.struct_type_param_count = 0;
    codegen.struct_type_args = null;
    codegen.struct_type_arg_count = 0;
    codegen.type_conv_depth = 0;

    // 初始化声明缓存（由 build_decl_caches 填充，这里仅重置）
    codegen.decl_cache_initialized = 0;
    codegen.enum_context_cache_name = null;
    codegen.enum_context_cache_filename = null;
    codegen.enum_context_cache_result = null;
    codegen.enum_context_cache_valid = 0;
    ii = 0;
    while ii < C99_DECL_CACHE_SIZE {
        codegen.fn_decl_cache[ii] = null;
        codegen.struct_decl_cache[ii] = null;
        codegen.enum_decl_cache[ii] = null;
        codegen.type_alias_cache[ii] = null;
        codegen.union_decl_cache[ii] = null;
        codegen.macro_decl_cache[ii] = null;
        codegen.interface_decl_cache[ii] = null;
        ii = ii + 1;
    }

    // 初始化标准库头文件标志
    codegen.needs_string_h = 0;
    codegen.needs_stdio_h = 0;
    codegen.needs_stdlib_h = 0;
    codegen.needs_syscall_helpers = 0;
    // 初始化 has_stdio_conflicts 标志
    codegen.has_stdio_conflicts = 0;
    // 使用传入的 is_nostdlib 参数
    codegen.is_nostdlib = is_nostdlib;
    // 初始化 stack_size
    codegen.stack_size = stack_size;
    // 初始化 async frame heap fallback
    codegen.async_frame_heap_fallback = async_frame_heap_fallback;
    // freestanding 模式：仅在 nostdlib 模式下启用（不包含任何标准库头文件）
    codegen.freestanding = is_nostdlib;
    // async 状态机参数捕获
    codegen.async_state_var = null;
    codegen.async_param_count = 0;
    codegen.async_bind_count = 0;
    codegen.async_current_bind_name = null;
    codegen.async_current_bind_c_name = null;
    codegen.async_current_bind_type = null;
    codegen.async_collect_count = 0;
    codegen.async_collect_ret_expr = null;
    codegen.async_collect_has_loop = 0;
    codegen.async_local_count = 0;
    ii = 0;
    while ii < @len(codegen.async_local_names) {
        codegen.async_local_root_stmt[ii] = -1;
        ii = ii + 1;
    }
    ii = 0;
    codegen.async_loop_var_name = null;
    codegen.async_loop_var_c = null;
    codegen.async_state_size = 0;
    codegen.async_poll_try_propagate_type = null;
    codegen.async_poll_ret_c = null;
    codegen.async_poll_union_c = null;
    codegen.async_emit_poll_return = 0;
    codegen.async_poll_ready_payload_c = null;
    codegen.async_poll_inner_is_err_union = 0;
    codegen.async_expr_subst_try_expr = null;
    codegen.async_expr_subst_name = null;
    codegen.async_expr_subst_c_name = null;
    codegen.container_mode = 0;
    codegen.c_import_plan = null;
    ii = 0;
    while ii < @len(codegen.async_param_names) {
        codegen.async_param_names[ii] = null;
        ii = ii + 1;
    }
    ii = 0;
    while ii < C99_ASYNC_MAX_AWAITS {
        codegen.async_bind_names[ii] = null;
        codegen.async_bind_c_names[ii] = null;
        ii = ii + 1;
    }

    return 0;
}

// 设置单态化实例（从 TypeChecker 传入）
fn c99_codegen_set_mono_instances(codegen: &C99CodeGenerator, checker: &TypeChecker) i32 {
    if codegen == null || checker == null {
        return -1;
    }
    codegen.checker = checker;
    codegen.mono_instance_count = 0;
    var ri: i32 = 0;
    while ri < C99_MAX_MONO_INSTANCES {
        codegen.reachable_mono_instances[ri] = 0;
        ri = ri + 1;
    }

    const count: i32 = checker.mono_instance_count;
    var i: i32 = 0;
    // 使用 C99_CHECKER_MAX_MONO_INSTANCES 作为循环上限
    // 这样安全证明系统能证明 checker.mono_instances[i] 访问安全
    while i < C99_CHECKER_MAX_MONO_INSTANCES {
        if i < count {
            codegen.mono_instances[i].generic_name = checker.mono_instances[i].generic_name;
            codegen.mono_instances[i].is_function = checker.mono_instances[i].is_function;
            codegen.mono_instances[i].type_arg_count = checker.mono_instances[i].type_arg_count;
            codegen.mono_instances[i].type_args = checker.mono_instances[i].type_arg_nodes;
            codegen.mono_instance_count = codegen.mono_instance_count + 1;
        }
        i = i + 1;
    }

    return 0;
}

fn c99_codegen_set_c_import_plan(codegen: &C99CodeGenerator, plan: &CImportPlan) void {
    if codegen == null {
        return;
    }
    codegen.c_import_plan = plan;
}

fn c99_codegen_set_reachable_functions(codegen: &C99CodeGenerator, checker: &TypeChecker) i32 {
    if codegen == null || checker == null {
        return -1;
    }
    codegen.reachable_function_decl_count = 0;
    var i: i32 = 0;
    while i < checker.reachable_fn_decl_count && i < C99_MAX_REACHABLE_FUNCTIONS {
        codegen.reachable_function_decls[i] = checker.reachable_fn_decls[i];
        codegen.reachable_function_decl_count = codegen.reachable_function_decl_count + 1;
        i = i + 1;
    }
    return 0;
}

// hash(error_name)，0 保留
fn c99_hash_error_name(name: &byte) u32 {
    var h: u32 = 5381;
    var i: i32 = 0;
    while name[i] != 0 {
        const c: u32 = (name[i] as byte) as u32;
        h = ((h * 32) + h) + c;
        i = i + 1;
    }
    if h == 0 { return 1; }
    return h;
}

// 获取或添加错误 ID（hash(error_name)），用于 return error.X 等
fn c99_get_or_add_error_id(codegen: &C99CodeGenerator, name: &byte) i32 {
    if codegen == null || name == null {
        return 0;
    }
    const h: u32 = c99_hash_error_name(name);
    var i: i32 = 0;
    const ecount: i32 = codegen.error_count;
    while i < ecount {
        if i >= 0 && i < C99_MAX_ERROR_IDS {
            if codegen.error_names[i] != null && strcmp(codegen.error_names[i] as *byte, name as *byte) == 0 {
                return codegen.error_hashes[i] as i32;
            }
        }
        i = i + 1;
    }
    if codegen.error_count >= C99_MAX_ERROR_IDS {
        c99_codegen_report_capacity_error(null, "error id registry" as &byte,
            codegen.error_count, C99_MAX_ERROR_IDS);
        return 0;
    }
    const copy: &byte = c99_arena_strdup(codegen.arena, name);
    if copy == null {
        return 0;
    }
    const err_idx: i32 = codegen.error_count;
    if err_idx >= 0 && err_idx < C99_MAX_ERROR_IDS {
        codegen.error_names[err_idx] = copy;
        codegen.error_hashes[err_idx] = h;
    } else {
        c99_codegen_report_capacity_error(null, "error id registry" as &byte,
            err_idx, C99_MAX_ERROR_IDS);
        return 0;
    }
    codegen.error_count = codegen.error_count + 1;
    return h as i32;
}

// 释放资源；多文件模式下关闭由本生成器打开的 FILE*
fn c99_codegen_free(codegen: &C99CodeGenerator) void {
    if codegen == null {
        return;
    }
    if codegen.split_enabled != 0 {
        if codegen.output != null {
            c99_output_buffer_note_close(codegen, codegen.output);
            _ = fclose(codegen.output as *void);
            codegen.output = null;
        }
        if codegen.split_part2_out != null {
            c99_output_buffer_note_close(codegen, codegen.split_part2_out);
            _ = fclose(codegen.split_part2_out as *void);
            codegen.split_part2_out = null;
        }
        if codegen.split_mirror != 0 {
            if codegen.split_part1_types_h != null {
                c99_output_buffer_note_close(codegen, codegen.split_part1_types_h);
                _ = fclose(codegen.split_part1_types_h as *void);
                codegen.split_part1_types_h = null;
            }
            if codegen.split_common_out != null {
                c99_output_buffer_note_close(codegen, codegen.split_common_out);
                _ = fclose(codegen.split_common_out as *void);
                codegen.split_common_out = null;
            }
            if codegen.split_protos_out != null {
                c99_output_buffer_note_close(codegen, codegen.split_protos_out);
                _ = fclose(codegen.split_protos_out as *void);
                codegen.split_protos_out = null;
            }
            var mci: i32 = 0;
            while mci < codegen.split_mirror_count {
                if mci >= 0 && mci < @len(codegen.split_mirror_handles) {
                    if codegen.split_mirror_handles[mci] != null {
                        c99_output_buffer_note_close(codegen, codegen.split_mirror_handles[mci]);
                        _ = fclose(codegen.split_mirror_handles[mci] as *void);
                        codegen.split_mirror_handles[mci] = null;
                    }
                }
                mci = mci + 1;
            }
        }
        codegen.emit_stream = null;
    }
}

// 递归创建路径上的目录（path 为目录路径，不含末尾文件名时也可）
fn c99_mkdir_p_chain(path: &byte) void {
    if path == null {
        return;
    }
    var buf: [byte: 1024] = [];
    var j: i32 = 0;
    while j < 1023 && path[j] != 0 as byte {
        if j >= 0 && j < @len(buf) {
            buf[j] = path[j];
        }
        j = j + 1;
    }
    if j >= 0 && j < @len(buf) {
        buf[j] = 0 as byte;
    }
    var i: i32 = 0;
    while i < j {
        if i >= 0 && i < @len(buf) {
            if buf[i] == 47 as byte && i > 0 {
                buf[i] = 0 as byte;
                _ = mkdir(&buf[0] as *byte, 493);
                buf[i] = 47 as byte;
            }
        }
        i = i + 1;
    }
    _ = mkdir(&buf[0] as *byte, 493);
}

// 为即将创建的文件路径创建父目录
fn c99_mkdir_p_for_file(file_path: &byte) void {
    if file_path == null {
        return;
    }
    var buf: [byte: 1024] = [];
    var j: i32 = 0;
    while j < 1023 && file_path[j] != 0 as byte {
        buf[j] = file_path[j];
        j = j + 1;
    }
    if j >= 0 && j < @len(buf) {
        buf[j] = 0 as byte;
    }
    var k: i32 = j - 1;
    if k >= 1024 {
        k = 1023;
    }
    while k > 0 {
        const scan_idx: i32 = k;
        if scan_idx <= 0 {
            break;
        }
        if scan_idx >= 1024 {
            k = k - 1;
            continue;
        }
        const buf_k: byte = c99_path_buf_char_at(buf, scan_idx);
        if buf_k != 47 as byte {
            k = k - 1;
        } else {
            break;
        }
    }
    if k <= 0 {
        return;
    }
    if k < 0 {
        return;
    }
    if k >= 1024 {
        return;
    }
    buf[k] = 0 as byte;
    c99_mkdir_p_chain(&buf[0] as &byte);
}

fn c99_string_const_ptr(codegen: &C99CodeGenerator, idx: i32) &StringConstant {
    if codegen == null {
        return null;
    }
    if idx < 0 {
        return null;
    }
    if idx >= codegen.string_constant_count {
        return null;
    }
    const ptr: &byte = semantic_vector_item_ptr(&codegen.string_constants, idx as usize);
    if ptr == null {
        return null;
    }
    return ptr as &StringConstant;
}

fn c99_string_const_name_at(codegen: &C99CodeGenerator, idx: i32) &byte {
    const item: &StringConstant = c99_string_const_ptr(codegen, idx);
    if item == null {
        return null;
    }
    return item.name;
}

fn c99_string_const_value_at(codegen: &C99CodeGenerator, idx: i32) &byte {
    const item: &StringConstant = c99_string_const_ptr(codegen, idx);
    if item == null {
        return null;
    }
    return item.value;
}

fn c99_mirror_lcp_len_flat(uniq: &byte, count: i32) i32 {
    if uniq == null || count <= 0 {
        return 0;
    }
    var minlen: i32 = 511;
    var ui: i32 = 0;
    while ui < count {
        var len: i32 = 0;
        while len < 511 && uniq[ui * 512 + len] != 0 as byte {
            len = len + 1;
        }
        if len < minlen {
            minlen = len;
        }
        ui = ui + 1;
    }
    var pos: i32 = 0;
    while pos < minlen {
        const ch: byte = uniq[pos];
        var same: i32 = 1;
        var u2: i32 = 1;
        while u2 < count {
            if uniq[u2 * 512 + pos] != ch {
                same = 0;
                u2 = count;
            }
            u2 = u2 + 1;
        }
        if same == 0 {
            break;
        }
        pos = pos + 1;
    }
    while pos > 0 && uniq[pos - 1] != 47 as byte {
        pos = pos - 1;
    }
    return pos;
}

// 由完整 .uya 路径与 LCP 得到相对路径的 .c 路径（写入 out_rel）
fn c99_mirror_rel_c_from_key(src: &byte, lcp: i32, out_rel: &byte, max_out: i32) i32 {
    if src == null || out_rel == null || max_out < 5 {
        return -1;
    }
    var rel_uya: [byte: 512] = [];
    var ri: i32 = 0;
    while ri < 511 && src[lcp + ri] != 0 as byte {
        if ri >= 0 && ri < @len(rel_uya) {
            rel_uya[ri] = src[lcp + ri];
        }
        ri = ri + 1;
    }
    if ri >= 0 && ri < @len(rel_uya) {
        rel_uya[ri] = 0 as byte;
    }
    if ri == 0 {
        var bn: i32 = 0;
        var bi: i32 = 0;
        while bi < 511 && src[bi] != 0 as byte {
            bn = bi;
            bi = bi + 1;
        }
        while bn >= 0 && src[bn] != 47 as byte {
            bn = bn - 1;
        }
        var t: i32 = 0;
        while t < 511 && src[bn + 1 + t] != 0 as byte {
            if t >= 0 && t < @len(rel_uya) {
                rel_uya[t] = src[bn + 1 + t];
            }
            t = t + 1;
        }
        if t >= 0 && t < @len(rel_uya) {
            rel_uya[t] = 0 as byte;
        }
    }
    return c99_copy_uya_rel_to_c(&rel_uya[0] as &byte, out_rel, max_out);
}

fn c99_copy_uya_rel_to_c(rel_uya: &byte, out_rel: &byte, max_out: i32) i32 {
    if rel_uya == null || out_rel == null || max_out < 5 {
        return -1;
    }
    var i: i32 = 0;
    while i < max_out - 1 && rel_uya[i] != 0 as byte {
        out_rel[i] = rel_uya[i];
        i = i + 1;
    }
    out_rel[i] = 0 as byte;
    if i >= 5 && out_rel[i - 4] == 46 as byte && out_rel[i - 3] == 117 as byte &&
       out_rel[i - 2] == 121 as byte && out_rel[i - 1] == 97 as byte {
        out_rel[i - 4] = 46 as byte;
        out_rel[i - 3] = 99 as byte;
        out_rel[i - 2] = 0 as byte;
        return 0;
    }
    return -1;
}

// 将 decl.filename 规范为绝对路径（与 cwd 拼接相对路径），供镜像 LCP 与 filename 匹配一致
fn c99_mirror_normalize_one_path(src: &byte, out: &byte, max_out: i32) i32 {
    if src == null || out == null || max_out < 2 {
        return -1;
    }
    if src[0] == 47 as byte {
        var i: i32 = 0;
        while i < max_out - 1 && src[i] != 0 as byte {
            out[i] = src[i];
            i = i + 1;
        }
        out[i] = 0 as byte;
        return 0;
    }
    var cwd_buf: [byte: 4096] = [];
    const cw: *byte = getcwd(&cwd_buf[0] as *byte, 4096 as usize);
    if cw == null {
        return -1;
    }
    const wl: i32 = snprintf(out as *byte, max_out as usize, "%s/%s" as *byte, cw as *byte, src as *byte);
    if wl <= 0 || wl >= max_out {
        return -1;
    }
    return 0;
}

// 打开 uya_common.c 与 planner 分配的各镜像 .c，写入 #include "uya_strings_extern.h"
export fn c99_split_mirror_prepare(codegen: &C99CodeGenerator, split_plan: &C99Plan) i32 {
    if codegen == null || codegen.split_enabled == 0 || codegen.split_mirror == 0 || codegen.split_dir == null {
        return 0;
    }
    if split_plan == null || split_plan.split_enabled == 0 || split_plan.split_mirror == 0 {
        return -1;
    }
    codegen.split_mirror_lcp = split_plan.split_lcp;
    var ci: i32 = 0;
    var mirror_slot: i32 = 0;
    const split_unit_count: i32 = c99_plan_usize_to_i32(split_plan.units.count);
    while ci < split_unit_count {
        const unit: &C99UnitPlan = c99_plan_unit_ptr(split_plan, ci);
        if unit != null && unit.kind == C99_SPLIT_UNIT_KIND_MIRROR_SOURCE {
            if mirror_slot < 0 || mirror_slot >= @len(codegen.split_mirror_keys) {
                c99_codegen_report_capacity_error(null, "split-C mirror handle registry" as &byte,
                    mirror_slot, @len(codegen.split_mirror_keys));
                return -1;
            }
            if unit.source_path == null || unit.c_path == null {
                return -1;
            }
            codegen.split_mirror_keys[mirror_slot] = unit.source_path;
            var fullp: [byte: 1024] = [];
            const fl: i32 = snprintf(&fullp[0] as *byte, 1024, "%s/%s" as *byte, codegen.split_dir as *byte, unit.c_path as *byte);
            if fl <= 0 || fl >= 1024 {
                return -1;
            }
            c99_mkdir_p_for_file(&fullp[0] as &byte);
            const fh: *void = fopen(&fullp[0] as *byte, "w" as *byte);
            if fh == null {
                return -1;
            }
            c99_output_buffer_note_open(codegen, fh as &void);
            fputs("#include \"uya_split_protos.h\"\n#include \"uya_mirror_globals.h\"\n#include \"uya_vtable_externs.h\"\n#include \"uya_strings_extern.h\"\n\n" as *byte, fh as *void);
            var is_libc_stdio_unit: i32 = 0;
            var tmp_stdio: [byte: 512] = [];
            if c99_mirror_normalize_one_path(unit.source_path, &tmp_stdio[0] as &byte, 512) == 0 {
                if strstr(&tmp_stdio[0] as *byte, "libc/stdio.uya" as *byte) != null {
                    is_libc_stdio_unit = 1;
                }
            }
            if codegen.freestanding == 0 {
                // fprintf(stderr,...) 等需 stdio；自举镜像 TU 与单文件一致。has_stdio_conflicts 时用 _stdin 宏路径，勿再含 <stdio.h>
                if codegen.has_stdio_conflicts == 0 {
                    fputs("#include <stdio.h>\n" as *byte, fh as *void);
                }
                // split 镜像 TU 里避免暴露 clock_t；直接用底层整型声明 clock()
                fputs("int32_t std_runtime_get_argc(void);\n" as *byte, fh as *void);
                fputs("uint8_t *std_runtime_get_argv(int32_t index);\n" as *byte, fh as *void);
                fputs("extern char *getenv(const char *);\n" as *byte, fh as *void);
                fputs("extern const uint32_t S_IFMT;\nextern const uint32_t S_IFDIR;\nextern const uint32_t S_IFREG;\n" as *byte, fh as *void);
                fputs("extern const uint8_t DT_REG;\nextern const uint8_t DT_UNKNOWN;\nextern const uint8_t DT_DIR;\n" as *byte, fh as *void);
                fputs("extern const int64_t CLOCKS_PER_SEC;\nextern uint64_t clock(void);\n" as *byte, fh as *void);
                if codegen.has_stdio_conflicts != 0 {
                    fputs("extern struct FILE _stdin, _stdout, _stderr;\n" as *byte, fh as *void);
                    // lib/libc/stdio.uya 镜像 .c 内定义 struct FILE * stdin = (&_stdin)，不能与 #define stdin 共存
                    if is_libc_stdio_unit == 0 {
                        fputs("#define stdin (&_stdin)\n#define stdout (&_stdout)\n#define stderr (&_stderr)\n" as *byte, fh as *void);
                    }
                }
            } else {
                // nostdlib：与单文件 main.uya 一致，不配 <stdio.h>；fprintf(stderr,...) 依赖 _stderr + 宏
                fputs("extern struct FILE _stdin, _stdout, _stderr;\n" as *byte, fh as *void);
                if is_libc_stdio_unit == 0 {
                    fputs("#define stdin (&_stdin)\n#define stdout (&_stdout)\n#define stderr (&_stderr)\n" as *byte, fh as *void);
                }
                fputs("int32_t std_runtime_get_argc(void);\n" as *byte, fh as *void);
                fputs("uint8_t *std_runtime_get_argv(int32_t index);\n" as *byte, fh as *void);
                fputs("extern char *getenv(const char *);\n" as *byte, fh as *void);
                fputs("extern const uint32_t S_IFMT;\nextern const uint32_t S_IFDIR;\nextern const uint32_t S_IFREG;\n" as *byte, fh as *void);
                fputs("extern const uint8_t DT_REG;\nextern const uint8_t DT_UNKNOWN;\nextern const uint8_t DT_DIR;\n" as *byte, fh as *void);
                fputs("extern const int64_t CLOCKS_PER_SEC;\nextern uint64_t clock(void);\n" as *byte, fh as *void);
            }
            fputs("\n" as *byte, fh as *void);
            codegen.split_mirror_handles[mirror_slot] = fh as &void;
            mirror_slot = mirror_slot + 1;
        }
        ci = ci + 1;
    }
    codegen.split_mirror_count = mirror_slot;
    const common_unit: &C99UnitPlan = c99_plan_unit_ptr(split_plan, split_plan.split_common_unit_id);
    var common_c_path: &byte = "uya_common.c" as &byte;
    if common_unit != null && common_unit.c_path != null {
        common_c_path = common_unit.c_path;
    }
    var comp: [byte: 1024] = [];
    const cl: i32 = snprintf(&comp[0] as *byte, 1024, "%s/%s" as *byte, codegen.split_dir as *byte, common_c_path as *byte);
    if cl <= 0 || cl >= 1024 {
        return -1;
    }
    c99_mkdir_p_for_file(&comp[0] as &byte);
    const ch: *void = fopen(&comp[0] as *byte, "w" as *byte);
    if ch == null {
        return -1;
    }
    c99_output_buffer_note_open(codegen, ch as &void);
    fputs("#include \"uya_split_protos.h\"\n#include \"uya_mirror_globals.h\"\n#include \"uya_vtable_externs.h\"\n#include \"uya_strings_extern.h\"\n\n" as *byte, ch as *void);
    if codegen.freestanding == 0 {
        if codegen.has_stdio_conflicts == 0 {
            fputs("#include <stdio.h>\n" as *byte, ch as *void);
        }
        // split 公共 TU 里避免暴露 clock_t；直接用底层整型声明 clock()
        fputs("int32_t std_runtime_get_argc(void);\n" as *byte, ch as *void);
        fputs("uint8_t *std_runtime_get_argv(int32_t index);\n" as *byte, ch as *void);
        fputs("extern char *getenv(const char *);\n" as *byte, ch as *void);
        fputs("extern const uint32_t S_IFMT;\nextern const uint32_t S_IFDIR;\nextern const uint32_t S_IFREG;\n" as *byte, ch as *void);
        fputs("extern const uint8_t DT_REG;\nextern const uint8_t DT_UNKNOWN;\nextern const uint8_t DT_DIR;\n" as *byte, ch as *void);
        fputs("extern const int64_t CLOCKS_PER_SEC;\nextern uint64_t clock(void);\n" as *byte, ch as *void);
        if codegen.has_stdio_conflicts != 0 {
            fputs("extern struct FILE _stdin, _stdout, _stderr;\n" as *byte, ch as *void);
            fputs("#define stdin (&_stdin)\n#define stdout (&_stdout)\n#define stderr (&_stderr)\n" as *byte, ch as *void);
        }
    } else {
        fputs("extern struct FILE _stdin, _stdout, _stderr;\n" as *byte, ch as *void);
        fputs("#define stdin (&_stdin)\n#define stdout (&_stdout)\n#define stderr (&_stderr)\n" as *byte, ch as *void);
        fputs("int32_t std_runtime_get_argc(void);\n" as *byte, ch as *void);
        fputs("uint8_t *std_runtime_get_argv(int32_t index);\n" as *byte, ch as *void);
        fputs("extern char *getenv(const char *);\n" as *byte, ch as *void);
        fputs("extern const uint32_t S_IFMT;\nextern const uint32_t S_IFDIR;\nextern const uint32_t S_IFREG;\n" as *byte, ch as *void);
        fputs("extern const uint8_t DT_REG;\nextern const uint8_t DT_UNKNOWN;\nextern const uint8_t DT_DIR;\n" as *byte, ch as *void);
        fputs("extern const int64_t CLOCKS_PER_SEC;\nextern uint64_t clock(void);\n" as *byte, ch as *void);
    }
    fputs("\n" as *byte, ch as *void);
    codegen.split_common_out = ch as &void;
    return 0;
}

export fn c99_mirror_emit_common(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.split_mirror == 0 {
        return;
    }
    if codegen.split_protos_out != null {
        codegen.emit_stream = codegen.split_protos_out;
    } else if codegen.split_common_out != null {
        codegen.emit_stream = codegen.split_common_out;
    }
}

export fn c99_mirror_emit_for_node(codegen: &C99CodeGenerator, node: &ASTNode) void {
    if codegen == null || codegen.split_mirror == 0 {
        return;
    }
    if codegen.split_common_out == null {
        return;
    }
    if node == null || node.filename == null {
        codegen.emit_stream = codegen.split_common_out;
        return;
    }
    const fnm: &byte = node.filename;
    var norm_fnm: [byte: 512] = [];
    if c99_mirror_normalize_one_path(fnm, &norm_fnm[0] as &byte, 512) != 0 {
        codegen.emit_stream = codegen.split_common_out;
        return;
    }
    var ix: i32 = 0;
    while ix < codegen.split_mirror_count {
        if ix >= 0 && ix < @len(codegen.split_mirror_keys) {
            if codegen.split_mirror_keys[ix] != null && strcmp(codegen.split_mirror_keys[ix] as *byte, &norm_fnm[0] as *byte) == 0 {
                if codegen.split_mirror_handles[ix] != null {
                    codegen.emit_stream = codegen.split_mirror_handles[ix];
                } else {
                    codegen.emit_stream = codegen.split_common_out;
                }
                return;
            }
        }
        ix = ix + 1;
    }
    codegen.emit_stream = codegen.split_common_out;
}

// split 模式下在 part1 写完字符串常量后切换到 part2（或 uya_common.c），并写入跨 TU 可见的字符串 extern
export fn c99_split_begin_body(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.split_enabled == 0 {
        return;
    }
    if codegen.split_mirror != 0 {
        if codegen.split_common_out == null {
            return;
        }
        fputs("\n/* --- uya_common.c: 类型与辅助代码（与 uya_part1.c 分 TU 链接） */\n" as *byte, codegen.split_common_out as *void);
        fputc(10, codegen.split_common_out as *void);
        codegen.emit_stream = codegen.split_common_out;
        codegen.split_body_started = 1;
        return;
    }
    if codegen.split_part2_out == null {
        return;
    }
    const p2: &void = codegen.split_part2_out;
    fputs("\n/* --- uya_part2.c: 与 uya_part1.c 分 TU 编译后链接（见 Makefile） */\n" as *byte, p2 as *void);
    fputc(10, p2 as *void);
    codegen.emit_stream = p2;
    codegen.split_body_started = 1;
}

// 在关闭 FILE 之前：将 uya_part2.c 重写为「全部字符串 extern + 原内容」，或镜像模式下写入 uya_strings_extern.h
export fn c99_split_finish_part2_externs(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.split_enabled == 0 || codegen.split_body_started == 0 {
        return;
    }
    _ = fflush(codegen.output as *void);
    if codegen.split_mirror != 0 {
        if codegen.split_common_out != null {
            _ = fflush(codegen.split_common_out as *void);
        }
        var mfi: i32 = 0;
        while mfi < codegen.split_mirror_count {
            if mfi >= 0 && mfi < @len(codegen.split_mirror_handles) {
                if codegen.split_mirror_handles[mfi] != null {
                    _ = fflush(codegen.split_mirror_handles[mfi] as *void);
                }
            }
            mfi = mfi + 1;
        }
        var hp: [byte: 1024] = [];
        const hl: i32 = snprintf(&hp[0] as *byte, 1024, "%s/uya_strings_extern.h" as *byte, codegen.split_dir as *byte);
        if hl > 0 && hl < 1024 {
            const hw: *void = fopen(&hp[0] as *byte, "w" as *byte);
            if hw != null {
                c99_output_buffer_note_open(codegen, hw as &void);
                fputs("// 由 Uya 镜像分 TU 模式生成：与 uya_part1.c 中字符串定义链接\n" as *byte, hw as *void);
                var si: i32 = 0;
                while si < codegen.string_constant_count {
                    const string_name: &byte = c99_string_const_name_at(codegen, si);
                    if string_name != null {
                        fprintf(hw as *void, "extern const char %s[];\n" as *byte, string_name as *byte);
                    }
                    si = si + 1;
                }
                si = 0;
                while si < codegen.embedded_constant_count {
                    if codegen.embedded_constants[si].name != null {
                        var embed_len: i32 = 1;
                        if codegen.embedded_constants[si].size > 0 {
                            embed_len = codegen.embedded_constants[si].size;
                        }
                        fprintf(hw as *void, "extern const unsigned char %s[%d];\n" as *byte, codegen.embedded_constants[si].name as *byte, embed_len);
                    }
                    si = si + 1;
                }
                si = 0;
                while si < codegen.embedded_dir_table_count {
                    if codegen.embedded_dir_tables[si].name != null {
                        var table_len: i32 = 1;
                        if codegen.embedded_dir_tables[si].entry_count > 0 {
                            table_len = codegen.embedded_dir_tables[si].entry_count;
                        }
                        fprintf(hw as *void, "extern const struct EmbedDirEntry %s[%d];\n" as *byte, codegen.embedded_dir_tables[si].name as *byte, table_len);
                    }
                    si = si + 1;
                }
                fputc(10, hw as *void);
                c99_output_buffer_note_close(codegen, hw as &void);
                _ = fclose(hw as *void);
            }
        }
        return;
    }
    if codegen.split_part2_path[0] == 0 as byte {
        return;
    }
    _ = fflush(codegen.split_part2_out as *void);
    c99_output_buffer_note_close(codegen, codegen.split_part2_out);
    _ = fclose(codegen.split_part2_out as *void);
    codegen.split_part2_out = null;
    var tmp_path: [byte: 1100] = [];
    const tlen: i32 = snprintf(&tmp_path[0] as *byte, 1100, "%s.tmp" as *byte, &codegen.split_part2_path[0] as *byte);
    if tlen <= 0 || tlen >= 1100 {
        return;
    }
    const out_wr: *void = fopen(&tmp_path[0] as *byte, "wb" as *byte);
    const in_rd: *void = fopen(&codegen.split_part2_path[0] as *byte, "rb" as *byte);
    if out_wr != null {
        c99_output_buffer_note_open(codegen, out_wr as &void);
    }
    if out_wr == null || in_rd == null {
        if out_wr != null {
            c99_output_buffer_note_close(codegen, out_wr as &void);
            _ = fclose(out_wr as *void);
        }
        if in_rd != null { _ = fclose(in_rd as *void); }
        return;
    }
    fputs("// 与 uya_part1.c 中字符串符号链接；由 Uya 在分 TU 模式下自动生成\n" as *byte, out_wr as *void);
    var si: i32 = 0;
    while si < codegen.string_constant_count {
        const string_name: &byte = c99_string_const_name_at(codegen, si);
        if string_name != null {
            fprintf(out_wr as *void, "extern const char %s[];\n" as *byte, string_name as *byte);
        }
        si = si + 1;
    }
    si = 0;
    while si < codegen.embedded_constant_count {
        if codegen.embedded_constants[si].name != null {
            var embed_len: i32 = 1;
            if codegen.embedded_constants[si].size > 0 {
                embed_len = codegen.embedded_constants[si].size;
            }
            fprintf(out_wr as *void, "extern const unsigned char %s[%d];\n" as *byte, codegen.embedded_constants[si].name as *byte, embed_len);
        }
        si = si + 1;
    }
    fputc(10, out_wr as *void);
    var copy_buf: [byte: 16384] = [];
    var done: i32 = 0;
    while done == 0 {
        const nread: usize = fread(&copy_buf[0] as *void, 1 as usize, 16384 as usize, in_rd as *void);
        if nread == 0 as usize {
            done = 1;
        } else {
            _ = fwrite(&copy_buf[0] as *void, 1 as usize, nread, out_wr as *void);
        }
    }
    _ = fclose(in_rd as *void);
    c99_output_buffer_note_close(codegen, out_wr as &void);
    _ = fclose(out_wr as *void);
    _ = unlink(&codegen.split_part2_path[0] as *byte);
    _ = rename(&tmp_path[0] as *byte, &codegen.split_part2_path[0] as *byte);
}

// 列出 planner 分配到 split-C 的源文件路径（去重），供按源文件镜像拆分时参考
export fn c99_write_mirror_manifest(codegen: &C99CodeGenerator, split_plan: &C99Plan) void {
    if codegen == null || codegen.split_enabled == 0 || codegen.split_dir == null {
        return;
    }
    if split_plan == null {
        return;
    }
    var mp: [byte: 1024] = [];
    const mpl: i32 = snprintf(&mp[0] as *byte, 1024, "%s/mirror_manifest.txt" as *byte, codegen.split_dir as *byte);
    if mpl <= 0 || mpl >= 1024 {
        return;
    }
    const mf: *void = fopen(&mp[0] as *byte, "w" as *byte);
    if mf == null {
        return;
    }
    c99_output_buffer_note_open(codegen, mf as &void);
    fputs("# planner 分配的 split-C 源文件路径（去重），一行一个\n" as *byte, mf as *void);
    const assignment_count: i32 = c99_plan_usize_to_i32(split_plan.split_sources.count);
    var di: i32 = 0;
    while di < assignment_count {
        const assignment: &C99SplitSourceAssignment = c99_plan_split_source_assignment_at(split_plan, di);
        if assignment != null && assignment.source_path != null {
            fputs(assignment.source_path as *byte, mf as *void);
            fputc(10, mf as *void);
        }
        di = di + 1;
    }
    c99_output_buffer_note_close(codegen, mf as &void);
    _ = fclose(mf as *void);
}

// 生成 split 目录下的 Makefile（make -j 并行编译多 .o）
export fn c99_write_split_makefile(codegen: &C99CodeGenerator, split_plan: &C99Plan) void {
    if codegen == null || codegen.split_enabled == 0 || codegen.split_dir == null {
        return;
    }
    if split_plan == null || split_plan.split_enabled == 0 {
        return;
    }
    var mkpath: [byte: 1024] = [];
    const mklen: i32 = snprintf(&mkpath[0] as *byte, 1024, "%s/Makefile" as *byte, codegen.split_dir as *byte);
    if mklen <= 0 || mklen >= 1024 {
        return;
    }
    const mf: *void = fopen(&mkpath[0] as *byte, "w" as *byte);
    if mf == null {
        return;
    }
    c99_output_buffer_note_open(codegen, mf as &void);
    fputs("# Generated by Uya --split-c-dir\n" as *byte, mf);
    // nostdlib 链接无 libc：默认 CFLAGS 禁用栈保护，避免 __stack_chk_fail 未定义
    if codegen.is_nostdlib != 0 {
        fputs("CC ?= cc\nCFLAGS ?= -std=c99 -Wall -Wextra -pedantic -g -fno-stack-protector -I.\nLDFLAGS ?=\n" as *byte, mf);
    } else {
        fputs("CC ?= cc\nCFLAGS ?= -std=c99 -Wall -Wextra -pedantic -g -I.\nLDFLAGS ?=\n" as *byte, mf);
    }
    if codegen.split_mirror != 0 {
        fputs("OBJS :=" as *byte, mf);
        var obj_i: i32 = 0;
        const obj_unit_count: i32 = c99_plan_usize_to_i32(split_plan.units.count);
        while obj_i < obj_unit_count {
            const obj_unit: &C99UnitPlan = c99_plan_unit_ptr(split_plan, obj_i);
            if obj_unit != null && obj_unit.object_path != null &&
                (obj_unit.kind == C99_SPLIT_UNIT_KIND_PART1 ||
                 obj_unit.kind == C99_SPLIT_UNIT_KIND_COMMON ||
                 obj_unit.kind == C99_SPLIT_UNIT_KIND_MIRROR_SOURCE) {
                fputc(32, mf as *void);
                fputs(obj_unit.object_path as *byte, mf as *void);
            }
            obj_i = obj_i + 1;
        }
        if codegen.c_import_plan != null {
            var cimp_obj_i: i32 = 0;
            while cimp_obj_i < codegen.c_import_plan.item_count {
                fprintf(mf as *void, " uya_cimport_%d.o" as *byte, cimp_obj_i);
                cimp_obj_i = cimp_obj_i + 1;
            }
        }
        fputc(10, mf as *void);
        fputs(".PHONY: all clean\n" as *byte, mf);
        fputs("all: $(UYA_OUT)\n" as *byte, mf);
        if codegen.is_nostdlib != 0 {
            fputs("$(UYA_OUT): $(OBJS)\n\t$(CC) $(OBJS) -o $(UYA_OUT) $(LDFLAGS)" as *byte, mf);
            if codegen.c_import_plan != null {
                var ld_i: i32 = 0;
                while ld_i < codegen.c_import_plan.aggregated_ldflags_token_count {
                    if codegen.c_import_plan.aggregated_ldflags_tokens != null && codegen.c_import_plan.aggregated_ldflags_tokens[ld_i] != null {
                        fputc(32, mf as *void);
                        fputs(codegen.c_import_plan.aggregated_ldflags_tokens[ld_i] as *byte, mf as *void);
                    }
                    ld_i = ld_i + 1;
                }
            }
            fputc(10, mf as *void);
        } else {
            fputs("$(UYA_OUT): $(OBJS)\n\t$(CC) $(OBJS) -o $(UYA_OUT) $(LDFLAGS)" as *byte, mf);
            if codegen.c_import_plan != null {
                var ld_i2: i32 = 0;
                while ld_i2 < codegen.c_import_plan.aggregated_ldflags_token_count {
                    if codegen.c_import_plan.aggregated_ldflags_tokens != null && codegen.c_import_plan.aggregated_ldflags_tokens[ld_i2] != null {
                        fputc(32, mf as *void);
                        fputs(codegen.c_import_plan.aggregated_ldflags_tokens[ld_i2] as *byte, mf as *void);
                    }
                    ld_i2 = ld_i2 + 1;
                }
            }
            fputs(" -lm\n" as *byte, mf);
        }
        fputs("uya_part1.o: uya_part1.c uya_part1_types.h uya_strings_extern.h uya_vtable_externs.h\n\t$(CC) -c $(CFLAGS) -I. uya_part1.c -o uya_part1.o\n" as *byte, mf);
        fputs("uya_common.o: uya_common.c uya_split_protos.h uya_mirror_globals.h uya_part1_types.h uya_strings_extern.h uya_vtable_externs.h\n\t$(CC) -c $(CFLAGS) -I. uya_common.c -o uya_common.o\n" as *byte, mf);
        if codegen.c_import_plan != null {
            var cimp_rule_i: i32 = 0;
            while cimp_rule_i < codegen.c_import_plan.item_count {
                const item: CImportItem = codegen.c_import_plan.items[cimp_rule_i];
                fprintf(mf as *void, "uya_cimport_%d.o: %s\n\t$(CC) -c $(CFLAGS)" as *byte,
                    cimp_rule_i, item.resolved_path as *byte);
                var cf_i: i32 = 0;
                while cf_i < item.cflags_token_count {
                    if item.cflags_tokens != null && item.cflags_tokens[cf_i] != null {
                        fputc(32, mf as *void);
                        fputs(item.cflags_tokens[cf_i] as *byte, mf as *void);
                    }
                    cf_i = cf_i + 1;
                }
                fprintf(mf as *void, " %s -o uya_cimport_%d.o\n" as *byte, item.resolved_path as *byte, cimp_rule_i);
                cimp_rule_i = cimp_rule_i + 1;
            }
        }
        var ri: i32 = 0;
        const rule_unit_count: i32 = c99_plan_usize_to_i32(split_plan.units.count);
        while ri < rule_unit_count {
            const rule_unit: &C99UnitPlan = c99_plan_unit_ptr(split_plan, ri);
            if rule_unit != null && rule_unit.kind == C99_SPLIT_UNIT_KIND_MIRROR_SOURCE &&
                rule_unit.c_path != null && rule_unit.object_path != null {
                fprintf(mf as *void, "%s: %s uya_split_protos.h uya_mirror_globals.h uya_part1_types.h uya_strings_extern.h uya_vtable_externs.h\n\t$(CC) -c $(CFLAGS) -I. %s -o %s\n" as *byte,
                    rule_unit.object_path as *byte, rule_unit.c_path as *byte,
                    rule_unit.c_path as *byte, rule_unit.object_path as *byte);
            }
            ri = ri + 1;
        }
        fputs("clean:\n\trm -f $(OBJS) $(UYA_OUT)\n" as *byte, mf);
        c99_output_buffer_note_close(codegen, mf as &void);
        _ = fclose(mf);
        return;
    }
    fputs("OBJS :=" as *byte, mf);
    var base_obj_i: i32 = 0;
    const base_unit_count: i32 = c99_plan_usize_to_i32(split_plan.units.count);
    while base_obj_i < base_unit_count {
        const base_unit: &C99UnitPlan = c99_plan_unit_ptr(split_plan, base_obj_i);
        if base_unit != null && base_unit.object_path != null &&
            (base_unit.kind == C99_SPLIT_UNIT_KIND_PART1 ||
             base_unit.kind == C99_SPLIT_UNIT_KIND_PART2) {
            fputc(32, mf as *void);
            fputs(base_unit.object_path as *byte, mf as *void);
        }
        base_obj_i = base_obj_i + 1;
    }
    if codegen.c_import_plan != null {
        var cimp_obj_i3: i32 = 0;
        while cimp_obj_i3 < codegen.c_import_plan.item_count {
            fprintf(mf as *void, " uya_cimport_%d.o" as *byte, cimp_obj_i3);
            cimp_obj_i3 = cimp_obj_i3 + 1;
        }
    }
    fputc(10, mf as *void);
    fputs(".PHONY: all clean\n" as *byte, mf);
    fputs("all: $(UYA_OUT)\n" as *byte, mf);
    if codegen.is_nostdlib != 0 {
        fputs("$(UYA_OUT): $(OBJS)\n\t$(CC) $(OBJS) -o $(UYA_OUT) $(LDFLAGS)" as *byte, mf);
        if codegen.c_import_plan != null {
            var ld_i3: i32 = 0;
            while ld_i3 < codegen.c_import_plan.aggregated_ldflags_token_count {
                if codegen.c_import_plan.aggregated_ldflags_tokens != null && codegen.c_import_plan.aggregated_ldflags_tokens[ld_i3] != null {
                    fputc(32, mf as *void);
                    fputs(codegen.c_import_plan.aggregated_ldflags_tokens[ld_i3] as *byte, mf as *void);
                }
                ld_i3 = ld_i3 + 1;
            }
        }
        fputc(10, mf as *void);
    } else {
        fputs("$(UYA_OUT): $(OBJS)\n\t$(CC) $(OBJS) -o $(UYA_OUT) $(LDFLAGS)" as *byte, mf);
        if codegen.c_import_plan != null {
            var ld_i4: i32 = 0;
            while ld_i4 < codegen.c_import_plan.aggregated_ldflags_token_count {
                if codegen.c_import_plan.aggregated_ldflags_tokens != null && codegen.c_import_plan.aggregated_ldflags_tokens[ld_i4] != null {
                    fputc(32, mf as *void);
                    fputs(codegen.c_import_plan.aggregated_ldflags_tokens[ld_i4] as *byte, mf as *void);
                }
                ld_i4 = ld_i4 + 1;
            }
        }
        fputs(" -lm\n" as *byte, mf);
    }
    fputs("uya_part1.o: uya_part1.c uya_part1_types.h uya_strings_extern.h\n\t$(CC) -c $(CFLAGS) -I. uya_part1.c -o uya_part1.o\n" as *byte, mf);
    fputs("uya_part2.o: uya_part2.c uya_part1_types.h uya_split_protos.h uya_mirror_globals.h uya_strings_extern.h uya_vtable_externs.h\n\t$(CC) -c $(CFLAGS) -I. uya_part2.c -o uya_part2.o\n" as *byte, mf);
    if codegen.c_import_plan != null {
        var cimp_rule_i2: i32 = 0;
        while cimp_rule_i2 < codegen.c_import_plan.item_count {
            const item2: CImportItem = codegen.c_import_plan.items[cimp_rule_i2];
            fprintf(mf as *void, "uya_cimport_%d.o: %s\n\t$(CC) -c $(CFLAGS)" as *byte,
                cimp_rule_i2, item2.resolved_path as *byte);
            var cf_i2: i32 = 0;
            while cf_i2 < item2.cflags_token_count {
                if item2.cflags_tokens != null && item2.cflags_tokens[cf_i2] != null {
                    fputc(32, mf as *void);
                    fputs(item2.cflags_tokens[cf_i2] as *byte, mf as *void);
                }
                cf_i2 = cf_i2 + 1;
            }
            fprintf(mf as *void, " %s -o uya_cimport_%d.o\n" as *byte, item2.resolved_path as *byte, cimp_rule_i2);
            cimp_rule_i2 = cimp_rule_i2 + 1;
        }
    }
    fputs("clean:\n\trm -f $(OBJS) $(UYA_OUT)\n" as *byte, mf);
    c99_output_buffer_note_close(codegen, mf as &void);
    _ = fclose(mf);
}

// 生成 #line 指令（用于调试，让C编译器错误信息指向原始Uya源文件）
// 优化：只在行号或文件名变化时才生成，避免重复
fn emit_line_directive(codegen: &C99CodeGenerator, line: i32, filename: &byte) void {
    if codegen == null || codegen.emit_stream as *void == null {
        return;
    }
    
    // 如果禁用了 #line 指令生成，跳过
    if codegen.emit_line_directives == 0 {
        return;
    }
    
    // 如果行号无效（<=0），跳过
    if line <= 0 {
        return;
    }
    
    // 如果行号和文件名都没有变化，跳过
    if codegen.current_line == line && codegen.current_filename == filename {
        return;
    }
    
    // 更新当前行号和文件名
    codegen.current_line = line;
    codegen.current_filename = filename;
    
    if filename != null && filename[0] != 0 {
        // 转义文件名中的特殊字符（如引号、反斜杠）
        fprintf(codegen.emit_stream as *void, "#line %d \"" as *byte, line);
        var p: &byte = filename;
        while p[0] != 0 {
            if p[0] == 92 || p[0] == 34 {  // '\' 或 '"'
                fputc(92, codegen.emit_stream as *void);  // '\\'
            }
            fputc(p[0] as i32, codegen.emit_stream as *void);
            p = p + 1;
        }
        fputs("\"\n" as *byte, codegen.emit_stream as *void);
    } else {
        fprintf(codegen.emit_stream as *void, "#line %d\n" as *byte, line);
    }
}

// 缩进输出
// 缩进缓存：避免循环调用 fputs
var g_indent_spaces: [byte: 256] = [];
var g_indent_spaces_init: i32 = 0;

fn init_indent_spaces() void {
    if g_indent_spaces_init == 0 {
        var j: i32 = 0;
        while j < 256 {
            g_indent_spaces[j] = 32; // space
            j = j + 1;
        }
        g_indent_spaces_init = 1;
    }
}

fn c99_emit_indent(codegen: &C99CodeGenerator) void {
    if codegen.indent_level <= 0 {
        return;
    }
    init_indent_spaces();
    var effective_indent: i32 = codegen.indent_level;
    // 缩进仅影响可读性，不影响 C 语义；这里对异常泄漏的缩进层级做上限保护，
    // 避免单个生成函数把输出膨胀成海量空格。
    if effective_indent > 63 {
        effective_indent = 63;
    }
    // 预先计算总空格数，避免循环
    const total: i32 = effective_indent * 4;
    if total > 255 {
        // 超过缓存大小，使用循环（很少见）
        var i: i32 = 0;
        while i < effective_indent {
            fputs("    " as *byte, codegen.emit_stream as *void);
            i = i + 1;
        }
        return;
    }
    // 使用 fwrite 一次性写入，比循环 fputs 快
    fwrite(&g_indent_spaces[0] as *void, 1, total, codegen.emit_stream as *void);
}

// 换行
fn c99_emit_newline(codegen: &C99CodeGenerator) void {
    fputc(10, codegen.emit_stream as *void);  // '\n'
}

// 分号换行
fn c99_emit_semi_newline(codegen: &C99CodeGenerator) void {
    fputs(";\n" as *byte, codegen.emit_stream as *void);
}

// 逗号空格
fn c99_emit_comma_space(codegen: &C99CodeGenerator) void {
    fputs(", " as *byte, codegen.emit_stream as *void);
}

// 右花括号换行
fn c99_emit_close_brace_newline(codegen: &C99CodeGenerator) void {
    fputs("}\n" as *byte, codegen.emit_stream as *void);
}

// 简单输出（带缩进处理）
// 注意：Uya Mini 不支持普通函数的可变参数
// 对于需要格式化的输出，直接使用 fprintf 而不是 c99_emit
fn c99_emit(codegen: &C99CodeGenerator, str: &byte) void {
    // 输出缩进
    c99_emit_indent(codegen);
    
    // 输出字符串（使用 fputs）
    fputs(str as *byte, codegen.emit_stream as *void);
}

// 简单的字符串复制到 Arena（用于 C99 代码生成器）
// 注意：与 lexer.uya 中的 arena_strdup 不同，这个版本接受 &byte 并使用 strlen 计算长度
fn c99_arena_strdup(arena: &CompilerArena, src: &byte) &byte {
    if src == null {
        return null;
    }
    const str_len: i32 = strlen(src as *byte) + 1;
    const dst: &byte = compiler_arena_alloc(arena, str_len) as &byte;
    if dst == null {
        return null;
    }
    memcpy(dst as *void, src as *void, str_len);
    return dst;
}

// C99 关键字列表（作为全局常量数组）
// 注意：Uya Mini 不支持全局数组，这里使用函数内静态数组
fn is_c_keyword(name: &byte) i32 {
    if name == null {
        return 0;
    }
    
    // C99 关键字列表
    // 注意：字符串字面量类型是 *byte，需要转换为 &byte 用于数组元素
    const keywords: [&byte: 38] = [
        "auto" as &byte,
        "break" as &byte,
        "case" as &byte,
        "char" as &byte,
        "const" as &byte,
        "continue" as &byte,
        "default" as &byte,
        "do" as &byte,
        "double" as &byte,
        "else" as &byte,
        "enum" as &byte,
        "extern" as &byte,
        "float" as &byte,
        "for" as &byte,
        "goto" as &byte,
        "if" as &byte,
        "int" as &byte,
        "long" as &byte,
        "register" as &byte,
        "return" as &byte,
        "short" as &byte,
        "signed" as &byte,
        "sizeof" as &byte,
        "static" as &byte,
        "struct" as &byte,
        "switch" as &byte,
        "typedef" as &byte,
        "union" as &byte,
        "unsigned" as &byte,
        "void" as &byte,
        "volatile" as &byte,
        "while" as &byte,
        "bool" as &byte,
        "_Bool" as &byte,
        "_Complex" as &byte,
        "_Imaginary" as &byte,
        "inline" as &byte,
        "restrict" as &byte
    ];
    
    var i: i32 = 0;
    while i < 38 {
        if strcmp(name as *byte, keywords[i] as *byte) == 0 {
            return 1;
        }
        i = i + 1;
    }
    
    return 0;
}

// C 标准库保留名称（stat 等字段可能与宏冲突，需添加 uya_ 前缀）
fn is_c_reserved_name(name: &byte) i32 {
    if name == null {
        return 0;
    }
    const reserved: [&byte: 3] = [
        "st_atime" as &byte,
        "st_mtime" as &byte,
        "st_ctime" as &byte
    ];
    var i: i32 = 0;
    while i < 3 {
        if strcmp(name as *byte, reserved[i] as *byte) == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// 将类型名字符串（如 Future<!i32>）转为合法 C 标识符（Future_err_i32）
fn sanitize_type_name_for_c(codegen: &C99CodeGenerator, name: &byte) &byte {
    if name == null {
        return null;
    }
    var out: [byte: 512] = [];
    var j: i32 = 0;
    var i: i32 = 0;
    while name[i] != 0 && j < 500 {
        const c: byte = name[i];
        if c == 33 {
            const err: &byte = "err_" as *byte;
            var k: i32 = 0;
            while err[k] != 0 && j < 500 {
                out[j] = err[k];
                j = j + 1;
                k = k + 1;
            }
        } else if c == 60 {
            out[j] = 95 as byte;
            j = j + 1;
        } else if c == 62 {
            out[j] = 95 as byte;
            j = j + 1;
        } else if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 32 {
            out[j] = c;
            j = j + 1;
        }
        i = i + 1;
    }
    if j >= 0 && j < @len(out) {
        out[j] = 0;
    }
    return c99_arena_strdup(codegen.arena, &out[0] as &byte);
}

// 获取安全的C标识符（关键字或保留名则添加 uya_ 前缀）
fn get_safe_c_identifier(codegen: &C99CodeGenerator, name: &byte) &byte {
    if name == null {
        return null;
    }
    c99_utils_cache_ensure(codegen);
    const slot: i32 = (hash_string(name) & C99_SAFE_IDENT_CACHE_MASK) as i32;
    const cached_key: &byte = g_c99_safe_ident_keys[slot];
    if cached_key != null && strcmp(cached_key as *byte, name as *byte) == 0 {
        return g_c99_safe_ident_values[slot];
    }
    if strchr(name as *byte, 33) != null || strchr(name as *byte, 60) != null {
        const sanitized: &byte = sanitize_type_name_for_c(codegen, name);
        c99_safe_ident_cache_store(codegen, name, sanitized);
        return sanitized;
    }
    if is_c_keyword(name) == 0 && is_c_reserved_name(name) == 0 {
        // Callers frequently pass stack-backed scratch buffers here (for mono names,
        // synthetic helper names, etc). Returning the raw pointer makes the cache
        // hold dangling data and later codegen can emit corrupted identifiers.
        const safe_copy: &byte = c99_arena_strdup(codegen.arena, name);
        if safe_copy != null {
            c99_safe_ident_cache_store(codegen, name, safe_copy);
            return safe_copy;
        }
        c99_safe_ident_cache_store(codegen, name, name);
        return name;
    }
    
    var buf: [byte: STRUCT_NAME_BUF_SIZE] = [];
    if is_c_reserved_name(name) != 0 {
        snprintf(&buf[0] as *byte, STRUCT_NAME_BUF_SIZE, "uya_%s" as *byte, name as *byte);
        const reserved_safe: &byte = c99_arena_strdup(codegen.arena, &buf[0] as &byte);
        c99_safe_ident_cache_store(codegen, name, reserved_safe);
        return reserved_safe;
    }
    var prefix: i32 = 1;
    while prefix <= 3 {
        if prefix == 1 {
            snprintf(&buf[0] as *byte, STRUCT_NAME_BUF_SIZE, "_%s" as *byte, name as *byte);
        } else if prefix == 2 {
            snprintf(&buf[0] as *byte, STRUCT_NAME_BUF_SIZE, "_%s_" as *byte, name as *byte);
        } else {
            snprintf(&buf[0] as *byte, STRUCT_NAME_BUF_SIZE, "uya_%s" as *byte, name as *byte);
        }
        
        // 检查这个名称是否已经用作关键字（理论上应该不会冲突）
        if is_c_keyword(&buf[0] as &byte) == 0 {
            const safe_name: &byte = c99_arena_strdup(codegen.arena, &buf[0] as &byte);
            c99_safe_ident_cache_store(codegen, name, safe_name);
            return safe_name;
        }
        prefix = prefix + 1;
    }
    
    // 如果仍然冲突，返回原名称（虽然可能导致编译错误）
    const fallback_copy: &byte = c99_arena_strdup(codegen.arena, name);
    if fallback_copy != null {
        c99_safe_ident_cache_store(codegen, name, fallback_copy);
        return fallback_copy;
    }
    c99_safe_ident_cache_store(codegen, name, name);
    return name;
}

// 添加字符串常量
fn add_string_constant(codegen: &C99CodeGenerator, value: &byte) &byte {
    if codegen == null || value == null {
        return null;
    }
    c99_utils_cache_ensure(codegen);
    // 检查是否已存在相同的字符串常量
    var i: i32 = 0;
    while i < codegen.string_constant_count {
        const item: &StringConstant = c99_string_const_ptr(codegen, i);
        if item != null && item.value != null &&
           strcmp(item.value as *byte, value as *byte) == 0 {
            c99_string_const_cache_store(codegen, value, item.name);
            return item.name;
        }
        i = i + 1;
    }
    
    // 生成常量名称（如 str0）
    var name_buf: [byte: NUM_BUF_SIZE] = [];
    snprintf(&name_buf[0] as *byte, NUM_BUF_SIZE, "str%d" as *byte, codegen.string_constant_count);
    
    // 存储到表中
    var record: StringConstant = StringConstant{
        name: c99_arena_strdup(codegen.arena, &name_buf[0] as &byte),
        value: value,
    };
    if record.name == null {
        return null;
    }
    if semantic_vector_append(&codegen.string_constants, &record as &const void) != 0 {
        c99_codegen_report_capacity_error(null, "string constant registry allocation" as &byte,
            codegen.string_constant_count, codegen.string_constant_count + 1);
        return null;
    }
    codegen.string_constant_count = codegen.string_constant_count + 1;
    const stored_idx: i32 = codegen.string_constant_count - 1;
    if stored_idx < 0 {
        return null;
    }
    const const_name: &byte = c99_string_const_name_at(codegen, stored_idx);
    if const_name == null {
        c99_codegen_report_capacity_error(null, "string constant registry metadata" as &byte,
            stored_idx, codegen.string_constant_count);
        return null;
    }
    c99_string_const_cache_store(codegen, value, const_name);
    return const_name;
}

// 查找字符串常量（不添加新的）
fn find_string_constant(codegen: &C99CodeGenerator, value: &byte) &byte {
    if value == null {
        return null;
    }
    c99_utils_cache_ensure(codegen);
    var i: i32 = 0;
    while i < codegen.string_constant_count {
        const item: &StringConstant = c99_string_const_ptr(codegen, i);
        if item != null && item.value != null &&
            strcmp(item.value as *byte, value as *byte) == 0 {
            c99_string_const_cache_store(codegen, value, item.name);
            return item.name;
        }
        i = i + 1;
    }
    return null;
}

fn c99_register_embed_builtin_slice_struct(codegen: &C99CodeGenerator, struct_name: &byte, element_type_name: &byte) void {
    if codegen == null || struct_name == null || element_type_name == null {
        return;
    }
    var i: i32 = 0;
    while i < codegen.slice_struct_count {
        if codegen.slice_struct_names[i] != null &&
            strcmp(codegen.slice_struct_names[i] as *byte, struct_name as *byte) == 0 {
            return;
        }
        i = i + 1;
    }
    if codegen.slice_struct_count < 0 || codegen.slice_struct_count >= C99_MAX_SLICE_STRUCTS {
        c99_codegen_report_capacity_error(null, "slice struct registry" as &byte,
            codegen.slice_struct_count, C99_MAX_SLICE_STRUCTS);
        return;
    }
    const elem_type: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_NAMED, 0, 0, codegen.arena, null);
    if elem_type == null {
        return;
    }
    elem_type.type_named_name = c99_arena_strdup(codegen.arena, element_type_name);
    if elem_type.type_named_name == null {
        elem_type.type_named_name = element_type_name;
    }
    const name_copy: &byte = c99_arena_strdup(codegen.arena, struct_name);
    if name_copy == null {
        return;
    }
    if codegen.slice_struct_count >= 0 && codegen.slice_struct_count < C99_MAX_SLICE_STRUCTS {
        codegen.slice_struct_names[codegen.slice_struct_count] = name_copy;
        codegen.slice_struct_element_types[codegen.slice_struct_count] = elem_type;
        codegen.slice_struct_count = codegen.slice_struct_count + 1;
    }
    add_struct_definition(codegen, name_copy);
}

fn c99_register_embed_slice_types(codegen: &C99CodeGenerator, need_dir_entry: i32) void {
    if codegen == null {
        return;
    }
    c99_register_embed_builtin_slice_struct(codegen, "uya_slice_uint8_t" as &byte, "byte" as &byte);
    if need_dir_entry != 0 {
        c99_register_embed_builtin_slice_struct(codegen, "uya_slice_EmbedDirEntry" as &byte, "EmbedDirEntry" as &byte);
    }
}

fn add_embed_constant(codegen: &C99CodeGenerator, resolved_path: &byte, data: &byte, size: i32) &byte {
    if codegen == null || resolved_path == null {
        return null;
    }
    var i: i32 = 0;
    while i < codegen.embedded_constant_count {
        if codegen.embedded_constants[i].resolved_path != null &&
            strcmp(codegen.embedded_constants[i].resolved_path as *byte, resolved_path as *byte) == 0 {
            return codegen.embedded_constants[i].name;
        }
        i = i + 1;
    }
    if codegen.embedded_constant_count < 0 || codegen.embedded_constant_count >= C99_MAX_EMBEDDED_CONSTANTS {
        c99_codegen_report_capacity_error(null, "embedded constant registry" as &byte,
            codegen.embedded_constant_count, C99_MAX_EMBEDDED_CONSTANTS);
        return null;
    }
    var name_buf: [byte: NUM_BUF_SIZE] = [];
    snprintf(&name_buf[0] as *byte, NUM_BUF_SIZE, "uya_embed_%d" as *byte, codegen.embedded_constant_count);
    const idx: i32 = codegen.embedded_constant_count;
    if idx < 0 || idx >= @len(codegen.embedded_constants) as i32 {
        c99_codegen_report_capacity_error(null, "embedded constant registry" as &byte,
            idx, C99_MAX_EMBEDDED_CONSTANTS);
        return null;
    }
    if idx >= 0 && idx < @len(codegen.embedded_constants) as i32 {
        codegen.embedded_constants[idx].name = c99_arena_strdup(codegen.arena, &name_buf[0] as &byte);
        codegen.embedded_constants[idx].resolved_path = c99_arena_strdup(codegen.arena, resolved_path);
        codegen.embedded_constants[idx].data = data;
        codegen.embedded_constants[idx].size = size;
        codegen.embedded_constant_count = idx + 1;
        const result_name: &byte = codegen.embedded_constants[idx].name;
        return result_name;
    }
    return null;
}

fn add_embed_dir_table(codegen: &C99CodeGenerator, expr: &ASTNode) &byte {
    if codegen == null || expr == null || expr.embed_resolved_path == null {
        return null;
    }
    var i: i32 = 0;
    while i < codegen.embedded_dir_table_count {
        if codegen.embedded_dir_tables[i].root_resolved_path != null &&
            strcmp(codegen.embedded_dir_tables[i].root_resolved_path as *byte, expr.embed_resolved_path as *byte) == 0 {
            return codegen.embedded_dir_tables[i].name;
        }
        i = i + 1;
    }
    if codegen.embedded_dir_table_count < 0 || codegen.embedded_dir_table_count >= C99_MAX_EMBED_DIR_TABLES {
        c99_codegen_report_capacity_error(expr, "embedded dir table registry" as &byte,
            codegen.embedded_dir_table_count, C99_MAX_EMBED_DIR_TABLES);
        return null;
    }
    c99_register_embed_slice_types(codegen, 1);
    var name_buf: [byte: NUM_BUF_SIZE] = [];
    snprintf(&name_buf[0] as *byte, NUM_BUF_SIZE, "uya_embed_dir_%d" as *byte, codegen.embedded_dir_table_count);
    const idx: i32 = codegen.embedded_dir_table_count;
    if idx < 0 || idx >= @len(codegen.embedded_dir_tables) as i32 {
        c99_codegen_report_capacity_error(expr, "embedded dir table registry" as &byte,
            idx, C99_MAX_EMBED_DIR_TABLES);
        return null;
    }
    if idx >= 0 && idx < @len(codegen.embedded_dir_tables) as i32 {
        codegen.embedded_dir_tables[idx].name = c99_arena_strdup(codegen.arena, &name_buf[0] as &byte);
        codegen.embedded_dir_tables[idx].root_resolved_path = c99_arena_strdup(codegen.arena, expr.embed_resolved_path);
        codegen.embedded_dir_tables[idx].entry_paths = expr.embed_dir_paths;
        codegen.embedded_dir_tables[idx].entry_sizes = expr.embed_dir_sizes;
        codegen.embedded_dir_tables[idx].entry_count = expr.embed_dir_entry_count;
        if expr.embed_dir_entry_count > 0 {
            const path_consts: & & byte = compiler_arena_alloc(codegen.arena, @size_of(&byte) * (expr.embed_dir_entry_count as usize)) as & & byte;
            const data_names: & & byte = compiler_arena_alloc(codegen.arena, @size_of(&byte) * (expr.embed_dir_entry_count as usize)) as & & byte;
            if path_consts == null || data_names == null {
                return codegen.embedded_dir_tables[idx].name;
            }
            codegen.embedded_dir_tables[idx].entry_path_consts = path_consts;
            codegen.embedded_dir_tables[idx].entry_data_names = data_names;
            var di: i32 = 0;
            while di < expr.embed_dir_entry_count {
                if expr.embed_dir_paths != null && expr.embed_dir_paths[di] != null {
                    path_consts[di] = add_string_constant(codegen, expr.embed_dir_paths[di]);
                } else {
                    path_consts[di] = null;
                }
                if expr.embed_dir_resolved_paths != null && expr.embed_dir_data != null && expr.embed_dir_sizes != null {
                    data_names[di] = add_embed_constant(codegen, expr.embed_dir_resolved_paths[di], expr.embed_dir_data[di], expr.embed_dir_sizes[di]);
                } else {
                    data_names[di] = null;
                }
                di = di + 1;
            }
        } else {
            codegen.embedded_dir_tables[idx].entry_path_consts = null;
            codegen.embedded_dir_tables[idx].entry_data_names = null;
        }
        codegen.embedded_dir_table_count = idx + 1;
        const result_name: &byte = codegen.embedded_dir_tables[idx].name;
        return result_name;
    }
    return null;
}

// 转义字符串中的特殊字符
fn escape_string_for_c(output: &void, str: &byte) void {
    if str == null {
        return;
    }
    
    var p: &byte = str;
    while p[0] != 0 {
        if p[0] == 10 {  // '\n'
            fputs("\\n" as *byte, output as *void);
        } else if p[0] == 9 {  // '\t'
            fputs("\\t" as *byte, output as *void);
        } else if p[0] == 13 {  // '\r'
            fputs("\\r" as *byte, output as *void);
        } else if p[0] == 92 {  // '\\'
            fputs("\\\\" as *byte, output as *void);
        } else if p[0] == 34 {  // '"'
            fputs("\\\"" as *byte, output as *void);
        } else {
            fputc(p[0] as i32, output as *void);
        }
        p = p + 1;
    }
}

// 输出所有字符串常量
fn emit_string_constants(codegen: &C99CodeGenerator) void {
    if codegen.string_constant_count == 0 {
        return;
    }
    
    fputs("\n// 字符串常量（char 类型以满足 -Wformat= 对 fprintf/snprintf 格式参数的要求）\n" as *byte, codegen.emit_stream as *void);
    var i: i32 = 0;
    while i < codegen.string_constant_count {
        const string_name: &byte = c99_string_const_name_at(codegen, i);
        const string_value: &byte = c99_string_const_value_at(codegen, i);
        if string_name != null && string_value != null {
            if codegen.split_enabled != 0 {
                fprintf(codegen.emit_stream as *void, "const char %s[] = \"" as *byte, string_name as *byte);
            } else {
                fprintf(codegen.emit_stream as *void, "static const char %s[] = \"" as *byte, string_name as *byte);
            }
            escape_string_for_c(codegen.emit_stream, string_value);
            fputs("\";\n" as *byte, codegen.emit_stream as *void);
        }
        i = i + 1;
    }
    codegen.string_constants_emitted_count = codegen.string_constant_count;
}

// 输出收集阶段之后才加入的字符串常量（如宏展开产生的 "id"/"name"）
export fn emit_pending_string_constants(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.string_constant_count <= codegen.string_constants_emitted_count {
        return;
    }
    const saved: &void = codegen.emit_stream;
    if codegen.split_enabled != 0 && codegen.split_body_started != 0 {
        codegen.emit_stream = codegen.output;
    }
    fputs("\n// 延迟字符串常量（宏展开等）\n" as *byte, codegen.emit_stream as *void);
    var emit_start: i32 = codegen.string_constants_emitted_count;
    if emit_start < 0 {
        emit_start = 0;
    }
    var emit_end: i32 = codegen.string_constant_count;
    var i: i32 = emit_start;
    while i < emit_end {
        if i < 0 {
            i = i + 1;
            continue;
        }
        const string_value: &byte = c99_string_const_value_at(codegen, i);
        const string_name: &byte = c99_string_const_name_at(codegen, i);
        if string_name != null && string_value != null {
            if codegen.split_enabled != 0 {
                fprintf(codegen.emit_stream as *void, "const char %s[] = \"" as *byte, string_name as *byte);
            } else {
                fprintf(codegen.emit_stream as *void, "static const char %s[] = \"" as *byte, string_name as *byte);
            }
            escape_string_for_c(codegen.emit_stream, string_value);
            fputs("\";\n" as *byte, codegen.emit_stream as *void);
        }
        i = i + 1;
    }
    codegen.string_constants_emitted_count = emit_end;
    codegen.emit_stream = saved;
}

fn emit_embed_constants_range(codegen: &C99CodeGenerator, start_idx: i32, end_idx: i32) void {
    if codegen == null {
        return;
    }
    var i: i32 = start_idx;
    if i < 0 {
        i = 0;
    }
    var emit_end: i32 = end_idx;
    if emit_end > @len(codegen.embedded_constants) as i32 {
        c99_codegen_report_capacity_error(null, "embedded constant emitted metadata" as &byte,
            emit_end, C99_MAX_EMBEDDED_CONSTANTS);
        return;
    }
    while i < emit_end {
        if i < 0 || i >= @len(codegen.embedded_constants) as i32 {
            i = i + 1;
            continue;
        }
        if i >= 0 && i < @len(codegen.embedded_constants) as i32 {
            const item: EmbeddedBinaryConstant = codegen.embedded_constants[i];
        if item.name == null {
            i = i + 1;
            continue;
        }
        var array_len: i32 = 1;
        if item.size > 0 {
            array_len = item.size;
        }
        if codegen.split_enabled != 0 {
            fprintf(codegen.emit_stream as *void, "const unsigned char %s[%d] = {" as *byte, item.name as *byte, array_len);
        } else {
            fprintf(codegen.emit_stream as *void, "static const unsigned char %s[%d] = {" as *byte, item.name as *byte, array_len);
        }
        if item.size <= 0 || item.data == null {
            fputs(" 0" as *byte, codegen.emit_stream as *void);
        } else {
            var bi: i32 = 0;
            while bi < item.size {
                if (bi % 12) == 0 {
                    fputs("\n    " as *byte, codegen.emit_stream as *void);
                } else {
                    fputs(" " as *byte, codegen.emit_stream as *void);
                }
                fprintf(codegen.emit_stream as *void, "0x%02x" as *byte, (item.data[bi] as i32) & 255);
                if bi < item.size - 1 {
                    fputc(44, codegen.emit_stream as *void);
                }
                bi = bi + 1;
            }
            if item.size > 0 {
                fputc(10, codegen.emit_stream as *void);
                fputs("" as *byte, codegen.emit_stream as *void);
            }
        }
        fputs("};\n" as *byte, codegen.emit_stream as *void);
        }
        i = i + 1;
    }
}

export fn emit_embed_constants(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.embedded_constant_count <= 0 {
        return;
    }
    fputs("\n// 嵌入二进制常量\n" as *byte, codegen.emit_stream as *void);
    emit_embed_constants_range(codegen, 0, codegen.embedded_constant_count);
    codegen.embedded_constants_emitted_count = codegen.embedded_constant_count;
}

export fn emit_pending_embed_constants(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.embedded_constant_count <= codegen.embedded_constants_emitted_count {
        return;
    }
    fputs("\n// 延迟嵌入二进制常量\n" as *byte, codegen.emit_stream as *void);
    emit_embed_constants_range(codegen, codegen.embedded_constants_emitted_count, codegen.embedded_constant_count);
    codegen.embedded_constants_emitted_count = codegen.embedded_constant_count;
}

fn c99_emit_inline_string_ptr(output: &void, text: &byte) void {
    if output == null {
        return;
    }
    if text == null {
        fputs("(uint8_t *)\"\"" as *byte, output as *void);
        return;
    }
    fputs("(uint8_t *)\"" as *byte, output as *void);
    escape_string_for_c(output, text);
    fputc(34, output as *void);
}

fn emit_embed_dir_tables_range(codegen: &C99CodeGenerator, start_idx: i32, end_idx: i32) void {
    if codegen == null {
        return;
    }
    var i: i32 = start_idx;
    if i < 0 {
        i = 0;
    }
    var emit_end: i32 = end_idx;
    if emit_end > @len(codegen.embedded_dir_tables) as i32 {
        c99_codegen_report_capacity_error(null, "embedded dir table emitted metadata" as &byte,
            emit_end, C99_MAX_EMBED_DIR_TABLES);
        return;
    }
    while i < emit_end {
        if i < 0 || i >= @len(codegen.embedded_dir_tables) as i32 {
            i = i + 1;
            continue;
        }
        if i >= 0 && i < @len(codegen.embedded_dir_tables) as i32 {
            const item: EmbeddedDirTableConstant = codegen.embedded_dir_tables[i];
        if item.name == null {
            i = i + 1;
            continue;
        }
        var array_len: i32 = 1;
        if item.entry_count > 0 {
            array_len = item.entry_count;
        }
        if codegen.split_enabled != 0 {
            fprintf(codegen.emit_stream as *void, "const struct EmbedDirEntry %s[%d] = {\n" as *byte, item.name as *byte, array_len);
        } else {
            fprintf(codegen.emit_stream as *void, "static const struct EmbedDirEntry %s[%d] = {\n" as *byte, item.name as *byte, array_len);
        }
        if item.entry_count <= 0 {
            fputs("    { .path = { .ptr = (uint8_t *)\"\", .len = (size_t)0 }, .data = { .ptr = (uint8_t *)\"\", .len = (size_t)0 } }\n" as *byte, codegen.emit_stream as *void);
        } else {
            var ei: i32 = 0;
            while ei < item.entry_count {
                fputs("    {\n        .path = { .ptr = " as *byte, codegen.emit_stream as *void);
                if item.entry_path_consts != null && item.entry_path_consts[ei] != null {
                    fprintf(codegen.emit_stream as *void, "(uint8_t *)%s" as *byte, item.entry_path_consts[ei] as *byte);
                } else if item.entry_paths != null {
                    c99_emit_inline_string_ptr(codegen.emit_stream, item.entry_paths[ei]);
                } else {
                    c99_emit_inline_string_ptr(codegen.emit_stream, null);
                }
                if item.entry_paths != null && item.entry_paths[ei] != null {
                    fprintf(codegen.emit_stream as *void, ", .len = (size_t)%zu },\n" as *byte, strlen(item.entry_paths[ei] as *byte));
                } else {
                    fputs(", .len = (size_t)0 },\n" as *byte, codegen.emit_stream as *void);
                }
                fputs("        .data = { .ptr = " as *byte, codegen.emit_stream as *void);
                if item.entry_data_names != null && item.entry_data_names[ei] != null {
                    fprintf(codegen.emit_stream as *void, "(uint8_t *)%s" as *byte, item.entry_data_names[ei] as *byte);
                } else {
                    fputs("(uint8_t *)\"\"" as *byte, codegen.emit_stream as *void);
                }
                if item.entry_sizes != null {
                    fprintf(codegen.emit_stream as *void, ", .len = (size_t)%d }\n" as *byte, item.entry_sizes[ei]);
                } else {
                    fputs(", .len = (size_t)0 }\n" as *byte, codegen.emit_stream as *void);
                }
                if ei < item.entry_count - 1 {
                    fputs("    },\n" as *byte, codegen.emit_stream as *void);
                } else {
                    fputs("    }\n" as *byte, codegen.emit_stream as *void);
                }
                ei = ei + 1;
            }
        }
        fputs("};\n" as *byte, codegen.emit_stream as *void);
        }
        i = i + 1;
    }
}

export fn emit_embed_dir_tables(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.embedded_dir_table_count <= 0 {
        return;
    }
    fputs("\n// 嵌入目录表\n" as *byte, codegen.emit_stream as *void);
    emit_embed_dir_tables_range(codegen, 0, codegen.embedded_dir_table_count);
    codegen.embedded_dir_tables_emitted_count = codegen.embedded_dir_table_count;
}

export fn emit_pending_embed_dir_tables(codegen: &C99CodeGenerator) void {
    if codegen == null || codegen.embedded_dir_table_count <= codegen.embedded_dir_tables_emitted_count {
        return;
    }
    fputs("\n// 延迟嵌入目录表\n" as *byte, codegen.emit_stream as *void);
    emit_embed_dir_tables_range(codegen, codegen.embedded_dir_tables_emitted_count, codegen.embedded_dir_table_count);
    codegen.embedded_dir_tables_emitted_count = codegen.embedded_dir_table_count;
}

// 评估编译时常量表达式（返回 -1 表示无法评估）
fn eval_const_expr(codegen: &C99CodeGenerator, expr: &ASTNode) i32 {
    if expr == null {
        return -1;
    }
    // 与 checker_eval_const_expr 一致：符号表解析 export const（含跨文件），否则 [T: MAX_N] 在 C 中退化为 [1]
    if codegen != null && codegen.checker != null {
        const ck: i32 = checker_eval_const_expr(codegen.checker, expr);
        if ck != -1 {
            return ck;
        }
    }

    if expr.type == ASTNodeType.AST_NUMBER {
        return expr.number_value as i32;
    } else if expr.type == ASTNodeType.AST_FLOAT {
        return -1;
    } else if expr.type == ASTNodeType.AST_IDENTIFIER {
        // 查找常量变量声明
        if codegen == null || codegen.program_node == null {
            return -1;
        }
        
        const const_name: &byte = expr.identifier_name;
        if const_name == null {
            return -1;
        }
        
        // 从程序节点中查找常量变量声明
        const program: &ASTNode = codegen.program_node;
        if program.type != ASTNodeType.AST_PROGRAM {
            return -1;
        }
        
        var i: i32 = 0;
        while i < program.program_decl_count {
            const decl: &ASTNode = program.program_decls[i];
            if decl != null && decl.type == ASTNodeType.AST_VAR_DECL {
                const var_name: &byte = decl.var_decl_name;
                if var_name != null && strcmp(var_name as *byte, const_name as *byte) == 0 {
                    if decl.var_decl_is_const != 0 {
                        const init_expr: &ASTNode = decl.var_decl_init;
                        if init_expr != null {
                            return eval_const_expr(codegen, init_expr);
                        }
                        return -1;
                    }
                }
            } else if decl != null && decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
                const ex_name: &byte = decl.extern_var_decl_name;
                if ex_name != null && strcmp(ex_name as *byte, const_name as *byte) == 0 &&
                    decl.extern_var_decl_is_const != 0 {
                    const ex_init: &ASTNode = decl.extern_var_decl_init_expr;
                    if ex_init != null {
                        return eval_const_expr(codegen, ex_init);
                    }
                    return -1;
                }
            }
            i = i + 1;
        }
        // 未找到常量变量或不是 const
        return -1;
    } else if expr.type == ASTNodeType.AST_BINARY_EXPR {
        const left: &ASTNode = expr.binary_expr_left;
        const right: &ASTNode = expr.binary_expr_right;
        const op_tmp: !TokenType = expr.binary_expr_op as! TokenType;
        const op: TokenType = op_tmp.value;
        const left_val: i32 = eval_const_expr(codegen, left);
        const right_val: i32 = eval_const_expr(codegen, right);
        if left_val == -1 || right_val == -1 {
            return -1;
        }
        
        if op == TokenType.TOKEN_PLUS {
            return left_val + right_val;
        } else if op == TokenType.TOKEN_MINUS {
            return left_val - right_val;
        } else if op == TokenType.TOKEN_ASTERISK {
            return left_val * right_val;
        } else if op == TokenType.TOKEN_SLASH {
            if right_val == 0 {
                return -1;
            }
            return left_val / right_val;
        } else if op == TokenType.TOKEN_PERCENT {
            if right_val == 0 {
                return -1;
            }
            return left_val % right_val;
        } else {
            // 不支持的操作符
            return -1;
        }
    } else if expr.type == ASTNodeType.AST_UNARY_EXPR {
        const op_tmp: !TokenType = expr.unary_expr_op as! TokenType;
        const op: TokenType = op_tmp.value;
        const operand: &ASTNode = expr.unary_expr_operand;
        const operand_val: i32 = eval_const_expr(codegen, operand);
        if operand_val == -1 {
            return -1;
        }
        
        if op == TokenType.TOKEN_PLUS {
            return operand_val;
        } else if op == TokenType.TOKEN_MINUS {
            return -operand_val;
        } else {
            // 不支持的其他一元操作符
            return -1;
        }
    } else {
        // 不是常量表达式
        return -1;
    }
}

// 从字符串插值构建 printf 格式串并添加为常量，用于 printf(interp) 脱糖为单次 printf(fmt, ...)
fn build_and_add_printf_fmt_from_interp(codegen: &C99CodeGenerator, interp: &ASTNode) &byte {
    if codegen == null || interp == null || interp.type != ASTNodeType.AST_STRING_INTERP {
        return null;
    }
    const n: i32 = interp.string_interp_segment_count;
    if n <= 0 { return null; }
    var buf: [byte: C99_STRING_INTERP_BUF_SIZE] = [];
    var off: i32 = 0;
    var i: i32 = 0;
    while i < n && off < C99_STRING_INTERP_BUF_SIZE - 32 {
        const seg: &ASTStringInterpSegment = &interp.string_interp_segments[i];
        if seg.is_text != 0 && seg.text != null {
            var p: i32 = 0;
            while seg.text[p] != 0 && off < C99_STRING_INTERP_BUF_SIZE - 36 {
                if seg.text[p] == 37 {
                    buf[off] = 37;
                    off = off + 1;
                    buf[off] = 37;
                    off = off + 1;
                } else {
                    buf[off] = seg.text[p];
                    off = off + 1;
                }
                p = p + 1;
            }
        } else {
            buf[off] = 37;
            off = off + 1;
            if seg.format_spec != null && seg.format_spec[0] != 0 {
                var k: i32 = 0;
                while seg.format_spec[k] != 0 && off < C99_STRING_INTERP_LIMIT {
                    buf[off] = seg.format_spec[k];
                    off = off + 1;
                    k = k + 1;
                }
            } else {
                buf[off] = 100;
                off = off + 1;
            }
        }
        i = i + 1;
    }
    if off >= 0 && off < C99_STRING_INTERP_BUF_SIZE {
        buf[off] = 0;
    }
    return add_string_constant(codegen, &buf[0] as &byte);
}

// 将插值格式串直接输出到 output（内联），不依赖常量表
fn emit_printf_fmt_inline(codegen: &C99CodeGenerator, interp: &ASTNode) void {
    if codegen == null || interp == null || interp.type != ASTNodeType.AST_STRING_INTERP {
        return;
    }
    const n: i32 = interp.string_interp_segment_count;
    if n <= 0 { return; }
    var buf: [byte: C99_STRING_INTERP_BUF_SIZE] = [];
    var off: i32 = 0;
    var i: i32 = 0;
    while i < n && off < C99_STRING_INTERP_BUF_SIZE - 32 {
        const seg: &ASTStringInterpSegment = &interp.string_interp_segments[i];
        if seg.is_text != 0 && seg.text != null {
            var p: i32 = 0;
            while seg.text[p] != 0 && off < C99_STRING_INTERP_BUF_SIZE - 36 {
                if seg.text[p] == 37 {
                    buf[off] = 37;
                    off = off + 1;
                    buf[off] = 37;
                    off = off + 1;
                } else {
                    buf[off] = seg.text[p];
                    off = off + 1;
                }
                p = p + 1;
            }
        } else {
            buf[off] = 37;
            off = off + 1;
            if seg.format_spec != null && seg.format_spec[0] != 0 {
                var k: i32 = 0;
                while seg.format_spec[k] != 0 && off < C99_STRING_INTERP_LIMIT {
                    buf[off] = seg.format_spec[k];
                    off = off + 1;
                    k = k + 1;
                }
            } else {
                buf[off] = 100;
                off = off + 1;
            }
        }
        i = i + 1;
    }
    if off >= 0 && off < C99_STRING_INTERP_BUF_SIZE {
        buf[off] = 0;
    }
    fputc(34, codegen.emit_stream as *void);
    escape_string_for_c(codegen.emit_stream, &buf[0] as &byte);
    fputc(34, codegen.emit_stream as *void);
}

// 收集表达式中的字符串常量（不生成代码）
fn collect_string_constants_from_expr(codegen: &C99CodeGenerator, expr: &ASTNode) void {
    if expr == null {
        return;
    }
    
    if expr.type == ASTNodeType.AST_STRING {
        if expr.string_literal_value != null {
            add_string_constant(codegen, expr.string_literal_value);
        }
    } else if expr.type == ASTNodeType.AST_SRC_NAME {
        // 收集文件名字符串常量
        const filename: &byte = expr.filename;
        var basename: &byte = null;
        if filename == null {
            basename = "(unknown)" as &byte;
        } else {
            basename = strrchr(filename as *byte, 47) as &byte;  // '/' = ASCII 47
            if basename == null {
                basename = strrchr(filename as *byte, 92) as &byte;  // '\\' = ASCII 92
            }
            if basename != null {
                basename = (basename as i64 + 1) as &byte;
            } else {
                basename = filename;
            }
        }
        add_string_constant(codegen, basename);
    } else if expr.type == ASTNodeType.AST_SRC_PATH {
        // 收集文件路径字符串常量
        const filepath: &byte = expr.filename;
        var path: &byte = null;
        if filepath == null {
            path = "(unknown)" as &byte;
        } else {
            path = filepath;
        }
        add_string_constant(codegen, path);
    } else if expr.type == ASTNodeType.AST_FUNC_NAME {
        // 收集函数名字符串常量
        var func_name: &byte = "(unknown)" as &byte;
        if codegen.current_function_decl != null &&
           codegen.current_function_decl.type == ASTNodeType.AST_FN_DECL &&
           codegen.current_function_decl.fn_decl_name != null {
            func_name = codegen.current_function_decl.fn_decl_name;
        }
        add_string_constant(codegen, func_name);
    } else if expr.type == ASTNodeType.AST_STRING_INTERP {
        var i: i32 = 0;
        while i < expr.string_interp_segment_count {
            const seg: &ASTStringInterpSegment = &expr.string_interp_segments[i];
            if seg.is_text != 0 && seg.text != null {
                add_string_constant(codegen, seg.text);
            } else {
                var fmt_buf: [byte: FMT_BUF_SIZE] = [];
                fmt_buf[0] = 37;
                var j: i32 = 1;
                if seg.format_spec != null && seg.format_spec[0] != 0 {
                    var k: i32 = 0;
                    while seg.format_spec[k] != 0 && j < FMT_BUF_SIZE - 2 {
                        fmt_buf[j] = seg.format_spec[k];
                        j = j + 1;
                        k = k + 1;
                    }
                } else {
                    fmt_buf[1] = 100;
                    j = 2;
                }
                if j >= 0 && j < FMT_BUF_SIZE {
                    fmt_buf[j] = 0;
                }
                const fmt_in_arena: &byte = c99_arena_strdup(codegen.arena, &fmt_buf[0] as &byte);
                if fmt_in_arena != null {
                    add_string_constant(codegen, fmt_in_arena);
                }
                if seg.expr != null {
                    collect_string_constants_from_expr(codegen, seg.expr);
                }
            }
            i = i + 1;
        }
    } else if expr.type == ASTNodeType.AST_BINARY_EXPR {
        collect_string_constants_from_expr(codegen, expr.binary_expr_left);
        collect_string_constants_from_expr(codegen, expr.binary_expr_right);
    } else if expr.type == ASTNodeType.AST_UNARY_EXPR {
        collect_string_constants_from_expr(codegen, expr.unary_expr_operand);
    } else if expr.type == ASTNodeType.AST_CALL_EXPR {
        const callee: &ASTNode = expr.call_expr_callee;
        const args: & & ASTNode = expr.call_expr_args;
        const arg_count: i32 = expr.call_expr_arg_count;
        collect_string_constants_from_expr(codegen, callee);
        var i: i32 = 0;
        while i < arg_count {
            collect_string_constants_from_expr(codegen, args[i]);
            i = i + 1;
        }
    } else if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        collect_string_constants_from_expr(codegen, expr.member_access_object);
    } else if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        collect_string_constants_from_expr(codegen, expr.array_access_array);
        collect_string_constants_from_expr(codegen, expr.array_access_index);
    } else if expr.type == ASTNodeType.AST_STRUCT_INIT {
        var i: i32 = 0;
        while i < expr.struct_init_field_count {
            collect_string_constants_from_expr(codegen, expr.struct_init_field_values[i]);
            i = i + 1;
        }
    } else if expr.type == ASTNodeType.AST_ARRAY_LITERAL {
        const repeat: &ASTNode = expr.array_literal_repeat_count_expr;
        const count: i32 = expr.array_literal_element_count;
        if repeat != null && count >= 1 {
            collect_string_constants_from_expr(codegen, expr.array_literal_elements[0]);
        } else {
            var i: i32 = 0;
            while i < count {
                collect_string_constants_from_expr(codegen, expr.array_literal_elements[i]);
                i = i + 1;
            }
        }
    } else if expr.type == ASTNodeType.AST_TUPLE_LITERAL {
        const count: i32 = expr.tuple_literal_element_count;
        const elements: & & ASTNode = expr.tuple_literal_elements;
        if elements != null {
            var i: i32 = 0;
            while i < count {
                collect_string_constants_from_expr(codegen, elements[i]);
                i = i + 1;
            }
        }
    } else if expr.type == ASTNodeType.AST_SIZEOF || expr.type == ASTNodeType.AST_LEN || expr.type == ASTNodeType.AST_ALIGNOF {
        // 这些表达式内部可能包含表达式或类型，但类型节点不包含字符串
        // 暂时忽略
    } else if expr.type == ASTNodeType.AST_CAST_EXPR {
        collect_string_constants_from_expr(codegen, expr.cast_expr_expr);
    } else if expr.type == ASTNodeType.AST_TRY_EXPR {
        collect_string_constants_from_expr(codegen, expr.try_expr_operand);
    } else if expr.type == ASTNodeType.AST_CATCH_EXPR {
        collect_string_constants_from_expr(codegen, expr.catch_expr_operand);
        if expr.catch_expr_catch_block != null {
            const block: &ASTNode = expr.catch_expr_catch_block;
            var i: i32 = 0;
            while i < block.block_stmt_count {
                collect_string_constants_from_stmt(codegen, block.block_stmts[i]);
                i = i + 1;
            }
        }
    } else if expr.type == ASTNodeType.AST_SLICE_EXPR {
        collect_string_constants_from_expr(codegen, expr.slice_expr_base);
        collect_string_constants_from_expr(codegen, expr.slice_expr_start_expr);
        collect_string_constants_from_expr(codegen, expr.slice_expr_len_expr);
    } else if expr.type == ASTNodeType.AST_SYSCALL {
        // @syscall 表达式：收集系统调用号和参数中的字符串
        if expr.syscall_number != null {
            collect_string_constants_from_expr(codegen, expr.syscall_number);
        }
        var sc_i: i32 = 0;
        while sc_i < expr.syscall_arg_count {
            if expr.syscall_args[sc_i] != null {
                collect_string_constants_from_expr(codegen, expr.syscall_args[sc_i]);
            }
            sc_i = sc_i + 1;
        }
    } else if expr.type == ASTNodeType.AST_VA_START {
        if expr.va_start_ap != null { collect_string_constants_from_expr(codegen, expr.va_start_ap); }
        if expr.va_start_last_param != null { collect_string_constants_from_expr(codegen, expr.va_start_last_param); }
    } else if expr.type == ASTNodeType.AST_VA_END {
        if expr.va_end_ap != null { collect_string_constants_from_expr(codegen, expr.va_end_ap); }
    } else if expr.type == ASTNodeType.AST_VA_ARG {
        if expr.va_arg_ap != null { collect_string_constants_from_expr(codegen, expr.va_arg_ap); }
    } else if expr.type == ASTNodeType.AST_PRINT || expr.type == ASTNodeType.AST_PRINTLN {
        if expr.print_expr != null { collect_string_constants_from_expr(codegen, expr.print_expr); }
    } else {
        // 其他表达式类型（标识符、数字、布尔值）不包含字符串
    }
}

fn collect_embed_constants_from_expr(codegen: &C99CodeGenerator, expr: &ASTNode) void {
    if codegen == null || expr == null {
        return;
    }
    if expr.type == ASTNodeType.AST_EMBED {
        c99_register_embed_slice_types(codegen, 0);
        if expr.embed_resolved_path != null {
            add_embed_constant(codegen, expr.embed_resolved_path, expr.embed_data, expr.embed_size);
        }
        return;
    }
    if expr.type == ASTNodeType.AST_EMBED_DIR {
        c99_register_embed_slice_types(codegen, 1);
        add_embed_dir_table(codegen, expr);
        return;
    }
    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        collect_embed_constants_from_expr(codegen, expr.binary_expr_left);
        collect_embed_constants_from_expr(codegen, expr.binary_expr_right);
    } else if expr.type == ASTNodeType.AST_UNARY_EXPR {
        collect_embed_constants_from_expr(codegen, expr.unary_expr_operand);
    } else if expr.type == ASTNodeType.AST_CALL_EXPR {
        collect_embed_constants_from_expr(codegen, expr.call_expr_callee);
        if expr.call_expr_args != null {
            var ai: i32 = 0;
            while ai < expr.call_expr_arg_count {
                collect_embed_constants_from_expr(codegen, expr.call_expr_args[ai]);
                ai = ai + 1;
            }
        }
    } else if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        collect_embed_constants_from_expr(codegen, expr.member_access_object);
    } else if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        collect_embed_constants_from_expr(codegen, expr.array_access_array);
        collect_embed_constants_from_expr(codegen, expr.array_access_index);
    } else if expr.type == ASTNodeType.AST_SLICE_EXPR {
        collect_embed_constants_from_expr(codegen, expr.slice_expr_base);
        collect_embed_constants_from_expr(codegen, expr.slice_expr_start_expr);
        collect_embed_constants_from_expr(codegen, expr.slice_expr_len_expr);
    } else if expr.type == ASTNodeType.AST_STRUCT_INIT {
        var fi: i32 = 0;
        while fi < expr.struct_init_field_count {
            collect_embed_constants_from_expr(codegen, expr.struct_init_field_values[fi]);
            fi = fi + 1;
        }
    } else if expr.type == ASTNodeType.AST_ARRAY_LITERAL {
        var ei: i32 = 0;
        while ei < expr.array_literal_element_count {
            collect_embed_constants_from_expr(codegen, expr.array_literal_elements[ei]);
            ei = ei + 1;
        }
        collect_embed_constants_from_expr(codegen, expr.array_literal_repeat_count_expr);
    } else if expr.type == ASTNodeType.AST_TUPLE_LITERAL {
        var ti: i32 = 0;
        while ti < expr.tuple_literal_element_count {
            collect_embed_constants_from_expr(codegen, expr.tuple_literal_elements[ti]);
            ti = ti + 1;
        }
    } else if expr.type == ASTNodeType.AST_CAST_EXPR {
        collect_embed_constants_from_expr(codegen, expr.cast_expr_expr);
    } else if expr.type == ASTNodeType.AST_LEN {
        collect_embed_constants_from_expr(codegen, expr.len_expr_array);
    } else if expr.type == ASTNodeType.AST_SIZEOF {
        if expr.sizeof_expr_is_type == 0 {
            collect_embed_constants_from_expr(codegen, expr.sizeof_expr_target);
        }
    } else if expr.type == ASTNodeType.AST_ALIGNOF {
        if expr.alignof_expr_is_type == 0 {
            collect_embed_constants_from_expr(codegen, expr.alignof_expr_target);
        }
    } else if expr.type == ASTNodeType.AST_TRY_EXPR {
        collect_embed_constants_from_expr(codegen, expr.try_expr_operand);
    } else if expr.type == ASTNodeType.AST_AWAIT_EXPR {
        collect_embed_constants_from_expr(codegen, expr.await_expr_operand);
    } else if expr.type == ASTNodeType.AST_CATCH_EXPR {
        collect_embed_constants_from_expr(codegen, expr.catch_expr_operand);
        if expr.catch_expr_catch_block != null {
            var ci: i32 = 0;
            while ci < expr.catch_expr_catch_block.block_stmt_count {
                collect_embed_constants_from_stmt(codegen, expr.catch_expr_catch_block.block_stmts[ci]);
                ci = ci + 1;
            }
        }
    } else if expr.type == ASTNodeType.AST_MATCH_EXPR {
        collect_embed_constants_from_expr(codegen, expr.match_expr_expr);
        if expr.match_expr_arms != null {
            var mi: i32 = 0;
            while mi < expr.match_expr_arm_count {
                collect_embed_constants_from_expr(codegen, expr.match_expr_arms[mi].result_expr);
                mi = mi + 1;
            }
        }
    } else if expr.type == ASTNodeType.AST_PRINT || expr.type == ASTNodeType.AST_PRINTLN {
        collect_embed_constants_from_expr(codegen, expr.print_expr);
    } else if expr.type == ASTNodeType.AST_PTR_FROM_USIZE {
        collect_embed_constants_from_expr(codegen, expr.ptr_from_usize_value);
    } else if expr.type == ASTNodeType.AST_USIZE_FROM_PTR {
        collect_embed_constants_from_expr(codegen, expr.usize_from_ptr_ptr);
    } else if expr.type == ASTNodeType.AST_ERROR_ID {
        collect_embed_constants_from_expr(codegen, expr.error_id_operand);
    } else if expr.type == ASTNodeType.AST_ERROR_NAME {
        collect_embed_constants_from_expr(codegen, expr.error_name_operand);
    } else if expr.type == ASTNodeType.AST_SYSCALL {
        collect_embed_constants_from_expr(codegen, expr.syscall_number);
        var si: i32 = 0;
        while si < expr.syscall_arg_count {
            collect_embed_constants_from_expr(codegen, expr.syscall_args[si]);
            si = si + 1;
        }
    } else if expr.type == ASTNodeType.AST_VA_START {
        collect_embed_constants_from_expr(codegen, expr.va_start_ap);
        collect_embed_constants_from_expr(codegen, expr.va_start_last_param);
    } else if expr.type == ASTNodeType.AST_VA_END {
        collect_embed_constants_from_expr(codegen, expr.va_end_ap);
    } else if expr.type == ASTNodeType.AST_VA_ARG {
        collect_embed_constants_from_expr(codegen, expr.va_arg_ap);
    } else if expr.type == ASTNodeType.AST_VA_COPY {
        collect_embed_constants_from_expr(codegen, expr.va_copy_dest);
        collect_embed_constants_from_expr(codegen, expr.va_copy_src);
    }
}

// 收集语句中的字符串常量
fn collect_string_constants_from_stmt(codegen: &C99CodeGenerator, stmt: &ASTNode) void {
    if stmt == null {
        return;
    }
    
    if stmt.type == ASTNodeType.AST_EXPR_STMT {
        // 表达式语句的数据存储在表达式的节点中，直接忽略此节点
    } else if stmt.type == ASTNodeType.AST_ASSIGN {
        const dest: &ASTNode = stmt.assign_dest;
        const src: &ASTNode = stmt.assign_src;
        collect_string_constants_from_expr(codegen, dest);
        collect_string_constants_from_expr(codegen, src);
    } else if stmt.type == ASTNodeType.AST_RETURN_STMT {
        const expr: &ASTNode = stmt.return_stmt_expr;
        collect_string_constants_from_expr(codegen, expr);
    } else if stmt.type == ASTNodeType.AST_BLOCK {
        var i: i32 = 0;
        while i < stmt.block_stmt_count {
            collect_string_constants_from_stmt(codegen, stmt.block_stmts[i]);
            i = i + 1;
        }
    } else if stmt.type == ASTNodeType.AST_VAR_DECL {
        const init_expr: &ASTNode = stmt.var_decl_init;
        if init_expr != null {
            collect_string_constants_from_expr(codegen, init_expr);
        }
    } else if stmt.type == ASTNodeType.AST_DESTRUCTURE_DECL {
        const init_expr: &ASTNode = stmt.destructure_decl_init;
        if init_expr != null {
            collect_string_constants_from_expr(codegen, init_expr);
        }
    } else if stmt.type == ASTNodeType.AST_IF_STMT {
        const condition: &ASTNode = stmt.if_stmt_condition;
        const then_branch: &ASTNode = stmt.if_stmt_then_branch;
        const else_branch: &ASTNode = stmt.if_stmt_else_branch;
        collect_string_constants_from_expr(codegen, condition);
        collect_string_constants_from_stmt(codegen, then_branch);
        if else_branch != null {
            collect_string_constants_from_stmt(codegen, else_branch);
        }
    } else if stmt.type == ASTNodeType.AST_WHILE_STMT {
        const condition: &ASTNode = stmt.while_stmt_condition;
        const body: &ASTNode = stmt.while_stmt_body;
        collect_string_constants_from_expr(codegen, condition);
        collect_string_constants_from_stmt(codegen, body);
    } else if stmt.type == ASTNodeType.AST_FOR_STMT {
        const body: &ASTNode = stmt.for_stmt_body;
        if stmt.for_stmt_is_range != 0 {
            collect_string_constants_from_expr(codegen, stmt.for_stmt_range_start);
            if stmt.for_stmt_range_end != null {
                collect_string_constants_from_expr(codegen, stmt.for_stmt_range_end);
            }
        } else {
            collect_string_constants_from_expr(codegen, stmt.for_stmt_array);
        }
        collect_string_constants_from_stmt(codegen, body);
    } else if stmt.type == ASTNodeType.AST_BREAK_STMT || stmt.type == ASTNodeType.AST_CONTINUE_STMT {
        // 不包含表达式
    } else if stmt.type == ASTNodeType.AST_DEFER_STMT {
        if stmt.defer_stmt_body != null {
            collect_string_constants_from_stmt(codegen, stmt.defer_stmt_body);
        }
    } else if stmt.type == ASTNodeType.AST_ERRDEFER_STMT {
        if stmt.errdefer_stmt_body != null {
            collect_string_constants_from_stmt(codegen, stmt.errdefer_stmt_body);
        }
    } else {
        // 可能是表达式节点（如 ASTNodeType.AST_BINARY_EXPR 等）
        // 在这种情况下，将其视为表达式处理
        collect_string_constants_from_expr(codegen, stmt);
    }
}

fn collect_embed_constants_from_stmt(codegen: &C99CodeGenerator, stmt: &ASTNode) void {
    if codegen == null || stmt == null {
        return;
    }
    if stmt.type == ASTNodeType.AST_ASSIGN {
        collect_embed_constants_from_expr(codegen, stmt.assign_dest);
        collect_embed_constants_from_expr(codegen, stmt.assign_src);
    } else if stmt.type == ASTNodeType.AST_RETURN_STMT {
        collect_embed_constants_from_expr(codegen, stmt.return_stmt_expr);
    } else if stmt.type == ASTNodeType.AST_BLOCK {
        var i: i32 = 0;
        while i < stmt.block_stmt_count {
            collect_embed_constants_from_stmt(codegen, stmt.block_stmts[i]);
            i = i + 1;
        }
    } else if stmt.type == ASTNodeType.AST_VAR_DECL {
        collect_embed_constants_from_expr(codegen, stmt.var_decl_init);
    } else if stmt.type == ASTNodeType.AST_DESTRUCTURE_DECL {
        collect_embed_constants_from_expr(codegen, stmt.destructure_decl_init);
    } else if stmt.type == ASTNodeType.AST_IF_STMT {
        collect_embed_constants_from_expr(codegen, stmt.if_stmt_condition);
        collect_embed_constants_from_stmt(codegen, stmt.if_stmt_then_branch);
        collect_embed_constants_from_stmt(codegen, stmt.if_stmt_else_branch);
    } else if stmt.type == ASTNodeType.AST_WHILE_STMT {
        collect_embed_constants_from_expr(codegen, stmt.while_stmt_condition);
        collect_embed_constants_from_stmt(codegen, stmt.while_stmt_body);
    } else if stmt.type == ASTNodeType.AST_FOR_STMT {
        if stmt.for_stmt_is_range != 0 {
            collect_embed_constants_from_expr(codegen, stmt.for_stmt_range_start);
            collect_embed_constants_from_expr(codegen, stmt.for_stmt_range_end);
        } else {
            collect_embed_constants_from_expr(codegen, stmt.for_stmt_array);
        }
        collect_embed_constants_from_stmt(codegen, stmt.for_stmt_body);
    } else if stmt.type == ASTNodeType.AST_DEFER_STMT {
        collect_embed_constants_from_stmt(codegen, stmt.defer_stmt_body);
    } else if stmt.type == ASTNodeType.AST_ERRDEFER_STMT {
        collect_embed_constants_from_stmt(codegen, stmt.errdefer_stmt_body);
    } else {
        collect_embed_constants_from_expr(codegen, stmt);
    }
}

// 收集声明中的字符串常量（全局变量初始化、函数体、方法块）
fn collect_string_constants_from_decl(codegen: &C99CodeGenerator, decl: &ASTNode) void {
    if decl == null {
        return;
    }
    
    if decl.type == ASTNodeType.AST_VAR_DECL {
        if decl.var_decl_init != null {
            collect_string_constants_from_expr(codegen, decl.var_decl_init);
        }
    } else if decl.type == ASTNodeType.AST_FN_DECL {
        // 保存并设置当前函数上下文
        const saved_current_function_decl: &ASTNode = codegen.current_function_decl;
        codegen.current_function_decl = decl;
        
        const body: &ASTNode = decl.fn_decl_body;
        if body != null {
            collect_string_constants_from_stmt(codegen, body);
        }
        
        // 恢复之前的函数上下文
        codegen.current_function_decl = saved_current_function_decl;
    } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
        // 方法块：遍历所有方法，收集字符串常量
        var i: i32 = 0;
        while i < decl.method_block_method_count {
            const m: &ASTNode = decl.method_block_methods[i];
            if m != null && m.type == ASTNodeType.AST_FN_DECL {
                const saved_current_function_decl: &ASTNode = codegen.current_function_decl;
                codegen.current_function_decl = m;
                
                const body: &ASTNode = m.fn_decl_body;
                if body != null {
                    collect_string_constants_from_stmt(codegen, body);
                }
                
                codegen.current_function_decl = saved_current_function_decl;
            }
            i = i + 1;
        }
    } else {
        // 其他声明类型
    }
}

fn collect_embed_constants_from_decl(codegen: &C99CodeGenerator, decl: &ASTNode) void {
    if codegen == null || decl == null {
        return;
    }
    if decl.type == ASTNodeType.AST_VAR_DECL {
        collect_embed_constants_from_expr(codegen, decl.var_decl_init);
    } else if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        collect_embed_constants_from_expr(codegen, decl.extern_var_decl_init_expr);
    } else if decl.type == ASTNodeType.AST_FN_DECL {
        collect_embed_constants_from_stmt(codegen, decl.fn_decl_body);
    } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
        var i: i32 = 0;
        while i < decl.method_block_method_count {
            collect_embed_constants_from_decl(codegen, decl.method_block_methods[i]);
            i = i + 1;
        }
    } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
        var mi: i32 = 0;
        while mi < decl.struct_decl_method_count {
            collect_embed_constants_from_decl(codegen, decl.struct_decl_methods[mi]);
            mi = mi + 1;
        }
    } else if decl.type == ASTNodeType.AST_TEST_STMT {
        collect_embed_constants_from_stmt(codegen, decl.test_stmt_body);
    }
}
