// codegen/c99/plan.uya - C99 planner 合同：把发射计划与实际发射解耦的数据结构。
//
// 仅依赖 arena + semantic 动态 vector，所有列表（includes/typedefs/prototypes/
// globals/functions/helpers/deps 以及 split-C unit 列表）随数据动态增长，
// 不设固定最大 unit 数或固定容量上限。

use libc.getcwd;

export const C99_PLAN_LIFECYCLE_UNINITIALIZED: i32 = 0;
export const C99_PLAN_LIFECYCLE_ACTIVE: i32 = 1;
export const C99_PLAN_LIFECYCLE_RELEASED: i32 = 2;

export const C99_SPLIT_UNIT_KIND_GENERIC: i32 = 0;
export const C99_SPLIT_UNIT_KIND_PART1: i32 = 1;
export const C99_SPLIT_UNIT_KIND_PART2: i32 = 2;
export const C99_SPLIT_UNIT_KIND_COMMON: i32 = 3;
export const C99_SPLIT_UNIT_KIND_MIRROR_SOURCE: i32 = 4;

const C99_SPLIT_PLAN_PATH_BUF_SIZE: i32 = 512;

/// 功能说明：一个 split-C translation unit 的发射计划。
/// 参数说明：无；`unit_id` 为稳定下标，`name_id` 为 intern 后的 unit 名称。
/// 返回值说明：无。所有列表为 i32 稳定 ID 的动态 vector。
export struct C99UnitPlan {
    unit_id: i32,
    name_id: InternedNameId,
    kind: i32,
    source_path: &byte,
    c_path: &byte,
    object_path: &byte,
    includes: SemanticVector,
    typedefs: SemanticVector,
    prototypes: SemanticVector,
    globals: SemanticVector,
    functions: SemanticVector,
    helpers: SemanticVector,
    deps: SemanticVector,
}

/// 功能说明：整个 C99 输出的发射计划。
/// 参数说明：无；调用 `c99_plan_init` 后使用。
/// 返回值说明：无。program 级列表与 split-C unit 列表全部动态增长。
export struct C99Plan {
    arena: &CompilerArena,
    unit_count: usize,
    decl_count: i32,
    estimated_bytes: usize,
    resident_peak_bytes: usize,
    lifecycle_state: i32,
    split_enabled: i32,
    split_mirror: i32,
    split_lcp: i32,
    split_part1_unit_id: i32,
    split_part2_unit_id: i32,
    split_common_unit_id: i32,
    split_source_count: usize,
    includes: SemanticVector,
    typedefs: SemanticVector,
    prototypes: SemanticVector,
    globals: SemanticVector,
    functions: SemanticVector,
    helpers: SemanticVector,
    deps: SemanticVector,
    decls: SemanticVector,
    units: SemanticVector,
    split_sources: SemanticVector,
}

/// 功能说明：一个顶层 AST 声明的 planner 事件记录。
/// 参数说明：无；`decl` 指向已解析程序中的稳定 AST 声明节点。
/// 返回值说明：无；emitter 后续只消费该计划表，不直接枚举 program_decls。
export struct C99DeclPlanEntry {
    decl: &ASTNode,
}

/// 功能说明：一个源文件到 split-C unit 的分配记录。
/// 参数说明：无；`source_path` 为规范化源路径，`unit_id` 指向 `C99Plan.units`。
/// 返回值说明：无；被跳过镜像拆分的源文件会分配到 common unit。
export struct C99SplitSourceAssignment {
    source_path: &byte,
    unit_id: i32,
}

/// 功能说明：聚合 C99Plan 所有动态表的统计摘要。
/// 参数说明：无；由 `c99_plan_stats` 返回。
/// 返回值说明：无。
export struct C99PlanStats {
    table_count: i32,
    table_items: usize,
    table_capacity: usize,
    table_bytes: usize,
    table_realloc_count: i32,
}

export const C99_PROTOTYPE_KIND_FUNCTION: i32 = 1;
export const C99_PROTOTYPE_KIND_MONO_FUNCTION: i32 = 2;
export const C99_PROTOTYPE_KIND_METHOD: i32 = 3;
export const C99_PROTOTYPE_KIND_MONO_METHOD: i32 = 4;

const C99_PROTOTYPE_NAME_BUF_SIZE: i32 = 256;

/// 功能说明：一条 C99 函数前向声明发射事件。
/// 参数说明：无；字段保存声明节点、receiver 名称以及单态化类型实参。
/// 返回值说明：无；`kind` 使用 `C99_PROTOTYPE_KIND_*` 常量。
export struct C99PrototypePlanEntry {
    kind: i32,
    decl: &ASTNode,
    owner_name: &byte,
    owner_decl: &ASTNode,
    owner_type_args: & & ASTNode,
    owner_type_arg_count: i32,
    type_args: & & ASTNode,
    type_arg_count: i32,
}

/// 功能说明：C99 function prototype 输出计划。
/// 参数说明：无；调用 `c99_prototype_plan_init` 后由 planner 填充。
/// 返回值说明：无；entries 是按最终发射顺序排列的动态事件表。
export struct C99PrototypePlan {
    entries: SemanticVector,
    count: i32,
}

export const C99_TYPEDEF_KIND_REGISTER_STRUCT: i32 = 1;
export const C99_TYPEDEF_KIND_REGISTER_MONO_STRUCT: i32 = 2;
export const C99_TYPEDEF_KIND_REGISTER_ENUM: i32 = 3;
export const C99_TYPEDEF_KIND_ENUM: i32 = 4;
export const C99_TYPEDEF_KIND_ALIAS: i32 = 5;
export const C99_TYPEDEF_KIND_UNION: i32 = 6;
export const C99_TYPEDEF_KIND_MONO_UNION: i32 = 7;
export const C99_TYPEDEF_KIND_BUILTIN_TYPEINFO: i32 = 8;
export const C99_TYPEDEF_KIND_STRUCT: i32 = 9;
export const C99_TYPEDEF_KIND_MONO_STRUCT: i32 = 10;

/// 功能说明：一条 C99 类型定义相关发射事件。
/// 参数说明：无；`decl` 保存源声明，`type_args` 保存泛型单态实例实参。
/// 返回值说明：无；`kind` 使用 `C99_TYPEDEF_KIND_*` 常量。
export struct C99TypeDefinitionPlanEntry {
    kind: i32,
    decl: &ASTNode,
    type_args: & & ASTNode,
    type_arg_count: i32,
}

/// 功能说明：C99 type definition 输出计划。
/// 参数说明：无；调用 `c99_type_definition_plan_init` 后由 planner 填充。
/// 返回值说明：无；registrations、early_definitions、layout_definitions 均按最终阶段顺序排列。
export struct C99TypeDefinitionPlan {
    registrations: SemanticVector,
    early_definitions: SemanticVector,
    layout_definitions: SemanticVector,
    registration_count: i32,
    early_definition_count: i32,
    layout_definition_count: i32,
}

/// 功能说明：C99 helper 输出需求计划。
/// 参数说明：无；字段为 planner 固化的 helper 需求布尔值和 async frame 元数据快照。
/// 返回值说明：无；emitter 只按这些字段决定是否发射对应 helper 文本。
export struct C99HelperPlan {
    emit_error_name_helper: i32,
    emit_microapp_mmu_helpers: i32,
    emit_simd_runtime_helpers: i32,
    emit_syscall_helpers: i32,
    emit_microapp_syscall_helpers: i32,
    emit_async_frame_descriptors: i32,
    async_frame_descriptor_count: i32,
    async_frame_runtime_used: i32,
}

/// 功能说明：C99 helper 计划构建输入。
/// 参数说明：无；字段来自 AST、codegen 配置与发射前已收敛的待输出表计数。
/// 返回值说明：无；用于避免 planner 构建函数直接依赖 C99CodeGenerator。
export struct C99HelperPlanInput {
    ast: &ASTNode,
    decl_plan: &C99Plan,
    decl_count: i32,
    container_mode: i32,
    microapp_softvm_mode: i32,
    needs_syscall_helpers: i32,
    simd_struct_count: i32,
    async_frame_meta_count: i32,
}

/// 功能说明：split-C unit 分配计划构建输入。
/// 参数说明：无；字段来自当前 AST 与 codegen split 配置。
/// 返回值说明：无；用于让 planner 负责源文件到 translation unit 的稳定分配。
export struct C99SplitUnitPlanInput {
    ast: &ASTNode,
    decl_count: i32,
    split_enabled: i32,
    split_mirror: i32,
}

struct C99SplitSourceScanEntry {
    source_path: &byte,
    assign_common: i32,
}

/// 功能说明：C99 头部/前导输出计划，记录 include 与宿主 extern 声明需求。
/// 参数说明：无；字段由 `c99_prelude_plan_build` 根据 AST 与 codegen 配置填充。
/// 返回值说明：无；emitter 只消费这些布尔决策并按既有顺序写出文本。
export struct C99PreludePlan {
    has_mem_functions: i32,
    has_string_functions: i32,
    has_stdlib_conflicts: i32,
    has_own_opendir: i32,
    has_own_readdir: i32,
    has_own_closedir: i32,
    include_stddef_h: i32,
    include_stdio_base_h: i32,
    include_math_h: i32,
    include_string_h: i32,
    include_stdlib_h: i32,
    include_stdio_requested_h: i32,
    emit_malloc_decl: i32,
    emit_free_decl: i32,
    emit_realloc_decl: i32,
    emit_calloc_decl: i32,
    emit_clock_decl: i32,
    emit_abort_decl: i32,
    emit_read_decl: i32,
    emit_write_decl: i32,
    emit_opendir_decl: i32,
    emit_readdir_decl: i32,
    emit_closedir_decl: i32,
    emit_exit_decl: i32,
}

/// 功能说明：C99 前导计划构建输入。
/// 参数说明：无；字段来自当前 AST、codegen 配置与目标环境。
/// 返回值说明：无；用于避免 planner 构建函数暴露过长参数列表。
export struct C99PreludePlanInput {
    ast: &ASTNode,
    decl_plan: &C99Plan,
    decl_count: i32,
    freestanding: i32,
    needs_string_h: i32,
    needs_stdio_h: i32,
    needs_stdlib_h: i32,
    has_stdio_conflicts: i32,
    is_bootstrap: i32,
    target_os_is_macos: i32,
}

fn c99_plan_usize_to_i32(value: usize) i32 {
    const converted: !i32 = value as! i32;
    return converted catch {
        return -1;
    };
}

fn c99_plan_i32_to_usize(value: i32) usize {
    if value < 0 {
        return 0usize;
    }
    const converted: !usize = value as! usize;
    return converted catch {
        return 0usize;
    };
}

fn c99_plan_strlen(s: &byte) i32 {
    if s == null {
        return 0;
    }
    var n: i32 = 0;
    while n < 4096 && s[n] != 0 as byte {
        n = n + 1;
    }
    return n;
}

fn c99_plan_strdup(plan: &C99Plan, src: &byte) &byte {
    if src == null {
        return null;
    }
    if plan == null || plan.arena == null {
        return src;
    }
    const len: i32 = c99_plan_strlen(src) + 1;
    if len <= 0 {
        return null;
    }
    const dst: &byte = compiler_arena_alloc(plan.arena, len) as &byte;
    if dst == null {
        return null;
    }
    var i: i32 = 0;
    while i < len {
        dst[i] = src[i];
        i = i + 1;
    }
    return dst;
}

fn c99_split_plan_contains(path: &byte, needle: &byte) i32 {
    if path == null || needle == null {
        return 0;
    }
    const needle_len: i32 = c99_plan_strlen(needle);
    if needle_len <= 0 {
        return 1;
    }
    var i: i32 = 0;
    while path[i] != 0 as byte {
        var j: i32 = 0;
        while j < needle_len && path[i + j] != 0 as byte && path[i + j] == needle[j] {
            j = j + 1;
        }
        if j == needle_len {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn c99_split_plan_copy_to_buf(src: &byte, out: &byte, max_out: i32) i32 {
    if src == null || out == null || max_out <= 0 {
        return -1;
    }
    var i: i32 = 0;
    while i < max_out - 1 && src[i] != 0 as byte {
        out[i] = src[i];
        i = i + 1;
    }
    if i >= max_out {
        return -1;
    }
    out[i] = 0 as byte;
    if src[i] != 0 as byte {
        return -1;
    }
    return 0;
}

fn c99_split_plan_normalize_one_path(plan: &C99Plan, src: &byte) &byte {
    if src == null {
        return null;
    }
    var out: [byte: C99_SPLIT_PLAN_PATH_BUF_SIZE] = [];
    if src[0] == 47 as byte {
        if c99_split_plan_copy_to_buf(src, &out[0] as &byte, C99_SPLIT_PLAN_PATH_BUF_SIZE) != 0 {
            return null;
        }
        return c99_plan_strdup(plan, &out[0] as &byte);
    }
    var cwd_buf: [byte: 4096] = [];
    const cwd: *byte = getcwd(&cwd_buf[0] as *byte, 4096 as usize);
    if cwd == null {
        return null;
    }
    var wi: i32 = 0;
    while wi < C99_SPLIT_PLAN_PATH_BUF_SIZE - 1 && cwd_buf[wi] != 0 as byte {
        out[wi] = cwd_buf[wi];
        wi = wi + 1;
    }
    if wi >= C99_SPLIT_PLAN_PATH_BUF_SIZE - 2 {
        return null;
    }
    out[wi] = 47 as byte;
    wi = wi + 1;
    var si: i32 = 0;
    while wi < C99_SPLIT_PLAN_PATH_BUF_SIZE - 1 && src[si] != 0 as byte {
        out[wi] = src[si];
        wi = wi + 1;
        si = si + 1;
    }
    if src[si] != 0 as byte {
        return null;
    }
    out[wi] = 0 as byte;
    return c99_plan_strdup(plan, &out[0] as &byte);
}

fn c99_split_plan_should_assign_common(normalized_path: &byte) i32 {
    if normalized_path == null {
        return 1;
    }
    if c99_split_plan_contains(normalized_path, "runtime/entry/entry.uya" as &byte) != 0 {
        return 1;
    }
    if c99_split_plan_contains(normalized_path, "/tests/" as &byte) != 0 ||
        c99_split_plan_contains(normalized_path, "tests/test" as &byte) != 0 {
        return 1;
    }
    if c99_split_plan_contains(normalized_path, "runtime/runtime.uya" as &byte) != 0 {
        return 1;
    }
    if c99_split_plan_contains(normalized_path, "std/thread.uya" as &byte) != 0 {
        return 1;
    }
    return 0;
}

fn c99_split_source_scan_at(vec: &SemanticVector, idx: i32) &C99SplitSourceScanEntry {
    if vec == null || idx < 0 {
        return null;
    }
    return semantic_vector_item_ptr(vec, c99_plan_i32_to_usize(idx)) as &C99SplitSourceScanEntry;
}

fn c99_split_source_scan_append_unique(plan: &C99Plan, vec: &SemanticVector, source_path: &byte) i32 {
    if plan == null || vec == null || source_path == null {
        return -1;
    }
    const normalized: &byte = c99_split_plan_normalize_one_path(plan, source_path);
    if normalized == null {
        return -1;
    }
    const scan_count: i32 = c99_plan_usize_to_i32(vec.count);
    var i: i32 = 0;
    while i < scan_count {
        const existing: &C99SplitSourceScanEntry = c99_split_source_scan_at(vec, i);
        if existing != null && existing.source_path != null &&
            strcmp(existing.source_path as *byte, normalized as *byte) == 0 {
            return 0;
        }
        i = i + 1;
    }
    var entry: C99SplitSourceScanEntry = C99SplitSourceScanEntry{
        source_path: normalized,
        assign_common: c99_split_plan_should_assign_common(normalized),
    };
    if semantic_vector_append(vec, &entry as &const void) != 0 {
        return -1;
    }
    return 0;
}

fn c99_split_plan_lcp_len_from_scan(vec: &SemanticVector) i32 {
    if vec == null || vec.count == 0usize {
        return 0;
    }
    var first: &byte = null;
    var minlen: i32 = C99_SPLIT_PLAN_PATH_BUF_SIZE - 1;
    const scan_count: i32 = c99_plan_usize_to_i32(vec.count);
    var i: i32 = 0;
    while i < scan_count {
        const entry: &C99SplitSourceScanEntry = c99_split_source_scan_at(vec, i);
        if entry != null && entry.assign_common == 0 && entry.source_path != null {
            const len: i32 = c99_plan_strlen(entry.source_path);
            if first == null {
                first = entry.source_path;
            }
            if len < minlen {
                minlen = len;
            }
        }
        i = i + 1;
    }
    if first == null {
        return 0;
    }
    var pos: i32 = 0;
    while pos < minlen {
        const ch: byte = first[pos];
        var same: i32 = 1;
        i = 0;
        while i < scan_count {
            const entry2: &C99SplitSourceScanEntry = c99_split_source_scan_at(vec, i);
            if entry2 != null && entry2.assign_common == 0 && entry2.source_path != null {
                if entry2.source_path[pos] != ch {
                    same = 0;
                    i = scan_count;
                }
            }
            i = i + 1;
        }
        if same == 0 {
            break;
        }
        pos = pos + 1;
    }
    while pos > 0 && first[pos - 1] != 47 as byte {
        pos = pos - 1;
    }
    return pos;
}

fn c99_split_plan_copy_uya_rel_to_c(rel_uya: &byte, out_rel: &byte, max_out: i32) i32 {
    if rel_uya == null || out_rel == null || max_out < 5 {
        return -1;
    }
    var i: i32 = 0;
    while i < max_out - 1 && rel_uya[i] != 0 as byte {
        out_rel[i] = rel_uya[i];
        i = i + 1;
    }
    out_rel[i] = 0 as byte;
    if rel_uya[i] != 0 as byte {
        return -1;
    }
    if i >= 5 && out_rel[i - 4] == 46 as byte && out_rel[i - 3] == 117 as byte &&
       out_rel[i - 2] == 121 as byte && out_rel[i - 1] == 97 as byte {
        out_rel[i - 4] = 46 as byte;
        out_rel[i - 3] = 99 as byte;
        out_rel[i - 2] = 0 as byte;
        return 0;
    }
    return -1;
}

fn c99_split_plan_rel_c_from_key(plan: &C99Plan, src: &byte, lcp: i32) &byte {
    if src == null {
        return null;
    }
    var rel_uya: [byte: C99_SPLIT_PLAN_PATH_BUF_SIZE] = [];
    var ri: i32 = 0;
    while ri < C99_SPLIT_PLAN_PATH_BUF_SIZE - 1 && src[lcp + ri] != 0 as byte {
        rel_uya[ri] = src[lcp + ri];
        ri = ri + 1;
    }
    rel_uya[ri] = 0 as byte;
    if ri == 0 {
        var bn: i32 = 0;
        var bi: i32 = 0;
        while bi < C99_SPLIT_PLAN_PATH_BUF_SIZE - 1 && src[bi] != 0 as byte {
            bn = bi;
            bi = bi + 1;
        }
        while bn >= 0 && src[bn] != 47 as byte {
            bn = bn - 1;
        }
        var t: i32 = 0;
        while t < C99_SPLIT_PLAN_PATH_BUF_SIZE - 1 && src[bn + 1 + t] != 0 as byte {
            rel_uya[t] = src[bn + 1 + t];
            t = t + 1;
        }
        rel_uya[t] = 0 as byte;
    }
    var rel_c: [byte: C99_SPLIT_PLAN_PATH_BUF_SIZE] = [];
    if c99_split_plan_copy_uya_rel_to_c(&rel_uya[0] as &byte, &rel_c[0] as &byte, C99_SPLIT_PLAN_PATH_BUF_SIZE) != 0 {
        return null;
    }
    return c99_plan_strdup(plan, &rel_c[0] as &byte);
}

fn c99_split_plan_object_from_c_path(plan: &C99Plan, c_path: &byte) &byte {
    if c_path == null {
        return null;
    }
    var obj: [byte: C99_SPLIT_PLAN_PATH_BUF_SIZE] = [];
    var i: i32 = 0;
    while i < C99_SPLIT_PLAN_PATH_BUF_SIZE - 1 && c_path[i] != 0 as byte {
        obj[i] = c_path[i];
        i = i + 1;
    }
    if c_path[i] != 0 as byte {
        return null;
    }
    obj[i] = 0 as byte;
    if i >= 2 && obj[i - 2] == 46 as byte && obj[i - 1] == 99 as byte {
        obj[i - 1] = 111 as byte;
        return c99_plan_strdup(plan, &obj[0] as &byte);
    }
    return null;
}

fn c99_plan_empty_vector() SemanticVector {
    return SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
}

fn c99_plan_empty() C99Plan {
    return C99Plan{
        arena: null,
        unit_count: 0usize,
        decl_count: 0,
        estimated_bytes: 0usize,
        resident_peak_bytes: 0usize,
        lifecycle_state: C99_PLAN_LIFECYCLE_UNINITIALIZED,
        split_enabled: 0,
        split_mirror: 0,
        split_lcp: 0,
        split_part1_unit_id: -1,
        split_part2_unit_id: -1,
        split_common_unit_id: -1,
        split_source_count: 0usize,
        includes: c99_plan_empty_vector(),
        typedefs: c99_plan_empty_vector(),
        prototypes: c99_plan_empty_vector(),
        globals: c99_plan_empty_vector(),
        functions: c99_plan_empty_vector(),
        helpers: c99_plan_empty_vector(),
        deps: c99_plan_empty_vector(),
        decls: c99_plan_empty_vector(),
        units: c99_plan_empty_vector(),
        split_sources: c99_plan_empty_vector(),
    };
}

fn c99_prelude_plan_empty() C99PreludePlan {
    return C99PreludePlan{
        has_mem_functions: 0,
        has_string_functions: 0,
        has_stdlib_conflicts: 0,
        has_own_opendir: 0,
        has_own_readdir: 0,
        has_own_closedir: 0,
        include_stddef_h: 0,
        include_stdio_base_h: 0,
        include_math_h: 0,
        include_string_h: 0,
        include_stdlib_h: 0,
        include_stdio_requested_h: 0,
        emit_malloc_decl: 0,
        emit_free_decl: 0,
        emit_realloc_decl: 0,
        emit_calloc_decl: 0,
        emit_clock_decl: 0,
        emit_abort_decl: 0,
        emit_read_decl: 0,
        emit_write_decl: 0,
        emit_opendir_decl: 0,
        emit_readdir_decl: 0,
        emit_closedir_decl: 0,
        emit_exit_decl: 0,
    };
}

struct C99PreludeDeclScan {
    has_decl_mem_function: i32,
    has_decl_string_function: i32,
    has_decl_malloc: i32,
    has_decl_free: i32,
    has_decl_realloc: i32,
    has_decl_calloc: i32,
    has_decl_clock: i32,
    has_decl_read: i32,
    has_decl_write: i32,
    has_impl_malloc: i32,
    has_impl_free: i32,
    has_impl_realloc: i32,
    has_impl_calloc: i32,
    has_impl_clock: i32,
    has_impl_read: i32,
    has_impl_write: i32,
}

fn c99_prelude_decl_scan_empty() C99PreludeDeclScan {
    return C99PreludeDeclScan{
        has_decl_mem_function: 0,
        has_decl_string_function: 0,
        has_decl_malloc: 0,
        has_decl_free: 0,
        has_decl_realloc: 0,
        has_decl_calloc: 0,
        has_decl_clock: 0,
        has_decl_read: 0,
        has_decl_write: 0,
        has_impl_malloc: 0,
        has_impl_free: 0,
        has_impl_realloc: 0,
        has_impl_calloc: 0,
        has_impl_clock: 0,
        has_impl_read: 0,
        has_impl_write: 0,
    };
}

fn c99_prelude_plan_scan_decl(plan: &C99PreludePlan,
                              decl: &ASTNode,
                              scan: &C99PreludeDeclScan) void {
    if plan == null || scan == null || decl == null || decl.type != ASTNodeType.AST_FN_DECL || decl.fn_decl_name == null {
        return;
    }
    const name: &byte = decl.fn_decl_name;
    const has_body: i32 = (decl.fn_decl_body != null) as i32;
    if strcmp(name as *byte, "memcpy" as *byte) == 0 || strcmp(name as *byte, "memset" as *byte) == 0 ||
       strcmp(name as *byte, "memmove" as *byte) == 0 || strcmp(name as *byte, "memcmp" as *byte) == 0 ||
       strcmp(name as *byte, "memchr" as *byte) == 0 {
        scan.has_decl_mem_function = 1;
        if has_body != 0 {
            plan.has_mem_functions = 1;
        }
    } else if strcmp(name as *byte, "strlen" as *byte) == 0 || strcmp(name as *byte, "strcmp" as *byte) == 0 ||
       strcmp(name as *byte, "strncmp" as *byte) == 0 || strcmp(name as *byte, "strcpy" as *byte) == 0 ||
       strcmp(name as *byte, "strncpy" as *byte) == 0 || strcmp(name as *byte, "strcat" as *byte) == 0 ||
       strcmp(name as *byte, "strchr" as *byte) == 0 || strcmp(name as *byte, "strrchr" as *byte) == 0 ||
       strcmp(name as *byte, "strstr" as *byte) == 0 {
        scan.has_decl_string_function = 1;
        if has_body != 0 {
            plan.has_string_functions = 1;
        }
    }
    if has_body != 0 {
        if strcmp(name as *byte, "labs" as *byte) == 0 ||
           strcmp(name as *byte, "strtoul" as *byte) == 0 ||
           strcmp(name as *byte, "qsort" as *byte) == 0 ||
           strcmp(name as *byte, "bsearch" as *byte) == 0 {
            plan.has_stdlib_conflicts = 1;
        }
        if strcmp(name as *byte, "opendir" as *byte) == 0 {
            plan.has_own_opendir = 1;
        } else if strcmp(name as *byte, "readdir" as *byte) == 0 {
            plan.has_own_readdir = 1;
        } else if strcmp(name as *byte, "closedir" as *byte) == 0 {
            plan.has_own_closedir = 1;
        }
    }
    if strcmp(name as *byte, "malloc" as *byte) == 0 {
        scan.has_decl_malloc = 1;
        if has_body != 0 { scan.has_impl_malloc = 1; }
    } else if strcmp(name as *byte, "free" as *byte) == 0 {
        scan.has_decl_free = 1;
        if has_body != 0 { scan.has_impl_free = 1; }
    } else if strcmp(name as *byte, "realloc" as *byte) == 0 {
        scan.has_decl_realloc = 1;
        if has_body != 0 { scan.has_impl_realloc = 1; }
    } else if strcmp(name as *byte, "calloc" as *byte) == 0 {
        scan.has_decl_calloc = 1;
        if has_body != 0 { scan.has_impl_calloc = 1; }
    } else if strcmp(name as *byte, "clock" as *byte) == 0 {
        scan.has_decl_clock = 1;
        if has_body != 0 { scan.has_impl_clock = 1; }
    } else if strcmp(name as *byte, "read" as *byte) == 0 {
        scan.has_decl_read = 1;
        if has_body != 0 { scan.has_impl_read = 1; }
    } else if strcmp(name as *byte, "write" as *byte) == 0 {
        scan.has_decl_write = 1;
        if has_body != 0 { scan.has_impl_write = 1; }
    }
}

/// 功能说明：构建 C99 include/header/prelude 决策计划。
/// 参数说明：`input` 汇总顶层声明、C99 codegen 配置与目标环境。
/// 返回值说明：返回头部/前导计划；emitter 后续只按计划发射文本。
export fn c99_prelude_plan_build(input: C99PreludePlanInput) C99PreludePlan {
    var plan: C99PreludePlan = c99_prelude_plan_empty();
    var scan: C99PreludeDeclScan = c99_prelude_decl_scan_empty();
    if input.decl_plan != null {
        var pi: i32 = 0;
        while pi < input.decl_plan.decl_count {
            c99_prelude_plan_scan_decl(&plan, c99_plan_decl_at(input.decl_plan, pi), &scan);
            pi = pi + 1;
        }
    } else if input.ast != null && input.ast.type == ASTNodeType.AST_PROGRAM {
        var i: i32 = 0;
        while i < input.decl_count {
            c99_prelude_plan_scan_decl(&plan, input.ast.program_decls[i], &scan);
            i = i + 1;
        }
    }
    if input.freestanding != 0 {
        return plan;
    }
    plan.include_stddef_h = 1;
    if input.has_stdio_conflicts == 0 && input.is_bootstrap == 0 {
        plan.include_stdio_base_h = 1;
    }
    if input.is_bootstrap == 0 {
        plan.include_math_h = 1;
    }
    if (input.needs_string_h != 0 || scan.has_decl_string_function != 0 || scan.has_decl_mem_function != 0) &&
       plan.has_string_functions == 0 && plan.has_mem_functions == 0 && input.is_bootstrap == 0 {
        plan.include_string_h = 1;
    }
    if input.needs_stdlib_h != 0 && plan.has_stdlib_conflicts == 0 && input.is_bootstrap == 0 {
        plan.include_stdlib_h = 1;
    }
    if plan.include_stdlib_h == 0 && input.is_bootstrap == 0 {
        plan.emit_abort_decl = 1;
    }
    if input.needs_stdio_h != 0 && input.has_stdio_conflicts == 0 && input.is_bootstrap == 0 {
        plan.include_stdio_requested_h = 1;
    }
    if input.is_bootstrap == 0 {
        if scan.has_decl_malloc != 0 && scan.has_impl_malloc == 0 { plan.emit_malloc_decl = 1; }
        if scan.has_decl_free != 0 && scan.has_impl_free == 0 { plan.emit_free_decl = 1; }
        if scan.has_decl_realloc != 0 && scan.has_impl_realloc == 0 { plan.emit_realloc_decl = 1; }
        if scan.has_decl_calloc != 0 && scan.has_impl_calloc == 0 { plan.emit_calloc_decl = 1; }
        if scan.has_decl_clock != 0 && scan.has_impl_clock == 0 { plan.emit_clock_decl = 1; }
    }
    if input.target_os_is_macos != 0 && input.is_bootstrap != 0 {
        if scan.has_impl_read == 0 { plan.emit_read_decl = 1; }
        if scan.has_impl_write == 0 { plan.emit_write_decl = 1; }
    } else {
        if scan.has_decl_read != 0 && (scan.has_impl_read == 0 || input.target_os_is_macos != 0) {
            if input.is_bootstrap == 0 || input.target_os_is_macos != 0 {
                plan.emit_read_decl = 1;
            }
        }
        if scan.has_decl_write != 0 && (scan.has_impl_write == 0 || input.target_os_is_macos != 0) {
            if input.is_bootstrap == 0 || input.target_os_is_macos != 0 {
                plan.emit_write_decl = 1;
            }
        }
    }
    if plan.has_own_opendir == 0 && input.is_bootstrap == 0 { plan.emit_opendir_decl = 1; }
    if plan.has_own_readdir == 0 && input.is_bootstrap == 0 { plan.emit_readdir_decl = 1; }
    if plan.has_own_closedir == 0 && input.is_bootstrap == 0 { plan.emit_closedir_decl = 1; }
    if input.is_bootstrap == 0 { plan.emit_exit_decl = 1; }
    return plan;
}

fn c99_helper_plan_empty() C99HelperPlan {
    return C99HelperPlan{
        emit_error_name_helper: 0,
        emit_microapp_mmu_helpers: 0,
        emit_simd_runtime_helpers: 0,
        emit_syscall_helpers: 0,
        emit_microapp_syscall_helpers: 0,
        emit_async_frame_descriptors: 0,
        async_frame_descriptor_count: 0,
        async_frame_runtime_used: 0,
    };
}

fn c99_helper_plan_program_uses_async_frame_runtime(ast: &ASTNode, decl_count: i32) i32 {
    if ast == null || ast.type != ASTNodeType.AST_PROGRAM {
        return 0;
    }
    var i: i32 = 0;
    while i < decl_count {
        const decl: &ASTNode = ast.program_decls[i];
        if decl != null && decl.filename != null {
            if strstr(decl.filename as *byte, "std/async_frame.uya" as *byte) != null {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn c99_helper_plan_decl_plan_uses_async_frame_runtime(plan: &C99Plan) i32 {
    if plan == null {
        return 0;
    }
    var i: i32 = 0;
    while i < plan.decl_count {
        const decl: &ASTNode = c99_plan_decl_at(plan, i);
        if decl != null && decl.filename != null {
            if strstr(decl.filename as *byte, "std/async_frame.uya" as *byte) != null {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 功能说明：构建 C99 helper emission 需求计划。
/// 参数说明：`input` 汇总 AST、codegen 配置和已收敛待输出表计数。
/// 返回值说明：返回 helper 计划；emitter 后续只按计划发射 helper 文本。
export fn c99_helper_plan_build(input: C99HelperPlanInput) C99HelperPlan {
    var plan: C99HelperPlan = c99_helper_plan_empty();
    plan.emit_error_name_helper = 1;
    if input.container_mode != 0 && input.microapp_softvm_mode != 0 {
        plan.emit_microapp_mmu_helpers = 1;
    }
    if input.simd_struct_count > 0 {
        plan.emit_simd_runtime_helpers = 1;
    }
    if input.needs_syscall_helpers != 0 {
        plan.emit_syscall_helpers = 1;
        if input.container_mode != 0 {
            plan.emit_microapp_syscall_helpers = 1;
        }
    }
    plan.emit_async_frame_descriptors = 1;
    plan.async_frame_descriptor_count = input.async_frame_meta_count;
    if plan.async_frame_descriptor_count < 0 {
        plan.async_frame_descriptor_count = 0;
    }
    if input.decl_plan != null {
        plan.async_frame_runtime_used = c99_helper_plan_decl_plan_uses_async_frame_runtime(input.decl_plan);
    } else {
        plan.async_frame_runtime_used = c99_helper_plan_program_uses_async_frame_runtime(input.ast, input.decl_count);
    }
    return plan;
}

fn c99_prototype_plan_empty_entry() C99PrototypePlanEntry {
    return C99PrototypePlanEntry{
        kind: 0,
        decl: null,
        owner_name: null,
        owner_decl: null,
        owner_type_args: null,
        owner_type_arg_count: 0,
        type_args: null,
        type_arg_count: 0,
    };
}

/// 功能说明：构造未初始化的空 C99PrototypePlan 值。
/// 参数说明：无。
/// 返回值说明：返回 entries 为空、count 为 0 的 plan；调用方随后应执行 `c99_prototype_plan_init`。
export fn c99_prototype_plan_empty() C99PrototypePlan {
    return C99PrototypePlan{
        entries: c99_plan_empty_vector(),
        count: 0,
    };
}

/// 功能说明：初始化 C99PrototypePlan 动态事件表。
/// 参数说明：`plan` 为目标 prototype plan。
/// 返回值说明：无；失败状态由后续 append 返回值表达。
export fn c99_prototype_plan_init(plan: &C99PrototypePlan) void {
    if plan == null {
        return;
    }
    semantic_vector_init(&plan.entries, @size_of(C99PrototypePlanEntry));
    plan.count = 0;
}

/// 功能说明：释放 C99PrototypePlan 动态事件表。
/// 参数说明：`plan` 为目标 prototype plan。
/// 返回值说明：无；释放后 count 归零。
export fn c99_prototype_plan_release(plan: &C99PrototypePlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.entries);
    plan.count = 0;
}

/// 功能说明：按下标读取 prototype plan entry。
/// 参数说明：`plan` 为目标 prototype plan，`index` 为事件下标。
/// 返回值说明：命中返回 entry 指针，越界或未初始化返回 null。
export fn c99_prototype_plan_entry_at(plan: &C99PrototypePlan, index: i32) &C99PrototypePlanEntry {
    if plan == null || index < 0 {
        return null;
    }
    return semantic_vector_item_ptr(&plan.entries, c99_plan_i32_to_usize(index)) as &C99PrototypePlanEntry;
}

fn c99_prototype_plan_append(plan: &C99PrototypePlan,
                             kind: i32,
                             decl: &ASTNode,
                             owner_name: &byte,
                             owner_decl: &ASTNode,
                             owner_type_args: & & ASTNode,
                             owner_type_arg_count: i32,
                             type_args: & & ASTNode,
                             type_arg_count: i32) i32 {
    if plan == null || decl == null {
        return -1;
    }
    var entry: C99PrototypePlanEntry = c99_prototype_plan_empty_entry();
    entry.kind = kind;
    entry.decl = decl;
    entry.owner_name = owner_name;
    entry.owner_decl = owner_decl;
    entry.owner_type_args = owner_type_args;
    entry.owner_type_arg_count = owner_type_arg_count;
    entry.type_args = type_args;
    entry.type_arg_count = type_arg_count;
    if semantic_vector_append(&plan.entries, &entry as &const void) != 0 {
        return -1;
    }
    plan.count = c99_plan_usize_to_i32(plan.entries.count);
    return 0;
}

fn c99_prototype_plan_is_reachable(codegen: &C99CodeGenerator, fn_decl: &ASTNode) i32 {
    if codegen == null || fn_decl == null {
        return 0;
    }
    var i: i32 = 0;
    while i < codegen.reachable_function_decl_count && i < @len(codegen.reachable_function_decls) {
        const reachable_decl: &ASTNode = codegen.reachable_function_decls[i];
        if reachable_decl == fn_decl {
            return 1;
        }
        if reachable_decl != null && reachable_decl.type == ASTNodeType.AST_FN_DECL && fn_decl.type == ASTNodeType.AST_FN_DECL &&
           reachable_decl.fn_decl_name != null && fn_decl.fn_decl_name != null {
            if strcmp(reachable_decl.fn_decl_name as *byte, fn_decl.fn_decl_name as *byte) == 0 &&
               reachable_decl.fn_decl_is_extern == fn_decl.fn_decl_is_extern {
                var reachable_has_body: i32 = 0;
                var fn_has_body: i32 = 0;
                if reachable_decl.fn_decl_body != null { reachable_has_body = 1; }
                if fn_decl.fn_decl_body != null { fn_has_body = 1; }
                if reachable_has_body == fn_has_body {
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn c99_prototype_plan_should_emit_top_level_function(codegen: &C99CodeGenerator, fn_decl: &ASTNode) i32 {
    if codegen == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    if fn_decl.fn_decl_body == null {
        return 1;
    }
    return c99_prototype_plan_is_reachable(codegen, fn_decl);
}

fn c99_prototype_plan_mono_fn_name_matches_decl(codegen: &C99CodeGenerator, inst_name: &byte, fn_decl: &ASTNode) i32 {
    if codegen == null || inst_name == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL || fn_decl.fn_decl_name == null {
        return 0;
    }
    if strcmp(inst_name as *byte, fn_decl.fn_decl_name as *byte) == 0 {
        return 1;
    }
    if fn_decl.fn_decl_is_export != 0 && fn_decl.fn_decl_extern_lib_name == null && fn_decl.filename != null {
        const exported_name: &byte = get_export_function_c_name(codegen, fn_decl.fn_decl_name, fn_decl.filename);
        if exported_name != null && strcmp(inst_name as *byte, exported_name as *byte) == 0 {
            return 1;
        }
    }
    return 0;
}

fn c99_prototype_plan_append_top_level_fn(plan: &C99PrototypePlan,
                                          codegen: &C99CodeGenerator,
                                          decl: &ASTNode) i32 {
    if c99_prototype_plan_should_emit_top_level_function(codegen, decl) == 0 {
        return 0;
    }
    if is_generic_function_c99(decl) == 0 {
        return c99_prototype_plan_append(plan, C99_PROTOTYPE_KIND_FUNCTION, decl,
            null, null, null, 0, null, 0);
    }
    var j: i32 = 0;
    while j < codegen.mono_instance_count && j < @len(codegen.mono_instances) {
        if codegen.mono_instances[j].generic_name != null &&
           c99_prototype_plan_mono_fn_name_matches_decl(codegen, codegen.mono_instances[j].generic_name, decl) != 0 &&
           codegen.mono_instances[j].is_function != 0 &&
           codegen.reachable_mono_instances[j] != 0 &&
           has_unresolved_mono_type_args(decl, codegen.mono_instances[j].type_args, codegen.mono_instances[j].type_arg_count) == 0 {
            if c99_prototype_plan_append(plan, C99_PROTOTYPE_KIND_MONO_FUNCTION, decl,
                null, null, null, 0,
                codegen.mono_instances[j].type_args,
                codegen.mono_instances[j].type_arg_count) != 0 {
                return -1;
            }
        }
        j = j + 1;
    }
    return 0;
}

fn c99_prototype_plan_append_method(plan: &C99PrototypePlan,
                                    m: &ASTNode,
                                    owner_name: &byte,
                                    owner_decl: &ASTNode,
                                    owner_type_args: & & ASTNode,
                                    owner_type_arg_count: i32) i32 {
    return c99_prototype_plan_append(plan, C99_PROTOTYPE_KIND_METHOD, m,
        owner_name, owner_decl, owner_type_args, owner_type_arg_count, null, 0);
}

fn c99_prototype_plan_append_mono_method(plan: &C99PrototypePlan,
                                         m: &ASTNode,
                                         owner_name: &byte,
                                         owner_decl: &ASTNode,
                                         owner_type_args: & & ASTNode,
                                         owner_type_arg_count: i32,
                                         type_args: & & ASTNode,
                                         type_arg_count: i32) i32 {
    return c99_prototype_plan_append(plan, C99_PROTOTYPE_KIND_MONO_METHOD, m,
        owner_name, owner_decl, owner_type_args, owner_type_arg_count,
        type_args, type_arg_count);
}

fn c99_prototype_plan_append_generic_method_instances(plan: &C99PrototypePlan,
                                                      codegen: &C99CodeGenerator,
                                                      m: &ASTNode,
                                                      owner_name: &byte,
                                                      owner_decl: &ASTNode,
                                                      owner_type_args: & & ASTNode,
                                                      owner_type_arg_count: i32) i32 {
    if codegen == null || m == null || owner_name == null || m.fn_decl_name == null {
        return 0;
    }
    var expected_prefix: [byte: C99_PROTOTYPE_NAME_BUF_SIZE] = [];
    const prefix_len: i32 = snprintf(&expected_prefix[0] as *byte, C99_PROTOTYPE_NAME_BUF_SIZE,
        "%s_%s_" as *byte, owner_name as *byte, m.fn_decl_name as *byte);
    if prefix_len <= 0 {
        return 0;
    }
    var k: i32 = 0;
    while k < codegen.mono_instance_count && k < @len(codegen.mono_instances) {
        if codegen.mono_instances[k].generic_name != null && codegen.mono_instances[k].is_function != 0 {
            const gn: &byte = codegen.mono_instances[k].generic_name;
            if gn != null && strncmp(gn as *byte, &expected_prefix[0] as *byte, prefix_len) == 0 {
                if c99_prototype_plan_append_mono_method(plan, m, owner_name,
                    owner_decl, owner_type_args, owner_type_arg_count,
                    codegen.mono_instances[k].type_args,
                    codegen.mono_instances[k].type_arg_count) != 0 {
                    return -1;
                }
            }
        }
        k = k + 1;
    }
    return 0;
}

fn c99_prototype_plan_append_owner_methods(plan: &C99PrototypePlan,
                                           codegen: &C99CodeGenerator,
                                           methods: & & ASTNode,
                                           method_count: i32,
                                           owner_name: &byte,
                                           owner_decl: &ASTNode,
                                           owner_type_args: & & ASTNode,
                                           owner_type_arg_count: i32) i32 {
    if methods == null || owner_name == null {
        return 0;
    }
    var j: i32 = 0;
    while j < method_count {
        const m: &ASTNode = methods[j];
        if m != null && m.type == ASTNodeType.AST_FN_DECL {
            if m.fn_decl_type_param_count > 0 {
                if c99_prototype_plan_append_generic_method_instances(plan, codegen, m,
                    owner_name, owner_decl, owner_type_args, owner_type_arg_count) != 0 {
                    return -1;
                }
            } else if c99_prototype_plan_append_method(plan, m,
                owner_name, owner_decl, owner_type_args, owner_type_arg_count) != 0 {
                return -1;
            }
        }
        j = j + 1;
    }
    return 0;
}

fn c99_prototype_plan_append_struct_decl(plan: &C99PrototypePlan,
                                         codegen: &C99CodeGenerator,
                                         decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_STRUCT_DECL || decl.struct_decl_name == null {
        return 0;
    }
    const struct_name: &byte = decl.struct_decl_name;
    if is_generic_struct_c99(decl) == 0 {
        return c99_prototype_plan_append_owner_methods(plan, codegen,
            decl.struct_decl_methods, decl.struct_decl_method_count,
            struct_name, null, null, 0);
    }
    var k: i32 = 0;
    while k < codegen.mono_instance_count && k < @len(codegen.mono_instances) {
        if codegen.mono_instances[k].generic_name != null &&
           strcmp(codegen.mono_instances[k].generic_name as *byte, struct_name as *byte) == 0 &&
           codegen.mono_instances[k].is_function == 0 &&
           has_unresolved_mono_type_args(decl, codegen.mono_instances[k].type_args, codegen.mono_instances[k].type_arg_count) == 0 {
            const mono_name: &byte = get_mono_struct_name(codegen, struct_name,
                codegen.mono_instances[k].type_args,
                codegen.mono_instances[k].type_arg_count);
            if c99_prototype_plan_append_owner_methods(plan, codegen,
                decl.struct_decl_methods, decl.struct_decl_method_count,
                mono_name, decl, codegen.mono_instances[k].type_args,
                codegen.mono_instances[k].type_arg_count) != 0 {
                return -1;
            }
        }
        k = k + 1;
    }
    return 0;
}

fn c99_prototype_plan_append_method_block(plan: &C99PrototypePlan,
                                          codegen: &C99CodeGenerator,
                                          decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_METHOD_BLOCK {
        return 0;
    }
    var type_name: &byte = decl.method_block_struct_name;
    if type_name == null {
        type_name = decl.method_block_union_name;
    }
    return c99_prototype_plan_append_owner_methods(plan, codegen,
        decl.method_block_methods, decl.method_block_method_count,
        type_name, null, null, 0);
}

fn c99_prototype_plan_append_union_decl(plan: &C99PrototypePlan, decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_UNION_DECL || decl.union_decl_name == null {
        return 0;
    }
    var j: i32 = 0;
    while j < decl.union_decl_method_count {
        const m: &ASTNode = decl.union_decl_methods[j];
        if m != null && m.type == ASTNodeType.AST_FN_DECL {
            if c99_prototype_plan_append_method(plan, m, decl.union_decl_name, null, null, 0) != 0 {
                return -1;
            }
        }
        j = j + 1;
    }
    return 0;
}

/// 功能说明：根据 AST、可达函数与单态实例构建 function prototype 事件计划。
/// 参数说明：`plan` 为输出计划，`codegen` 提供可达性与 mono 实例，`ast` 为程序 AST。
/// 返回值说明：成功返回 `0`，追加事件失败返回 `-1`。
export fn c99_prototype_plan_build(plan: &C99PrototypePlan,
                                   codegen: &C99CodeGenerator,
                                   ast: &ASTNode,
                                   decl_count: i32) i32 {
    if plan == null || codegen == null || ast == null || ast.type != ASTNodeType.AST_PROGRAM {
        return -1;
    }
    semantic_vector_reset(&plan.entries);
    plan.count = 0;
    var i: i32 = 0;
    while i < decl_count {
        const decl: &ASTNode = ast.program_decls[i];
        if decl != null {
            if decl.type == ASTNodeType.AST_FN_DECL {
                if c99_prototype_plan_append_top_level_fn(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
                if c99_prototype_plan_append_method_block(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
                if c99_prototype_plan_append_struct_decl(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_UNION_DECL {
                if c99_prototype_plan_append_union_decl(plan, decl) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    plan.count = c99_plan_usize_to_i32(plan.entries.count);
    return 0;
}

/// 功能说明：从 C99Plan 的顶层声明事件表构建 function prototype 事件计划。
/// 参数说明：`plan` 为输出计划，`codegen` 提供可达性与 mono 实例，`decl_plan` 提供稳定声明顺序。
/// 返回值说明：成功返回 `0`，追加事件失败返回 `-1`。
export fn c99_prototype_plan_build_from_c99_plan(plan: &C99PrototypePlan,
                                                 codegen: &C99CodeGenerator,
                                                 decl_plan: &C99Plan) i32 {
    if plan == null || codegen == null || decl_plan == null {
        return -1;
    }
    semantic_vector_reset(&plan.entries);
    plan.count = 0;
    var i: i32 = 0;
    while i < decl_plan.decl_count {
        const decl: &ASTNode = c99_plan_decl_at(decl_plan, i);
        if decl != null {
            if decl.type == ASTNodeType.AST_FN_DECL {
                if c99_prototype_plan_append_top_level_fn(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_METHOD_BLOCK {
                if c99_prototype_plan_append_method_block(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
                if c99_prototype_plan_append_struct_decl(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_UNION_DECL {
                if c99_prototype_plan_append_union_decl(plan, decl) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    plan.count = c99_plan_usize_to_i32(plan.entries.count);
    return 0;
}

fn c99_type_definition_plan_empty_entry() C99TypeDefinitionPlanEntry {
    return C99TypeDefinitionPlanEntry{
        kind: 0,
        decl: null,
        type_args: null,
        type_arg_count: 0,
    };
}

/// 功能说明：构造未初始化的空 C99TypeDefinitionPlan 值。
/// 参数说明：无。
/// 返回值说明：返回三段事件表均为空的 plan；调用方随后应执行 `c99_type_definition_plan_init`。
export fn c99_type_definition_plan_empty() C99TypeDefinitionPlan {
    return C99TypeDefinitionPlan{
        registrations: c99_plan_empty_vector(),
        early_definitions: c99_plan_empty_vector(),
        layout_definitions: c99_plan_empty_vector(),
        registration_count: 0,
        early_definition_count: 0,
        layout_definition_count: 0,
    };
}

/// 功能说明：初始化 C99TypeDefinitionPlan 动态事件表。
/// 参数说明：`plan` 为目标 type definition plan。
/// 返回值说明：无；失败状态由后续 append 返回值表达。
export fn c99_type_definition_plan_init(plan: &C99TypeDefinitionPlan) void {
    if plan == null {
        return;
    }
    semantic_vector_init(&plan.registrations, @size_of(C99TypeDefinitionPlanEntry));
    semantic_vector_init(&plan.early_definitions, @size_of(C99TypeDefinitionPlanEntry));
    semantic_vector_init(&plan.layout_definitions, @size_of(C99TypeDefinitionPlanEntry));
    plan.registration_count = 0;
    plan.early_definition_count = 0;
    plan.layout_definition_count = 0;
}

/// 功能说明：释放 C99TypeDefinitionPlan 动态事件表。
/// 参数说明：`plan` 为目标 type definition plan。
/// 返回值说明：无；释放后三段 count 归零。
export fn c99_type_definition_plan_release(plan: &C99TypeDefinitionPlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.registrations);
    semantic_vector_release(&plan.early_definitions);
    semantic_vector_release(&plan.layout_definitions);
    plan.registration_count = 0;
    plan.early_definition_count = 0;
    plan.layout_definition_count = 0;
}

fn c99_type_definition_plan_entry_from(vec: &SemanticVector, index: i32) &C99TypeDefinitionPlanEntry {
    if vec == null || index < 0 {
        return null;
    }
    return semantic_vector_item_ptr(vec, c99_plan_i32_to_usize(index)) as &C99TypeDefinitionPlanEntry;
}

/// 功能说明：按下标读取 type registration 事件。
/// 参数说明：`plan` 为目标 plan，`index` 为 registration 下标。
/// 返回值说明：命中返回 entry 指针，越界或未初始化返回 null。
export fn c99_type_definition_plan_registration_at(plan: &C99TypeDefinitionPlan, index: i32) &C99TypeDefinitionPlanEntry {
    if plan == null {
        return null;
    }
    return c99_type_definition_plan_entry_from(&plan.registrations, index);
}

/// 功能说明：按下标读取 early type definition 事件。
/// 参数说明：`plan` 为目标 plan，`index` 为 early definition 下标。
/// 返回值说明：命中返回 entry 指针，越界或未初始化返回 null。
export fn c99_type_definition_plan_early_at(plan: &C99TypeDefinitionPlan, index: i32) &C99TypeDefinitionPlanEntry {
    if plan == null {
        return null;
    }
    return c99_type_definition_plan_entry_from(&plan.early_definitions, index);
}

/// 功能说明：按下标读取 layout type definition 事件。
/// 参数说明：`plan` 为目标 plan，`index` 为 layout definition 下标。
/// 返回值说明：命中返回 entry 指针，越界或未初始化返回 null。
export fn c99_type_definition_plan_layout_at(plan: &C99TypeDefinitionPlan, index: i32) &C99TypeDefinitionPlanEntry {
    if plan == null {
        return null;
    }
    return c99_type_definition_plan_entry_from(&plan.layout_definitions, index);
}

fn c99_type_definition_plan_append_to(plan: &C99TypeDefinitionPlan,
                                      vec: &SemanticVector,
                                      kind: i32,
                                      decl: &ASTNode,
                                      type_args: & & ASTNode,
                                      type_arg_count: i32) i32 {
    if plan == null || vec == null {
        return -1;
    }
    var entry: C99TypeDefinitionPlanEntry = c99_type_definition_plan_empty_entry();
    entry.kind = kind;
    entry.decl = decl;
    entry.type_args = type_args;
    entry.type_arg_count = type_arg_count;
    if semantic_vector_append(vec, &entry as &const void) != 0 {
        return -1;
    }
    return 0;
}

fn c99_type_definition_plan_append_registration(plan: &C99TypeDefinitionPlan,
                                                kind: i32,
                                                decl: &ASTNode,
                                                type_args: & & ASTNode,
                                                type_arg_count: i32) i32 {
    if c99_type_definition_plan_append_to(plan, &plan.registrations, kind, decl, type_args, type_arg_count) != 0 {
        return -1;
    }
    plan.registration_count = c99_plan_usize_to_i32(plan.registrations.count);
    return 0;
}

fn c99_type_definition_plan_append_early(plan: &C99TypeDefinitionPlan,
                                         kind: i32,
                                         decl: &ASTNode) i32 {
    if c99_type_definition_plan_append_to(plan, &plan.early_definitions, kind, decl, null, 0) != 0 {
        return -1;
    }
    plan.early_definition_count = c99_plan_usize_to_i32(plan.early_definitions.count);
    return 0;
}

fn c99_type_definition_plan_append_layout(plan: &C99TypeDefinitionPlan,
                                          kind: i32,
                                          decl: &ASTNode,
                                          type_args: & & ASTNode,
                                          type_arg_count: i32) i32 {
    if c99_type_definition_plan_append_to(plan, &plan.layout_definitions, kind, decl, type_args, type_arg_count) != 0 {
        return -1;
    }
    plan.layout_definition_count = c99_plan_usize_to_i32(plan.layout_definitions.count);
    return 0;
}

fn c99_type_definition_plan_append_struct_registrations(plan: &C99TypeDefinitionPlan,
                                                        codegen: &C99CodeGenerator,
                                                        decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_STRUCT_DECL || decl.struct_decl_name == null {
        return 0;
    }
    if is_generic_struct_c99(decl) == 0 {
        return c99_type_definition_plan_append_registration(plan, C99_TYPEDEF_KIND_REGISTER_STRUCT, decl, null, 0);
    }
    var j: i32 = 0;
    while j < codegen.mono_instance_count && j < @len(codegen.mono_instances) {
        if codegen.mono_instances[j].generic_name != null &&
           strcmp(codegen.mono_instances[j].generic_name as *byte, decl.struct_decl_name as *byte) == 0 &&
           codegen.mono_instances[j].is_function == 0 &&
           has_unresolved_mono_type_args(decl,
               codegen.mono_instances[j].type_args,
               codegen.mono_instances[j].type_arg_count) == 0 {
            if c99_type_definition_plan_append_registration(plan,
                C99_TYPEDEF_KIND_REGISTER_MONO_STRUCT,
                decl,
                codegen.mono_instances[j].type_args,
                codegen.mono_instances[j].type_arg_count) != 0 {
                return -1;
            }
        }
        j = j + 1;
    }
    return 0;
}

fn c99_type_definition_plan_append_union_layouts(plan: &C99TypeDefinitionPlan,
                                                 codegen: &C99CodeGenerator,
                                                 decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_UNION_DECL || decl.union_decl_name == null {
        return 0;
    }
    if is_generic_union_c99(decl) == 0 {
        return c99_type_definition_plan_append_layout(plan, C99_TYPEDEF_KIND_UNION, decl, null, 0);
    }
    var j: i32 = 0;
    while j < codegen.mono_instance_count && j < @len(codegen.mono_instances) {
        if codegen.mono_instances[j].generic_name != null &&
           strcmp(codegen.mono_instances[j].generic_name as *byte, decl.union_decl_name as *byte) == 0 &&
           codegen.mono_instances[j].is_function == 0 &&
           has_unresolved_mono_type_args(decl,
               codegen.mono_instances[j].type_args,
               codegen.mono_instances[j].type_arg_count) == 0 {
            if c99_type_definition_plan_append_layout(plan,
                C99_TYPEDEF_KIND_MONO_UNION,
                decl,
                codegen.mono_instances[j].type_args,
                codegen.mono_instances[j].type_arg_count) != 0 {
                return -1;
            }
        }
        j = j + 1;
    }
    return 0;
}

fn c99_type_definition_plan_append_struct_layouts(plan: &C99TypeDefinitionPlan,
                                                  codegen: &C99CodeGenerator,
                                                  decl: &ASTNode) i32 {
    if decl == null || decl.type != ASTNodeType.AST_STRUCT_DECL || decl.struct_decl_name == null {
        return 0;
    }
    if is_generic_struct_c99(decl) == 0 {
        return c99_type_definition_plan_append_layout(plan, C99_TYPEDEF_KIND_STRUCT, decl, null, 0);
    }
    var j: i32 = 0;
    while j < codegen.mono_instance_count && j < @len(codegen.mono_instances) {
        if codegen.mono_instances[j].generic_name != null &&
           strcmp(codegen.mono_instances[j].generic_name as *byte, decl.struct_decl_name as *byte) == 0 &&
           codegen.mono_instances[j].is_function == 0 &&
           has_unresolved_mono_type_args(decl,
               codegen.mono_instances[j].type_args,
               codegen.mono_instances[j].type_arg_count) == 0 {
            if c99_type_definition_plan_append_layout(plan,
                C99_TYPEDEF_KIND_MONO_STRUCT,
                decl,
                codegen.mono_instances[j].type_args,
                codegen.mono_instances[j].type_arg_count) != 0 {
                return -1;
            }
        }
        j = j + 1;
    }
    return 0;
}

fn c99_type_definition_plan_has_user_typeinfo(ast: &ASTNode, decl_count: i32) i32 {
    if ast == null || ast.type != ASTNodeType.AST_PROGRAM {
        return 0;
    }
    var i: i32 = 0;
    while i < decl_count {
        const decl: &ASTNode = ast.program_decls[i];
        if decl != null && decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_name != null &&
           strcmp(decl.struct_decl_name as *byte, "TypeInfo" as *byte) == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn c99_type_definition_plan_has_user_typeinfo_in_c99_plan(plan: &C99Plan) i32 {
    if plan == null {
        return 0;
    }
    var i: i32 = 0;
    while i < plan.decl_count {
        const decl: &ASTNode = c99_plan_decl_at(plan, i);
        if decl != null && decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_name != null &&
           strcmp(decl.struct_decl_name as *byte, "TypeInfo" as *byte) == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 功能说明：根据 AST 与单态实例构建 C99 类型定义事件计划。
/// 参数说明：`plan` 为输出计划，`codegen` 提供 mono 实例，`ast` 为程序 AST。
/// 返回值说明：成功返回 `0`，追加事件失败返回 `-1`。
export fn c99_type_definition_plan_build(plan: &C99TypeDefinitionPlan,
                                         codegen: &C99CodeGenerator,
                                         ast: &ASTNode,
                                         decl_count: i32) i32 {
    if plan == null || codegen == null || ast == null || ast.type != ASTNodeType.AST_PROGRAM {
        return -1;
    }
    semantic_vector_reset(&plan.registrations);
    semantic_vector_reset(&plan.early_definitions);
    semantic_vector_reset(&plan.layout_definitions);
    plan.registration_count = 0;
    plan.early_definition_count = 0;
    plan.layout_definition_count = 0;
    var i: i32 = 0;
    while i < decl_count {
        const decl: &ASTNode = ast.program_decls[i];
        if decl != null {
            if decl.type == ASTNodeType.AST_STRUCT_DECL {
                if c99_type_definition_plan_append_struct_registrations(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_ENUM_DECL {
                if c99_type_definition_plan_append_registration(plan, C99_TYPEDEF_KIND_REGISTER_ENUM, decl, null, 0) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < decl_count {
        const decl2: &ASTNode = ast.program_decls[i];
        if decl2 != null {
            if decl2.type == ASTNodeType.AST_ENUM_DECL {
                if c99_type_definition_plan_append_early(plan, C99_TYPEDEF_KIND_ENUM, decl2) != 0 {
                    return -1;
                }
            } else if decl2.type == ASTNodeType.AST_TYPE_ALIAS &&
                decl2.type_alias_name != null && decl2.type_alias_target_type != null {
                if c99_type_definition_plan_append_early(plan, C99_TYPEDEF_KIND_ALIAS, decl2) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < decl_count {
        const decl3: &ASTNode = ast.program_decls[i];
        if decl3 != null && decl3.type == ASTNodeType.AST_UNION_DECL {
            if c99_type_definition_plan_append_union_layouts(plan, codegen, decl3) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    if c99_type_definition_plan_has_user_typeinfo(ast, decl_count) == 0 {
        if c99_type_definition_plan_append_layout(plan, C99_TYPEDEF_KIND_BUILTIN_TYPEINFO, null, null, 0) != 0 {
            return -1;
        }
    }
    i = 0;
    while i < decl_count {
        const decl4: &ASTNode = ast.program_decls[i];
        if decl4 != null && decl4.type == ASTNodeType.AST_STRUCT_DECL {
            if c99_type_definition_plan_append_struct_layouts(plan, codegen, decl4) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    plan.registration_count = c99_plan_usize_to_i32(plan.registrations.count);
    plan.early_definition_count = c99_plan_usize_to_i32(plan.early_definitions.count);
    plan.layout_definition_count = c99_plan_usize_to_i32(plan.layout_definitions.count);
    return 0;
}

/// 功能说明：从 C99Plan 的顶层声明事件表构建 C99 类型定义事件计划。
/// 参数说明：`plan` 为输出计划，`codegen` 提供 mono 实例，`decl_plan` 提供稳定声明顺序。
/// 返回值说明：成功返回 `0`，追加事件失败返回 `-1`。
export fn c99_type_definition_plan_build_from_c99_plan(plan: &C99TypeDefinitionPlan,
                                                       codegen: &C99CodeGenerator,
                                                       decl_plan: &C99Plan) i32 {
    if plan == null || codegen == null || decl_plan == null {
        return -1;
    }
    semantic_vector_reset(&plan.registrations);
    semantic_vector_reset(&plan.early_definitions);
    semantic_vector_reset(&plan.layout_definitions);
    plan.registration_count = 0;
    plan.early_definition_count = 0;
    plan.layout_definition_count = 0;
    var i: i32 = 0;
    while i < decl_plan.decl_count {
        const decl: &ASTNode = c99_plan_decl_at(decl_plan, i);
        if decl != null {
            if decl.type == ASTNodeType.AST_STRUCT_DECL {
                if c99_type_definition_plan_append_struct_registrations(plan, codegen, decl) != 0 {
                    return -1;
                }
            } else if decl.type == ASTNodeType.AST_ENUM_DECL {
                if c99_type_definition_plan_append_registration(plan, C99_TYPEDEF_KIND_REGISTER_ENUM, decl, null, 0) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < decl_plan.decl_count {
        const decl2: &ASTNode = c99_plan_decl_at(decl_plan, i);
        if decl2 != null {
            if decl2.type == ASTNodeType.AST_ENUM_DECL {
                if c99_type_definition_plan_append_early(plan, C99_TYPEDEF_KIND_ENUM, decl2) != 0 {
                    return -1;
                }
            } else if decl2.type == ASTNodeType.AST_TYPE_ALIAS &&
                decl2.type_alias_name != null && decl2.type_alias_target_type != null {
                if c99_type_definition_plan_append_early(plan, C99_TYPEDEF_KIND_ALIAS, decl2) != 0 {
                    return -1;
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < decl_plan.decl_count {
        const decl3: &ASTNode = c99_plan_decl_at(decl_plan, i);
        if decl3 != null && decl3.type == ASTNodeType.AST_UNION_DECL {
            if c99_type_definition_plan_append_union_layouts(plan, codegen, decl3) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    if c99_type_definition_plan_has_user_typeinfo_in_c99_plan(decl_plan) == 0 {
        if c99_type_definition_plan_append_layout(plan, C99_TYPEDEF_KIND_BUILTIN_TYPEINFO, null, null, 0) != 0 {
            return -1;
        }
    }
    i = 0;
    while i < decl_plan.decl_count {
        const decl4: &ASTNode = c99_plan_decl_at(decl_plan, i);
        if decl4 != null && decl4.type == ASTNodeType.AST_STRUCT_DECL {
            if c99_type_definition_plan_append_struct_layouts(plan, codegen, decl4) != 0 {
                return -1;
            }
        }
        i = i + 1;
    }
    plan.registration_count = c99_plan_usize_to_i32(plan.registrations.count);
    plan.early_definition_count = c99_plan_usize_to_i32(plan.early_definitions.count);
    plan.layout_definition_count = c99_plan_usize_to_i32(plan.layout_definitions.count);
    return 0;
}

fn c99_unit_plan_init_vectors(unit: &C99UnitPlan) void {
    if unit == null {
        return;
    }
    semantic_vector_init(&unit.includes, @size_of(i32));
    semantic_vector_init(&unit.typedefs, @size_of(i32));
    semantic_vector_init(&unit.prototypes, @size_of(i32));
    semantic_vector_init(&unit.globals, @size_of(i32));
    semantic_vector_init(&unit.functions, @size_of(i32));
    semantic_vector_init(&unit.helpers, @size_of(i32));
    semantic_vector_init(&unit.deps, @size_of(i32));
}

fn c99_unit_plan_release_vectors(unit: &C99UnitPlan) void {
    if unit == null {
        return;
    }
    semantic_vector_release(&unit.includes);
    semantic_vector_release(&unit.typedefs);
    semantic_vector_release(&unit.prototypes);
    semantic_vector_release(&unit.globals);
    semantic_vector_release(&unit.functions);
    semantic_vector_release(&unit.helpers);
    semantic_vector_release(&unit.deps);
}

fn c99_unit_plan_storage_bytes(unit: &C99UnitPlan) usize {
    if unit == null {
        return 0usize;
    }
    return unit.includes.bytes +
        unit.typedefs.bytes +
        unit.prototypes.bytes +
        unit.globals.bytes +
        unit.functions.bytes +
        unit.helpers.bytes +
        unit.deps.bytes;
}

fn c99_plan_stats_add(stats: &C99PlanStats, table: &SemanticVector) void {
    if stats == null || table == null {
        return;
    }
    stats.table_count = stats.table_count + 1;
    stats.table_items = stats.table_items + table.count;
    stats.table_capacity = stats.table_capacity + table.capacity;
    stats.table_bytes = stats.table_bytes + table.bytes;
    stats.table_realloc_count = stats.table_realloc_count + table.realloc_count;
}

/// 功能说明：估算 C99Plan 当前结构与所有动态表（含每个 unit）占用字节数。
/// 参数说明：`plan` 为目标 C99Plan。
/// 返回值说明：返回结构体本体与所有动态表容量字节数；参数无效时返回 `0`。
export fn c99_plan_storage_bytes(plan: &C99Plan) usize {
    if plan == null {
        return 0usize;
    }
    var total: usize = @size_of(C99Plan) +
        plan.includes.bytes +
        plan.typedefs.bytes +
        plan.prototypes.bytes +
        plan.globals.bytes +
        plan.functions.bytes +
        plan.helpers.bytes +
        plan.deps.bytes +
        plan.decls.bytes +
        plan.units.bytes +
        plan.split_sources.bytes;
    var i: usize = 0usize;
    while i < plan.units.count {
        const unit: &C99UnitPlan = semantic_vector_item_ptr(&plan.units, i) as &C99UnitPlan;
        total = total + c99_unit_plan_storage_bytes(unit);
        i = i + 1usize;
    }
    return total;
}

fn c99_plan_refresh_bytes(plan: &C99Plan) void {
    if plan == null {
        return;
    }
    const current_bytes: usize = c99_plan_storage_bytes(plan);
    plan.estimated_bytes = current_bytes;
    if current_bytes > plan.resident_peak_bytes {
        plan.resident_peak_bytes = current_bytes;
    }
}

fn c99_plan_release_unit_vectors(plan: &C99Plan) void {
    if plan == null {
        return;
    }
    var i: usize = 0usize;
    while i < plan.units.count {
        const unit: &C99UnitPlan = semantic_vector_item_ptr(&plan.units, i) as &C99UnitPlan;
        c99_unit_plan_release_vectors(unit);
        i = i + 1usize;
    }
}

/// 功能说明：初始化 C99Plan 的 program 级动态表与 split-C unit 列表。
/// 参数说明：`plan` 为目标 C99Plan，`arena` 为 planner 阶段专用 arena。
/// 返回值说明：无。
export fn c99_plan_init(plan: &C99Plan, arena: &CompilerArena) void {
    if plan == null {
        return;
    }
    plan.arena = arena;
    plan.unit_count = 0usize;
    plan.decl_count = 0;
    plan.estimated_bytes = 0usize;
    plan.resident_peak_bytes = 0usize;
    plan.lifecycle_state = C99_PLAN_LIFECYCLE_ACTIVE;
    plan.split_enabled = 0;
    plan.split_mirror = 0;
    plan.split_lcp = 0;
    plan.split_part1_unit_id = -1;
    plan.split_part2_unit_id = -1;
    plan.split_common_unit_id = -1;
    plan.split_source_count = 0usize;
    semantic_vector_init(&plan.includes, @size_of(i32));
    semantic_vector_init(&plan.typedefs, @size_of(i32));
    semantic_vector_init(&plan.prototypes, @size_of(i32));
    semantic_vector_init(&plan.globals, @size_of(i32));
    semantic_vector_init(&plan.functions, @size_of(i32));
    semantic_vector_init(&plan.helpers, @size_of(i32));
    semantic_vector_init(&plan.deps, @size_of(i32));
    semantic_vector_init(&plan.decls, @size_of(C99DeclPlanEntry));
    semantic_vector_init(&plan.units, @size_of(C99UnitPlan));
    semantic_vector_init(&plan.split_sources, @size_of(C99SplitSourceAssignment));
    c99_plan_refresh_bytes(plan);
}

/// 功能说明：重置 C99Plan 内容并保留 program 级表已分配容量。
/// 参数说明：`plan` 为目标 C99Plan。
/// 返回值说明：无。每个 unit 的子表会被释放。
export fn c99_plan_reset(plan: &C99Plan) void {
    if plan == null {
        return;
    }
    c99_plan_release_unit_vectors(plan);
    semantic_vector_reset(&plan.includes);
    semantic_vector_reset(&plan.typedefs);
    semantic_vector_reset(&plan.prototypes);
    semantic_vector_reset(&plan.globals);
    semantic_vector_reset(&plan.functions);
    semantic_vector_reset(&plan.helpers);
    semantic_vector_reset(&plan.deps);
    semantic_vector_reset(&plan.decls);
    semantic_vector_reset(&plan.units);
    semantic_vector_reset(&plan.split_sources);
    plan.unit_count = 0usize;
    plan.decl_count = 0;
    plan.split_enabled = 0;
    plan.split_mirror = 0;
    plan.split_lcp = 0;
    plan.split_part1_unit_id = -1;
    plan.split_part2_unit_id = -1;
    plan.split_common_unit_id = -1;
    plan.split_source_count = 0usize;
    plan.lifecycle_state = C99_PLAN_LIFECYCLE_ACTIVE;
    c99_plan_refresh_bytes(plan);
}

/// 功能说明：释放 C99Plan 所有动态表（含每个 unit 的子表）。
/// 参数说明：`plan` 为目标 C99Plan。
/// 返回值说明：无。
export fn c99_plan_release(plan: &C99Plan) void {
    if plan == null {
        return;
    }
    c99_plan_release_unit_vectors(plan);
    semantic_vector_release(&plan.includes);
    semantic_vector_release(&plan.typedefs);
    semantic_vector_release(&plan.prototypes);
    semantic_vector_release(&plan.globals);
    semantic_vector_release(&plan.functions);
    semantic_vector_release(&plan.helpers);
    semantic_vector_release(&plan.deps);
    semantic_vector_release(&plan.decls);
    semantic_vector_release(&plan.units);
    semantic_vector_release(&plan.split_sources);
    plan.unit_count = 0usize;
    plan.decl_count = 0;
    plan.split_enabled = 0;
    plan.split_mirror = 0;
    plan.split_lcp = 0;
    plan.split_part1_unit_id = -1;
    plan.split_part2_unit_id = -1;
    plan.split_common_unit_id = -1;
    plan.split_source_count = 0usize;
    plan.estimated_bytes = 0usize;
    plan.arena = null;
    plan.lifecycle_state = C99_PLAN_LIFECYCLE_RELEASED;
}

/// 功能说明：向 C99Plan 追加一个顶层声明事件。
/// 参数说明：`plan` 为目标 plan，`decl` 为 AST 顶层声明节点。
/// 返回值说明：成功返回 `0`，参数无效或动态表追加失败返回 `-1`。
export fn c99_plan_add_decl(plan: &C99Plan, decl: &ASTNode) i32 {
    if plan == null {
        return -1;
    }
    var entry: C99DeclPlanEntry = C99DeclPlanEntry{
        decl: decl,
    };
    if semantic_vector_append(&plan.decls, &entry as &const void) != 0 {
        return -1;
    }
    plan.decl_count = c99_plan_usize_to_i32(plan.decls.count);
    c99_plan_refresh_bytes(plan);
    return 0;
}

/// 功能说明：按 planner 顺序读取顶层声明事件。
/// 参数说明：`plan` 为目标 plan，`index` 为声明事件下标。
/// 返回值说明：命中返回 AST 声明节点；越界或未初始化返回 `null`。
export fn c99_plan_decl_at(plan: &C99Plan, index: i32) &ASTNode {
    if plan == null || index < 0 {
        return null;
    }
    if c99_plan_i32_to_usize(index) >= plan.decls.count {
        return null;
    }
    const entry: &C99DeclPlanEntry = semantic_vector_item_ptr(&plan.decls, c99_plan_i32_to_usize(index)) as &C99DeclPlanEntry;
    if entry == null {
        return null;
    }
    return entry.decl;
}

/// 功能说明：从程序 AST 构建顶层声明事件表。
/// 参数说明：`plan` 为目标 plan，`ast` 为程序 AST。
/// 返回值说明：成功返回 `0`，输入无效或动态表追加失败返回 `-1`。
export fn c99_plan_build_decls(plan: &C99Plan, ast: &ASTNode) i32 {
    if plan == null || ast == null || ast.type != ASTNodeType.AST_PROGRAM {
        return -1;
    }
    semantic_vector_reset(&plan.decls);
    plan.decl_count = 0;
    var i: i32 = 0;
    while i < ast.program_decl_count {
        const decl: &ASTNode = ast.program_decls[i];
        if c99_plan_add_decl(plan, decl) != 0 {
            return -1;
        }
        i = i + 1;
    }
    plan.decl_count = c99_plan_usize_to_i32(plan.decls.count);
    c99_plan_refresh_bytes(plan);
    return 0;
}

/// 功能说明：追加一个 split-C unit 计划。
/// 参数说明：`plan` 为目标 C99Plan，`name_id` 为 unit 名称的 intern ID。
/// 返回值说明：成功返回新 unit 的下标（unit_id），失败返回 `-1`。
export fn c99_plan_add_unit(plan: &C99Plan, name_id: InternedNameId) i32 {
    if plan == null {
        return -1;
    }
    const idx: i32 = c99_plan_usize_to_i32(plan.units.count);
    var unit: C99UnitPlan = C99UnitPlan{
        unit_id: idx,
        name_id: name_id,
        kind: C99_SPLIT_UNIT_KIND_GENERIC,
        source_path: null,
        c_path: null,
        object_path: null,
        includes: c99_plan_empty_vector(),
        typedefs: c99_plan_empty_vector(),
        prototypes: c99_plan_empty_vector(),
        globals: c99_plan_empty_vector(),
        functions: c99_plan_empty_vector(),
        helpers: c99_plan_empty_vector(),
        deps: c99_plan_empty_vector(),
    };
    if semantic_vector_append(&plan.units, &unit as &const void) != 0 {
        return -1;
    }
    const stored: &C99UnitPlan = semantic_vector_item_ptr(&plan.units, c99_plan_i32_to_usize(idx)) as &C99UnitPlan;
    if stored == null {
        return -1;
    }
    c99_unit_plan_init_vectors(stored);
    plan.unit_count = plan.units.count;
    c99_plan_refresh_bytes(plan);
    return idx;
}

/// 功能说明：追加一个带 split-C 文件分配信息的 unit 计划。
/// 参数说明：`kind` 为 C99_SPLIT_UNIT_KIND_*；路径参数可为 null。
/// 返回值说明：成功返回新 unit 下标，失败返回 `-1`。
export fn c99_plan_add_split_unit(plan: &C99Plan, kind: i32, source_path: &byte, c_path: &byte, object_path: &byte) i32 {
    const unit_id: i32 = c99_plan_add_unit(plan, -1);
    if unit_id < 0 {
        return -1;
    }
    const unit: &C99UnitPlan = c99_plan_unit_ptr(plan, unit_id);
    if unit == null {
        return -1;
    }
    unit.kind = kind;
    unit.source_path = source_path;
    unit.c_path = c_path;
    unit.object_path = object_path;
    return unit_id;
}

/// 功能说明：按下标获取 unit 计划指针。
/// 参数说明：`plan` 为目标 C99Plan，`unit_id` 为 unit 下标。
/// 返回值说明：命中返回指针，越界或无效返回 null。
export fn c99_plan_unit_ptr(plan: &C99Plan, unit_id: i32) &C99UnitPlan {
    if plan == null || unit_id < 0 {
        return null;
    }
    return semantic_vector_item_ptr(&plan.units, c99_plan_i32_to_usize(unit_id)) as &C99UnitPlan;
}

/// 功能说明：读取 C99Plan 当前 unit 数量。
export fn c99_plan_unit_count(plan: &C99Plan) usize {
    if plan == null {
        return 0usize;
    }
    return plan.units.count;
}

fn c99_plan_append_split_source_assignment(plan: &C99Plan, source_path: &byte, unit_id: i32) i32 {
    if plan == null || source_path == null || unit_id < 0 {
        return -1;
    }
    var entry: C99SplitSourceAssignment = C99SplitSourceAssignment{
        source_path: source_path,
        unit_id: unit_id,
    };
    if semantic_vector_append(&plan.split_sources, &entry as &const void) != 0 {
        return -1;
    }
    plan.split_source_count = plan.split_sources.count;
    c99_plan_refresh_bytes(plan);
    return 0;
}

/// 功能说明：按下标读取 split 源文件分配记录。
/// 参数说明：`plan` 为目标计划，`idx` 为分配记录下标。
/// 返回值说明：命中返回记录指针，越界返回 null。
export fn c99_plan_split_source_assignment_at(plan: &C99Plan, idx: i32) &C99SplitSourceAssignment {
    if plan == null || idx < 0 {
        return null;
    }
    return semantic_vector_item_ptr(&plan.split_sources, c99_plan_i32_to_usize(idx)) as &C99SplitSourceAssignment;
}

/// 功能说明：按规范化源路径查找其分配到的 split-C unit。
/// 参数说明：`normalized_source_path` 必须已经过 split planner 同样的路径规范化。
/// 返回值说明：命中返回 unit；未分配或参数无效返回 null。
export fn c99_plan_split_unit_for_source(plan: &C99Plan, normalized_source_path: &byte) &C99UnitPlan {
    if plan == null || normalized_source_path == null {
        return null;
    }
    const assignment_count: i32 = c99_plan_usize_to_i32(plan.split_sources.count);
    var i: i32 = 0;
    while i < assignment_count {
        const assignment: &C99SplitSourceAssignment = c99_plan_split_source_assignment_at(plan, i);
        if assignment != null && assignment.source_path != null &&
            strcmp(assignment.source_path as *byte, normalized_source_path as *byte) == 0 {
            return c99_plan_unit_ptr(plan, assignment.unit_id);
        }
        i = i + 1;
    }
    return null;
}

/// 功能说明：构建 split-C unit 分配计划。
/// 参数说明：`plan` 为已初始化 C99Plan；`input` 提供 AST 与 split 配置。
/// 返回值说明：成功返回 `0`，路径归一化或动态表追加失败返回 `-1`。
export fn c99_split_unit_plan_build(plan: &C99Plan, input: C99SplitUnitPlanInput) i32 {
    if plan == null {
        return -1;
    }
    plan.split_enabled = input.split_enabled;
    plan.split_mirror = input.split_mirror;
    plan.split_lcp = 0;
    plan.split_part1_unit_id = -1;
    plan.split_part2_unit_id = -1;
    plan.split_common_unit_id = -1;
    plan.split_source_count = 0usize;
    semantic_vector_reset(&plan.split_sources);
    if input.split_enabled == 0 {
        c99_plan_refresh_bytes(plan);
        return 0;
    }

    const part1_c: &byte = c99_plan_strdup(plan, "uya_part1.c" as &byte);
    const part1_o: &byte = c99_plan_strdup(plan, "uya_part1.o" as &byte);
    plan.split_part1_unit_id = c99_plan_add_split_unit(plan, C99_SPLIT_UNIT_KIND_PART1, null, part1_c, part1_o);
    if plan.split_part1_unit_id < 0 {
        return -1;
    }

    if input.split_mirror == 0 {
        const part2_c: &byte = c99_plan_strdup(plan, "uya_part2.c" as &byte);
        const part2_o: &byte = c99_plan_strdup(plan, "uya_part2.o" as &byte);
        plan.split_part2_unit_id = c99_plan_add_split_unit(plan, C99_SPLIT_UNIT_KIND_PART2, null, part2_c, part2_o);
        if plan.split_part2_unit_id < 0 {
            return -1;
        }
        if input.ast != null && input.ast.type == ASTNodeType.AST_PROGRAM {
            var part2_scan: SemanticVector = c99_plan_empty_vector();
            semantic_vector_init(&part2_scan, @size_of(C99SplitSourceScanEntry));
            var pi: i32 = 0;
            while pi < input.decl_count {
                const decl2: &ASTNode = input.ast.program_decls[pi];
                if decl2 != null && decl2.filename != null {
                    if c99_split_source_scan_append_unique(plan, &part2_scan, decl2.filename) != 0 {
                        semantic_vector_release(&part2_scan);
                        return -1;
                    }
                }
                pi = pi + 1;
            }
            pi = 0;
            const part2_count: i32 = c99_plan_usize_to_i32(part2_scan.count);
            while pi < part2_count {
                const part2_entry: &C99SplitSourceScanEntry = c99_split_source_scan_at(&part2_scan, pi);
                if part2_entry != null && part2_entry.source_path != null {
                    if c99_plan_append_split_source_assignment(plan, part2_entry.source_path, plan.split_part2_unit_id) != 0 {
                        semantic_vector_release(&part2_scan);
                        return -1;
                    }
                }
                pi = pi + 1;
            }
            semantic_vector_release(&part2_scan);
        }
        c99_plan_refresh_bytes(plan);
        return 0;
    }

    const common_c: &byte = c99_plan_strdup(plan, "uya_common.c" as &byte);
    const common_o: &byte = c99_plan_strdup(plan, "uya_common.o" as &byte);
    plan.split_common_unit_id = c99_plan_add_split_unit(plan, C99_SPLIT_UNIT_KIND_COMMON, null, common_c, common_o);
    if plan.split_common_unit_id < 0 {
        return -1;
    }

    var scan: SemanticVector = c99_plan_empty_vector();
    semantic_vector_init(&scan, @size_of(C99SplitSourceScanEntry));
    if input.ast != null && input.ast.type == ASTNodeType.AST_PROGRAM {
        var i: i32 = 0;
        while i < input.decl_count {
            const decl: &ASTNode = input.ast.program_decls[i];
            if decl != null && decl.filename != null {
                if c99_split_source_scan_append_unique(plan, &scan, decl.filename) != 0 {
                    semantic_vector_release(&scan);
                    return -1;
                }
            }
            i = i + 1;
        }
    }
    plan.split_lcp = c99_split_plan_lcp_len_from_scan(&scan);

    const split_scan_count: i32 = c99_plan_usize_to_i32(scan.count);
    var si: i32 = 0;
    while si < split_scan_count {
        const entry: &C99SplitSourceScanEntry = c99_split_source_scan_at(&scan, si);
        if entry != null && entry.source_path != null {
            var target_unit_id: i32 = plan.split_common_unit_id;
            if entry.assign_common == 0 {
                const rel_c: &byte = c99_split_plan_rel_c_from_key(plan, entry.source_path, plan.split_lcp);
                const rel_o: &byte = c99_split_plan_object_from_c_path(plan, rel_c);
                if rel_c == null || rel_o == null {
                    semantic_vector_release(&scan);
                    return -1;
                }
                target_unit_id = c99_plan_add_split_unit(plan, C99_SPLIT_UNIT_KIND_MIRROR_SOURCE,
                    entry.source_path, rel_c, rel_o);
                if target_unit_id < 0 {
                    semantic_vector_release(&scan);
                    return -1;
                }
            }
            if c99_plan_append_split_source_assignment(plan, entry.source_path, target_unit_id) != 0 {
                semantic_vector_release(&scan);
                return -1;
            }
        }
        si = si + 1;
    }
    semantic_vector_release(&scan);
    c99_plan_refresh_bytes(plan);
    return 0;
}

fn c99_plan_append_i32(plan: &C99Plan, vec: &SemanticVector, value: i32) i32 {
    if plan == null || vec == null {
        return -1;
    }
    var v: i32 = value;
    if semantic_vector_append(vec, &v as &const void) != 0 {
        return -1;
    }
    c99_plan_refresh_bytes(plan);
    return 0;
}

/// 功能说明：向 program 级各表追加一项稳定 ID。
/// 返回值说明：成功返回 `0`，失败返回 `-1`。
export fn c99_plan_add_include(plan: &C99Plan, id: i32) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.includes, id);
}
export fn c99_plan_add_typedef(plan: &C99Plan, id: i32) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.typedefs, id);
}
export fn c99_plan_add_prototype(plan: &C99Plan, id: FunctionId) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.prototypes, id);
}
export fn c99_plan_add_global(plan: &C99Plan, id: i32) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.globals, id);
}
export fn c99_plan_add_function(plan: &C99Plan, id: FunctionId) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.functions, id);
}
export fn c99_plan_add_helper(plan: &C99Plan, id: i32) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.helpers, id);
}
export fn c99_plan_add_dep(plan: &C99Plan, id: i32) i32 {
    if plan == null { return -1; }
    return c99_plan_append_i32(plan, &plan.deps, id);
}

fn c99_plan_unit_append_i32(plan: &C99Plan, unit_id: i32, selector: i32, value: i32) i32 {
    const unit: &C99UnitPlan = c99_plan_unit_ptr(plan, unit_id);
    if unit == null {
        return -1;
    }
    var vec: &SemanticVector = null;
    if selector == 0 { vec = &unit.includes; }
    else if selector == 1 { vec = &unit.typedefs; }
    else if selector == 2 { vec = &unit.prototypes; }
    else if selector == 3 { vec = &unit.globals; }
    else if selector == 4 { vec = &unit.functions; }
    else if selector == 5 { vec = &unit.helpers; }
    else if selector == 6 { vec = &unit.deps; }
    if vec == null {
        return -1;
    }
    var v: i32 = value;
    if semantic_vector_append(vec, &v as &const void) != 0 {
        return -1;
    }
    c99_plan_refresh_bytes(plan);
    return 0;
}

/// 功能说明：向指定 unit 的各表追加一项稳定 ID。
/// 返回值说明：成功返回 `0`，unit 越界或追加失败返回 `-1`。
export fn c99_plan_unit_add_include(plan: &C99Plan, unit_id: i32, id: i32) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 0, id);
}
export fn c99_plan_unit_add_typedef(plan: &C99Plan, unit_id: i32, id: i32) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 1, id);
}
export fn c99_plan_unit_add_prototype(plan: &C99Plan, unit_id: i32, id: FunctionId) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 2, id);
}
export fn c99_plan_unit_add_global(plan: &C99Plan, unit_id: i32, id: i32) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 3, id);
}
export fn c99_plan_unit_add_function(plan: &C99Plan, unit_id: i32, id: FunctionId) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 4, id);
}
export fn c99_plan_unit_add_helper(plan: &C99Plan, unit_id: i32, id: i32) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 5, id);
}
export fn c99_plan_unit_add_dep(plan: &C99Plan, unit_id: i32, dep_unit_id: i32) i32 {
    return c99_plan_unit_append_i32(plan, unit_id, 6, dep_unit_id);
}

/// 功能说明：读取 C99Plan 当前估算字节数。
export fn c99_plan_estimated_bytes(plan: &C99Plan) usize {
    if plan == null {
        return 0usize;
    }
    return plan.estimated_bytes;
}

/// 功能说明：读取 C99Plan 生命周期窗口内峰值字节数。
export fn c99_plan_peak_bytes(plan: &C99Plan) usize {
    if plan == null {
        return 0usize;
    }
    return plan.resident_peak_bytes;
}

/// 功能说明：读取 C99Plan 当前生命周期状态。
export fn c99_plan_lifecycle_state(plan: &C99Plan) i32 {
    if plan == null {
        return C99_PLAN_LIFECYCLE_UNINITIALIZED;
    }
    return plan.lifecycle_state;
}

/// 功能说明：聚合 C99Plan 所有动态表（program 级 + units 列表 + 每个 unit 子表）统计。
/// 参数说明：`plan` 为目标 C99Plan。
/// 返回值说明：返回 table 数量、项数、容量、字节数与重分配次数摘要。
export fn c99_plan_stats(plan: &C99Plan) C99PlanStats {
    var stats: C99PlanStats = C99PlanStats{
        table_count: 0,
        table_items: 0usize,
        table_capacity: 0usize,
        table_bytes: 0usize,
        table_realloc_count: 0,
    };
    if plan == null {
        return stats;
    }
    c99_plan_stats_add(&stats, &plan.includes);
    c99_plan_stats_add(&stats, &plan.typedefs);
    c99_plan_stats_add(&stats, &plan.prototypes);
    c99_plan_stats_add(&stats, &plan.globals);
    c99_plan_stats_add(&stats, &plan.functions);
    c99_plan_stats_add(&stats, &plan.helpers);
    c99_plan_stats_add(&stats, &plan.deps);
    c99_plan_stats_add(&stats, &plan.decls);
    c99_plan_stats_add(&stats, &plan.units);
    c99_plan_stats_add(&stats, &plan.split_sources);
    var i: usize = 0usize;
    while i < plan.units.count {
        const unit: &C99UnitPlan = semantic_vector_item_ptr(&plan.units, i) as &C99UnitPlan;
        if unit != null {
            c99_plan_stats_add(&stats, &unit.includes);
            c99_plan_stats_add(&stats, &unit.typedefs);
            c99_plan_stats_add(&stats, &unit.prototypes);
            c99_plan_stats_add(&stats, &unit.globals);
            c99_plan_stats_add(&stats, &unit.functions);
            c99_plan_stats_add(&stats, &unit.helpers);
            c99_plan_stats_add(&stats, &unit.deps);
        }
        i = i + 1usize;
    }
    return stats;
}
