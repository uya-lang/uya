            fputs("// 系统调用辅助函数：Linux/Darwin x86-64；Linux/Darwin AArch64；Linux ARM32 EABI\n" as *byte, codegen.emit_stream as *void);
            fputs("#if (defined(__x86_64__) || defined(_M_X64)) && defined(__linux__)\n" as *byte, codegen.emit_stream as *void);
    
    // uya_syscall0 - 无参数
    fputs("static inline long uya_syscall0(long nr) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    long ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("    __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(nr) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n\n" as *byte, codegen.emit_stream as *void);
    
    // uya_syscall1 - 1 个参数
    fputs("static inline long uya_syscall1(long nr, long a1) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    long ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("    __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(nr), \"D\"(a1) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n\n" as *byte, codegen.emit_stream as *void);
    
    // uya_syscall2 - 2 个参数
    fputs("static inline long uya_syscall2(long nr, long a1, long a2) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    long ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("    __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(nr), \"D\"(a1), \"S\"(a2) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n\n" as *byte, codegen.emit_stream as *void);
    
    // uya_syscall3 - 3 个参数
    fputs("static inline long uya_syscall3(long nr, long a1, long a2, long a3) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    long ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("    __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(nr), \"D\"(a1), \"S\"(a2), \"d\"(a3) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n\n" as *byte, codegen.emit_stream as *void);
    
    // uya_syscall4 - 4 个参数
    fputs("static inline long uya_syscall4(long nr, long a1, long a2, long a3, long a4) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    register long r10 __asm__(\"r10\") = a4;\n" as *byte, codegen.emit_stream as *void);
