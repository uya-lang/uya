    fputs("int32_t uya_macos_host_readdir_fill(void *dirp, void *out) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    unsigned char *src = (unsigned char *)0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    unsigned char *dst = (unsigned char *)0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    size_t clear_idx = 0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    size_t name_len = 0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (dirp == (void *)0 || out == (void *)0) return -1;\n" as *byte, codegen.emit_stream as *void);
    fputs("    static uya_macos_readdir_fn real_readdir = (uya_macos_readdir_fn)0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (real_readdir == (uya_macos_readdir_fn)0) real_readdir = (uya_macos_readdir_fn)dlsym((void *)-1, \"readdir\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (real_readdir == (uya_macos_readdir_fn)0) return -1;\n" as *byte, codegen.emit_stream as *void);
    fputs("    src = (unsigned char *)real_readdir(dirp);\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (src == (unsigned char *)0) return 0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    dst = (unsigned char *)out;\n" as *byte, codegen.emit_stream as *void);
    fputs("    while (clear_idx < 275u) {\n" as *byte, codegen.emit_stream as *void);
    fputs("        dst[clear_idx] = 0;\n" as *byte, codegen.emit_stream as *void);
    fputs("        clear_idx++;\n" as *byte, codegen.emit_stream as *void);
    fputs("    }\n" as *byte, codegen.emit_stream as *void);
    fputs("    dst[18] = src[20];\n" as *byte, codegen.emit_stream as *void);
    fputs("    while (name_len < 255u && src[21 + name_len] != 0) {\n" as *byte, codegen.emit_stream as *void);
    fputs("        dst[19 + name_len] = src[21 + name_len];\n" as *byte, codegen.emit_stream as *void);
    fputs("        name_len++;\n" as *byte, codegen.emit_stream as *void);
    fputs("    }\n" as *byte, codegen.emit_stream as *void);
    fputs("    dst[19 + name_len] = 0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    return 1;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int32_t uya_macos_host_closedir(void *dirp) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (dirp == (void *)0) return -1;\n" as *byte, codegen.emit_stream as *void);
    fputs("    static uya_macos_closedir_fn real_closedir = (uya_macos_closedir_fn)0;\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (real_closedir == (uya_macos_closedir_fn)0) real_closedir = (uya_macos_closedir_fn)dlsym((void *)-1, \"closedir\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    if (real_closedir == (uya_macos_closedir_fn)0) return -1;\n" as *byte, codegen.emit_stream as *void);
    fputs("    return real_closedir(dirp);\n" as *byte, codegen.emit_stream as *void);
