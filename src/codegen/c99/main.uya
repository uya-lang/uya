        if codegen.split_mirror != 0 && codegen.split_dir != null {
            var apath: [byte: 1024] = [];
            const al: i32 = snprintf(&apath[0] as *byte, 1024, "%s/uya_part1_types.h" as *byte, codegen.split_dir as *byte);
            if al > 0 && al < 1024 {
                const ah: *void = fopen(&apath[0] as *byte, "a" as *byte);
                if ah != null {
                    c99_output_buffer_note_open(codegen, ah as &void);
