    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    c99_emit_close_brace_newline(codegen);
    
        fputs("#elif (defined(__x86_64__) || defined(_M_X64)) && defined(__APPLE__)\n" as *byte, codegen.emit_stream as *void);
        fputs("static inline long uya_syscall0(long nr) {\n" as *byte, codegen.emit_stream as *void);
        fputs("    long ret;\n" as *byte, codegen.emit_stream as *void);
        fputs("    unsigned char uya_err;\n" as *byte, codegen.emit_stream as *void);
        fputs("    __asm__ volatile(\"syscall\\n\\tsetc %1\" : \"=a\"(ret), \"=qm\"(uya_err) : \"a\"(nr + 0x2000000L) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
        fputs("    return uya_err != 0 ? -ret : ret;\n}\n\n" as *byte, codegen.emit_stream as *void);
