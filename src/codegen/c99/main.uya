    fputs("#endif\n" as *byte, codegen.emit_stream as *void);
    c99_emit_newline(codegen);
    if prof_codegen != 0 {
        t_mk2 = clock();
        prof_ms_header = ((t_mk2 as i64) - (t_mk1 as i64)) * 1000 / (CLOCKS_PER_SEC as i64);
    }
    
    // 第一步：字符串池与 uya_common（镜像模式延后到第六步 d2 之后，使枚举/typedef/结构体等先写入 uya_part1_types.h）
    var i: i32 = 0;
    if codegen.split_mirror == 0 {
        emit_string_constants(codegen);
        emit_embed_constants(codegen);
        c99_split_begin_body(codegen);
        c99_emit_newline(codegen);
    }
    
    // 第三步：注册所有错误声明（用于 return error.X 等）
    i = 0;
    while i < decl_count {
        const decl: &ASTNode = c99_plan_decl_at(split_unit_plan, i);
        if decl != null && decl.type == ASTNodeType.AST_ERROR_DECL {
            if decl.error_decl_name != null {
                c99_get_or_add_error_id(codegen, decl.error_decl_name);
            }
        }
        i = i + 1;
    }
    
    // 第四步/第五步：按 type definition plan 注册类型并发射前向声明、枚举与 typedef
    c99_emit_type_definition_registrations(codegen, &type_definition_plan);
    c99_emit_type_forward_declarations(codegen);
    c99_emit_type_definition_early(codegen, &type_definition_plan);
    if prof_codegen != 0 {
        t_mk3 = clock();
        prof_ms_step1_typedef = ((t_mk3 as i64) - (t_mk2 as i64)) * 1000 / (CLOCKS_PER_SEC as i64);
    }
    
    // 第六步 a：切片/SIMD/err_union 类型已在统一预收集阶段完成
    // 第六步 b：生成切片结构体（&[T] -> struct uya_slice_X），必须在用户结构体之前
    emit_pending_slice_structs(codegen);
    if codegen.slice_struct_count > 0 {
        c99_emit_newline(codegen);
    }
    emit_pending_simd_structs(codegen);
    helper_plan = c99_build_helper_plan(codegen, split_unit_plan);
    if helper_plan.emit_simd_runtime_helpers != 0 {
        var t_simd0: clock_t = 0;
        if prof_codegen != 0 {
            t_simd0 = clock();
        }
        emit_simd_x86_sse_runtime_helpers(codegen);
        if prof_codegen != 0 {
            const t_simd1: clock_t = clock();
            prof_simd_ms = ((t_simd1 as i64) - (t_simd0 as i64)) * 1000 / (CLOCKS_PER_SEC as i64);
        }
        c99_emit_newline(codegen);
    }
    // 预注册 Future/Poll 单态实例：async_channel 最小构造用例下，若不提前注册，
    // split 模式会先声明 Channel_i32_send/recv 返回 Future<...> 接口，但 types 头缺少完整接口定义。
    c99_codegen_ensure_mono_struct_1arg(codegen, "Future" as &byte, "usize" as &byte);
    c99_codegen_ensure_mono_struct_1arg(codegen, "Future" as &byte, "i32" as &byte);
    c99_codegen_ensure_mono_struct_1arg(codegen, "Future" as &byte, "u32" as &byte);
    c99_codegen_ensure_mono_struct_1arg(codegen, "Poll" as &byte, "usize" as &byte);
    c99_codegen_ensure_mono_struct_1arg(codegen, "Poll" as &byte, "i32" as &byte);
    c99_codegen_ensure_mono_struct_1arg(codegen, "Poll" as &byte, "u32" as &byte);
    preregister_named_generic_1arg(codegen, "Future" as &byte, "usize" as &byte);
    preregister_named_generic_1arg(codegen, "Future" as &byte, "i32" as &byte);
    preregister_named_generic_1arg(codegen, "Future" as &byte, "u32" as &byte);
    // 镜像 split 下强制将接口类型定义写入 uya_part1_types.h；
    // 否则可能落入 uya_common.c，导致业务 TU 仅见到前置声明而返回类型不完整。
    if codegen.split_mirror != 0 && codegen.split_part1_types_h != null {
        codegen.emit_stream = codegen.split_part1_types_h;
    }
    // 第六步 b1：生成接口结构体与 vtable 结构体（vtable 常量在方法前向声明之后生成）
    // 说明：错误联合结构体可能以 interface 作为 payload，需要先有 interface struct 定义。
    emit_interface_structs_and_vtables(codegen);
    c99_emit_newline(codegen);
    // 预注册 !usize（encode_to_to_json 展开块返回类型），使 err_union_size_t 在第一批输出，避免在函数体内使用未定义类型
    {
        const usize_type: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_NAMED, 0, 0, codegen.arena, null);
        if usize_type != null {
            usize_type.type_named_name = "usize" as &byte;
            const err_union_usize: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_ERROR_UNION, 0, 0, codegen.arena, null);
            if err_union_usize != null {
                err_union_usize.type_error_union_payload_type = usize_type;
                c99_type_to_c(codegen, err_union_usize);
            }
        }
    }
    // 预注册 !bool：std.async 的 ok<bool> 等单态原型在第七步才登记 err_union_bool，若仅靠后续 emit 会与 syscall 等生成顺序纠缠；在此与 !usize 一并提前输出定义
    {
        const bool_type: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_NAMED, 0, 0, codegen.arena, null);
        if bool_type != null {
            bool_type.type_named_name = "bool" as &byte;
            const err_union_b: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_ERROR_UNION, 0, 0, codegen.arena, null);
            if err_union_b != null {
                err_union_b.type_error_union_payload_type = bool_type;
                c99_type_to_c(codegen, err_union_b);
            }
        }
    }
    // 预注册 !byte：Vec<byte>.pop/get 等单态原型会返回 !byte（C 为 err_union_uint8_t），需在类型头阶段先定义
    {
        const byte_named_node: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_NAMED, 0, 0, codegen.arena, null);
        if byte_named_node != null {
            byte_named_node.type_named_name = "byte" as &byte;
            const err_union_byte: &ASTNode = ast_new_node(ASTNodeType.AST_TYPE_ERROR_UNION, 0, 0, codegen.arena, null);
            if err_union_byte != null {
                err_union_byte.type_error_union_payload_type = byte_named_node;
                c99_type_to_c(codegen, err_union_byte);
            }
        }
    }
    // 第六步 b1.5：在输出 err_union 定义前登记函数/方法签名中的 !T（如 std_linux_epoll_create 的 !LinuxEpoll）。
    // 若仅依赖原第六步 e1.5，则登记发生在关闭 uya_part1_types.h 之后，types 头里只有「struct err_union_*;」前向声明而无完整定义，各镜像 .c 会编译失败。
    i = 0;
    while i < decl_count {
        const decl: &ASTNode = c99_plan_decl_at(split_unit_plan, i);
        if decl != null && decl.type == ASTNodeType.AST_FN_DECL {
            if is_generic_function_c99(decl) == 0 {
                preregister_err_union_from_fn_signature(codegen, decl);
            }
        } else if decl != null && decl.type == ASTNodeType.AST_METHOD_BLOCK {
            var owner_name: &byte = decl.method_block_struct_name;
            if owner_name == null {
                owner_name = decl.method_block_union_name;
            }
            var mi: i32 = 0;
            while mi < decl.method_block_method_count {
                const m: &ASTNode = decl.method_block_methods[mi];
                if owner_name != null && m != null && m.type == ASTNodeType.AST_FN_DECL && m.fn_decl_type_param_count == 0 {
                    preregister_err_union_from_method_signature(codegen, m, owner_name);
                }
                mi = mi + 1;
            }
        } else if decl != null && decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_methods != null {
            var mi2: i32 = 0;
            while mi2 < decl.struct_decl_method_count {
                const m2: &ASTNode = decl.struct_decl_methods[mi2];
                if m2 != null && m2.type == ASTNodeType.AST_FN_DECL && m2.fn_decl_type_param_count == 0 {
                    preregister_err_union_from_method_signature(codegen, m2, decl.struct_decl_name);
                }
                mi2 = mi2 + 1;
            }
        }
        i = i + 1;
    }
    // 第六步 b2：生成错误联合结构体（!T -> struct err_union_X），必须在用户结构体之前
    emit_pending_err_union_structs(codegen);
    if codegen.err_union_struct_count > 0 {
        c99_emit_newline(codegen);
    }
    // 第六步 c/d：late mono 注册可能发生在 typedef/err_union 预注册阶段，layout 发射前重建一次 type plan。
    if c99_type_definition_plan_build_from_c99_plan(&type_definition_plan, codegen, split_unit_plan) != 0 {
        c99_type_definition_plan_release(&type_definition_plan);
        return 1;
    }
    // 按 type definition plan 发射 union、内置 TypeInfo、struct/mono struct 定义
    c99_emit_type_definition_layouts(codegen, &type_definition_plan);
    c99_type_definition_plan_release(&type_definition_plan);

    // 统一扫描所有声明中的 @frame 类型并补前向声明，避免多 TU 编译报 incomplete type
    // 必须在关闭 uya_part1_types.h 之前完成，确保前向声明写入类型头文件
    c99_emit_all_async_frame_forwards(codegen, split_unit_plan);

    // 镜像：关闭类型头文件，再写 uya_part1.c 字符串池并进入 uya_common.c（此前 emit_stream 指向 uya_part1_types.h）
    if codegen.split_mirror != 0 && codegen.split_part1_types_h != null {
        _ = fflush(codegen.split_part1_types_h as *void);
        c99_output_buffer_note_close(codegen, codegen.split_part1_types_h);
        _ = fclose(codegen.split_part1_types_h as *void);
        codegen.split_part1_types_h = null;
        codegen.emit_stream = codegen.output;
        fputs("#include \"uya_part1_types.h\"\n\n" as *byte, codegen.output as *void);
    }
    if codegen.split_mirror != 0 {
        emit_string_constants(codegen);
        emit_embed_constants(codegen);
        c99_split_begin_body(codegen);
        c99_emit_newline(codegen);
    }
    emit_pending_embed_constants(codegen);
    emit_embed_dir_tables(codegen);
    emit_pending_embed_dir_tables(codegen);
    if codegen.embedded_dir_table_count > 0 {
        c99_emit_newline(codegen);
    }
    
    // 第七步 c：收集所有测试语句
    // 使用 Arena 分配数组（固定大小数组不能作为可变参数传递）
    const tests_array: & & ASTNode = compiler_arena_alloc(codegen.arena, @size_of(&ASTNode) * MAX_TESTS) as & & ASTNode;
    if tests_array == null {
        return -1;
    }
    var test_count: i32 = 0;
    
    prepare_codegen_tests_and_emit_flags(codegen, split_unit_plan, tests_array, &test_count);
    if g_c99_codegen_has_error != 0 {
        c99_emit_diag_suppress_restore(codegen, saved_codegen_diag);
        return -1;
    }
    
    // 将测试计数保存到 codegen 中，以便 gen_function 可以判断是否需要调用 uya_run_tests()
    codegen.test_count = test_count;
    
    // std.thread：宿主 C 间接调用单参函数指针（由 GCC/Clang 保证调用约定与栈对齐）。
    // 使用 static 而非 static inline：在 -O2 下将该助手内联进部分调用点会触发错误优化（段错误）；
    // 保持为翻译单元内普通 static 函数可避免有问题的跨过程内联。
    // 同时把前向声明写入 split_protos.h，供跨 TU 调用（如 lib/libc/pthread.uya）
    if codegen.split_protos_out != null {
        fputs("int32_t uya_call0_i32(void *fn);\n" as *byte, codegen.split_protos_out as *void);
        fputs("int32_t uya_call0_i32_stack(void *fn, void *stack_top);\n" as *byte, codegen.split_protos_out as *void);
        fputs("int32_t uya_thread_call_i32(void *fn, int32_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("uint32_t uya_thread_call_u32(void *fn, uint32_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("size_t uya_thread_call_usize(void *fn, size_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("int64_t uya_thread_call_i64(void *fn, int64_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("uint64_t uya_thread_call_u64(void *fn, uint64_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("int16_t uya_thread_call_i16(void *fn, int16_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("uint16_t uya_thread_call_u16(void *fn, uint16_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("int8_t uya_thread_call_i8(void *fn, int8_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("uint8_t uya_thread_call_u8(void *fn, uint8_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("int32_t uya_thread_call_bool(void *fn, int32_t arg);\n" as *byte, codegen.split_protos_out as *void);
        fputs("uint32_t uya_thread_call_f32(void *fn, uint32_t arg_bits);\n" as *byte, codegen.split_protos_out as *void);
        fputs("uint64_t uya_thread_call_f64(void *fn, uint64_t arg_bits);\n" as *byte, codegen.split_protos_out as *void);
    }
    fputs("// std.thread：宿主工具链间接调用（跨 -O0/-O2 稳定；见 lib/std/thread.uya）\n" as *byte, codegen.emit_stream as *void);
    fputs("int32_t uya_call0_i32(void *fn) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int32_t (*uya_fn0_i32)(void);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_fn0_i32)fn)();\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int32_t uya_call0_i32_stack(void *fn, void *stack_top) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int32_t (*uya_fn0_i32)(void);\n" as *byte, codegen.emit_stream as *void);
    fputs("#if defined(__x86_64__) || defined(_M_X64)\n" as *byte, codegen.emit_stream as *void);
    fputs("    uintptr_t top = ((uintptr_t)stack_top) & ~(uintptr_t)0xFUL;\n" as *byte, codegen.emit_stream as *void);
    fputs("    int32_t ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("    __asm__ volatile(\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov %%rsp, %%rbx\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov %1, %%rsp\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"call *%2\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov %%rbx, %%rsp\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        : \"=a\"(ret)\n" as *byte, codegen.emit_stream as *void);
    fputs("        : \"r\"((void *)top), \"r\"(fn)\n" as *byte, codegen.emit_stream as *void);
    fputs("        : \"rbx\", \"rcx\", \"rdx\", \"rsi\", \"rdi\", \"r8\", \"r9\", \"r10\", \"r11\", \"memory\", \"cc\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("#elif defined(__aarch64__) || defined(_M_ARM64)\n" as *byte, codegen.emit_stream as *void);
    fputs("    uintptr_t top = ((uintptr_t)stack_top) & ~(uintptr_t)0xFUL;\n" as *byte, codegen.emit_stream as *void);
    fputs("    int32_t ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("    __asm__ volatile(\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov x9, sp\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov sp, %1\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"blr %2\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov %w0, w0\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        \"mov sp, x9\\n\\t\"\n" as *byte, codegen.emit_stream as *void);
    fputs("        : \"=r\"(ret)\n" as *byte, codegen.emit_stream as *void);
    fputs("        : \"r\"((void *)top), \"r\"(fn)\n" as *byte, codegen.emit_stream as *void);
    fputs("        : \"x0\", \"x9\", \"x30\", \"memory\", \"cc\");\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ret;\n" as *byte, codegen.emit_stream as *void);
    fputs("#else\n" as *byte, codegen.emit_stream as *void);
    fputs("    (void)stack_top;\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_fn0_i32)fn)();\n" as *byte, codegen.emit_stream as *void);
    fputs("#endif\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int32_t uya_thread_call_i32(void *fn, int32_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int32_t (*uya_thrd_fn_i32)(int32_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_i32)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("uint32_t uya_thread_call_u32(void *fn, uint32_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef uint32_t (*uya_thrd_fn_u32)(uint32_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_u32)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("size_t uya_thread_call_usize(void *fn, size_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef size_t (*uya_thrd_fn_usz)(size_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_usz)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int64_t uya_thread_call_i64(void *fn, int64_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int64_t (*uya_thrd_fn_i64)(int64_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_i64)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("uint64_t uya_thread_call_u64(void *fn, uint64_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef uint64_t (*uya_thrd_fn_u64)(uint64_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_u64)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int16_t uya_thread_call_i16(void *fn, int16_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int16_t (*uya_thrd_fn_i16)(int16_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_i16)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("uint16_t uya_thread_call_u16(void *fn, uint16_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef uint16_t (*uya_thrd_fn_u16)(uint16_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_u16)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int8_t uya_thread_call_i8(void *fn, int8_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int8_t (*uya_thrd_fn_i8)(int8_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_i8)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("uint8_t uya_thread_call_u8(void *fn, uint8_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef uint8_t (*uya_thrd_fn_u8)(uint8_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_u8)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("int32_t uya_thread_call_bool(void *fn, int32_t arg) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef int32_t (*uya_thrd_fn_bool)(int32_t);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return ((uya_thrd_fn_bool)fn)(arg);\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("// f32/f64：槽位内仍为 u32/u64 位模式；间接调用须用真实 float/double 调用约定（不可伪装成整数函数指针）。\n" as *byte, codegen.emit_stream as *void);
    fputs("uint32_t uya_thread_call_f32(void *fn, uint32_t arg_bits) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef float (*uya_thrd_fn_f32)(float);\n" as *byte, codegen.emit_stream as *void);
    fputs("    union { uint32_t u; float f; } a;\n" as *byte, codegen.emit_stream as *void);
    fputs("    union { uint32_t u; float f; } out;\n" as *byte, codegen.emit_stream as *void);
    fputs("    a.u = arg_bits;\n" as *byte, codegen.emit_stream as *void);
    fputs("    out.f = ((uya_thrd_fn_f32)fn)(a.f);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return out.u;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n" as *byte, codegen.emit_stream as *void);
    fputs("uint64_t uya_thread_call_f64(void *fn, uint64_t arg_bits) {\n" as *byte, codegen.emit_stream as *void);
    fputs("    typedef double (*uya_thrd_fn_f64)(double);\n" as *byte, codegen.emit_stream as *void);
    fputs("    union { uint64_t u; double d; } a;\n" as *byte, codegen.emit_stream as *void);
    fputs("    union { uint64_t u; double d; } out;\n" as *byte, codegen.emit_stream as *void);
    fputs("    a.u = arg_bits;\n" as *byte, codegen.emit_stream as *void);
    fputs("    out.d = ((uya_thrd_fn_f64)fn)(a.d);\n" as *byte, codegen.emit_stream as *void);
    fputs("    return out.u;\n" as *byte, codegen.emit_stream as *void);
    fputs("}\n\n" as *byte, codegen.emit_stream as *void);
    
    // 第七步 d：按需生成系统调用辅助函数（@syscall 内置函数支持）
    helper_plan = c99_build_helper_plan(codegen, split_unit_plan);
    if helper_plan.emit_syscall_helpers != 0 {
