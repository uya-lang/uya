    fputs("    __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(nr), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
