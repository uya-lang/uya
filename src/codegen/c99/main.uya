        fputs("    __asm__ volatile(\"syscall\\n\\tsetc %1\" : \"=a\"(ret), \"=qm\"(uya_err) : \"a\"(nr + 0x2000000L), \"D\"(a1) : \"rcx\", \"r11\", \"cc\", \"memory\");\n" as *byte, codegen.emit_stream as *void);
        fputs("    return uya_err != 0 ? -ret : ret;\n}\n\n" as *byte, codegen.emit_stream as *void);
        fputs("static inline long uya_syscall2(long nr, long a1, long a2) {\n" as *byte, codegen.emit_stream as *void);
