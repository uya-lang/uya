// 兼容层：通用 async lowering 计划现统一收敛到 src/lower/async.uya。

use lower.async;

export fn async_transform_build_plan(
    plan: &AsyncLowerPlan,
    arena: &CompilerArena,
    checker: &TypeChecker,
    body: &ASTNode
) i32 {
    return async_lower_build_plan(plan, arena, checker, body);
}

export fn async_transform_stmt_contains_await(node: &ASTNode) i32 {
    return async_lower_stmt_contains_await(node);
}

export fn async_transform_find_first_try_await_expr(node: &ASTNode, out_try_expr: &&ASTNode) i32 {
    return async_lower_find_first_try_await_expr(node, out_try_expr);
}
