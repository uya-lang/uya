// codegen/mir_c99/driver.uya - MIR-C99 backend driver from target request.

use codegen.mir_c99.calls;
use codegen.mir_c99.cfg;
use codegen.mir_c99.emitter;
use codegen.mir_c99.names;
use codegen.mir_c99.place_memory;
use codegen.mir_c99.plan;
use codegen.mir_c99.types;
use codegen.mir_c99.values;
use codegen.mir_c99.runtime_helpers;

export const MIR_C99_DRIVER_STATUS_ERROR: i32 = -1;
export const MIR_C99_DRIVER_STATUS_UNINITIALIZED: i32 = 0;
export const MIR_C99_DRIVER_STATUS_READY: i32 = 1;
export const MIR_C99_DRIVER_STATUS_DONE: i32 = 2;
export const MIR_C99_DRIVER_DIAG_UNVERIFIED_REQUEST: i32 = -100;

/// 功能说明：记录 MIR-C99 driver 的一次后端执行结果。
/// 参数说明：无；字段保存 plan、emitter 摘要和 diagnostic code。
/// 返回值说明：无。
export struct MirC99DriverResult {
    status: i32,
    output_kind: i32,
    plan: &MirC99Plan,
    unit_count: usize,
    function_count: usize,
    block_count: usize,
    terminator_count: usize,
    type_count: usize,
    value_count: usize,
    local_count: usize,
    memory_op_count: usize,
    call_count: usize,
    helper_count: usize,
    name_count: usize,
    output_bytes: usize,
    diagnostic_code: i32,
}

fn mir_c99_driver_error(result: &MirC99DriverResult, diagnostic_code: i32) i32 {
    if result != null {
        result.status = MIR_C99_DRIVER_STATUS_ERROR;
        result.diagnostic_code = diagnostic_code;
    }
    return -1;
}

/// 功能说明：初始化 MIR-C99 driver result。
/// 参数说明：`result` 为输出结果。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_driver_result_init(result: &MirC99DriverResult) i32 {
    if result == null {
        return -1;
    }
    result.status = MIR_C99_DRIVER_STATUS_UNINITIALIZED;
    result.output_kind = MIR_BACKEND_OUTPUT_MIR_C99_PLAN;
    result.plan = null;
    result.unit_count = 0usize;
    result.function_count = 0usize;
    result.block_count = 0usize;
    result.terminator_count = 0usize;
    result.type_count = 0usize;
    result.value_count = 0usize;
    result.local_count = 0usize;
    result.memory_op_count = 0usize;
    result.call_count = 0usize;
    result.helper_count = 0usize;
    result.name_count = 0usize;
    result.output_bytes = 0usize;
    result.diagnostic_code = 0;
    return 0;
}

fn mir_c99_driver_seed_names(module: &PortableMirModule, names: &MirC99NamePlan) i32 {
    if module == null || names == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.functions.count {
        if mir_c99_name_plan_add(names, MIR_C99_NAME_KIND_FUNCTION,
            i as i32, 0, 0, 0) < 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < module.blocks.count {
        if mir_c99_name_plan_add(names, MIR_C99_NAME_KIND_BLOCK,
            i as i32, 0, 0, 0) < 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < module.values.count {
        if mir_c99_name_plan_add(names, MIR_C99_NAME_KIND_TEMP,
            i as i32, 0, 0, 0) < 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 verified MIR-C99 backend request 构建 `MirC99Plan` 并准备 emitter 输出摘要。
/// 参数说明：`request` 必须是 `MIR_TARGET_BACKEND_C99`，`plan`/`type_plan`/`name_plan`/`emitter`/`result` 为调用方提供的输出结构。
/// 返回值说明：成功返回 `0`，request 非法、计划构建失败或 emitter 拒绝时返回 `-1`。
export fn mir_c99_driver_run(request: &MirTargetBackendRequest, arena: &CompilerArena,
    plan: &MirC99Plan, type_plan: &MirC99TypePlan, name_plan: &MirC99NamePlan, cfg_plan: &MirC99CfgPlan,
    value_plan: &MirC99ValuePlan, place_plan: &MirC99PlaceMemoryPlan,
    call_plan: &MirC99CallPlan, runtime_helper_plan: &MirC99RuntimeHelperPlan,
    emitter: &MirC99Emitter, result: &MirC99DriverResult) i32 {
    if request == null || plan == null || type_plan == null ||
       name_plan == null || cfg_plan == null || value_plan == null ||
       place_plan == null || call_plan == null || runtime_helper_plan == null ||
       emitter == null || result == null {
        return -1;
    }
    if mir_c99_driver_result_init(result) != 0 {
        return -1;
    }
    if request.backend_kind != MIR_TARGET_BACKEND_C99 ||
       portable_mir_backend_request_is_verified(request) == 0 {
        return mir_c99_driver_error(result, MIR_C99_DRIVER_DIAG_UNVERIFIED_REQUEST);
    }
    if mir_c99_plan_init(plan, arena, request.target_profile_id) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    result.plan = plan;
    if mir_c99_plan_add_unit(plan, MIR_C99_UNIT_KIND_PRIMARY) < 0 {
        return mir_c99_driver_error(result, -1);
    }
    const primary_unit: &MirC99Unit = mir_c99_plan_unit_ptr(plan, 0);
    if primary_unit == null {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_type_plan_init(type_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_name_plan_init(name_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_cfg_plan_init(cfg_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_value_plan_init(value_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_place_memory_plan_init(place_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_call_plan_init(call_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_runtime_helper_plan_init(runtime_helper_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_type_plan_build(request.module, plan, type_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_value_plan_build(request.module, value_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_value_plan_build_expressions(request.module, value_plan) != 0 {
        return mir_c99_driver_error(result,
            mir_c99_value_plan_diagnostic_code(value_plan));
    }
    if mir_c99_value_plan_build_constants(request.module, value_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_place_memory_plan_build(request.module, place_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_call_plan_build(request.module, call_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_runtime_helper_plan_build(request.module, plan, primary_unit,
        runtime_helper_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_async_frame_layout_plan_build(request.module, plan, primary_unit) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_cfg_plan_build_functions(request.module, plan, primary_unit, cfg_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_cfg_plan_build_blocks(request.module, cfg_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_cfg_plan_build_terminators(request.module, cfg_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_cfg_plan_build_cleanup_drops(request.module, cfg_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_cfg_plan_build_error_union_returns(request.module, cfg_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_driver_seed_names(request.module, name_plan) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    if mir_c99_emitter_begin(emitter, request, plan) != 0 ||
       mir_c99_emitter_bind_cfg(emitter, cfg_plan) != 0 ||
       mir_c99_emitter_read_plan(emitter) != 0 ||
       mir_c99_emitter_record_unit_outputs(emitter) != 0 {
        return mir_c99_driver_error(result, -1);
    }
    const out: MirC99EmitterOutputResult = mir_c99_emitter_output_result(emitter);
    result.status = MIR_C99_DRIVER_STATUS_DONE;
    result.output_kind = MIR_BACKEND_OUTPUT_MIR_C99_PLAN;
    result.unit_count = plan.units.count;
    result.function_count = cfg_plan.function_count;
    result.block_count = cfg_plan.block_count;
    result.terminator_count = cfg_plan.terminator_count;
    result.type_count = type_plan.count;
    result.value_count = value_plan.count;
    result.local_count = place_plan.local_count;
    result.memory_op_count = place_plan.op_count;
    result.call_count = call_plan.call_count;
    result.helper_count = runtime_helper_plan.helper_count;
    result.name_count = name_plan.count;
    result.output_bytes = out.output_bytes;
    result.diagnostic_code = out.diagnostic_code;
    return 0;
}
