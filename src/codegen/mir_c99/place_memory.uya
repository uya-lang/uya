// codegen/mir_c99/place_memory.uya - MIR locals and memory ops to MIR-C99 place plan.

use codegen.mir_c99.plan;

export const MIR_C99_LOCAL_SLOT_STATUS_MISSING: i32 = 0;
export const MIR_C99_LOCAL_SLOT_STATUS_READY: i32 = 1;
export const MIR_C99_LOCAL_SLOT_STATUS_REJECT: i32 = 2;

export const MIR_C99_MEMORY_OP_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_MEMORY_OP_KIND_LOAD: i32 = 1;
export const MIR_C99_MEMORY_OP_KIND_STORE: i32 = 2;
export const MIR_C99_MEMORY_OP_KIND_LOCAL_SET: i32 = 3;
export const MIR_C99_MEMORY_OP_KIND_FIELD_ADDR: i32 = 4;
export const MIR_C99_MEMORY_OP_KIND_FIELD_LOAD: i32 = 5;
export const MIR_C99_MEMORY_OP_KIND_FIELD_STORE: i32 = 6;
export const MIR_C99_MEMORY_OP_KIND_INDEX_ADDR: i32 = 7;
export const MIR_C99_MEMORY_OP_KIND_INDEX_LOAD: i32 = 8;
export const MIR_C99_MEMORY_OP_KIND_INDEX_STORE: i32 = 9;
export const MIR_C99_MEMORY_OP_KIND_SLICE_PTR_ADDR: i32 = 10;
export const MIR_C99_MEMORY_OP_KIND_SLICE_PTR_LOAD: i32 = 11;
export const MIR_C99_MEMORY_OP_KIND_SLICE_LEN_ADDR: i32 = 12;
export const MIR_C99_MEMORY_OP_KIND_SLICE_LEN_LOAD: i32 = 13;

export const MIR_C99_MEMORY_OP_STATUS_MISSING: i32 = 0;
export const MIR_C99_MEMORY_OP_STATUS_READY: i32 = 1;
export const MIR_C99_MEMORY_OP_STATUS_REJECT: i32 = 2;

export const MIR_C99_MEMORY_OP_FLAG_POINTER_DEREF: i32 = 1;
export const MIR_C99_MEMORY_OP_FLAG_FIELD_ACCESS: i32 = 2;
export const MIR_C99_MEMORY_OP_FLAG_INDEX_ACCESS: i32 = 4;
export const MIR_C99_MEMORY_OP_FLAG_SLICE_COMPONENT: i32 = 8;

export const MIR_C99_SLICE_COMPONENT_PTR: i32 = 1;
export const MIR_C99_SLICE_COMPONENT_LEN: i32 = 2;

/// 功能说明：记录一个 MIR local 到 C local slot 的稳定映射。
/// 参数说明：无；字段保存 local/type/function 和 C slot source id。
/// 返回值说明：无；由 `MirC99PlaceMemoryPlan.locals` 动态保存。
export struct MirC99LocalSlotEntry {
    local_id: MirLocalId,
    function_id: MirFunctionId,
    type_id: MirTypeId,
    c_slot_source_id: i32,
    address_space: i32,
    alignment: usize,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR load/store/local_set/field place 到 C place/value 操作的稳定映射。
/// 参数说明：无；字段保存 inst、目标 local、source value/local、result value 和 field/base metadata。
/// 返回值说明：无；由 `MirC99PlaceMemoryPlan.ops` 动态保存。
export struct MirC99MemoryOpEntry {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    op_kind: i32,
    dest_local_id: MirLocalId,
    source_local_id: MirLocalId,
    source_value_id: MirValueId,
    result_value_id: MirValueId,
    pointer_operand_id: MirOperandId,
    pointer_value_id: MirValueId,
    pointer_local_id: MirLocalId,
    pointee_type_id: MirTypeId,
    base_operand_id: MirOperandId,
    base_value_id: MirValueId,
    base_local_id: MirLocalId,
    field_operand_id: MirOperandId,
    field_index: i32,
    field_type_id: MirTypeId,
    owner_type_id: MirTypeId,
    index_operand_id: MirOperandId,
    index_value_id: MirValueId,
    index_local_id: MirLocalId,
    index_immediate: i32,
    element_type_id: MirTypeId,
    array_type_id: MirTypeId,
    array_length: i32,
    slice_component_kind: i32,
    slice_type_id: MirTypeId,
    slice_ptr_type_id: MirTypeId,
    slice_len_type_id: MirTypeId,
    type_id: MirTypeId,
    operand_start: i32,
    operand_count: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 local slot 和 memory operation 计划。
/// 参数说明：无；`locals` 和 `ops` 为按 MIR 顺序追加的动态表。
/// 返回值说明：无；调用 `mir_c99_place_memory_plan_init` 后使用。
export struct MirC99PlaceMemoryPlan {
    locals: SemanticVector,
    ops: SemanticVector,
    local_count: usize,
    op_count: usize,
    reject_count: usize,
}

fn mir_c99_place_operand_ptr(module: &PortableMirModule, operand_id: MirOperandId) &MirOperand {
    const operand_index: i32 = operand_id as i32;
    if module == null || operand_index < 0 || (operand_index as usize) >= module.operands.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.operands, operand_index as usize) as &MirOperand;
}

fn mir_c99_place_type_ptr(module: &PortableMirModule, type_id: MirTypeId) &MirType {
    const type_index: i32 = type_id as i32;
    if module == null || type_index < 0 || (type_index as usize) >= module.types.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.types, type_index as usize) as &MirType;
}

fn mir_c99_place_field_layout_ptr(module: &PortableMirModule, index: i32) &MirFieldLayout {
    if module == null || index < 0 || (index as usize) >= module.field_layouts.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.field_layouts, index as usize) as &MirFieldLayout;
}

fn mir_c99_place_operand_is_pointer(module: &PortableMirModule, operand: &MirOperand) i32 {
    if module == null || operand == null {
        return 0;
    }
    const typ: &MirType = mir_c99_place_type_ptr(module, operand.type_id);
    if typ != null && typ.kind == MIR_TYPE_KIND_POINTER {
        return 1;
    }
    return 0;
}

fn mir_c99_local_slot_from_mir(local: &MirLocal) MirC99LocalSlotEntry {
    if local == null {
        return MirC99LocalSlotEntry{
            local_id: MIR_LOCAL_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            type_id: MIR_TYPE_INVALID_ID,
            c_slot_source_id: MIR_LOCAL_INVALID_ID,
            address_space: 0,
            alignment: 0usize,
            flags: 0,
            status: MIR_C99_LOCAL_SLOT_STATUS_REJECT,
        };
    }
    return MirC99LocalSlotEntry{
        local_id: local.local_id,
        function_id: local.function_id,
        type_id: local.type_id,
        c_slot_source_id: local.local_id,
        address_space: local.address_space,
        alignment: local.alignment,
        flags: local.flags,
        status: MIR_C99_LOCAL_SLOT_STATUS_READY,
    };
}

fn mir_c99_memory_op_kind(inst: &MirInst) i32 {
    if inst == null {
        return MIR_C99_MEMORY_OP_KIND_UNSUPPORTED;
    }
    if inst.op == MIR_INST_OP_LOAD {
        return MIR_C99_MEMORY_OP_KIND_LOAD;
    }
    if inst.op == MIR_INST_OP_STORE {
        return MIR_C99_MEMORY_OP_KIND_STORE;
    }
    if inst.op == MIR_INST_OP_LOCAL_SET {
        return MIR_C99_MEMORY_OP_KIND_LOCAL_SET;
    }
    if inst.op == MIR_INST_OP_FIELD_ADDR {
        return MIR_C99_MEMORY_OP_KIND_FIELD_ADDR;
    }
    if inst.op == MIR_INST_OP_FIELD_LOAD {
        return MIR_C99_MEMORY_OP_KIND_FIELD_LOAD;
    }
    if inst.op == MIR_INST_OP_FIELD_STORE {
        return MIR_C99_MEMORY_OP_KIND_FIELD_STORE;
    }
    if inst.op == MIR_INST_OP_INDEX_ADDR {
        return MIR_C99_MEMORY_OP_KIND_INDEX_ADDR;
    }
    if inst.op == MIR_INST_OP_INDEX_LOAD {
        return MIR_C99_MEMORY_OP_KIND_INDEX_LOAD;
    }
    if inst.op == MIR_INST_OP_INDEX_STORE {
        return MIR_C99_MEMORY_OP_KIND_INDEX_STORE;
    }
    if inst.op == MIR_INST_OP_SLICE_PTR_ADDR {
        return MIR_C99_MEMORY_OP_KIND_SLICE_PTR_ADDR;
    }
    if inst.op == MIR_INST_OP_SLICE_PTR_LOAD {
        return MIR_C99_MEMORY_OP_KIND_SLICE_PTR_LOAD;
    }
    if inst.op == MIR_INST_OP_SLICE_LEN_ADDR {
        return MIR_C99_MEMORY_OP_KIND_SLICE_LEN_ADDR;
    }
    if inst.op == MIR_INST_OP_SLICE_LEN_LOAD {
        return MIR_C99_MEMORY_OP_KIND_SLICE_LEN_LOAD;
    }
    return MIR_C99_MEMORY_OP_KIND_UNSUPPORTED;
}

fn mir_c99_place_memory_op_bind_pointer(module: &PortableMirModule,
    entry: &MirC99MemoryOpEntry, operand: &MirOperand) i32 {
    if module == null || entry == null || operand == null ||
       mir_c99_place_operand_is_pointer(module, operand) == 0 {
        return 0;
    }
    const typ: &MirType = mir_c99_place_type_ptr(module, operand.type_id);
    if typ == null {
        return 0;
    }
    entry.pointer_operand_id = operand.operand_id;
    entry.pointer_value_id = operand.value_id;
    entry.pointer_local_id = operand.local_id;
    entry.pointee_type_id = typ.pointee_type_id;
    entry.flags = entry.flags | MIR_C99_MEMORY_OP_FLAG_POINTER_DEREF;
    return 1;
}

fn mir_c99_place_memory_op_bind_field(module: &PortableMirModule,
    entry: &MirC99MemoryOpEntry, base: &MirOperand, field_descriptor: &MirOperand) i32 {
    if module == null || entry == null || base == null || field_descriptor == null ||
       field_descriptor.immediate_i32 < 0 {
        return 0;
    }
    const owner: &MirType = mir_c99_place_type_ptr(module, field_descriptor.type_id);
    if owner == null ||
       (owner.kind != MIR_TYPE_KIND_STRUCT && owner.kind != MIR_TYPE_KIND_UNION &&
        owner.kind != MIR_TYPE_KIND_ENUM) ||
       field_descriptor.immediate_i32 >= owner.field_count {
        return 0;
    }
    const field: &MirFieldLayout = mir_c99_place_field_layout_ptr(module,
        owner.field_start + field_descriptor.immediate_i32);
    if field == null || field.owner_type_id != owner.type_id ||
       field.field_index != field_descriptor.immediate_i32 {
        return 0;
    }
    entry.base_operand_id = base.operand_id;
    entry.base_value_id = base.value_id;
    entry.base_local_id = base.local_id;
    entry.field_operand_id = field_descriptor.operand_id;
    entry.field_index = field_descriptor.immediate_i32;
    entry.field_type_id = field.field_type_id;
    entry.owner_type_id = owner.type_id;
    entry.flags = entry.flags | MIR_C99_MEMORY_OP_FLAG_FIELD_ACCESS;
    return 1;
}

fn mir_c99_place_memory_op_bind_index(module: &PortableMirModule,
    entry: &MirC99MemoryOpEntry, base: &MirOperand, index_operand: &MirOperand) i32 {
    if module == null || entry == null || base == null || index_operand == null {
        return 0;
    }
    const pointer_type: &MirType = mir_c99_place_type_ptr(module, base.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER {
        return 0;
    }
    const array_type: &MirType = mir_c99_place_type_ptr(module,
        pointer_type.pointee_type_id);
    if array_type == null || array_type.kind != MIR_TYPE_KIND_ARRAY ||
       mir_c99_place_type_ptr(module, array_type.element_type_id) == null ||
       array_type.field_count <= 0 {
        return 0;
    }
    if index_operand.value_id != MIR_VALUE_INVALID_ID ||
       index_operand.local_id != MIR_LOCAL_INVALID_ID {
        if (entry.flags & MIR_INST_FLAG_BOUNDS_CHECKED) == 0 {
            return 0;
        }
    } else if index_operand.immediate_i32 < 0 ||
              index_operand.immediate_i32 >= array_type.field_count {
        return 0;
    }
    entry.base_operand_id = base.operand_id;
    entry.base_value_id = base.value_id;
    entry.base_local_id = base.local_id;
    entry.index_operand_id = index_operand.operand_id;
    entry.index_value_id = index_operand.value_id;
    entry.index_local_id = index_operand.local_id;
    entry.index_immediate = index_operand.immediate_i32;
    entry.element_type_id = array_type.element_type_id;
    entry.array_type_id = array_type.type_id;
    entry.array_length = array_type.field_count;
    entry.flags = entry.flags | MIR_C99_MEMORY_OP_FLAG_INDEX_ACCESS;
    return 1;
}

fn mir_c99_place_memory_op_bind_slice_component(module: &PortableMirModule,
    entry: &MirC99MemoryOpEntry, base: &MirOperand) i32 {
    if module == null || entry == null || base == null {
        return 0;
    }
    const pointer_type: &MirType = mir_c99_place_type_ptr(module, base.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER {
        return 0;
    }
    const slice_type: &MirType = mir_c99_place_type_ptr(module,
        pointer_type.pointee_type_id);
    if slice_type == null || slice_type.kind != MIR_TYPE_KIND_SLICE ||
       mir_c99_place_type_ptr(module, slice_type.pointee_type_id) == null {
        return 0;
    }
    var component_kind: i32 = 0;
    var len_type_id: MirTypeId = -1;
    if entry.op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_PTR_ADDR ||
       entry.op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_PTR_LOAD {
        component_kind = MIR_C99_SLICE_COMPONENT_PTR;
    } else if entry.op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_LEN_ADDR {
        const len_pointer_type: &MirType = mir_c99_place_type_ptr(module, entry.type_id);
        if len_pointer_type == null || len_pointer_type.kind != MIR_TYPE_KIND_POINTER {
            return 0;
        }
        const len_type: &MirType = mir_c99_place_type_ptr(module,
            len_pointer_type.pointee_type_id);
        if len_type == null || len_type.kind != MIR_TYPE_KIND_USIZE {
            return 0;
        }
        component_kind = MIR_C99_SLICE_COMPONENT_LEN;
        len_type_id = len_type.type_id;
    } else if entry.op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_LEN_LOAD {
        const len_load_type: &MirType = mir_c99_place_type_ptr(module, entry.type_id);
        if len_load_type == null || len_load_type.kind != MIR_TYPE_KIND_USIZE {
            return 0;
        }
        component_kind = MIR_C99_SLICE_COMPONENT_LEN;
        len_type_id = len_load_type.type_id;
    } else {
        return 0;
    }
    entry.base_operand_id = base.operand_id;
    entry.base_value_id = base.value_id;
    entry.base_local_id = base.local_id;
    entry.slice_component_kind = component_kind;
    entry.slice_type_id = slice_type.type_id;
    entry.slice_ptr_type_id = slice_type.pointee_type_id;
    entry.slice_len_type_id = len_type_id;
    entry.flags = entry.flags | MIR_C99_MEMORY_OP_FLAG_SLICE_COMPONENT;
    return 1;
}

fn mir_c99_memory_op_from_mir(module: &PortableMirModule, inst: &MirInst) MirC99MemoryOpEntry {
    if module == null || inst == null {
        return MirC99MemoryOpEntry{
            inst_id: MIR_INST_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            block_id: MIR_BLOCK_INVALID_ID,
            op_kind: MIR_C99_MEMORY_OP_KIND_UNSUPPORTED,
            dest_local_id: MIR_LOCAL_INVALID_ID,
            source_local_id: MIR_LOCAL_INVALID_ID,
            source_value_id: MIR_VALUE_INVALID_ID,
            result_value_id: MIR_VALUE_INVALID_ID,
            pointer_operand_id: -1,
            pointer_value_id: MIR_VALUE_INVALID_ID,
            pointer_local_id: MIR_LOCAL_INVALID_ID,
            pointee_type_id: MIR_TYPE_INVALID_ID,
            base_operand_id: -1,
            base_value_id: -1,
            base_local_id: -1,
            field_operand_id: -1,
            field_index: -1,
            field_type_id: -1,
            owner_type_id: -1,
            index_operand_id: -1,
            index_value_id: -1,
            index_local_id: -1,
            index_immediate: -1,
            element_type_id: -1,
            array_type_id: -1,
            array_length: 0,
            slice_component_kind: 0,
            slice_type_id: -1,
            slice_ptr_type_id: -1,
            slice_len_type_id: -1,
            type_id: MIR_TYPE_INVALID_ID,
            operand_start: -1,
            operand_count: 0,
            flags: 0,
            status: MIR_C99_MEMORY_OP_STATUS_REJECT,
        };
    }
    const op_kind: i32 = mir_c99_memory_op_kind(inst);
    var dest_local_id: MirLocalId = -1;
    var source_local_id: MirLocalId = -1;
    var source_value_id: MirValueId = -1;
    var pointer_operand: &MirOperand = null;
    var base_operand: &MirOperand = null;
    var field_operand: &MirOperand = null;
    var index_operand: &MirOperand = null;
    var status: i32 = MIR_C99_MEMORY_OP_STATUS_READY;
    if op_kind == MIR_C99_MEMORY_OP_KIND_UNSUPPORTED {
        status = MIR_C99_MEMORY_OP_STATUS_REJECT;
    }
    if op_kind == MIR_C99_MEMORY_OP_KIND_LOAD && inst.operand_count >= 1 {
        const load_src: &MirOperand = mir_c99_place_operand_ptr(module, inst.operand_start);
        if load_src != null {
            source_local_id = load_src.local_id;
            pointer_operand = load_src;
        }
    } else if (op_kind == MIR_C99_MEMORY_OP_KIND_STORE ||
               op_kind == MIR_C99_MEMORY_OP_KIND_LOCAL_SET) &&
              inst.operand_count >= 2 {
        const dest: &MirOperand = mir_c99_place_operand_ptr(module, inst.operand_start);
        const source: &MirOperand = mir_c99_place_operand_ptr(module, inst.operand_start + 1);
        if dest != null {
            dest_local_id = dest.local_id;
            pointer_operand = dest;
        }
        if source != null {
            source_local_id = source.local_id;
            source_value_id = source.value_id;
        }
    } else if (op_kind == MIR_C99_MEMORY_OP_KIND_FIELD_ADDR ||
               op_kind == MIR_C99_MEMORY_OP_KIND_FIELD_LOAD) &&
              inst.operand_count >= 2 {
        base_operand = mir_c99_place_operand_ptr(module, inst.operand_start);
        field_operand = mir_c99_place_operand_ptr(module, inst.operand_start + 1);
        if base_operand != null {
            source_local_id = base_operand.local_id;
            source_value_id = base_operand.value_id;
        }
    } else if op_kind == MIR_C99_MEMORY_OP_KIND_FIELD_STORE &&
              inst.operand_count >= 3 {
        base_operand = mir_c99_place_operand_ptr(module, inst.operand_start);
        field_operand = mir_c99_place_operand_ptr(module, inst.operand_start + 1);
        const field_source: &MirOperand = mir_c99_place_operand_ptr(module, inst.operand_start + 2);
        if base_operand != null {
            dest_local_id = base_operand.local_id;
        }
        if field_source != null {
            source_local_id = field_source.local_id;
            source_value_id = field_source.value_id;
        }
    } else if (op_kind == MIR_C99_MEMORY_OP_KIND_INDEX_ADDR ||
               op_kind == MIR_C99_MEMORY_OP_KIND_INDEX_LOAD) &&
              inst.operand_count >= 2 {
        base_operand = mir_c99_place_operand_ptr(module, inst.operand_start);
        index_operand = mir_c99_place_operand_ptr(module, inst.operand_start + 1);
        if base_operand != null {
            source_local_id = base_operand.local_id;
            source_value_id = base_operand.value_id;
        }
    } else if op_kind == MIR_C99_MEMORY_OP_KIND_INDEX_STORE &&
              inst.operand_count >= 3 {
        base_operand = mir_c99_place_operand_ptr(module, inst.operand_start);
        index_operand = mir_c99_place_operand_ptr(module, inst.operand_start + 1);
        const index_source: &MirOperand = mir_c99_place_operand_ptr(module, inst.operand_start + 2);
        if base_operand != null {
            dest_local_id = base_operand.local_id;
        }
        if index_source != null {
            source_local_id = index_source.local_id;
            source_value_id = index_source.value_id;
        }
    } else if (op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_PTR_ADDR ||
               op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_PTR_LOAD ||
               op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_LEN_ADDR ||
               op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_LEN_LOAD) &&
              inst.operand_count >= 1 {
        base_operand = mir_c99_place_operand_ptr(module, inst.operand_start);
        if base_operand != null {
            source_local_id = base_operand.local_id;
            source_value_id = base_operand.value_id;
        }
    } else if op_kind != MIR_C99_MEMORY_OP_KIND_UNSUPPORTED {
        status = MIR_C99_MEMORY_OP_STATUS_REJECT;
    }
    var entry: MirC99MemoryOpEntry = MirC99MemoryOpEntry{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        block_id: inst.block_id,
        op_kind: op_kind,
        dest_local_id: dest_local_id,
        source_local_id: source_local_id,
        source_value_id: source_value_id,
        result_value_id: inst.result_value_id,
        pointer_operand_id: -1,
        pointer_value_id: MIR_VALUE_INVALID_ID,
        pointer_local_id: MIR_LOCAL_INVALID_ID,
        pointee_type_id: MIR_TYPE_INVALID_ID,
        base_operand_id: -1,
        base_value_id: -1,
        base_local_id: -1,
        field_operand_id: -1,
        field_index: -1,
        field_type_id: -1,
        owner_type_id: -1,
        index_operand_id: -1,
        index_value_id: -1,
        index_local_id: -1,
        index_immediate: -1,
        element_type_id: -1,
        array_type_id: -1,
        array_length: 0,
        slice_component_kind: 0,
        slice_type_id: -1,
        slice_ptr_type_id: -1,
        slice_len_type_id: -1,
        type_id: inst.type_id,
        operand_start: inst.operand_start,
        operand_count: inst.operand_count,
        flags: inst.flags,
        status: status,
    };
    if op_kind == MIR_C99_MEMORY_OP_KIND_LOAD || op_kind == MIR_C99_MEMORY_OP_KIND_STORE {
        mir_c99_place_memory_op_bind_pointer(module, &entry, pointer_operand);
    }
    if op_kind == MIR_C99_MEMORY_OP_KIND_FIELD_ADDR ||
       op_kind == MIR_C99_MEMORY_OP_KIND_FIELD_LOAD ||
       op_kind == MIR_C99_MEMORY_OP_KIND_FIELD_STORE {
        if mir_c99_place_memory_op_bind_field(module, &entry, base_operand, field_operand) == 0 {
            entry.status = MIR_C99_MEMORY_OP_STATUS_REJECT;
        }
    }
    if op_kind == MIR_C99_MEMORY_OP_KIND_INDEX_ADDR ||
       op_kind == MIR_C99_MEMORY_OP_KIND_INDEX_LOAD ||
       op_kind == MIR_C99_MEMORY_OP_KIND_INDEX_STORE {
        if mir_c99_place_memory_op_bind_index(module, &entry, base_operand, index_operand) == 0 {
            entry.status = MIR_C99_MEMORY_OP_STATUS_REJECT;
        }
    }
    if op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_PTR_ADDR ||
       op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_PTR_LOAD ||
       op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_LEN_ADDR ||
       op_kind == MIR_C99_MEMORY_OP_KIND_SLICE_LEN_LOAD {
        if mir_c99_place_memory_op_bind_slice_component(module, &entry, base_operand) == 0 {
            entry.status = MIR_C99_MEMORY_OP_STATUS_REJECT;
        }
    }
    return entry;
}

/// 功能说明：初始化 MIR-C99 place/memory 计划。
/// 参数说明：`plan` 为输出计划。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_place_memory_plan_init(plan: &MirC99PlaceMemoryPlan) i32 {
    if plan == null {
        return -1;
    }
    semantic_vector_init(&plan.locals, @size_of(MirC99LocalSlotEntry));
    semantic_vector_init(&plan.ops, @size_of(MirC99MemoryOpEntry));
    plan.local_count = 0usize;
    plan.op_count = 0usize;
    plan.reject_count = 0usize;
    return 0;
}

/// 功能说明：释放 MIR-C99 place/memory 计划。
/// 参数说明：`plan` 为待释放计划；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_place_memory_plan_release(plan: &MirC99PlaceMemoryPlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.locals);
    semantic_vector_release(&plan.ops);
    plan.local_count = 0usize;
    plan.op_count = 0usize;
    plan.reject_count = 0usize;
}

/// 功能说明：从 PortableMIR module 构建 local slot 和 memory operation 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出 place/memory 计划。
/// 返回值说明：当前支持的 local/load/store/local_set 都映射成功返回 `0`，参数非法或追加失败返回 `-1`。
export fn mir_c99_place_memory_plan_build(module: &PortableMirModule,
    plan: &MirC99PlaceMemoryPlan) i32 {
    if module == null || plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.locals.count {
        const local: &MirLocal = semantic_vector_item_ptr(&module.locals, i) as &MirLocal;
        const entry: MirC99LocalSlotEntry = mir_c99_local_slot_from_mir(local);
        if semantic_vector_append(&plan.locals, &entry as &const void) != 0 {
            status = -1;
        }
        plan.local_count = plan.locals.count;
        if entry.status == MIR_C99_LOCAL_SLOT_STATUS_REJECT {
            plan.reject_count = plan.reject_count + 1usize;
            status = -1;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = semantic_vector_item_ptr(&module.insts, i) as &MirInst;
        const op_entry: MirC99MemoryOpEntry = mir_c99_memory_op_from_mir(module, inst);
        if op_entry.status == MIR_C99_MEMORY_OP_STATUS_READY {
            if semantic_vector_append(&plan.ops, &op_entry as &const void) != 0 {
                status = -1;
            }
            plan.op_count = plan.ops.count;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：按下标读取 MIR-C99 local slot 计划条目。
/// 参数说明：`plan` 为 place/memory 计划，`index` 为 local 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_place_memory_plan_local_ptr(plan: &MirC99PlaceMemoryPlan, index: i32) &MirC99LocalSlotEntry {
    if plan == null || index < 0 || (index as usize) >= plan.locals.count {
        return null;
    }
    return semantic_vector_item_ptr(&plan.locals, index as usize) as &MirC99LocalSlotEntry;
}

/// 功能说明：按下标读取 MIR-C99 memory operation 计划条目。
/// 参数说明：`plan` 为 place/memory 计划，`index` 为 op 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_place_memory_plan_op_ptr(plan: &MirC99PlaceMemoryPlan, index: i32) &MirC99MemoryOpEntry {
    if plan == null || index < 0 || (index as usize) >= plan.ops.count {
        return null;
    }
    return semantic_vector_item_ptr(&plan.ops, index as usize) as &MirC99MemoryOpEntry;
}
