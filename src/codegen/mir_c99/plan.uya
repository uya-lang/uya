// codegen/mir_c99/plan.uya - Independent MIR-C99 output plan.
//
// This file intentionally owns only MIR-C99 plan data. It consumes stable MIR
// ids and helper refs; it must not depend on legacy AST C99 planner state.

export const MIR_C99_PLAN_LIFECYCLE_UNINITIALIZED: i32 = 0;
export const MIR_C99_PLAN_LIFECYCLE_ACTIVE: i32 = 1;
export const MIR_C99_PLAN_LIFECYCLE_RELEASED: i32 = 2;

export const MIR_C99_UNIT_KIND_PRIMARY: i32 = 1;
export const MIR_C99_UNIT_KIND_MODULE: i32 = 2;
export const MIR_C99_UNIT_KIND_HELPERS: i32 = 3;
export const MIR_C99_UNIT_KIND_SOURCE: i32 = 4;
export const MIR_C99_UNIT_KIND_FUNCTION_GROUP: i32 = 5;

export const MIR_C99_REF_KIND_UNKNOWN: i32 = 0;
export const MIR_C99_REF_KIND_INCLUDE: i32 = 1;
export const MIR_C99_REF_KIND_TYPEDEF: i32 = 2;
export const MIR_C99_REF_KIND_PROTOTYPE: i32 = 3;
export const MIR_C99_REF_KIND_GLOBAL: i32 = 4;
export const MIR_C99_REF_KIND_FUNCTION: i32 = 5;
export const MIR_C99_REF_KIND_HELPER: i32 = 6;
export const MIR_C99_REF_KIND_DEP: i32 = 7;
export const MIR_C99_REF_KIND_ASYNC_FRAME_LAYOUT: i32 = 8;
export const MIR_C99_REF_KIND_ASYNC_FRAME_SLOT: i32 = 9;

export const MIR_C99_GLOBAL_INIT_STATUS_READY: i32 = 1;
export const MIR_C99_GLOBAL_INIT_STATUS_REJECT: i32 = 2;
export const MIR_C99_LINK_INPUT_STATUS_READY: i32 = 1;
export const MIR_C99_LINK_INPUT_STATUS_REJECT: i32 = 2;

/// 功能说明：记录 MIR-C99 输出计划中的稳定引用。
/// 参数说明：无；`source_id` 保存 MIR/module/helper 的稳定 ID，`aux_id` 保存后端局部辅助 ID。
/// 返回值说明：无；由 `MirC99Plan` 和 `MirC99Unit` 的动态表保存。
export struct MirC99Ref {
    kind: i32,
    source_id: i32,
    aux_id: i32,
    flags: i32,
}

/// 功能说明：记录一个 MIR-C99 translation unit 的输出计划。
/// 参数说明：无；所有列表均为 `MirC99Ref` 动态表，不设置固定容量上限。
/// 返回值说明：无；首版可以只有 primary unit，后续 split-C 复用同一结构。
export struct MirC99Unit {
    unit_id: i32,
    kind: i32,
    name_id: InternedNameId,
    source_file_id: FileId,
    function_group_id: i32,
    fingerprint: u64,
    estimated_bytes: usize,
    includes: SemanticVector,
    typedefs: SemanticVector,
    prototypes: SemanticVector,
    globals: SemanticVector,
    functions: SemanticVector,
    helpers: SemanticVector,
    deps: SemanticVector,
    async_frame_layouts: SemanticVector,
    async_frame_slots: SemanticVector,
}

/// 功能说明：记录一个 MIR function 被分配到哪个 MIR-C99 translation unit。
/// 参数说明：无；字段保存 function、unit、cross-unit symbol、source file 和 function group 稳定 ID。
/// 返回值说明：无；由 `MirC99Plan.unit_assignments` 动态表保存。
export struct MirC99UnitAssignment {
    assignment_id: i32,
    function_id: MirFunctionId,
    unit_id: i32,
    source_file_id: FileId,
    cross_unit_symbol_id: MirCrossUnitSymbolId,
    function_group_id: i32,
    flags: i32,
}

/// 功能说明：记录 MIR-C99 async frame 的单个 concrete slot 布局。
/// 参数说明：无；字段来自 PortableMIR `MirAsyncFrameMeta`，覆盖 state/result/await child/captured local。
/// 返回值说明：无；由 `MirC99Plan.async_frame_slots` 动态表保存。
export struct MirC99AsyncFrameSlotLayout {
    slot_meta_id: MirAsyncFrameMetaId,
    function_id: MirFunctionId,
    frame_type_id: MirTypeId,
    slot_kind: i32,
    slot_index: i32,
    slot_type_id: MirTypeId,
    captured_local_id: MirLocalId,
    state_tag: i32,
    flags: i32,
}

/// 功能说明：记录 MIR-C99 async frame struct layout 摘要。
/// 参数说明：无；字段按 function/frame type 聚合 state tag、result、await child 和 captured local slot。
/// 返回值说明：无；完整 poll/resume state machine 在后续 async 叶子消费此布局。
export struct MirC99AsyncFrameLayout {
    function_id: MirFunctionId,
    frame_type_id: MirTypeId,
    slot_start: usize,
    slot_count: usize,
    state_tag_slot_count: usize,
    result_slot_count: usize,
    await_child_slot_count: usize,
    captured_local_slot_count: usize,
    flags: i32,
}

/// 功能说明：记录 MIR-C99 global scalar/aggregate/string initializer 和 extern global 输出计划。
/// 参数说明：无；字段只来自 verifier-clean PortableMIR `MirGlobal` 和 `MirConst` metadata。
/// 返回值说明：无；由 `MirC99Plan.global_initializers` 动态保存，unit global ref 通过 `aux_id` 指向本表。
export struct MirC99GlobalInitializerPlanEntry {
    global_id: MirGlobalId,
    type_id: MirTypeId,
    const_id: MirConstId,
    init_kind: i32,
    const_kind: i32,
    section: i32,
    linkage: i32,
    visibility: i32,
    alignment: usize,
    dedupe_id: i32,
    byte_offset: usize,
    byte_count: usize,
    scalar_i64: i64,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 host link 所需的 @c_import sidecar object、object file、library 和 search path 输入。
/// 参数说明：无；字段只来自 verifier-clean PortableMIR `MirLinkInput`，保留 target profile、@c_import 来源、路径/库名 dedupe 和 capability metadata。
/// 返回值说明：无；由 `MirC99Plan.link_inputs` 动态保存，host compile/link handoff 后续消费本表。
export struct MirC99LinkInputPlanEntry {
    link_input_id: MirLinkInputId,
    kind: i32,
    target_profile_id: i32,
    c_import_id: i32,
    symbol_id: SymbolId,
    path_dedupe_id: i32,
    name_dedupe_id: i32,
    capability_req_id: MirCapabilityReqId,
    debug_loc_id: MirDebugLocId,
    flags: i32,
    status: i32,
}

/// 功能说明：记录完整 MIR-C99 后端输出计划。
/// 参数说明：无；调用 `mir_c99_plan_init` 后使用，所有 program/unit 表都动态增长。
/// 返回值说明：无；emitter 只消费该结构输出 C bytes。
export struct MirC99Plan {
    arena: &CompilerArena,
    lifecycle_state: i32,
    target_profile_id: i32,
    unit_count: usize,
    estimated_bytes: usize,
    resident_peak_bytes: usize,
    includes: SemanticVector,
    typedefs: SemanticVector,
    prototypes: SemanticVector,
    globals: SemanticVector,
    functions: SemanticVector,
    helpers: SemanticVector,
    deps: SemanticVector,
    async_frame_layout_refs: SemanticVector,
    async_frame_slot_refs: SemanticVector,
    async_frame_layouts: SemanticVector,
    async_frame_slots: SemanticVector,
    global_initializers: SemanticVector,
    link_inputs: SemanticVector,
    unit_assignments: SemanticVector,
    units: SemanticVector,
}

/// 功能说明：聚合 MIR-C99 plan 动态表的统计摘要。
/// 参数说明：无；由 `mir_c99_plan_stats` 返回。
/// 返回值说明：无；字段统计动态表数量、元素数、容量、字节数和扩容次数。
export struct MirC99PlanStats {
    table_count: i32,
    table_items: usize,
    table_capacity: usize,
    table_bytes: usize,
    table_realloc_count: i32,
}

fn mir_c99_ref_make(kind: i32, source_id: i32, aux_id: i32, flags: i32) MirC99Ref {
    return MirC99Ref{
        kind: kind,
        source_id: source_id,
        aux_id: aux_id,
        flags: flags,
    };
}

fn mir_c99_empty_vector() SemanticVector {
    return SemanticVector{
        data: null,
        item_size: 0usize,
        count: 0usize,
        capacity: 0usize,
        bytes: 0usize,
        realloc_count: 0,
    };
}

fn mir_c99_unit_empty() MirC99Unit {
    return MirC99Unit{
        unit_id: -1,
        kind: MIR_C99_UNIT_KIND_PRIMARY,
        name_id: 0,
        source_file_id: 0,
        function_group_id: -1,
        fingerprint: 0u64,
        estimated_bytes: 0usize,
        includes: mir_c99_empty_vector(),
        typedefs: mir_c99_empty_vector(),
        prototypes: mir_c99_empty_vector(),
        globals: mir_c99_empty_vector(),
        functions: mir_c99_empty_vector(),
        helpers: mir_c99_empty_vector(),
        deps: mir_c99_empty_vector(),
        async_frame_layouts: mir_c99_empty_vector(),
        async_frame_slots: mir_c99_empty_vector(),
    };
}

fn mir_c99_vec_append_ref(vec: &SemanticVector, kind: i32, source_id: i32, aux_id: i32, flags: i32) i32 {
    if vec == null {
        return -1;
    }
    const item: MirC99Ref = mir_c99_ref_make(kind, source_id, aux_id, flags);
    if semantic_vector_append(vec, &item as &const void) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_stats_add_vector(stats: &MirC99PlanStats, vec: &SemanticVector) void {
    if stats == null || vec == null {
        return;
    }
    stats.table_count = stats.table_count + 1;
    stats.table_items = stats.table_items + vec.count;
    stats.table_capacity = stats.table_capacity + vec.capacity;
    stats.table_bytes = stats.table_bytes + vec.bytes;
    stats.table_realloc_count = stats.table_realloc_count + vec.realloc_count;
}

fn mir_c99_hash_mix_u64(hash: u64, value: u64) u64 {
    return (hash ^ value) * 1099511628211u64;
}

fn mir_c99_hash_mix_i32(hash: u64, value: i32) u64 {
    return mir_c99_hash_mix_u64(hash, value as u64);
}

fn mir_c99_unit_fingerprint_refs(hash: u64, vec: &SemanticVector) u64 {
    if vec == null {
        return hash;
    }
    var h: u64 = mir_c99_hash_mix_u64(hash, vec.count);
    var i: usize = 0usize;
    while i < vec.count {
        const ref: &MirC99Ref = semantic_vector_item_ptr(vec, i) as &MirC99Ref;
        if ref != null {
            h = mir_c99_hash_mix_i32(h, ref.kind);
            h = mir_c99_hash_mix_i32(h, ref.source_id);
            h = mir_c99_hash_mix_i32(h, ref.aux_id);
            h = mir_c99_hash_mix_i32(h, ref.flags);
        }
        i = i + 1usize;
    }
    return h;
}

/// 功能说明：计算 MIR-C99 unit 的结构性 fingerprint。
/// 参数说明：`unit` 为待计算 unit；只读取 unit kind、function group、ref 顺序和 ref metadata。
/// 返回值说明：返回与路径文本、空白无关的 64-bit fingerprint；参数非法返回 `0`。
export fn mir_c99_unit_compute_fingerprint(unit: &MirC99Unit) u64 {
    if unit == null {
        return 0u64;
    }
    var h: u64 = 1469598103934665603u64;
    h = mir_c99_hash_mix_i32(h, unit.kind);
    h = mir_c99_hash_mix_i32(h, unit.function_group_id);
    h = mir_c99_unit_fingerprint_refs(h, &unit.includes);
    h = mir_c99_unit_fingerprint_refs(h, &unit.typedefs);
    h = mir_c99_unit_fingerprint_refs(h, &unit.prototypes);
    h = mir_c99_unit_fingerprint_refs(h, &unit.globals);
    h = mir_c99_unit_fingerprint_refs(h, &unit.functions);
    h = mir_c99_unit_fingerprint_refs(h, &unit.helpers);
    h = mir_c99_unit_fingerprint_refs(h, &unit.deps);
    h = mir_c99_unit_fingerprint_refs(h, &unit.async_frame_layouts);
    h = mir_c99_unit_fingerprint_refs(h, &unit.async_frame_slots);
    return h;
}

/// 功能说明：刷新 MIR-C99 unit 的结构性 fingerprint。
/// 参数说明：`unit` 为待刷新 unit。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_unit_refresh_fingerprint(unit: &MirC99Unit) i32 {
    if unit == null {
        return -1;
    }
    unit.fingerprint = mir_c99_unit_compute_fingerprint(unit);
    return 0;
}

/// 功能说明：初始化一个 MIR-C99 unit 计划。
/// 参数说明：`unit` 为输出 unit，`unit_id` 为稳定下标，`kind` 为 `MIR_C99_UNIT_KIND_*`。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_unit_init(unit: &MirC99Unit, unit_id: i32, kind: i32) i32 {
    if unit == null || unit_id < 0 {
        return -1;
    }
    unit.unit_id = unit_id;
    unit.kind = kind;
    unit.name_id = 0;
    unit.source_file_id = 0;
    unit.function_group_id = -1;
    unit.fingerprint = 0u64;
    unit.estimated_bytes = 0usize;
    semantic_vector_init(&unit.includes, @size_of(MirC99Ref));
    semantic_vector_init(&unit.typedefs, @size_of(MirC99Ref));
    semantic_vector_init(&unit.prototypes, @size_of(MirC99Ref));
    semantic_vector_init(&unit.globals, @size_of(MirC99Ref));
    semantic_vector_init(&unit.functions, @size_of(MirC99Ref));
    semantic_vector_init(&unit.helpers, @size_of(MirC99Ref));
    semantic_vector_init(&unit.deps, @size_of(MirC99Ref));
    semantic_vector_init(&unit.async_frame_layouts, @size_of(MirC99Ref));
    semantic_vector_init(&unit.async_frame_slots, @size_of(MirC99Ref));
    return 0;
}

/// 功能说明：释放 MIR-C99 unit 内部动态表。
/// 参数说明：`unit` 为待释放 unit；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_unit_release(unit: &MirC99Unit) void {
    if unit == null {
        return;
    }
    semantic_vector_release(&unit.includes);
    semantic_vector_release(&unit.typedefs);
    semantic_vector_release(&unit.prototypes);
    semantic_vector_release(&unit.globals);
    semantic_vector_release(&unit.functions);
    semantic_vector_release(&unit.helpers);
    semantic_vector_release(&unit.deps);
    semantic_vector_release(&unit.async_frame_layouts);
    semantic_vector_release(&unit.async_frame_slots);
    unit.estimated_bytes = 0usize;
}

/// 功能说明：向 MIR-C99 unit 的指定 ref 表追加稳定引用。
/// 参数说明：`unit` 为目标 unit，`kind` 为 `MIR_C99_REF_KIND_*`，`source_id`/`aux_id`/`flags` 为引用元数据。
/// 返回值说明：成功返回 `0`，未知 kind 或追加失败返回 `-1`。
export fn mir_c99_unit_append_ref(unit: &MirC99Unit, kind: i32, source_id: i32, aux_id: i32, flags: i32) i32 {
    if unit == null {
        return -1;
    }
    var status: i32 = -1;
    if kind == MIR_C99_REF_KIND_INCLUDE {
        status = mir_c99_vec_append_ref(&unit.includes, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_TYPEDEF {
        status = mir_c99_vec_append_ref(&unit.typedefs, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_PROTOTYPE {
        status = mir_c99_vec_append_ref(&unit.prototypes, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_GLOBAL {
        status = mir_c99_vec_append_ref(&unit.globals, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_FUNCTION {
        status = mir_c99_vec_append_ref(&unit.functions, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_HELPER {
        status = mir_c99_vec_append_ref(&unit.helpers, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_DEP {
        status = mir_c99_vec_append_ref(&unit.deps, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_ASYNC_FRAME_LAYOUT {
        status = mir_c99_vec_append_ref(&unit.async_frame_layouts, kind, source_id, aux_id, flags);
    } else if kind == MIR_C99_REF_KIND_ASYNC_FRAME_SLOT {
        status = mir_c99_vec_append_ref(&unit.async_frame_slots, kind, source_id, aux_id, flags);
    }
    if status != 0 {
        return -1;
    }
    return mir_c99_unit_refresh_fingerprint(unit);
}

/// 功能说明：初始化 MIR-C99 输出计划。
/// 参数说明：`plan` 为输出计划，`arena` 为生命周期归属，`target_profile_id` 为 MIR target profile。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_plan_init(plan: &MirC99Plan, arena: &CompilerArena, target_profile_id: i32) i32 {
    if plan == null {
        return -1;
    }
    plan.arena = arena;
    plan.lifecycle_state = MIR_C99_PLAN_LIFECYCLE_ACTIVE;
    plan.target_profile_id = target_profile_id;
    plan.unit_count = 0usize;
    plan.estimated_bytes = 0usize;
    plan.resident_peak_bytes = 0usize;
    semantic_vector_init(&plan.includes, @size_of(MirC99Ref));
    semantic_vector_init(&plan.typedefs, @size_of(MirC99Ref));
    semantic_vector_init(&plan.prototypes, @size_of(MirC99Ref));
    semantic_vector_init(&plan.globals, @size_of(MirC99Ref));
    semantic_vector_init(&plan.functions, @size_of(MirC99Ref));
    semantic_vector_init(&plan.helpers, @size_of(MirC99Ref));
    semantic_vector_init(&plan.deps, @size_of(MirC99Ref));
    semantic_vector_init(&plan.async_frame_layout_refs, @size_of(MirC99Ref));
    semantic_vector_init(&plan.async_frame_slot_refs, @size_of(MirC99Ref));
    semantic_vector_init(&plan.async_frame_layouts, @size_of(MirC99AsyncFrameLayout));
    semantic_vector_init(&plan.async_frame_slots, @size_of(MirC99AsyncFrameSlotLayout));
    semantic_vector_init(&plan.global_initializers, @size_of(MirC99GlobalInitializerPlanEntry));
    semantic_vector_init(&plan.link_inputs, @size_of(MirC99LinkInputPlanEntry));
    semantic_vector_init(&plan.unit_assignments, @size_of(MirC99UnitAssignment));
    semantic_vector_init(&plan.units, @size_of(MirC99Unit));
    return 0;
}

/// 功能说明：释放 MIR-C99 输出计划及所有 unit 动态表。
/// 参数说明：`plan` 为待释放计划；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_plan_release(plan: &MirC99Plan) void {
    if plan == null {
        return;
    }
    var i: usize = 0usize;
    while i < plan.units.count {
        const unit: &MirC99Unit = semantic_vector_item_ptr(&plan.units, i) as &MirC99Unit;
        mir_c99_unit_release(unit);
        i = i + 1usize;
    }
    semantic_vector_release(&plan.includes);
    semantic_vector_release(&plan.typedefs);
    semantic_vector_release(&plan.prototypes);
    semantic_vector_release(&plan.globals);
    semantic_vector_release(&plan.functions);
    semantic_vector_release(&plan.helpers);
    semantic_vector_release(&plan.deps);
    semantic_vector_release(&plan.async_frame_layout_refs);
    semantic_vector_release(&plan.async_frame_slot_refs);
    semantic_vector_release(&plan.async_frame_layouts);
    semantic_vector_release(&plan.async_frame_slots);
    semantic_vector_release(&plan.global_initializers);
    semantic_vector_release(&plan.link_inputs);
    semantic_vector_release(&plan.unit_assignments);
    semantic_vector_release(&plan.units);
    plan.lifecycle_state = MIR_C99_PLAN_LIFECYCLE_RELEASED;
    plan.unit_count = 0usize;
    plan.estimated_bytes = 0usize;
    plan.resident_peak_bytes = 0usize;
}

/// 功能说明：向 MIR-C99 plan 的 program 级 ref 表追加稳定引用。
/// 参数说明：`plan` 为目标计划，`kind` 为 `MIR_C99_REF_KIND_*`，`source_id`/`aux_id`/`flags` 为引用元数据。
/// 返回值说明：成功返回 `0`，未知 kind 或追加失败返回 `-1`。
export fn mir_c99_plan_append_ref(plan: &MirC99Plan, kind: i32, source_id: i32, aux_id: i32, flags: i32) i32 {
    if plan == null || plan.lifecycle_state != MIR_C99_PLAN_LIFECYCLE_ACTIVE {
        return -1;
    }
    if kind == MIR_C99_REF_KIND_INCLUDE {
        return mir_c99_vec_append_ref(&plan.includes, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_TYPEDEF {
        return mir_c99_vec_append_ref(&plan.typedefs, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_PROTOTYPE {
        return mir_c99_vec_append_ref(&plan.prototypes, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_GLOBAL {
        return mir_c99_vec_append_ref(&plan.globals, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_FUNCTION {
        return mir_c99_vec_append_ref(&plan.functions, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_HELPER {
        return mir_c99_vec_append_ref(&plan.helpers, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_DEP {
        return mir_c99_vec_append_ref(&plan.deps, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_ASYNC_FRAME_LAYOUT {
        return mir_c99_vec_append_ref(&plan.async_frame_layout_refs, kind, source_id, aux_id, flags);
    }
    if kind == MIR_C99_REF_KIND_ASYNC_FRAME_SLOT {
        return mir_c99_vec_append_ref(&plan.async_frame_slot_refs, kind, source_id, aux_id, flags);
    }
    return -1;
}

fn mir_c99_plan_debug_loc_source_file_id(module: &PortableMirModule,
    debug_loc_id: MirDebugLocId) FileId {
    const index: i32 = debug_loc_id as i32;
    if module == null || index < 0 || (index as usize) >= module.debug_locs.count {
        return -1 as FileId;
    }
    const loc: &MirDebugLoc =
        semantic_vector_item_ptr(&module.debug_locs, index as usize) as &MirDebugLoc;
    if loc == null {
        return -1 as FileId;
    }
    return loc.file_id;
}

fn mir_c99_plan_find_cross_unit_for_function(module: &PortableMirModule,
    function: &MirFunction) &MirCrossUnitSymbol {
    if module == null || function == null {
        return null;
    }
    var i: usize = 0usize;
    while i < module.cross_unit_symbols.count {
        const symbol: &MirCrossUnitSymbol =
            semantic_vector_item_ptr(&module.cross_unit_symbols, i) as &MirCrossUnitSymbol;
        if symbol != null &&
           symbol.owner_kind == MIR_CROSS_UNIT_OWNER_FUNCTION &&
           symbol.owner_function_id == function.function_id &&
           symbol.target_profile_id == module.target_profile.profile_id &&
           symbol.unit_id >= 0 {
            return symbol;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_plan_find_cross_unit_for_global(module: &PortableMirModule,
    global: &MirGlobal) &MirCrossUnitSymbol {
    if module == null || global == null {
        return null;
    }
    var i: usize = 0usize;
    while i < module.cross_unit_symbols.count {
        const symbol: &MirCrossUnitSymbol =
            semantic_vector_item_ptr(&module.cross_unit_symbols, i) as &MirCrossUnitSymbol;
        if symbol != null &&
           symbol.owner_kind == MIR_CROSS_UNIT_OWNER_GLOBAL &&
           symbol.owner_global_id == global.global_id &&
           symbol.target_profile_id == module.target_profile.profile_id &&
           symbol.unit_id >= 0 {
            return symbol;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_plan_find_unit(plan: &MirC99Plan, kind: i32,
    source_file_id: i32, function_group_id: i32) &MirC99Unit {
    if plan == null {
        return null;
    }
    var i: usize = 0usize;
    while i < plan.units.count {
        const unit: &MirC99Unit =
            semantic_vector_item_ptr(&plan.units, i) as &MirC99Unit;
        if unit != null && unit.kind == kind &&
           (unit.source_file_id as i32) == source_file_id &&
           unit.function_group_id == function_group_id {
            return unit;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_plan_add_assignment_unit(plan: &MirC99Plan, kind: i32,
    source_file_id: i32, function_group_id: i32) &MirC99Unit {
    if plan == null {
        return null;
    }
    const existing: &MirC99Unit =
        mir_c99_plan_find_unit(plan, kind, source_file_id, function_group_id);
    if existing != null {
        return existing;
    }
    const unit_id: i32 = mir_c99_plan_add_unit(plan, kind);
    if unit_id < 0 {
        return null;
    }
    const unit: &MirC99Unit = mir_c99_plan_unit_ptr(plan, unit_id);
    if unit == null {
        return null;
    }
    unit.source_file_id = source_file_id as FileId;
    unit.function_group_id = function_group_id;
    if mir_c99_unit_refresh_fingerprint(unit) != 0 {
        return null;
    }
    return unit;
}

fn mir_c99_plan_append_unit_assignment(plan: &MirC99Plan, function: &MirFunction,
    unit: &MirC99Unit, source_file_id: i32,
    cross_unit_symbol_id: MirCrossUnitSymbolId, function_group_id: i32) i32 {
    if plan == null || function == null || unit == null {
        return -1;
    }
    const assignment: MirC99UnitAssignment = MirC99UnitAssignment{
        assignment_id: plan.unit_assignments.count as i32,
        function_id: function.function_id,
        unit_id: unit.unit_id,
        source_file_id: source_file_id as FileId,
        cross_unit_symbol_id: cross_unit_symbol_id,
        function_group_id: function_group_id,
        flags: function.flags,
    };
    if semantic_vector_append(&plan.unit_assignments, &assignment as &const void) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_plan_assign_function_unit(module: &PortableMirModule,
    plan: &MirC99Plan, fallback_unit: &MirC99Unit, function: &MirFunction) i32 {
    if module == null || plan == null || fallback_unit == null || function == null {
        return -1;
    }
    const cross_symbol: &MirCrossUnitSymbol =
        mir_c99_plan_find_cross_unit_for_function(module, function);
    var source_file_id: i32 =
        mir_c99_plan_debug_loc_source_file_id(module, function.debug_loc_id) as i32;
    var cross_unit_symbol_id: MirCrossUnitSymbolId = MIR_CROSS_UNIT_SYMBOL_INVALID_ID;
    var unit_kind: i32 = MIR_C99_UNIT_KIND_SOURCE;
    var function_group_id: i32 = -1;
    if cross_symbol != null {
        unit_kind = MIR_C99_UNIT_KIND_MODULE;
        function_group_id = cross_symbol.unit_id;
        cross_unit_symbol_id = cross_symbol.cross_unit_symbol_id;
    } else if source_file_id >= 0 {
        function_group_id = source_file_id;
    } else {
        unit_kind = MIR_C99_UNIT_KIND_FUNCTION_GROUP;
        source_file_id = fallback_unit.source_file_id as i32;
        function_group_id = function.function_id;
    }
    const unit: &MirC99Unit =
        mir_c99_plan_add_assignment_unit(plan, unit_kind, source_file_id,
            function_group_id);
    if unit == null {
        return -1;
    }
    return mir_c99_plan_append_unit_assignment(plan, function, unit,
        source_file_id, cross_unit_symbol_id, function_group_id);
}

/// 功能说明：为 MIR-C99 split-C 建立 function 到 unit 的动态 assignment 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出计划，`fallback_unit` 为无 source metadata 时的稳定 fallback。
/// 返回值说明：全部 function 分配成功返回 `0`，参数非法或动态表追加失败返回 `-1`。
export fn mir_c99_plan_prepare_function_units(module: &PortableMirModule,
    plan: &MirC99Plan, fallback_unit: &MirC99Unit) i32 {
    if module == null || plan == null || fallback_unit == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.functions.count {
        const function: &MirFunction =
            semantic_vector_item_ptr(&module.functions, i) as &MirFunction;
        if function == null ||
           mir_c99_plan_assign_function_unit(module, plan, fallback_unit,
               function) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：查询 MIR function 已分配的 MIR-C99 unit。
/// 参数说明：`plan` 为输出计划，`function` 为待输出 MIR function。
/// 返回值说明：找到 assignment 时返回 unit 指针，否则返回 null。
export fn mir_c99_plan_unit_for_function(plan: &MirC99Plan,
    function: &MirFunction) &MirC99Unit {
    if plan == null || function == null {
        return null;
    }
    var i: usize = 0usize;
    while i < plan.unit_assignments.count {
        const assignment: &MirC99UnitAssignment =
            semantic_vector_item_ptr(&plan.unit_assignments, i) as &MirC99UnitAssignment;
        if assignment != null && assignment.function_id == function.function_id {
            return mir_c99_plan_unit_ptr(plan, assignment.unit_id);
        }
        i = i + 1usize;
    }
    return null;
}

/// 功能说明：按 MIR function id 查询已分配的 MIR-C99 unit。
/// 参数说明：`plan` 为输出计划，`function_id` 为 PortableMIR function id，`fallback_unit` 为未分配时的回退 unit。
/// 返回值说明：找到 assignment 时返回目标 unit，否则返回 `fallback_unit`；参数非法返回 null。
export fn mir_c99_plan_unit_for_function_id(plan: &MirC99Plan,
    function_id: MirFunctionId, fallback_unit: &MirC99Unit) &MirC99Unit {
    if plan == null || function_id == MIR_FUNCTION_INVALID_ID {
        return null;
    }
    var i: usize = 0usize;
    while i < plan.unit_assignments.count {
        const assignment: &MirC99UnitAssignment =
            semantic_vector_item_ptr(&plan.unit_assignments, i) as &MirC99UnitAssignment;
        if assignment != null && assignment.function_id == function_id {
            const unit: &MirC99Unit =
                mir_c99_plan_unit_ptr(plan, assignment.unit_id);
            if unit != null {
                return unit;
            }
        }
        i = i + 1usize;
    }
    return fallback_unit;
}

/// 功能说明：为 MIR global 选择 MIR-C99 unit。
/// 参数说明：`plan` 为输出计划，`module`/`global` 提供 cross-unit 和 source metadata，`fallback_unit` 为无 metadata 时的回退 unit。
/// 返回值说明：返回可追加 global ref 的 unit；追加动态 unit 失败时返回 null。
export fn mir_c99_plan_unit_for_global(plan: &MirC99Plan,
    module: &PortableMirModule, global: &MirGlobal,
    fallback_unit: &MirC99Unit) &MirC99Unit {
    if plan == null || module == null || global == null || fallback_unit == null {
        return null;
    }
    const cross_symbol: &MirCrossUnitSymbol =
        mir_c99_plan_find_cross_unit_for_global(module, global);
    var source_file_id: i32 =
        mir_c99_plan_debug_loc_source_file_id(module, global.debug_loc_id) as i32;
    var unit_kind: i32 = MIR_C99_UNIT_KIND_SOURCE;
    var function_group_id: i32 = -1;
    if cross_symbol != null {
        unit_kind = MIR_C99_UNIT_KIND_MODULE;
        function_group_id = cross_symbol.unit_id;
    } else if source_file_id >= 0 {
        function_group_id = source_file_id;
    } else {
        return fallback_unit;
    }
    const unit: &MirC99Unit =
        mir_c99_plan_add_assignment_unit(plan, unit_kind, source_file_id,
            function_group_id);
    if unit == null {
        return null;
    }
    return unit;
}

fn mir_c99_link_input_kind_is_supported(kind: i32) i32 {
    if kind == MIR_LINK_INPUT_KIND_C_IMPORT_OBJECT ||
       kind == MIR_LINK_INPUT_KIND_OBJECT_FILE ||
       kind == MIR_LINK_INPUT_KIND_LIBRARY ||
       kind == MIR_LINK_INPUT_KIND_SEARCH_PATH {
        return 1;
    }
    return 0;
}

fn mir_c99_link_input_metadata_valid(module: &PortableMirModule,
    input: &MirLinkInput) i32 {
    if module == null || input == null ||
       mir_c99_link_input_kind_is_supported(input.kind) == 0 ||
       input.target_profile_id != module.target_profile.profile_id ||
       input.path_dedupe_id < 0 {
        return 0;
    }
    if (input.kind == MIR_LINK_INPUT_KIND_LIBRARY ||
        input.kind == MIR_LINK_INPUT_KIND_SEARCH_PATH) &&
       input.name_dedupe_id < 0 {
        return 0;
    }
    return 1;
}

/// 功能说明：读取 MIR-C99 link input plan 条目。
/// 参数说明：`plan` 为输出计划，`index` 为 `link_inputs` 动态表下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_link_input_plan_ptr(plan: &MirC99Plan,
    index: i32) &MirC99LinkInputPlanEntry {
    if plan == null || index < 0 || (index as usize) >= plan.link_inputs.count {
        return null;
    }
    return semantic_vector_item_ptr(&plan.link_inputs,
        index as usize) as &MirC99LinkInputPlanEntry;
}

/// 功能说明：向 MIR-C99 plan 追加一个 PortableMIR link input 条目。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出计划，`input` 为 PortableMIR link input。
/// 返回值说明：成功返回 plan 条目下标；metadata 不一致或追加失败返回 `-1`。
export fn mir_c99_link_input_plan_append(module: &PortableMirModule,
    plan: &MirC99Plan, input: &MirLinkInput) i32 {
    if module == null || plan == null || input == null ||
       mir_c99_link_input_metadata_valid(module, input) == 0 {
        return -1;
    }
    const entry_id: i32 = plan.link_inputs.count as i32;
    const entry: MirC99LinkInputPlanEntry = MirC99LinkInputPlanEntry{
        link_input_id: input.link_input_id,
        kind: input.kind,
        target_profile_id: input.target_profile_id,
        c_import_id: input.c_import_id,
        symbol_id: input.symbol_id,
        path_dedupe_id: input.path_dedupe_id,
        name_dedupe_id: input.name_dedupe_id,
        capability_req_id: input.capability_req_id,
        debug_loc_id: input.debug_loc_id,
        flags: input.flags,
        status: MIR_C99_LINK_INPUT_STATUS_READY,
    };
    if semantic_vector_append(&plan.link_inputs, &entry as &const void) != 0 {
        return -1;
    }
    if mir_c99_plan_append_ref(plan, MIR_C99_REF_KIND_DEP,
           input.link_input_id, entry_id, input.kind) != 0 {
        return -1;
    }
    return entry_id;
}

/// 功能说明：从 PortableMIR link input table 构建 MIR-C99 host link 输入计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出计划。
/// 返回值说明：成功返回 `0`；遇到未知 kind、metadata 不一致或追加失败返回 `-1`。
export fn mir_c99_link_input_plan_build(module: &PortableMirModule,
    plan: &MirC99Plan) i32 {
    if module == null || plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.link_inputs.count {
        const input: &MirLinkInput =
            semantic_vector_item_ptr(&module.link_inputs, i) as &MirLinkInput;
        if input == null ||
           mir_c99_link_input_plan_append(module, plan, input) < 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

fn mir_c99_global_initializer_const_ptr(module: &PortableMirModule,
    const_id: MirConstId) &MirConst {
    const index: i32 = const_id as i32;
    if module == null || index < 0 || (index as usize) >= module.consts.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.consts, index as usize) as &MirConst;
}

fn mir_c99_global_initializer_is_supported(kind: i32) i32 {
    if kind == MIR_GLOBAL_INIT_SCALAR || kind == MIR_GLOBAL_INIT_AGGREGATE ||
       kind == MIR_GLOBAL_INIT_STRING || kind == MIR_GLOBAL_INIT_EXTERN {
        return 1;
    }
    return 0;
}

fn mir_c99_global_initializer_const_matches(const_kind: i32, init_kind: i32) i32 {
    if init_kind == MIR_GLOBAL_INIT_SCALAR && const_kind == MIR_CONST_KIND_SCALAR {
        return 1;
    }
    if init_kind == MIR_GLOBAL_INIT_AGGREGATE && const_kind == MIR_CONST_KIND_AGGREGATE {
        return 1;
    }
    if init_kind == MIR_GLOBAL_INIT_STRING && const_kind == MIR_CONST_KIND_STRING {
        return 1;
    }
    return 0;
}

fn mir_c99_global_initializer_extern_metadata_valid(global: &MirGlobal) i32 {
    if global == null {
        return 0;
    }
    if global.init_kind != MIR_GLOBAL_INIT_EXTERN {
        return 1;
    }
    if global.init_const_id == MIR_CONST_INVALID_ID &&
       global.linkage == MIR_GLOBAL_LINKAGE_EXTERN {
        return 1;
    }
    return 0;
}

/// 功能说明：读取 MIR-C99 global initializer plan 条目。
/// 参数说明：`plan` 为输出计划，`index` 为 `global_initializers` 动态表下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_global_initializer_plan_ptr(plan: &MirC99Plan,
    index: i32) &MirC99GlobalInitializerPlanEntry {
    if plan == null || index < 0 || (index as usize) >= plan.global_initializers.count {
        return null;
    }
    return semantic_vector_item_ptr(&plan.global_initializers,
        index as usize) as &MirC99GlobalInitializerPlanEntry;
}

fn mir_c99_global_initializer_string_metadata_valid(global: &MirGlobal,
    init_const: &MirConst) i32 {
    if global == null || init_const == null {
        return 0;
    }
    if global.init_kind != MIR_GLOBAL_INIT_STRING {
        return 1;
    }
    if global.dedupe_id < 0 || init_const.dedupe_id < 0 || init_const.byte_count == 0usize {
        return 0;
    }
    return 1;
}

/// 功能说明：向 MIR-C99 plan 追加一个 global scalar/aggregate/string initializer 或 extern global 条目。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan`/`unit` 为输出计划，`global` 为 PortableMIR global。
/// 返回值说明：成功返回 plan 条目下标；不支持或 metadata 不一致返回 `-1`。
export fn mir_c99_global_initializer_plan_append(module: &PortableMirModule,
    plan: &MirC99Plan, unit: &MirC99Unit, global: &MirGlobal) i32 {
    if module == null || plan == null || unit == null || global == null ||
       mir_c99_global_initializer_is_supported(global.init_kind) == 0 {
        return -1;
    }
    if global.init_kind == MIR_GLOBAL_INIT_EXTERN {
        if mir_c99_global_initializer_extern_metadata_valid(global) == 0 {
            return -1;
        }
        const extern_entry_id: i32 = plan.global_initializers.count as i32;
        const extern_entry: MirC99GlobalInitializerPlanEntry = MirC99GlobalInitializerPlanEntry{
            global_id: global.global_id,
            type_id: global.type_id,
            const_id: MIR_CONST_INVALID_ID,
            init_kind: global.init_kind,
            const_kind: 0,
            section: global.section,
            linkage: global.linkage,
            visibility: global.visibility,
            alignment: global.alignment,
            dedupe_id: global.dedupe_id,
            byte_offset: 0usize,
            byte_count: 0usize,
            scalar_i64: 0i64,
            flags: global.flags,
            status: MIR_C99_GLOBAL_INIT_STATUS_READY,
        };
        if semantic_vector_append(&plan.global_initializers, &extern_entry as &const void) != 0 {
            return -1;
        }
        if mir_c99_plan_append_ref(plan, MIR_C99_REF_KIND_GLOBAL,
               global.global_id, extern_entry_id, global.init_kind) != 0 ||
           mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_GLOBAL,
               global.global_id, extern_entry_id, global.init_kind) != 0 {
            return -1;
        }
        return extern_entry_id;
    }
    const init_const: &MirConst =
        mir_c99_global_initializer_const_ptr(module, global.init_const_id);
    if init_const == null || init_const.type_id != global.type_id ||
       mir_c99_global_initializer_const_matches(init_const.kind, global.init_kind) == 0 ||
       mir_c99_global_initializer_string_metadata_valid(global, init_const) == 0 {
        return -1;
    }
    const entry_id: i32 = plan.global_initializers.count as i32;
    const entry: MirC99GlobalInitializerPlanEntry = MirC99GlobalInitializerPlanEntry{
        global_id: global.global_id,
        type_id: global.type_id,
        const_id: global.init_const_id,
        init_kind: global.init_kind,
        const_kind: init_const.kind,
        section: global.section,
        linkage: global.linkage,
        visibility: global.visibility,
        alignment: global.alignment,
        dedupe_id: init_const.dedupe_id,
        byte_offset: init_const.byte_offset,
        byte_count: init_const.byte_count,
        scalar_i64: init_const.scalar_i64,
        flags: global.flags | init_const.flags,
        status: MIR_C99_GLOBAL_INIT_STATUS_READY,
    };
    if semantic_vector_append(&plan.global_initializers, &entry as &const void) != 0 {
        return -1;
    }
    if mir_c99_plan_append_ref(plan, MIR_C99_REF_KIND_GLOBAL,
           global.global_id, entry_id, global.init_kind) != 0 ||
       mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_GLOBAL,
           global.global_id, entry_id, global.init_kind) != 0 {
        return -1;
    }
    return entry_id;
}

/// 功能说明：从 PortableMIR global table 构建 MIR-C99 scalar/aggregate/string initializer 和 extern global 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出计划，`fallback_unit` 为无 unit metadata 时的回退 unit。
/// 返回值说明：成功返回 `0`；遇到支持范围内 metadata 不一致或追加失败返回 `-1`。
export fn mir_c99_global_initializer_plan_build(module: &PortableMirModule,
    plan: &MirC99Plan, fallback_unit: &MirC99Unit) i32 {
    if module == null || plan == null || fallback_unit == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.globals.count {
        const global: &MirGlobal =
            semantic_vector_item_ptr(&module.globals, i) as &MirGlobal;
        if global != null &&
           mir_c99_global_initializer_is_supported(global.init_kind) != 0 {
            const unit: &MirC99Unit =
                mir_c99_plan_unit_for_global(plan, module, global, fallback_unit);
            if unit == null ||
               mir_c99_global_initializer_plan_append(module, plan, unit,
                   global) < 0 {
                status = -1;
            }
        }
        i = i + 1usize;
    }
    return status;
}

fn mir_c99_async_frame_layout_is_slot_kind(slot_kind: i32) i32 {
    if slot_kind == MIR_ASYNC_FRAME_SLOT_STATE_TAG ||
       slot_kind == MIR_ASYNC_FRAME_SLOT_RESULT ||
       slot_kind == MIR_ASYNC_FRAME_SLOT_AWAIT_CHILD ||
       slot_kind == MIR_ASYNC_FRAME_SLOT_CAPTURED_LOCAL {
        return 1;
    }
    return 0;
}

/// 功能说明：读取 PortableMIR async frame metadata 指针。
/// 参数说明：`module` 为 verifier-clean MIR module，`index` 为 metadata 动态表下标。
/// 返回值说明：成功返回 `MirAsyncFrameMeta` 指针，参数非法返回 null。
export fn mir_c99_async_frame_layout_plan_meta_ptr(module: &PortableMirModule,
    index: usize) &MirAsyncFrameMeta {
    if module == null || index >= module.async_frame_metas.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.async_frame_metas, index) as &MirAsyncFrameMeta;
}

fn mir_c99_async_frame_layout_plan_find(plan: &MirC99Plan,
    function_id: MirFunctionId, frame_type_id: MirTypeId) i32 {
    if plan == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < plan.async_frame_layouts.count {
        const layout: &MirC99AsyncFrameLayout =
            semantic_vector_item_ptr(&plan.async_frame_layouts, i) as &MirC99AsyncFrameLayout;
        if layout != null && layout.function_id == function_id &&
           layout.frame_type_id == frame_type_id {
            return i as i32;
        }
        i = i + 1usize;
    }
    return -1;
}

fn mir_c99_async_frame_layout_plan_new(plan: &MirC99Plan, unit: &MirC99Unit,
    meta: &MirAsyncFrameMeta) i32 {
    if plan == null || unit == null || meta == null {
        return -1;
    }
    const layout_id: i32 = plan.async_frame_layouts.count as i32;
    const layout: MirC99AsyncFrameLayout = MirC99AsyncFrameLayout{
        function_id: meta.function_id,
        frame_type_id: meta.frame_type_id,
        slot_start: plan.async_frame_slots.count,
        slot_count: 0usize,
        state_tag_slot_count: 0usize,
        result_slot_count: 0usize,
        await_child_slot_count: 0usize,
        captured_local_slot_count: 0usize,
        flags: meta.flags,
    };
    if semantic_vector_append(&plan.async_frame_layouts, &layout as &const void) != 0 {
        return -1;
    }
    if mir_c99_plan_append_ref(plan, MIR_C99_REF_KIND_ASYNC_FRAME_LAYOUT,
           meta.function_id, layout_id, meta.flags) != 0 ||
       mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_ASYNC_FRAME_LAYOUT,
           meta.function_id, layout_id, meta.flags) != 0 {
        return -1;
    }
    return layout_id;
}

/// 功能说明：向 MIR-C99 async frame layout 追加一个 concrete slot。
/// 参数说明：`plan`/`unit` 为输出计划，`layout_id` 为所属 layout，`meta` 为 PortableMIR slot metadata。
/// 返回值说明：成功返回 `0`，参数非法、未知 slot kind 或追加失败返回 `-1`。
export fn mir_c99_async_frame_layout_plan_append_slot(plan: &MirC99Plan,
    unit: &MirC99Unit, layout_id: i32, meta: &MirAsyncFrameMeta) i32 {
    if plan == null || unit == null || meta == null || layout_id < 0 ||
       (layout_id as usize) >= plan.async_frame_layouts.count ||
       mir_c99_async_frame_layout_is_slot_kind(meta.slot_kind) == 0 {
        return -1;
    }
    const slot: MirC99AsyncFrameSlotLayout = MirC99AsyncFrameSlotLayout{
        slot_meta_id: meta.async_frame_meta_id,
        function_id: meta.function_id,
        frame_type_id: meta.frame_type_id,
        slot_kind: meta.slot_kind,
        slot_index: meta.slot_index,
        slot_type_id: meta.slot_type_id,
        captured_local_id: meta.captured_local_id,
        state_tag: meta.state_tag,
        flags: meta.flags,
    };
    if semantic_vector_append(&plan.async_frame_slots, &slot as &const void) != 0 {
        return -1;
    }
    const layout: &MirC99AsyncFrameLayout =
        semantic_vector_item_ptr(&plan.async_frame_layouts, layout_id as usize) as &MirC99AsyncFrameLayout;
    if layout == null {
        return -1;
    }
    layout.slot_count = layout.slot_count + 1usize;
    if meta.slot_kind == MIR_ASYNC_FRAME_SLOT_STATE_TAG {
        layout.state_tag_slot_count = layout.state_tag_slot_count + 1usize;
    } else if meta.slot_kind == MIR_ASYNC_FRAME_SLOT_RESULT {
        layout.result_slot_count = layout.result_slot_count + 1usize;
    } else if meta.slot_kind == MIR_ASYNC_FRAME_SLOT_AWAIT_CHILD {
        layout.await_child_slot_count = layout.await_child_slot_count + 1usize;
    } else if meta.slot_kind == MIR_ASYNC_FRAME_SLOT_CAPTURED_LOCAL {
        layout.captured_local_slot_count = layout.captured_local_slot_count + 1usize;
    }
    if mir_c99_plan_append_ref(plan, MIR_C99_REF_KIND_ASYNC_FRAME_SLOT,
           meta.async_frame_meta_id, meta.slot_index, meta.slot_kind) != 0 ||
       mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_ASYNC_FRAME_SLOT,
           meta.async_frame_meta_id, meta.slot_index, meta.slot_kind) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：从 PortableMIR async frame metadata 构建 MIR-C99 frame struct layout 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出计划，`fallback_unit` 为无 function assignment 时的回退 unit。
/// 返回值说明：成功返回 `0`；参数非法、未知 slot kind 或动态表追加失败返回 `-1`。
export fn mir_c99_async_frame_layout_plan_build(module: &PortableMirModule,
    plan: &MirC99Plan, fallback_unit: &MirC99Unit) i32 {
    if module == null || plan == null || fallback_unit == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.async_frame_metas.count {
        const meta: &MirAsyncFrameMeta =
            mir_c99_async_frame_layout_plan_meta_ptr(module, i);
        if meta == null || mir_c99_async_frame_layout_is_slot_kind(meta.slot_kind) == 0 {
            status = -1;
        } else {
            const unit: &MirC99Unit =
                mir_c99_plan_unit_for_function_id(plan, meta.function_id, fallback_unit);
            var layout_id: i32 = mir_c99_async_frame_layout_plan_find(plan,
                meta.function_id, meta.frame_type_id);
            if unit == null {
                status = -1;
            } else if layout_id < 0 {
                layout_id = mir_c99_async_frame_layout_plan_new(plan, unit, meta);
            }
            if unit == null || layout_id < 0 ||
               mir_c99_async_frame_layout_plan_append_slot(plan, unit,
                   layout_id, meta) != 0 {
                status = -1;
            }
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：向 MIR-C99 plan 追加一个 unit。
/// 参数说明：`plan` 为目标计划，`kind` 为 `MIR_C99_UNIT_KIND_*`。
/// 返回值说明：成功返回新 unit id，失败返回 `-1`。
export fn mir_c99_plan_add_unit(plan: &MirC99Plan, kind: i32) i32 {
    if plan == null || plan.lifecycle_state != MIR_C99_PLAN_LIFECYCLE_ACTIVE {
        return -1;
    }
    const unit_id: i32 = plan.units.count as i32;
    var unit: MirC99Unit = mir_c99_unit_empty();
    if mir_c99_unit_init(&unit, unit_id, kind) != 0 {
        return -1;
    }
    if semantic_vector_append(&plan.units, &unit as &const void) != 0 {
        mir_c99_unit_release(&unit);
        return -1;
    }
    plan.unit_count = plan.units.count;
    const stored: &MirC99Unit = mir_c99_plan_unit_ptr(plan, unit_id);
    if mir_c99_unit_refresh_fingerprint(stored) != 0 {
        return -1;
    }
    return unit_id;
}

/// 功能说明：获取 MIR-C99 plan 中的 unit 指针。
/// 参数说明：`plan` 为目标计划，`unit_id` 为稳定 unit 下标。
/// 返回值说明：成功返回 unit 指针，参数非法返回 null。
export fn mir_c99_plan_unit_ptr(plan: &MirC99Plan, unit_id: i32) &MirC99Unit {
    if plan == null || unit_id < 0 || (unit_id as usize) >= plan.units.count {
        return null;
    }
    return semantic_vector_item_ptr(&plan.units, unit_id as usize) as &MirC99Unit;
}

/// 功能说明：统计 MIR-C99 plan 的动态表占用。
/// 参数说明：`plan` 为待统计计划。
/// 返回值说明：返回动态表数量、元素数、容量、字节数和扩容次数；参数非法时返回全零。
export fn mir_c99_plan_stats(plan: &MirC99Plan) MirC99PlanStats {
    var stats: MirC99PlanStats = MirC99PlanStats{
        table_count: 0,
        table_items: 0usize,
        table_capacity: 0usize,
        table_bytes: 0usize,
        table_realloc_count: 0,
    };
    if plan == null {
        return stats;
    }
    mir_c99_stats_add_vector(&stats, &plan.includes);
    mir_c99_stats_add_vector(&stats, &plan.typedefs);
    mir_c99_stats_add_vector(&stats, &plan.prototypes);
    mir_c99_stats_add_vector(&stats, &plan.globals);
    mir_c99_stats_add_vector(&stats, &plan.functions);
    mir_c99_stats_add_vector(&stats, &plan.helpers);
    mir_c99_stats_add_vector(&stats, &plan.deps);
    mir_c99_stats_add_vector(&stats, &plan.async_frame_layout_refs);
    mir_c99_stats_add_vector(&stats, &plan.async_frame_slot_refs);
    mir_c99_stats_add_vector(&stats, &plan.async_frame_layouts);
    mir_c99_stats_add_vector(&stats, &plan.async_frame_slots);
    mir_c99_stats_add_vector(&stats, &plan.global_initializers);
    mir_c99_stats_add_vector(&stats, &plan.link_inputs);
    mir_c99_stats_add_vector(&stats, &plan.unit_assignments);
    mir_c99_stats_add_vector(&stats, &plan.units);
    var i: usize = 0usize;
    while i < plan.units.count {
        const unit: &MirC99Unit = semantic_vector_item_ptr(&plan.units, i) as &MirC99Unit;
        mir_c99_stats_add_vector(&stats, &unit.includes);
        mir_c99_stats_add_vector(&stats, &unit.typedefs);
        mir_c99_stats_add_vector(&stats, &unit.prototypes);
        mir_c99_stats_add_vector(&stats, &unit.globals);
        mir_c99_stats_add_vector(&stats, &unit.functions);
        mir_c99_stats_add_vector(&stats, &unit.helpers);
        mir_c99_stats_add_vector(&stats, &unit.deps);
        mir_c99_stats_add_vector(&stats, &unit.async_frame_layouts);
        mir_c99_stats_add_vector(&stats, &unit.async_frame_slots);
        i = i + 1usize;
    }
    return stats;
}
