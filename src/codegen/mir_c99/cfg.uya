    while i < module.terminators.count {
        const term: &MirTerminator =
            semantic_vector_item_ptr(&module.terminators, i) as &MirTerminator;
        if mir_c99_cfg_plan_append_error_union_return(cfg_plan, module, term) != 0 {
            status = -1;
