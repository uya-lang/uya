/// 返回值说明：非相关 instruction 返回 `0`；映射成功返回 `0`，不支持返回 `-1`。
export fn mir_c99_cfg_plan_append_async_cleanup_release(cfg_plan: &MirC99CfgPlan,
    module: &PortableMirModule, inst: &MirInst) i32 {
