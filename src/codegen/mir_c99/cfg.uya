// codegen/mir_c99/cfg.uya - MIR CFG to MIR-C99 function/block plan.

use codegen.mir_c99.plan;
use libc.FILE;
use libc.fputc;
use libc.fputs;

export const MIR_C99_CFG_FUNCTION_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_FUNCTION_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_BLOCK_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_BLOCK_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_TERMINATOR_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_TERMINATOR_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_DROP_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_DROP_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_ERROR_UNION_RETURN_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_ERROR_UNION_RETURN_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_ASYNC_STATE_EDGE_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_ASYNC_STATE_EDGE_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_ASYNC_AWAIT_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_ASYNC_AWAIT_STATUS_REJECT: i32 = 2;
export const MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_STATUS_PLANNED: i32 = 1;
export const MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_STATUS_REJECT: i32 = 2;

export const MIR_C99_CFG_FUNCTION_FLAG_CLEANUP_ERROR: i32 = 1;
export const MIR_C99_CFG_BLOCK_FLAG_CLEANUP: i32 = 1;
export const MIR_C99_CFG_TERMINATOR_FLAG_ERROR_CFG: i32 = 1;
export const MIR_C99_CFG_DROP_FLAG_CLEANUP_EDGE: i32 = 1;
export const MIR_C99_CFG_ERROR_UNION_RETURN_FLAG_CHECKED: i32 = 1;
export const MIR_C99_CFG_ASYNC_STATE_EDGE_FLAG_POLL: i32 = 1;
export const MIR_C99_CFG_ASYNC_STATE_EDGE_FLAG_RESUME: i32 = 2;
export const MIR_C99_CFG_ASYNC_AWAIT_FLAG_STATE: i32 = 1;
export const MIR_C99_CFG_ASYNC_AWAIT_FLAG_CHILD: i32 = 2;
export const MIR_C99_CFG_ASYNC_AWAIT_FLAG_RESULT: i32 = 4;
export const MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_DROP: i32 = 1;
export const MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_ERROR_UNION: i32 = 2;
export const MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_FRAME_RELEASE: i32 = 4;
export const MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_RESULT: i32 = 8;

/// 功能说明：记录一个 MIR function 到 C function 的稳定映射。
/// 参数说明：无；字段只保存 MIR function/block range 和 MIR-C99 unit/name 信息。
/// 返回值说明：无；具体 block/terminator 输出由后续 CFG leaf 填充。
export struct MirC99FunctionPlanEntry {
    function_id: MirFunctionId,
    unit_id: i32,
    c_name_source_id: i32,
    signature_type_id: MirTypeId,
    block_start: i32,
    block_count: i32,
    entry_block_id: MirBlockId,
    status: i32,
    flags: i32,
}

/// 功能说明：记录一个 MIR block 到 C label 的稳定映射。
/// 参数说明：无；字段保存 block 所属 function、instruction range、terminator 和 C label source id。
/// 返回值说明：无。
export struct MirC99BlockPlanEntry {
    block_id: MirBlockId,
    function_id: MirFunctionId,
    c_label_source_id: i32,
    inst_start: i32,
    inst_count: i32,
    terminator_id: MirTerminatorId,
    status: i32,
    flags: i32,
}

/// 功能说明：记录一个 MIR terminator 到低级 C99 控制流语句的稳定映射。
/// 参数说明：无；字段保存 terminator kind 和 BR 目标 block。
/// 返回值说明：无。
export struct MirC99TerminatorPlanEntry {
    terminator_id: MirTerminatorId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    kind: i32,
    operand_start: i32,
    operand_count: i32,
    successor_start: i32,
    successor_count: i32,
    branch_target_block_id: MirBlockId,
    condition_value_id: MirValueId,
    true_target_block_id: MirBlockId,
    false_target_block_id: MirBlockId,
    return_value_id: MirValueId,
    status: i32,
    flags: i32,
}

/// 功能说明：记录一个 MIR cleanup/drop instruction 到低级 C99 cleanup edge 输出的稳定映射。
/// 参数说明：无；字段来自 MIR cleanup block、drop opcode、operand 和 cleanup action metadata。
/// 返回值说明：无。
export struct MirC99CleanupDropPlanEntry {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    op: i32,
    cleanup_action: i32,
    dropped_value_id: MirValueId,
    operand_start: i32,
    operand_count: i32,
    status: i32,
    flags: i32,
}

/// 功能说明：记录一个 MIR error-union return 到 success/fallback C99 return path 的稳定映射。
/// 参数说明：无；字段来自 MIR return terminator、return value 和 defining error-union instruction。
/// 返回值说明：无。
export struct MirC99ErrorUnionReturnPlanEntry {
    terminator_id: MirTerminatorId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    return_value_id: MirValueId,
    defining_inst_id: MirInstId,
    defining_op: i32,
    path_kind: i32,
    payload_value_id: MirValueId,
    operand_start: i32,
    operand_count: i32,
    status: i32,
    flags: i32,
}

/// 功能说明：记录 async poll/resume 到低级 C label/goto state edge 的映射。
/// 参数说明：无；字段来自 MIR async instruction 和 `MirAsyncFrameMeta` 的 poll/resume block。
/// 返回值说明：无；后续 await 叶子会继续补充状态保存和 result 处理。
export struct MirC99AsyncFrameStateEdge {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    source_block_id: MirBlockId,
    target_block_id: MirBlockId,
    op: i32,
    state_tag: i32,
    poll_block_id: MirBlockId,
    resume_block_id: MirBlockId,
    status: i32,
    flags: i32,
}

/// 功能说明：记录 await/bind/direct await/loop await 的 frame 状态保存与恢复计划。
/// 参数说明：无；字段来自 MIR async state/child/result op 和 `MirAsyncFrameMeta` slot metadata。
/// 返回值说明：无；后续输出阶段按该计划读写 async frame struct slot。
export struct MirC99AsyncAwaitStateTransition {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    op: i32,
    slot_kind: i32,
    slot_index: i32,
    state_tag: i32,
    await_child_slot_index: i32,
    result_slot_index: i32,
    status: i32,
    flags: i32,
}

/// 功能说明：记录 async error union、cleanup edge 和 frame release 的输出计划。
/// 参数说明：无；字段来自 MIR drop/error-union/async frame free/result load instruction。
/// 返回值说明：无；输出阶段按该计划处理 defer/errdefer、error path 和 frame 释放。
export struct MirC99AsyncCleanupReleasePlanEntry {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    op: i32,
    cleanup_action: i32,
    error_union_path: i32,
    result_value_id: MirValueId,
    frame_released: i32,
    status: i32,
    flags: i32,
}

/// 功能说明：记录 MIR-C99 CFG function plan。
/// 参数说明：无；动态保存 MIR function/block/terminator 到 C function/label/goto 的映射。
/// 返回值说明：无。
export struct MirC99CfgPlan {
    functions: SemanticVector,
    blocks: SemanticVector,
    terminators: SemanticVector,
    cleanup_drops: SemanticVector,
    error_union_returns: SemanticVector,
    async_state_edges: SemanticVector,
    async_await_transitions: SemanticVector,
    async_cleanup_releases: SemanticVector,
    function_count: usize,
    block_count: usize,
    terminator_count: usize,
    cleanup_drop_count: usize,
    error_union_return_count: usize,
    async_state_edge_count: usize,
    async_await_transition_count: usize,
    async_cleanup_release_count: usize,
    cleanup_error_function_count: usize,
    cleanup_block_count: usize,
    cleanup_error_terminator_count: usize,
    reject_count: usize,
}

fn mir_c99_cfg_function_entry_from_mir(function: &MirFunction, unit_id: i32) MirC99FunctionPlanEntry {
    if function == null {
        return MirC99FunctionPlanEntry{
            function_id: MIR_FUNCTION_INVALID_ID,
            unit_id: unit_id,
            c_name_source_id: MIR_FUNCTION_INVALID_ID,
            signature_type_id: MIR_TYPE_INVALID_ID,
            block_start: -1,
            block_count: 0,
            entry_block_id: MIR_BLOCK_INVALID_ID,
            status: MIR_C99_CFG_FUNCTION_STATUS_REJECT,
            flags: 0,
        };
    }
    var flags: i32 = function.flags;
    if (function.cleanup_model & MIR_CLEANUP_MODEL_ERROR) != 0 {
        flags = flags | MIR_C99_CFG_FUNCTION_FLAG_CLEANUP_ERROR;
    }
    return MirC99FunctionPlanEntry{
        function_id: function.function_id,
        unit_id: unit_id,
        c_name_source_id: function.function_id,
        signature_type_id: function.signature_type_id,
        block_start: function.block_start,
        block_count: function.block_count,
        entry_block_id: function.entry_block_id,
        status: MIR_C99_CFG_FUNCTION_STATUS_PLANNED,
        flags: flags,
    };
}

fn mir_c99_cfg_block_entry_from_mir(block: &MirBlock) MirC99BlockPlanEntry {
    if block == null {
        return MirC99BlockPlanEntry{
            block_id: MIR_BLOCK_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            c_label_source_id: MIR_BLOCK_INVALID_ID,
            inst_start: -1,
            inst_count: 0,
            terminator_id: MIR_TERMINATOR_INVALID_ID,
            status: MIR_C99_CFG_BLOCK_STATUS_REJECT,
            flags: 0,
        };
    }
    var flags: i32 = block.flags;
    if (block.flags & MIR_BLOCK_FLAG_CLEANUP) != 0 {
        flags = flags | MIR_C99_CFG_BLOCK_FLAG_CLEANUP;
    }
    return MirC99BlockPlanEntry{
        block_id: block.block_id,
        function_id: block.function_id,
        c_label_source_id: block.block_id,
        inst_start: block.inst_start,
        inst_count: block.inst_count,
        terminator_id: block.terminator_id,
        status: MIR_C99_CFG_BLOCK_STATUS_PLANNED,
        flags: flags,
    };
}

fn mir_c99_cfg_successor_ptr(module: &PortableMirModule, successor_id: i32) &MirSuccessor {
    if module == null || successor_id < 0 || (successor_id as usize) >= module.successors.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.successors, successor_id as usize) as &MirSuccessor;
}

fn mir_c99_cfg_operand_ptr(module: &PortableMirModule, operand_id: i32) &MirOperand {
    if module == null || operand_id < 0 || (operand_id as usize) >= module.operands.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.operands, operand_id as usize) as &MirOperand;
}

fn mir_c99_cfg_value_ptr(module: &PortableMirModule, value_id: MirValueId) &MirValue {
    const value_index: i32 = value_id as i32;
    if module == null || value_index < 0 ||
       (value_index as usize) >= module.values.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.values, value_index as usize) as &MirValue;
}

fn mir_c99_cfg_inst_ptr(module: &PortableMirModule, inst_id: MirInstId) &MirInst {
    const inst_index: i32 = inst_id as i32;
    if module == null || inst_index < 0 ||
       (inst_index as usize) >= module.insts.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.insts, inst_index as usize) as &MirInst;
}

fn mir_c99_cfg_async_frame_meta_ptr(module: &PortableMirModule,
    index: usize) &MirAsyncFrameMeta {
    if module == null || index >= module.async_frame_metas.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.async_frame_metas, index) as &MirAsyncFrameMeta;
}

fn mir_c99_cfg_find_async_frame_meta_for_inst(module: &PortableMirModule,
    inst: &MirInst) &MirAsyncFrameMeta {
    if module == null || inst == null {
        return null;
    }
    var i: usize = 0usize;
    while i < module.async_frame_metas.count {
        const meta: &MirAsyncFrameMeta = mir_c99_cfg_async_frame_meta_ptr(module, i);
        if meta != null && meta.function_id == inst.function_id &&
           meta.poll_block_id != MIR_BLOCK_INVALID_ID &&
           meta.resume_block_id != MIR_BLOCK_INVALID_ID {
            return meta;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_cfg_inst_is_async_state_edge(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_ASYNC_POLL_CHILD ||
       inst.op == MIR_INST_OP_ASYNC_RESUME_EDGE {
        return 1;
    }
    return 0;
}

fn mir_c99_cfg_inst_is_async_await_transition(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_ASYNC_STATE_LOAD ||
       inst.op == MIR_INST_OP_ASYNC_STATE_STORE ||
       inst.op == MIR_INST_OP_ASYNC_AWAIT_CHILD_SLOT ||
       inst.op == MIR_INST_OP_ASYNC_RESULT_LOAD {
        return 1;
    }
    return 0;
}

fn mir_c99_cfg_error_union_path_from_inst(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_ERROR_UNION_OK ||
       inst.op == MIR_INST_OP_ERROR_UNION_PAYLOAD {
        return MIR_ERROR_UNION_PATH_SUCCESS;
    }
    if inst.op == MIR_INST_OP_ERROR_UNION_ERR ||
       inst.op == MIR_INST_OP_ERROR_UNION_ERROR {
        return MIR_ERROR_UNION_PATH_FAILURE;
    }
    return 0;
}

fn mir_c99_cfg_inst_is_async_cleanup_release(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if portable_mir_inst_op_is_drop(inst.op) != 0 {
        return 1;
    }
    if inst.op == MIR_INST_OP_ASYNC_FRAME_FREE ||
       inst.op == MIR_INST_OP_ASYNC_RESULT_LOAD {
        return 1;
    }
    if inst.op == MIR_INST_OP_ERROR_UNION_OK ||
       inst.op == MIR_INST_OP_ERROR_UNION_ERR {
        return 1;
    }
    return 0;
}

fn mir_c99_cfg_async_cleanup_release_flags(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if portable_mir_inst_op_is_drop(inst.op) != 0 {
        return MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_DROP;
    }
    if inst.op == MIR_INST_OP_ASYNC_FRAME_FREE {
        return MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_FRAME_RELEASE;
    }
    if inst.op == MIR_INST_OP_ASYNC_RESULT_LOAD {
        return MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_RESULT;
    }
    if inst.op == MIR_INST_OP_ERROR_UNION_OK ||
       inst.op == MIR_INST_OP_ERROR_UNION_ERR {
        return MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_FLAG_ERROR_UNION;
    }
    return 0;
}

fn mir_c99_cfg_async_cleanup_release_reject_entry(
    inst: &MirInst) MirC99AsyncCleanupReleasePlanEntry {
    var inst_id: MirInstId = MIR_INST_INVALID_ID;
    var function_id: MirFunctionId = MIR_FUNCTION_INVALID_ID;
    var block_id: MirBlockId = MIR_BLOCK_INVALID_ID;
    var op: i32 = 0;
    var result_value_id: MirValueId = MIR_VALUE_INVALID_ID;
    var flags: i32 = 0;
    if inst != null {
        inst_id = inst.inst_id;
        function_id = inst.function_id;
        block_id = inst.block_id;
        op = inst.op;
        result_value_id = inst.result_value_id;
        flags = inst.flags;
    }
    return MirC99AsyncCleanupReleasePlanEntry{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: op,
        cleanup_action: 0,
        error_union_path: 0,
        result_value_id: result_value_id,
        frame_released: 0,
        status: MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_STATUS_REJECT,
        flags: flags,
    };
}

fn mir_c99_cfg_async_cleanup_release_from_mir(module: &PortableMirModule,
    inst: &MirInst) MirC99AsyncCleanupReleasePlanEntry {
    if module == null || inst == null ||
       mir_c99_cfg_inst_is_async_cleanup_release(inst) == 0 {
        return mir_c99_cfg_async_cleanup_release_reject_entry(inst);
    }
    var cleanup_action: i32 = 0;
    var error_union_path: i32 = 0;
    var result_value_id: MirValueId = inst.result_value_id;
    var frame_released: i32 = 0;
    var flags: i32 = mir_c99_cfg_async_cleanup_release_flags(inst);
    if portable_mir_inst_op_is_drop(inst.op) != 0 {
        cleanup_action = mir_c99_cfg_cleanup_action_for_drop(inst);
        if cleanup_action == MIR_CLEANUP_ACTION_LEXICAL_DROP {
            cleanup_action = MIR_CLEANUP_ACTION_DROP;
        }
        flags = flags | MIR_C99_CFG_DROP_FLAG_CLEANUP_EDGE;
        if inst.operand_count > 0 {
            const operand: &MirOperand = mir_c99_cfg_operand_ptr(module, inst.operand_start);
            if operand == null {
                return mir_c99_cfg_async_cleanup_release_reject_entry(inst);
            }
            result_value_id = operand.value_id;
        }
    } else if inst.op == MIR_INST_OP_ASYNC_FRAME_FREE {
        cleanup_action = MIR_CLEANUP_ACTION_DEFER;
        frame_released = 1;
    } else if inst.op == MIR_INST_OP_ASYNC_RESULT_LOAD {
        error_union_path = mir_c99_cfg_error_union_path_from_inst(inst);
    } else {
        error_union_path = mir_c99_cfg_error_union_path_from_inst(inst);
        if error_union_path == 0 {
            return mir_c99_cfg_async_cleanup_release_reject_entry(inst);
        }
        if error_union_path == MIR_ERROR_UNION_PATH_FAILURE {
            cleanup_action = MIR_CLEANUP_ACTION_ERRDEFER;
        }
    }
    if portable_mir_inst_op_is_drop(inst.op) != 0 && cleanup_action == 0 {
        return mir_c99_cfg_async_cleanup_release_reject_entry(inst);
    }
    return MirC99AsyncCleanupReleasePlanEntry{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        block_id: inst.block_id,
        op: inst.op,
        cleanup_action: cleanup_action,
        error_union_path: error_union_path,
        result_value_id: result_value_id,
        frame_released: frame_released,
        status: MIR_C99_CFG_ASYNC_CLEANUP_RELEASE_STATUS_PLANNED,
        flags: flags,
    };
}

fn mir_c99_cfg_async_await_transition_from_mir(module: &PortableMirModule,
    inst: &MirInst) MirC99AsyncAwaitStateTransition {
    if module == null || inst == null ||
       mir_c99_cfg_inst_is_async_await_transition(inst) == 0 {
        return MirC99AsyncAwaitStateTransition{
            inst_id: MIR_INST_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            block_id: MIR_BLOCK_INVALID_ID,
            op: 0,
            slot_kind: 0,
            slot_index: -1,
            state_tag: 0,
            await_child_slot_index: -1,
            result_slot_index: -1,
            status: MIR_C99_CFG_ASYNC_AWAIT_STATUS_REJECT,
            flags: 0,
        };
    }
    const meta: &MirAsyncFrameMeta = mir_c99_cfg_find_async_frame_meta_for_inst(module, inst);
    if meta == null {
        return MirC99AsyncAwaitStateTransition{
            inst_id: inst.inst_id,
            function_id: inst.function_id,
            block_id: inst.block_id,
            op: inst.op,
            slot_kind: 0,
            slot_index: -1,
            state_tag: 0,
            await_child_slot_index: -1,
            result_slot_index: -1,
            status: MIR_C99_CFG_ASYNC_AWAIT_STATUS_REJECT,
            flags: 0,
        };
    }
    var slot_kind: i32 = MIR_ASYNC_FRAME_SLOT_STATE_TAG;
    var slot_index: i32 = meta.slot_index;
    var flags: i32 = MIR_C99_CFG_ASYNC_AWAIT_FLAG_STATE;
    if inst.op == MIR_INST_OP_ASYNC_AWAIT_CHILD_SLOT {
        slot_kind = MIR_ASYNC_FRAME_SLOT_AWAIT_CHILD;
        slot_index = meta.await_child_slot_index;
        flags = MIR_C99_CFG_ASYNC_AWAIT_FLAG_CHILD;
    } else if inst.op == MIR_INST_OP_ASYNC_RESULT_LOAD {
        slot_kind = MIR_ASYNC_FRAME_SLOT_RESULT;
        slot_index = meta.result_slot_index;
        flags = MIR_C99_CFG_ASYNC_AWAIT_FLAG_RESULT;
    }
    return MirC99AsyncAwaitStateTransition{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        block_id: inst.block_id,
        op: inst.op,
        slot_kind: slot_kind,
        slot_index: slot_index,
        state_tag: meta.state_tag,
        await_child_slot_index: meta.await_child_slot_index,
        result_slot_index: meta.result_slot_index,
        status: MIR_C99_CFG_ASYNC_AWAIT_STATUS_PLANNED,
        flags: flags,
    };
}

fn mir_c99_cfg_async_state_edge_from_mir(module: &PortableMirModule,
    inst: &MirInst) MirC99AsyncFrameStateEdge {
    if module == null || inst == null ||
       mir_c99_cfg_inst_is_async_state_edge(inst) == 0 {
        return MirC99AsyncFrameStateEdge{
            inst_id: MIR_INST_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            source_block_id: MIR_BLOCK_INVALID_ID,
            target_block_id: MIR_BLOCK_INVALID_ID,
            op: 0,
            state_tag: 0,
            poll_block_id: MIR_BLOCK_INVALID_ID,
            resume_block_id: MIR_BLOCK_INVALID_ID,
            status: MIR_C99_CFG_ASYNC_STATE_EDGE_STATUS_REJECT,
            flags: 0,
        };
    }
    const meta: &MirAsyncFrameMeta = mir_c99_cfg_find_async_frame_meta_for_inst(module, inst);
    if meta == null {
        return MirC99AsyncFrameStateEdge{
            inst_id: inst.inst_id,
            function_id: inst.function_id,
            source_block_id: inst.block_id,
            target_block_id: MIR_BLOCK_INVALID_ID,
            op: inst.op,
            state_tag: 0,
            poll_block_id: MIR_BLOCK_INVALID_ID,
            resume_block_id: MIR_BLOCK_INVALID_ID,
            status: MIR_C99_CFG_ASYNC_STATE_EDGE_STATUS_REJECT,
            flags: 0,
        };
    }
    var target_block: MirBlockId = meta.poll_block_id;
    var flags: i32 = MIR_C99_CFG_ASYNC_STATE_EDGE_FLAG_POLL;
    if inst.op == MIR_INST_OP_ASYNC_RESUME_EDGE {
        target_block = meta.resume_block_id;
        flags = MIR_C99_CFG_ASYNC_STATE_EDGE_FLAG_RESUME;
    }
    return MirC99AsyncFrameStateEdge{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        source_block_id: inst.block_id,
        target_block_id: target_block,
        op: inst.op,
        state_tag: meta.state_tag,
        poll_block_id: meta.poll_block_id,
        resume_block_id: meta.resume_block_id,
        status: MIR_C99_CFG_ASYNC_STATE_EDGE_STATUS_PLANNED,
        flags: flags,
    };
}

fn mir_c99_cfg_block_ptr(module: &PortableMirModule, block_id: MirBlockId) &MirBlock {
    const block_index: i32 = block_id as i32;
    if module == null || block_index < 0 ||
       (block_index as usize) >= module.blocks.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.blocks, block_index as usize) as &MirBlock;
}

fn mir_c99_cfg_inst_block_ptr(module: &PortableMirModule, inst: &MirInst) &MirBlock {
    if module == null || inst == null {
        return null;
    }
    return mir_c99_cfg_block_ptr(module, inst.block_id);
}

fn mir_c99_cfg_cleanup_action_for_drop(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if inst.op == MIR_INST_OP_DROP_IN_PLACE {
        return MIR_CLEANUP_ACTION_DEFER;
    }
    if inst.op == MIR_INST_OP_DROP_VALUE {
        if (inst.flags & MIR_INST_FLAG_ERROR_UNION_CHECKED) != 0 {
            return MIR_CLEANUP_ACTION_ERRDEFER;
        }
        return MIR_CLEANUP_ACTION_LEXICAL_DROP;
    }
    return 0;
}

fn mir_c99_cfg_cleanup_drop_reject_entry(inst: &MirInst) MirC99CleanupDropPlanEntry {
    var inst_id: MirInstId = MIR_INST_INVALID_ID;
    var function_id: MirFunctionId = MIR_FUNCTION_INVALID_ID;
    var block_id: MirBlockId = MIR_BLOCK_INVALID_ID;
    var op: i32 = 0;
    var operand_start: i32 = -1;
    var operand_count: i32 = 0;
    var flags: i32 = 0;
    if inst != null {
        inst_id = inst.inst_id;
        function_id = inst.function_id;
        block_id = inst.block_id;
        op = inst.op;
        operand_start = inst.operand_start;
        operand_count = inst.operand_count;
        flags = inst.flags;
    }
    return MirC99CleanupDropPlanEntry{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        op: op,
        cleanup_action: 0,
        dropped_value_id: MIR_VALUE_INVALID_ID,
        operand_start: operand_start,
        operand_count: operand_count,
        status: MIR_C99_CFG_DROP_STATUS_REJECT,
        flags: flags,
    };
}

fn mir_c99_cfg_cleanup_drop_entry_from_mir(module: &PortableMirModule,
    inst: &MirInst) MirC99CleanupDropPlanEntry {
    if module == null || inst == null || portable_mir_inst_op_is_drop(inst.op) == 0 ||
       inst.operand_count < 1 {
        return mir_c99_cfg_cleanup_drop_reject_entry(inst);
    }
    const block: &MirBlock = mir_c99_cfg_inst_block_ptr(module, inst);
    if block == null || (block.flags & MIR_BLOCK_FLAG_CLEANUP) == 0 {
        return mir_c99_cfg_cleanup_drop_reject_entry(inst);
    }
    const operand: &MirOperand = mir_c99_cfg_operand_ptr(module, inst.operand_start);
    if operand == null {
        return mir_c99_cfg_cleanup_drop_reject_entry(inst);
    }
    const action: i32 = mir_c99_cfg_cleanup_action_for_drop(inst);
    if action == 0 {
        return mir_c99_cfg_cleanup_drop_reject_entry(inst);
    }
    return MirC99CleanupDropPlanEntry{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        block_id: inst.block_id,
        op: inst.op,
        cleanup_action: action,
        dropped_value_id: operand.value_id,
        operand_start: inst.operand_start,
        operand_count: inst.operand_count,
        status: MIR_C99_CFG_DROP_STATUS_PLANNED,
        flags: inst.flags | MIR_C99_CFG_DROP_FLAG_CLEANUP_EDGE,
    };
}

fn mir_c99_cfg_error_union_return_reject_entry(term: &MirTerminator,
    return_value_id: MirValueId) MirC99ErrorUnionReturnPlanEntry {
    var terminator_id: MirTerminatorId = MIR_TERMINATOR_INVALID_ID;
    var function_id: MirFunctionId = MIR_FUNCTION_INVALID_ID;
    var block_id: MirBlockId = MIR_BLOCK_INVALID_ID;
    var operand_start: i32 = -1;
    var operand_count: i32 = 0;
    var flags: i32 = 0;
    if term != null {
        terminator_id = term.terminator_id;
        function_id = term.function_id;
        block_id = term.block_id;
        operand_start = term.operand_start;
        operand_count = term.operand_count;
        flags = term.flags;
    }
    return MirC99ErrorUnionReturnPlanEntry{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        return_value_id: return_value_id,
        defining_inst_id: MIR_INST_INVALID_ID,
        defining_op: 0,
        path_kind: 0,
        payload_value_id: MIR_VALUE_INVALID_ID,
        operand_start: operand_start,
        operand_count: operand_count,
        status: MIR_C99_CFG_ERROR_UNION_RETURN_STATUS_REJECT,
        flags: flags,
    };
}

fn mir_c99_cfg_error_union_return_path(inst: &MirInst) i32 {
    return mir_c99_cfg_error_union_path_from_inst(inst);
}

fn mir_c99_cfg_error_union_return_flags(inst: &MirInst) i32 {
    if inst == null {
        return 0;
    }
    if (inst.flags & MIR_INST_FLAG_ERROR_UNION_CHECKED) != 0 {
        return MIR_C99_CFG_ERROR_UNION_RETURN_FLAG_CHECKED;
    }
    return 0;
}

fn mir_c99_cfg_error_union_return_inst(module: &PortableMirModule,
    term: &MirTerminator) &MirInst {
    if module == null || term == null || term.kind != MIR_TERMINATOR_KIND_RETURN ||
       term.operand_count != 1 {
        return null;
    }
    const return_operand: &MirOperand = mir_c99_cfg_operand_ptr(module, term.operand_start);
    if return_operand == null {
        return null;
    }
    const value: &MirValue = mir_c99_cfg_value_ptr(module, return_operand.value_id);
    if value == null || value.defining_inst_id == MIR_INST_INVALID_ID {
        return null;
    }
    const inst: &MirInst = mir_c99_cfg_inst_ptr(module, value.defining_inst_id);
    if inst == null || portable_mir_inst_op_is_error_union(inst.op) == 0 {
        return null;
    }
    return inst;
}

fn mir_c99_cfg_error_union_return_entry_from_mir(module: &PortableMirModule,
    term: &MirTerminator) MirC99ErrorUnionReturnPlanEntry {
    if module == null || term == null || term.kind != MIR_TERMINATOR_KIND_RETURN ||
       term.operand_count != 1 {
        return mir_c99_cfg_error_union_return_reject_entry(term, MIR_VALUE_INVALID_ID);
    }
    const return_operand: &MirOperand = mir_c99_cfg_operand_ptr(module, term.operand_start);
    if return_operand == null {
        return mir_c99_cfg_error_union_return_reject_entry(term, MIR_VALUE_INVALID_ID);
    }
    const inst: &MirInst = mir_c99_cfg_error_union_return_inst(module, term);
    if inst == null {
        return mir_c99_cfg_error_union_return_reject_entry(term, return_operand.value_id);
    }
    const path: i32 = mir_c99_cfg_error_union_return_path(inst);
    if path == 0 {
        return mir_c99_cfg_error_union_return_reject_entry(term, return_operand.value_id);
    }
    return MirC99ErrorUnionReturnPlanEntry{
        terminator_id: term.terminator_id,
        function_id: term.function_id,
        block_id: term.block_id,
        return_value_id: return_operand.value_id,
        defining_inst_id: inst.inst_id,
        defining_op: inst.op,
        path_kind: path,
        payload_value_id: inst.result_value_id,
        operand_start: term.operand_start,
        operand_count: term.operand_count,
        status: MIR_C99_CFG_ERROR_UNION_RETURN_STATUS_PLANNED,
        flags: mir_c99_cfg_error_union_return_flags(inst),
    };
}

fn mir_c99_cfg_terminator_flags_from_mir(module: &PortableMirModule,
    term: &MirTerminator) i32 {
    if term == null {
        return 0;
    }
    var flags: i32 = term.flags;
    const block: &MirBlock = mir_c99_cfg_block_ptr(module, term.block_id);
    if block != null && (block.flags & MIR_BLOCK_FLAG_CLEANUP) != 0 {
        flags = flags | MIR_C99_CFG_TERMINATOR_FLAG_ERROR_CFG;
    }
    return flags;
}

fn mir_c99_cfg_terminator_reject_entry(term: &MirTerminator) MirC99TerminatorPlanEntry {
    var terminator_id: MirTerminatorId = MIR_TERMINATOR_INVALID_ID;
    var function_id: MirFunctionId = MIR_FUNCTION_INVALID_ID;
    var block_id: MirBlockId = MIR_BLOCK_INVALID_ID;
    var kind: i32 = MIR_TERMINATOR_KIND_INVALID;
    var operand_start: i32 = -1;
    var operand_count: i32 = 0;
    var successor_start: i32 = -1;
    var successor_count: i32 = 0;
    var flags: i32 = 0;
    if term != null {
        terminator_id = term.terminator_id;
        function_id = term.function_id;
        block_id = term.block_id;
        kind = term.kind;
        operand_start = term.operand_start;
        operand_count = term.operand_count;
        successor_start = term.successor_start;
        successor_count = term.successor_count;
        flags = term.flags;
    }
    return MirC99TerminatorPlanEntry{
        terminator_id: terminator_id,
        function_id: function_id,
        block_id: block_id,
        kind: kind,
        operand_start: operand_start,
        operand_count: operand_count,
        successor_start: successor_start,
        successor_count: successor_count,
        branch_target_block_id: MIR_BLOCK_INVALID_ID,
        condition_value_id: MIR_VALUE_INVALID_ID,
        true_target_block_id: MIR_BLOCK_INVALID_ID,
        false_target_block_id: MIR_BLOCK_INVALID_ID,
        return_value_id: MIR_VALUE_INVALID_ID,
        status: MIR_C99_CFG_TERMINATOR_STATUS_REJECT,
        flags: flags,
    };
}

fn mir_c99_cfg_terminator_record_entry(module: &PortableMirModule,
    term: &MirTerminator) MirC99TerminatorPlanEntry {
    if term == null {
        return mir_c99_cfg_terminator_reject_entry(term);
    }
    return MirC99TerminatorPlanEntry{
        terminator_id: term.terminator_id,
        function_id: term.function_id,
        block_id: term.block_id,
        kind: term.kind,
        operand_start: term.operand_start,
        operand_count: term.operand_count,
        successor_start: term.successor_start,
        successor_count: term.successor_count,
        branch_target_block_id: MIR_BLOCK_INVALID_ID,
        condition_value_id: MIR_VALUE_INVALID_ID,
        true_target_block_id: MIR_BLOCK_INVALID_ID,
        false_target_block_id: MIR_BLOCK_INVALID_ID,
        return_value_id: MIR_VALUE_INVALID_ID,
        status: MIR_C99_CFG_TERMINATOR_STATUS_PLANNED,
        flags: mir_c99_cfg_terminator_flags_from_mir(module, term),
    };
}

fn mir_c99_cfg_terminator_entry_from_mir(module: &PortableMirModule,
    term: &MirTerminator) MirC99TerminatorPlanEntry {
    if module == null || term == null {
        return mir_c99_cfg_terminator_reject_entry(term);
    }
    if term.kind == MIR_TERMINATOR_KIND_BR {
        if term.successor_count == 1 {
            const successor: &MirSuccessor = mir_c99_cfg_successor_ptr(module, term.successor_start);
            if successor != null {
                return MirC99TerminatorPlanEntry{
                    terminator_id: term.terminator_id,
                    function_id: term.function_id,
                    block_id: term.block_id,
                    kind: term.kind,
                    operand_start: term.operand_start,
                    operand_count: term.operand_count,
                    successor_start: term.successor_start,
                    successor_count: term.successor_count,
                    branch_target_block_id: successor.block_id,
                    condition_value_id: MIR_VALUE_INVALID_ID,
                    true_target_block_id: MIR_BLOCK_INVALID_ID,
                    false_target_block_id: MIR_BLOCK_INVALID_ID,
                    return_value_id: MIR_VALUE_INVALID_ID,
                    status: MIR_C99_CFG_TERMINATOR_STATUS_PLANNED,
                    flags: mir_c99_cfg_terminator_flags_from_mir(module, term),
                };
            }
        }
        return mir_c99_cfg_terminator_reject_entry(term);
    }
    if term.kind == MIR_TERMINATOR_KIND_COND_BR {
        if term.operand_count == 1 && term.successor_count == 2 {
            const condition: &MirOperand = mir_c99_cfg_operand_ptr(module, term.operand_start);
            const true_successor: &MirSuccessor =
                mir_c99_cfg_successor_ptr(module, term.successor_start);
            const false_successor: &MirSuccessor =
                mir_c99_cfg_successor_ptr(module, term.successor_start + 1);
            if condition != null && true_successor != null && false_successor != null {
                return MirC99TerminatorPlanEntry{
                    terminator_id: term.terminator_id,
                    function_id: term.function_id,
                    block_id: term.block_id,
                    kind: term.kind,
                    operand_start: term.operand_start,
                    operand_count: term.operand_count,
                    successor_start: term.successor_start,
                    successor_count: term.successor_count,
                    branch_target_block_id: MIR_BLOCK_INVALID_ID,
                    condition_value_id: condition.value_id,
                    true_target_block_id: true_successor.block_id,
                    false_target_block_id: false_successor.block_id,
                    return_value_id: MIR_VALUE_INVALID_ID,
                    status: MIR_C99_CFG_TERMINATOR_STATUS_PLANNED,
                    flags: mir_c99_cfg_terminator_flags_from_mir(module, term),
                };
            }
        }
        return mir_c99_cfg_terminator_reject_entry(term);
    }
    if term.kind == MIR_TERMINATOR_KIND_RETURN {
        if term.operand_count == 0 {
            return MirC99TerminatorPlanEntry{
                terminator_id: term.terminator_id,
                function_id: term.function_id,
                block_id: term.block_id,
                kind: term.kind,
                operand_start: term.operand_start,
                operand_count: term.operand_count,
                successor_start: term.successor_start,
                successor_count: term.successor_count,
                branch_target_block_id: MIR_BLOCK_INVALID_ID,
                condition_value_id: MIR_VALUE_INVALID_ID,
                true_target_block_id: MIR_BLOCK_INVALID_ID,
                false_target_block_id: MIR_BLOCK_INVALID_ID,
                return_value_id: MIR_VALUE_INVALID_ID,
                status: MIR_C99_CFG_TERMINATOR_STATUS_PLANNED,
                flags: mir_c99_cfg_terminator_flags_from_mir(module, term),
            };
        }
        if term.operand_count == 1 {
            const return_operand: &MirOperand = mir_c99_cfg_operand_ptr(module, term.operand_start);
            if return_operand != null {
                return MirC99TerminatorPlanEntry{
                    terminator_id: term.terminator_id,
                    function_id: term.function_id,
                    block_id: term.block_id,
                    kind: term.kind,
                    operand_start: term.operand_start,
                    operand_count: term.operand_count,
                    successor_start: term.successor_start,
                    successor_count: term.successor_count,
                    branch_target_block_id: MIR_BLOCK_INVALID_ID,
                    condition_value_id: MIR_VALUE_INVALID_ID,
                    true_target_block_id: MIR_BLOCK_INVALID_ID,
                    false_target_block_id: MIR_BLOCK_INVALID_ID,
                    return_value_id: return_operand.value_id,
                    status: MIR_C99_CFG_TERMINATOR_STATUS_PLANNED,
                    flags: mir_c99_cfg_terminator_flags_from_mir(module, term),
                };
            }
        }
        return mir_c99_cfg_terminator_reject_entry(term);
    }
    return mir_c99_cfg_terminator_record_entry(module, term);
}

fn mir_c99_cfg_write_i32(stream: &FILE, value: i32) i32 {
    if stream == null {
        return -1;
    }
    if value == 0 {
        if fputc(48, stream as *void) < 0 {
            return -1;
        }
        return 0;
    }
    var v: i32 = value;
    if v < 0 {
        if fputc(45, stream as *void) < 0 {
            return -1;
        }
        v = 0 - v;
    }
    var digits: [i32: 20] = [];
    var count: i32 = 0;
    while v > 0 && count < 20 {
        digits[count] = v % 10;
        v = v / 10;
        count = count + 1;
    }
    var i: i32 = count - 1;
    while i >= 0 {
        if fputc(48 + digits[i], stream as *void) < 0 {
            return -1;
        }
        i = i - 1;
    }
    return 0;
}

/// 功能说明：初始化 MIR-C99 CFG function plan。
/// 参数说明：`plan` 为输出 CFG plan。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_cfg_plan_init(plan: &MirC99CfgPlan) i32 {
    if plan == null {
        return -1;
    }
    semantic_vector_init(&plan.functions, @size_of(MirC99FunctionPlanEntry));
    semantic_vector_init(&plan.blocks, @size_of(MirC99BlockPlanEntry));
    semantic_vector_init(&plan.terminators, @size_of(MirC99TerminatorPlanEntry));
    semantic_vector_init(&plan.cleanup_drops, @size_of(MirC99CleanupDropPlanEntry));
    semantic_vector_init(&plan.error_union_returns, @size_of(MirC99ErrorUnionReturnPlanEntry));
    semantic_vector_init(&plan.async_state_edges, @size_of(MirC99AsyncFrameStateEdge));
    semantic_vector_init(&plan.async_await_transitions, @size_of(MirC99AsyncAwaitStateTransition));
    semantic_vector_init(&plan.async_cleanup_releases,
        @size_of(MirC99AsyncCleanupReleasePlanEntry));
    plan.function_count = 0usize;
    plan.block_count = 0usize;
    plan.terminator_count = 0usize;
    plan.cleanup_drop_count = 0usize;
    plan.error_union_return_count = 0usize;
    plan.async_state_edge_count = 0usize;
    plan.async_await_transition_count = 0usize;
    plan.async_cleanup_release_count = 0usize;
    plan.cleanup_error_function_count = 0usize;
    plan.cleanup_block_count = 0usize;
    plan.cleanup_error_terminator_count = 0usize;
    plan.reject_count = 0usize;
    return 0;
}

/// 功能说明：释放 MIR-C99 CFG function plan。
/// 参数说明：`plan` 为待释放 CFG plan；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_cfg_plan_release(plan: &MirC99CfgPlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.functions);
    semantic_vector_release(&plan.blocks);
    semantic_vector_release(&plan.terminators);
    semantic_vector_release(&plan.cleanup_drops);
    semantic_vector_release(&plan.error_union_returns);
    semantic_vector_release(&plan.async_state_edges);
    semantic_vector_release(&plan.async_await_transitions);
    semantic_vector_release(&plan.async_cleanup_releases);
    plan.function_count = 0usize;
    plan.block_count = 0usize;
    plan.terminator_count = 0usize;
    plan.cleanup_drop_count = 0usize;
    plan.error_union_return_count = 0usize;
    plan.async_state_edge_count = 0usize;
    plan.async_await_transition_count = 0usize;
    plan.async_cleanup_release_count = 0usize;
    plan.cleanup_error_function_count = 0usize;
    plan.cleanup_block_count = 0usize;
    plan.cleanup_error_terminator_count = 0usize;
    plan.reject_count = 0usize;
}

/// 功能说明：向 MIR-C99 CFG plan 追加一个 MIR function -> C function 映射。
/// 参数说明：`cfg_plan` 为 CFG plan，`output_plan` 为 MIR-C99 plan，`unit` 为目标 unit，`function` 为 MIR function。
/// 返回值说明：成功返回 `0`，参数非法或动态表追加失败返回 `-1`。
export fn mir_c99_cfg_plan_append_function(cfg_plan: &MirC99CfgPlan,
    output_plan: &MirC99Plan, unit: &MirC99Unit, function: &MirFunction) i32 {
    if cfg_plan == null || output_plan == null || unit == null || function == null {
        return -1;
    }
    const entry: MirC99FunctionPlanEntry =
        mir_c99_cfg_function_entry_from_mir(function, unit.unit_id);
    if semantic_vector_append(&cfg_plan.functions, &entry as &const void) != 0 {
        return -1;
    }
    cfg_plan.function_count = cfg_plan.functions.count;
    if entry.status == MIR_C99_CFG_FUNCTION_STATUS_REJECT {
        cfg_plan.reject_count = cfg_plan.reject_count + 1usize;
        return -1;
    }
    if (entry.flags & MIR_C99_CFG_FUNCTION_FLAG_CLEANUP_ERROR) != 0 {
        cfg_plan.cleanup_error_function_count =
            cfg_plan.cleanup_error_function_count + 1usize;
    }
    if mir_c99_plan_append_ref(output_plan, MIR_C99_REF_KIND_FUNCTION,
        entry.function_id, entry.c_name_source_id, entry.flags) != 0 {
        return -1;
    }
    if mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_FUNCTION,
        entry.function_id, entry.c_name_source_id, entry.flags) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 CFG plan 追加一个 MIR block -> C label 映射。
/// 参数说明：`cfg_plan` 为 CFG plan，`block` 为 MIR block。
/// 返回值说明：成功返回 `0`，参数非法或动态表追加失败返回 `-1`。
export fn mir_c99_cfg_plan_append_block(cfg_plan: &MirC99CfgPlan, block: &MirBlock) i32 {
    if cfg_plan == null || block == null {
        return -1;
    }
    const entry: MirC99BlockPlanEntry = mir_c99_cfg_block_entry_from_mir(block);
    if semantic_vector_append(&cfg_plan.blocks, &entry as &const void) != 0 {
        return -1;
    }
    cfg_plan.block_count = cfg_plan.blocks.count;
    if entry.status == MIR_C99_CFG_BLOCK_STATUS_REJECT {
        cfg_plan.reject_count = cfg_plan.reject_count + 1usize;
        return -1;
    }
    if (entry.flags & MIR_C99_CFG_BLOCK_FLAG_CLEANUP) != 0 {
        cfg_plan.cleanup_block_count = cfg_plan.cleanup_block_count + 1usize;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 CFG plan 追加一个 MIR terminator -> C control-flow 映射。
/// 参数说明：`cfg_plan` 为 CFG plan，`module` 为 MIR module，`terminator` 为 MIR terminator。
/// 返回值说明：成功返回 `0`，不支持或参数非法返回 `-1`。
export fn mir_c99_cfg_plan_append_terminator(cfg_plan: &MirC99CfgPlan,
    module: &PortableMirModule, terminator: &MirTerminator) i32 {
    if cfg_plan == null || module == null || terminator == null {
        return -1;
    }
    const entry: MirC99TerminatorPlanEntry =
        mir_c99_cfg_terminator_entry_from_mir(module, terminator);
    if semantic_vector_append(&cfg_plan.terminators, &entry as &const void) != 0 {
        return -1;
    }
    cfg_plan.terminator_count = cfg_plan.terminators.count;
    if entry.status == MIR_C99_CFG_TERMINATOR_STATUS_REJECT {
        cfg_plan.reject_count = cfg_plan.reject_count + 1usize;
        return -1;
    }
    if (entry.flags & MIR_C99_CFG_TERMINATOR_FLAG_ERROR_CFG) != 0 {
        cfg_plan.cleanup_error_terminator_count =
            cfg_plan.cleanup_error_terminator_count + 1usize;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 CFG plan 追加一个 MIR cleanup/drop instruction 映射。
/// 参数说明：`cfg_plan` 为 CFG plan，`module` 为 MIR module，`inst` 为 MIR drop instruction。
/// 返回值说明：非 drop instruction 返回 `0`；cleanup block 内 drop 映射成功返回 `0`，不支持返回 `-1`。
export fn mir_c99_cfg_plan_append_cleanup_drop(cfg_plan: &MirC99CfgPlan,
    module: &PortableMirModule, inst: &MirInst) i32 {
    if cfg_plan == null || module == null || inst == null {
        return -1;
    }
    if portable_mir_inst_op_is_drop(inst.op) == 0 {
        return 0;
    }
    const entry: MirC99CleanupDropPlanEntry =
        mir_c99_cfg_cleanup_drop_entry_from_mir(module, inst);
    if semantic_vector_append(&cfg_plan.cleanup_drops, &entry as &const void) != 0 {
        return -1;
    }
    cfg_plan.cleanup_drop_count = cfg_plan.cleanup_drops.count;
    if entry.status == MIR_C99_CFG_DROP_STATUS_REJECT {
        cfg_plan.reject_count = cfg_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 CFG plan 追加一个 MIR error-union success/fallback return 映射。
/// 参数说明：`cfg_plan` 为 CFG plan，`module` 为 MIR module，`terminator` 为 MIR return terminator。
/// 返回值说明：非 error-union return 返回 `0`；error-union return 映射成功返回 `0`，不支持返回 `-1`。
export fn mir_c99_cfg_plan_append_error_union_return(cfg_plan: &MirC99CfgPlan,
    module: &PortableMirModule, terminator: &MirTerminator) i32 {
    if cfg_plan == null || module == null || terminator == null {
        return -1;
    }
    if mir_c99_cfg_error_union_return_inst(module, terminator) == null {
        return 0;
    }
    const entry: MirC99ErrorUnionReturnPlanEntry =
        mir_c99_cfg_error_union_return_entry_from_mir(module, terminator);
    if semantic_vector_append(&cfg_plan.error_union_returns,
        &entry as &const void) != 0 {
        return -1;
    }
    cfg_plan.error_union_return_count = cfg_plan.error_union_returns.count;
    if entry.status == MIR_C99_CFG_ERROR_UNION_RETURN_STATUS_REJECT {
        cfg_plan.reject_count = cfg_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 CFG plan 追加一个 async poll/resume state edge。
