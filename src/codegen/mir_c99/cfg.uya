/// 功能说明：从 PortableMIR module 构建 MIR function -> C function 映射。
/// 参数说明：`module` 为 verifier-clean MIR module，`output_plan` 为 MIR-C99 plan，`unit` 为目标 single unit，`cfg_plan` 为输出 CFG plan。
/// 返回值说明：全部 function 映射成功返回 `0`，参数非法或任一 function 失败返回 `-1`。
export fn mir_c99_cfg_plan_build_functions(module: &PortableMirModule,
    output_plan: &MirC99Plan, unit: &MirC99Unit, cfg_plan: &MirC99CfgPlan) i32 {
    if module == null || output_plan == null || unit == null || cfg_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.functions.count {
        const function: &MirFunction = semantic_vector_item_ptr(&module.functions, i) as &MirFunction;
        var target_unit: &MirC99Unit = mir_c99_plan_unit_for_function(output_plan, function);
        if target_unit == null {
            target_unit = unit;
        }
        if mir_c99_cfg_plan_append_function(cfg_plan, output_plan, target_unit, function) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 PortableMIR module 构建 MIR block -> C label 映射。
/// 参数说明：`module` 为 verifier-clean MIR module，`cfg_plan` 为输出 CFG plan。
/// 返回值说明：全部 block 映射成功返回 `0`，参数非法或任一 block 失败返回 `-1`。
export fn mir_c99_cfg_plan_build_blocks(module: &PortableMirModule, cfg_plan: &MirC99CfgPlan) i32 {
    if module == null || cfg_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.blocks.count {
        const block: &MirBlock = semantic_vector_item_ptr(&module.blocks, i) as &MirBlock;
        if mir_c99_cfg_plan_append_block(cfg_plan, block) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 PortableMIR module 构建 MIR terminator -> C control-flow 映射。
/// 参数说明：`module` 为 verifier-clean MIR module，`cfg_plan` 为输出 CFG plan。
/// 返回值说明：全部已支持 terminator 映射成功返回 `0`，参数非法或任一 terminator 失败返回 `-1`。
export fn mir_c99_cfg_plan_build_terminators(module: &PortableMirModule, cfg_plan: &MirC99CfgPlan) i32 {
    if module == null || cfg_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.terminators.count {
        const terminator: &MirTerminator = semantic_vector_item_ptr(&module.terminators, i) as &MirTerminator;
        if mir_c99_cfg_plan_append_terminator(cfg_plan, module, terminator) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 PortableMIR module 构建 cleanup block 内 drop instruction 的 MIR-C99 映射。
/// 参数说明：`module` 为 verifier-clean MIR module，`cfg_plan` 为输出 CFG plan。
/// 返回值说明：全部 cleanup/drop 映射成功返回 `0`，参数非法或任一 cleanup/drop 失败返回 `-1`。
export fn mir_c99_cfg_plan_build_cleanup_drops(module: &PortableMirModule,
    cfg_plan: &MirC99CfgPlan) i32 {
    if module == null || cfg_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = semantic_vector_item_ptr(&module.insts, i) as &MirInst;
        if mir_c99_cfg_plan_append_cleanup_drop(cfg_plan, module, inst) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 PortableMIR module 构建 error-union success/fallback return 映射。
