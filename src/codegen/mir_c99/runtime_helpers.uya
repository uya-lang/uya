// codegen/mir_c99/runtime_helpers.uya - MIR runtime helper refs to MIR-C99 helper plan.

use codegen.mir_c99.plan;

export const MIR_C99_RUNTIME_HELPER_STATUS_READY: i32 = 1;
export const MIR_C99_RUNTIME_HELPER_STATUS_REJECT: i32 = 2;
export const MIR_C99_ASYNC_FRAME_POOL_DEFAULT_STACK_LIMIT: usize = 65536usize;

/// 功能说明：记录 MIR-C99 async frame pool 和 heap fallback 运行时策略。
/// 参数说明：无；字段来自 verified backend request flags 和 PortableMIR async frame metadata。
/// 返回值说明：无；runtime helper 输出阶段据此生成 `_uya_async_frame_heap_fallback` 等配置。
export struct MirC99AsyncFramePoolPlan {
    required: i32,
    async_frame_heap_fallback_enabled: i32,
    async_frame_stack_limit: usize,
    helper_ref_count: usize,
    status: i32,
    flags: i32,
}

/// 功能说明：记录 MIR-C99 runtime helper 计划。
/// 参数说明：无；helper refs 仅来自 verifier-clean MIR capability requirements。
/// 返回值说明：无；调用 `mir_c99_runtime_helper_plan_init` 后使用。
export struct MirC99RuntimeHelperPlan {
    helper_count: usize,
    reject_count: usize,
    async_frame_pool: MirC99AsyncFramePoolPlan,
}

fn mir_c99_runtime_helper_capability_req_ptr(module: &PortableMirModule,
    index: usize) &MirCapabilityReq {
    if module == null || index >= module.capability_reqs.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.capability_reqs, index) as &MirCapabilityReq;
}

fn mir_c99_runtime_helper_inst_ptr(module: &PortableMirModule, index: usize) &MirInst {
    if module == null || index >= module.insts.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.insts, index) as &MirInst;
}

fn mir_c99_runtime_helper_required_capability(helper_id: i32) i32 {
    if helper_id == MIR_RUNTIME_HELPER_MEMCPY ||
       helper_id == MIR_RUNTIME_HELPER_MEMSET ||
       helper_id == MIR_RUNTIME_HELPER_MEMCMP {
        return MIR_RUNTIME_CAP_MEMORY_HELPERS;
    }
    if helper_id == MIR_RUNTIME_HELPER_STRING_PRIMITIVE {
        return MIR_RUNTIME_CAP_STRING_PRIMITIVES;
    }
    if helper_id == MIR_RUNTIME_HELPER_PRINT ||
       helper_id == MIR_RUNTIME_HELPER_PRINTLN {
        return MIR_RUNTIME_CAP_PRINT_HELPERS;
    }
    if helper_id == MIR_RUNTIME_HELPER_MALLOC ||
       helper_id == MIR_RUNTIME_HELPER_FREE {
        return MIR_RUNTIME_CAP_HEAP_HELPERS;
    }
    if helper_id == MIR_RUNTIME_HELPER_ENV ||
       helper_id == MIR_RUNTIME_HELPER_FILE_IO {
        return MIR_RUNTIME_CAP_ENV_FILE_IO;
    }
    if helper_id == MIR_RUNTIME_HELPER_SYSCALL {
        return MIR_RUNTIME_CAP_SYSCALL;
    }
    return 0;
}

fn mir_c99_runtime_helper_is_memory_string(helper_id: i32) i32 {
    if helper_id == MIR_RUNTIME_HELPER_MEMCPY ||
       helper_id == MIR_RUNTIME_HELPER_MEMSET ||
       helper_id == MIR_RUNTIME_HELPER_MEMCMP ||
       helper_id == MIR_RUNTIME_HELPER_STRING_PRIMITIVE {
        return 1;
    }
    return 0;
}

fn mir_c99_runtime_helper_is_print_stdout(helper_id: i32) i32 {
    if helper_id == MIR_RUNTIME_HELPER_PRINT ||
       helper_id == MIR_RUNTIME_HELPER_PRINTLN {
        return 1;
    }
    return 0;
}

fn mir_c99_runtime_helper_is_heap_allocator(helper_id: i32) i32 {
    if helper_id == MIR_RUNTIME_HELPER_MALLOC ||
       helper_id == MIR_RUNTIME_HELPER_FREE {
        return 1;
    }
    return 0;
}

fn mir_c99_runtime_helper_is_env_file_io(helper_id: i32) i32 {
    if helper_id == MIR_RUNTIME_HELPER_ENV ||
       helper_id == MIR_RUNTIME_HELPER_FILE_IO {
        return 1;
    }
    return 0;
}

fn mir_c99_runtime_helper_is_syscall(helper_id: i32) i32 {
    if helper_id == MIR_RUNTIME_HELPER_SYSCALL {
        return 1;
    }
    return 0;
}

fn mir_c99_runtime_helper_is_supported(helper_id: i32) i32 {
    if mir_c99_runtime_helper_is_memory_string(helper_id) != 0 ||
       mir_c99_runtime_helper_is_print_stdout(helper_id) != 0 ||
       mir_c99_runtime_helper_is_heap_allocator(helper_id) != 0 ||
       mir_c99_runtime_helper_is_env_file_io(helper_id) != 0 ||
       mir_c99_runtime_helper_is_syscall(helper_id) != 0 {
        return 1;
    }
    return 0;
}

fn mir_c99_runtime_helper_plan_async_frame_inst(inst: &MirInst,
    module: &PortableMirModule, mir_plan: &MirC99Plan, unit: &MirC99Unit,
    helper_plan: &MirC99RuntimeHelperPlan) i32 {
    if inst == null || module == null || mir_plan == null || unit == null ||
       helper_plan == null {
        return -1;
    }
    if portable_mir_inst_op_is_async_frame(inst.op) == 0 {
        return 0;
    }
    if (inst.runtime_capability_mask & MIR_RUNTIME_CAP_ASYNC_FRAME) == 0 ||
       portable_mir_target_profile_supports_runtime_capability(&module.target_profile,
           MIR_RUNTIME_CAP_ASYNC_FRAME) == 0 {
        helper_plan.reject_count = helper_plan.reject_count + 1usize;
        return -1;
    }
    if mir_c99_plan_append_ref(mir_plan, MIR_C99_REF_KIND_HELPER,
           inst.op, inst.inst_id, inst.flags) != 0 ||
       mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_HELPER,
           inst.op, inst.inst_id, inst.flags) != 0 {
        helper_plan.reject_count = helper_plan.reject_count + 1usize;
        return -1;
    }
    helper_plan.helper_count = helper_plan.helper_count + 1usize;
    helper_plan.async_frame_pool.helper_ref_count =
        helper_plan.async_frame_pool.helper_ref_count + 1usize;
    return 0;
}

fn mir_c99_runtime_helper_plan_async_frame_pool(request: &MirTargetBackendRequest,
    helper_plan: &MirC99RuntimeHelperPlan) i32 {
    if request == null || request.module == null || helper_plan == null {
        return -1;
    }
    const module: &PortableMirModule = request.module;
    var required: i32 = 0;
    if module.async_frame_metas.count > 0usize {
        required = 1;
    }
    var i: usize = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = mir_c99_runtime_helper_inst_ptr(module, i);
        if inst != null && portable_mir_inst_op_is_async_frame(inst.op) != 0 {
            required = 1;
        }
        i = i + 1usize;
    }
    helper_plan.async_frame_pool.required = required;
    helper_plan.async_frame_pool.async_frame_stack_limit =
        MIR_C99_ASYNC_FRAME_POOL_DEFAULT_STACK_LIMIT;
    helper_plan.async_frame_pool.async_frame_heap_fallback_enabled = 0;
    if (request.flags & MIR_TARGET_BACKEND_FLAG_ASYNC_FRAME_HEAP_FALLBACK) != 0 {
        helper_plan.async_frame_pool.async_frame_heap_fallback_enabled = 1;
    }
    helper_plan.async_frame_pool.status = MIR_C99_RUNTIME_HELPER_STATUS_READY;
    helper_plan.async_frame_pool.flags = request.flags;
    return 0;
}

fn mir_c99_runtime_helper_plan_async_frames(module: &PortableMirModule,
    mir_plan: &MirC99Plan, unit: &MirC99Unit,
    helper_plan: &MirC99RuntimeHelperPlan) i32 {
    if module == null || mir_plan == null || unit == null || helper_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = mir_c99_runtime_helper_inst_ptr(module, i);
        if inst != null &&
           mir_c99_runtime_helper_plan_async_frame_inst(inst, module, mir_plan,
               unit, helper_plan) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：初始化 MIR-C99 runtime helper 计划。
/// 参数说明：`plan` 为输出计划。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_runtime_helper_plan_init(plan: &MirC99RuntimeHelperPlan) i32 {
    if plan == null {
        return -1;
    }
    plan.helper_count = 0usize;
    plan.reject_count = 0usize;
    plan.async_frame_pool = MirC99AsyncFramePoolPlan{
        required: 0,
        async_frame_heap_fallback_enabled: 0,
        async_frame_stack_limit: MIR_C99_ASYNC_FRAME_POOL_DEFAULT_STACK_LIMIT,
        helper_ref_count: 0usize,
        status: MIR_C99_RUNTIME_HELPER_STATUS_READY,
        flags: 0,
    };
    return 0;
}

/// 功能说明：从 MIR capability requirements 构建 runtime helper refs。
/// 参数说明：`request` 为 verifier-clean MIR-C99 backend 请求，`mir_plan` 和 `unit` 为输出 ref 表，`helper_plan` 为统计计划。
/// 返回值说明：成功返回 `0`；目标 profile 不支持 helper capability 或追加失败返回 `-1`。
export fn mir_c99_runtime_helper_plan_build(request: &MirTargetBackendRequest,
    mir_plan: &MirC99Plan, unit: &MirC99Unit,
    helper_plan: &MirC99RuntimeHelperPlan) i32 {
    if request == null || request.module == null || mir_plan == null ||
       unit == null || helper_plan == null {
        return -1;
    }
    const module: &PortableMirModule = request.module;
    var status: i32 = 0;
    if mir_c99_runtime_helper_plan_async_frame_pool(request, helper_plan) != 0 {
        status = -1;
    }
    var i: usize = 0usize;
    while i < module.capability_reqs.count {
        const req: &MirCapabilityReq =
            mir_c99_runtime_helper_capability_req_ptr(module, i);
        if req != null &&
           mir_c99_runtime_helper_is_supported(req.capability_id) != 0 {
            const required_cap: i32 =
                mir_c99_runtime_helper_required_capability(req.capability_id);
            if portable_mir_target_profile_supports_runtime_capability(
                &module.target_profile, required_cap) == 0 {
                helper_plan.reject_count = helper_plan.reject_count + 1usize;
                status = -1;
            } else if mir_c99_plan_append_ref(mir_plan, MIR_C99_REF_KIND_HELPER,
                       req.capability_id, req.capability_req_id, req.flags) != 0 ||
                      mir_c99_unit_append_ref(unit, MIR_C99_REF_KIND_HELPER,
                       req.capability_id, req.capability_req_id, req.flags) != 0 {
                helper_plan.reject_count = helper_plan.reject_count + 1usize;
                status = -1;
            } else {
                helper_plan.helper_count = helper_plan.helper_count + 1usize;
            }
        }
        i = i + 1usize;
    }
    if mir_c99_runtime_helper_plan_async_frames(module, mir_plan, unit,
       helper_plan) != 0 {
        status = -1;
    }
    return status;
}
