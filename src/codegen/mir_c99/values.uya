// codegen/mir_c99/values.uya - MIR value to MIR-C99 temporary plan.

use codegen.mir_c99.plan;

export const MIR_C99_VALUE_TEMP_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_VALUE_TEMP_KIND_BOOL: i32 = 1;
export const MIR_C99_VALUE_TEMP_KIND_I32: i32 = 2;
export const MIR_C99_VALUE_TEMP_KIND_BYTE: i32 = 3;
export const MIR_C99_VALUE_TEMP_KIND_USIZE: i32 = 4;
export const MIR_C99_VALUE_TEMP_KIND_ISIZE: i32 = 5;
export const MIR_C99_VALUE_TEMP_KIND_F32: i32 = 6;
export const MIR_C99_VALUE_TEMP_KIND_F64: i32 = 7;
export const MIR_C99_VALUE_TEMP_KIND_POINTER: i32 = 8;

export const MIR_C99_VALUE_TEMP_STATUS_MISSING: i32 = 0;
export const MIR_C99_VALUE_TEMP_STATUS_READY: i32 = 1;
export const MIR_C99_VALUE_TEMP_STATUS_REJECT: i32 = 2;

export const MIR_C99_CONSTANT_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_CONSTANT_KIND_I32_LITERAL: i32 = 1;
export const MIR_C99_CONSTANT_KIND_ZERO: i32 = 2;
export const MIR_C99_CONSTANT_KIND_NULL: i32 = 3;

export const MIR_C99_CONSTANT_STATUS_MISSING: i32 = 0;
export const MIR_C99_CONSTANT_STATUS_READY: i32 = 1;
export const MIR_C99_CONSTANT_STATUS_REJECT: i32 = 2;

export const MIR_C99_EXPR_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_EXPR_KIND_I32_ADD: i32 = 1;
export const MIR_C99_EXPR_KIND_I32_LE: i32 = 2;
export const MIR_C99_EXPR_KIND_INT_ARITH: i32 = 3;
export const MIR_C99_EXPR_KIND_INT_COMPARE: i32 = 4;
export const MIR_C99_EXPR_KIND_INT_UNARY: i32 = 5;
export const MIR_C99_EXPR_KIND_BOOL_LOGIC: i32 = 6;

export const MIR_C99_EXPR_STATUS_MISSING: i32 = 0;
export const MIR_C99_EXPR_STATUS_READY: i32 = 1;
export const MIR_C99_EXPR_STATUS_REJECT: i32 = 2;

/// 功能说明：记录一个 MIR value 到 MIR-C99 C temp 的稳定映射。
/// 参数说明：无；字段保存 MIR value/type/local/defining-inst ID 和 C temp source id。
/// 返回值说明：无；由 `MirC99ValuePlan.entries` 动态保存。
export struct MirC99ValueTemp {
    value_id: MirValueId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    type_id: MirTypeId,
    c_temp_source_id: i32,
    c_temp_kind: i32,
    local_id: MirLocalId,
    defining_inst_id: MirInstId,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR operand literal 到 MIR-C99 常量表达式的稳定映射。
/// 参数说明：无；字段保存 operand/type、立即数 payload 和常量类别。
/// 返回值说明：无；由 `MirC99ValuePlan.constants` 动态保存。
export struct MirC99ConstantEntry {
    operand_id: MirOperandId,
    type_id: MirTypeId,
    c_literal_source_id: i32,
    constant_kind: i32,
    immediate_i32: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR instruction 到 MIR-C99 C 表达式的稳定映射。
/// 参数说明：无；字段保存 inst/result/operand ID 和表达式类别。
/// 返回值说明：无；由 `MirC99ValuePlan.expressions` 动态保存。
export struct MirC99ExpressionEntry {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    result_value_id: MirValueId,
    type_id: MirTypeId,
    expr_kind: i32,
    lhs_operand_id: MirOperandId,
    rhs_operand_id: MirOperandId,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 value/temp 计划。
/// 参数说明：无；`entries` 按 MIR value 顺序追加 temp 映射，`constants` 和 `expressions` 记录 operand/inst 映射。
/// 返回值说明：无；调用 `mir_c99_value_plan_init` 后使用。
export struct MirC99ValuePlan {
    entries: SemanticVector,
    constants: SemanticVector,
    expressions: SemanticVector,
    count: usize,
    constant_count: usize,
    expression_count: usize,
    reject_count: usize,
}

fn mir_c99_value_type_ptr(module: &PortableMirModule, type_id: MirTypeId) &MirType {
    const type_index: i32 = type_id as i32;
    if module == null || type_index < 0 || (type_index as usize) >= module.types.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.types, type_index as usize) as &MirType;
}

fn mir_c99_value_temp_kind_for_type(typ: &MirType) i32 {
    if typ == null {
        return MIR_C99_VALUE_TEMP_KIND_UNSUPPORTED;
    }
    if typ.kind == MIR_TYPE_KIND_BOOL {
        return MIR_C99_VALUE_TEMP_KIND_BOOL;
    }
    if typ.kind == MIR_TYPE_KIND_I32 {
        return MIR_C99_VALUE_TEMP_KIND_I32;
    }
    if typ.kind == MIR_TYPE_KIND_USIZE {
        return MIR_C99_VALUE_TEMP_KIND_USIZE;
    }
    if typ.kind == MIR_TYPE_KIND_POINTER {
        return MIR_C99_VALUE_TEMP_KIND_POINTER;
    }
    return MIR_C99_VALUE_TEMP_KIND_UNSUPPORTED;
}

fn mir_c99_operand_is_constant_literal(operand: &MirOperand) i32 {
    if operand == null {
        return 0;
    }
    const value_id: MirValueId = operand.value_id;
    const local_id: MirLocalId = operand.local_id;
    if value_id == MIR_VALUE_INVALID_ID && local_id == MIR_LOCAL_INVALID_ID {
        return 1;
    }
    return 0;
}

fn mir_c99_constant_kind_for_operand(typ: &MirType, operand: &MirOperand) i32 {
    if typ == null || operand == null || mir_c99_operand_is_constant_literal(operand) == 0 {
        return MIR_C99_CONSTANT_KIND_UNSUPPORTED;
    }
    if operand.immediate_i32 == 0 && typ.kind == MIR_TYPE_KIND_POINTER {
        return MIR_C99_CONSTANT_KIND_NULL;
    }
    if operand.immediate_i32 == 0 {
        return MIR_C99_CONSTANT_KIND_ZERO;
    }
    if typ.kind == MIR_TYPE_KIND_I32 {
        return MIR_C99_CONSTANT_KIND_I32_LITERAL;
    }
    return MIR_C99_CONSTANT_KIND_UNSUPPORTED;
}

fn mir_c99_expression_kind_for_inst(inst: &MirInst) i32 {
    if inst == null {
        return MIR_C99_EXPR_KIND_UNSUPPORTED;
    }
    if inst.op == MIR_INST_OP_I32_ADD {
        return MIR_C99_EXPR_KIND_I32_ADD;
    }
    if inst.op == MIR_INST_OP_I32_LE {
        return MIR_C99_EXPR_KIND_I32_LE;
    }
    if portable_mir_inst_op_is_integer_arithmetic(inst.op) != 0 {
        return MIR_C99_EXPR_KIND_INT_ARITH;
    }
    if portable_mir_inst_op_is_integer_compare(inst.op) != 0 {
        return MIR_C99_EXPR_KIND_INT_COMPARE;
    }
    if portable_mir_inst_op_is_integer_unary(inst.op) != 0 {
        return MIR_C99_EXPR_KIND_INT_UNARY;
    }
    if portable_mir_inst_op_is_logic(inst.op) != 0 {
        return MIR_C99_EXPR_KIND_BOOL_LOGIC;
    }
    return MIR_C99_EXPR_KIND_UNSUPPORTED;
}

fn mir_c99_expression_has_shape(inst: &MirInst, expr_kind: i32) i32 {
    if inst == null {
        return 0;
    }
    const result_value_id: MirValueId = inst.result_value_id;
    if result_value_id == MIR_VALUE_INVALID_ID {
        return 0;
    }
    if expr_kind == MIR_C99_EXPR_KIND_INT_UNARY ||
       (expr_kind == MIR_C99_EXPR_KIND_BOOL_LOGIC &&
        inst.op == MIR_INST_OP_BOOL_NOT) {
        if inst.operand_count == 1 {
            return 1;
        }
        return 0;
    }
    if inst.operand_count == 2 {
        return 1;
    }
    return 0;
}

fn mir_c99_value_temp_from_mir(module: &PortableMirModule, value: &MirValue) MirC99ValueTemp {
    if module == null || value == null {
        return MirC99ValueTemp{
            value_id: MIR_VALUE_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            block_id: MIR_BLOCK_INVALID_ID,
            type_id: MIR_TYPE_INVALID_ID,
            c_temp_source_id: MIR_VALUE_INVALID_ID,
            c_temp_kind: MIR_C99_VALUE_TEMP_KIND_UNSUPPORTED,
            local_id: MIR_LOCAL_INVALID_ID,
            defining_inst_id: MIR_INST_INVALID_ID,
            flags: 0,
            status: MIR_C99_VALUE_TEMP_STATUS_REJECT,
        };
    }
    const typ: &MirType = mir_c99_value_type_ptr(module, value.type_id);
    const temp_kind: i32 = mir_c99_value_temp_kind_for_type(typ);
    var status: i32 = MIR_C99_VALUE_TEMP_STATUS_READY;
    if temp_kind == MIR_C99_VALUE_TEMP_KIND_UNSUPPORTED {
        status = MIR_C99_VALUE_TEMP_STATUS_REJECT;
    }
    return MirC99ValueTemp{
        value_id: value.value_id,
        function_id: value.function_id,
        block_id: value.block_id,
        type_id: value.type_id,
        c_temp_source_id: value.value_id,
        c_temp_kind: temp_kind,
        local_id: value.local_id,
        defining_inst_id: value.defining_inst_id,
        flags: value.flags,
        status: status,
    };
}

fn mir_c99_expression_entry_from_inst(inst: &MirInst) MirC99ExpressionEntry {
    if inst == null {
        return MirC99ExpressionEntry{
            inst_id: MIR_INST_INVALID_ID,
            function_id: MIR_FUNCTION_INVALID_ID,
            block_id: MIR_BLOCK_INVALID_ID,
            result_value_id: MIR_VALUE_INVALID_ID,
            type_id: MIR_TYPE_INVALID_ID,
            expr_kind: MIR_C99_EXPR_KIND_UNSUPPORTED,
            lhs_operand_id: -1,
            rhs_operand_id: -1,
            flags: 0,
            status: MIR_C99_EXPR_STATUS_REJECT,
        };
    }
    const result_value_id: MirValueId = inst.result_value_id;
    const expr_kind: i32 = mir_c99_expression_kind_for_inst(inst);
    var status: i32 = MIR_C99_EXPR_STATUS_READY;
    if expr_kind == MIR_C99_EXPR_KIND_UNSUPPORTED ||
       mir_c99_expression_has_shape(inst, expr_kind) == 0 {
        status = MIR_C99_EXPR_STATUS_REJECT;
    }
    var rhs_operand_id: MirOperandId = inst.operand_start + 1;
    if expr_kind == MIR_C99_EXPR_KIND_INT_UNARY ||
       (expr_kind == MIR_C99_EXPR_KIND_BOOL_LOGIC &&
        inst.op == MIR_INST_OP_BOOL_NOT) {
        rhs_operand_id = -1;
    }
    return MirC99ExpressionEntry{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        block_id: inst.block_id,
        result_value_id: inst.result_value_id,
        type_id: inst.type_id,
        expr_kind: expr_kind,
        lhs_operand_id: inst.operand_start,
        rhs_operand_id: rhs_operand_id,
        flags: inst.flags,
        status: status,
    };
}

fn mir_c99_constant_entry_from_operand(module: &PortableMirModule,
    operand: &MirOperand) MirC99ConstantEntry {
    if module == null || operand == null {
        return MirC99ConstantEntry{
            operand_id: -1,
            type_id: MIR_TYPE_INVALID_ID,
            c_literal_source_id: -1,
            constant_kind: MIR_C99_CONSTANT_KIND_UNSUPPORTED,
            immediate_i32: 0,
            flags: 0,
            status: MIR_C99_CONSTANT_STATUS_REJECT,
        };
    }
    const typ: &MirType = mir_c99_value_type_ptr(module, operand.type_id);
    const constant_kind: i32 = mir_c99_constant_kind_for_operand(typ, operand);
    var status: i32 = MIR_C99_CONSTANT_STATUS_READY;
    if constant_kind == MIR_C99_CONSTANT_KIND_UNSUPPORTED {
        status = MIR_C99_CONSTANT_STATUS_REJECT;
    }
    return MirC99ConstantEntry{
        operand_id: operand.operand_id,
        type_id: operand.type_id,
        c_literal_source_id: operand.operand_id,
        constant_kind: constant_kind,
        immediate_i32: operand.immediate_i32,
        flags: operand.flags,
        status: status,
    };
}

/// 功能说明：初始化 MIR-C99 value/temp 计划。
/// 参数说明：`plan` 为输出计划。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_value_plan_init(plan: &MirC99ValuePlan) i32 {
    if plan == null {
        return -1;
    }
    semantic_vector_init(&plan.entries, @size_of(MirC99ValueTemp));
    semantic_vector_init(&plan.constants, @size_of(MirC99ConstantEntry));
    semantic_vector_init(&plan.expressions, @size_of(MirC99ExpressionEntry));
    plan.count = 0usize;
    plan.constant_count = 0usize;
    plan.expression_count = 0usize;
    plan.reject_count = 0usize;
    return 0;
}

/// 功能说明：释放 MIR-C99 value/temp 计划。
/// 参数说明：`plan` 为待释放计划；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_value_plan_release(plan: &MirC99ValuePlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.entries);
    semantic_vector_release(&plan.constants);
    semantic_vector_release(&plan.expressions);
    plan.count = 0usize;
    plan.constant_count = 0usize;
    plan.expression_count = 0usize;
    plan.reject_count = 0usize;
}

/// 功能说明：向 MIR-C99 value/temp 计划追加一个 MIR value 映射。
/// 参数说明：`value_plan` 为输出计划，`module` 提供 MIR type metadata，`value` 为 MIR value。
/// 返回值说明：成功返回 `0`，追加失败或 unsupported value type 返回 `-1`。
export fn mir_c99_value_plan_append(value_plan: &MirC99ValuePlan,
    module: &PortableMirModule, value: &MirValue) i32 {
    if value_plan == null || module == null || value == null {
        return -1;
    }
    const entry: MirC99ValueTemp = mir_c99_value_temp_from_mir(module, value);
    if semantic_vector_append(&value_plan.entries, &entry as &const void) != 0 {
        return -1;
    }
    value_plan.count = value_plan.entries.count;
    if entry.status == MIR_C99_VALUE_TEMP_STATUS_REJECT {
        value_plan.reject_count = value_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 表达式计划追加一个 MIR instruction 映射。
/// 参数说明：`value_plan` 为输出计划，`inst` 为 MIR instruction。
/// 返回值说明：成功追加当前支持表达式返回 `0`；非表达式 instruction 返回 `0` 且不追加；追加失败返回 `-1`。
export fn mir_c99_value_plan_append_expression(value_plan: &MirC99ValuePlan,
    inst: &MirInst) i32 {
    if value_plan == null || inst == null {
        return -1;
    }
    const entry: MirC99ExpressionEntry = mir_c99_expression_entry_from_inst(inst);
    if entry.status == MIR_C99_EXPR_STATUS_REJECT {
        return 0;
    }
    if semantic_vector_append(&value_plan.expressions, &entry as &const void) != 0 {
        return -1;
    }
    value_plan.expression_count = value_plan.expressions.count;
    return 0;
}

/// 功能说明：向 MIR-C99 常量计划追加一个 MIR operand literal 映射。
/// 参数说明：`value_plan` 为输出计划，`module` 提供 MIR type metadata，`operand` 为 MIR operand。
/// 返回值说明：成功追加常量返回 `0`；非常量 operand 返回 `0` 且不追加；追加失败返回 `-1`。
export fn mir_c99_value_plan_append_constant(value_plan: &MirC99ValuePlan,
    module: &PortableMirModule, operand: &MirOperand) i32 {
    if value_plan == null || module == null || operand == null {
        return -1;
    }
    if mir_c99_operand_is_constant_literal(operand) == 0 {
        return 0;
    }
    const entry: MirC99ConstantEntry = mir_c99_constant_entry_from_operand(module, operand);
    if entry.status == MIR_C99_CONSTANT_STATUS_REJECT {
        return 0;
    }
    if semantic_vector_append(&value_plan.constants, &entry as &const void) != 0 {
        return -1;
    }
    value_plan.constant_count = value_plan.constants.count;
    return 0;
}

/// 功能说明：从 PortableMIR module 的 value metadata 构建 MIR-C99 C temp 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`value_plan` 为输出 temp 计划。
/// 返回值说明：所有 value 都映射成功返回 `0`，遇到 unsupported value 或参数非法返回 `-1`。
export fn mir_c99_value_plan_build(module: &PortableMirModule,
    value_plan: &MirC99ValuePlan) i32 {
    if module == null || value_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.values.count {
        const value: &MirValue = semantic_vector_item_ptr(&module.values, i) as &MirValue;
        if mir_c99_value_plan_append(value_plan, module, value) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 PortableMIR module 的 instruction metadata 构建 MIR-C99 C 表达式计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`value_plan` 为输出 value/expression 计划。
/// 返回值说明：所有当前支持 instruction 都映射成功返回 `0`，参数非法或追加失败返回 `-1`。
export fn mir_c99_value_plan_build_expressions(module: &PortableMirModule,
    value_plan: &MirC99ValuePlan) i32 {
    if module == null || value_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = semantic_vector_item_ptr(&module.insts, i) as &MirInst;
        if mir_c99_value_plan_append_expression(value_plan, inst) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：从 PortableMIR module 的 operand metadata 构建 MIR-C99 常量表达式计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`value_plan` 为输出 value/constant 计划。
/// 返回值说明：所有可识别常量都映射成功返回 `0`，参数非法或追加失败返回 `-1`。
export fn mir_c99_value_plan_build_constants(module: &PortableMirModule,
    value_plan: &MirC99ValuePlan) i32 {
    if module == null || value_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.operands.count {
        const operand: &MirOperand = semantic_vector_item_ptr(&module.operands, i) as &MirOperand;
        if mir_c99_value_plan_append_constant(value_plan, module, operand) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：按下标读取 MIR-C99 value/temp 计划条目。
/// 参数说明：`value_plan` 为 temp 计划，`index` 为条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_value_plan_entry_ptr(value_plan: &MirC99ValuePlan, index: i32) &MirC99ValueTemp {
    if value_plan == null || index < 0 || (index as usize) >= value_plan.entries.count {
        return null;
    }
    return semantic_vector_item_ptr(&value_plan.entries, index as usize) as &MirC99ValueTemp;
}

/// 功能说明：按下标读取 MIR-C99 expression 计划条目。
/// 参数说明：`value_plan` 为 value/expression 计划，`index` 为表达式条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_value_plan_expression_ptr(value_plan: &MirC99ValuePlan, index: i32) &MirC99ExpressionEntry {
    if value_plan == null || index < 0 || (index as usize) >= value_plan.expressions.count {
        return null;
    }
    return semantic_vector_item_ptr(&value_plan.expressions, index as usize) as &MirC99ExpressionEntry;
}

/// 功能说明：按下标读取 MIR-C99 constant 计划条目。
/// 参数说明：`value_plan` 为 temp/constant 计划，`index` 为常量条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_value_plan_constant_ptr(value_plan: &MirC99ValuePlan, index: i32) &MirC99ConstantEntry {
    if value_plan == null || index < 0 || (index as usize) >= value_plan.constants.count {
        return null;
    }
    return semantic_vector_item_ptr(&value_plan.constants, index as usize) as &MirC99ConstantEntry;
}
