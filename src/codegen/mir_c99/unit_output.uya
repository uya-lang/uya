// codegen/mir_c99/unit_output.uya - Single-unit MIR-C99 output writer contract.

use codegen.mir_c99.cfg;
use codegen.mir_c99.plan;
use lower.mir;
use libc.FILE;
use libc.fputc;
use libc.fputs;

export const MIR_C99_OUTPUT_SECTION_INCLUDE: i32 = 1;
export const MIR_C99_OUTPUT_SECTION_TYPEDEF: i32 = 2;
export const MIR_C99_OUTPUT_SECTION_EXTERN_PROTOTYPE: i32 = 3;
export const MIR_C99_OUTPUT_SECTION_FUNCTION_PROTOTYPE: i32 = 4;
export const MIR_C99_OUTPUT_SECTION_GLOBAL: i32 = 5;
export const MIR_C99_OUTPUT_SECTION_FUNCTION_BODY: i32 = 6;
export const MIR_C99_OUTPUT_SECTION_DEP: i32 = 7;

export const MIR_C99_OUTPUT_STATUS_ERROR: i32 = -1;
export const MIR_C99_OUTPUT_STATUS_READY: i32 = 1;
export const MIR_C99_OUTPUT_STATUS_DONE: i32 = 2;

/// 功能说明：记录 MIR-C99 单 unit 输出 writer 的 section 统计。
/// 参数说明：无；字段按固定 section 顺序累计 ref count 和 C byte 估算。
/// 返回值说明：无。
export struct MirC99UnitOutputStats {
    include_count: usize,
    typedef_count: usize,
    extern_prototype_count: usize,
    function_prototype_count: usize,
    global_count: usize,
    function_body_count: usize,
    helper_count: usize,
    dep_count: usize,
    section_count: i32,
    output_bytes: usize,
}

/// 功能说明：记录 MIR-C99 单 unit 输出 writer 状态。
/// 参数说明：无；writer 只保存 MIR-C99 plan/unit 指针，不读取高层 body 或 legacy C backend。
/// 返回值说明：无。
export struct MirC99UnitOutputWriter {
    status: i32,
    module: &PortableMirModule,
    plan: &MirC99Plan,
    unit: &MirC99Unit,
    cfg_plan: &MirC99CfgPlan,
    stats: MirC99UnitOutputStats,
    diagnostic_code: i32,
}

fn mir_c99_unit_output_ref_ptr(vec: &SemanticVector, index: usize) &MirC99Ref {
    if vec == null || index >= vec.count {
        return null;
    }
    return semantic_vector_item_ptr(vec, index) as &MirC99Ref;
}

fn mir_c99_unit_output_write(stream: &FILE, text: &byte) i32 {
    if stream == null || text == null {
        return -1;
    }
    if fputs(text as *byte, stream as *void) < 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_i32(stream: &FILE, value: i32) i32 {
    if stream == null {
        return -1;
    }
    if value == 0 {
        if fputc(48, stream as *void) < 0 {
            return -1;
        }
        return 0;
    }
    var v: i32 = value;
    if v < 0 {
        if fputc(45, stream as *void) < 0 {
            return -1;
        }
        v = 0 - v;
    }
    var digits: [i32: 20] = [];
    var count: i32 = 0;
    while v > 0 && count < 20 {
        digits[count] = v % 10;
        v = v / 10;
        count = count + 1;
    }
    var i: i32 = count - 1;
    while i >= 0 {
        if fputc(48 + digits[i], stream as *void) < 0 {
            return -1;
        }
        i = i - 1;
    }
    return 0;
}

fn mir_c99_unit_output_write_i64(stream: &FILE, value: i64) i32 {
    if stream == null {
        return -1;
    }
    if value == 0i64 {
        if fputc(48, stream as *void) < 0 {
            return -1;
        }
        return 0;
    }
    var v: i64 = value;
    if v < 0i64 {
        if fputc(45, stream as *void) < 0 {
            return -1;
        }
        v = 0i64 - v;
    }
    var digits: [i32: 32] = [];
    var count: i32 = 0;
    while v > 0i64 && count < 32 {
        const digit_tmp: !i32 = (v % 10i64) as! i32;
        const digit: i32 = digit_tmp catch { return -1; };
        digits[count] = digit;
        v = v / 10i64;
        count = count + 1;
    }
    var i: i32 = count - 1;
    while i >= 0 {
        if fputc(48 + digits[i], stream as *void) < 0 {
            return -1;
        }
        i = i - 1;
    }
    return 0;
}

fn mir_c99_unit_output_write_c_string_byte(stream: &FILE, ch: byte) i32 {
    if stream == null {
        return -1;
    }
    if ch == 34 as byte {
        return mir_c99_unit_output_write(stream, "\\\"" as &byte);
    }
    if ch == 92 as byte {
        return mir_c99_unit_output_write(stream, "\\\\" as &byte);
    }
    if ch == 10 as byte {
        return mir_c99_unit_output_write(stream, "\\n" as &byte);
    }
    if ch == 13 as byte {
        return mir_c99_unit_output_write(stream, "\\r" as &byte);
    }
    if ch == 9 as byte {
        return mir_c99_unit_output_write(stream, "\\t" as &byte);
    }
    if fputc(ch as i32, stream as *void) < 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_c_string_literal(stream: &FILE,
    text: &byte, byte_count: usize) i32 {
    if stream == null || text == null {
        return -1;
    }
    if fputc(34, stream as *void) < 0 {
        return -1;
    }
    var i: usize = 0usize;
    while i < byte_count {
        if mir_c99_unit_output_write_c_string_byte(stream, text[i]) != 0 {
            return -1;
        }
        i = i + 1usize;
    }
    if fputc(34, stream as *void) < 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_ref_line(stream: &FILE, prefix: &byte, ref: &MirC99Ref, suffix: &byte) i32 {
    if stream == null || prefix == null || ref == null || suffix == null {
        return -1;
    }
    if fputs(prefix as *byte, stream as *void) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_i32(stream, ref.source_id) != 0 {
        return -1;
    }
    if fputs(suffix as *byte, stream as *void) < 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_global_initializer_ptr(writer: &MirC99UnitOutputWriter,
    ref: &MirC99Ref) &MirC99GlobalInitializerPlanEntry {
    if writer == null || writer.plan == null || ref == null ||
       ref.kind != MIR_C99_REF_KIND_GLOBAL {
        return null;
    }
    return mir_c99_global_initializer_plan_ptr(writer.plan, ref.aux_id);
}

fn mir_c99_unit_output_write_global_initializer(writer: &MirC99UnitOutputWriter,
    stream: &FILE, ref: &MirC99Ref) i32 {
    if writer == null || stream == null || ref == null {
        return -1;
    }
    const init: &MirC99GlobalInitializerPlanEntry =
        mir_c99_unit_output_global_initializer_ptr(writer, ref);
    if init == null || init.status != MIR_C99_GLOBAL_INIT_STATUS_READY ||
       (init.global_id as i32) != ref.source_id {
        return -1;
    }
    if init.init_kind == MIR_GLOBAL_INIT_EXTERN {
        if init.linkage != MIR_GLOBAL_LINKAGE_EXTERN ||
           init.const_id != MIR_CONST_INVALID_ID {
            return -1;
        }
        if mir_c99_unit_output_write(stream, "extern int64_t uya_mir_global_" as &byte) != 0 ||
           mir_c99_unit_output_write_i32(stream, init.global_id) != 0 ||
           mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
            return -1;
        }
        return 0;
    }
    if init.init_kind == MIR_GLOBAL_INIT_SCALAR {
        if mir_c99_unit_output_write(stream, "static int64_t uya_mir_global_" as &byte) != 0 ||
           mir_c99_unit_output_write_i32(stream, init.global_id) != 0 ||
           mir_c99_unit_output_write(stream, " = " as &byte) != 0 ||
           mir_c99_unit_output_write_i64(stream, init.scalar_i64) != 0 ||
           mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
            return -1;
        }
        return 0;
    }
    if init.init_kind == MIR_GLOBAL_INIT_AGGREGATE {
        if init.byte_count == 0usize {
            return -1;
        }
        if mir_c99_unit_output_write(stream, "static uint8_t uya_mir_global_" as &byte) != 0 ||
           mir_c99_unit_output_write_i32(stream, init.global_id) != 0 ||
           mir_c99_unit_output_write(stream, "[" as &byte) != 0 ||
           mir_c99_unit_output_write_i32(stream, init.byte_count as i32) != 0 ||
           mir_c99_unit_output_write(stream, "] = { 0 };\n" as &byte) != 0 {
            return -1;
        }
        return 0;
    }
    if init.init_kind == MIR_GLOBAL_INIT_STRING {
        if init.byte_count == 0usize || init.dedupe_id < 0 ||
           init.string_data == null {
            return -1;
        }
        if mir_c99_unit_output_write(stream, "static const char uya_mir_string_" as &byte) != 0 ||
           mir_c99_unit_output_write_i32(stream, init.dedupe_id) != 0 ||
           mir_c99_unit_output_write(stream, "[" as &byte) != 0 ||
           mir_c99_unit_output_write_i32(stream, (init.byte_count + 1usize) as i32) != 0 ||
           mir_c99_unit_output_write(stream, "] = " as &byte) != 0 ||
           mir_c99_unit_output_write_c_string_literal(stream, init.string_data,
            init.byte_count) != 0 ||
           mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
            return -1;
        }
        return 0;
    }
    return -1;
}

fn mir_c99_unit_output_write_ref_table(stream: &FILE, vec: &SemanticVector,
    prefix: &byte, suffix: &byte) i32 {
    if stream == null || vec == null || prefix == null || suffix == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < vec.count {
        const ref: &MirC99Ref = mir_c99_unit_output_ref_ptr(vec, i);
        if mir_c99_unit_output_write_ref_line(stream, prefix, ref, suffix) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

fn mir_c99_unit_output_write_unit_i32(stream: &FILE, unit: &MirC99Unit) i32 {
    if stream == null || unit == null {
        return -1;
    }
    return mir_c99_unit_output_write_i32(stream, unit.unit_id);
}

fn mir_c99_unit_output_function_plan_ptr(writer: &MirC99UnitOutputWriter,
    function_id: MirFunctionId) &MirC99FunctionPlanEntry {
    if writer == null || writer.cfg_plan == null || function_id == MIR_FUNCTION_INVALID_ID {
        return null;
    }
    var i: usize = 0usize;
    while i < writer.cfg_plan.functions.count {
        const entry: &MirC99FunctionPlanEntry =
            semantic_vector_item_ptr(&writer.cfg_plan.functions, i) as &MirC99FunctionPlanEntry;
        if entry != null && entry.function_id == function_id {
            return entry;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_unit_output_block_plan_ptr(writer: &MirC99UnitOutputWriter,
    block_id: MirBlockId) &MirC99BlockPlanEntry {
    if writer == null || writer.cfg_plan == null || block_id == MIR_BLOCK_INVALID_ID {
        return null;
    }
    var i: usize = 0usize;
    while i < writer.cfg_plan.blocks.count {
        const entry: &MirC99BlockPlanEntry =
            semantic_vector_item_ptr(&writer.cfg_plan.blocks, i) as &MirC99BlockPlanEntry;
        if entry != null && entry.block_id == block_id {
            return entry;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_unit_output_terminator_plan_ptr(writer: &MirC99UnitOutputWriter,
    terminator_id: MirTerminatorId) &MirC99TerminatorPlanEntry {
    if writer == null || writer.cfg_plan == null || terminator_id == MIR_TERMINATOR_INVALID_ID {
        return null;
    }
    var i: usize = 0usize;
    while i < writer.cfg_plan.terminators.count {
        const entry: &MirC99TerminatorPlanEntry =
            semantic_vector_item_ptr(&writer.cfg_plan.terminators, i) as &MirC99TerminatorPlanEntry;
        if entry != null && entry.terminator_id == terminator_id {
            return entry;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_unit_output_inst_ptr(writer: &MirC99UnitOutputWriter,
    inst_id: MirInstId) &MirInst {
    if writer == null || writer.module == null || inst_id < 0 ||
       (inst_id as usize) >= writer.module.insts.count {
        return null;
    }
    return semantic_vector_item_ptr(&writer.module.insts,
        inst_id as usize) as &MirInst;
}

fn mir_c99_unit_output_operand_ptr(writer: &MirC99UnitOutputWriter,
    operand_id: MirOperandId) &MirOperand {
    if writer == null || writer.module == null || operand_id < 0 ||
       (operand_id as usize) >= writer.module.operands.count {
        return null;
    }
    return semantic_vector_item_ptr(&writer.module.operands,
        operand_id as usize) as &MirOperand;
}

fn mir_c99_unit_output_type_ptr(writer: &MirC99UnitOutputWriter,
    type_id: MirTypeId) &MirType {
    if writer == null || writer.module == null || type_id < 0 ||
       (type_id as usize) >= writer.module.types.count {
        return null;
    }
    return semantic_vector_item_ptr(&writer.module.types,
        type_id as usize) as &MirType;
}

fn mir_c99_unit_output_string_initializer_for_dedupe(
    writer: &MirC99UnitOutputWriter, dedupe_id: i32) &MirC99GlobalInitializerPlanEntry {
    if writer == null || writer.plan == null || dedupe_id < 0 {
        return null;
    }
    var i: usize = 0usize;
    while i < writer.plan.global_initializers.count {
        const init: &MirC99GlobalInitializerPlanEntry =
            semantic_vector_item_ptr(&writer.plan.global_initializers,
                i) as &MirC99GlobalInitializerPlanEntry;
        if init != null && init.init_kind == MIR_GLOBAL_INIT_STRING &&
           init.dedupe_id == dedupe_id {
            return init;
        }
        i = i + 1usize;
    }
    return null;
}

fn mir_c99_unit_output_function_return_type(writer: &MirC99UnitOutputWriter,
    function: &MirC99FunctionPlanEntry) &MirType {
    if writer == null || function == null {
        return null;
    }
    const signature: &MirType =
        mir_c99_unit_output_type_ptr(writer, function.signature_type_id);
    if signature == null {
        return null;
    }
    if signature.kind == MIR_TYPE_KIND_FUNCTION {
        return mir_c99_unit_output_type_ptr(writer, signature.element_type_id);
    }
    return signature;
}

fn mir_c99_unit_output_function_signature_type(writer: &MirC99UnitOutputWriter,
    function: &MirC99FunctionPlanEntry) &MirType {
    if writer == null || function == null {
        return null;
    }
    const signature: &MirType =
        mir_c99_unit_output_type_ptr(writer, function.signature_type_id);
    if signature == null || signature.kind != MIR_TYPE_KIND_FUNCTION {
        return null;
    }
    return signature;
}

fn mir_c99_unit_output_write_function_param_types(writer: &MirC99UnitOutputWriter,
    stream: &FILE, signature: &MirType) i32 {
    if writer == null || writer.module == null || stream == null ||
       signature == null || signature.kind != MIR_TYPE_KIND_FUNCTION ||
       signature.field_start < 0 || signature.field_count < 0 {
        return -1;
    }
    if signature.field_count == 0 {
        return mir_c99_unit_output_write(stream, "void" as &byte);
    }
    var i: i32 = 0;
    while i < signature.field_count {
        const param: &MirFunctionParamType =
            semantic_vector_item_ptr(&writer.module.function_param_types,
                (signature.field_start + i) as usize) as &MirFunctionParamType;
        if param == null || param.owner_type_id != signature.type_id ||
           param.param_index != i {
            return -1;
        }
        const param_type: &MirType = mir_c99_unit_output_type_ptr(writer,
            param.type_id);
        if param_type == null ||
           mir_c99_unit_output_write_c_type(stream, param_type) != 0 {
            return -1;
        }
        if i + 1 < signature.field_count &&
           mir_c99_unit_output_write(stream, ", " as &byte) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

fn mir_c99_unit_output_write_c_type(stream: &FILE, typ: &MirType) i32 {
    if stream == null || typ == null {
        return -1;
    }
    if typ.kind == MIR_TYPE_KIND_VOID {
        return mir_c99_unit_output_write(stream, "void" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_BOOL {
        return mir_c99_unit_output_write(stream, "bool" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_I8 {
        return mir_c99_unit_output_write(stream, "int8_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_U8 || typ.kind == MIR_TYPE_KIND_BYTE {
        return mir_c99_unit_output_write(stream, "uint8_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_I16 {
        return mir_c99_unit_output_write(stream, "int16_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_U16 {
        return mir_c99_unit_output_write(stream, "uint16_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_I32 {
        return mir_c99_unit_output_write(stream, "int32_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_U32 {
        return mir_c99_unit_output_write(stream, "uint32_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_I64 {
        return mir_c99_unit_output_write(stream, "int64_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_U64 {
        return mir_c99_unit_output_write(stream, "uint64_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_ISIZE {
        return mir_c99_unit_output_write(stream, "intptr_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_USIZE {
        return mir_c99_unit_output_write(stream, "uintptr_t" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_F32 {
        return mir_c99_unit_output_write(stream, "float" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_F64 {
        return mir_c99_unit_output_write(stream, "double" as &byte);
    }
    if typ.kind == MIR_TYPE_KIND_POINTER ||
       typ.kind == MIR_TYPE_KIND_FUNCTION_POINTER {
        return mir_c99_unit_output_write(stream, "void *" as &byte);
    }
    return -1;
}

fn mir_c99_unit_output_write_function_decl_head(writer: &MirC99UnitOutputWriter,
    stream: &FILE, function: &MirC99FunctionPlanEntry) i32 {
    const return_type: &MirType =
        mir_c99_unit_output_function_return_type(writer, function);
    if return_type == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "static " as &byte) != 0 ||
       mir_c99_unit_output_write_c_type(stream, return_type) != 0 ||
       mir_c99_unit_output_write(stream, " uya_mir_fn_" as &byte) != 0 ||
       mir_c99_unit_output_write_i32(stream, function.c_name_source_id) != 0 ||
       mir_c99_unit_output_write(stream, "(void)" as &byte) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_extern_function_prototype(
    writer: &MirC99UnitOutputWriter, stream: &FILE,
    function: &MirC99FunctionPlanEntry) i32 {
    const signature: &MirType =
        mir_c99_unit_output_function_signature_type(writer, function);
    const return_type: &MirType =
        mir_c99_unit_output_function_return_type(writer, function);
    if writer == null || stream == null || function == null ||
       (function.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 ||
       function.extern_symbol_name == null || signature == null ||
       return_type == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "extern " as &byte) != 0 ||
       mir_c99_unit_output_write_c_type(stream, return_type) != 0 ||
       mir_c99_unit_output_write(stream, " " as &byte) != 0 ||
       mir_c99_unit_output_write(stream, function.extern_symbol_name) != 0 ||
       mir_c99_unit_output_write(stream, "(" as &byte) != 0 ||
       mir_c99_unit_output_write_function_param_types(writer, stream,
            signature) != 0 ||
       mir_c99_unit_output_write(stream, ");\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_value_name(stream: &FILE, value_id: MirValueId) i32 {
    if stream == null || value_id == MIR_VALUE_INVALID_ID {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "tmp" as &byte) != 0 ||
       mir_c99_unit_output_write_i32(stream, value_id) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_local_name(stream: &FILE, local_id: MirLocalId) i32 {
    if stream == null || local_id == MIR_LOCAL_INVALID_ID {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "local" as &byte) != 0 ||
       mir_c99_unit_output_write_i32(stream, local_id) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_operand_expr(writer: &MirC99UnitOutputWriter,
    stream: &FILE, operand: &MirOperand) i32 {
    if writer == null || stream == null || operand == null {
        return -1;
    }
    if operand.value_id != MIR_VALUE_INVALID_ID {
        return mir_c99_unit_output_write_value_name(stream, operand.value_id);
    }
    if operand.local_id != MIR_LOCAL_INVALID_ID {
        return mir_c99_unit_output_write_local_name(stream, operand.local_id);
    }
    return mir_c99_unit_output_write_i32(stream, operand.immediate_i32);
}

fn mir_c99_unit_output_write_function_locals(writer: &MirC99UnitOutputWriter,
    stream: &FILE, function: &MirC99FunctionPlanEntry) i32 {
    if writer == null || writer.module == null || stream == null ||
       function == null {
        return -1;
    }
    var i: usize = 0usize;
    while i < writer.module.locals.count {
        const local: &MirLocal =
            semantic_vector_item_ptr(&writer.module.locals, i) as &MirLocal;
        if local != null && local.function_id == function.function_id {
            const typ: &MirType = mir_c99_unit_output_type_ptr(writer,
                local.type_id);
            if typ == null ||
               mir_c99_unit_output_write_c_type(stream, typ) != 0 ||
               mir_c99_unit_output_write(stream, " " as &byte) != 0 ||
               mir_c99_unit_output_write_local_name(stream, local.local_id) != 0 ||
               mir_c99_unit_output_write(stream, " = 0;\n" as &byte) != 0 {
                return -1;
            }
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < writer.module.values.count {
        const value: &MirValue =
            semantic_vector_item_ptr(&writer.module.values, i) as &MirValue;
        if value != null && value.function_id == function.function_id {
            const typ2: &MirType = mir_c99_unit_output_type_ptr(writer,
                value.type_id);
            if typ2 == null ||
               mir_c99_unit_output_write_c_type(stream, typ2) != 0 ||
               mir_c99_unit_output_write(stream, " " as &byte) != 0 ||
               mir_c99_unit_output_write_value_name(stream, value.value_id) != 0 ||
               mir_c99_unit_output_write(stream, " = 0;\n" as &byte) != 0 {
                return -1;
            }
        }
        i = i + 1usize;
    }
    return 0;
}

fn mir_c99_unit_output_write_value_inst(writer: &MirC99UnitOutputWriter,
    stream: &FILE, inst: &MirInst) i32 {
    if writer == null || stream == null || inst == null ||
       inst.result_value_id == MIR_VALUE_INVALID_ID || inst.operand_count < 2 {
        return -1;
    }
    const lhs: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start);
    const rhs: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start + 1);
    if lhs == null || rhs == null ||
       mir_c99_unit_output_write_value_name(stream, inst.result_value_id) != 0 ||
       mir_c99_unit_output_write(stream, " = " as &byte) != 0 ||
       mir_c99_unit_output_write_operand_expr(writer, stream, lhs) != 0 {
        return -1;
    }
    if inst.op == MIR_INST_OP_I32_ADD {
        if mir_c99_unit_output_write(stream, " + " as &byte) != 0 {
            return -1;
        }
    } else if inst.op == MIR_INST_OP_I32_EQ {
        if mir_c99_unit_output_write(stream, " == " as &byte) != 0 {
            return -1;
        }
    } else if inst.op == MIR_INST_OP_I32_LE {
        if mir_c99_unit_output_write(stream, " <= " as &byte) != 0 {
            return -1;
        }
    } else {
        return -1;
    }
    if mir_c99_unit_output_write_operand_expr(writer, stream, rhs) != 0 ||
       mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_local_set_inst(writer: &MirC99UnitOutputWriter,
    stream: &FILE, inst: &MirInst) i32 {
    if writer == null || stream == null || inst == null ||
       inst.op != MIR_INST_OP_LOCAL_SET || inst.operand_count != 2 {
        return -1;
    }
    const dest: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start);
    const source: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start + 1);
    if dest == null || source == null || dest.local_id == MIR_LOCAL_INVALID_ID ||
       mir_c99_unit_output_write_local_name(stream, dest.local_id) != 0 ||
       mir_c99_unit_output_write(stream, " = " as &byte) != 0 ||
       mir_c99_unit_output_write_operand_expr(writer, stream, source) != 0 ||
       mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_print_call(writer: &MirC99UnitOutputWriter,
    stream: &FILE, inst: &MirInst) i32 {
    if writer == null || stream == null || inst == null ||
       inst.op != MIR_INST_OP_CALL || inst.operand_count < 2 {
        return -1;
    }
    if inst.flags == MIR_EXTERN_HOSTED_HELPER_UYA_WRITE_NEWLINE {
        if mir_c99_unit_output_write(stream, "fputc('\\n', stdout);\n" as &byte) != 0 {
            return -1;
        }
        return 1;
    }
    if inst.flags != MIR_EXTERN_HOSTED_HELPER_UYA_WRITE_STR ||
       inst.operand_count < 4 {
        return 0;
    }
    const ptr_operand: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start + 2);
    const len_operand: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start + 3);
    if ptr_operand == null || len_operand == null ||
       ptr_operand.immediate_i32 < 0 || len_operand.immediate_i32 < 0 {
        return -1;
    }
    const init: &MirC99GlobalInitializerPlanEntry =
        mir_c99_unit_output_string_initializer_for_dedupe(writer,
            ptr_operand.immediate_i32);
    if init == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream,
        "fwrite(uya_mir_string_" as &byte) != 0 ||
       mir_c99_unit_output_write_i32(stream, init.dedupe_id) != 0 ||
       mir_c99_unit_output_write(stream, ", 1, " as &byte) != 0 ||
       mir_c99_unit_output_write_i32(stream, len_operand.immediate_i32) != 0 ||
       mir_c99_unit_output_write(stream, ", stdout);\n" as &byte) != 0 {
        return -1;
    }
    return 1;
}

fn mir_c99_unit_output_mir_function_ptr(writer: &MirC99UnitOutputWriter,
    function_id: MirFunctionId) &MirFunction {
    const index: i32 = function_id as i32;
    if writer == null || writer.module == null || index < 0 ||
       (index as usize) >= writer.module.functions.count {
        return null;
    }
    return semantic_vector_item_ptr(&writer.module.functions,
        index as usize) as &MirFunction;
}

fn mir_c99_unit_output_write_extern_call(writer: &MirC99UnitOutputWriter,
    stream: &FILE, inst: &MirInst) i32 {
    if writer == null || writer.module == null || stream == null ||
       inst == null || inst.op != MIR_INST_OP_CALL || inst.operand_count <= 0 {
        return -1;
    }
    const target: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
        inst.operand_start);
    if target == null {
        return -1;
    }
    if target.kind == MIR_OPERAND_KIND_CALL_TARGET_EXTERN {
    } else {
        return 0;
    }
    const callee_mir: &MirFunction = mir_c99_unit_output_mir_function_ptr(writer,
        target.immediate_i32);
    const callee_function: &MirC99FunctionPlanEntry =
        mir_c99_unit_output_function_plan_ptr(writer, target.immediate_i32);
    const signature: &MirType = mir_c99_unit_output_function_signature_type(writer,
        callee_function);
    const return_type: &MirType = mir_c99_unit_output_function_return_type(writer,
        callee_function);
    if callee_mir == null || callee_function == null ||
       (callee_mir.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 ||
       callee_function.extern_symbol_name == null || signature == null ||
       return_type == null || signature.field_count != inst.operand_count - 1 {
        return -1;
    }
    if inst.result_value_id != MIR_VALUE_INVALID_ID {
        if return_type.kind == MIR_TYPE_KIND_VOID ||
           mir_c99_unit_output_write_value_name(stream,
                inst.result_value_id) != 0 ||
           mir_c99_unit_output_write(stream, " = " as &byte) != 0 {
            return -1;
        }
    } else if return_type.kind != MIR_TYPE_KIND_VOID {
        return -1;
    }
    if mir_c99_unit_output_write(stream,
        callee_function.extern_symbol_name) != 0 ||
       mir_c99_unit_output_write(stream, "(" as &byte) != 0 {
        return -1;
    }
    var i: i32 = 1;
    while i < inst.operand_count {
        const arg: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
            inst.operand_start + i);
        if arg == null ||
           mir_c99_unit_output_write_operand_expr(writer, stream, arg) != 0 {
            return -1;
        }
        if i + 1 < inst.operand_count &&
           mir_c99_unit_output_write(stream, ", " as &byte) != 0 {
            return -1;
        }
        i = i + 1;
    }
    if mir_c99_unit_output_write(stream, ");\n" as &byte) != 0 {
        return -1;
    }
    return 1;
}

fn mir_c99_unit_output_write_block_insts(writer: &MirC99UnitOutputWriter,
    stream: &FILE, block: &MirC99BlockPlanEntry) i32 {
    if writer == null || stream == null || block == null {
        return -1;
    }
    var offset: i32 = 0;
    while offset < block.inst_count {
        const inst: &MirInst = mir_c99_unit_output_inst_ptr(writer,
            block.inst_start + offset);
        if inst == null {
            return -1;
        }
        if inst.op == MIR_INST_OP_NOP {
            offset = offset + 1;
            continue;
        }
        if inst.op == MIR_INST_OP_CALL {
            const print_status: i32 =
                mir_c99_unit_output_write_print_call(writer, stream, inst);
            if print_status < 0 {
                return -1;
            }
            if print_status == 0 &&
               mir_c99_unit_output_write_extern_call(writer, stream, inst) <= 0 {
                return -1;
            }
            offset = offset + 1;
            continue;
        }
        if (inst.op == MIR_INST_OP_I32_ADD || inst.op == MIR_INST_OP_I32_EQ ||
            inst.op == MIR_INST_OP_I32_LE) &&
           mir_c99_unit_output_write_value_inst(writer, stream, inst) != 0 {
            return -1;
        }
        if inst.op == MIR_INST_OP_LOCAL_SET &&
           mir_c99_unit_output_write_local_set_inst(writer, stream, inst) != 0 {
            return -1;
        }
        if inst.op != MIR_INST_OP_I32_ADD && inst.op != MIR_INST_OP_I32_EQ &&
           inst.op != MIR_INST_OP_I32_LE && inst.op != MIR_INST_OP_LOCAL_SET {
            return -1;
        }
        offset = offset + 1;
    }
    return 0;
}

fn mir_c99_unit_output_write_block_label(stream: &FILE, block: &MirC99BlockPlanEntry) i32 {
    if stream == null || block == null || block.c_label_source_id == MIR_BLOCK_INVALID_ID {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "bb" as &byte) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write_i32(stream, block.c_label_source_id) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write(stream, ":\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_write_terminator(writer: &MirC99UnitOutputWriter,
    stream: &FILE, term: &MirC99TerminatorPlanEntry) i32 {
    if writer == null || stream == null || term == null {
        return -1;
    }
    if term.kind == MIR_TERMINATOR_KIND_BR {
        return mir_c99_cfg_emit_br_goto(term, stream);
    }
    if term.kind == MIR_TERMINATOR_KIND_COND_BR {
        return mir_c99_cfg_emit_cond_br_goto(term, stream);
    }
    if term.kind == MIR_TERMINATOR_KIND_RETURN {
        if term.operand_count == 0 {
            return mir_c99_unit_output_write(stream, "return;\n" as &byte);
        }
        const operand: &MirOperand = mir_c99_unit_output_operand_ptr(writer,
            term.operand_start);
        if operand == null {
            return -1;
        }
        if operand.value_id == MIR_VALUE_INVALID_ID {
            if mir_c99_unit_output_write(stream, "return " as &byte) != 0 ||
               mir_c99_unit_output_write_operand_expr(writer, stream, operand) != 0 ||
               mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
                return -1;
            }
            return 0;
        }
        return mir_c99_cfg_emit_return(term, stream);
    }
    return -1;
}

fn mir_c99_unit_output_write_function_body(writer: &MirC99UnitOutputWriter,
    stream: &FILE, ref: &MirC99Ref) i32 {
    if writer == null || stream == null || ref == null {
        return -1;
    }
    const function: &MirC99FunctionPlanEntry =
        mir_c99_unit_output_function_plan_ptr(writer, ref.source_id);
    if function == null || function.status != MIR_C99_CFG_FUNCTION_STATUS_PLANNED {
        return -1;
    }
    if (function.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 {
        return 0;
    }
    if mir_c99_unit_output_write_function_decl_head(writer, stream, function) != 0 ||
       mir_c99_unit_output_write(stream, " {\n" as &byte) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write_function_locals(writer, stream, function) != 0 {
        return -1;
    }
    var offset: i32 = 0;
    while offset < function.block_count {
        const block: &MirC99BlockPlanEntry =
            mir_c99_unit_output_block_plan_ptr(writer, function.block_start + offset);
        if block == null || mir_c99_unit_output_write_block_label(stream, block) != 0 {
            return -1;
        }
        if mir_c99_unit_output_write_block_insts(writer, stream, block) != 0 {
            return -1;
        }
        const term: &MirC99TerminatorPlanEntry =
            mir_c99_unit_output_terminator_plan_ptr(writer, block.terminator_id);
        if mir_c99_unit_output_write_terminator(writer, stream, term) != 0 {
            return -1;
        }
        offset = offset + 1;
    }
    if mir_c99_unit_output_write(stream, "}\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

fn mir_c99_unit_output_empty_stats() MirC99UnitOutputStats {
    return MirC99UnitOutputStats{
        include_count: 0usize,
        typedef_count: 0usize,
        extern_prototype_count: 0usize,
        function_prototype_count: 0usize,
        global_count: 0usize,
        function_body_count: 0usize,
        helper_count: 0usize,
        dep_count: 0usize,
        section_count: 0,
        output_bytes: 0usize,
    };
}

fn mir_c99_unit_output_estimate_ref_bytes(count: usize) usize {
    return count * 32usize;
}

fn mir_c99_unit_output_extern_function_prototype_count(
    writer: &MirC99UnitOutputWriter) usize {
    if writer == null || writer.unit == null {
        return 0usize;
    }
    var count: usize = writer.unit.helpers.count;
    var i: usize = 0usize;
    while i < writer.unit.functions.count {
        const ref: &MirC99Ref = mir_c99_unit_output_ref_ptr(&writer.unit.functions,
            i);
        const function: &MirC99FunctionPlanEntry =
            mir_c99_unit_output_function_plan_ptr(writer, ref.source_id);
        if ref != null && function != null &&
           (function.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 &&
           function.extern_symbol_name != null {
            count = count + 1usize;
        }
        i = i + 1usize;
    }
    return count;
}

fn mir_c99_unit_output_refresh_stats(writer: &MirC99UnitOutputWriter) i32 {
    if writer == null || writer.unit == null {
        return -1;
    }
    writer.stats.include_count = writer.unit.includes.count;
    writer.stats.typedef_count = writer.unit.typedefs.count;
    writer.stats.extern_prototype_count =
        mir_c99_unit_output_extern_function_prototype_count(writer);
    writer.stats.function_prototype_count = writer.unit.prototypes.count;
    writer.stats.global_count = writer.unit.globals.count;
    writer.stats.function_body_count = writer.unit.functions.count;
    writer.stats.helper_count = writer.unit.helpers.count;
    writer.stats.dep_count = writer.unit.deps.count;
    writer.stats.section_count = 6;
    writer.stats.output_bytes =
        mir_c99_unit_output_estimate_ref_bytes(writer.stats.include_count) +
        mir_c99_unit_output_estimate_ref_bytes(writer.stats.typedef_count) +
        mir_c99_unit_output_estimate_ref_bytes(writer.stats.extern_prototype_count) +
        mir_c99_unit_output_estimate_ref_bytes(writer.stats.function_prototype_count) +
        mir_c99_unit_output_estimate_ref_bytes(writer.stats.global_count) +
        mir_c99_unit_output_estimate_ref_bytes(writer.stats.function_body_count);
    return 0;
}

/// 功能说明：初始化 MIR-C99 单 unit 输出 writer。
/// 参数说明：`writer` 为输出 writer，`plan` 为 MIR-C99 plan，`unit` 为待输出 unit。
/// 返回值说明：成功返回 `0`，参数非法或 plan 未激活返回 `-1`。
export fn mir_c99_unit_output_writer_begin(writer: &MirC99UnitOutputWriter,
    module: &PortableMirModule, plan: &MirC99Plan, unit: &MirC99Unit) i32 {
    if writer == null || module == null || plan == null || unit == null ||
       plan.lifecycle_state != MIR_C99_PLAN_LIFECYCLE_ACTIVE {
        return -1;
    }
    writer.status = MIR_C99_OUTPUT_STATUS_READY;
    writer.module = module;
    writer.plan = plan;
    writer.unit = unit;
    writer.cfg_plan = null;
    writer.stats = mir_c99_unit_output_empty_stats();
    writer.diagnostic_code = 0;
    if mir_c99_unit_output_refresh_stats(writer) != 0 {
        writer.status = MIR_C99_OUTPUT_STATUS_ERROR;
        writer.diagnostic_code = -1;
        return -1;
    }
    return 0;
}

/// 功能说明：把 MIR-C99 单 unit 输出 writer 绑定到 CFG plan，以允许输出 function body。
/// 参数说明：`writer` 为已初始化 writer，`cfg_plan` 为已构建的 CFG plan。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_unit_output_writer_bind_cfg(writer: &MirC99UnitOutputWriter,
    cfg_plan: &MirC99CfgPlan) i32 {
    if writer == null || writer.status != MIR_C99_OUTPUT_STATUS_READY || cfg_plan == null {
        return -1;
    }
    writer.cfg_plan = cfg_plan;
    return 0;
}

/// 功能说明：确认 MIR-C99 单 unit 输出 section 顺序合同。
/// 参数说明：`section_index` 为从 0 开始的 section 顺序。
/// 返回值说明：返回 `MIR_C99_OUTPUT_SECTION_*`；未知下标返回 `0`。
export fn mir_c99_unit_output_section_at(section_index: i32) i32 {
    if section_index == 0 { return MIR_C99_OUTPUT_SECTION_INCLUDE; }
    if section_index == 1 { return MIR_C99_OUTPUT_SECTION_TYPEDEF; }
    if section_index == 2 { return MIR_C99_OUTPUT_SECTION_EXTERN_PROTOTYPE; }
    if section_index == 3 { return MIR_C99_OUTPUT_SECTION_FUNCTION_PROTOTYPE; }
    if section_index == 4 { return MIR_C99_OUTPUT_SECTION_GLOBAL; }
    if section_index == 5 { return MIR_C99_OUTPUT_SECTION_FUNCTION_BODY; }
    return 0;
}

/// 功能说明：输出 MIR-C99 单 unit 的 include section。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出条目数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_include_section(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "/* mir-c99 includes */\n" as &byte) != 0 {
        return -1;
    }
    if writer.unit.includes.count == 0usize {
        if mir_c99_unit_output_write(stream, "#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n#include <stdio.h>\n" as &byte) != 0 {
            return -1;
        }
        return 4;
    }
    if mir_c99_unit_output_write_ref_table(stream, &writer.unit.includes,
        "#include \"uya_mir_include_" as &byte, ".h\"\n" as &byte) != 0 {
        return -1;
    }
    return writer.unit.includes.count as i32;
}

/// 功能说明：输出 MIR-C99 单 unit 的 typedef section。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出条目数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_typedef_section(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "\n/* mir-c99 typedefs */\n" as &byte) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write_ref_table(stream, &writer.unit.typedefs,
        "typedef int32_t uya_mir_ty_" as &byte, ";\n" as &byte) != 0 {
        return -1;
    }
    return writer.unit.typedefs.count as i32;
}

/// 功能说明：输出 MIR-C99 单 unit 的 extern prototype section。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出条目数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_extern_prototype_section(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "\n/* mir-c99 extern prototypes */\n" as &byte) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write_ref_table(stream, &writer.unit.helpers,
        "extern void uya_mir_helper_" as &byte, "(void);\n" as &byte) != 0 {
        return -1;
    }
    var count: i32 = writer.unit.helpers.count as i32;
    var i: usize = 0usize;
    while i < writer.unit.functions.count {
        const ref: &MirC99Ref = mir_c99_unit_output_ref_ptr(&writer.unit.functions,
            i);
        const function: &MirC99FunctionPlanEntry =
            mir_c99_unit_output_function_plan_ptr(writer, ref.source_id);
        if ref == null {
            return -1;
        }
        if function != null && (function.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 &&
           function.extern_symbol_name != null {
            if mir_c99_unit_output_write_extern_function_prototype(writer, stream,
                function) != 0 {
                return -1;
            }
            count = count + 1;
        }
        i = i + 1usize;
    }
    return count;
}

/// 功能说明：输出 MIR-C99 单 unit 的 function prototype section。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出条目数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_function_prototype_section(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.unit == null || writer.cfg_plan == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "\n/* mir-c99 function prototypes */\n" as &byte) != 0 {
        return -1;
    }
    var i: usize = 0usize;
    while i < writer.unit.prototypes.count {
        const ref: &MirC99Ref = mir_c99_unit_output_ref_ptr(&writer.unit.prototypes, i);
        if ref == null {
            return -1;
        }
        const function: &MirC99FunctionPlanEntry =
            mir_c99_unit_output_function_plan_ptr(writer, ref.source_id);
        if function == null ||
           mir_c99_unit_output_write_function_decl_head(writer, stream, function) != 0 ||
           mir_c99_unit_output_write(stream, ";\n" as &byte) != 0 {
            return -1;
        }
        i = i + 1usize;
    }
    return writer.unit.prototypes.count as i32;
}

/// 功能说明：输出 MIR-C99 split unit header guard 起始。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 header 输出流。
/// 返回值说明：成功返回 `0`，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_header_guard_begin(writer: &MirC99UnitOutputWriter,
    stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "#ifndef UYA_MIR_UNIT_" as &byte) != 0 ||
       mir_c99_unit_output_write_unit_i32(stream, writer.unit) != 0 ||
       mir_c99_unit_output_write(stream, "_H\n#define UYA_MIR_UNIT_" as &byte) != 0 ||
       mir_c99_unit_output_write_unit_i32(stream, writer.unit) != 0 ||
       mir_c99_unit_output_write(stream, "_H\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：输出 MIR-C99 split unit dependency include section。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 header 输出流。
/// 返回值说明：成功返回写出依赖数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_dep_section(writer: &MirC99UnitOutputWriter,
    stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "\n/* mir-c99 unit deps */\n" as &byte) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write_ref_table(stream, &writer.unit.deps,
        "#include \"uya_mir_unit_" as &byte, ".h\"\n" as &byte) != 0 {
        return -1;
    }
    return writer.unit.deps.count as i32;
}

/// 功能说明：输出 MIR-C99 split unit header guard 结束。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 header 输出流。
/// 返回值说明：成功返回 `0`，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_header_guard_end(writer: &MirC99UnitOutputWriter,
    stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "#endif /* UYA_MIR_UNIT_" as &byte) != 0 ||
       mir_c99_unit_output_write_unit_i32(stream, writer.unit) != 0 ||
       mir_c99_unit_output_write(stream, "_H */\n" as &byte) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：输出 MIR-C99 split unit 的独立 header 文件内容。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 header 输出流。
/// 返回值说明：成功返回写出的 section 数，任一 section 失败返回 `-1`。
export fn mir_c99_unit_output_write_header_file(writer: &MirC99UnitOutputWriter,
    stream: &FILE) i32 {
    if writer == null || writer.status != MIR_C99_OUTPUT_STATUS_READY || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write_header_guard_begin(writer, stream) != 0 {
        return -1;
    }
    if mir_c99_unit_output_write_include_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_dep_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_typedef_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_extern_prototype_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_function_prototype_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_header_guard_end(writer, stream) != 0 {
        return -1;
    }
    return 6;
}

/// 功能说明：输出 MIR-C99 split unit 源文件对自身 header 的 include。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C source 输出流。
/// 返回值说明：成功返回 `1`，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_source_header_include(writer: &MirC99UnitOutputWriter,
    stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "#include \"uya_mir_unit_" as &byte) != 0 ||
       mir_c99_unit_output_write_unit_i32(stream, writer.unit) != 0 ||
       mir_c99_unit_output_write(stream, ".h\"\n" as &byte) != 0 {
        return -1;
    }
    return 1;
}

/// 功能说明：按固定顺序输出 include/typedef/extern prototype/function prototype sections。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出 section 数，任一 section 失败返回 `-1`。
export fn mir_c99_unit_output_write_declaration_sections(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.status != MIR_C99_OUTPUT_STATUS_READY || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write_include_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_typedef_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_extern_prototype_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_function_prototype_section(writer, stream) < 0 {
        return -1;
    }
    return 4;
}

/// 功能说明：输出 MIR-C99 单 unit 的 global section。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出条目数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_global_section(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.unit == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "\n/* mir-c99 globals */\n" as &byte) != 0 {
        return -1;
    }
    var i: usize = 0usize;
    while i < writer.unit.globals.count {
        const ref: &MirC99Ref = mir_c99_unit_output_ref_ptr(&writer.unit.globals, i);
        if mir_c99_unit_output_write_global_initializer(writer, stream, ref) != 0 {
            return -1;
        }
        i = i + 1usize;
    }
    return writer.unit.globals.count as i32;
}

/// 功能说明：输出 MIR-C99 单 unit 的 function body section。
/// 参数说明：`writer` 为已绑定 CFG plan 的 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回写出函数数，参数非法或写出失败返回 `-1`。
export fn mir_c99_unit_output_write_function_body_section(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.unit == null || writer.cfg_plan == null || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write(stream, "\n/* mir-c99 function bodies */\n" as &byte) != 0 {
        return -1;
    }
    var i: usize = 0usize;
    while i < writer.unit.functions.count {
        const ref: &MirC99Ref = mir_c99_unit_output_ref_ptr(&writer.unit.functions, i);
        if mir_c99_unit_output_write_function_body(writer, stream, ref) != 0 {
            return -1;
        }
        i = i + 1usize;
    }
    return writer.unit.functions.count as i32;
}

/// 功能说明：按固定顺序输出 MIR-C99 单 unit 的所有已建模 sections。
/// 参数说明：`writer` 为已初始化 writer，`stream` 为 C 输出流。
/// 返回值说明：成功返回 section 数，任一 section 失败返回 `-1`。
export fn mir_c99_unit_output_write_all_sections(writer: &MirC99UnitOutputWriter, stream: &FILE) i32 {
    if writer == null || writer.status != MIR_C99_OUTPUT_STATUS_READY || stream == null {
        return -1;
    }
    if mir_c99_unit_output_write_declaration_sections(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_global_section(writer, stream) < 0 {
        return -1;
    }
    if mir_c99_unit_output_write_function_body_section(writer, stream) < 0 {
        return -1;
    }
    return 6;
}

/// 功能说明：完成 MIR-C99 单 unit 输出 writer 的统计阶段。
/// 参数说明：`writer` 为已初始化 writer。
/// 返回值说明：成功返回 output bytes 估算，状态非法返回 `-1`。
export fn mir_c99_unit_output_writer_finish(writer: &MirC99UnitOutputWriter) i32 {
    if writer == null || writer.status != MIR_C99_OUTPUT_STATUS_READY {
        return -1;
    }
    writer.status = MIR_C99_OUTPUT_STATUS_DONE;
    return writer.stats.output_bytes as i32;
}
