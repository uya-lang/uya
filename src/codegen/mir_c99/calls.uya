// codegen/mir_c99/calls.uya - MIR call instruction to MIR-C99 call plan.

use codegen.mir_c99.plan;

export const MIR_C99_CALL_TARGET_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_CALL_TARGET_KIND_DIRECT: i32 = 1;
export const MIR_C99_CALL_TARGET_KIND_EXTERN: i32 = 2;
export const MIR_C99_CALL_TARGET_KIND_METHOD_INSTANCE: i32 = 3;
export const MIR_C99_CALL_TARGET_KIND_FUNCTION_POINTER: i32 = 4;

export const MIR_C99_CALL_RETURN_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_CALL_RETURN_KIND_VOID: i32 = 1;
export const MIR_C99_CALL_RETURN_KIND_DIRECT_VALUE: i32 = 2;
export const MIR_C99_CALL_RETURN_KIND_OUT_PARAM_AGGREGATE: i32 = 3;

export const MIR_C99_CALL_STATUS_READY: i32 = 1;
export const MIR_C99_CALL_STATUS_REJECT: i32 = 2;

/// 功能说明：记录一个 MIR call instruction 到 MIR-C99 call 的计划条目。
/// 参数说明：无；字段来自 verifier-clean MIR call instruction、callee operand、callee value 和 callee function metadata。
/// 返回值说明：无；由 `MirC99CallPlan.calls` 动态保存。
export struct MirC99CallEntry {
    inst_id: MirInstId,
    function_id: MirFunctionId,
    block_id: MirBlockId,
    target_kind: i32,
    callee_function_id: MirFunctionId,
    callee_value_id: MirValueId,
    callee_type_id: MirTypeId,
    signature_type_id: MirTypeId,
    return_type_id: MirTypeId,
    return_abi_class: i32,
    float_abi_arg_count: i32,
    required_call_flags: i32,
    return_kind: i32,
    out_param_operand_id: MirOperandId,
    out_param_value_id: MirValueId,
    out_param_local_id: MirLocalId,
    out_param_type_id: MirTypeId,
    aggregate_return_size_bytes: usize,
    aggregate_return_align_bytes: usize,
    arg_start: i32,
    arg_count: i32,
    result_value_id: MirValueId,
    calling_convention: i32,
    method_instance_flags: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 call 计划。
/// 参数说明：无；当前保存 direct、extern、method-instance 和 function-pointer call，其他 callee kind 留给后续 leaf。
/// 返回值说明：无；调用 `mir_c99_call_plan_init` 后使用。
export struct MirC99CallPlan {
    calls: SemanticVector,
    call_count: usize,
    reject_count: usize,
}

fn mir_c99_call_operand_ptr(module: &PortableMirModule, operand_id: i32) &MirOperand {
    if module == null || operand_id < 0 || (operand_id as usize) >= module.operands.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.operands, operand_id as usize) as &MirOperand;
}

fn mir_c99_call_function_ptr(module: &PortableMirModule,
    function_id: MirFunctionId) &MirFunction {
    const index: i32 = function_id as i32;
    if module == null || index < 0 || (index as usize) >= module.functions.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.functions, index as usize) as &MirFunction;
}

fn mir_c99_call_type_ptr(module: &PortableMirModule, type_id: MirTypeId) &MirType {
    const index: i32 = type_id as i32;
    if module == null || index < 0 || (index as usize) >= module.types.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.types, index as usize) as &MirType;
}

fn mir_c99_call_function_param_type_ptr(module: &PortableMirModule,
    index: i32) &MirFunctionParamType {
    if module == null || index < 0 ||
       (index as usize) >= module.function_param_types.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.function_param_types,
        index as usize) as &MirFunctionParamType;
}

fn mir_c99_call_float_abi_class_matches_type(typ: &MirType,
    abi_class: i32) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_F32 && abi_class == MIR_ABI_CLASS_FLOAT {
        return 1;
    }
    if typ.kind == MIR_TYPE_KIND_F64 && abi_class == MIR_ABI_CLASS_DOUBLE {
        return 1;
    }
    return 0;
}

fn mir_c99_call_type_is_aggregate_return(return_type: &MirType) i32 {
    if return_type == null {
        return 0;
    }
    if return_type.kind == MIR_TYPE_KIND_STRUCT ||
       return_type.kind == MIR_TYPE_KIND_UNION ||
       return_type.kind == MIR_TYPE_KIND_ENUM ||
       return_type.kind == MIR_TYPE_KIND_ARRAY ||
       return_type.kind == MIR_TYPE_KIND_SLICE {
        return 1;
    }
    return 0;
}

fn mir_c99_call_return_kind_for_signature(return_type: &MirType) i32 {
    if return_type == null {
        return MIR_C99_CALL_RETURN_KIND_UNSUPPORTED;
    }
    if return_type.kind == MIR_TYPE_KIND_VOID {
        return MIR_C99_CALL_RETURN_KIND_VOID;
    }
    if mir_c99_call_type_is_aggregate_return(return_type) != 0 {
        return MIR_C99_CALL_RETURN_KIND_OUT_PARAM_AGGREGATE;
    }
    return MIR_C99_CALL_RETURN_KIND_DIRECT_VALUE;
}

fn mir_c99_call_signature_float_abi_arg_count(module: &PortableMirModule,
    signature: &MirType) i32 {
    if module == null || signature == null ||
       signature.kind != MIR_TYPE_KIND_FUNCTION ||
       signature.field_start < 0 || signature.field_count < 0 {
        return -1;
    }
    var count: i32 = 0;
    var i: i32 = 0;
    while i < signature.field_count {
        const param: &MirFunctionParamType =
            mir_c99_call_function_param_type_ptr(module, signature.field_start + i);
        if param == null || param.owner_type_id != signature.type_id ||
           param.param_index != i {
            return -1;
        }
        const param_type: &MirType = mir_c99_call_type_ptr(module, param.type_id);
        if param_type == null {
            return -1;
        }
        if param_type.kind == MIR_TYPE_KIND_F32 || param_type.kind == MIR_TYPE_KIND_F64 {
            if mir_c99_call_float_abi_class_matches_type(param_type,
                param.abi_class) == 0 {
                return -1;
            }
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn mir_c99_call_signature_required_flags(module: &PortableMirModule,
    signature: &MirType) i32 {
    if module == null || signature == null ||
       signature.kind != MIR_TYPE_KIND_FUNCTION {
        return -1;
    }
    const return_type: &MirType = mir_c99_call_type_ptr(module,
        signature.element_type_id);
    if return_type == null {
        return -1;
    }
    var flags: i32 = 0;
    if signature.field_count > 1 {
        flags = flags | MIR_CALL_FLAG_MULTI_PARAM;
    }
    if mir_c99_call_type_is_aggregate_return(return_type) != 0 {
        flags = flags | MIR_CALL_FLAG_AGGREGATE_RETURN |
            MIR_CALL_FLAG_OUT_PARAM_WRITEBACK;
    } else if return_type.kind == MIR_TYPE_KIND_ERROR_UNION {
        if return_type.abi_class != MIR_ABI_CLASS_ERROR_UNION {
            return -1;
        }
        flags = flags | MIR_CALL_FLAG_ERROR_UNION_RETURN;
    } else if return_type.kind == MIR_TYPE_KIND_F32 ||
              return_type.kind == MIR_TYPE_KIND_F64 {
        if mir_c99_call_float_abi_class_matches_type(return_type,
            return_type.abi_class) == 0 {
            return -1;
        }
        flags = flags | MIR_CALL_FLAG_FLOAT_ABI;
    }
    const float_arg_count: i32 =
        mir_c99_call_signature_float_abi_arg_count(module, signature);
    if float_arg_count < 0 {
        return -1;
    }
    if float_arg_count > 0 {
        flags = flags | MIR_CALL_FLAG_FLOAT_ABI;
    }
    return flags;
}

fn mir_c99_call_float_abi_status(module: &PortableMirModule,
    inst: &MirInst, signature: &MirType) i32 {
    const required_call_flags: i32 =
        mir_c99_call_signature_required_flags(module, signature);
    if required_call_flags < 0 {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    if required_call_flags != 0 &&
       (inst.flags & required_call_flags) != required_call_flags {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    return MIR_C99_CALL_STATUS_READY;
}

fn mir_c99_call_bind_out_param_return(module: &PortableMirModule,
    inst: &MirInst, return_type: &MirType, entry: &MirC99CallEntry) i32 {
    if module == null || inst == null || return_type == null || entry == null {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    if entry.return_kind != MIR_C99_CALL_RETURN_KIND_OUT_PARAM_AGGREGATE {
        return MIR_C99_CALL_STATUS_READY;
    }
    if (inst.flags & MIR_CALL_FLAG_AGGREGATE_RETURN) == 0 ||
       (inst.flags & MIR_CALL_FLAG_OUT_PARAM_WRITEBACK) == 0 ||
       inst.operand_count < 2 {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    const out_param: &MirOperand = mir_c99_call_operand_ptr(module,
        inst.operand_start + 1);
    if out_param == null ||
       (out_param.flags & MIR_CALL_FLAG_OUT_PARAM_WRITEBACK) == 0 {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    const pointer_type: &MirType = mir_c99_call_type_ptr(module,
        out_param.type_id);
    if pointer_type == null || pointer_type.kind != MIR_TYPE_KIND_POINTER ||
       pointer_type.pointee_type_id != return_type.type_id {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    if return_type.size_bytes == 0usize || return_type.align_bytes == 0usize {
        return MIR_C99_CALL_STATUS_REJECT;
    }
    entry.out_param_operand_id = out_param.operand_id;
    entry.out_param_value_id = out_param.value_id;
    entry.out_param_local_id = out_param.local_id;
    entry.out_param_type_id = out_param.type_id;
    entry.aggregate_return_size_bytes = return_type.size_bytes;
    entry.aggregate_return_align_bytes = return_type.align_bytes;
    return MIR_C99_CALL_STATUS_READY;
}

fn mir_c99_call_target_kind_for_operand(target: &MirOperand) i32 {
    if target == null {
        return MIR_C99_CALL_TARGET_KIND_UNSUPPORTED;
    }
    if target.kind == MIR_OPERAND_KIND_CALL_TARGET_DIRECT {
        return MIR_C99_CALL_TARGET_KIND_DIRECT;
    }
    if target.kind == MIR_OPERAND_KIND_CALL_TARGET_EXTERN {
        return MIR_C99_CALL_TARGET_KIND_EXTERN;
    }
    if target.kind == MIR_OPERAND_KIND_CALL_TARGET_METHOD_INSTANCE {
        return MIR_C99_CALL_TARGET_KIND_METHOD_INSTANCE;
    }
    if target.kind == MIR_OPERAND_KIND_CALL_TARGET_FUNCTION_POINTER {
        return MIR_C99_CALL_TARGET_KIND_FUNCTION_POINTER;
    }
    return MIR_C99_CALL_TARGET_KIND_UNSUPPORTED;
}

fn mir_c99_call_infer_legacy_target_kind(callee: &MirFunction) i32 {
    if callee == null {
        return MIR_C99_CALL_TARGET_KIND_UNSUPPORTED;
    }
    if (callee.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 &&
       callee.calling_convention == MIR_CALL_CONV_C {
        return MIR_C99_CALL_TARGET_KIND_EXTERN;
    }
    if (callee.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 &&
       callee.calling_convention == MIR_CALL_CONV_UYA {
        return MIR_C99_CALL_TARGET_KIND_DIRECT;
    }
    return MIR_C99_CALL_TARGET_KIND_UNSUPPORTED;
}

fn mir_c99_call_callee_matches_target(target_kind: i32, callee: &MirFunction) i32 {
    if callee == null {
        return 0;
    }
    if target_kind == MIR_C99_CALL_TARGET_KIND_DIRECT {
        if (callee.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 ||
           callee.calling_convention != MIR_CALL_CONV_UYA {
            return 0;
        }
        return 1;
    }
    if target_kind == MIR_C99_CALL_TARGET_KIND_EXTERN {
        if (callee.flags & MIR_FUNCTION_FLAG_EXTERN) == 0 ||
           callee.calling_convention != MIR_CALL_CONV_C {
            return 0;
        }
        return 1;
    }
    if target_kind == MIR_C99_CALL_TARGET_KIND_METHOD_INSTANCE {
        if (callee.flags & MIR_FUNCTION_FLAG_EXTERN) != 0 ||
           callee.calling_convention != MIR_CALL_CONV_UYA {
            return 0;
        }
        return 1;
    }
    return 0;
}

fn mir_c99_call_reject_entry(inst: &MirInst) MirC99CallEntry {
    var inst_id: MirInstId = MIR_INST_INVALID_ID;
    var function_id: MirFunctionId = MIR_FUNCTION_INVALID_ID;
    var block_id: MirBlockId = MIR_BLOCK_INVALID_ID;
    var result_value_id: MirValueId = -1;
    var calling_convention: i32 = 0;
    var flags: i32 = 0;
    if inst != null {
        inst_id = inst.inst_id;
        function_id = inst.function_id;
        block_id = inst.block_id;
        result_value_id = inst.result_value_id;
        calling_convention = inst.calling_convention;
        flags = inst.flags;
    }
    return MirC99CallEntry{
        inst_id: inst_id,
        function_id: function_id,
        block_id: block_id,
        target_kind: MIR_C99_CALL_TARGET_KIND_UNSUPPORTED,
        callee_function_id: MIR_FUNCTION_INVALID_ID,
        callee_value_id: -1,
        callee_type_id: -1,
        signature_type_id: -1,
        return_type_id: -1,
        return_abi_class: 0,
        float_abi_arg_count: 0,
        required_call_flags: 0,
        return_kind: MIR_C99_CALL_RETURN_KIND_UNSUPPORTED,
        out_param_operand_id: -1,
        out_param_value_id: -1,
        out_param_local_id: -1,
        out_param_type_id: -1,
        aggregate_return_size_bytes: 0usize,
        aggregate_return_align_bytes: 0usize,
        arg_start: -1,
        arg_count: 0,
        result_value_id: result_value_id,
        calling_convention: calling_convention,
        method_instance_flags: 0,
        flags: flags,
        status: MIR_C99_CALL_STATUS_REJECT,
    };
}

fn mir_c99_call_entry_from_mir(module: &PortableMirModule,
    inst: &MirInst) MirC99CallEntry {
    if module == null || inst == null || inst.op != MIR_INST_OP_CALL ||
       inst.operand_count <= 0 {
        return mir_c99_call_reject_entry(inst);
    }
    const target: &MirOperand = mir_c99_call_operand_ptr(module, inst.operand_start);
    if target == null ||
       (target.kind != 0 &&
        target.kind != MIR_OPERAND_KIND_CALL_TARGET_DIRECT &&
        target.kind != MIR_OPERAND_KIND_CALL_TARGET_EXTERN &&
        target.kind != MIR_OPERAND_KIND_CALL_TARGET_METHOD_INSTANCE &&
        target.kind != MIR_OPERAND_KIND_CALL_TARGET_FUNCTION_POINTER) {
        return mir_c99_call_reject_entry(inst);
    }
    if target.kind == MIR_OPERAND_KIND_CALL_TARGET_METHOD_INSTANCE &&
       target.flags < 0 {
        return mir_c99_call_reject_entry(inst);
    }
    var target_kind: i32 = mir_c99_call_target_kind_for_operand(target);
    var signature_type_id: MirTypeId = -1;
    var return_type_id: MirTypeId = -1;
    var return_abi_class: i32 = 0;
    var float_abi_arg_count: i32 = 0;
    var required_call_flags: i32 = 0;
    var return_kind: i32 = MIR_C99_CALL_RETURN_KIND_UNSUPPORTED;
    var callee_function_id: MirFunctionId = MIR_FUNCTION_INVALID_ID;
    var callee_value_id: MirValueId = -1;
    var callee_type_id: MirTypeId = -1;
    if target_kind == MIR_C99_CALL_TARGET_KIND_FUNCTION_POINTER {
        if target.value_id == MIR_VALUE_INVALID_ID {
            return mir_c99_call_reject_entry(inst);
        }
        const function_pointer_type: &MirType = mir_c99_call_type_ptr(module,
            target.type_id);
        if function_pointer_type == null ||
           function_pointer_type.kind != MIR_TYPE_KIND_FUNCTION_POINTER {
            return mir_c99_call_reject_entry(inst);
        }
        const pointee_type: &MirType = mir_c99_call_type_ptr(module,
            function_pointer_type.pointee_type_id);
        if pointee_type == null || pointee_type.kind != MIR_TYPE_KIND_FUNCTION {
            return mir_c99_call_reject_entry(inst);
        }
        callee_value_id = target.value_id;
        callee_type_id = target.type_id;
        signature_type_id = pointee_type.type_id;
    } else if target.value_id != -1 {
        return mir_c99_call_reject_entry(inst);
    }
    const callee: &MirFunction = mir_c99_call_function_ptr(module,
        target.immediate_i32);
    if target_kind == MIR_C99_CALL_TARGET_KIND_UNSUPPORTED &&
       target.kind == 0 && target.value_id == MIR_VALUE_INVALID_ID {
        target_kind = mir_c99_call_infer_legacy_target_kind(callee);
    }
    if target_kind == MIR_C99_CALL_TARGET_KIND_UNSUPPORTED {
        return mir_c99_call_reject_entry(inst);
    }
    if mir_c99_call_callee_matches_target(target_kind, callee) == 0 {
        if target_kind != MIR_C99_CALL_TARGET_KIND_FUNCTION_POINTER {
            return mir_c99_call_reject_entry(inst);
        }
    } else {
        callee_function_id = target.immediate_i32;
        signature_type_id = callee.signature_type_id;
    }
    const signature: &MirType = mir_c99_call_type_ptr(module, signature_type_id);
    if signature == null {
        return mir_c99_call_reject_entry(inst);
    }
    var return_type: &MirType = null;
    if signature.kind == MIR_TYPE_KIND_FUNCTION {
        if mir_c99_call_float_abi_status(module, inst, signature) ==
           MIR_C99_CALL_STATUS_REJECT {
            return mir_c99_call_reject_entry(inst);
        }
        return_type = mir_c99_call_type_ptr(module, signature.element_type_id);
    } else {
        return_type = signature;
    }
    if return_type == null {
        return mir_c99_call_reject_entry(inst);
    }
    return_type_id = return_type.type_id;
    return_abi_class = return_type.abi_class;
    return_kind = mir_c99_call_return_kind_for_signature(return_type);
    if return_kind == MIR_C99_CALL_RETURN_KIND_UNSUPPORTED {
        return mir_c99_call_reject_entry(inst);
    }
    if signature.kind == MIR_TYPE_KIND_FUNCTION {
        float_abi_arg_count =
            mir_c99_call_signature_float_abi_arg_count(module, signature);
        if float_abi_arg_count < 0 {
            return mir_c99_call_reject_entry(inst);
        }
        required_call_flags = mir_c99_call_signature_required_flags(module,
            signature);
        if required_call_flags < 0 {
            return mir_c99_call_reject_entry(inst);
        }
    }
    var entry: MirC99CallEntry = MirC99CallEntry{
        inst_id: inst.inst_id,
        function_id: inst.function_id,
        block_id: inst.block_id,
        target_kind: target_kind,
        callee_function_id: callee_function_id,
        callee_value_id: callee_value_id,
        callee_type_id: callee_type_id,
        signature_type_id: signature.type_id,
        return_type_id: return_type_id,
        return_abi_class: return_abi_class,
        float_abi_arg_count: float_abi_arg_count,
        required_call_flags: required_call_flags,
        return_kind: return_kind,
        out_param_operand_id: -1,
        out_param_value_id: -1,
        out_param_local_id: -1,
        out_param_type_id: -1,
        aggregate_return_size_bytes: 0usize,
        aggregate_return_align_bytes: 0usize,
        arg_start: inst.operand_start + 1,
        arg_count: inst.operand_count - 1,
        result_value_id: inst.result_value_id,
        calling_convention: inst.calling_convention,
        method_instance_flags: target.flags,
        flags: inst.flags,
        status: MIR_C99_CALL_STATUS_READY,
    };
    if mir_c99_call_bind_out_param_return(module, inst, return_type, &entry) ==
       MIR_C99_CALL_STATUS_REJECT {
        return mir_c99_call_reject_entry(inst);
    }
    return entry;
}

/// 功能说明：初始化 MIR-C99 call 计划。
/// 参数说明：`plan` 为输出计划。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_call_plan_init(plan: &MirC99CallPlan) i32 {
    if plan == null {
        return -1;
    }
    semantic_vector_init(&plan.calls, @size_of(MirC99CallEntry));
    plan.call_count = 0usize;
    plan.reject_count = 0usize;
    return 0;
}

/// 功能说明：释放 MIR-C99 call 计划。
/// 参数说明：`plan` 为待释放计划；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_call_plan_release(plan: &MirC99CallPlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.calls);
    plan.call_count = 0usize;
    plan.reject_count = 0usize;
}

/// 功能说明：向 MIR-C99 call 计划追加一个 verifier-clean MIR call。
/// 参数说明：`plan` 为输出计划，`module` 为 verifier-clean MIR module，`inst` 为 MIR call instruction。
/// 返回值说明：非 call instruction 返回 `0`；成功追加支持的 call 返回 `0`，unsupported call kind 返回 `-1`。
export fn mir_c99_call_plan_append(plan: &MirC99CallPlan,
    module: &PortableMirModule, inst: &MirInst) i32 {
    if plan == null || module == null || inst == null {
        return -1;
    }
    if inst.op != MIR_INST_OP_CALL {
        return 0;
    }
    const entry: MirC99CallEntry = mir_c99_call_entry_from_mir(module, inst);
    if entry.status == MIR_C99_CALL_STATUS_REJECT {
        plan.reject_count = plan.reject_count + 1usize;
        return -1;
    }
    if semantic_vector_append(&plan.calls, &entry as &const void) != 0 {
        return -1;
    }
    plan.call_count = plan.calls.count;
    return 0;
}

/// 功能说明：从 PortableMIR module 的 call instruction 构建 MIR-C99 call 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`plan` 为输出 call 计划。
/// 返回值说明：所有支持的 call 均映射成功返回 `0`；遇到 unsupported call kind 或参数非法返回 `-1`。
export fn mir_c99_call_plan_build(module: &PortableMirModule,
    plan: &MirC99CallPlan) i32 {
    if module == null || plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.insts.count {
        const inst: &MirInst = semantic_vector_item_ptr(&module.insts, i) as &MirInst;
        if mir_c99_call_plan_append(plan, module, inst) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：按下标读取 MIR-C99 call 计划条目。
/// 参数说明：`plan` 为 call 计划，`index` 为条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_call_plan_entry_ptr(plan: &MirC99CallPlan,
    index: i32) &MirC99CallEntry {
    if plan == null || index < 0 || (index as usize) >= plan.calls.count {
        return null;
    }
    return semantic_vector_item_ptr(&plan.calls, index as usize) as &MirC99CallEntry;
}
