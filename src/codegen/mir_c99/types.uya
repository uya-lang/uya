// codegen/mir_c99/types.uya - MIR layout metadata to MIR-C99 typedef plan.

use codegen.mir_c99.plan;

export const MIR_C99_C_TYPE_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_C_TYPE_KIND_VOID: i32 = 1;
export const MIR_C99_C_TYPE_KIND_BOOL: i32 = 2;
export const MIR_C99_C_TYPE_KIND_I32: i32 = 3;
export const MIR_C99_C_TYPE_KIND_USIZE: i32 = 4;
export const MIR_C99_C_TYPE_KIND_POINTER: i32 = 5;
export const MIR_C99_C_TYPE_KIND_STRUCT: i32 = 6;
export const MIR_C99_C_TYPE_KIND_ATOMIC_HELPER: i32 = 7;
export const MIR_C99_C_TYPE_KIND_VECTOR_HELPER: i32 = 8;
export const MIR_C99_C_TYPE_KIND_MASK_HELPER: i32 = 9;
export const MIR_C99_C_TYPE_KIND_I8: i32 = 10;
export const MIR_C99_C_TYPE_KIND_U8: i32 = 11;
export const MIR_C99_C_TYPE_KIND_I16: i32 = 12;
export const MIR_C99_C_TYPE_KIND_U16: i32 = 13;
export const MIR_C99_C_TYPE_KIND_U32: i32 = 14;
export const MIR_C99_C_TYPE_KIND_I64: i32 = 15;
export const MIR_C99_C_TYPE_KIND_U64: i32 = 16;
export const MIR_C99_C_TYPE_KIND_ISIZE: i32 = 17;
export const MIR_C99_C_TYPE_KIND_BYTE: i32 = 18;
export const MIR_C99_C_TYPE_KIND_F32: i32 = 19;
export const MIR_C99_C_TYPE_KIND_F64: i32 = 20;
export const MIR_C99_C_TYPE_KIND_ARRAY: i32 = 21;
export const MIR_C99_C_TYPE_KIND_SLICE: i32 = 22;
export const MIR_C99_C_TYPE_KIND_UNION: i32 = 23;
export const MIR_C99_C_TYPE_KIND_ENUM: i32 = 24;
export const MIR_C99_C_TYPE_KIND_ERROR_UNION: i32 = 25;
export const MIR_C99_C_TYPE_KIND_FUNCTION: i32 = 26;
export const MIR_C99_C_TYPE_KIND_FUNCTION_POINTER: i32 = 27;

export const MIR_C99_TYPE_STATUS_MISSING: i32 = 0;
export const MIR_C99_TYPE_STATUS_READY: i32 = 1;
export const MIR_C99_TYPE_STATUS_REJECT: i32 = 2;

/// 功能说明：记录一个 MIR aggregate type 的字段和布局计划。
/// 参数说明：无；字段来自 verifier-clean MIR type/layout metadata。
/// 返回值说明：无；由 `MirC99TypePlan.aggregate_layouts` 动态保存。
export struct MirC99AggregateLayoutEntry {
    owner_type_id: MirTypeId,
    c_type_kind: i32,
    field_start: i32,
    field_count: i32,
    size_bytes: usize,
    align_bytes: usize,
    tag_offset_bytes: usize,
    payload_offset_bytes: usize,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR type 到 MIR-C99 typedef 的计划条目。
/// 参数说明：无；字段全部来自 MIR type/layout metadata，不保存高层语义结构。
/// 返回值说明：无；由 `MirC99TypePlan.entries` 动态保存。
export struct MirC99TypeDef {
    type_id: MirTypeId,
    source_type_id: TypeId,
    mir_kind: i32,
    c_type_kind: i32,
    size_bytes: usize,
    align_bytes: usize,
    tag_offset_bytes: usize,
    payload_offset_bytes: usize,
    return_type_id: MirTypeId,
    callable_type_id: MirTypeId,
    calling_convention: i32,
    element_type_id: MirTypeId,
    pointee_type_id: MirTypeId,
    field_start: i32,
    field_count: i32,
    lane_count: i32,
    lane_stride_bytes: usize,
    abi_class: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 typedef 计划。
/// 参数说明：无；`entries` 是按 MIR type 顺序追加的动态表。
/// 返回值说明：无；调用 `mir_c99_type_plan_init` 后使用。
export struct MirC99TypePlan {
    entries: SemanticVector,
    aggregate_layouts: SemanticVector,
    count: usize,
    aggregate_layout_count: usize,
    reject_count: usize,
}

fn mir_c99_type_is_aggregate_layout_kind(typ: &MirType) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_STRUCT ||
       typ.kind == MIR_TYPE_KIND_UNION ||
       typ.kind == MIR_TYPE_KIND_ENUM {
        return 1;
    }
    return 0;
}

fn mir_c99_type_aggregate_layout_from_mir(typ: &MirType,
    c_type_kind: i32) MirC99AggregateLayoutEntry {
    if typ == null || mir_c99_type_is_aggregate_layout_kind(typ) == 0 ||
       typ.field_start < 0 || typ.field_count <= 0 ||
       typ.size_bytes == 0usize || typ.align_bytes == 0usize {
        return MirC99AggregateLayoutEntry{
            owner_type_id: MIR_TYPE_INVALID_ID,
            c_type_kind: MIR_C99_C_TYPE_KIND_UNSUPPORTED,
            field_start: -1,
            field_count: 0,
            size_bytes: 0usize,
            align_bytes: 0usize,
            tag_offset_bytes: 0usize,
            payload_offset_bytes: 0usize,
            flags: 0,
            status: MIR_C99_TYPE_STATUS_REJECT,
        };
    }
    return MirC99AggregateLayoutEntry{
        owner_type_id: typ.type_id,
        c_type_kind: c_type_kind,
        field_start: typ.field_start,
        field_count: typ.field_count,
        size_bytes: typ.size_bytes,
        align_bytes: typ.align_bytes,
        tag_offset_bytes: typ.tag_offset_bytes,
        payload_offset_bytes: typ.payload_offset_bytes,
        flags: typ.flags,
        status: MIR_C99_TYPE_STATUS_READY,
    };
}

fn mir_c99_type_def_from_mir(typ: &MirType) MirC99TypeDef {
    if typ == null {
        return MirC99TypeDef{
            type_id: MIR_TYPE_INVALID_ID,
            source_type_id: 0,
            mir_kind: MIR_TYPE_KIND_VOID,
            c_type_kind: MIR_C99_C_TYPE_KIND_UNSUPPORTED,
            size_bytes: 0usize,
            align_bytes: 0usize,
            tag_offset_bytes: 0usize,
            payload_offset_bytes: 0usize,
            return_type_id: MIR_TYPE_INVALID_ID,
            callable_type_id: MIR_TYPE_INVALID_ID,
            calling_convention: 0,
            element_type_id: MIR_TYPE_INVALID_ID,
            pointee_type_id: MIR_TYPE_INVALID_ID,
            field_start: -1,
            field_count: 0,
            lane_count: 0,
            lane_stride_bytes: 0usize,
            abi_class: 0,
            flags: 0,
            status: MIR_C99_TYPE_STATUS_REJECT,
        };
    }
    var c_kind: i32 = MIR_C99_C_TYPE_KIND_UNSUPPORTED;
    var status: i32 = MIR_C99_TYPE_STATUS_READY;
    if typ.kind == MIR_TYPE_KIND_VOID {
        c_kind = MIR_C99_C_TYPE_KIND_VOID;
    } else if typ.kind == MIR_TYPE_KIND_BOOL {
        c_kind = MIR_C99_C_TYPE_KIND_BOOL;
    } else if typ.kind == MIR_TYPE_KIND_I8 {
        c_kind = MIR_C99_C_TYPE_KIND_I8;
    } else if typ.kind == MIR_TYPE_KIND_U8 {
        c_kind = MIR_C99_C_TYPE_KIND_U8;
    } else if typ.kind == MIR_TYPE_KIND_I16 {
        c_kind = MIR_C99_C_TYPE_KIND_I16;
    } else if typ.kind == MIR_TYPE_KIND_U16 {
        c_kind = MIR_C99_C_TYPE_KIND_U16;
    } else if typ.kind == MIR_TYPE_KIND_I32 {
        c_kind = MIR_C99_C_TYPE_KIND_I32;
    } else if typ.kind == MIR_TYPE_KIND_U32 {
        c_kind = MIR_C99_C_TYPE_KIND_U32;
    } else if typ.kind == MIR_TYPE_KIND_I64 {
        c_kind = MIR_C99_C_TYPE_KIND_I64;
    } else if typ.kind == MIR_TYPE_KIND_U64 {
        c_kind = MIR_C99_C_TYPE_KIND_U64;
    } else if typ.kind == MIR_TYPE_KIND_ISIZE {
        c_kind = MIR_C99_C_TYPE_KIND_ISIZE;
    } else if typ.kind == MIR_TYPE_KIND_USIZE {
        c_kind = MIR_C99_C_TYPE_KIND_USIZE;
    } else if typ.kind == MIR_TYPE_KIND_BYTE {
        c_kind = MIR_C99_C_TYPE_KIND_BYTE;
    } else if typ.kind == MIR_TYPE_KIND_F32 {
        c_kind = MIR_C99_C_TYPE_KIND_F32;
    } else if typ.kind == MIR_TYPE_KIND_F64 {
        c_kind = MIR_C99_C_TYPE_KIND_F64;
    } else if typ.kind == MIR_TYPE_KIND_ARRAY {
        c_kind = MIR_C99_C_TYPE_KIND_ARRAY;
    } else if typ.kind == MIR_TYPE_KIND_SLICE {
        c_kind = MIR_C99_C_TYPE_KIND_SLICE;
    } else if typ.kind == MIR_TYPE_KIND_UNION {
        c_kind = MIR_C99_C_TYPE_KIND_UNION;
    } else if typ.kind == MIR_TYPE_KIND_ENUM {
        c_kind = MIR_C99_C_TYPE_KIND_ENUM;
    } else if typ.kind == MIR_TYPE_KIND_ERROR_UNION {
        c_kind = MIR_C99_C_TYPE_KIND_ERROR_UNION;
    } else if typ.kind == MIR_TYPE_KIND_FUNCTION {
        c_kind = MIR_C99_C_TYPE_KIND_FUNCTION;
    } else if typ.kind == MIR_TYPE_KIND_FUNCTION_POINTER {
        c_kind = MIR_C99_C_TYPE_KIND_FUNCTION_POINTER;
    } else if typ.kind == MIR_TYPE_KIND_POINTER {
        c_kind = MIR_C99_C_TYPE_KIND_POINTER;
    } else if typ.kind == MIR_TYPE_KIND_STRUCT {
        c_kind = MIR_C99_C_TYPE_KIND_STRUCT;
    } else if typ.kind == MIR_TYPE_KIND_ATOMIC {
        c_kind = MIR_C99_C_TYPE_KIND_ATOMIC_HELPER;
    } else if typ.kind == MIR_TYPE_KIND_VECTOR {
        c_kind = MIR_C99_C_TYPE_KIND_VECTOR_HELPER;
    } else if typ.kind == MIR_TYPE_KIND_MASK {
        c_kind = MIR_C99_C_TYPE_KIND_MASK_HELPER;
    } else {
        status = MIR_C99_TYPE_STATUS_REJECT;
    }
    return MirC99TypeDef{
        type_id: typ.type_id,
        source_type_id: typ.source_type_id,
        mir_kind: typ.kind,
        c_type_kind: c_kind,
        size_bytes: typ.size_bytes,
        align_bytes: typ.align_bytes,
        tag_offset_bytes: typ.tag_offset_bytes,
        payload_offset_bytes: typ.payload_offset_bytes,
        return_type_id: typ.element_type_id,
        callable_type_id: typ.pointee_type_id,
        calling_convention: typ.flags,
        element_type_id: typ.element_type_id,
        pointee_type_id: typ.pointee_type_id,
        field_start: typ.field_start,
        field_count: typ.field_count,
        lane_count: typ.lane_count,
        lane_stride_bytes: typ.lane_stride_bytes,
        abi_class: typ.abi_class,
        flags: typ.flags,
        status: status,
    };
}

/// 功能说明：初始化 MIR-C99 typedef 计划。
/// 参数说明：`plan` 为输出计划。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_type_plan_init(plan: &MirC99TypePlan) i32 {
    if plan == null {
        return -1;
    }
    semantic_vector_init(&plan.entries, @size_of(MirC99TypeDef));
    semantic_vector_init(&plan.aggregate_layouts, @size_of(MirC99AggregateLayoutEntry));
    plan.count = 0usize;
    plan.aggregate_layout_count = 0usize;
    plan.reject_count = 0usize;
    return 0;
}

/// 功能说明：释放 MIR-C99 typedef 计划。
/// 参数说明：`plan` 为待释放计划；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_type_plan_release(plan: &MirC99TypePlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.entries);
    semantic_vector_release(&plan.aggregate_layouts);
    plan.count = 0usize;
    plan.aggregate_layout_count = 0usize;
    plan.reject_count = 0usize;
}

fn mir_c99_type_plan_append_aggregate_layout(type_plan: &MirC99TypePlan,
    typ: &MirType, c_type_kind: i32) i32 {
    if type_plan == null || typ == null {
        return -1;
    }
    if mir_c99_type_is_aggregate_layout_kind(typ) == 0 {
        return 0;
    }
    // PortableMIR verifier guarantees `portable_mir_verify_aggregate_field_layout`.
    const layout_entry: MirC99AggregateLayoutEntry =
        mir_c99_type_aggregate_layout_from_mir(typ, c_type_kind);
    if semantic_vector_append(&type_plan.aggregate_layouts,
        &layout_entry as &const void) != 0 {
        return -1;
    }
    type_plan.aggregate_layout_count = type_plan.aggregate_layouts.count;
    if layout_entry.status == MIR_C99_TYPE_STATUS_REJECT {
        type_plan.reject_count = type_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

/// 功能说明：向 MIR-C99 typedef 计划追加一个 MIR type 映射。
/// 参数说明：`type_plan` 为 typedef 计划，`output_plan` 为 MIR-C99 输出计划，`typ` 为 MIR type metadata。
/// 返回值说明：成功返回 `0`，追加失败或 unsupported type 返回 `-1`。
export fn mir_c99_type_plan_append(type_plan: &MirC99TypePlan, output_plan: &MirC99Plan, typ: &MirType) i32 {
    if type_plan == null || output_plan == null || typ == null {
        return -1;
    }
    const entry: MirC99TypeDef = mir_c99_type_def_from_mir(typ);
    if semantic_vector_append(&type_plan.entries, &entry as &const void) != 0 {
        return -1;
    }
    type_plan.count = type_plan.entries.count;
    if entry.status == MIR_C99_TYPE_STATUS_REJECT {
        type_plan.reject_count = type_plan.reject_count + 1usize;
        return -1;
    }
    if mir_c99_type_plan_append_aggregate_layout(type_plan, typ,
        entry.c_type_kind) != 0 {
        return -1;
    }
    if mir_c99_plan_append_ref(output_plan, MIR_C99_REF_KIND_TYPEDEF,
        entry.type_id, entry.c_type_kind, entry.flags) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：从 PortableMIR module 的 type metadata 构建 MIR-C99 typedef 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`output_plan` 为 MIR-C99 输出计划，`type_plan` 为输出 typedef 计划。
/// 返回值说明：所有 type 都映射成功返回 `0`，遇到 unsupported type 或参数非法返回 `-1`。
export fn mir_c99_type_plan_build(module: &PortableMirModule,
    output_plan: &MirC99Plan, type_plan: &MirC99TypePlan) i32 {
    if module == null || output_plan == null || type_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.types.count {
        const typ: &MirType = semantic_vector_item_ptr(&module.types, i) as &MirType;
        if mir_c99_type_plan_append(type_plan, output_plan, typ) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：按下标读取 MIR-C99 typedef 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_entry_ptr(type_plan: &MirC99TypePlan, index: i32) &MirC99TypeDef {
    if type_plan == null || index < 0 || (index as usize) >= type_plan.entries.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.entries, index as usize) as &MirC99TypeDef;
}

/// 功能说明：按下标读取 MIR-C99 aggregate layout 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 aggregate layout 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_aggregate_layout_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99AggregateLayoutEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.aggregate_layouts.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.aggregate_layouts,
        index as usize) as &MirC99AggregateLayoutEntry;
}
