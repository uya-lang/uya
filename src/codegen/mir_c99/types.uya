// codegen/mir_c99/types.uya - MIR layout metadata to MIR-C99 typedef plan.

use codegen.mir_c99.plan;

export const MIR_C99_C_TYPE_KIND_UNSUPPORTED: i32 = 0;
export const MIR_C99_C_TYPE_KIND_VOID: i32 = 1;
export const MIR_C99_C_TYPE_KIND_BOOL: i32 = 2;
export const MIR_C99_C_TYPE_KIND_I32: i32 = 3;
export const MIR_C99_C_TYPE_KIND_USIZE: i32 = 4;
export const MIR_C99_C_TYPE_KIND_POINTER: i32 = 5;
export const MIR_C99_C_TYPE_KIND_STRUCT: i32 = 6;
export const MIR_C99_C_TYPE_KIND_ATOMIC_HELPER: i32 = 7;
export const MIR_C99_C_TYPE_KIND_VECTOR_HELPER: i32 = 8;
export const MIR_C99_C_TYPE_KIND_MASK_HELPER: i32 = 9;
export const MIR_C99_C_TYPE_KIND_I8: i32 = 10;
export const MIR_C99_C_TYPE_KIND_U8: i32 = 11;
export const MIR_C99_C_TYPE_KIND_I16: i32 = 12;
export const MIR_C99_C_TYPE_KIND_U16: i32 = 13;
export const MIR_C99_C_TYPE_KIND_U32: i32 = 14;
export const MIR_C99_C_TYPE_KIND_I64: i32 = 15;
export const MIR_C99_C_TYPE_KIND_U64: i32 = 16;
export const MIR_C99_C_TYPE_KIND_ISIZE: i32 = 17;
export const MIR_C99_C_TYPE_KIND_BYTE: i32 = 18;
export const MIR_C99_C_TYPE_KIND_F32: i32 = 19;
export const MIR_C99_C_TYPE_KIND_F64: i32 = 20;
export const MIR_C99_C_TYPE_KIND_ARRAY: i32 = 21;
export const MIR_C99_C_TYPE_KIND_SLICE: i32 = 22;
export const MIR_C99_C_TYPE_KIND_UNION: i32 = 23;
export const MIR_C99_C_TYPE_KIND_ENUM: i32 = 24;
export const MIR_C99_C_TYPE_KIND_ERROR_UNION: i32 = 25;
export const MIR_C99_C_TYPE_KIND_FUNCTION: i32 = 26;
export const MIR_C99_C_TYPE_KIND_FUNCTION_POINTER: i32 = 27;

export const MIR_C99_TYPE_STATUS_MISSING: i32 = 0;
export const MIR_C99_TYPE_STATUS_READY: i32 = 1;
export const MIR_C99_TYPE_STATUS_REJECT: i32 = 2;

export const MIR_C99_FLOAT_LAYOUT_USE_AGGREGATE_FIELD: i32 = 1;
export const MIR_C99_FLOAT_LAYOUT_USE_ARRAY_ELEMENT: i32 = 2;
export const MIR_C99_FLOAT_LAYOUT_USE_SLICE_ELEMENT: i32 = 3;
export const MIR_C99_FLOAT_LAYOUT_USE_RETURN_VALUE: i32 = 4;
export const MIR_C99_FLOAT_LAYOUT_USE_PARAM: i32 = 5;

export const MIR_C99_LAYOUT_CHECK_KIND_SIZE: i32 = 1;
export const MIR_C99_LAYOUT_CHECK_KIND_ALIGN: i32 = 2;
export const MIR_C99_LAYOUT_CHECK_KIND_OFFSET: i32 = 3;

export const MIR_C99_LAYOUT_CHECK_FORM_TYPEDEF_CHAR_ARRAY: i32 = 1;

/// 功能说明：记录 f32/f64 在复合类型和 ABI signature 中的布局用途。
/// 参数说明：无；字段来自 MIR type、field layout 和 function param type metadata。
/// 返回值说明：无；由 `MirC99TypePlan.float_layout_uses` 动态保存。
export struct MirC99FloatLayoutUseEntry {
    use_kind: i32,
    container_type_id: MirTypeId,
    float_type_id: MirTypeId,
    slot_index: i32,
    size_bytes: usize,
    align_bytes: usize,
    abi_class: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR aggregate type 的字段和布局计划。
/// 参数说明：无；字段来自 verifier-clean MIR type/layout metadata。
/// 返回值说明：无；由 `MirC99TypePlan.aggregate_layouts` 动态保存。
export struct MirC99AggregateLayoutEntry {
    owner_type_id: MirTypeId,
    c_type_kind: i32,
    field_start: i32,
    field_count: i32,
    size_bytes: usize,
    align_bytes: usize,
    tag_offset_bytes: usize,
    payload_offset_bytes: usize,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR error-union type 的 tag/payload 布局计划。
/// 参数说明：无；字段来自 verifier-clean MIR type/layout metadata。
/// 返回值说明：无；由 `MirC99TypePlan.error_union_layouts` 动态保存。
export struct MirC99ErrorUnionLayoutEntry {
    owner_type_id: MirTypeId,
    payload_type_id: MirTypeId,
    tag_offset_bytes: usize,
    payload_offset_bytes: usize,
    size_bytes: usize,
    align_bytes: usize,
    abi_class: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR function/function-pointer type 的签名计划。
/// 参数说明：无；字段来自 verifier-clean MIR type 和 function param metadata。
/// 返回值说明：无；由 `MirC99TypePlan.function_signatures` 动态保存。
export struct MirC99FunctionSignatureEntry {
    owner_type_id: MirTypeId,
    c_type_kind: i32,
    return_type_id: MirTypeId,
    callable_type_id: MirTypeId,
    param_start: i32,
    param_count: i32,
    calling_convention: i32,
    abi_class: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR function/function-pointer type 的参数 ABI 计划。
/// 参数说明：无；字段来自 verifier-clean `MirFunctionParamType` metadata。
/// 返回值说明：无；由 `MirC99TypePlan.function_params` 动态保存。
export struct MirC99FunctionParamEntry {
    owner_type_id: MirTypeId,
    param_index: i32,
    param_type_id: MirTypeId,
    abi_class: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 layout compile-time check 计划。
/// 参数说明：无；字段来自 verifier-clean MIR type 和 field layout metadata。
/// 返回值说明：无；由 `MirC99TypePlan.layout_checks` 动态保存。
export struct MirC99LayoutCheckEntry {
    check_kind: i32,
    owner_type_id: MirTypeId,
    field_index: i32,
    expected_bytes: usize,
    check_form: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录一个 MIR type 到 MIR-C99 typedef 的计划条目。
/// 参数说明：无；字段全部来自 MIR type/layout metadata，不保存高层语义结构。
/// 返回值说明：无；由 `MirC99TypePlan.entries` 动态保存。
export struct MirC99TypeDef {
    type_id: MirTypeId,
    source_type_id: TypeId,
    mir_kind: i32,
    c_type_kind: i32,
    size_bytes: usize,
    align_bytes: usize,
    tag_offset_bytes: usize,
    payload_offset_bytes: usize,
    return_type_id: MirTypeId,
    callable_type_id: MirTypeId,
    calling_convention: i32,
    element_type_id: MirTypeId,
    pointee_type_id: MirTypeId,
    field_start: i32,
    field_count: i32,
    lane_count: i32,
    lane_stride_bytes: usize,
    abi_class: i32,
    flags: i32,
    status: i32,
}

/// 功能说明：记录 MIR-C99 typedef 计划。
/// 参数说明：无；`entries` 是按 MIR type 顺序追加的动态表。
/// 返回值说明：无；调用 `mir_c99_type_plan_init` 后使用。
export struct MirC99TypePlan {
    entries: SemanticVector,
    aggregate_layouts: SemanticVector,
    error_union_layouts: SemanticVector,
    function_signatures: SemanticVector,
    function_params: SemanticVector,
    layout_checks: SemanticVector,
    float_layout_uses: SemanticVector,
    count: usize,
    aggregate_layout_count: usize,
    error_union_layout_count: usize,
    function_signature_count: usize,
    function_param_count: usize,
    layout_check_count: usize,
    float_layout_use_count: usize,
    reject_count: usize,
}

fn mir_c99_type_ptr(module: &PortableMirModule, type_id: MirTypeId) &MirType {
    const index: i32 = type_id as i32;
    if module == null || index < 0 || (index as usize) >= module.types.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.types, index as usize) as &MirType;
}

fn mir_c99_type_field_layout_ptr(module: &PortableMirModule, index: i32) &MirFieldLayout {
    if module == null || index < 0 || (index as usize) >= module.field_layouts.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.field_layouts, index as usize) as &MirFieldLayout;
}

fn mir_c99_type_function_param_type_ptr(module: &PortableMirModule,
    index: i32) &MirFunctionParamType {
    if module == null || index < 0 ||
       (index as usize) >= module.function_param_types.count {
        return null;
    }
    return semantic_vector_item_ptr(&module.function_param_types,
        index as usize) as &MirFunctionParamType;
}

fn mir_c99_type_is_float_layout_kind(typ: &MirType) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_F32 || typ.kind == MIR_TYPE_KIND_F64 {
        return 1;
    }
    return 0;
}

fn mir_c99_type_is_aggregate_layout_kind(typ: &MirType) i32 {
    if typ == null {
        return 0;
    }
    if typ.kind == MIR_TYPE_KIND_STRUCT ||
       typ.kind == MIR_TYPE_KIND_UNION ||
       typ.kind == MIR_TYPE_KIND_ENUM {
        return 1;
    }
    return 0;
}

fn mir_c99_type_aggregate_layout_from_mir(typ: &MirType,
    c_type_kind: i32) MirC99AggregateLayoutEntry {
    if typ == null || mir_c99_type_is_aggregate_layout_kind(typ) == 0 ||
       typ.field_start < 0 || typ.field_count <= 0 ||
       typ.size_bytes == 0usize || typ.align_bytes == 0usize {
        return MirC99AggregateLayoutEntry{
            owner_type_id: MIR_TYPE_INVALID_ID,
            c_type_kind: MIR_C99_C_TYPE_KIND_UNSUPPORTED,
            field_start: -1,
            field_count: 0,
            size_bytes: 0usize,
            align_bytes: 0usize,
            tag_offset_bytes: 0usize,
            payload_offset_bytes: 0usize,
            flags: 0,
            status: MIR_C99_TYPE_STATUS_REJECT,
        };
    }
    return MirC99AggregateLayoutEntry{
        owner_type_id: typ.type_id,
        c_type_kind: c_type_kind,
        field_start: typ.field_start,
        field_count: typ.field_count,
        size_bytes: typ.size_bytes,
        align_bytes: typ.align_bytes,
        tag_offset_bytes: typ.tag_offset_bytes,
        payload_offset_bytes: typ.payload_offset_bytes,
        flags: typ.flags,
        status: MIR_C99_TYPE_STATUS_READY,
    };
}

fn mir_c99_type_error_union_layout_from_mir(typ: &MirType) MirC99ErrorUnionLayoutEntry {
    if typ == null || typ.kind != MIR_TYPE_KIND_ERROR_UNION ||
       typ.element_type_id == MIR_TYPE_INVALID_ID ||
       typ.size_bytes == 0usize || typ.align_bytes == 0usize ||
       typ.payload_offset_bytes <= typ.tag_offset_bytes ||
       typ.abi_class != MIR_ABI_CLASS_ERROR_UNION {
        return MirC99ErrorUnionLayoutEntry{
            owner_type_id: MIR_TYPE_INVALID_ID,
            payload_type_id: MIR_TYPE_INVALID_ID,
            tag_offset_bytes: 0usize,
            payload_offset_bytes: 0usize,
            size_bytes: 0usize,
            align_bytes: 0usize,
            abi_class: 0,
            flags: 0,
            status: MIR_C99_TYPE_STATUS_REJECT,
        };
    }
    return MirC99ErrorUnionLayoutEntry{
        owner_type_id: typ.type_id,
        payload_type_id: typ.element_type_id,
        tag_offset_bytes: typ.tag_offset_bytes,
        payload_offset_bytes: typ.payload_offset_bytes,
        size_bytes: typ.size_bytes,
        align_bytes: typ.align_bytes,
        abi_class: typ.abi_class,
        flags: typ.flags,
        status: MIR_C99_TYPE_STATUS_READY,
    };
}

fn mir_c99_type_plan_append_float_layout_use(type_plan: &MirC99TypePlan,
    use_kind: i32, container_type_id: MirTypeId, float_type: &MirType,
    slot_index: i32, abi_class: i32, flags: i32) i32 {
    if type_plan == null || mir_c99_type_is_float_layout_kind(float_type) == 0 ||
       float_type.size_bytes == 0usize || float_type.align_bytes == 0usize {
        return -1;
    }
    const entry: MirC99FloatLayoutUseEntry = MirC99FloatLayoutUseEntry{
        use_kind: use_kind,
        container_type_id: container_type_id,
        float_type_id: float_type.type_id,
        slot_index: slot_index,
        size_bytes: float_type.size_bytes,
        align_bytes: float_type.align_bytes,
        abi_class: abi_class,
        flags: flags,
        status: MIR_C99_TYPE_STATUS_READY,
    };
    if semantic_vector_append(&type_plan.float_layout_uses,
        &entry as &const void) != 0 {
        return -1;
    }
    type_plan.float_layout_use_count = type_plan.float_layout_uses.count;
    return 0;
}

fn mir_c99_type_def_from_mir(typ: &MirType) MirC99TypeDef {
    if typ == null {
        return MirC99TypeDef{
            type_id: MIR_TYPE_INVALID_ID,
            source_type_id: 0,
            mir_kind: MIR_TYPE_KIND_VOID,
            c_type_kind: MIR_C99_C_TYPE_KIND_UNSUPPORTED,
            size_bytes: 0usize,
            align_bytes: 0usize,
            tag_offset_bytes: 0usize,
            payload_offset_bytes: 0usize,
            return_type_id: MIR_TYPE_INVALID_ID,
            callable_type_id: MIR_TYPE_INVALID_ID,
            calling_convention: 0,
            element_type_id: MIR_TYPE_INVALID_ID,
            pointee_type_id: MIR_TYPE_INVALID_ID,
            field_start: -1,
            field_count: 0,
            lane_count: 0,
            lane_stride_bytes: 0usize,
            abi_class: 0,
            flags: 0,
            status: MIR_C99_TYPE_STATUS_REJECT,
        };
    }
    var c_kind: i32 = MIR_C99_C_TYPE_KIND_UNSUPPORTED;
    var status: i32 = MIR_C99_TYPE_STATUS_READY;
    if typ.kind == MIR_TYPE_KIND_VOID {
        c_kind = MIR_C99_C_TYPE_KIND_VOID;
    } else if typ.kind == MIR_TYPE_KIND_BOOL {
        c_kind = MIR_C99_C_TYPE_KIND_BOOL;
    } else if typ.kind == MIR_TYPE_KIND_I8 {
        c_kind = MIR_C99_C_TYPE_KIND_I8;
    } else if typ.kind == MIR_TYPE_KIND_U8 {
        c_kind = MIR_C99_C_TYPE_KIND_U8;
    } else if typ.kind == MIR_TYPE_KIND_I16 {
        c_kind = MIR_C99_C_TYPE_KIND_I16;
    } else if typ.kind == MIR_TYPE_KIND_U16 {
        c_kind = MIR_C99_C_TYPE_KIND_U16;
    } else if typ.kind == MIR_TYPE_KIND_I32 {
        c_kind = MIR_C99_C_TYPE_KIND_I32;
    } else if typ.kind == MIR_TYPE_KIND_U32 {
        c_kind = MIR_C99_C_TYPE_KIND_U32;
    } else if typ.kind == MIR_TYPE_KIND_I64 {
        c_kind = MIR_C99_C_TYPE_KIND_I64;
    } else if typ.kind == MIR_TYPE_KIND_U64 {
        c_kind = MIR_C99_C_TYPE_KIND_U64;
    } else if typ.kind == MIR_TYPE_KIND_ISIZE {
        c_kind = MIR_C99_C_TYPE_KIND_ISIZE;
    } else if typ.kind == MIR_TYPE_KIND_USIZE {
        c_kind = MIR_C99_C_TYPE_KIND_USIZE;
    } else if typ.kind == MIR_TYPE_KIND_BYTE {
        c_kind = MIR_C99_C_TYPE_KIND_BYTE;
    } else if typ.kind == MIR_TYPE_KIND_F32 {
        c_kind = MIR_C99_C_TYPE_KIND_F32;
    } else if typ.kind == MIR_TYPE_KIND_F64 {
        c_kind = MIR_C99_C_TYPE_KIND_F64;
    } else if typ.kind == MIR_TYPE_KIND_ARRAY {
        c_kind = MIR_C99_C_TYPE_KIND_ARRAY;
    } else if typ.kind == MIR_TYPE_KIND_SLICE {
        c_kind = MIR_C99_C_TYPE_KIND_SLICE;
    } else if typ.kind == MIR_TYPE_KIND_UNION {
        c_kind = MIR_C99_C_TYPE_KIND_UNION;
    } else if typ.kind == MIR_TYPE_KIND_ENUM {
        c_kind = MIR_C99_C_TYPE_KIND_ENUM;
    } else if typ.kind == MIR_TYPE_KIND_ERROR_UNION {
        c_kind = MIR_C99_C_TYPE_KIND_ERROR_UNION;
    } else if typ.kind == MIR_TYPE_KIND_FUNCTION {
        c_kind = MIR_C99_C_TYPE_KIND_FUNCTION;
    } else if typ.kind == MIR_TYPE_KIND_FUNCTION_POINTER {
        c_kind = MIR_C99_C_TYPE_KIND_FUNCTION_POINTER;
    } else if typ.kind == MIR_TYPE_KIND_POINTER {
        c_kind = MIR_C99_C_TYPE_KIND_POINTER;
    } else if typ.kind == MIR_TYPE_KIND_STRUCT {
        c_kind = MIR_C99_C_TYPE_KIND_STRUCT;
    } else if typ.kind == MIR_TYPE_KIND_ATOMIC {
        c_kind = MIR_C99_C_TYPE_KIND_ATOMIC_HELPER;
    } else if typ.kind == MIR_TYPE_KIND_VECTOR {
        c_kind = MIR_C99_C_TYPE_KIND_VECTOR_HELPER;
    } else if typ.kind == MIR_TYPE_KIND_MASK {
        c_kind = MIR_C99_C_TYPE_KIND_MASK_HELPER;
    } else {
        status = MIR_C99_TYPE_STATUS_REJECT;
    }
    return MirC99TypeDef{
        type_id: typ.type_id,
        source_type_id: typ.source_type_id,
        mir_kind: typ.kind,
        c_type_kind: c_kind,
        size_bytes: typ.size_bytes,
        align_bytes: typ.align_bytes,
        tag_offset_bytes: typ.tag_offset_bytes,
        payload_offset_bytes: typ.payload_offset_bytes,
        return_type_id: typ.element_type_id,
        callable_type_id: typ.pointee_type_id,
        calling_convention: typ.flags,
        element_type_id: typ.element_type_id,
        pointee_type_id: typ.pointee_type_id,
        field_start: typ.field_start,
        field_count: typ.field_count,
        lane_count: typ.lane_count,
        lane_stride_bytes: typ.lane_stride_bytes,
        abi_class: typ.abi_class,
        flags: typ.flags,
        status: status,
    };
}

/// 功能说明：初始化 MIR-C99 typedef 计划。
/// 参数说明：`plan` 为输出计划。
/// 返回值说明：成功返回 `0`，参数非法返回 `-1`。
export fn mir_c99_type_plan_init(plan: &MirC99TypePlan) i32 {
    if plan == null {
        return -1;
    }
    semantic_vector_init(&plan.entries, @size_of(MirC99TypeDef));
    semantic_vector_init(&plan.aggregate_layouts, @size_of(MirC99AggregateLayoutEntry));
    semantic_vector_init(&plan.error_union_layouts, @size_of(MirC99ErrorUnionLayoutEntry));
    semantic_vector_init(&plan.function_signatures, @size_of(MirC99FunctionSignatureEntry));
    semantic_vector_init(&plan.function_params, @size_of(MirC99FunctionParamEntry));
    semantic_vector_init(&plan.layout_checks, @size_of(MirC99LayoutCheckEntry));
    semantic_vector_init(&plan.float_layout_uses, @size_of(MirC99FloatLayoutUseEntry));
    plan.count = 0usize;
    plan.aggregate_layout_count = 0usize;
    plan.error_union_layout_count = 0usize;
    plan.function_signature_count = 0usize;
    plan.function_param_count = 0usize;
    plan.layout_check_count = 0usize;
    plan.float_layout_use_count = 0usize;
    plan.reject_count = 0usize;
    return 0;
}

/// 功能说明：释放 MIR-C99 typedef 计划。
/// 参数说明：`plan` 为待释放计划；允许传入 null。
/// 返回值说明：无。
export fn mir_c99_type_plan_release(plan: &MirC99TypePlan) void {
    if plan == null {
        return;
    }
    semantic_vector_release(&plan.entries);
    semantic_vector_release(&plan.aggregate_layouts);
    semantic_vector_release(&plan.error_union_layouts);
    semantic_vector_release(&plan.function_signatures);
    semantic_vector_release(&plan.function_params);
    semantic_vector_release(&plan.layout_checks);
    semantic_vector_release(&plan.float_layout_uses);
    plan.count = 0usize;
    plan.aggregate_layout_count = 0usize;
    plan.error_union_layout_count = 0usize;
    plan.function_signature_count = 0usize;
    plan.function_param_count = 0usize;
    plan.layout_check_count = 0usize;
    plan.float_layout_use_count = 0usize;
    plan.reject_count = 0usize;
}

fn mir_c99_type_plan_append_aggregate_layout(type_plan: &MirC99TypePlan,
    typ: &MirType, c_type_kind: i32) i32 {
    if type_plan == null || typ == null {
        return -1;
    }
    if mir_c99_type_is_aggregate_layout_kind(typ) == 0 {
        return 0;
    }
    // PortableMIR verifier guarantees `portable_mir_verify_aggregate_field_layout`.
    const layout_entry: MirC99AggregateLayoutEntry =
        mir_c99_type_aggregate_layout_from_mir(typ, c_type_kind);
    if semantic_vector_append(&type_plan.aggregate_layouts,
        &layout_entry as &const void) != 0 {
        return -1;
    }
    type_plan.aggregate_layout_count = type_plan.aggregate_layouts.count;
    if layout_entry.status == MIR_C99_TYPE_STATUS_REJECT {
        type_plan.reject_count = type_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

fn mir_c99_type_plan_append_error_union_layout(type_plan: &MirC99TypePlan,
    typ: &MirType) i32 {
    if type_plan == null || typ == null {
        return -1;
    }
    if typ.kind != MIR_TYPE_KIND_ERROR_UNION {
        return 0;
    }
    // PortableMIR verifier guarantees `portable_mir_verify_error_union_layout`.
    const layout_entry: MirC99ErrorUnionLayoutEntry =
        mir_c99_type_error_union_layout_from_mir(typ);
    if semantic_vector_append(&type_plan.error_union_layouts,
        &layout_entry as &const void) != 0 {
        return -1;
    }
    type_plan.error_union_layout_count = type_plan.error_union_layouts.count;
    if layout_entry.status == MIR_C99_TYPE_STATUS_REJECT {
        type_plan.reject_count = type_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

fn mir_c99_type_function_c_kind(typ: &MirType) i32 {
    if typ == null {
        return MIR_C99_C_TYPE_KIND_UNSUPPORTED;
    }
    if typ.kind == MIR_TYPE_KIND_FUNCTION {
        return MIR_C99_C_TYPE_KIND_FUNCTION;
    }
    if typ.kind == MIR_TYPE_KIND_FUNCTION_POINTER {
        return MIR_C99_C_TYPE_KIND_FUNCTION_POINTER;
    }
    return MIR_C99_C_TYPE_KIND_UNSUPPORTED;
}

fn mir_c99_type_plan_append_function_param(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType, i: i32) i32 {
    const param: &MirFunctionParamType =
        mir_c99_type_function_param_type_ptr(module, typ.field_start + i);
    if param == null || param.owner_type_id != typ.type_id ||
       param.param_index != i ||
       mir_c99_type_ptr(module, param.type_id) == null {
        return -1;
    }
    const entry: MirC99FunctionParamEntry = MirC99FunctionParamEntry{
        owner_type_id: param.owner_type_id,
        param_index: param.param_index,
        param_type_id: param.type_id,
        abi_class: param.abi_class,
        flags: param.flags,
        status: MIR_C99_TYPE_STATUS_READY,
    };
    if semantic_vector_append(&type_plan.function_params,
        &entry as &const void) != 0 {
        return -1;
    }
    type_plan.function_param_count = type_plan.function_params.count;
    return 0;
}

fn mir_c99_type_plan_append_function_signature(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType) i32 {
    if module == null || type_plan == null || typ == null {
        return -1;
    }
    if typ.kind != MIR_TYPE_KIND_FUNCTION && typ.kind != MIR_TYPE_KIND_FUNCTION_POINTER {
        return 0;
    }
    // PortableMIR verifier guarantees `portable_mir_verify_function_type_layout`.
    const param_start: i32 = type_plan.function_params.count as i32;
    var status: i32 = MIR_C99_TYPE_STATUS_READY;
    if mir_c99_type_ptr(module, typ.element_type_id) == null ||
       typ.field_count < 0 ||
       mir_c99_type_function_c_kind(typ) == MIR_C99_C_TYPE_KIND_UNSUPPORTED {
        status = MIR_C99_TYPE_STATUS_REJECT;
    }
    var i: i32 = 0;
    while i < typ.field_count {
        if mir_c99_type_plan_append_function_param(module, type_plan, typ, i) != 0 {
            status = MIR_C99_TYPE_STATUS_REJECT;
        }
        i = i + 1;
    }
    const entry: MirC99FunctionSignatureEntry = MirC99FunctionSignatureEntry{
        owner_type_id: typ.type_id,
        c_type_kind: mir_c99_type_function_c_kind(typ),
        return_type_id: typ.element_type_id,
        callable_type_id: typ.pointee_type_id,
        param_start: param_start,
        param_count: typ.field_count,
        calling_convention: typ.flags,
        abi_class: typ.abi_class,
        flags: typ.flags,
        status: status,
    };
    if semantic_vector_append(&type_plan.function_signatures,
        &entry as &const void) != 0 {
        return -1;
    }
    type_plan.function_signature_count = type_plan.function_signatures.count;
    if status == MIR_C99_TYPE_STATUS_REJECT {
        type_plan.reject_count = type_plan.reject_count + 1usize;
        return -1;
    }
    return 0;
}

fn mir_c99_type_plan_append_layout_check(type_plan: &MirC99TypePlan,
    check_kind: i32, owner_type_id: MirTypeId, field_index: i32,
    expected_bytes: usize, flags: i32) i32 {
    if type_plan == null {
        return -1;
    }
    if check_kind != MIR_C99_LAYOUT_CHECK_KIND_OFFSET && expected_bytes == 0usize {
        return -1;
    }
    const entry: MirC99LayoutCheckEntry = MirC99LayoutCheckEntry{
        check_kind: check_kind,
        owner_type_id: owner_type_id,
        field_index: field_index,
        expected_bytes: expected_bytes,
        check_form: MIR_C99_LAYOUT_CHECK_FORM_TYPEDEF_CHAR_ARRAY,
        flags: flags,
        status: MIR_C99_TYPE_STATUS_READY,
    };
    if semantic_vector_append(&type_plan.layout_checks,
        &entry as &const void) != 0 {
        return -1;
    }
    type_plan.layout_check_count = type_plan.layout_checks.count;
    return 0;
}

fn mir_c99_type_plan_append_type_layout_checks(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType) i32 {
    if module == null || type_plan == null || typ == null {
        return -1;
    }
    if typ.size_bytes == 0usize || typ.align_bytes == 0usize {
        return 0;
    }
    var status: i32 = 0;
    if mir_c99_type_plan_append_layout_check(type_plan,
        MIR_C99_LAYOUT_CHECK_KIND_SIZE, typ.type_id, -1,
        typ.size_bytes, typ.flags) != 0 {
        status = -1;
    }
    if mir_c99_type_plan_append_layout_check(type_plan,
        MIR_C99_LAYOUT_CHECK_KIND_ALIGN, typ.type_id, -1,
        typ.align_bytes, typ.flags) != 0 {
        status = -1;
    }
    if typ.kind == MIR_TYPE_KIND_STRUCT ||
       typ.kind == MIR_TYPE_KIND_UNION ||
       typ.kind == MIR_TYPE_KIND_ENUM {
        var i: i32 = 0;
        while i < typ.field_count {
            const field: &MirFieldLayout =
                mir_c99_type_field_layout_ptr(module, typ.field_start + i);
            if field == null ||
               mir_c99_type_plan_append_layout_check(type_plan,
                MIR_C99_LAYOUT_CHECK_KIND_OFFSET, typ.type_id,
                field.field_index, field.offset_bytes, field.flags) != 0 {
                status = -1;
            }
            i = i + 1;
        }
    }
    if typ.kind == MIR_TYPE_KIND_ERROR_UNION {
        if mir_c99_type_plan_append_layout_check(type_plan,
            MIR_C99_LAYOUT_CHECK_KIND_OFFSET, typ.type_id, 0,
            typ.tag_offset_bytes, typ.flags) != 0 {
            status = -1;
        }
        if mir_c99_type_plan_append_layout_check(type_plan,
            MIR_C99_LAYOUT_CHECK_KIND_OFFSET, typ.type_id, 1,
            typ.payload_offset_bytes, typ.flags) != 0 {
            status = -1;
        }
    }
    return status;
}

fn mir_c99_type_plan_append_float_aggregate_fields(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType) i32 {
    if module == null || type_plan == null || mir_c99_type_is_aggregate_layout_kind(typ) == 0 {
        return 0;
    }
    var status: i32 = 0;
    var i: i32 = 0;
    while i < typ.field_count {
        const field: &MirFieldLayout = mir_c99_type_field_layout_ptr(module,
            typ.field_start + i);
        if field != null {
            const field_type: &MirType = mir_c99_type_ptr(module, field.field_type_id);
            if field_type != null &&
               (field_type.kind == MIR_TYPE_KIND_F32 || field_type.kind == MIR_TYPE_KIND_F64) {
                if mir_c99_type_plan_append_float_layout_use(type_plan,
                    MIR_C99_FLOAT_LAYOUT_USE_AGGREGATE_FIELD, typ.type_id,
                    field_type, field.field_index, field_type.abi_class,
                    field.flags) != 0 {
                    status = -1;
                }
            }
        }
        i = i + 1;
    }
    return status;
}

fn mir_c99_type_plan_append_float_element(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType) i32 {
    if module == null || type_plan == null || typ == null {
        return -1;
    }
    if typ.kind != MIR_TYPE_KIND_ARRAY && typ.kind != MIR_TYPE_KIND_SLICE {
        return 0;
    }
    const element_type: &MirType = mir_c99_type_ptr(module, typ.element_type_id);
    if element_type != null &&
       (element_type.kind == MIR_TYPE_KIND_F32 || element_type.kind == MIR_TYPE_KIND_F64) {
        var use_kind: i32 = MIR_C99_FLOAT_LAYOUT_USE_ARRAY_ELEMENT;
        if typ.kind == MIR_TYPE_KIND_SLICE {
            use_kind = MIR_C99_FLOAT_LAYOUT_USE_SLICE_ELEMENT;
        }
        return mir_c99_type_plan_append_float_layout_use(type_plan, use_kind,
            typ.type_id, element_type, -1, element_type.abi_class, typ.flags);
    }
    return 0;
}

fn mir_c99_type_plan_append_float_signature(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType) i32 {
    if module == null || type_plan == null || typ == null ||
       typ.kind != MIR_TYPE_KIND_FUNCTION {
        return 0;
    }
    var status: i32 = 0;
    const return_type: &MirType = mir_c99_type_ptr(module, typ.element_type_id);
    if return_type != null &&
       (return_type.kind == MIR_TYPE_KIND_F32 || return_type.kind == MIR_TYPE_KIND_F64) {
        if mir_c99_type_plan_append_float_layout_use(type_plan,
            MIR_C99_FLOAT_LAYOUT_USE_RETURN_VALUE, typ.type_id, return_type,
            -1, return_type.abi_class, typ.flags) != 0 {
            status = -1;
        }
    }
    var i: i32 = 0;
    while i < typ.field_count {
        const param: &MirFunctionParamType =
            mir_c99_type_function_param_type_ptr(module, typ.field_start + i);
        if param != null {
            const param_type: &MirType = mir_c99_type_ptr(module, param.type_id);
            if param_type != null &&
               (param_type.kind == MIR_TYPE_KIND_F32 || param_type.kind == MIR_TYPE_KIND_F64) {
                if mir_c99_type_plan_append_float_layout_use(type_plan,
                    MIR_C99_FLOAT_LAYOUT_USE_PARAM, typ.type_id, param_type,
                    param.param_index, param.abi_class, param.flags) != 0 {
                    status = -1;
                }
            }
        }
        i = i + 1;
    }
    return status;
}

fn mir_c99_type_plan_append_float_layout_uses(module: &PortableMirModule,
    type_plan: &MirC99TypePlan, typ: &MirType) i32 {
    if module == null || type_plan == null || typ == null {
        return -1;
    }
    var status: i32 = 0;
    if typ.kind == MIR_TYPE_KIND_F32 || typ.kind == MIR_TYPE_KIND_F64 {
        if mir_c99_type_plan_append_float_layout_use(type_plan,
            MIR_C99_FLOAT_LAYOUT_USE_RETURN_VALUE, typ.type_id, typ, -1,
            typ.abi_class, typ.flags) != 0 {
            status = -1;
        }
    }
    if mir_c99_type_plan_append_float_aggregate_fields(module, type_plan, typ) != 0 {
        status = -1;
    }
    if mir_c99_type_plan_append_float_element(module, type_plan, typ) != 0 {
        status = -1;
    }
    if mir_c99_type_plan_append_float_signature(module, type_plan, typ) != 0 {
        status = -1;
    }
    return status;
}

/// 功能说明：向 MIR-C99 typedef 计划追加一个 MIR type 映射。
/// 参数说明：`type_plan` 为 typedef 计划，`output_plan` 为 MIR-C99 输出计划，`typ` 为 MIR type metadata。
/// 返回值说明：成功返回 `0`，追加失败或 unsupported type 返回 `-1`。
export fn mir_c99_type_plan_append(type_plan: &MirC99TypePlan, output_plan: &MirC99Plan, typ: &MirType) i32 {
    if type_plan == null || output_plan == null || typ == null {
        return -1;
    }
    const entry: MirC99TypeDef = mir_c99_type_def_from_mir(typ);
    if semantic_vector_append(&type_plan.entries, &entry as &const void) != 0 {
        return -1;
    }
    type_plan.count = type_plan.entries.count;
    if entry.status == MIR_C99_TYPE_STATUS_REJECT {
        type_plan.reject_count = type_plan.reject_count + 1usize;
        return -1;
    }
    if mir_c99_type_plan_append_aggregate_layout(type_plan, typ,
        entry.c_type_kind) != 0 {
        return -1;
    }
    if mir_c99_type_plan_append_error_union_layout(type_plan, typ) != 0 {
        return -1;
    }
    if mir_c99_plan_append_ref(output_plan, MIR_C99_REF_KIND_TYPEDEF,
        entry.type_id, entry.c_type_kind, entry.flags) != 0 {
        return -1;
    }
    return 0;
}

/// 功能说明：从 PortableMIR module 的 type metadata 构建 MIR-C99 typedef 计划。
/// 参数说明：`module` 为 verifier-clean MIR module，`output_plan` 为 MIR-C99 输出计划，`type_plan` 为输出 typedef 计划。
/// 返回值说明：所有 type 都映射成功返回 `0`，遇到 unsupported type 或参数非法返回 `-1`。
export fn mir_c99_type_plan_build(module: &PortableMirModule,
    output_plan: &MirC99Plan, type_plan: &MirC99TypePlan) i32 {
    if module == null || output_plan == null || type_plan == null {
        return -1;
    }
    var status: i32 = 0;
    var i: usize = 0usize;
    while i < module.types.count {
        const typ: &MirType = semantic_vector_item_ptr(&module.types, i) as &MirType;
        if mir_c99_type_plan_append(type_plan, output_plan, typ) != 0 {
            status = -1;
        }
        if mir_c99_type_plan_append_function_signature(module, type_plan, typ) != 0 {
            status = -1;
        }
        if mir_c99_type_plan_append_type_layout_checks(module, type_plan, typ) != 0 {
            status = -1;
        }
        if mir_c99_type_plan_append_float_layout_uses(module, type_plan, typ) != 0 {
            status = -1;
        }
        i = i + 1usize;
    }
    return status;
}

/// 功能说明：按下标读取 MIR-C99 typedef 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_entry_ptr(type_plan: &MirC99TypePlan, index: i32) &MirC99TypeDef {
    if type_plan == null || index < 0 || (index as usize) >= type_plan.entries.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.entries, index as usize) as &MirC99TypeDef;
}

/// 功能说明：按下标读取 MIR-C99 aggregate layout 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 aggregate layout 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_aggregate_layout_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99AggregateLayoutEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.aggregate_layouts.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.aggregate_layouts,
        index as usize) as &MirC99AggregateLayoutEntry;
}

/// 功能说明：按下标读取 MIR-C99 error-union layout 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 error-union layout 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_error_union_layout_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99ErrorUnionLayoutEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.error_union_layouts.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.error_union_layouts,
        index as usize) as &MirC99ErrorUnionLayoutEntry;
}

/// 功能说明：按下标读取 MIR-C99 function signature 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 function signature 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_function_signature_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99FunctionSignatureEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.function_signatures.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.function_signatures,
        index as usize) as &MirC99FunctionSignatureEntry;
}

/// 功能说明：按下标读取 MIR-C99 function param 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 function param 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_function_param_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99FunctionParamEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.function_params.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.function_params,
        index as usize) as &MirC99FunctionParamEntry;
}

/// 功能说明：按下标读取 MIR-C99 layout check 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 layout check 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_layout_check_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99LayoutCheckEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.layout_checks.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.layout_checks,
        index as usize) as &MirC99LayoutCheckEntry;
}

/// 功能说明：按下标读取 MIR-C99 f32/f64 layout use 计划条目。
/// 参数说明：`type_plan` 为 typedef 计划，`index` 为 float layout use 条目下标。
/// 返回值说明：成功返回条目指针，参数非法返回 null。
export fn mir_c99_type_plan_float_layout_use_ptr(type_plan: &MirC99TypePlan,
    index: i32) &MirC99FloatLayoutUseEntry {
    if type_plan == null || index < 0 ||
       (index as usize) >= type_plan.float_layout_uses.count {
        return null;
    }
    return semantic_vector_item_ptr(&type_plan.float_layout_uses,
        index as usize) as &MirC99FloatLayoutUseEntry;
}
