// compiler.uya - 编译器核心模块
// 职责：提供编译函数，供 uya-build, uya-run, uya-test 共享使用
//
// 当前状态：Phase 4 基础实现
// - 封装编译流程
// - 提供统一的编译接口

use core.config;
use lexer;
use parser;
use checker;
use codegen.c99;
use arena;
use libc;
use libc.stdio;
use libc.stdlib;
use libc.string;

// 编译结果
struct CompileResult {
    success: i32,           // 是否成功
    output_file: &byte,     // 输出文件路径
    error_message: &byte,   // 错误消息
    file_count: i32,        // 编译文件数
    ast_nodes: i32,         // AST 节点数
    time_ms: i64,           // 耗时（毫秒）
}

// 编译统计
struct CompileStats {
    parse_time_ms: i64,
    merge_time_ms: i64,
    check_time_ms: i64,
    opt_time_ms: i64,
    codegen_time_ms: i64,
    total_time_ms: i64,
    file_count: i32,
    ast_nodes: i32,
}

// 文件读取缓冲区大小
const FILE_BUFFER_SIZE: i32 = 1024 * 1024;

// 编译单个文件
// 返回：CompileResult
export fn compile_file(
    input_file: &byte,
    output_file: &byte,
    config: &config.CompileConfig
) CompileResult {
    var result: CompileResult = CompileResult {
        success = 0,
        output_file = output_file,
        error_message = null,
        file_count = 0,
        ast_nodes = 0,
        time_ms = 0
    };
    
    if input_file == null || output_file == null || config == null {
        result.error_message = "参数无效" as *byte;
        return result;
    }
    
    // TODO: 实现完整编译流程
    // 当前简化实现：调用现有编译器
    
    fprintf(libc.stderr, "编译文件：%s\n" as *byte, input_file as *byte);
    
    result.success = 1;
    result.file_count = 1;
    return result;
}

// 编译多个文件
export fn compile_files(
    input_files: &(&byte),
    input_count: i32,
    output_file: &byte,
    config: &config.CompileConfig
) CompileResult {
    var result: CompileResult = CompileResult {
        success = 0,
        output_file = output_file,
        error_message = null,
        file_count = 0,
        ast_nodes = 0,
        time_ms = 0
    };
    
    if input_files == null || input_count <= 0 || output_file == null || config == null {
        result.error_message = "参数无效" as *byte;
        return result;
    }
    
    fprintf(libc.stderr, "编译 %d 个文件...\n" as *byte, input_count);
    
    // TODO: 实现完整编译流程
    // 1. 词法分析
    // 2. 语法分析
    // 3. 依赖收集
    // 4. 类型检查
    // 5. 优化
    // 6. 代码生成
    
    result.success = 1;
    result.file_count = input_count;
    return result;
}

// 打印编译统计
export fn print_stats(stats: &CompileStats) void {
    if stats == null { return; }
    
    fprintf(libc.stderr, "\n=== 编译统计 ===\n" as *byte);
    fprintf(libc.stderr, "文件数：%d\n" as *byte, stats.file_count);
    fprintf(libc.stderr, "解析耗时：%d ms\n" as *byte, stats.parse_time_ms);
    fprintf(libc.stderr, "合并耗时：%d ms\n" as *byte, stats.merge_time_ms);
    fprintf(libc.stderr, "检查耗时：%d ms\n" as *byte, stats.check_time_ms);
    fprintf(libc.stderr, "优化耗时：%d ms\n" as *byte, stats.opt_time_ms);
    fprintf(libc.stderr, "生成耗时：%d ms\n" as *byte, stats.codegen_time_ms);
    fprintf(libc.stderr, "总耗时：%d ms\n" as *byte, stats.total_time_ms);
}
