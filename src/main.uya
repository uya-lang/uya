// main.uya - Uya command launcher
// 架构：export fn main 编译为 main_main，由 std.runtime.entry 的 C main 调用。

use std.runtime.get_argc;
use std.runtime.get_argv;
use std.runtime.ptr_diff;
use std.runtime.saved_envp;
use libc.FILE;
use libc.stderr;
use libc.fprintf;
use libc.snprintf;
use libc.malloc;
use libc.free;
use libc.memcpy;
use libc.strcmp;
use libc.strrchr;
use libc.access;
use libc.execve;
use libc.readlink;
use libc.X_OK;

const PATH_MAX: usize = 4096usize;

fn launcher_is_external_cmd(name: &byte) i32 {
    if name == null {
        return 0;
    }
    if strcmp(name as *byte, "build" as *byte) == 0 {
        return 1;
    }
    if strcmp(name as *byte, "check" as *byte) == 0 {
        return 1;
    }
    if strcmp(name as *byte, "run" as *byte) == 0 {
        return 1;
    }
    if strcmp(name as *byte, "test" as *byte) == 0 {
        return 1;
    }
    if strcmp(name as *byte, "fmt" as *byte) == 0 {
        return 1;
    }
    if strcmp(name as *byte, "upm" as *byte) == 0 {
        return 1;
    }
    if strcmp(name as *byte, "microapp" as *byte) == 0 {
        return 1;
    }
    return 0;
}

fn launcher_get_dir(argv0: &byte, buffer: &byte, buffer_size: usize) i32 {
    if argv0 == null || buffer == null || buffer_size == 0usize {
        return 1;
    }
    const argv_slash: *byte = strrchr(argv0 as *byte, 47);
    if argv_slash != null {
        const dir_len_tmp: !usize = ptr_diff(argv_slash, argv0) as! usize;
        const dir_len: usize = dir_len_tmp.value;
        if dir_len + 1usize < buffer_size {
            memcpy(buffer as *byte, argv0 as *const byte, dir_len);
            buffer[dir_len] = 47 as byte;
            buffer[dir_len + 1usize] = 0 as byte;
            return 0;
        }
    }

    var resolved_path: [byte: PATH_MAX] = [];
    const len: i32 = readlink("/proc/self/exe" as *byte, &resolved_path[0], PATH_MAX - 1usize);
    if len != -1 {
        resolved_path[len as usize] = 0 as byte;
        const last_slash: *byte = strrchr(&resolved_path[0], 47);
        if last_slash != null {
            const dir_len2_tmp: !usize = ptr_diff(last_slash, &resolved_path[0] as *byte) as! usize;
            const dir_len2: usize = dir_len2_tmp.value;
            if dir_len2 + 1usize < buffer_size {
                memcpy(buffer as *byte, &resolved_path[0] as *const byte, dir_len2);
                buffer[dir_len2] = 47 as byte;
                buffer[dir_len2 + 1usize] = 0 as byte;
                return 0;
            }
        }
    }

    if buffer_size > 2usize {
        buffer[0] = 46 as byte;
        buffer[1] = 47 as byte;
        buffer[2] = 0 as byte;
        return 0;
    }
    return 1;
}

fn launcher_build_cmd_path(command_name: &byte, out: &byte, out_cap: usize) i32 {
    if command_name == null || command_name[0] == 0 as byte || out == null || out_cap == 0usize {
        return 1;
    }
    const argv0: *byte = get_argv(0);
    if argv0 == null {
        return 1;
    }
    var compiler_dir: [byte: PATH_MAX] = [];
    if launcher_get_dir(argv0 as &byte, &compiler_dir[0] as &byte, PATH_MAX) != 0 {
        return 1;
    }
    const written: i32 = snprintf(out as *byte, out_cap, "%scmd/%s" as *byte, &compiler_dir[0] as *byte, command_name as *byte);
    if written <= 0 || written >= out_cap as i32 {
        return 1;
    }
    return 0;
}

fn launcher_dispatch_external_cmd(command_name: &byte) i32 {
    var cmd_path: [byte: PATH_MAX] = [];
    if launcher_build_cmd_path(command_name, &cmd_path[0] as &byte, PATH_MAX) != 0 {
        fprintf(stderr, "错误: 无法构造 cmd/%s 路径\n" as *byte, command_name as *byte);
        return 1;
    }
    if access(&cmd_path[0] as *const byte, X_OK) != 0 {
        fprintf(stderr, "错误: 缺少可执行子命令 %s；请先运行 make cmds\n" as *byte, &cmd_path[0] as *byte);
        return 1;
    }

    const argc: i32 = get_argc();
    var arg_index: i32 = 2;
    var forwarded_argc: i32 = argc - arg_index;
    if forwarded_argc < 0 {
        forwarded_argc = 0;
    }
    const dispatch_argc: i32 = forwarded_argc + 1;
    const argv_bytes: usize = @size_of(&byte) * ((dispatch_argc + 1) as usize);
    const dispatch_argv: &(&byte) = malloc(argv_bytes) as &(&byte);
    if dispatch_argv == null {
        fprintf(stderr, "错误: 无法为 cmd/%s 调度参数分配内存\n" as *byte, command_name as *byte);
        return 1;
    }

    dispatch_argv[0] = &cmd_path[0] as &byte;
    var dst_index: i32 = 1;
    while arg_index < argc {
        const arg: *byte = get_argv(arg_index);
        if arg == null {
            fprintf(stderr, "错误: 无法获取 cmd/%s 调度参数（索引 %d）\n" as *byte, command_name as *byte, arg_index);
            free(dispatch_argv as &void);
            return 1;
        }
        dispatch_argv[dst_index] = arg as &byte;
        dst_index = dst_index + 1;
        arg_index = arg_index + 1;
    }
    dispatch_argv[dst_index] = null;

    var empty_env: [&byte: 1] = [null];
    var envp: &(&byte) = &empty_env[0] as &(&byte);
    if saved_envp != null {
        envp = saved_envp as &(&byte);
    }
    execve(&cmd_path[0] as &const byte, dispatch_argv, envp as & &byte);
    fprintf(stderr, "错误: 无法执行子命令 %s\n" as *byte, &cmd_path[0] as *byte);
    free(dispatch_argv as &void);
    return 127;
}

fn launcher_print_help(program_name: &byte) void {
    var name: &byte = program_name;
    if name == null {
        name = "uya" as *byte;
    }
    fprintf(stderr, "Uya 编译器 launcher\n" as *byte);
    fprintf(stderr, "版本：v0.9.9\n" as *byte);
    fprintf(stderr, "\n用法:\n" as *byte);
    fprintf(stderr, "  %s build <文件> [-o <输出>] [选项]\n" as *byte, name as *byte);
    fprintf(stderr, "  %s check <文件> [选项]\n" as *byte, name as *byte);
    fprintf(stderr, "  %s run <文件> [选项] [-- <参数>...]\n" as *byte, name as *byte);
    fprintf(stderr, "  %s test <文件> [选项]\n" as *byte, name as *byte);
    fprintf(stderr, "  %s fmt <文件> [选项]\n" as *byte, name as *byte);
    fprintf(stderr, "  %s upm <子命令> [参数]\n" as *byte, name as *byte);
    fprintf(stderr, "  %s microapp <build|pack|inspect|verify|run> [参数]\n" as *byte, name as *byte);
    fprintf(stderr, "\n说明: 隐式编译入口已移除；请使用 `uya build ...`。\n" as *byte);
}

fn launcher_print_compat_diagnostic(program_name: &byte) i32 {
    var name: &byte = program_name;
    if name == null {
        name = "uya" as *byte;
    }
    fprintf(stderr, "错误: 隐式编译入口已移除，请使用 `%s build ...`\n" as *byte, name as *byte);
    fprintf(stderr, "提示: 子命令二进制位于 bin/cmd/；若缺失请先运行 make cmds\n" as *byte);
    return 1;
}

fn launcher_print_microapp_image_migration(program_name: &byte, old_command: &byte, new_command: &byte) i32 {
    var name: &byte = program_name;
    if name == null {
        name = "uya" as *byte;
    }
    fprintf(stderr, "错误: 顶层 `%s` 已迁移，请使用 `%s microapp %s ...`\n" as *byte,
        old_command as *byte, name as *byte, new_command as *byte);
    fprintf(stderr, "提示: microapp image/payload 逻辑位于独立子命令 bin/cmd/microapp\n" as *byte);
    return 1;
}

/// 编译器 launcher 入口。
/// 参数说明：无，直接读取进程 argv。
/// 返回值说明：返回整个 `uya` 命令的进程退出码。
export fn main() i32 {
    const argc: i32 = get_argc();
    const program_name: *byte = get_argv(0);
    if argc <= 1 {
        launcher_print_help(program_name as &byte);
        return 1;
    }

    const first_arg: *byte = get_argv(1);
    if first_arg == null {
        return launcher_print_compat_diagnostic(program_name as &byte);
    }
    if strcmp(first_arg, "--help" as *byte) == 0 || strcmp(first_arg, "-h" as *byte) == 0 {
        launcher_print_help(program_name as &byte);
        return 0;
    }
    if strcmp(first_arg, "--version" as *byte) == 0 || strcmp(first_arg, "-v" as *byte) == 0 {
        fprintf(stderr, "Uya 编译器版本 v0.9.9\n" as *byte);
        return 0;
    }
    if strcmp(first_arg, "pack-image" as *byte) == 0 {
        return launcher_print_microapp_image_migration(program_name as &byte, first_arg as &byte, "pack" as &byte);
    }
    if strcmp(first_arg, "inspect-image" as *byte) == 0 {
        return launcher_print_microapp_image_migration(program_name as &byte, first_arg as &byte, "inspect" as &byte);
    }
    if strcmp(first_arg, "verify-image" as *byte) == 0 {
        return launcher_print_microapp_image_migration(program_name as &byte, first_arg as &byte, "verify" as &byte);
    }
    if launcher_is_external_cmd(first_arg as &byte) != 0 {
        return launcher_dispatch_external_cmd(first_arg as &byte);
    }

    return launcher_print_compat_diagnostic(program_name as &byte);
}
