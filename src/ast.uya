// ast.uya - AST 节点创建和操作
// Uya 自举编译器
//
// 注意：ASTNode 用匿名 union 重叠组压缩体积；各 kind 只访问自己的那组字段。

// match 模式种类
enum MatchPatternKind {
    MATCH_PAT_LITERAL,   // 字面量（整数、true、false）
    MATCH_PAT_ENUM,      // 枚举变体（EnumName.Variant）
    MATCH_PAT_UNION,     // 联合体变体（.variant(bind)）
    MATCH_PAT_ERROR,     // 错误类型（error.Name）
    MATCH_PAT_BIND,      // 变量绑定（identifier 捕获值）
    MATCH_PAT_WILDCARD,  // 通配符 _
    MATCH_PAT_ELSE,      // else 分支
}

// 字面量类型后缀枚举
enum LiteralSuffix {
    LITERAL_SUFFIX_NONE,    // 无后缀
    LITERAL_SUFFIX_I8,
    LITERAL_SUFFIX_I16,
    LITERAL_SUFFIX_I32,
    LITERAL_SUFFIX_I64,
    LITERAL_SUFFIX_U8,
    LITERAL_SUFFIX_U16,
    LITERAL_SUFFIX_U32,
    LITERAL_SUFFIX_U64,
    LITERAL_SUFFIX_USIZE,
    LITERAL_SUFFIX_F32,
    LITERAL_SUFFIX_F64,
}

// match 臂结构（Uya 无 union，扁平化为独立字段）
// 字面量臂时用 literal_int_value / literal_is_bool 避免对 literal_expr 指针的 . 访问（C 需 ->）
struct ASTMatchArm {
    kind: MatchPatternKind,
    literal_expr: &ASTNode,
    literal_int_value: i32,   // LITERAL 且为数字时的值
    literal_is_bool: i32,     // LITERAL 且为 bool 时为 1
    enum_name: &byte,
    variant_name: &byte,
    error_name: &byte,
    var_name: &byte,
    result_expr: &ASTNode,
    result_is_block: i32,  // 1 表示 result_expr 为 AST_BLOCK，避免对 result_expr 指针的 .type 访问
}

// 枚举变体结构
struct EnumVariant {
    name: &byte,
    value: &byte,  // 显式值字符串（若指定 = NUM），否则 null
}

// 类型参数结构（用于泛型）
// 例如：<T: Ord + Clone> 中的 T 是一个类型参数，Ord 和 Clone 是约束
struct TypeParam {
    name: &byte,              // 类型参数名称（如 "T"）
    constraints: & & byte,    // 约束接口名称数组（如 ["Ord", "Clone"]，从 Arena 分配）
    constraint_count: i32,    // 约束数量
}

// AST 节点类型枚举（与 C 版本 ast.h 一致）
enum ASTNodeType {
    AST_PROGRAM,
    AST_ENUM_DECL,
    AST_ERROR_DECL,    // 预定义错误声明（error Name;）
    AST_INTERFACE_DECL, // 接口声明（interface I { fn method(self: *Self,...) Ret; ... }）
    AST_STRUCT_DECL,
    AST_UNION_DECL,    // 联合体声明（union Name { variant1: T1, variant2: T2 }）
    AST_METHOD_BLOCK,  // 方法块（StructName { fn method(...) { ... } ... }）
    AST_FN_DECL,
    AST_MACRO_DECL,    // 宏声明（mc ID(param_list) return_tag { statements }）
    AST_TYPE_ALIAS,    // 类型别名（type Name = Type）
    AST_VAR_DECL,
    AST_EXTERN_VAR_DECL,  // extern 变量声明（extern const/var name: type; 或 export const/var name: type = val;）
    AST_DESTRUCTURE_DECL,  // 解构声明（const (x, y) = expr）
    AST_USE_STMT,         // use 语句（use path; 或 use path.item; 或 use path as alias;）
    AST_C_IMPORT_DECL,    // @c_import("path", cflags?, ldflags?);
    AST_IF_STMT,
    AST_WHILE_STMT,
    AST_FOR_STMT,
    AST_BREAK_STMT,
    AST_CONTINUE_STMT,
    AST_RETURN_STMT,
    AST_DEFER_STMT,     // defer 语句（作用域结束 LIFO 执行）
    AST_ERRDEFER_STMT,  // errdefer 语句（仅错误返回时 LIFO 执行）
    AST_TEST_STMT,      // test 语句（test "description" { body }）
    AST_ASSIGN,
    AST_EXPR_STMT,
    AST_BLOCK,
    AST_BINARY_EXPR,
    AST_PIPELINE_EXPR,  // pipeline 表达式：left |> right
    AST_UNARY_EXPR,
    AST_CALL_EXPR,
    AST_MEMBER_ACCESS,
    AST_ARRAY_ACCESS,
    AST_SLICE_EXPR,     // 切片表达式（base[start:len]，结果类型 &[T] 或 &[T: N]）
    AST_STRUCT_INIT,
    AST_ARRAY_LITERAL,
    AST_TUPLE_LITERAL,  // 元组字面量（(expr1, expr2, ...)）
    AST_SIZEOF,
    AST_LEN,
    AST_ALIGNOF,
    AST_CAST_EXPR,
    AST_IDENTIFIER,
    AST_UNDERSCORE,  // 忽略占位 _（仅用于赋值左侧、解构，不能引用）
    AST_NUMBER,
    AST_FLOAT,
    AST_BOOL,
    AST_INT_LIMIT,
    AST_STRING,
    AST_CHAR,           // 字符字面量 'x' 或 '\n'，可赋给 byte
    AST_STRING_INTERP,  // 字符串插值 "text${expr}text" 或 "text${expr:spec}text"，结果为 [i8: N]
    AST_PARAMS,   // @params 内置变量（函数体内参数元组）
    AST_TRY_EXPR,       // try expr（错误传播）
    AST_CATCH_EXPR,     // expr catch [|err|] { stmts }（错误捕获）
    AST_ERROR_VALUE,    // error.Name（错误值，用于 return error.X）
    AST_MATCH_EXPR,     // match expr { pat => expr, ... else => expr }
    AST_MC_EVAL,        // @mc_eval(expr) - 宏内求值表达式
    AST_MC_CODE,        // @mc_code(expr) - 宏内生成代码
    AST_MC_AST,         // @mc_ast(expr) - 宏内获取 AST
    AST_MC_ERROR,       // @mc_error(msg) - 宏内报错
    AST_MC_INTERP,      // ${expr} - 宏内插值
    AST_MC_TYPE,        // @mc_type(expr) - 宏内类型反射
    AST_MC_SOURCE,      // @mc_source(expr) - 宏内将表达式序列化为源码字符串
    AST_AWAIT_EXPR,     // try @await expr - 异步等待表达式
    AST_SRC_NAME,       // @src_name - 源文件名
    AST_SRC_PATH,       // @src_path - 源文件路径
    AST_SRC_LINE,       // @src_line - 源文件行号
    AST_SRC_COL,        // @src_col - 源文件列号
    AST_FUNC_NAME,      // @func_name - 当前函数名
    AST_EMBED,          // @embed("path") - 编译期嵌入单文件
    AST_EMBED_DIR,      // @embed_dir("path") - 编译期嵌入目录
    AST_SYSCALL,        // @syscall(nr, arg1, ..., arg6) - 系统调用
    AST_PTR_FROM_USIZE, // @ptr_from_usize(value) - 从 usize 转换为指针
    AST_USIZE_FROM_PTR, // @usize_from_ptr(ptr) - 从指针转换为 usize
    AST_ERROR_ID,       // @error_id(err) - 提取错误值的数值 ID
    AST_ERROR_NAME,     // @error_name(err) - 提取错误值的名称字符串
    AST_VA_START,       // @va_start(ap, last) - 可变参数函数内初始化 va_list
    AST_VA_END,        // @va_end(ap) - 结束 va_list 访问
    AST_VA_ARG,        // @va_arg(ap, Type) - 从 va_list 按类型获取下一个参数
    AST_VA_COPY,       // @va_copy(dest, src) - 复制 va_list
    AST_ASM,           // @asm { ... } - 内联汇编块
    AST_ASM_TARGET,    // @asm_target() - 平台检测
    AST_PRINT,          // @print(expr) - 打印表达式（不换行）
    AST_PRINTLN,        // @println(expr) - 打印表达式并换行
    AST_TYPE_NAMED,
    AST_TYPE_POINTER,
    AST_TYPE_ARRAY,
    AST_TYPE_SLICE,     // 切片类型（&[T] 或 &[T: N]）
    AST_TYPE_TUPLE,  // 元组类型（(T1, T2, ...)）
    AST_TYPE_ERROR_UNION,  // 错误联合类型 !T
    AST_TYPE_ATOMIC,   // 原子类型（atomic T）
    AST_TYPE_VECTOR,   // SIMD 向量类型（@vector(T, N)）
    AST_TYPE_MASK,     // SIMD 掩码类型（@mask(N)）
    AST_TYPE_FRAME,    // 异步帧类型（@frame(foo)）
}

// 字符串插值段（用于 AST_STRING_INTERP）
struct ASTStringInterpSegment {
    is_text: i32,       // 1=纯文本段，0=插值表达式段
    text: &byte,        // 纯文本段内容（is_text=1 时）
    expr: &ASTNode,     // 插值表达式（is_text=0 时）
    format_spec: &byte, // 格式说明符（如 ".2f"，可选）
    // checker 填入的插值实参形态，供 C99 后端选择与实参类型匹配的 printf 转换符：
    // 0=未判定（沿用旧行为）1=有符号整型 2=无符号整型 3=浮点 4=字节指针 5=切片
    format_kind: i32,
}

// AST 节点结构：所有节点类型共用的字段放在最外层，各类型独有的负载字段放进
// 同一个匿名 union 块里的不同 struct 组（互斥使用、共享存储），字段仍按 `node.field` 访问。
//
// 内存账：改造前 259 个字段全部内联，sizeof(ASTNode)=1856；改成重叠组后 =152（12.2×）。
// 代价是**每个组字段的读写都必须证明节点 kind**，否则踩到邻组同 offset 的字段。
//
// 三条分组不变量（新增/移动字段必须逐条对照，详见 docs/astnode_overlap_design.md §3）：
//   I1 同 kind 同组：只写在同一个 kind 上的字段放同一组；跨 kind 共享的字段放公共区。
//   I2 跨组写禁止：写组 A 的字段时，节点 kind 必须属于组 A —— 尤其是「拿到的节点可能是别的
//      kind」时（HIRStmt.ast_node 这类复用字段、降级合成的节点、整节点拷贝后改 kind），
//      必须先判 `node.type` 再读变体字段。反例：var_decl_moved_field_src 与
//      for_stmt_range_end 同处 offset 56，漏判 kind 会把「循环上界指针」当成「被移动字段」。
//   I3 多 kind 共用 → 公共区：两个以上 kind 都要用的字段，提到 union 块外的公共区，
//      不要为了省字节塞进某一组。
//
// 另：含重叠块的结构体禁止用结构体字面量初始化（`ASTNode{ ... }`），只能逐字段赋值；
// 新建节点统一走 ast_new_node()（整块清零 + 置 kind），不要手写 memset 后漏置 kind。
struct ASTNode {
    type: ASTNodeType,
    line: i32,
    column: i32,
    filename: &byte,

    // 各节点类型独有的负载字段：同一个匿名 union 块里的每个 struct 是一个重叠组，
    // 不同组共享同一段存储（按 kind 互斥使用）；字段仍按 `node.field` 访问。
    union {
        struct {
            // program（指针数组在 C 中为 T**，Uya 中用 & & T 表示）
            program_decls: & & ASTNode,
            program_decl_count: i32,
        }
        struct {
            // enum_decl
            enum_decl_name: &byte,
            enum_decl_variants: &EnumVariant,
            enum_decl_variant_count: i32,
            enum_decl_is_export: i32,  // 1 表示 export enum，0 表示私有
        }
        struct {
            // error_decl（预定义错误声明 error Name;）
            error_decl_name: &byte,
            error_decl_is_export: i32,  // 1 表示 export error，0 表示私有
        }
        struct {
            // interface_decl（interface I { fn method(self: *Self,...) Ret; ... }）
            interface_decl_name: &byte,
            interface_decl_type_params: &TypeParam,   // 类型参数数组（泛型参数，如 <T>，从 Arena 分配）
            interface_decl_type_param_count: i32,     // 类型参数数量
            interface_decl_method_sigs: & & ASTNode,
            interface_decl_method_sig_count: i32,
            interface_decl_composed_interfaces: & & byte,  // 组合的接口名称数组
            interface_decl_composed_count: i32,            // 组合的接口数量
            interface_decl_is_export: i32,  // 1 表示 export interface，0 表示私有
        }
        struct {
            // struct_decl
            struct_decl_name: &byte,
            struct_decl_type_params: &TypeParam,      // 类型参数数组（泛型参数，如 <T: Default>，从 Arena 分配）
            struct_decl_type_param_count: i32,        // 类型参数数量
            struct_decl_interface_names: & & byte,  // 实现的接口名称数组（可为 null）
            struct_decl_interface_count: i32,
            struct_decl_fields: & & ASTNode,
            struct_decl_field_count: i32,
            struct_decl_methods: & & ASTNode,  // 内部方法数组（AST_FN_DECL 节点，可为 null）
            struct_decl_method_count: i32,     // 内部方法数量
            struct_decl_is_export: i32,  // 1 表示 export struct，0 表示私有
            struct_decl_is_opaque: i32,  // 1 表示字段仅声明模块可见且类型不可复制
        }
        struct {
            // union_decl（union Name { variant1: T1, variant2: T2 [ , fn ... ] }）
            union_decl_name: &byte,
            union_decl_variants: & & ASTNode,  // 变体数组（变体是 AST_VAR_DECL 节点）
            union_decl_variant_count: i32,
            union_decl_methods: & & ASTNode,   // 内部方法数组（AST_FN_DECL 节点，可为 null；extern union 无方法）
            union_decl_method_count: i32,
            union_decl_is_extern: i32,  // 1 表示 extern union（C 互操作，仅生成 union，无 tagged 包装）
            union_decl_is_export: i32,  // 1 表示 export union，0 表示私有
            union_decl_type_params: &TypeParam,  // 泛型参数（如 <T>），null 表示非泛型
            union_decl_type_param_count: i32,
        }
        struct {
            // method_block（StructName/UnionName { fn method(...) { ... } ... }）
            method_block_struct_name: &byte,
            method_block_union_name: &byte,    // 联合体名称（为 null 时表示结构体方法块）
            method_block_methods: & & ASTNode,
            method_block_method_count: i32,
        }
        struct {
            // fn_decl
            fn_decl_name: &byte,
            fn_decl_type_params: &TypeParam,          // 类型参数数组（泛型参数，如 <T: Ord>，从 Arena 分配）
            fn_decl_type_param_count: i32,            // 类型参数数量
            fn_decl_params: & & ASTNode,
            fn_decl_param_count: i32,
            fn_decl_return_type: &ASTNode,
            fn_decl_body: &ASTNode,
            fn_decl_is_varargs: i32,
            fn_decl_is_export: i32,  // 1 表示 export fn，0 表示私有
            fn_decl_is_extern: i32,  // 1 表示 extern fn（含 export extern fn main），0 表示普通函数
            fn_decl_is_async: i32,   // 1 表示 @async_fn，0 表示普通函数
            fn_decl_is_naked: i32,   // 1 表示 @naked_fn，0 表示普通函数
            fn_decl_align: i32,       // @align(N) 指定的帧对齐（仅对 async 生效），0 表示未指定
            fn_decl_extern_lib_name: &byte,  // extern "libc" fn 中的库名（如 "libc"），null 表示普通 extern fn
        }
        struct {
            // macro_decl（宏声明）
            macro_decl_name: &byte,
            macro_decl_params: & & ASTNode,
            macro_decl_param_count: i32,
            macro_decl_return_tag: &byte,      // "expr", "stmt", "struct", "type"
            macro_decl_body: &ASTNode,
            macro_decl_is_export: i32,
        }
        struct {
            // type_alias（类型别名）
            type_alias_name: &byte,
            type_alias_target_type: &ASTNode,
            type_alias_is_export: i32,
        }
        struct {
            // mc_* 宏内建函数
            mc_eval_operand: &ASTNode,
        }
        struct {
            mc_code_operand: &ASTNode,
        }
        struct {
            mc_ast_operand: &ASTNode,
        }
        struct {
            mc_error_operand: &ASTNode,
        }
        struct {
            mc_interp_operand: &ASTNode,
        }
        struct {
            mc_type_operand: &ASTNode,
        }
        struct {
            mc_source_operand: &ASTNode,
        }
        struct {
            // var_decl
            var_decl_name: &byte,
            var_decl_type: &ASTNode,
            var_decl_init: &ASTNode,
            var_decl_is_const: i32,
            var_decl_was_moved: i32,   // 移动语义：1 表示该绑定曾被移动，离开作用域时不调用 drop
            var_decl_moved_field_src: &byte,  // 嵌套字段移动：源访问路径（如 "h.buf"），未移动时为 null
            var_decl_is_export: i32,  // 1 表示 export const，0 表示私有（仅顶层 const 声明使用）
            var_decl_is_thread_local: i32,  // 1 表示 @thread_local 全局（C99 发射 _Thread_local）
            // 结构体字段的重叠分组（仅 struct 声明里的字段使用，其他 AST_VAR_DECL 为 0）：
            // 同一个匿名 union 块内的不同 group 互不共存，共享同一段存储。
            var_decl_overlap_block: i32,  // 所属匿名 union 块序号（0 = 普通字段，不参与重叠）
            var_decl_overlap_group: i32,  // 块内 struct 组序号（同块同组字段顺序排布、互不重叠）
        }
        struct {
            // extern_var_decl（顶层：extern const/var name: type; 或 export const/var name: type = val;）
            extern_var_decl_name: &byte,           // 变量名
            extern_var_decl_var_type: &ASTNode,    // 类型节点
            extern_var_decl_init_expr: &ASTNode,   // 初始化表达式（可为 null，extern 声明无初始化）
            extern_var_decl_is_const: i32,         // 1 = const, 0 = var
            extern_var_decl_is_extern: i32,        // 1 = extern 声明，0 = 有初始化
            extern_var_decl_is_export: i32,        // 1 = export，0 = 私有
            extern_var_decl_extern_lib_name: &byte, // extern "libc" 的库名（如 "libc"），null 表示普通 extern
        }
        struct {
            // destructure_decl（const (x, y) = expr）
            destructure_decl_names: & & byte,
            destructure_decl_name_count: i32,
            destructure_decl_is_const: i32,
            destructure_decl_init: &ASTNode,
        }
        struct {
            // use_stmt（use path; 或 use path.item; 或 use path as alias;）
            use_stmt_path_segments: & & byte,  // 模块路径段数组（如 ["std", "io"] 表示 std.io，存储在 Arena）
            use_stmt_path_segment_count: i32,   // 路径段数量
            use_stmt_item_name: &byte,          // 可选：导入的特定项名称（如 use std.io.read_file 中的 "read_file"，为 null 表示导入整个模块）
            use_stmt_alias: &byte,              // 可选：别名（如 use std.io as io 中的 "io"，为 null 表示无别名）
        }
        struct {
            // c_import_decl（@c_import("path", cflags?, ldflags?);）
            c_import_path_literal: &byte,
            c_import_resolved_path: &byte,
            c_import_cflags_literal: &byte,
            c_import_ldflags_literal: &byte,
            c_import_cflags_normalized: &byte,
            c_import_ldflags_normalized: &byte,
            c_import_expanded_paths: & & byte,
            c_import_expanded_rel_paths: & & byte,
            c_import_expanded_count: i32,
        }
        struct {
            // binary_expr
            binary_expr_left: &ASTNode,
            binary_expr_op: i32,
            binary_expr_right: &ASTNode,
        }
        struct {
            // pipeline_expr (left |> right)
            pipeline_expr_left: &ASTNode,
            pipeline_expr_right: &ASTNode,
            // 最外层 pipeline 表达式是否已经完成 move 消费检查。
            // checker 可能对同一 AST 重复推断；该标记避免把重复推断误报为二次消费。
            pipeline_expr_move_checked: i32,
        }
        struct {
            // unary_expr
            unary_expr_op: i32,
            unary_expr_operand: &ASTNode,
        }
        struct {
            // try_expr（try expr）
            try_expr_operand: &ASTNode,
            // 操作数按「checked 整数算术」求值：操作数是整数算术表达式（根为 + - * / %
            // 或一元 -），在 try 上下文中产出 !T，溢出 → error.Overflow，除零 →
            // error.DivisionByZero。由 checker 置位，codegen 据此选择 checked 发射器。
            try_expr_is_checked_arith: i32,
            // checked 算术载荷的 TypeKind（checker 期在符号表有效时解析并记录，
            // codegen 期局部符号已退出作用域，无法再从叶子表达式反推）
            try_expr_checked_kind: i32,
        }
        struct {
            // catch_expr（expr catch [|err|] { stmts }）
            catch_expr_operand: &ASTNode,
            catch_expr_err_name: &byte,
            catch_expr_catch_block: &ASTNode,
            // 同 try_expr_is_checked_arith：catch 的操作数是 checked 整数算术
            catch_expr_is_checked_arith: i32,
            // 同 try_expr_checked_kind
            catch_expr_checked_kind: i32,
        }
        struct {
            // await_expr（try @await expr）- 异步等待
            await_expr_operand: &ASTNode,
        }
        struct {
            // error_value（error.Name）
            error_value_name: &byte,
        }
        struct {
            // match_expr（match expr { pat => expr, ... }）
            match_expr_expr: &ASTNode,
            match_expr_arms: &ASTMatchArm,
            match_expr_arm_count: i32,
        }
        struct {
            // call_expr
            call_expr_callee: &ASTNode,
            call_expr_args: & & ASTNode,
            call_expr_arg_count: i32,
            call_expr_has_ellipsis_forward: i32,  // 1 表示末尾为 ... 转发可变参数
            call_expr_type_args: & & ASTNode,     // 类型参数数组（泛型函数调用，如 max<i32>，从 Arena 分配）
            call_expr_type_arg_count: i32,        // 类型参数数量
            // simd helper（@vector.splat / @vector.load / @vector.store / @vector.select /
            // @vector.reduce_add）关联的向量类型 AST。它**只写在 AST_CALL_EXPR 节点上**
            // （check_expr.uya / check_call.uya 都在读 call_expr_* 的同一处读写它），
            // 所以必须与 call_expr_* 同组：单独成组会和 call_expr_callee 共享 offset 0，
            // 写它等于抹掉被调方指针。
            simd_splat_target_type: &ASTNode,
        }
        struct {
            // member_access
            member_access_object: &ASTNode,
            member_access_field_name: &byte,
            member_access_is_module_access: i32,
            member_access_module_name: &byte,  // 模块名（如 "std.testing"，由 checker 设置）
        }
        struct {
            // array_access
            array_access_array: &ASTNode,
            array_access_index: &ASTNode,
        }
        struct {
            // slice_expr（base[start:len]）
            slice_expr_base: &ASTNode,
            slice_expr_start_expr: &ASTNode,
            slice_expr_len_expr: &ASTNode,
        }
        struct {
            // struct_init
            struct_init_struct_name: &byte,
            struct_init_field_names: & & byte,
            struct_init_field_values: & & ASTNode,
            struct_init_field_count: i32,
            struct_init_type_args: & & ASTNode,   // 类型实参数组（泛型结构体，如 Pair<i32, i64>）
            struct_init_type_arg_count: i32,      // 类型实参数量
        }
        struct {
            // array_literal（[expr1, ...] 或 [value: N]）
            array_literal_elements: & & ASTNode,
            array_literal_element_count: i32,
            array_literal_repeat_count_expr: &ASTNode,
        }
        struct {
            // tuple_literal（(expr1, expr2, ...)）
            tuple_literal_elements: & & ASTNode,
            tuple_literal_element_count: i32,
        }
        struct {
            // sizeof_expr
            sizeof_expr_target: &ASTNode,
            sizeof_expr_is_type: i32,
        }
        struct {
            // len_expr
            len_expr_array: &ASTNode,
        }
        struct {
            // alignof_expr
            alignof_expr_target: &ASTNode,
            alignof_expr_is_type: i32,
        }
        struct {
            // cast_expr（expr as type 或 expr as! type）
            cast_expr_expr: &ASTNode,
            cast_expr_target_type: &ASTNode,
            cast_expr_is_force_cast: i32,  // 1 表示 as!（强转，返回 !T），0 表示 as
        }
        struct {
            // identifier
            identifier_name: &byte,
        }
        struct {
            // number
            number_value: i32,
            number_value_i64: i64,  // 完整 i64 值，供 codegen 生成超出 i32 的常量；解析时与 number_value 同步
            literal_suffix: i32,  // 字面量类型后缀 (0=NONE, 1=I8, 2=I16, 3=I32, 4=I64, 5=U8, 6=U16, 7=U32, 8=U64, 9=USIZE, 10=F32, 11=F64)
        }
        struct {
            // float_literal
            float_literal_value: f64,
            float_literal_suffix: i32,  // 浮点字面量类型后缀
        }
        struct {
            // bool_literal
            bool_literal_value: i32,
        }
        struct {
            // int_limit (max/min)
            int_limit_is_max: i32,
            int_limit_resolved_kind: i32,
        }
        struct {
            // string_literal
            string_literal_value: &byte,
        }
        struct {
            // embed / embed_dir
            embed_path_literal: &byte,
            embed_resolved_path: &byte,
            embed_data: &byte,
            embed_size: i32,
            embed_dir_paths: & & byte,
            embed_dir_resolved_paths: & & byte,
            embed_dir_data: & & byte,
            embed_dir_sizes: &i32,
            embed_dir_entry_count: i32,
        }
        struct {
            // char_literal（字符字面量，赋给 byte）
            char_literal_value: i32,
        }
        struct {
            // string_interp（"text${expr}text" 或 "text${expr:spec}text"）
            string_interp_segments: &ASTStringInterpSegment,
            string_interp_segment_count: i32,
            string_interp_computed_size: i32,  // 由 checker 填充
        }
        struct {
            // if_stmt
            if_stmt_condition: &ASTNode,
            if_stmt_then_branch: &ASTNode,
            if_stmt_else_branch: &ASTNode,
        }
        struct {
            // while_stmt
            while_stmt_condition: &ASTNode,
            while_stmt_body: &ASTNode,
        }
        struct {
            // for_stmt
            for_stmt_array: &ASTNode,
            for_stmt_var_name: &byte,
            for_stmt_is_ref: i32,
            for_stmt_is_range: i32,
            for_stmt_range_start: &ASTNode,
            for_stmt_range_end: &ASTNode,
            for_stmt_body: &ASTNode,
        }
        struct {
            // return_stmt
            return_stmt_expr: &ASTNode,
        }
        struct {
            // defer_stmt（defer stmt 或 defer { ... }）
            defer_stmt_body: &ASTNode,
        }
        struct {
            // errdefer_stmt（errdefer stmt 或 errdefer { ... }）
            errdefer_stmt_body: &ASTNode,
        }
        struct {
            // test_stmt（test "description" { body }）
            test_stmt_description: &byte,  // 测试说明（字符串存储在 Arena 中）
            test_stmt_body: &ASTNode,      // 测试体（AST_BLOCK）
        }
        struct {
            // assign
            assign_dest: &ASTNode,
            assign_src: &ASTNode,
        }
        struct {
            // block
            block_stmts: & & ASTNode,
            block_stmt_count: i32,
        }
        struct {
            // type_named（命名类型：i32, bool, void, struct Name, 或泛型类型 Vec<i32>）
            type_named_name: &byte,
            type_named_type_args: & & ASTNode,    // 类型参数数组（泛型类型参数，如 Vec<i32> 中的 [i32]，从 Arena 分配）
            type_named_type_arg_count: i32,       // 类型参数数量（0 表示非泛型类型）
        }
        struct {
            // type_pointer
            type_pointer_pointed_type: &ASTNode,
            type_pointer_is_ffi_pointer: i32,
            type_pointer_is_const: i32,  // 是否为只读指针（1 表示 &const T 或 *const T，0 表示 &T 或 *T）
        }
        struct {
            // type_array
            type_array_element_type: &ASTNode,
            type_array_size_expr: &ASTNode,
        }
        struct {
            // type_slice（&[T] 或 &[T: N]）；type_slice_element_const=1 表示 &[const T]
            type_slice_element_type: &ASTNode,
            type_slice_size_expr: &ASTNode,
            type_slice_element_const: i32,
        }
        struct {
            // type_tuple（(T1, T2, ...)）
            type_tuple_element_types: & & ASTNode,
            type_tuple_element_count: i32,
        }
        struct {
            // type_error_union（!T）
            type_error_union_payload_type: &ASTNode,
        }
        struct {
            // syscall（@syscall(nr, arg1, ..., arg6)）
            syscall_number: &ASTNode,    // 系统调用号（必须）
            syscall_args: & & ASTNode,   // 参数数组（0-6 个）
            syscall_arg_count: i32,      // 参数个数
        }
        struct {
            // ptr_from_usize_expr
            ptr_from_usize_value: &ASTNode,  // usize 值表达式
        }
        struct {
            // usize_from_ptr_expr
            usize_from_ptr_ptr: &ASTNode,    // 指针表达式
        }
        struct {
            // error_id_expr
            error_id_operand: &ASTNode,      // 错误表达式
        }
        struct {
            // error_name_expr
            error_name_operand: &ASTNode,    // 错误表达式
        }
        struct {
            // va_start_expr
            va_start_ap: &ASTNode,
            va_start_last_param: &ASTNode,
        }
        struct {
            // va_end_expr
            va_end_ap: &ASTNode,
        }
        struct {
            // va_arg_expr
            va_arg_ap: &ASTNode,
            va_arg_arg_type: &ASTNode,
        }
        struct {
            // va_copy_expr
            va_copy_dest: &ASTNode,
            va_copy_src: &ASTNode,
        }
        struct {
            // asm（@asm { ... } 内联汇编块）
            asm_instructions: & & byte,     // 指令字符串数组
            asm_instruction_count: i32,     // 指令数量
            asm_inputs: & & ASTNode,        // 输入表达式数组（每条指令的输入连续存储）
            asm_input_counts: & i32,        // 每条指令的输入数量
            asm_outputs: & & ASTNode,       // 输出表达式数组（每条指令的输出连续存储）
            asm_output_counts: & i32,       // 每条指令的输出数量
            asm_clobbers: & & byte,         // clobber 寄存器名称数组
            asm_clobber_count: i32,         // clobber 个数
            asm_clobbers_memory: i32,       // 是否修改内存（1=是）
        }
        struct {
            // print/println（@print/@println）
            print_expr: &ASTNode,    // 要打印的表达式
        }
        struct {
            // type_atomic（atomic T）
            type_atomic_inner_type: &ASTNode,
        }
        struct {
            // type_vector（@vector(T, N)）
            type_vector_element_type: &ASTNode,
            type_vector_size_expr: &ASTNode,
        }
        struct {
            // type_mask（@mask(N)）
            type_mask_size_expr: &ASTNode,
        }
        struct {
            // type_frame（@frame(foo)）
            type_frame_operand: &ASTNode,
        }
    }

    // 优化器通用标记：跨节点类型使用，不能放进重叠组。
    is_optimized: i32,          // 是否已被优化（1=是，0=否）
    optimized_value: i32,       // 优化后的值（常量折叠）
    is_dead_code: i32,          // 是否为死代码（1=是，需要跳过）
    is_proved_safe: i32,        // 是否已证明安全（1=是，可跳过运行时检查）
    is_inlined: i32,            // 是否被内联（1=是）
    inlined_body: &ASTNode,     // 内联后的函数体
    is_unrolled: i32,           // 是否被展开（1=是）
    unroll_count: i32,          // 循环展开次数
}

/// 创建并零初始化一个新的 AST 节点。
///
/// `ASTNode` 的变体字段放在匿名 union 重叠组里，不同组共享同一段存储：逐字段赋值
/// 只会保留「最后写入那组」的字节，其余组读到的仍是 `malloc` 残留。所以这里按
/// 机器字把整块内存清零（等价于旧扁结构的全字段零初始化），再写回非零缺省值。
///
/// 参数：`type` 节点种类；`line`/`column` 源码位置；`arena` 分配用 arena；
/// `filename` 源文件名（可为 null）。
/// 返回值：新节点；`arena` 为 null 或分配失败时返回 null。
export fn ast_new_node(type: ASTNodeType, line: i32, column: i32, arena: &CompilerArena, filename: &byte) &ASTNode {
    if arena == null {
        return null;
    }
    const node: &ASTNode = compiler_arena_alloc(arena, @size_of(ASTNode)) as &ASTNode;
    if node == null {
        return null;
    }
    // arena 按 8 字节对齐（ARENA_ALIGNMENT），可以按机器字清零。
    const words: &usize = node as &usize;
    const word_bytes: usize = @size_of(usize);
    const word_count: usize = (@size_of(ASTNode) as usize) / word_bytes;
    var wi: usize = 0 as usize;
    while wi < word_count {
        words[wi] = 0 as usize;
        wi = wi + 1 as usize;
    }
    const raw: &byte = node as &byte;
    var bi: usize = word_count * word_bytes;
    while bi < (@size_of(ASTNode) as usize) {
        raw[bi] = 0 as byte;
        bi = bi + 1 as usize;
    }
    node.type = type;
    node.line = line;
    node.column = column;
    node.filename = filename;
    // 其余字段一律保持 0：重叠组共享存储，这里写任何非零缺省值都会踩坏别的组
    // （例如往 `try_expr_checked_kind` 写 -1，落点正好是别的组第 2 个指针字段的
    // 高 4 字节，于是那个指针变成 0xffffffff00000000）。
    // 「未设置」哨兵因此改成按需设置：`try_expr_checked_kind` /
    // `catch_expr_checked_kind` 的读取方全部先判 `is_checked_arith != 0`，
    // 由 checker 在判定为 checked 算术时写入真实 TypeKind。
    return node;
}

// 合并多个 ASTNodeType.AST_PROGRAM 节点为一个程序节点
// 参数：programs - 程序节点数组（元素类型为 &ASTNode，长度 = count）；count - 数量；arena - Arena
// 调用方按**实际文件数**分配 programs（原先这里写死 `[&ASTNode: MAX_MERGE_PROGRAMS]` = 512，
// 文件多于 512 个就会越界），所以不再需要固定上限常量。
fn ast_merge_programs(programs: &(&ASTNode), count: i32, arena: &CompilerArena) &ASTNode {
    if count <= 0 || arena == null {
        return null;
    }
    var i: i32 = 0;
    while i < count {
        const p: &ASTNode = programs[i];
        if p == null || p.type != ASTNodeType.AST_PROGRAM {
            return null;
        }
        i = i + 1;
    }
    var total_decl_count: i32 = 0;
    i = 0;
    while i < count {
        total_decl_count = total_decl_count +| programs[i].program_decl_count;
        i = i + 1;
    }
    const first: &ASTNode = programs[0];
    const merged: &ASTNode = ast_new_node(ASTNodeType.AST_PROGRAM, first.line, first.column, arena, first.filename);
    if merged == null {
        return null;
    }
    if total_decl_count <= 0 {
        merged.program_decls = null;
        merged.program_decl_count = 0;
        return merged;
    }
    const decls: & & ASTNode = compiler_arena_alloc(arena, @size_of(&ASTNode) * total_decl_count as usize) as & & ASTNode;
    if decls == null {
        return null;
    }
    var decl_index: i32 = 0;
    i = 0;
    while i < count {
        const program: &ASTNode = programs[i];
        var j: i32 = 0;
        while j < program.program_decl_count {
            decls[decl_index] = program.program_decls[j];
            decl_index = decl_index + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    merged.program_decls = decls;
    merged.program_decl_count = total_decl_count;
    return merged;
}

// std.cfg 等会把块展开为「仅含若干声明」的嵌套 AST_PROGRAM；checker 会递归检查，
// 但 C99 codegen 只遍历顶层 program_decls，导致块内 fn 不生成 C、链接报未定义。
// 合并后展平一层或多层嵌套：将子 AST_PROGRAM 内的声明提升到当前程序列表（递归）。

fn ast_program_has_nested_program_child(program: &ASTNode) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM {
        return 0;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const d: &ASTNode = program.program_decls[i];
        if d != null && d.type == ASTNodeType.AST_PROGRAM {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn ast_nested_program_leaf_decl_count(program: &ASTNode) i32 {
    if program == null || program.type != ASTNodeType.AST_PROGRAM {
        return 0;
    }
    var n: i32 = 0;
    var i: i32 = 0;
    while i < program.program_decl_count {
        const d: &ASTNode = program.program_decls[i];
        if d != null && d.type == ASTNodeType.AST_PROGRAM {
            n = n +| ast_nested_program_leaf_decl_count(d);
        } else if d != null {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn ast_nested_program_collect_decls(program: &ASTNode, out: & & ASTNode, write_pos: i32) i32 {
    var pos: i32 = write_pos;
    if program == null || program.type != ASTNodeType.AST_PROGRAM {
        return pos;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        const d: &ASTNode = program.program_decls[i];
        if d != null && d.type == ASTNodeType.AST_PROGRAM {
            pos = ast_nested_program_collect_decls(d, out, pos);
        } else if d != null {
            out[pos] = d;
            pos = pos +| 1;
        }
        i = i + 1;
    }
    return pos;
}

// 返回展平后的程序根节点（无嵌套子程序时返回原指针）
fn ast_flatten_nested_program_decls(program: &ASTNode, arena: &CompilerArena) &ASTNode {
    if program == null || program.type != ASTNodeType.AST_PROGRAM || arena == null {
        return program;
    }
    if ast_program_has_nested_program_child(program) == 0 {
        return program;
    }
    const flat_count: i32 = ast_nested_program_leaf_decl_count(program);
    if flat_count < 0 {
        return program;
    }
    const decls: & & ASTNode = compiler_arena_alloc(arena, @size_of(&ASTNode) * flat_count as usize) as & & ASTNode;
    if decls == null {
        return program;
    }
    const end_pos: i32 = ast_nested_program_collect_decls(program, decls, 0);
    // 计数与收集不一致时绝不采用展平结果。曾出现展平后 arena/AST 损坏，导致 libc 中部分静态辅助函数
    // （如 _strftime_write）未生成定义却仍有调用。待查明 leaf_count 与 collect 分歧根因前，保守跳过展平。
    if end_pos != flat_count {
        return program;
    }
    const out: &ASTNode = ast_new_node(ASTNodeType.AST_PROGRAM, program.line, program.column, arena, program.filename);
    if out == null {
        return program;
    }
    out.program_decls = decls;
    out.program_decl_count = end_pos;
    return out;
}
