// checker/lifetime.uya - 跨函数内存安全证明：Origin 格与生命周期比较
// 施工图见 docs/interprocedural_proof_plan.md §4（P1 地基）。
//
// 本模块只做两件事：
//   1. 定义值「来源」（origin）这个有限格，以及它的 join / 偏序；
//   2. 定义生命周期比较 outlives(o1, o2)。
// 传播（transfer）在 P0/P1 只覆盖「结论可复用」的少数形态，见 lifetime_origin_of_expr。

// ===== Origin 格（§4.1）=====
//
// UNKNOWN ⊑ LOCAL(s) ⊑ PARAM(i) ⊑ HEAP ≡ STATIC
// （⊑ 读作「更不确定」；HEAP 与 STATIC 同层：都不随栈帧结束而失效）
// 函数摘要求值的递归深度上限（见 lifetime_summary_ret_origin 的说明）。
// 取 8：正常的「返回形参转发」链条（`wrap(mk(x))` 之类）不超过两三层，
// 8 层足以覆盖真实代码，环状调用链则在此处果断截断为 UNKNOWN。
const LIFETIME_SUMMARY_MAX_DEPTH: i32 = 8;
// 当前摘要求值深度（单线程检查器，跨文件全局即可；见 lifetime_summary_ret_origin）。
var g_lifetime_summary_depth: i32 = 0;
const ORIGIN_UNKNOWN: i32 = 0;
const ORIGIN_LOCAL: i32 = 1;
const ORIGIN_PARAM: i32 = 2;
const ORIGIN_HEAP: i32 = 3;
const ORIGIN_STATIC: i32 = 4;

// 作用域 id 的初值：0 表示「还没有任何作用域」，真实作用域从 1 开始递增。
const LIFETIME_SCOPE_ID_BASE: i32 = 1;

// 一个 origin 值。
//
// 刻意**不做字段敏感**（§4.1 末尾的取舍）：`&arr[i]`、`&s.f`、`s[0:4]`、`p.f` 都只是
// 派生，origin 只记「是否派生自同一底层存储」，不记偏移。代价是漏报「字段 x 被 free
// 后字段 y 仍用」这类罕见场景，收益是状态数不随字段路径乘积爆炸。
struct Origin {
    kind: i32,      // ORIGIN_* 之一
    scope_id: i32,  // 仅 ORIGIN_LOCAL 有意义：产生该局部存储的作用域 id
    param_index: i32, // 仅 ORIGIN_PARAM 有意义：第几个形参（0 起）
}

/// 构造「不可判定」的 origin。
/// 参数：无。
/// 返回：kind = ORIGIN_UNKNOWN 的 Origin。
fn origin_unknown() Origin {
    var o: Origin = Origin {
        kind: ORIGIN_UNKNOWN,
        scope_id: 0,
        param_index: 0,
    };
    return o;
}

/// 构造「局部栈存储」的 origin。
/// 参数：scope_id - 产生该存储的作用域 id。
/// 返回：kind = ORIGIN_LOCAL 的 Origin。
fn origin_local(scope_id: i32) Origin {
    var o: Origin = Origin {
        kind: ORIGIN_LOCAL,
        scope_id: scope_id,
        param_index: 0,
    };
    return o;
}

/// 构造「形参所指存储」的 origin。
/// 参数：param_index - 形参下标（0 起）。
/// 返回：kind = ORIGIN_PARAM 的 Origin。
fn origin_param(param_index: i32) Origin {
    var o: Origin = Origin {
        kind: ORIGIN_PARAM,
        scope_id: 0,
        param_index: param_index,
    };
    return o;
}

/// 构造「堆 / 静态」起源，二者同层（寿命都是 ∞）。
/// 参数：即 lifetime 永不结束的 origin。
/// 返回：kind = ORIGIN_HEAP 的 Origin。
fn origin_heap() Origin {
    var o: Origin = Origin {
        kind: ORIGIN_HEAP,
        scope_id: 0,
        param_index: 0,
    };
    return o;
}

/// 构造「静态存储」的 origin（顶层 var/const、字符串字面量、static 缓冲）。
/// 参数：无。
/// 返回：kind = ORIGIN_STATIC 的 Origin。
fn origin_static() Origin {
    var o: Origin = Origin {
        kind: ORIGIN_STATIC,
        scope_id: 0,
        param_index: 0,
    };
    return o;
}

/// 判断 origin 是否「寿命永不到期」（STATIC 或 HEAP）。
/// 参数：o - 待判定的 origin。
/// 返回：1 表示寿命 ∞，0 表示否则。
fn origin_is_unbounded(o: Origin) i32 {
    if o.kind == ORIGIN_STATIC || o.kind == ORIGIN_HEAP {
        return 1;
    }
    return 0;
}

/// 判断两个 origin 是否相等（含 scope_id / param_index）。
/// 参数：a - 左值；b - 右值。
/// 返回：1 表示相等，0 表示不等。
fn origin_equals(a: Origin, b: Origin) i32 {
    if a.kind != b.kind {
        return 0;
    }
    if a.kind == ORIGIN_LOCAL && a.scope_id != b.scope_id {
        return 0;
    }
    if a.kind == ORIGIN_PARAM && a.param_index != b.param_index {
        return 0;
    }
    return 1;
}

/// 计算两个 origin 的最小上界（join），按指针取值、**不消费**实参。
/// 参数：a - 左值指针；b - 右值指针。
/// 返回：二者 join 后的 origin（指针为 null 时返回 UNKNOWN）。
///
/// 存在的理由：`Origin` 是按值移动的类型，`origin_join(a, b)` 会把 a、b 两个局部
/// 变量消费掉；调用点若还想再用其中任何一个（典型场景：acc 与本次 return 的 origin
/// 都要参与后续 join），走指针入口可以避开移动检查，语义完全等价。
fn origin_join_ptr(a: &Origin, b: &Origin) Origin {
    if a == null || b == null {
        return origin_unknown();
    }
    var va: Origin = a[0];
    var vb: Origin = b[0];
    return origin_join(va, vb);
}

/// 计算两个 origin 的最小上界（join）。
/// 参数：a - 左值；b - 右值。
/// 返回：二者 join 后的 origin。
fn origin_join(a: Origin, b: Origin) Origin {
    if origin_equals(a, b) != 0 {
        return a;
    }
    // 任何含 UNKNOWN → UNKNOWN
    if a.kind == ORIGIN_UNKNOWN || b.kind == ORIGIN_UNKNOWN {
        return origin_unknown();
    }
    // HEAP 与 STATIC 同层：取更宽的 HEAP
    if origin_is_unbounded(a) != 0 && origin_is_unbounded(b) != 0 {
        return origin_heap();
    }
    // {LOCAL(a), LOCAL(b)} → LOCAL(min)：取更外层（更保守）
    if a.kind == ORIGIN_LOCAL && b.kind == ORIGIN_LOCAL {
        if a.scope_id <= b.scope_id {
            return a;
        }
        return b;
    }
    // 不同类（LOCAL vs PARAM/∞、PARAM(i) vs PARAM(j)、LOCAL vs ∞ 等）→ UNKNOWN
    return origin_unknown();
}

/// 把 origin 中的 PARAM(i) 按调用点实参 origin 实例化。
/// 参数：ret - 被调方返回的 origin；actuals - 实参 origin 数组；actual_count - 实参个数。
/// 返回：实例化后的 origin（PARAM 下标越界则降级 UNKNOWN）。
fn origin_instantiate(ret: Origin, actuals: &Origin, actual_count: i32) Origin {
    if ret.kind != ORIGIN_PARAM {
        return ret;
    }
    if actuals == null || ret.param_index < 0 || ret.param_index >= actual_count {
        return origin_unknown();
    }
    return actuals[ret.param_index];
}

// ===== 生命周期比较（§4.3）=====

/// 判断 o1 的寿命是否覆盖 o2（o1 活得不比 o2 短）。
/// 参数：o1 - 目标存储的 origin；o2 - 被写入值的 origin。
/// 返回：1 表示 outlives；0 表示不成立或不可判定（保守返回 0，调用方按「证不出」处理）。
///
/// 规则：
///   ∞（STATIC/HEAP）总是覆盖任何存储；
///   LOCAL(a) 覆盖 LOCAL(b) 当且仅当 a <= b（a 更外层，活得至少一样久）；
///   PARAM 的寿命由调用点决定，这里一律返回 0（交给调用点判定），
///   UNKNOWN 同样返回 0（永不产生假保证）。
fn origin_outlives(o1: Origin, o2: Origin) i32 {
    if origin_is_unbounded(o1) != 0 {
        return 1;
    }
    if o1.kind == ORIGIN_LOCAL && o2.kind == ORIGIN_LOCAL {
        if o1.scope_id <= o2.scope_id {
            return 1;
        }
        return 0;
    }
    return 0;
}

/// 判断一个 origin 能否安全地写入寿命 ∞ 的容器（全局 / 堆对象字段）。
/// 参数：o - 待写入值的 origin。
/// 返回：1 表示可写（STATIC / HEAP / UNKNOWN），0 表示不可写。
///
/// 注意 UNKNOWN 也放行：不可判定时不报错，避免把「证不出」当成「证伪」。
fn origin_can_write_long_lived(o: Origin) i32 {
    if o.kind == ORIGIN_STATIC || o.kind == ORIGIN_HEAP || o.kind == ORIGIN_UNKNOWN {
        return 1;
    }
    return 0;
}

// ===== P0 度量报告（--lifetime-report）=====
//
// 施工图 §6.2 只认两个数字：跨函数消解率 = (④ + ⑤) / 全部 requirement、
// 误报率 = Pass C 报错数 / 全部 requirement。这里先把**分母和分子都数清**，
// 不打印逐站点明细（逐站点明细随 B1/B3 接线后再加，见 §11 的 P0 出口判据）。

/// 累加一条「非空」义务（形参指针解引用前提）。
/// 参数：checker - 类型检查器；resolved - 1 表示已消解（&x / 本地守卫 / 上游），0 表示未消解。
/// 返回：无。
fn lifetime_report_param_null(checker: &TypeChecker, resolved: i32) void {
    if checker == null || checker.lifetime_report == 0 {
        return;
    }
    checker.lifetime_req_total = checker.lifetime_req_total +| 1;
    checker.lifetime_req_param_null = checker.lifetime_req_param_null +| 1;
    lifetime_report_bucket(checker, resolved);
}

/// 累加一条「非零」义务（除数前提）。
/// 参数：checker - 类型检查器；resolved - 1 表示已消解，0 表示未消解。
/// 返回：无。
fn lifetime_report_div_zero(checker: &TypeChecker, resolved: i32) void {
    if checker == null || checker.lifetime_report == 0 {
        return;
    }
    checker.lifetime_req_total = checker.lifetime_req_total +| 1;
    checker.lifetime_req_div_zero = checker.lifetime_req_div_zero +| 1;
    lifetime_report_bucket(checker, resolved);
}

/// 累加一条「返回指向局部存储」站点（B1 受检面）。
/// 参数：checker - 类型检查器。
/// 返回：无。
fn lifetime_report_return_local(checker: &TypeChecker) void {
    if checker == null || checker.lifetime_report == 0 {
        return;
    }
    checker.lifetime_returns_local = checker.lifetime_returns_local +| 1;
}

/// 内部：按消解状态累加分子/分母。
/// 参数：checker - 类型检查器；resolved - 1 已消解，0 未消解。
/// 返回：无。
fn lifetime_report_bucket(checker: &TypeChecker, resolved: i32) void {
    if resolved != 0 {
        checker.lifetime_req_resolved = checker.lifetime_req_resolved +| 1;
    } else {
        checker.lifetime_req_unresolved = checker.lifetime_req_unresolved +| 1;
    }
}

/// 打印度量报告汇总（只在 --lifetime-report 时输出，绝不产生编译错误）。
/// 参数：checker - 类型检查器。
/// 返回：无。
///
/// 输出格式刻意保持**稳定且有序**（固定字段顺序、无时间戳、无路径绝对化），
/// 这样两次运行的输出可以直接 diff，满足 P0 的「两次运行报告 diff = 0」出口判据。
fn lifetime_report_flush(checker: &TypeChecker) void {
    if checker == null || checker.lifetime_report == 0 {
        return;
    }
    fprintf(libc.stderr, "[lifetime] functions=%d\n" as *byte, checker.lifetime_fn_count);
    fprintf(libc.stderr, "[lifetime] req_total=%d req_resolved=%d req_unresolved=%d\n" as *byte,
        checker.lifetime_req_total, checker.lifetime_req_resolved, checker.lifetime_req_unresolved);
    fprintf(libc.stderr, "[lifetime] req_param_null=%d\n" as *byte, checker.lifetime_req_param_null);
    fprintf(libc.stderr, "[lifetime] req_div_zero=%d\n" as *byte, checker.lifetime_req_div_zero);
    fprintf(libc.stderr, "[lifetime] returns_local=%d\n" as *byte, checker.lifetime_returns_local);
    fprintf(libc.stderr, "[lifetime] summary_unknown=%d\n" as *byte, checker.lifetime_summary_fail);
    // escapes 段：编译器眼里所有能绕过证明的构造。字段顺序固定、可 diff，
    // 是 docs/unsafe_audit_plan.md 里「白名单冻结」的输入。
    fprintf(libc.stderr, "[escapes] extern_fn=%d extern_var=%d\n" as *byte,
        checker.lifetime_escape_extern_fn, checker.lifetime_escape_extern_var);
    fprintf(libc.stderr, "[escapes] asm=%d\n" as *byte, checker.lifetime_escape_asm);
    fprintf(libc.stderr, "[escapes] union=%d extern_union=%d\n" as *byte,
        checker.lifetime_escape_union, checker.lifetime_escape_extern_union);
    fprintf(libc.stderr, "[escapes] ptr_int=%d\n" as *byte, checker.lifetime_escape_ptr_int);
    fprintf(libc.stderr, "[escapes] alloc=%d\n" as *byte, checker.lifetime_escape_alloc);
}

// ===== transfer 表（§4.2）：表达式 → origin =====
//
// 只覆盖施工图 §4.2 表里「结论可复用」的形态。刻意**不做**的部分（一律返回
// origin_unknown()）：cast 往返、union 变体字段、@asm 输出、指针算术 —— 理由见
// 施工图 §5.1~§5.3，那里说明了为什么任何推断都会产生假保证。

/// 对一个表达式求 origin（来源）。
/// 参数：checker - 类型检查器；expr - 待求 origin 的表达式。
/// 返回：该表达式的 origin；非指针/不可判定形态返回 origin_unknown()。
fn lifetime_origin_of_expr(checker: &TypeChecker, expr: &ASTNode) Origin {
    if checker == null || expr == null {
        return origin_unknown();
    }
    // `&x` / `&arr[i]` / `&s.f`：取操作数的 origin（派生不改变存储归属，§4.1）
    if expr.type == ASTNodeType.AST_UNARY_EXPR &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND {
        return lifetime_origin_of_place(checker, expr.unary_expr_operand);
    }
    // 切片 `base[start:len]` 是视图，不拥有存储
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        return lifetime_origin_of_place(checker, expr.slice_expr_base);
    }
    // 标识符：局部 / 形参 / 顶层，见 lifetime_origin_of_place
    //
    // 这里必须先分清两种「标识符求值」：
    //   `&x`（取地址）→ 问的是 x **自身的存储** → LOCAL
    //   `x`  （读值）  → 问的是 x 里那个值**指向哪** → 由 lifetime_origin_of_value 决定
    // 二者混用正是第一版误报的根源：`const r: &byte = b; return r;` 里 r 是
    // 局部指针变量，但它存的值来自形参 b，返回它是合法的，不该按 LOC(A) 报错。
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        return lifetime_origin_of_value(checker, expr);
    }
    // 成员访问 `p.f` / `s.f`：**读字段**得到的是字段里那个值。
    //
    // 不能一律按容器归属处理：`arena.current_chunk = arena.first_chunk;` 的右值是
    // 「读 first_chunk 字段」，得到的是它存的指针值，指向的存储与 arena 这个形参
    // 同寿命；按 LOCAL(arena 的 scope) 判定会立刻误报（实测 arena/heap/main 共 34 处）。
    // 只有 `&s.f`（取地址）才该按容器归属，那条路径走 lifetime_origin_of_place。
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        return lifetime_origin_of_value(checker, expr);
    }
    // 下标 `s[i]`：读元素同样是读值
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        return lifetime_origin_of_value(checker, expr);
    }
    // 字符串字面量：静态存储
    if expr.type == ASTNodeType.AST_STRING {
        return origin_static();
    }
    // 函数调用：实例化被调方摘要的 ret_origin（见 lifetime_origin_of_call）
    if expr.type == ASTNodeType.AST_CALL_EXPR {
        return lifetime_origin_of_call(checker, expr);
    }
    // 其余形态（cast / 算术 / @asm / union / 指针算术）：不可判定
    return origin_unknown();
}

/// 对一个「存储位置」求 origin（标识符、字段链、下标链）。
/// 参数：checker - 类型检查器；expr - 位置表达式。
/// 返回：该位置所涉及的底层存储 origin。
///
/// 这是 origin 格「不做字段敏感」的落点：`&s.f.g` 与 `&s.g` 都是 origin(s)。
fn lifetime_origin_of_place(checker: &TypeChecker, expr: &ASTNode) Origin {
    if checker == null || expr == null {
        return origin_unknown();
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        const name: &byte = expr.identifier_name;
        if name == null {
            return origin_unknown();
        }
        const sym: &Symbol = symbol_table_lookup(checker, name);
        if sym == null {
            // 查不到符号：可能是顶层全局（顶层 var 走 STATIC）或未知名字。
            // 保守给 STATIC —— 与 §2 的观察一致（`return &g_allocator` 合法）。
            return origin_static();
        }
        // 形参：PARAM(i)。存不下时（P1 暂不记录 param_index）降级为「形参整体」。
        // 用 param_index = -1 表示「是形参但下标未知」，join 时会变 UNKNOWN；
        // 这里刻意保留 PARAM(-1) 而不是 UNKNOWN，因为「是形参」本身已经足够
        // 让 return 判定放行（§4.4 规则 1）。
        if lifetime_symbol_is_param(checker, sym) != 0 {
            return origin_param(-1);
        }
        // 顶层符号（全局 var / const、static 缓冲）→ STATIC
        if sym.scope_level <= 0 {
            return origin_static();
        }
        // **关键区分**：这里问的是「这个位置所指的存储在哪儿」。
        //
        // 对 `&x`（取地址）而言，答案是「x 自身的存储」→ LOCAL。
        // 但对**指针类型的符号**而言，`x` 求值出来是它**持有的指针值**，
        // 该指针指向的存储完全可能在别处（`const r: &byte = &arena.buf[i]`，
        // 之后 `return r` 返回的是堆/arena 上的地址，不是 r 自己的栈槽）。
        // 因此指针类型符号一律返回 UNKNOWN —— 证不出 ≠ 证伪，不能报错。
        //
        // 这条区分是 P1 第一版最大的误报来源：不区分会把 `src/`、`lib/` 里
        // 成百上千个「局部指针变量转存后返回」判成悬垂（实测 arena/ast/lexer/
        // heap/parallel 全部打穿），正是施工图 §6.3 的熔断形态。
        var sym_type: Type = sym.type;
        if sym_type.kind == TypeKind.TYPE_POINTER || sym_type.kind == TypeKind.TYPE_SLICE {
            return origin_unknown();
        }
        return origin_local(sym.scope_id);
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        return lifetime_origin_of_place(checker, expr.member_access_object);
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        return lifetime_origin_of_place(checker, expr.array_access_array);
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR &&
        (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND {
        return lifetime_origin_of_expr(checker, expr);
    }
    // 指针解引用 `*p`：派生自 p 所指向的存储，归属仍看 p
    return origin_unknown();
}

/// 对函数调用求 origin：解析被调方，把 ret_origin 里的 PARAM(i) 按实参 origin 代入。
/// 参数：checker - 类型检查器；expr - 调用表达式。
/// 返回：调用结果的 origin；不可解析时 origin_unknown()。
fn lifetime_origin_of_call(checker: &TypeChecker, expr: &ASTNode) Origin {
    if checker == null || expr == null || expr.call_expr_callee == null {
        return origin_unknown();
    }
    const fn_decl: &ASTNode = resolve_reachable_callee_fn_decl(checker, expr.call_expr_callee);
    if fn_decl == null || fn_decl.fn_decl_body == null {
        // extern / 不可达 / 无体：信任边界，返回值按 UNKNOWN（§5.5）
        return origin_unknown();
    }
    const ret: Origin = lifetime_summary_ret_origin(checker, fn_decl);
    if ret.kind == ORIGIN_UNKNOWN || ret.kind != ORIGIN_PARAM {
        return ret;
    }
    // 实例化 PARAM(i)：用第 i 个实参的 origin
    const pi: i32 = ret.param_index;
    if pi < 0 || expr.call_expr_args == null || pi >= expr.call_expr_arg_count {
        return origin_unknown();
    }
    return lifetime_origin_of_expr(checker, expr.call_expr_args[pi]);
}

// ===== 函数摘要（§4.5 / §4.6 Pass A）=====
//
// 摘要的键就是 fn 声明节点（resolve_reachable_callee_fn_decl 已能解析）。
// 第一版只算 ret_origin 一项 —— B1 的三处判定点只需要它；escape_mask /
// requires 随 B2/B3 接线再加，避免一次引入过多未知量。

/// 计算一个函数的「返回 origin」摘要：函数体里所有 `return expr` 的 origin 的 join。
/// 参数：checker - 类型检查器；fn_decl - 函数声明节点。
/// 返回：概括后仍能安全用于调用点的 origin（PARAM(i) 表示「原样返回第 i 个形参」）。
///
/// 单调性与保守性：
/// - 任何一处 return 给出 UNKNOWN，整体就是 UNKNOWN（不会凭空产生保证）；
/// - 多处 return 取 join，`return &local` 与 `return &param` 混合 → join 出 UNKNOWN，
///   调用点因此不做任何推断（保守）。
fn lifetime_summary_ret_origin(checker: &TypeChecker, fn_decl: &ASTNode) Origin {
    if checker == null || fn_decl == null || fn_decl.fn_decl_body == null {
        return origin_unknown();
    }
    // 递归深度闸门（防栈溢出）。
    //
    // 摘要本身没有记忆化：`f` 的 return 里有调用 `g`，就会去算 `g` 的摘要，`g` 的
    // return 里又有调用 …… 递归调用链会一路展开，环状调用链则永不收敛。实测
    // 不设闸门时 `uya check src/main.uya` 1.7 秒后段错误（rc=139）。
    // 超过上限一律 UNKNOWN —— 与「证不出 ≠ 证伪」一致，只会少判，不会误报。
    if g_lifetime_summary_depth >= LIFETIME_SUMMARY_MAX_DEPTH {
        return origin_unknown();
    }
    g_lifetime_summary_depth = g_lifetime_summary_depth +| 1;
    var acc: Origin = origin_unknown();
    var seen: i32 = 0;
    lifetime_collect_return_origins(checker, fn_decl.fn_decl_body, &acc, &seen);
    g_lifetime_summary_depth = g_lifetime_summary_depth -| 1;
    if seen == 0 {
        // 没有 return 语句（void 函数）：非指针结果
        return origin_unknown();
    }
    return acc;
}

/// 递归收集函数体里所有 `return expr` 的 origin，按 join 累加。
/// 参数：checker - 类型检查器；node - 当前子树；acc - 累加器（inout）；seen - 已见 return 数（inout）。
/// 返回：无。
///
/// 刻意**不进入**嵌套的 fn 声明（lambda 式内联函数会把别的函数的 return 混进来）。
fn lifetime_collect_return_origins(checker: &TypeChecker, node: &ASTNode, acc: &Origin, seen: &i32) void {
    if checker == null || node == null || acc == null || seen == null {
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        seen[0] = seen[0] +| 1;
        if node.return_stmt_expr == null {
            return;
        }
        const o: Origin = lifetime_origin_of_expr(checker, node.return_stmt_expr);
        // `Origin` 是按值移动的类型：`o` 只能被消费**一次**，且不能同时出现在
        // if/else 两个分支里（Uya 把两个分支都视作「可能已消费」）。
        // 因此这里让 o 只出现在一条无条件语句里：
        //   seen[0] == 1（首次）→ acc 原值是 origin_unknown()，先把 acc 置成未知来源
        //                        再 join，结果就等于 o 本身，语义等价且无需分支。
        //   非首次            → 正常的 join。
        // 已见首条时显式写回 origin_unknown()，正是为了复用同一条 join 路径。
        if seen[0] == 1 {
            acc[0] = origin_unknown();
        }
        var joined: Origin = origin_join(acc[0], o);
        acc[0] = joined;
        return;
    }
    // 不下钻嵌套函数声明
    if node.type == ASTNodeType.AST_FN_DECL {
        return;
    }
    lifetime_walk_child_nodes(checker, node, acc, seen);
}

/// 遍历一个语句/表达式节点的直接子节点，对每个子节点回调「收集 return origin」。
/// 参数：checker - 类型检查器；node - 当前节点；acc - 累加器（inout）；seen - 计数（inout）。
/// 返回：无。
///
/// 覆盖范围只要求「不漏 return」：块、if/else、while、for、var-decl、assign、
/// defer/errdefer、test 块、match。表达式内部不递归 —— return 语句只可能出现在
/// 语句位置，表达式里的嵌套块（catch/match 臂）另行覆盖。
fn lifetime_walk_child_nodes(checker: &TypeChecker, node: &ASTNode, acc: &Origin, seen: &i32) void {
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            lifetime_collect_return_origins(checker, node.block_stmts[i], acc, seen);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_collect_return_origins(checker, node.if_stmt_then_branch, acc, seen);
        lifetime_collect_return_origins(checker, node.if_stmt_else_branch, acc, seen);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        lifetime_collect_return_origins(checker, node.while_stmt_body, acc, seen);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        lifetime_collect_return_origins(checker, node.for_stmt_body, acc, seen);
        return;
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        lifetime_collect_return_origins(checker, node.defer_stmt_body, acc, seen);
        return;
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        lifetime_collect_return_origins(checker, node.errdefer_stmt_body, acc, seen);
        return;
    }
    if node.type == ASTNodeType.AST_TEST_STMT {
        lifetime_collect_return_origins(checker, node.test_stmt_body, acc, seen);
        return;
    }
    // 其余语句/表达式：return 不会出现在其直接子位置（表达式内的 catch/match
    // 块可能含 return，但那已由各自语句路径覆盖；第一版不追求穷尽，宁漏勿假）。
}

// ===== B1：悬垂引用判定（§4.4 三处判定点）=====

/// 判定并报告「return 返回指向局部存储的引用」。
/// 参数：checker - 类型检查器；node - return 语句节点；expr_type - return 表达式的类型。
/// 返回：1 表示无问题；0 表示已报错。
///
/// 放行规则（施工图 §4.4 规则 1，经 §6.3 熔断后收窄）：
///   STATIC / HEAP / PARAM 一律放行；UNKNOWN 放行（证不出不等于证伪）；
///   只有 LOCAL（当前函数内任意作用域）才报错。
///
/// **只认三种形态**，其余一律放行：
///   1. 取地址形态 `return &x` / `return &arr[i]` / `return &s.f`；
///   2. 切片视图 `return arr[a:b]` / `return p[a:b]`（视图不拥有存储，悬垂与否
///      只取决于 base —— `&buf[0:4]` 是第 1 种派生出的第 2 种，buglist P1 第二条
///      的复现就是这一形态）；
///   3. 按值返回的局部数组 `[T: N]`（数组在 C 侧是按值拷贝的聚合体，不携带
///      指针；但里面的**每个指针元素**都是栈地址副本，返回后同样悬垂）。
///
/// 局部指针变量（`const p: &T = ...; return p;`）与函数调用的返回值仍然放行 ——
/// 判定它们需要「指针变量当前指向」的传播，P1 未实现；强行判定会立刻打出
/// 231 处误报并让 `src/` 无法自举（实测记录见 main.uya 调用点注释）。
fn lifetime_check_return_escape(checker: &TypeChecker, node: &ASTNode, expr_type: Type) i32 {
    if checker == null || node == null || node.return_stmt_expr == null {
        return 1;
    }
    // 形态 3 先判：按值返回的局部数组既不含指针也不含切片，会被下面那句
    // lifetime_type_may_hold_pointer 直接放行，必须单独走。
    if lifetime_check_return_local_array_escape(checker, node) == 0 {
        return 0;
    }
    // 只对「返回类型含指针/切片」的情况判定：返回值不是引用就没有悬垂引用
    if lifetime_type_may_hold_pointer(expr_type) == 0 {
        return 1;
    }
    // 收窄点：只判定「取地址」与「切片视图」两种形态。`return p;`（p 是局部指针
    // 变量）与 `return f(...);`（调用返回值）在此放行，见上方说明。
    if lifetime_expr_is_address_of_local(node.return_stmt_expr) == 0 &&
        lifetime_expr_is_local_slice_view(node.return_stmt_expr) == 0 {
        return 1;
    }
    const o: Origin = lifetime_origin_of_expr(checker, node.return_stmt_expr);
    if o.kind != ORIGIN_LOCAL {
        return 1;
    }
    lifetime_report_return_local(checker);
    checker_report_error(checker, node,
        "返回指向局部存储的引用：该存储随函数返回失效，调用方拿到的是悬垂指针" as *byte);
    return 0;
}

/// 判定并报告「按值返回局部数组、而数组元素含指针」。
/// 参数：checker - 类型检查器；node - return 语句节点。
/// 返回：1 表示无问题；0 表示已报错。
///
/// 只判定最不可能误报的一种形态：return 表达式是**标识符**、且该标识符是当前函数
/// 作用域内的局部变量（不是形参、不是顶层全局）、且它的类型是**元素含指针的数组**。
/// 数组本身按值拷贝不会悬垂，悬垂的是元素里那些栈地址副本；调用方拿到后一解引用
/// 就踩已释放的栈帧，属 buglist P1 第一条的实体。
///
/// 刻意不做：数组下标 `return buf[i]`（元素可能是指针，但读元素走的是
/// lifetime_origin_of_value，P1 精度下拿不到可靠来源）、返回值里含数组的结构体。
fn lifetime_check_return_local_array_escape(checker: &TypeChecker, node: &ASTNode) i32 {
    const expr: &ASTNode = node.return_stmt_expr;
    if expr.type != ASTNodeType.AST_IDENTIFIER || expr.identifier_name == null {
        return 1;
    }
    const sym: &Symbol = symbol_table_lookup(checker, expr.identifier_name);
    if sym == null {
        return 1;
    }
    if lifetime_symbol_is_param(checker, sym) != 0 || sym.scope_level <= 0 {
        return 1;   // 形参 / 顶层全局：不归本函数所有，返回它们不悬垂
    }
    var sym_type: Type = sym.type;
    if sym_type.kind != TypeKind.TYPE_ARRAY || sym_type.element_type == null {
        return 1;
    }
    var elem_type: Type = sym_type.element_type[0];
    if lifetime_type_may_hold_pointer(elem_type) == 0 {
        return 1;   // 纯标量数组按值拷贝，安全
    }
    lifetime_report_return_local(checker);
    checker_report_error(checker, node,
        "返回含指针元素的局部数组：数组里的指针指向本函数的局部存储，随返回失效" as *byte);
    return 0;
}

/// 判断表达式是否为「对局部存储开窗」的切片表达式 `base[a:b]`。
/// 参数：expr - return 表达式。
/// 返回：1 表示是切片表达式（base 的归属交给 origin 判定），0 表示不是。
///
/// 与 lifetime_expr_is_address_of_local 同一层级的**语法**判断：这里只回答
/// 「这是不是一个切片视图」，至于 base 是局部还是形参，由 origin 格决定 ——
/// `return s[0:4]`（s 是形参）必须放行，`return buf[0:4]`（buf 是局部数组）
/// 必须报错，两者语法同形。
fn lifetime_expr_is_local_slice_view(expr: &ASTNode) i32 {
    if expr == null {
        return 0;
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        return 1;
    }
    return 0;
}

/// 判断一个类型「是否可能携带指向其他存储的引用」。
/// 参数：t - 待判定类型。
/// 返回：1 表示是指针或切片（可能悬垂），0 表示按值类型（不可能悬垂）。
fn lifetime_type_may_hold_pointer(t: Type) i32 {
    if t.kind == TypeKind.TYPE_POINTER || t.kind == TypeKind.TYPE_SLICE {
        return 1;
    }
    if t.kind == TypeKind.TYPE_ERROR_UNION && t.error_union_payload_type != null {
        var inner: Type = t.error_union_payload_type[0];
        return lifetime_type_may_hold_pointer(inner);
    }
    return 0;
}

/// 判断「写更长寿命容器」判定点是否值得对某个来源求 origin。
/// 参数：src - 赋值源表达式。
/// 返回：1 表示来源形态可判（`&place` / 切片视图 / 标识符），0 表示跳过判定。
///
/// 只放行这三种形态的理由见 lifetime_check_store_escape：调用表达式会把
/// 「函数摘要」拖进来，而摘要在没有记忆化时会互相递归。
fn lifetime_store_src_is_checkable(src: &ASTNode) i32 {
    if src == null {
        return 0;
    }
    if src.type == ASTNodeType.AST_UNARY_EXPR {
        if (src.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND {
            return 1;
        }
        return 0;
    }
    if src.type == ASTNodeType.AST_SLICE_EXPR {
        return 1;
    }
    if src.type == ASTNodeType.AST_IDENTIFIER {
        return 1;
    }
    return 0;
}

/// 判定并报告「把短寿命的值写进长寿命的容器」（§4.4 规则 2）。
/// 参数：checker - 类型检查器；dest - 赋值目标表达式；src - 赋值源表达式；dest_type - 目标类型。
/// 返回：1 表示无问题；0 表示已报错。
///
/// **只报「寿命长短可证」的那一侧**，其余一律放行。具体：来源必须是 LOCAL，
/// 且容器必须是「寿命明确 ∞」的两种：
///   1. 顶层全局变量 `g = &x`；
///   2. 全局对象的字段 `g_obj.f = &x`（容器 origin 为 STATIC）。
///
/// 明确**放行**（也就等于明确承认这些洞还在，见 docs/unsafe_audit_plan.md §5）：
///   - `PARAM → 全局`：形参借来的存储活多久由调用点决定，没有生命周期参数就证不出 ——
///     而 `g_compiler_arena_failure_key = key` 这类「登记调用方给的 key」是编译器自身
///     的主流写法（arena.uya / heap.uya / pthread.uya 共 4 处），一律拒绝等于让
///     语言用不了。这一条要等「传参判定点」把调用点 origin 传进来才收得掉。
///   - `LOCAL → 局部容器的字段`：容器自己也不逃逸时它并不危险，而「容器是否逃逸」
///     需要字段级逃逸分析（未实现）。判它会把 `checker.current_function_decl = method`
///     这类纯内部记账全部打穿。
///   - 写切片元素 `arr[i] = e`：切片 origin 还拿不到。
fn lifetime_check_store_escape(checker: &TypeChecker, dest: &ASTNode, src: &ASTNode, dest_type: Type) i32 {
    if checker == null || dest == null || src == null {
        return 1;
    }
    if lifetime_type_may_hold_pointer(dest_type) == 0 {
        return 1;
    }
    // 只判「来源形态便宜且可靠」的三类：`&place`、切片视图、标识符。
    //
    // 排除调用表达式不只是省时间：`lifetime_origin_of_expr(调用)` →
    // `lifetime_summary_ret_origin` → 递归扫被调方函数体的每个 return → 又可能遇到
    // 调用 —— 没有记忆化时这是**互相递归**，实测让 `uya check src/main.uya` 从 4s
    // 变成不返回、随后栈溢出段错误（rc=139）。语义上也没损失：`g_slot = make_ptr()`
    // 这种「被调方返回局部地址」的错误，在**被调方自己的 return 判定点**上已经
    // 报过一次，不必在调用点重复判。
    if lifetime_store_src_is_checkable(src) == 0 {
        return 1;
    }
    const src_origin: Origin = lifetime_origin_of_expr(checker, src);
    // 只有 LOCAL 是「寿命已经确定且短」的：其余（STATIC/HEAP/PARAM/UNKNOWN）
    // 都证不出「短」，按「证不出 ≠ 证伪」放行。
    if src_origin.kind != ORIGIN_LOCAL {
        return 1;
    }

    // 场景 1：写全局变量（scope_level == 0 的符号 = 顶层 var）
    if dest.type == ASTNodeType.AST_IDENTIFIER && dest.identifier_name != null {
        const sym: &Symbol = symbol_table_lookup(checker, dest.identifier_name);
        if sym != null && sym.scope_level <= 0 {
            checker_report_error(checker, dest,
                "不能把指向局部存储的引用写入全局变量：该存储随函数返回失效，全局变量会变成悬垂指针" as *byte);
            return 0;
        }
        return 1;
    }

    // 场景 2：写**全局对象**的字段 `g_obj.f = e`
    //
    // 只有容器是 STATIC 时才判：那时「容器寿命 ∞ 且来源寿命短」是可证的悬垂。
    // 容器是形参/局部时不判（见上面的放行清单）。
    //
    // 这里修的是一个真实的判定方向错误：原实现写作
    // `if origin_outlives(container, src_origin) == 0 { 报错 }`，
    // 即「容器活得不比来源长」才报 —— 那恰恰是安全的一侧（指针随容器一起死）；
    // 而「容器活得比来源长」（来源先死、容器里的指针悬垂）反而放行。
    if dest.type == ASTNodeType.AST_MEMBER_ACCESS {
        const container: Origin = lifetime_origin_of_place(checker, dest.member_access_object);
        if container.kind == ORIGIN_STATIC {
            checker_report_error(checker, dest,
                "不能把指向局部存储的引用写入全局对象的字段：该存储随函数返回失效，字段会变成悬垂指针" as *byte);
            return 0;
        }
    }
    return 1;
}

/// 判断一个符号是否绑定到当前函数的形参。
/// 参数：checker - 类型检查器；sym - 待判定符号。
/// 返回：1 表示是形参，0 表示不是。
///
/// 为什么不直接用 `scope_level == 1`：函数体开作用域后才插形参，但有方法接收者
/// 自带的 `self`、嵌套块、泛型单态化等路径会让形参落在别的层级；反过来，
/// 第一层里也可能有非形参的局部变量。所以拿当前函数的形参表逐名核对，
/// 这是唯一不会随作用域层级变化而漂移的判据。
fn lifetime_symbol_is_param(checker: &TypeChecker, sym: &Symbol) i32 {
    if checker == null || sym == null || sym.name == null {
        return 0;
    }
    const fn_decl: &ASTNode = checker.current_function_decl;
    if fn_decl == null || fn_decl.fn_decl_params == null {
        return 0;
    }
    var i: i32 = 0;
    while i < fn_decl.fn_decl_param_count {
        const p: &ASTNode = fn_decl.fn_decl_params[i];
        if p != null && p.type == ASTNodeType.AST_VAR_DECL && p.var_decl_name != null {
            if str_equals(p.var_decl_name, sym.name) != 0 {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 对一个「值」求 origin：问的是「这个值指向的存储在哪儿」。
/// 参数：checker - 类型检查器；expr - 求值表达式。
/// 返回：该值携带的 origin。
///
/// 与 lifetime_origin_of_place 的分工：
///   of_place  回答「这个位置的存储本身在哪」——`&x` 用它，答案是 LOCAL；
///   of_value  回答「这个值指向哪里」——`return x` / `f(x)` 用它。
///
/// 对局部指针变量，P1 还没有「指针变量的当前指向」这件事（需要 each-symbol
/// 的指向传播），因此一律 UNKNOWN：证不出 ≠ 证伪。这是有意保守的选择 ——
/// 施工图 §6.3 已经把「误报数百条」定为熔断信号，宁可少报也不能打穿自举。
fn lifetime_origin_of_value(checker: &TypeChecker, expr: &ASTNode) Origin {
    if checker == null || expr == null {
        return origin_unknown();
    }
    // ⚠ 这里**只能**处理标识符。早期版本最后一行的兜底是
    // `return lifetime_origin_of_expr(checker, expr);`，而 `lifetime_origin_of_expr`
    // 对 `AST_MEMBER_ACCESS` / `AST_ARRAY_ACCESS` 又回调本函数 —— 两者互相递归，
    // 一旦有「读字段/读元素」的来源被求 origin 就永远不返回（实测把 store 判定点
    // 接进赋值后，`uya check src/main.uya` 从 4s 变成 600s 仍未结束）。
    // 语义上正确答案也不该递归：`s.f` 读出的是**字段里存的那个指针值**，它指向哪儿
    // 在这个精度下证不出 → UNKNOWN。因此非标识符一律 UNKNOWN。
    if expr.type != ASTNodeType.AST_IDENTIFIER {
        return origin_unknown();
    }
    const name: &byte = expr.identifier_name;
    if name == null {
        return origin_unknown();
    }
    const sym: &Symbol = symbol_table_lookup(checker, name);
    if sym == null {
        return origin_static();
    }
    // 形参：值来自调用方 → PARAM（由调用点实例化）
    if lifetime_symbol_is_param(checker, sym) != 0 {
        return origin_param(-1);
    }
    // 顶层符号：全局 var / const、static 缓冲 → 寿命 ∞
    if sym.scope_level <= 0 {
        return origin_static();
    }
    // 局部变量：读出来的值是**副本**。
    //   指针/切片：指向的存储未知 → UNKNOWN（见上方说明）
    //   非指针：按值拷贝，不构成引用，也记 UNKNOWN（调用方只对指针形态判定）
    var sym_type: Type = sym.type;
    if sym_type.kind == TypeKind.TYPE_POINTER || sym_type.kind == TypeKind.TYPE_SLICE {
        return origin_unknown();
    }
    return origin_unknown();
}

/// 判断表达式是否为「对局部存储取地址」的形态：`&x`、`&arr[i]`、`&s.f`。
/// 参数：expr - return 表达式。
/// 返回：1 表示是取地址形态，0 表示不是（局部指针变量、调用返回值等）。
///
/// 这是 B1 第一版唯一判定的形态（见 lifetime_check_return_escape 的说明）。
/// 只做**语法层**判断，不关心操作数最终解析成局部还是形参 —— 后者交给
/// origin 格的 LOCAL 判定，语法层只管「这是不是一个取地址表达式」。
/// `as &T` 包裹的取地址（`(&x) as &void`）也算，因为按 §5.2 它一律 UNKNOWN，
/// 由 origin 层自然放行，这里不必特判。
fn lifetime_expr_is_address_of_local(expr: &ASTNode) i32 {
    if expr == null {
        return 0;
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        var op: TokenType = expr.unary_expr_op as TokenType;
        if op == TokenType.TOKEN_AMPERSAND {
            return 1;
        }
        return 0;
    }
    // 切片字面视图 `base[a:b]` 不会把局部栈存储带出函数体的情况极少，
    // 第一版不判定（避免把 `s[0:4]` 里 s 为形参的合法形态误报）。
    return 0;
}

// ===== B2：形参「非空」requirement 摘要与调用点付账 =====
//
// assume-guarantee 的 requirement 方向：被调方**不能**假定形参非空（那是它没挣到的
// warranty），只能声明「我需要它非空」。这条声明必须在调用点被付账。
//
// 判定刻意「宁漏勿假」：只有同时满足下面三条才算一条 requirement ——
//   1. 该形参是**指针**类型；
//   2. 函数体内**解引用**了它（`p[i]` 或 `p.f`）；
//   3. 函数体内**没有**任何 `p == null` / `p != null` 形式的比较。
// 第 3 条是关键：出现 null 比较说明该形参被设计成可空的，由被调方自己守卫，
// 此时不产生 requirement —— 否则库里那些「可选 out 形参」全会被误判。

/// 判断表达式是否为字面量 `null`。
/// 参数：expr - 待判定表达式。
/// 返回：1 表示是 `null` 字面量，0 表示不是。
fn lifetime_expr_is_null_literal(expr: &ASTNode) i32 {
    if expr == null {
        return 0;
    }
    if expr.type != ASTNodeType.AST_IDENTIFIER {
        return 0;
    }
    if expr.identifier_name == null {
        return 0;
    }
    if str_equals(expr.identifier_name, "null" as &byte) != 0 {
        return 1;
    }
    return 0;
}

/// 递归扫描子树，记录「是否解引用 name」与「是否把 name 与 null 比较过」。
/// 参数：checker - 类型检查器（保留给后续需要类型信息的扩展）；node - 当前节点；
///       name - 形参名；saw_deref - 解引用标记（出参）；saw_guard - null 比较标记（出参）。
/// 返回：无。
///
/// 刻意**不下钻**嵌套的 `AST_FN_DECL`：内层函数有独立形参空间，
/// 同名标识符指的不是外层形参，下钻会凭空造出 requirement。
/// 递归扫描子树，记录「是否**无条件**解引用 name」与「是否把 name 与 null 比较过」。
/// 参数：checker - 类型检查器（保留给后续需要类型信息的扩展）；node - 当前节点；
///       name - 形参名；nested - 是否处在控制流内部（0 否，1 是）；
///       saw_deref - 无条件解引用标记（出参）；saw_guard - null 比较标记（出参）。
/// 返回：无。
///
/// **只认无条件解引用**：`p[i]` 若出现在 if/while/for/defer/test/errdefer 的体内，
/// 就可能是「数据相关」的 —— 例如 lib/tls/base/drbg.uya 的 `_update`：
///
///     fn _update(ctx: &DrbgCtx, provided_data: &const byte, provided_len: usize) void {
///         ...
///         while i < provided_len { buf[...] = provided_data[i]; ... }   // provided_len == 0 时不会执行
///     }
///     _update(ctx, null, 0);                                            // 合法且安全
///
/// 那里的解引用由 `provided_len` 守着，不是「形参必须非空」。这种「解引用可否发生
/// 取决于另一个实参」的相关性正是 B4 要证明的东西；B4 之前一律按「证不出」放行
/// （施工图 §5：证不出不等于证伪）。
///
/// 刻意**不下钻**嵌套的 `AST_FN_DECL`：内层函数有独立形参空间，
/// 同名标识符指的不是外层形参，下钻会凭空造出 requirement。
fn lifetime_scan_param_use(checker: &TypeChecker, node: &ASTNode, name: &byte, nested: i32,
                           saw_deref: &i32, saw_guard: &i32) void {
    if node == null || name == null {
        return;
    }
    if node.type == ASTNodeType.AST_FN_DECL {
        return;
    }
    // 解引用形态 1：`p[i]`
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        const base: &ASTNode = node.array_access_array;
        if nested == 0 && base != null && base.type == ASTNodeType.AST_IDENTIFIER &&
            base.identifier_name != null && str_equals(base.identifier_name, name) != 0 {
            saw_deref[0] = 1;
        }
    }
    // 解引用形态 2：`p.f`
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        const obj: &ASTNode = node.member_access_object;
        if nested == 0 && obj != null && obj.type == ASTNodeType.AST_IDENTIFIER &&
            obj.identifier_name != null && str_equals(obj.identifier_name, name) != 0 {
            saw_deref[0] = 1;
        }
    }
    // 守卫形态：`p == null` / `p != null` / `null == p` / `null != p`
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        const bop: TokenType = node.binary_expr_op as TokenType;
        if bop == TokenType.TOKEN_EQUAL || bop == TokenType.TOKEN_NOT_EQUAL {
            const lhs: &ASTNode = node.binary_expr_left;
            const rhs: &ASTNode = node.binary_expr_right;
            if lifetime_binary_is_null_guard(lhs, rhs, name) != 0 ||
                lifetime_binary_is_null_guard(rhs, lhs, name) != 0 {
                saw_guard[0] = 1;
            }
        }
    }
    // 递归子节点。这里按语句/表达式的容器形态逐类展开（与 lifetime_walk_child_nodes
    // 同一套覆盖范围，但多了表达式的左/右子树，因为解引用可能出现在任意表达式位置）。
    // 进入控制流体内时 nested 置 1，见函数头注释。
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            lifetime_scan_param_use(checker, node.block_stmts[i], name, nested, saw_deref, saw_guard);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_scan_param_use(checker, node.if_stmt_condition, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.if_stmt_then_branch, name, 1, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.if_stmt_else_branch, name, 1, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        lifetime_scan_param_use(checker, node.while_stmt_condition, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.while_stmt_body, name, 1, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        lifetime_scan_param_use(checker, node.for_stmt_array, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.for_stmt_range_start, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.for_stmt_range_end, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.for_stmt_body, name, 1, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        lifetime_scan_param_use(checker, node.defer_stmt_body, name, 1, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        lifetime_scan_param_use(checker, node.errdefer_stmt_body, name, 1, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_TEST_STMT {
        lifetime_scan_param_use(checker, node.test_stmt_body, name, 1, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        lifetime_scan_param_use(checker, node.assign_dest, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.assign_src, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        lifetime_scan_param_use(checker, node.return_stmt_expr, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        lifetime_scan_param_use(checker, node.var_decl_init, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        var ci: i32 = 0;
        while ci < node.call_expr_arg_count {
            lifetime_scan_param_use(checker, node.call_expr_args[ci], name, nested, saw_deref, saw_guard);
            ci = ci + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        lifetime_scan_param_use(checker, node.binary_expr_left, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.binary_expr_right, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR {
        lifetime_scan_param_use(checker, node.unary_expr_operand, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        lifetime_scan_param_use(checker, node.member_access_object, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        lifetime_scan_param_use(checker, node.array_access_array, name, nested, saw_deref, saw_guard);
        lifetime_scan_param_use(checker, node.array_access_index, name, nested, saw_deref, saw_guard);
        return;
    }
    if node.type == ASTNodeType.AST_SLICE_EXPR {
        lifetime_scan_param_use(checker, node.slice_expr_base, name, nested, saw_deref, saw_guard);
        return;
    }
}

/// 判断一对操作数是否为「`name` 与 `null` 比较」。
/// 参数：a - 假定为 `name` 一侧；b - 假定为 `null` 一侧；name - 形参名。
/// 返回：1 表示匹配，0 表示不匹配。
fn lifetime_binary_is_null_guard(a: &ASTNode, b: &ASTNode, name: &byte) i32 {
    if a == null || b == null || name == null {
        return 0;
    }
    if a.type != ASTNodeType.AST_IDENTIFIER || a.identifier_name == null {
        return 0;
    }
    if str_equals(a.identifier_name, name) == 0 {
        return 0;
    }
    return lifetime_expr_is_null_literal(b);
}

/// 判定 `fn_decl` 的第 `param_index` 个形参是否构成一条「非空」requirement。
/// 参数：checker - 类型检查器；fn_decl - 被调方函数声明；param_index - 形参下标（0 基）。
/// 返回：1 表示该形参需要调用点保证非空，0 表示不需要（或证不出）。
fn lifetime_fn_param_requires_nonnull(checker: &TypeChecker, fn_decl: &ASTNode, param_index: i32) i32 {
    if checker == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    if param_index < 0 || param_index >= fn_decl.fn_decl_param_count {
        return 0;
    }
    if fn_decl.fn_decl_body == null {
        return 0;   // 无函数体（extern / 接口声明）：没有可判定的用法，宁漏勿假
    }
    const param: &ASTNode = fn_decl.fn_decl_params[param_index];
    if param == null || param.type != ASTNodeType.AST_VAR_DECL || param.var_decl_name == null {
        return 0;
    }
    const param_type: Type = type_from_ast(checker, param.var_decl_type);
    if param_type.kind != TypeKind.TYPE_POINTER {
        return 0;   // 只对指针形参谈「非空」
    }
    var saw_deref: i32 = 0;
    var saw_guard: i32 = 0;
    lifetime_scan_param_use(checker, fn_decl.fn_decl_body, param.var_decl_name, 0, &saw_deref, &saw_guard);
    if saw_guard != 0 {
        return 0;   // 被调方自己做了 null 守卫 → 形参可空，不产生 requirement
    }
    if saw_deref == 0 {
        return 0;   // 没解引用 → 没有非空需求
    }
    return 1;
}

/// 在调用点付账：实参是字面量 `null` 且被调方需要该形参非空时报错。
/// 参数：checker - 类型检查器；node - 调用表达式节点。
/// 返回：无。
///
/// 只处理「被调方是可直接解析到 `AST_FN_DECL` 的具名函数」这一种调用形态：
/// 方法调用、函数指针、泛型实例化走的是各自的解析路径，第一版不碰 ——
/// 宁可漏报也不要在解析不确定的地方造误报（施工图 §5 的健全性取向）。
fn lifetime_check_call_null_args(checker: &TypeChecker, node: &ASTNode) void {
    if checker == null || node == null || node.type != ASTNodeType.AST_CALL_EXPR {
        return;
    }
    if checker.enable_safety_proof == 0 {
        return;
    }
    const callee: &ASTNode = node.call_expr_callee;
    if callee == null || callee.type != ASTNodeType.AST_IDENTIFIER || callee.identifier_name == null {
        return;
    }
    // 函数名不在符号表里 —— 只有函数签名表。签名表带着 decl_node（见
    // FunctionSignature.decl_node 的注释），据此才能读到被调方函数体。
    const sig: &FunctionSignature = function_table_lookup(checker, callee.identifier_name);
    if sig == null || sig.decl_node == null || sig.decl_node.type != ASTNodeType.AST_FN_DECL {
        return;
    }
    const fn_decl: &ASTNode = sig.decl_node;
    // 去重：同一调用节点会被 checker_infer_type 推导多次，只报一遍。
    if checker.lifetime_last_null_arg_node == node {
        return;
    }
    var count: i32 = node.call_expr_arg_count;
    if count > fn_decl.fn_decl_param_count {
        count = fn_decl.fn_decl_param_count;
    }
    var i: i32 = 0;
    while i < count {
        const arg: &ASTNode = node.call_expr_args[i];
        if arg != null && lifetime_expr_is_null_literal(arg) != 0 {
            if lifetime_fn_param_requires_nonnull(checker, fn_decl, i) != 0 {
                checker.lifetime_last_null_arg_node = node;
                lifetime_report_param_null(checker, 0);
                checker_report_error(checker, arg,
                    "传入 null 给需要非空的形参：被调方会直接解引用它，运行期必然崩溃" as *byte);
            }
        }
        i = i + 1;
    }
}

// ===== B4：后置事实（下标上界）=====
//
// 目标形态（`find` 类函数）：
//
//     fn find_in(a: &[i32: 8], needle: i32) i32 {
//         var i: i32 = 0;
//         while i < 8 {
//             if a[i] == needle { return i; }
//             i = i + 1;
//         }
//         return -1;
//     }
//     const idx: i32 = find_in(&a, n);
//     if idx >= 0 { return a[idx]; }     // ← 旧行为：数组索引安全证明失败
//
// 后置事实：`idx >= 0` 时必有 `idx < 8`。它只能**有条件**成立，
// 所以绝不能在赋值点无条件加约束（那样 `a[idx]` 在 idx == -1 的路径上也会放行，
// 反而制造 UB）。正确接法是只在 `if v >= 0` 的 then 分支里注入 `v < N`，
// 由 main.uya 的 if 处理随分支回滚 —— 见 lifetime_apply_post_index_bound。

/// 判定表达式是否为负整数常量字面量（`-1` 这类失败哨兵）。
/// 参数：expr - 待判定表达式。
/// 返回：1 表示是负的整数字面量，0 表示不是。
fn lifetime_expr_is_negative_literal(expr: &ASTNode) i32 {
    if expr == null || expr.type != ASTNodeType.AST_UNARY_EXPR {
        return 0;
    }
    const op: TokenType = expr.unary_expr_op as TokenType;
    if op != TokenType.TOKEN_MINUS {
        return 0;
    }
    const operand: &ASTNode = expr.unary_expr_operand;
    if operand == null || operand.type != ASTNodeType.AST_NUMBER {
        return 0;
    }
    if operand.number_value <= 0 {
        return 0;
    }
    return 1;
}

/// 取 `v < N` 形式的循环条件里的 `v` 名字。
/// 参数：cond - 循环条件表达式。
/// 返回：变量名；不是该形式时返回 null。
fn lifetime_cond_lt_var(cond: &ASTNode) &byte {
    if cond == null || cond.type != ASTNodeType.AST_BINARY_EXPR {
        return null;
    }
    const op: TokenType = cond.binary_expr_op as TokenType;
    if op != TokenType.TOKEN_LESS {
        return null;
    }
    const lhs: &ASTNode = cond.binary_expr_left;
    if lhs == null || lhs.type != ASTNodeType.AST_IDENTIFIER || lhs.identifier_name == null {
        return null;
    }
    const rhs: &ASTNode = cond.binary_expr_right;
    if rhs == null || rhs.type != ASTNodeType.AST_NUMBER || rhs.number_value <= 0 {
        return null;
    }
    return lhs.identifier_name;
}

/// 取 `v < N` 形式的循环条件里的上界 `N`。
/// 参数：cond - 循环条件表达式。
/// 返回：N（> 0）；不是该形式时返回 0。
fn lifetime_cond_lt_bound(cond: &ASTNode) i32 {
    if lifetime_cond_lt_var(cond) == null {
        return 0;
    }
    return cond.binary_expr_right.number_value;
}

/// 扫描循环体内的 return，统计「受 `v < N` 守卫的 `return v`」与「无法归类的 return」。
/// 参数：checker - 类型检查器（累加器在 lifetime_scan_good / lifetime_scan_bad）；
///       node - 当前节点；var_name - 循环变量名；mutated - 进入本节点前该变量是否已被改写。
/// 返回：无。
///
/// 「已改写」是健全性的关键：`return v` 只有在**本条路径上还没改过 v** 时才带守卫结论
/// （v < N 是进入循环体时成立的事实）。块内按语句顺序推进；进入 if/循环这类
/// 复合语句后一律保守地认为 v 可能被改写。
fn lifetime_scan_guarded_returns(checker: &TypeChecker, node: &ASTNode, var_name: &byte, mutated: i32) void {
    if checker == null || node == null || var_name == null {
        return;
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var cur: i32 = mutated;
        var i: i32 = 0;
        while i < node.block_stmt_count {
            const stmt: &ASTNode = node.block_stmts[i];
            if stmt != null && stmt.type == ASTNodeType.AST_ASSIGN &&
                stmt.assign_dest != null && stmt.assign_dest.type == ASTNodeType.AST_IDENTIFIER &&
                stmt.assign_dest.identifier_name != null &&
                str_equals(stmt.assign_dest.identifier_name, var_name) != 0 {
                cur = 1;
            } else if stmt != null && (stmt.type == ASTNodeType.AST_IF_STMT ||
                                       stmt.type == ASTNodeType.AST_WHILE_STMT ||
                                       stmt.type == ASTNodeType.AST_FOR_STMT) {
                lifetime_scan_guarded_returns(checker, stmt, var_name, cur);
                cur = 1;    // 复合语句可能改写 v，后续 return 不再带守卫结论
                i = i + 1;
                continue;
            }
            lifetime_scan_guarded_returns(checker, stmt, var_name, cur);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_scan_guarded_returns(checker, node.if_stmt_then_branch, var_name, mutated);
        lifetime_scan_guarded_returns(checker, node.if_stmt_else_branch, var_name, mutated);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        lifetime_scan_guarded_returns(checker, node.while_stmt_body, var_name, 1);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        lifetime_scan_guarded_returns(checker, node.for_stmt_body, var_name, 1);
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        const expr: &ASTNode = node.return_stmt_expr;
        if expr == null {
            checker.lifetime_scan_bad = checker.lifetime_scan_bad +| 1;
            return;
        }
        if lifetime_expr_is_negative_literal(expr) != 0 {
            return;     // 失败哨兵，与上界无关
        }
        if expr.type == ASTNodeType.AST_IDENTIFIER && expr.identifier_name != null &&
            str_equals(expr.identifier_name, var_name) != 0 && mutated == 0 {
            checker.lifetime_scan_good = checker.lifetime_scan_good +| 1;
            return;
        }
        checker.lifetime_scan_bad = checker.lifetime_scan_bad +| 1;
        return;
    }
    // 其余语句：不深入（表达式里不会有 return）。
}

/// 扫描子树里的 return，要求它们全部是负整数哨兵。
/// 参数：checker - 类型检查器（违规计入 lifetime_scan_bad）；node - 当前节点。
/// 返回：无。
fn lifetime_scan_neg_returns(checker: &TypeChecker, node: &ASTNode) void {
    if checker == null || node == null {
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        if lifetime_expr_is_negative_literal(node.return_stmt_expr) == 0 {
            checker.lifetime_scan_bad = checker.lifetime_scan_bad +| 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            lifetime_scan_neg_returns(checker, node.block_stmts[i]);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_scan_neg_returns(checker, node.if_stmt_then_branch);
        lifetime_scan_neg_returns(checker, node.if_stmt_else_branch);
        return;
    }
    // 循环体、defer 等不在本函数处理范围（顶层循环由调用方单独处理）。
}

/// 求一个 while 循环贡献的下标上界。
/// 参数：checker - 类型检查器；wh - `AST_WHILE_STMT` 节点。
/// 返回：N（> 0）表示「循环里 return 出来的值 < N」；0 表示本循环不贡献上界；
///       -1 表示本循环里出现了无法归类的 return（调用方应整体放弃摘要）。
fn lifetime_while_guarded_bound(checker: &TypeChecker, wh: &ASTNode) i32 {
    if checker == null || wh == null || wh.type != ASTNodeType.AST_WHILE_STMT {
        return 0;
    }
    const var_name: &byte = lifetime_cond_lt_var(wh.while_stmt_condition);
    const bound: i32 = lifetime_cond_lt_bound(wh.while_stmt_condition);
    if var_name == null || bound <= 0 {
        // 条件不是 `v < N`：循环体里若有 return，一律按无法归类处理
        checker.lifetime_scan_good = 0;
        checker.lifetime_scan_bad = 0;
        lifetime_scan_neg_returns(checker, wh.while_stmt_body);
        if checker.lifetime_scan_bad != 0 {
            return -1;
        }
        return 0;
    }
    checker.lifetime_scan_good = 0;
    checker.lifetime_scan_bad = 0;
    lifetime_scan_guarded_returns(checker, wh.while_stmt_body, var_name, 0);
    if checker.lifetime_scan_bad != 0 {
        return -1;
    }
    if checker.lifetime_scan_good == 0 {
        return 0;
    }
    return bound;
}

/// 求被调方的后置事实：`返回值 >= 0` 时 `返回值 < N`。
/// 参数：checker - 类型检查器；fn_decl - 被调方函数声明。
/// 返回：N（> 0）；推不出（或存在任何无法归类的 return）时返回 0。
///
/// 判据（宁漏勿假）：
///   ①返回类型必须是 i32；
///   ②函数体顶层每条语句要么是 `while v < N { ... }`（且循环内所有 return 都是
///     「未改写 v 之前的 `return v`」或负整数哨兵，且至少有一个 `return v`），
///     要么其子树的 return 全是负整数哨兵；
///   ③所有循环给出的 N 必须一致。
/// 任何一条不满足就放弃摘要 —— 宁可少证一条下标，也不能凭空断言上界。
fn lifetime_fn_ret_index_upper(checker: &TypeChecker, fn_decl: &ASTNode) i32 {
    if checker == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 0;
    }
    if fn_decl.fn_decl_body == null || fn_decl.fn_decl_return_type == null {
        return 0;
    }
    const ret_type: Type = type_from_ast(checker, fn_decl.fn_decl_return_type);
    if ret_type.kind != TypeKind.TYPE_I32 {
        return 0;
    }
    const body: &ASTNode = fn_decl.fn_decl_body;
    if body.type != ASTNodeType.AST_BLOCK || body.block_stmts == null {
        return 0;
    }
    var bound: i32 = 0;
    var i: i32 = 0;
    while i < body.block_stmt_count {
        const stmt: &ASTNode = body.block_stmts[i];
        if stmt != null && stmt.type == ASTNodeType.AST_WHILE_STMT {
            const b: i32 = lifetime_while_guarded_bound(checker, stmt);
            if b < 0 {
                return 0;
            }
            if b > 0 {
                if bound != 0 && bound != b {
                    return 0;   // 多个循环给出的界不一致，无法合成单一事实
                }
                bound = b;
            }
        } else {
            checker.lifetime_scan_bad = 0;
            lifetime_scan_neg_returns(checker, stmt);
            if checker.lifetime_scan_bad != 0 {
                return 0;
            }
        }
        i = i + 1;
    }
    return bound;
}

/// 在变量初始化表达式是「下标或 -1」语义的调用时，把被调方承诺的上界记到符号上。
/// 参数：checker - 类型检查器；node - 变量声明节点。
/// 返回：无。
///
/// 只认 `var v: i32 = f(...)` 这一种最简形态；实参、方法调用、函数指针一律不碰。
fn lifetime_record_post_index_upper(checker: &TypeChecker, node: &ASTNode) void {
    if checker == null || node == null || node.type != ASTNodeType.AST_VAR_DECL {
        return;
    }
    if node.var_decl_name == null || node.var_decl_init == null {
        return;
    }
    const init: &ASTNode = node.var_decl_init;
    if init.type != ASTNodeType.AST_CALL_EXPR || init.call_expr_callee == null ||
        init.call_expr_callee.type != ASTNodeType.AST_IDENTIFIER ||
        init.call_expr_callee.identifier_name == null {
        return;
    }
    const sig: &FunctionSignature = function_table_lookup(checker, init.call_expr_callee.identifier_name);
    if sig == null || sig.decl_node == null || sig.decl_node.type != ASTNodeType.AST_FN_DECL {
        return;
    }
    const upper: i32 = lifetime_fn_ret_index_upper(checker, sig.decl_node);
    if upper <= 0 {
        return;
    }
    const sym: &Symbol = symbol_table_lookup(checker, node.var_decl_name);
    if sym == null {
        return;
    }
    sym.post_index_upper = upper;
}

/// 在 `if v >= 0` 的 then 分支里把后置事实变成可用约束 `v < N`。
/// 参数：checker - 类型检查器；cond - if 的条件表达式。
/// 返回：无。
///
/// 调用方必须只在**正条件**（then 分支）时调用，且约束随分支回滚
/// （main.uya 的 if 处理本来就保存/恢复 constraint_count）。
/// 认三种写法：`v >= 0`、`0 <= v`、`v > -1`；`&&` 两侧都看。
fn lifetime_apply_post_index_bound(checker: &TypeChecker, cond: &ASTNode) void {
    if checker == null || cond == null || cond.type != ASTNodeType.AST_BINARY_EXPR {
        return;
    }
    const op: TokenType = cond.binary_expr_op as TokenType;
    if op == TokenType.TOKEN_LOGICAL_AND {
        lifetime_apply_post_index_bound(checker, cond.binary_expr_left);
        lifetime_apply_post_index_bound(checker, cond.binary_expr_right);
        return;
    }
    const lhs: &ASTNode = cond.binary_expr_left;
    const rhs: &ASTNode = cond.binary_expr_right;
    if lhs == null || rhs == null {
        return;
    }
    var var_name: &byte = null;
    if op == TokenType.TOKEN_GREATER_EQUAL && rhs.type == ASTNodeType.AST_NUMBER &&
        rhs.number_value == 0 && lhs.type == ASTNodeType.AST_IDENTIFIER {
        var_name = lhs.identifier_name;                     // v >= 0
    } else if op == TokenType.TOKEN_LESS_EQUAL && lhs.type == ASTNodeType.AST_NUMBER &&
        lhs.number_value == 0 && rhs.type == ASTNodeType.AST_IDENTIFIER {
        var_name = rhs.identifier_name;                     // 0 <= v
    } else if op == TokenType.TOKEN_GREATER && rhs.type == ASTNodeType.AST_UNARY_EXPR &&
        rhs.unary_expr_op as TokenType == TokenType.TOKEN_MINUS &&
        rhs.unary_expr_operand != null && rhs.unary_expr_operand.type == ASTNodeType.AST_NUMBER &&
        rhs.unary_expr_operand.number_value == 1 && lhs.type == ASTNodeType.AST_IDENTIFIER {
        var_name = lhs.identifier_name;                     // v > -1
    }
    if var_name == null {
        return;
    }
    const sym: &Symbol = symbol_table_lookup(checker, var_name);
    if sym == null || sym.post_index_upper <= 0 {
        return;
    }
    constraint_add(checker, var_name, CONSTRAINT_LT, sym.post_index_upper);
}

// ===== B5：非逃逸形参 → 移动解锁 =====
//
// 现行规则（`has_active_pointer_to`）是「有指针指向我 → 不许移动」：只要作用域里
// 还留着 `const p: &S = &a;`，后面 `const b: S = a;` 就一律被挡。B5 把它收紧到
// 真正会悬垂的形态 —— **指针 p 不阻止移动，当且仅当 p 的每一次使用都满足**：
//
//   ① 形态是「作为实参传给某个函数的**非逃逸形参**」，即被调方既没把该形参存进
//      字段/元素/全局，也没把它 return 出去、没再传给别的调用；
//   ② 位置在移动点之前。
//
// 健全性：①保证调用返回后被调方不可能持有 p；②保证移动之后本函数不再碰 p。
// 两条缺一不可，所以只要 p 有一次别的用法（解引用、赋值、比较、传给会逃逸的形参），
// 或者 p **根本没有任何用法**（证不出它已经死了），都维持原来的拒绝。
// 后一条正是 `tests/error_move_active_pointer.uya` 仍然报错的原因。

/// 判定节点类型是否为「不含子表达式」的叶子形态。
/// 参数：t - AST 节点类型。
/// 返回：1 表示是叶子（遍历时可以安全忽略）；0 表示可能含子表达式。
fn lifetime_node_is_leaf_type(t: ASTNodeType) i32 {
    if t == ASTNodeType.AST_NUMBER || t == ASTNodeType.AST_FLOAT ||
       t == ASTNodeType.AST_BOOL || t == ASTNodeType.AST_STRING ||
       t == ASTNodeType.AST_CHAR || t == ASTNodeType.AST_INT_LIMIT ||
       t == ASTNodeType.AST_IDENTIFIER || t == ASTNodeType.AST_UNDERSCORE ||
       t == ASTNodeType.AST_ERROR_VALUE ||
       t == ASTNodeType.AST_SRC_NAME || t == ASTNodeType.AST_SRC_PATH ||
       t == ASTNodeType.AST_SRC_LINE || t == ASTNodeType.AST_SRC_COL ||
       t == ASTNodeType.AST_FUNC_NAME ||
       t == ASTNodeType.AST_EMBED || t == ASTNodeType.AST_EMBED_DIR ||
       t == ASTNodeType.AST_PARAMS || t == ASTNodeType.AST_ASM_TARGET {
        return 1;
    }
    return 0;
}

/// B5 逃逸摘要的「污点」集合：从形参派生出来、但地址仍指向调用方存储的局部名。
///
/// 只看标识符本体是不够的：`const q = p[0:2];` / `const q = &p[0];` / `const q = p;`
/// 把同一段地址搬进了局部别名，后续 `return q` / `sink(q)` 一样会把指针交出去；
/// 反过来，q 只在函数内被读（`q[0]`、`q[1].id`）就不该算逃逸。所以逃生点收敛到
/// return / 赋值 / 传参三处，别名搬运本身不算，能被追到的别名进这个集合。
///
/// 集合满了**不能静默丢弃**：少记一个别名就少判一次逃逸，换来的是不健全的解锁。
/// 因此记一个溢出标志，调用方见到就退回「会逃逸」。
const LIFETIME_TAINT_MAX: i32 = 32;
var g_lifetime_taint_names: [&byte: LIFETIME_TAINT_MAX] = [];
var g_lifetime_taint_count: i32 = 0;
var g_lifetime_taint_overflow: i32 = 0;

/// 清空污点集合（每次判定一个形参前调用）。
/// 参数：无。
/// 返回：无。
fn lifetime_taint_reset() void {
    g_lifetime_taint_count = 0;
    g_lifetime_taint_overflow = 0;
}

/// 判定名字是否已在污点集合里。
/// 参数：name - 待判定名（可为 null）。
/// 返回：1 表示在集合里；0 表示不在。
fn lifetime_taint_contains(name: &byte) i32 {
    if name == null {
        return 0;
    }
    var i: i32 = 0;
    while i < g_lifetime_taint_count {
        const t: &byte = g_lifetime_taint_names[i];
        if t != null && str_equals(t, name) != 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 把一个局部名加进污点集合（去重；满了置溢出标志）。
/// 参数：name - 待加入的局部名（可为 null）。
/// 返回：无。
fn lifetime_taint_add(name: &byte) void {
    if name == null || name[0] == 0 {
        return;
    }
    if lifetime_taint_contains(name) != 0 {
        return;
    }
    // 下标先落到局部再判界：数组索引安全证明在全局可变计数上拿不到约束，写成
    // 「只读一次 + 早返回」的形态它才认。
    const idx: i32 = g_lifetime_taint_count;
    if idx < 0 {
        g_lifetime_taint_overflow = 1;
        return;
    }
    if idx >= LIFETIME_TAINT_MAX {
        g_lifetime_taint_overflow = 1;
        return;
    }
    g_lifetime_taint_names[idx] = name;
    g_lifetime_taint_count = idx + 1;
}

/// 判定表达式是否「地址不变地」派生自某个污点名 —— 即拿到的是**同一段存储**。
///
/// 认这几种：标识符本身、cast（`p as *void`）、取址（`&p[0]`、`&p[0].id`）、
/// 切片（`p[0:2]`）。`p[i]` / `p.f` 取的是被指向的**值**，不在此列（那属于
/// 深度派生，见 `lifetime_expr_derives_from_taint`）。
/// 参数：expr - 待判定表达式；depth - 剩余深度（用尽按「派生」处理，保守）。
/// 返回：1 表示是；0 表示不是。
fn lifetime_expr_weak_derives_from_taint(expr: &ASTNode, depth: i32) i32 {
    if expr == null {
        return 0;
    }
    if depth <= 0 {
        return 1;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        return lifetime_taint_contains(expr.identifier_name);
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        return lifetime_expr_weak_derives_from_taint(expr.cast_expr_expr, depth -| 1);
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        if (expr.unary_expr_op as TokenType) == TokenType.TOKEN_AMPERSAND {
            return lifetime_expr_weak_derives_from_taint(expr.unary_expr_operand, depth -| 1);
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        return lifetime_expr_weak_derives_from_taint(expr.slice_expr_base, depth -| 1);
    }
    return 0;
}

/// 判定表达式是否**沿着访问链**派生自某个污点名（`p[0]`、`p.f`、`q[2].id`…）。
/// 参数：expr - 待判定表达式；depth - 剩余深度（用尽按「派生」处理，保守）。
/// 返回：1 表示派生自它（或深度用尽无法判定）；0 表示与它无关。
fn lifetime_expr_derives_from_taint(expr: &ASTNode, depth: i32) i32 {
    if expr == null {
        return 0;
    }
    if depth <= 0 {
        return 1;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        return lifetime_taint_contains(expr.identifier_name);
    }
    if expr.type == ASTNodeType.AST_ARRAY_ACCESS {
        return lifetime_expr_derives_from_taint(expr.array_access_array, depth -| 1);
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        return lifetime_expr_derives_from_taint(expr.member_access_object, depth -| 1);
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        return lifetime_expr_derives_from_taint(expr.cast_expr_expr, depth -| 1);
    }
    if expr.type == ASTNodeType.AST_SLICE_EXPR {
        return lifetime_expr_derives_from_taint(expr.slice_expr_base, depth -| 1);
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        return lifetime_expr_derives_from_taint(expr.unary_expr_operand, depth -| 1);
    }
    return 0;
}

/// 判定表达式是否「就是 `name` 这个值」（标识符本身，或被 cast 包一层的它）。
/// 参数：expr - 待判定表达式；name - 变量名。
/// 返回：1 表示是；0 表示不是。
fn lifetime_expr_is_name_value(expr: &ASTNode, name: &byte) i32 {
    if expr == null || name == null {
        return 0;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        if expr.identifier_name != null && str_equals(expr.identifier_name, name) != 0 {
            return 1;
        }
        return 0;
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        return lifetime_expr_is_name_value(expr.cast_expr_expr, name);
    }
    return 0;
}

/// 扫函数体，判定形参 `name` 是否可能逃逸（存进字段/元素、return 出去、再传给调用）。
/// 参数：checker - 类型检查器；node - 当前子树；name - 形参名；escapes - 累积标志。
/// 返回：无。
///
/// 只看「值本身」的逃逸：`return p[0].id` 返回的是字段不是指针，`g(p[0].id)` 传的
/// 也是字段，这两种都不算逃逸（只有 `return p` / `g(p)` 这类传递指针本体才算）。
fn lifetime_scan_param_escape(checker: &TypeChecker, node: &ASTNode, name: &byte,
                              escapes: &i32) void {
    if node == null || name == null || escapes[0] != 0 {
        return;
    }
    if node.type == ASTNodeType.AST_FN_DECL {
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        // 返回「同一段存储」才算逃逸：`return p`、`return &p[0]`、`return p[0:2]`，
        // 以及 `const q = p[0:2]; return q;` 里的 q。`return p[0].id` 返回的是字段
        // 值，不是指针，放行。
        if lifetime_expr_weak_derives_from_taint(node.return_stmt_expr, 4) != 0 {
            escapes[0] = 1;
            return;
        }
        lifetime_scan_param_escape(checker, node.return_stmt_expr, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        // 赋给谁都得按逃逸算：全局、结构体字段、切片元素、`*q` 指向的存储都可能活过
        // 本次调用。局部别名（`const q = ...`）走 AST_VAR_DECL 的污点传播，不走这里。
        if lifetime_expr_weak_derives_from_taint(node.assign_src, 4) != 0 {
            escapes[0] = 1;
            return;
        }
        lifetime_scan_param_escape(checker, node.assign_dest, name, escapes);
        lifetime_scan_param_escape(checker, node.assign_src, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        // 把指针本体当实参传出去就算逃逸：被调方可能把它存起来。
        var ci: i32 = 0;
        while ci < node.call_expr_arg_count {
            const arg: &ASTNode = node.call_expr_args[ci];
            // 传出去的若是「同一段存储」（含 `&p[0]`、`p[0:2]`、局部别名），被调方
            // 可能把它存起来 —— 除非那个位置的形参本身是非逃逸形参（见
            // lifetime_scan_pointer_uses 的对应判据）。
            if lifetime_expr_weak_derives_from_taint(arg, 4) != 0 {
                escapes[0] = 1;
                return;
            }
            lifetime_scan_param_escape(checker, arg, name, escapes);
            ci = ci + 1;
        }
        return;
    }
    lifetime_scan_param_escape_children(checker, node, name, escapes);
}

/// `lifetime_scan_param_escape` 的子节点展开（容器类节点逐类下钻）。
/// 参数：checker - 类型检查器；node - 当前子树；name - 形参名；escapes - 累积标志。
/// 返回：无。
fn lifetime_scan_param_escape_children(checker: &TypeChecker, node: &ASTNode, name: &byte,
                                       escapes: &i32) void {
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            lifetime_scan_param_escape(checker, node.block_stmts[i], name, escapes);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_scan_param_escape(checker, node.if_stmt_condition, name, escapes);
        lifetime_scan_param_escape(checker, node.if_stmt_then_branch, name, escapes);
        lifetime_scan_param_escape(checker, node.if_stmt_else_branch, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        lifetime_scan_param_escape(checker, node.while_stmt_condition, name, escapes);
        lifetime_scan_param_escape(checker, node.while_stmt_body, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        lifetime_scan_param_escape(checker, node.for_stmt_array, name, escapes);
        lifetime_scan_param_escape(checker, node.for_stmt_range_start, name, escapes);
        lifetime_scan_param_escape(checker, node.for_stmt_range_end, name, escapes);
        lifetime_scan_param_escape(checker, node.for_stmt_body, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        lifetime_scan_param_escape(checker, node.defer_stmt_body, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        lifetime_scan_param_escape(checker, node.errdefer_stmt_body, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_TEST_STMT {
        lifetime_scan_param_escape(checker, node.test_stmt_body, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        // `const q = p;` / `const q = p[0:2];` / `const q = &p[0];` 只是把同一段地址
        // 搬进局部别名，本身不逃逸 —— 把 q 记进污点集合，后面 q 被 return / 赋值 /
        // 传参时才判逃逸。取不到地址的派生（`const v = p[0].id`）仍按逃逸处理：
        // 无法区分「加载出来的是指针」还是字段值，宁严勿松。
        if lifetime_expr_weak_derives_from_taint(node.var_decl_init, 4) != 0 {
            lifetime_taint_add(node.var_decl_name);
            return;
        }
        if lifetime_expr_derives_from_taint(node.var_decl_init, 4) != 0 {
            escapes[0] = 1;
            return;
        }
        lifetime_scan_param_escape(checker, node.var_decl_init, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        lifetime_scan_param_escape(checker, node.binary_expr_left, name, escapes);
        lifetime_scan_param_escape(checker, node.binary_expr_right, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR {
        // `&p[0]` / `*p` 本身不逃逸：地址留着继续追，真正的逃生点是它后面被
        // return / 赋值 / 传参（那时 weak_derives 会认出来）。
        return;
        lifetime_scan_param_escape(checker, node.unary_expr_operand, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        lifetime_scan_param_escape(checker, node.member_access_object, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        lifetime_scan_param_escape(checker, node.array_access_array, name, escapes);
        lifetime_scan_param_escape(checker, node.array_access_index, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_SLICE_EXPR {
        // `p[0:2]` 只是把同一段地址换个视图，不逃逸；外传时由上层逃生点判定。
        return;
    }
    if node.type == ASTNodeType.AST_TRY_EXPR {
        lifetime_scan_param_escape(checker, node.try_expr_operand, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_PIPELINE_EXPR {
        lifetime_scan_param_escape(checker, node.pipeline_expr_left, name, escapes);
        lifetime_scan_param_escape(checker, node.pipeline_expr_right, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_STRUCT_INIT {
        var i: i32 = 0;
        while i < node.struct_init_field_count {
            lifetime_scan_param_escape(checker, node.struct_init_field_values[i], name, escapes);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_LITERAL {
        var i: i32 = 0;
        while i < node.array_literal_element_count {
            lifetime_scan_param_escape(checker, node.array_literal_elements[i], name, escapes);
            i = i + 1;
        }
        lifetime_scan_param_escape(checker, node.array_literal_repeat_count_expr, name, escapes);
        return;
    }
    if node.type == ASTNodeType.AST_TUPLE_LITERAL {
        var i: i32 = 0;
        while i < node.tuple_literal_element_count {
            lifetime_scan_param_escape(checker, node.tuple_literal_elements[i], name, escapes);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_STRING_INTERP {
        var i: i32 = 0;
        while i < node.string_interp_segment_count {
            lifetime_scan_param_escape(checker, node.string_interp_segments[i].expr, name, escapes);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_PRINT || node.type == ASTNodeType.AST_PRINTLN {
        lifetime_scan_param_escape(checker, node.print_expr, name, escapes);
        return;
    }
    // 剩下的形态要么是叶子，要么是这里没逐个展开的容器（match / catch / await /
    // @syscall / 宏求值…）。认不出来就按**逃逸**处理：这条判定的用途是放宽移动
    // 规则，漏判会换来不健全，宁可把这类被调方判成会逃逸。
    if lifetime_node_is_leaf_type(node.type) == 0 {
        escapes[0] = 1;
    }
}

/// 判定 `fn_decl` 的第 `param_index` 个形参是否**可能逃逸**。
/// 参数：checker - 类型检查器；fn_decl - 被调方函数声明；param_index - 形参下标（0 基）。
/// 返回：1 可能逃逸（含无法判定）；0 可证明不逃逸。
///
/// 看不到函数体（extern / 接口声明）、形参形态认不出、下标越界，一律按**逃逸**处理 ——
/// 这条判定是用来放宽移动规则的，宁严勿松。
fn lifetime_fn_param_escapes(checker: &TypeChecker, fn_decl: &ASTNode, param_index: i32) i32 {
    if checker == null || fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL {
        return 1;
    }
    if param_index < 0 || param_index >= fn_decl.fn_decl_param_count {
        return 1;
    }
    if fn_decl.fn_decl_body == null {
        return 1;
    }
    const param: &ASTNode = fn_decl.fn_decl_params[param_index];
    if param == null || param.type != ASTNodeType.AST_VAR_DECL || param.var_decl_name == null {
        return 1;
    }
    var escapes: i32 = 0;
    // 形参自己先入污点集合，随后扫函数体：遇到 `const q = p[0:2]` 这类别名搬运就
    // 把 q 也加进去，遇到 return / 赋值 / 传参才判逃逸（见各逃生点的说明）。
    lifetime_taint_reset();
    lifetime_taint_add(param.var_decl_name);
    lifetime_scan_param_escape(checker, fn_decl.fn_decl_body, param.var_decl_name, &escapes);
    // 污点集合满了：少记了别名，逃逸可能被漏判 —— 直接退回「会逃逸」。
    if g_lifetime_taint_overflow != 0 {
        escapes = 1;
    }
    lifetime_taint_reset();
    if escapes != 0 {
        return 1;
    }
    return 0;
}

/// 判定某个调用实参位置上的形参是否为「非逃逸形参」。
/// 参数：checker - 类型检查器；call - 调用表达式；arg_index - 实参下标。
/// 返回：1 表示非逃逸（引用的存储不会被被调方留下）；0 表示可能逃逸或无法判定。
fn lifetime_call_param_is_non_escape(checker: &TypeChecker, call: &ASTNode, arg_index: i32) i32 {
    if checker == null || call == null || call.type != ASTNodeType.AST_CALL_EXPR {
        return 0;
    }
    const callee: &ASTNode = call.call_expr_callee;
    if callee == null || callee.type != ASTNodeType.AST_IDENTIFIER || callee.identifier_name == null {
        return 0;
    }
    const sig: &FunctionSignature = function_table_lookup(checker, callee.identifier_name);
    if sig == null || sig.decl_node == null {
        return 0;
    }
    if lifetime_fn_param_escapes(checker, sig.decl_node, arg_index) != 0 {
        return 0;
    }
    return 1;
}

/// 判断节点 `a` 是否在源码位置上早于 `b`。
/// 参数：a - 待判定节点；b - 参照节点。
/// 返回：1 表示 a 在前；0 表示不在前或无法判定。
fn lifetime_pos_before(a: &ASTNode, b: &ASTNode) i32 {
    if a == null || b == null {
        return 0;
    }
    if a.line < b.line {
        return 1;
    }
    if a.line > b.line {
        return 0;
    }
    if a.column < b.column {
        return 1;
    }
    return 0;
}

/// 扫函数体，收集指针 `name` 的全部使用形态，判定它是否「已经死了」。
/// 参数：checker - 类型检查器；node - 当前子树；name - 指针名；move_node - 移动点；
///       seen - 已见使用计数；dead - 累积标志（1 表示所有已见使用都合法）。
/// 返回：无。
///
/// 合法使用 = 作为实参传给非逃逸形参，且位置早于移动点；其余一切（解引用、
/// 赋值、比较、再取址、传给会逃逸的形参、以及移动点之后的使用）都会把 dead 清零。
fn lifetime_scan_pointer_uses(checker: &TypeChecker, node: &ASTNode, name: &byte,
                              move_node: &ASTNode, seen: &i32, dead: &i32) void {
    if node == null || name == null || dead[0] == 0 {
        return;
    }
    if node.type == ASTNodeType.AST_FN_DECL {
        return;
    }
    if node.type == ASTNodeType.AST_IDENTIFIER {
        if node.identifier_name != null && str_equals(node.identifier_name, name) != 0 {
            seen[0] = seen[0] +| 1;
            dead[0] = 0;    // 不是「非逃逸形参实参」的位置 → 该指针仍然活跃
        }
        return;
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        var ci: i32 = 0;
        while ci < node.call_expr_arg_count {
            const arg: &ASTNode = node.call_expr_args[ci];
            if lifetime_expr_is_name_value(arg, name) != 0 {
                seen[0] = seen[0] +| 1;
                if lifetime_call_param_is_non_escape(checker, node, ci) == 0 ||
                    lifetime_pos_before(node, move_node) == 0 {
                    dead[0] = 0;
                    return;
                }
            } else {
                lifetime_scan_pointer_uses(checker, arg, name, move_node, seen, dead);
            }
            ci = ci + 1;
        }
        return;
    }
    lifetime_scan_pointer_use_children(checker, node, name, move_node, seen, dead);
}

/// `lifetime_scan_pointer_uses` 的子节点展开（容器类节点逐类下钻）。
/// 参数：checker - 类型检查器；node - 当前子树；name - 指针名；move_node - 移动点；
///       seen - 已见使用计数；dead - 累积标志。
/// 返回：无。
fn lifetime_scan_pointer_use_children(checker: &TypeChecker, node: &ASTNode, name: &byte,
                                      move_node: &ASTNode, seen: &i32, dead: &i32) void {
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            lifetime_scan_pointer_uses(checker, node.block_stmts[i], name, move_node, seen, dead);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_scan_pointer_uses(checker, node.if_stmt_condition, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.if_stmt_then_branch, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.if_stmt_else_branch, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        lifetime_scan_pointer_uses(checker, node.while_stmt_condition, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.while_stmt_body, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        lifetime_scan_pointer_uses(checker, node.for_stmt_array, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.for_stmt_range_start, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.for_stmt_range_end, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.for_stmt_body, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        lifetime_scan_pointer_uses(checker, node.defer_stmt_body, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        lifetime_scan_pointer_uses(checker, node.errdefer_stmt_body, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_TEST_STMT {
        lifetime_scan_pointer_uses(checker, node.test_stmt_body, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        // 声明名不是「使用」：`const p: &S = &a;` 里的 p 只是绑定，初始化式里
        // 出现的是被取址的变量（a），不是 p 本身。
        lifetime_scan_pointer_uses(checker, node.var_decl_init, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        lifetime_scan_pointer_uses(checker, node.assign_dest, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.assign_src, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        lifetime_scan_pointer_uses(checker, node.return_stmt_expr, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        lifetime_scan_pointer_uses(checker, node.binary_expr_left, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.binary_expr_right, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR {
        lifetime_scan_pointer_uses(checker, node.unary_expr_operand, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        lifetime_scan_pointer_uses(checker, node.member_access_object, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        lifetime_scan_pointer_uses(checker, node.array_access_array, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.array_access_index, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_SLICE_EXPR {
        lifetime_scan_pointer_uses(checker, node.slice_expr_base, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_TRY_EXPR {
        lifetime_scan_pointer_uses(checker, node.try_expr_operand, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_PIPELINE_EXPR {
        lifetime_scan_pointer_uses(checker, node.pipeline_expr_left, name, move_node, seen, dead);
        lifetime_scan_pointer_uses(checker, node.pipeline_expr_right, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_STRUCT_INIT {
        var i: i32 = 0;
        while i < node.struct_init_field_count {
            lifetime_scan_pointer_uses(checker, node.struct_init_field_values[i], name, move_node, seen, dead);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_LITERAL {
        var i: i32 = 0;
        while i < node.array_literal_element_count {
            lifetime_scan_pointer_uses(checker, node.array_literal_elements[i], name, move_node, seen, dead);
            i = i + 1;
        }
        lifetime_scan_pointer_uses(checker, node.array_literal_repeat_count_expr, name, move_node, seen, dead);
        return;
    }
    if node.type == ASTNodeType.AST_TUPLE_LITERAL {
        var i: i32 = 0;
        while i < node.tuple_literal_element_count {
            lifetime_scan_pointer_uses(checker, node.tuple_literal_elements[i], name, move_node, seen, dead);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_STRING_INTERP {
        var i: i32 = 0;
        while i < node.string_interp_segment_count {
            lifetime_scan_pointer_uses(checker, node.string_interp_segments[i].expr, name, move_node, seen, dead);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_PRINT || node.type == ASTNodeType.AST_PRINTLN {
        lifetime_scan_pointer_uses(checker, node.print_expr, name, move_node, seen, dead);
        return;
    }
    // 同 lifetime_scan_param_escape_children：认不出来的容器形态一律按「指针仍活跃」
    // 处理，避免漏看一次使用就错误放行移动。
    if lifetime_node_is_leaf_type(node.type) == 0 {
        dead[0] = 0;
    }
}

/// 判定指针变量 `ptr_name` 在移动点 `move_node` 处是否已经「死了」。
/// 参数：checker - 类型检查器；ptr_name - 指针变量名；move_node - 移动发生的节点。
/// 返回：1 表示可证明已死（移动不会让它悬垂）；0 表示仍然活跃或证不出来。
///
/// 判据：至少有一次使用，且全部是「实参 → 非逃逸形参」且都早于移动点。
/// 「一次使用都没有」返回 0 —— 那种情况说不出指针死没死，维持原拒绝。
fn lifetime_pointer_is_dead(checker: &TypeChecker, ptr_name: &byte, move_node: &ASTNode) i32 {
    if checker == null || ptr_name == null || move_node == null {
        return 0;
    }
    const fn_decl: &ASTNode = checker.current_function_decl;
    if fn_decl == null || fn_decl.type != ASTNodeType.AST_FN_DECL || fn_decl.fn_decl_body == null {
        return 0;
    }
    var seen: i32 = 0;
    var dead: i32 = 1;
    lifetime_scan_pointer_uses(checker, fn_decl.fn_decl_body, ptr_name, move_node, &seen, &dead);
    if dead == 0 || seen == 0 {
        return 0;
    }
    return 1;
}

// ===== 逃逸口登记（--lifetime-report 的 escapes 段）=====
//
// 主线是「不安全之处必须显式」：先让编译器把自己眼里所有**能绕过证明**的构造
// 按类别数出来，再把这份统计冻成可 diff 的基线（见 docs/unsafe_audit_plan.md）。
// 这一段只做**统计**，绝不产生任何编译错误 —— 与 P0 度量报告同一取向。
//
// 为什么必须分开数而不能合并成一个数字：每一类的审计成本与风险面完全不同。
// `extern` 是信任边界（528 条声明，编译器不看实现）；`@asm` 是机器码（无法证明）；
// `union` 是类型系统不跟踪活跃变体的共享存储；指针↔整数 cast 是唯一能凭空造出
// 任意地址的通道；`malloc/free` 是所有权面。把它们混成一个「不安全行数」既不能
// 定位也不能冻结。

/// 判断表达式是否是「指向分配器的调用」，是则累加所有权逃逸口计数。
/// 参数：checker - 类型检查器；expr - 待判定的表达式节点。
/// 返回：无。
///
/// 认的是**裸调用形态**：callee 是标识符且名字在 ALLOC 名单里。
/// 方法调用（`x.free()`）与别名（`const f: fn(...) = free; f(p)`）不在此列 ——
/// 前者在 Uya 里不是分配器的惯用写法，后者需要函数指针指向传播（未实现）。
/// 宁可少数也不要在解析不确定的地方造出假的「安全」结论。
fn lifetime_account_alloc_call(checker: &TypeChecker, expr: &ASTNode) void {
    if checker == null || expr == null || expr.type != ASTNodeType.AST_CALL_EXPR {
        return;
    }
    const callee: &ASTNode = expr.call_expr_callee;
    if callee == null || callee.type != ASTNodeType.AST_IDENTIFIER || callee.identifier_name == null {
        return;
    }
    if lifetime_name_is_allocator(callee.identifier_name) != 0 {
        checker.lifetime_escape_alloc = checker.lifetime_escape_alloc +| 1;
        lifetime_escape_site(checker, "alloc" as &byte, expr);
    }
}

/// 打印一条逃逸口明细（只在 `--escape-list` 时生效）。
/// 参数：checker - 类型检查器；kind - 类别名（extern_fn / extern_var / asm / union /
///       extern_union / ptr_int / alloc）；node - 该逃逸口所在的 AST 节点。
/// 返回：无。
///
/// 输出格式固定为 `[escape] <kind> <file>:<line>`：
///   - **不带列号**：列号在同一次编辑里最容易漂移，白名单按「类别 + 文件」聚合，
///     带列号只会制造噪音；
///   - **按 AST 声明顺序**：同一输入两次运行的顺序一致，满足 §3 的 diff = 0 判据；
///   - 文件名缺失时打 `?`，不要打 null —— 让下游脚本能按固定字段切分。
fn lifetime_escape_site(checker: &TypeChecker, kind: &byte, node: &ASTNode) void {
    if checker == null || checker.escape_list == 0 || node == null {
        return;
    }
    const file: &byte = node.filename;
    if file == null {
        fprintf(libc.stderr, "[escape] %s ?:%d\n" as *byte, kind, node.line);
        return;
    }
    fprintf(libc.stderr, "[escape] %s %s:%d\n" as *byte, kind, file, node.line);
}

/// 判断一个名字是否是已知分配器入口。
/// 参数：name - 函数名。
/// 返回：1 表示是 malloc / free / calloc / realloc 之一，0 表示不是。
fn lifetime_name_is_allocator(name: &byte) i32 {
    if name == null {
        return 0;
    }
    if str_equals(name, "malloc" as &byte) != 0 { return 1; }
    if str_equals(name, "free" as &byte) != 0 { return 1; }
    if str_equals(name, "calloc" as &byte) != 0 { return 1; }
    if str_equals(name, "realloc" as &byte) != 0 { return 1; }
    return 0;
}

/// 判断一个表达式是否是「指针/整数形态类型」。
/// 参数：expr - 待判定的表达式节点。
/// 返回：1 表示是 `&T` / `usize` / `isize` 类型节点，0 表示不是。
///
/// 只用于**源表达式是语法可见的类型节点**的情形（cast 的源是表达式，语法上常认不出来），
/// 因此这个判据在源侧多半返回 0 —— 见 lifetime_cast_is_ptr_int_bridge 的取舍说明。
fn lifetime_expr_is_ptr_or_int_type(expr: &ASTNode) i32 {
    if expr == null {
        return 0;
    }
    if expr.type == ASTNodeType.AST_TYPE_POINTER {
        return 1;
    }
    if expr.type == ASTNodeType.AST_TYPE_NAMED && expr.type_named_name != null {
        if str_equals(expr.type_named_name, "usize" as &byte) != 0 { return 1; }
        if str_equals(expr.type_named_name, "isize" as &byte) != 0 { return 1; }
    }
    return 0;
}

/// 判断一次 cast 是否是「指针 ↔ 指针 / 指针 → 整数」这类能绕过类型系统的转换。
/// 参数：node - `AST_CAST_EXPR` 节点。
/// 返回：1 表示是指针有关的 cast，0 表示不是。
///
/// 判据刻意只看**两侧是否涉及指针**：
///   - 目标是指针 `as &T`：总是记一笔（源无论是 `&U`、整数还是 `&void`，都在换指代对象）；
///   - 目标是 `usize`/`isize` 且源语法上也是指针类型节点：记一笔（指针 → 整数）；
///   - 目标与源都是整数：**不记** —— `x as i64`、`n as usize` 这类宽化在 Uya 里遍地都是，
///     把它们算成逃逸口会把审计面放大成噪声（实测第一版把 37k 次整数宽化全算了进去）。
fn lifetime_cast_is_ptr_int_bridge(node: &ASTNode) i32 {
    if node == null || node.type != ASTNodeType.AST_CAST_EXPR {
        return 0;
    }
    const target: &ASTNode = node.cast_expr_target_type;
    if target == null {
        return 0;
    }
    if target.type == ASTNodeType.AST_TYPE_POINTER {
        return 1;
    }
    if target.type == ASTNodeType.AST_TYPE_NAMED && target.type_named_name != null {
        const is_size: i32 = str_equals(target.type_named_name, "usize" as &byte) |
            str_equals(target.type_named_name, "isize" as &byte);
        if is_size != 0 && lifetime_expr_is_ptr_or_int_type(node.cast_expr_expr) != 0 {
            return 1;
        }
    }
    return 0;
}

/// 递归登记子树里的单点逃逸口（@asm / @ptr_from_usize / @usize_from_ptr / 指针 cast）。
/// 参数：checker - 类型检查器；node - 当前节点。
/// 返回：无。
///
/// **不下钻**嵌套的 `AST_FN_DECL` 与 `AST_METHOD_BLOCK`：它们的 body 由各自
/// 的登记入口负责，下钻会把同一个 `@asm` 数两遍。
fn lifetime_account_escape_sites(checker: &TypeChecker, node: &ASTNode) void {
    if checker == null || node == null {
        return;
    }
    if node.type == ASTNodeType.AST_ASM {
        checker.lifetime_escape_asm = checker.lifetime_escape_asm +| 1;
        lifetime_escape_site(checker, "asm" as &byte, node);
        return;
    }
    if node.type == ASTNodeType.AST_PTR_FROM_USIZE || node.type == ASTNodeType.AST_USIZE_FROM_PTR {
        checker.lifetime_escape_ptr_int = checker.lifetime_escape_ptr_int +| 1;
        lifetime_escape_site(checker, "ptr_int" as &byte, node);
        return;
    }
    if node.type == ASTNodeType.AST_CAST_EXPR {
        if lifetime_cast_is_ptr_int_bridge(node) != 0 {
            checker.lifetime_escape_ptr_int = checker.lifetime_escape_ptr_int +| 1;
            lifetime_escape_site(checker, "ptr_int" as &byte, node);
        }
    }
    if node.type == ASTNodeType.AST_BLOCK && node.block_stmts != null {
        var i: i32 = 0;
        while i < node.block_stmt_count {
            lifetime_account_escape_sites(checker, node.block_stmts[i]);
            i = i + 1;
        }
        return;
    }
    // 其余形态：逐个展开**直接子节点**再递归。
    //
    // 这里刻意自己展开，不复用 lifetime_walk_child_nodes —— 那个函数是为「收集 return
    // origin」写的，它会回调 lifetime_collect_return_origins，而本函数一旦从那边
    // 兜底借道就会形成 A→B→A 的无限递归（实测：小文件直接挂住不返回，大文件
    // 先把栈打爆成 SIGSEGV）。登记器必须有自己的、只朝下走的展开逻辑。
    lifetime_account_escape_child_statements(checker, node);
}

/// 依次登记一个语句/表达式节点的直接子语句。
/// 参数：checker - 类型检查器；node - 当前节点。
/// 返回：无。
///
/// 只展开**语句位置**的子节点（块、if/else、while、for、defer/errdefer、test），
/// 这些位置覆盖了 `@asm` / `@ptr_from_usize` / 指针 cast 的绝大多数出现处。
/// 表达式深处的 cast 由 lifetime_account_escape_expr_children 补。
fn lifetime_account_escape_child_statements(checker: &TypeChecker, node: &ASTNode) void {
    if node.type == ASTNodeType.AST_IF_STMT {
        lifetime_account_escape_sites(checker, node.if_stmt_then_branch);
        lifetime_account_escape_sites(checker, node.if_stmt_else_branch);
        lifetime_account_escape_sites(checker, node.if_stmt_condition);
        return;
    }
    if node.type == ASTNodeType.AST_WHILE_STMT {
        lifetime_account_escape_sites(checker, node.while_stmt_condition);
        lifetime_account_escape_sites(checker, node.while_stmt_body);
        return;
    }
    if node.type == ASTNodeType.AST_FOR_STMT {
        lifetime_account_escape_sites(checker, node.for_stmt_body);
        lifetime_account_escape_sites(checker, node.for_stmt_array);
        lifetime_account_escape_sites(checker, node.for_stmt_range_start);
        lifetime_account_escape_sites(checker, node.for_stmt_range_end);
        return;
    }
    if node.type == ASTNodeType.AST_DEFER_STMT {
        lifetime_account_escape_sites(checker, node.defer_stmt_body);
        return;
    }
    if node.type == ASTNodeType.AST_ERRDEFER_STMT {
        lifetime_account_escape_sites(checker, node.errdefer_stmt_body);
        return;
    }
    if node.type == ASTNodeType.AST_TEST_STMT {
        lifetime_account_escape_sites(checker, node.test_stmt_body);
        return;
    }
    if node.type == ASTNodeType.AST_VAR_DECL {
        lifetime_account_escape_sites(checker, node.var_decl_init);
        return;
    }
    if node.type == ASTNodeType.AST_ASSIGN {
        lifetime_account_escape_sites(checker, node.assign_dest);
        lifetime_account_escape_sites(checker, node.assign_src);
        return;
    }
    if node.type == ASTNodeType.AST_RETURN_STMT {
        lifetime_account_escape_sites(checker, node.return_stmt_expr);
        return;
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        lifetime_account_alloc_call(checker, node);
    }
    lifetime_account_escape_expr_children(checker, node);
}

/// 依次登记一个表达式节点的直接子表达式（二元/一元/调用实参/成员/下标/cast 等）。
/// 参数：checker - 类型检查器；node - 当前节点。
/// 返回：无。
fn lifetime_account_escape_expr_children(checker: &TypeChecker, node: &ASTNode) void {
    if node.type == ASTNodeType.AST_BINARY_EXPR {
        lifetime_account_escape_sites(checker, node.binary_expr_left);
        lifetime_account_escape_sites(checker, node.binary_expr_right);
        return;
    }
    if node.type == ASTNodeType.AST_UNARY_EXPR {
        lifetime_account_escape_sites(checker, node.unary_expr_operand);
        return;
    }
    if node.type == ASTNodeType.AST_CAST_EXPR {
        lifetime_account_escape_sites(checker, node.cast_expr_expr);
        return;
    }
    if node.type == ASTNodeType.AST_CALL_EXPR {
        var i: i32 = 0;
        while i < node.call_expr_arg_count {
            lifetime_account_escape_sites(checker, node.call_expr_args[i]);
            i = i + 1;
        }
        return;
    }
    if node.type == ASTNodeType.AST_MEMBER_ACCESS {
        lifetime_account_escape_sites(checker, node.member_access_object);
        return;
    }
    if node.type == ASTNodeType.AST_ARRAY_ACCESS {
        lifetime_account_escape_sites(checker, node.array_access_array);
        lifetime_account_escape_sites(checker, node.array_access_index);
        return;
    }
    if node.type == ASTNodeType.AST_SLICE_EXPR {
        lifetime_account_escape_sites(checker, node.slice_expr_base);
        lifetime_account_escape_sites(checker, node.slice_expr_start_expr);
        lifetime_account_escape_sites(checker, node.slice_expr_len_expr);
        return;
    }
    // 其余表达式形态（标识符、字面量等）不含逃逸口，到此为止。
}

/// 登记一个函数声明带来的逃逸口。
/// 参数：checker - 类型检查器；node - `AST_FN_DECL` 节点。
/// 返回：无。
fn lifetime_account_fn_decl(checker: &TypeChecker, node: &ASTNode) void {
    if node == null || node.type != ASTNodeType.AST_FN_DECL {
        return;
    }
    if node.fn_decl_is_extern != 0 {
        checker.lifetime_escape_extern_fn = checker.lifetime_escape_extern_fn +| 1;
        lifetime_escape_site(checker, "extern_fn" as &byte, node);
        return;     // extern 没有函数体，没什么可扫
    }
    lifetime_account_escape_sites(checker, node.fn_decl_body);
}

/// 登记一个 union 声明。
/// 参数：checker - 类型检查器；node - `AST_UNION_DECL` 节点。
/// 返回：无。
fn lifetime_account_union_decl(checker: &TypeChecker, node: &ASTNode) void {
    checker.lifetime_escape_union = checker.lifetime_escape_union +| 1;
    if node.union_decl_is_extern != 0 {
        checker.lifetime_escape_extern_union = checker.lifetime_escape_extern_union +| 1;
        lifetime_escape_site(checker, "extern_union" as &byte, node);
    } else {
        lifetime_escape_site(checker, "union" as &byte, node);
    }
    if node.union_decl_variants != null {
        var i: i32 = 0;
        while i < node.union_decl_variant_count {
            lifetime_account_escape_sites(checker, node.union_decl_variants[i]);
            i = i + 1;
        }
    }
}

/// 登记一个顶层声明（及结构体/接口方法块）带来的逃逸口。
/// 参数：checker - 类型检查器；decl - 顶层声明节点。
/// 返回：无。
fn lifetime_account_top_decl(checker: &TypeChecker, decl: &ASTNode) void {
    if checker == null || decl == null {
        return;
    }
    if decl.type == ASTNodeType.AST_FN_DECL {
        lifetime_account_fn_decl(checker, decl);
        return;
    }
    if decl.type == ASTNodeType.AST_EXTERN_VAR_DECL {
        checker.lifetime_escape_extern_var = checker.lifetime_escape_extern_var +| 1;
        lifetime_escape_site(checker, "extern_var" as &byte, decl);
        return;
    }
    if decl.type == ASTNodeType.AST_UNION_DECL {
        lifetime_account_union_decl(checker, decl);
        return;
    }
    if decl.type == ASTNodeType.AST_STRUCT_DECL && decl.struct_decl_methods != null {
        var i: i32 = 0;
        while i < decl.struct_decl_method_count {
            lifetime_account_fn_decl(checker, decl.struct_decl_methods[i]);
            i = i + 1;
        }
        return;
    }
    if decl.type == ASTNodeType.AST_METHOD_BLOCK && decl.method_block_methods != null {
        var i: i32 = 0;
        while i < decl.method_block_method_count {
            lifetime_account_fn_decl(checker, decl.method_block_methods[i]);
            i = i + 1;
        }
        return;
    }
}

/// 登记整个程序里所有「能绕过证明」的构造（只在 --lifetime-report 时执行）。
/// 参数：checker - 类型检查器；program - `AST_PROGRAM` 根节点。
/// 返回：无。
///
/// 这是 escapes 段的唯一入口，由 checker_check_program_node 在全部声明检查完后调用一次。
/// 只读 AST、只累加计数，不改任何编译结果 —— 关掉 --lifetime-report 时整段是零成本。
fn lifetime_account_program_escapes(checker: &TypeChecker, program: &ASTNode) void {
    if checker == null || program == null || program.type != ASTNodeType.AST_PROGRAM {
        return;
    }
    if checker.lifetime_report == 0 {
        return;
    }
    if program.program_decls == null {
        return;
    }
    var i: i32 = 0;
    while i < program.program_decl_count {
        lifetime_account_top_decl(checker, program.program_decls[i]);
        i = i + 1;
    }
}
