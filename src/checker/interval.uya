// checker/interval.uya - 区间算术和约束系统
// 从 checker/main.uya 拆分

// ============================================
// 约束系统（路径敏感分析）
// ============================================

// 约束操作符常量
const CONSTRAINT_LT: i32 = 0;   // <
const CONSTRAINT_LE: i32 = 1;   // <=
const CONSTRAINT_GT: i32 = 2;   // >
const CONSTRAINT_GE: i32 = 3;   // >=
const CONSTRAINT_EQ: i32 = 4;   // ==
const CONSTRAINT_NE: i32 = 5;   // !=

// 指针非空状态管理

const CONSTRAINT_EXPR_NAME_MAX: i32 = 256;

// 与 checker.constraint_* 同下标的可信度标记（见 wide_constraint_* 说明）
var g_constraint_sound: [i32: 64] = [];


// 添加指针非空状态
// 参数：ptr_name - 指针变量名
fn pointer_nonnull_add(checker: &TypeChecker, ptr_name: &byte) void {
    if checker == null || ptr_name == null {
        return;
    }
    if checker.pointer_nonnull_count >= MAX_POINTER_NAMES {
        return;  // 已满
    }
    // 检查是否已存在
    var i: i32 = 0;
    const count: i32 = checker.pointer_nonnull_count;
    while i < count {
        if i < MAX_POINTER_NAMES {
            const name: &byte = checker.pointer_nonnull_names[i];
            if name != null && strcmp(name as *byte, ptr_name as *byte) == 0 {
                return;  // 已存在
            }
        }
        i = i + 1;
    }
    const idx: i32 = checker.pointer_nonnull_count;
    if idx >= 0 && idx < MAX_POINTER_NAMES {
        checker.pointer_nonnull_names[idx] = ptr_name;
        checker.pointer_nonnull_count = idx + 1;
    }
}

// 移除指针非空状态
// 参数：ptr_name - 指针变量名
fn pointer_nonnull_remove(checker: &TypeChecker, ptr_name: &byte) void {
    if checker == null || ptr_name == null {
        return;
    }
    var write_idx: i32 = 0;
    var i: i32 = 0;
    const count: i32 = checker.pointer_nonnull_count;
    while i < count {
        if i < MAX_POINTER_NAMES {
            const name: &byte = checker.pointer_nonnull_names[i];
            if name != null && strcmp(name as *byte, ptr_name as *byte) != 0 {
                if write_idx < MAX_POINTER_NAMES {
                    checker.pointer_nonnull_names[write_idx] = name;
                }
                write_idx = write_idx + 1;
            }
        }
        i = i + 1;
    }
    checker.pointer_nonnull_count = write_idx;
}

// 检查指针是否已知非空
// 参数：ptr_name - 指针变量名
// 返回：1 表示已知非空，0 表示未知
fn pointer_is_known_nonnull(checker: &TypeChecker, ptr_name: &byte) i32 {
    if checker == null || ptr_name == null {
        return 0;
    }
    var i: i32 = 0;
    const count: i32 = checker.pointer_nonnull_count;
    while i < count {
        if i < MAX_POINTER_NAMES {
            const name: &byte = checker.pointer_nonnull_names[i];
            if name != null && strcmp(name as *byte, ptr_name as *byte) == 0 {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// 清除所有指针非空状态
fn pointer_nonnull_clear(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    var i: i32 = 0;
    while i < MAX_POINTER_NAMES {
        checker.pointer_nonnull_names[i] = null;
        i = i + 1;
    }
    checker.pointer_nonnull_count = 0;
}

// 可能为空的指针管理

// 添加可能为空的指针
// 参数：ptr_name - 指针变量名
fn pointer_nullable_add(checker: &TypeChecker, ptr_name: &byte) void {
    if checker == null || ptr_name == null {
        return;
    }
    if checker.pointer_nullable_count >= MAX_POINTER_NAMES {
        return;  // 已满
    }
    // 检查是否已存在
    var i: i32 = 0;
    const count: i32 = checker.pointer_nullable_count;
    while i < count {
        if i < MAX_POINTER_NAMES {
            const name: &byte = checker.pointer_nullable_names[i];
            if name != null && strcmp(name as *byte, ptr_name as *byte) == 0 {
                return;  // 已存在
            }
        }
        i = i + 1;
    }
    const idx: i32 = checker.pointer_nullable_count;
    if idx >= 0 && idx < MAX_POINTER_NAMES {
        checker.pointer_nullable_names[idx] = ptr_name;
        checker.pointer_nullable_count = idx + 1;
    }
}

// 检查指针是否可能为空（被初始化为 null）
// 参数：ptr_name - 指针变量名
// 返回：1 表示可能为空，0 表示不可能为空
fn pointer_is_nullable(checker: &TypeChecker, ptr_name: &byte) i32 {
    if checker == null || ptr_name == null {
        return 0;
    }
    var i: i32 = 0;
    const count: i32 = checker.pointer_nullable_count;
    while i < count {
        if i < MAX_POINTER_NAMES {
            const name: &byte = checker.pointer_nullable_names[i];
            if name != null && strcmp(name as *byte, ptr_name as *byte) == 0 {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// 清除所有约束
fn constraint_clear(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count && i < MAX_CONSTRAINTS {
        checker.constraint_var_names[i] = null;
        checker.constraint_ops[i] = 0;
        checker.constraint_values[i] = 0;
        i = i + 1;
    }
    checker.constraint_count = 0;
}

// 添加约束
// 参数：var_name - 变量名，op - 操作符，value - 常量值
// ===== 约束可信度标记（溢出证明专用）=====
//
// constraint_* 表里不同来源的约束可信度不同：
//   - constraint_add：直接来自用户写的守卫（if i < 100 …）→ 可信，sound = 1
//   - constraint_update_for_increment：i = i + const 的位模式回绕更新 → 不可信
//   - constraint_replace_with_interval：来自 eval_expr_interval（内部用 u32 回绕）
//     → 不可信
// 越界证明沿用既有行为（全部采纳）；溢出证明只采纳 sound = 1 的约束，
// 否则会把「回绕后被收得更紧」的假区间当成真区间，把真实溢出判成安全。

fn wide_mark_constraint_unsound_at(idx: i32) void {
    if idx < 0 || idx >= @len(g_constraint_sound) {
        return;
    }
    g_constraint_sound[idx] = 0;
}

fn wide_mark_constraint_sound_at(idx: i32) void {
    if idx < 0 || idx >= @len(g_constraint_sound) {
        return;
    }
    g_constraint_sound[idx] = 1;
}

fn wide_move_constraint_sound(from_idx: i32, to_idx: i32) void {
    const v: i32 = wide_constraint_is_sound_at(from_idx);
    if to_idx < 0 || to_idx >= @len(g_constraint_sound) {
        return;
    }
    g_constraint_sound[to_idx] = v;
}

fn wide_constraint_is_sound_at(idx: i32) i32 {
    if idx < 0 || idx >= @len(g_constraint_sound) {
        return 0;
    }
    return g_constraint_sound[idx];
}

fn wide_constraint_sound_reset() void {
    var i: i32 = 0;
    while i < @len(g_constraint_sound) {
        g_constraint_sound[i] = 0;
        i = i + 1;
    }
}

// 把 src_name 的**可信**约束整组复制到 dest_name。
// 用于 `var dst: T = src;` 这种直接传递：dst 的取值域与 src 完全相同，
// 因此 src 上由用户守卫建立的可信约束可以原样继承（用于溢出证明）。
fn constraint_copy_sound_guards(checker: &TypeChecker, dest_name: &byte, src_name: &byte) void {
    if checker == null || dest_name == null || src_name == null {
        return;
    }
    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS && wide_constraint_is_sound_at(i) != 0 {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, src_name as *byte) == 0 {
                constraint_add(checker, dest_name, checker.constraint_ops[i], checker.constraint_values[i]);
            }
        }
        i = i + 1;
    }
}

// 清空约束表时一并清空可信度标记
fn constraint_sound_clear_all() void {
    wide_constraint_sound_reset();
}

fn constraint_add(checker: &TypeChecker, var_name: &byte, op: i32, value: i32) void {
    if checker == null || var_name == null {
        return;
    }
    if checker.constraint_count >= MAX_CONSTRAINTS {
        return;  // 约束集已满
    }
    const idx: i32 = checker.constraint_count;
    if idx >= 0 && idx < MAX_CONSTRAINTS {
        checker.constraint_var_names[idx] = var_name;
        checker.constraint_ops[idx] = op;
        checker.constraint_values[idx] = value;
        wide_mark_constraint_sound_at(idx);   // 用户守卫，可信
        checker.constraint_count = idx + 1;
    }
}

// 移除指定变量的所有约束
// 参数：var_name - 变量名
fn constraint_remove_var(checker: &TypeChecker, var_name: &byte) void {
    if checker == null || var_name == null {
        return;
    }
    var write_idx: i32 = 0;
    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) != 0 {
                // 保留不是该变量的约束
                if write_idx < MAX_CONSTRAINTS {
                    checker.constraint_var_names[write_idx] = name;
                    checker.constraint_ops[write_idx] = checker.constraint_ops[i];
                    checker.constraint_values[write_idx] = checker.constraint_values[i];
                    wide_move_constraint_sound(i, write_idx);
                }
                write_idx = write_idx + 1;
            }
        }
        i = i + 1;
    }
    checker.constraint_count = write_idx;
}

// 更新递增赋值后的约束
// 参数：var_name - 变量名，increment - 递增值
// 例如：i = i + 1 后，如果原来 i >= 0，新值也 >= 0
fn constraint_update_for_increment(checker: &TypeChecker, var_name: &byte, increment: i32) void {
    if checker == null || var_name == null {
        return;
    }
    // 对于 i = i + n（n > 0）：
    // 如果原来 i >= k，新值 i >= k + n
    // 如果原来 i >= 0 且 n >= 0，新值也 >= 0
    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) == 0 {
                const op: i32 = checker.constraint_ops[i];
                const val: i32 = checker.constraint_values[i];
                // 更新精确值/上下界约束。
                // 增量累加会贴到 i32 边界（实测 UBSan：2147483647 + 1），
                // 以 u32 回绕消除有符号溢出 UB；位模式与原语义一致。
                // 注意：回绕后的上界可能比真实值域更紧（unsound）——现有越界证明
                // 依赖这套位模式，故保持原样；溢出证明只采纳 constraint_sound 的约束。
                // 用饱和而不是回绕：回绕会让上界变成一个更小（甚至负）的值，
                // 把约束收得比真实值域更紧 —— 既 unsound（会把真实溢出判成安全），
                // 又会把「循环计数器 +1」证明卡死（`i < MAX` 回绕后变成 `i <= MIN`）。
                // 饱和只会把界放宽（`i <= MAX` 仍成立），对越界证明也是安全的走向。
                const val_inc: i32 = interval_saturate_i32((val as i64) + (increment as i64));
                if op == CONSTRAINT_EQ {
                    checker.constraint_values[i] = val_inc;
                } else if op == CONSTRAINT_GE {
                    checker.constraint_values[i] = val_inc;
                } else if op == CONSTRAINT_GT {
                    checker.constraint_values[i] = val_inc;
                } else if op == CONSTRAINT_LE {
                    checker.constraint_values[i] = val_inc;
                } else if op == CONSTRAINT_LT {
                    checker.constraint_ops[i] = CONSTRAINT_LE;
                    checker.constraint_values[i] = ((val_inc as u32) - 1u) as i32;
                }
            }
        }
        i = i + 1;
    }
}

fn constraint_expr_name(checker: &TypeChecker, expr: &ASTNode) &byte {
    if checker == null || expr == null {
        return null;
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        return expr.identifier_name;
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR && expr.cast_expr_expr != null {
        return constraint_expr_name(checker, expr.cast_expr_expr);
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        if expr.member_access_is_module_access != 0 || expr.member_access_field_name == null {
            return null;
        }
        const object_name: &byte = constraint_expr_name(checker, expr.member_access_object);
        if object_name == null {
            return null;
        }
        const object_len: i32 = strlen(object_name as *byte) as i32;
        const field_len: i32 = strlen(expr.member_access_field_name as *byte) as i32;
        if object_len <= 0 || field_len <= 0 || object_len + field_len + 2 > CONSTRAINT_EXPR_NAME_MAX {
            return null;
        }
        // 名称必须放在生命周期稳定的内存里：之前用栈上 buf 再交给
        // string_pool_intern，而后者对负哈希（`hash as i32 < 0`）会直接返回入参，
        // 于是约束表里存下的是已失效的栈指针，名字比较结果取决于栈内容被谁覆盖
        // （表现为同一段代码换个变量名就时好时坏）。这里改用 arena 分配。
        const buf: &byte = compiler_arena_alloc(checker.arena, CONSTRAINT_EXPR_NAME_MAX as usize) as &byte;
        if buf == null {
            return null;
        }
        const name_len: i32 = snprintf(buf, CONSTRAINT_EXPR_NAME_MAX, "%s.%s" as &byte,
            object_name as *byte, expr.member_access_field_name as *byte);
        if name_len <= 0 || name_len >= CONSTRAINT_EXPR_NAME_MAX {
            return null;
        }
        return checker_intern_strdup(checker, buf);
    }
    return null;
}

fn constraint_length_field_matches_array_field(length_name: &byte, array_name: &byte) i32 {
    if length_name == null || array_name == null {
        return 0;
    }
    if str_equals(length_name, "path_len" as &byte) != 0 && str_equals(array_name, "path" as &byte) != 0 {
        return 1;
    }
    if str_equals(length_name, "token_count" as &byte) != 0 && str_equals(array_name, "tokens" as &byte) != 0 {
        return 1;
    }

    const length_len: usize = strlen(length_name as *byte);
    const array_len: usize = strlen(array_name as *byte);
    if length_len == array_len + 4 &&
        strncmp(length_name as *byte, array_name as *byte, array_len) == 0 &&
        strcmp((length_name as *byte + array_len) as *byte, "_len" as *byte) == 0 {
        return 1;
    }
    if length_len == array_len + 6 &&
        strncmp(length_name as *byte, array_name as *byte, array_len) == 0 &&
        strcmp((length_name as *byte + array_len) as *byte, "_count" as *byte) == 0 {
        return 1;
    }
    return 0;
}

fn constraint_member_length_capacity(checker: &TypeChecker, expr: &ASTNode) i32 {
    if checker == null || expr == null || expr.type != ASTNodeType.AST_MEMBER_ACCESS ||
        expr.member_access_field_name == null || expr.member_access_object == null {
        return -1;
    }
    var object_type: Type = checker_infer_type(checker, expr.member_access_object);
    if object_type.kind == TypeKind.TYPE_POINTER && object_type.pointer_to != null {
        object_type = object_type.pointer_to[0];
    }
    if object_type.kind != TypeKind.TYPE_STRUCT || object_type.struct_name == null {
        return -1;
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(checker.program_node, object_type.struct_name);
    if struct_decl == null || struct_decl.struct_decl_fields == null {
        return -1;
    }
    var i: i32 = 0;
    while i < struct_decl.struct_decl_field_count {
        const field: &ASTNode = struct_decl.struct_decl_fields[i];
        if field != null && field.type == ASTNodeType.AST_VAR_DECL && field.var_decl_name != null {
            const field_type: Type = type_from_ast(checker, field.var_decl_type);
            if field_type.kind == TypeKind.TYPE_ARRAY &&
                constraint_length_field_matches_array_field(expr.member_access_field_name, field.var_decl_name) != 0 {
                return field_type.array_size;
            }
        }
        i = i + 1;
    }
    return -1;
}

fn constraint_struct_array_capacity(checker: &TypeChecker, struct_type: &Type, array_field_name: &byte) i32 {
    if checker == null || struct_type == null || array_field_name == null ||
        struct_type.kind != TypeKind.TYPE_STRUCT || struct_type.struct_name == null {
        return -1;
    }
    const struct_decl: &ASTNode = find_struct_decl_from_program(checker.program_node, struct_type.struct_name);
    if struct_decl == null || struct_decl.struct_decl_fields == null {
        return -1;
    }
    var i: i32 = 0;
    while i < struct_decl.struct_decl_field_count {
        const field: &ASTNode = struct_decl.struct_decl_fields[i];
        if field != null && field.type == ASTNodeType.AST_VAR_DECL && field.var_decl_name != null &&
            str_equals(field.var_decl_name, array_field_name) != 0 {
            const field_type: Type = type_from_ast(checker, field.var_decl_type);
            if field_type.kind == TypeKind.TYPE_ARRAY {
                return field_type.array_size;
            }
        }
        i = i + 1;
    }
    return -1;
}

fn constraint_call_returns_token_index_capacity(checker: &TypeChecker, expr: &ASTNode) i32 {
    if checker == null || expr == null || expr.type != ASTNodeType.AST_CALL_EXPR ||
        expr.call_expr_callee == null || expr.call_expr_args == null || expr.call_expr_arg_count <= 0 {
        return -1;
    }

    var callee_name: &byte = null;
    const callee: &ASTNode = expr.call_expr_callee;
    if callee.type == ASTNodeType.AST_IDENTIFIER {
        callee_name = callee.identifier_name;
    } else if callee.type == ASTNodeType.AST_MEMBER_ACCESS {
        callee_name = callee.member_access_field_name;
    }
    if callee_name == null {
        return -1;
    }

    var returns_token_index: i32 = 0;
    if strstr(callee_name as *byte, "find_matching_" as *byte) != null {
        returns_token_index = 1;
    } else if strstr(callee_name as *byte, "skip_balanced" as *byte) != null {
        returns_token_index = 1;
    } else if strstr(callee_name as *byte, "find_decl_body" as *byte) != null {
        returns_token_index = 1;
    } else if strstr(callee_name as *byte, "find_token_before_stop" as *byte) != null {
        returns_token_index = 1;
    }
    if returns_token_index == 0 {
        return -1;
    }

    var stream_expr: &ASTNode = expr.call_expr_args[0];
    if stream_expr != null && stream_expr.type == ASTNodeType.AST_UNARY_EXPR {
        const unary_op_tmp: !TokenType = stream_expr.unary_expr_op as! TokenType;
        const unary_op: TokenType = unary_op_tmp.value;
        if unary_op == TokenType.TOKEN_AMPERSAND {
            stream_expr = stream_expr.unary_expr_operand;
        }
    }
    if stream_expr == null {
        return -1;
    }

    var stream_type: Type = checker_infer_type(checker, stream_expr);
    if stream_type.kind == TypeKind.TYPE_POINTER && stream_type.pointer_to != null {
        stream_type = stream_type.pointer_to[0];
    }
    if stream_type.kind != TypeKind.TYPE_STRUCT {
        return -1;
    }
    return constraint_struct_array_capacity(checker, &stream_type, "tokens" as &byte);
}

// 从二元比较表达式提取约束
// 参数：expr - 二元表达式，is_positive - 是否取正条件
// 例如：i < 10 提取为 (i, LT, 10)
//       is_positive = false 时，i < 10 提取为 (i, GE, 10)
// 特殊处理：ptr == null / ptr != null 用于空指针检测
fn constraint_extract_from_binary(checker: &TypeChecker, expr: &ASTNode, is_positive: i32) void {
    if checker == null || expr == null {
        return;
    }
    if expr.type != ASTNodeType.AST_BINARY_EXPR {
        return;
    }

    const op_tmp: !TokenType = expr.binary_expr_op as! TokenType;
    const op: TokenType = op_tmp.value;
    // 操作符的 i32 快照：该函数的控制流会对 op 做多处/多次比较，
    // 而独立检查（单独 check 本文件）时枚举操作数在第二次读取即被判为「已被移动」。
    // 快照一次后所有比较都走 i32，规避该误报且语义等价。
    const op_code: i32 = op as i32;

    // 处理逻辑与（&&）：正条件下 A && B 同时成立
    if op_code == TokenType.TOKEN_LOGICAL_AND as i32 {
        if is_positive == 0 {
            return;
        }
        const left_expr: &ASTNode = expr.binary_expr_left;
        const right_expr: &ASTNode = expr.binary_expr_right;
        if left_expr != null {
            constraint_extract_from_binary(checker, left_expr, is_positive);
        }
        if right_expr != null {
            constraint_extract_from_binary(checker, right_expr, is_positive);
        }
        return;
    }

    // 处理逻辑或（||）：负条件下 !(A || B) 等价于 !A && !B
    if op_code == TokenType.TOKEN_LOGICAL_OR as i32 {
        if is_positive == 0 {
            const left_or_expr: &ASTNode = expr.binary_expr_left;
            const right_or_expr: &ASTNode = expr.binary_expr_right;
            if left_or_expr != null {
                constraint_extract_from_binary(checker, left_or_expr, 0);
            }
            if right_or_expr != null {
                constraint_extract_from_binary(checker, right_or_expr, 0);
            }
        }
        return;
    }

    // 只处理比较运算符
    if op_code != TokenType.TOKEN_EQUAL as i32 && op_code != TokenType.TOKEN_NOT_EQUAL as i32 &&
       op_code != TokenType.TOKEN_LESS as i32 && op_code != TokenType.TOKEN_GREATER as i32 &&
       op_code != TokenType.TOKEN_LESS_EQUAL as i32 && op_code != TokenType.TOKEN_GREATER_EQUAL as i32 {
        return;
    }

    // 获取左右操作数
    var left: &ASTNode = expr.binary_expr_left;
    var right: &ASTNode = expr.binary_expr_right;
    var effective_op: TokenType = op;  // 有效操作符（可能因交换律而改变）

    if left == null || right == null {
        return;
    }

    // 尝试标准化：将 "常量 op 变量" 转换为 "变量 op' 常量"
    // 例如：10 > i => i < 10
    const left_hint: LinearExpr = extract_linear_expr(checker, left);
    const right_hint: LinearExpr = extract_linear_expr(checker, right);
    if left_hint.is_valid != 0 && left_hint.var_name == null &&
        right_hint.is_valid != 0 && right_hint.var_name != null {
        // 左边不是标识符，右边是标识符：交换并翻转操作符
        const tmp: &ASTNode = left;
        left = right;
        right = tmp;
        // 翻转比较操作符
        if op_code == TokenType.TOKEN_LESS as i32 {             // < -> >
            effective_op = TokenType.TOKEN_GREATER;
        } else if op_code == TokenType.TOKEN_GREATER as i32 {   // > -> <
            effective_op = TokenType.TOKEN_LESS;
        } else if op_code == TokenType.TOKEN_LESS_EQUAL as i32 {    // <= -> >=
            effective_op = TokenType.TOKEN_GREATER_EQUAL;
        } else if op_code == TokenType.TOKEN_GREATER_EQUAL as i32 { // >= -> <=
            effective_op = TokenType.TOKEN_LESS_EQUAL;
        }
        // == 和 != 不需要翻转
    }

    // 左操作数必须是标识符或线性表达式（var + const 或 var - const）
    // 使用 extract_linear_expr 提取线性表达式
    const left_linear: LinearExpr = extract_linear_expr(checker, left);
    if left_linear.is_valid == 0 {
        return;
    }

    // 必须有变量名（纯常量不需要约束）
    if left_linear.var_name == null {
        return;
    }

    const var_name: &byte = left_linear.var_name;
    const var_offset: i32 = left_linear.offset;  // 变量的偏移量

    // 检查是否是指针与 null 的比较（用于空指针检测）
    // 注意：指针比较不支持偏移量
    if (op_code == TokenType.TOKEN_EQUAL as i32 || op_code == TokenType.TOKEN_NOT_EQUAL as i32) && var_offset == 0 {
        var is_null_compare: i32 = 0;
        var ptr_name: &byte = null;

        // 检查 ptr == null 或 ptr != null
        if right.type == ASTNodeType.AST_IDENTIFIER && right.identifier_name != null {
            if str_equals(right.identifier_name, "null" as &byte) != 0 {
                is_null_compare = 1;
                ptr_name = var_name;
            }
        }
        // 检查 null == ptr 或 null != ptr
        if left.type == ASTNodeType.AST_IDENTIFIER && left.identifier_name != null && str_equals(left.identifier_name, "null" as &byte) != 0 {
            if right.type == ASTNodeType.AST_IDENTIFIER && right.identifier_name != null {
                is_null_compare = 1;
                ptr_name = right.identifier_name;
            }
        }

        if is_null_compare != 0 && ptr_name != null {
            // 指针与 null 的比较
            if op_code == TokenType.TOKEN_NOT_EQUAL as i32 {
                // ptr != null
                if is_positive != 0 {
                    // then 分支：ptr 非空
                    pointer_nonnull_add(checker, ptr_name);
                } else {
                    // else 分支：ptr 为空（移除非空状态）
                    pointer_nonnull_remove(checker, ptr_name);
                }
            } else {
                // ptr == null
                if is_positive != 0 {
                    // then 分支：ptr 为空（移除非空状态）
                    pointer_nonnull_remove(checker, ptr_name);
                } else {
                    // else 分支：ptr 非空
                    pointer_nonnull_add(checker, ptr_name);
                }
            }
            return;
        }
    }

    // 右操作数可以是常量，也可以是具有有限区间的表达式。
    // 若区间未知（成员访问、函数调用等），退回**右操作数类型的完整值域**：
    // `i < x`（x 为 i32）蕴含 `i < INT32_MAX`，这是条件的可靠推论，
    // 也是循环计数器 `i = i + 1` 能被证明的关键（循环上界常常是 obj.count 这类成员访问）。
    var right_interval: Interval = eval_expr_interval(checker, right);
    if right_interval.is_valid == 0 {
        if right == null {
            return;
        }
        const right_type: Type = checker_infer_type(checker, right);
        if is_integer_type(right_type.kind) == 0 {
            return;
        }
        const ty_bounds: WideInterval = wide_of_type_kind(right_type.kind as i32);
        if ty_bounds.lo_known == 0 || ty_bounds.hi_known == 0 {
            // u64/usize 上界超出 i32 区间表示，无法用常数约束表达，放弃
            return;
        }
        right_interval = interval_range(interval_saturate_i32(ty_bounds.lo), interval_saturate_i32(ty_bounds.hi));
    }

    // 映射操作符
    // 正条件：直接映射
    // 负条件：取反（LT <-> GE, GT <-> LE, EQ <-> NE）
    var constraint_op: i32 = 0;

    if is_positive != 0 {
        // 正条件
        if effective_op == TokenType.TOKEN_LESS {
            constraint_op = CONSTRAINT_LT;
        } else if effective_op == TokenType.TOKEN_GREATER {
            constraint_op = CONSTRAINT_GT;
        } else if effective_op == TokenType.TOKEN_LESS_EQUAL {
            constraint_op = CONSTRAINT_LE;
        } else if effective_op == TokenType.TOKEN_GREATER_EQUAL {
            constraint_op = CONSTRAINT_GE;
        } else if effective_op == TokenType.TOKEN_EQUAL {
            constraint_op = CONSTRAINT_EQ;
        } else if effective_op == TokenType.TOKEN_NOT_EQUAL {
            constraint_op = CONSTRAINT_NE;
        }
    } else {
        // 负条件（取反）
        if effective_op == TokenType.TOKEN_LESS {           // !(a < b) -> a >= b
            constraint_op = CONSTRAINT_GE;
        } else if effective_op == TokenType.TOKEN_GREATER { // !(a > b) -> a <= b
            constraint_op = CONSTRAINT_LE;
        } else if effective_op == TokenType.TOKEN_LESS_EQUAL {    // !(a <= b) -> a > b
            constraint_op = CONSTRAINT_GT;
        } else if effective_op == TokenType.TOKEN_GREATER_EQUAL { // !(a >= b) -> a < b
            constraint_op = CONSTRAINT_LT;
        } else if effective_op == TokenType.TOKEN_EQUAL {    // !(a == b) -> a != b
            constraint_op = CONSTRAINT_NE;
        } else if effective_op == TokenType.TOKEN_NOT_EQUAL { // !(a != b) -> a == b
            constraint_op = CONSTRAINT_EQ;
        }
    }

    // 计算调整后的约束值
    // 例如：i + 1 < 10 应该转换为 i < 9
    // 若右侧是区间，则选取对当前约束最保守但仍有效的常量边界。
    var bound_val: i32 = 0;
    if constraint_op == CONSTRAINT_LT || constraint_op == CONSTRAINT_LE {
        bound_val = right_interval.max;
    } else if constraint_op == CONSTRAINT_GT || constraint_op == CONSTRAINT_GE {
        bound_val = right_interval.min;
    } else {
        if right_interval.min != right_interval.max {
            return;
        }
        bound_val = right_interval.min;
    }
    // 以 u32 回绕消除有符号溢出 UB（实测 UBSan：2147483647 - -1）。
    const adj_u: u32 = (bound_val as u32) - (var_offset as u32);
    var adjusted_val: i32 = adj_u as i32;

    constraint_add(checker, var_name, constraint_op, adjusted_val);
}

// 验证数组访问边界
// 参数：var_name - 索引变量名，array_size - 数组大小
// 返回：1 表示证明安全，0 表示无法证明
fn constraint_verify_bounds(checker: &TypeChecker, var_name: &byte, array_size: i32) i32 {
    if checker == null || var_name == null {
        return 0;
    }

    var has_lower_bound: i32 = 0;  // var >= 0
    var has_upper_bound: i32 = 0;  // var < size

    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) == 0 {
                const op: i32 = checker.constraint_ops[i];
                const val: i32 = checker.constraint_values[i];

                // 检查下界：var >= 0 或 var > -1
                if op == CONSTRAINT_GE && val == 0 {
                    has_lower_bound = 1;
                } else if op == CONSTRAINT_GT && val == -1 {
                    has_lower_bound = 1;
                }

                // 检查上界：var < size 或 var <= size-1
                if op == CONSTRAINT_LT && val == array_size {
                    has_upper_bound = 1;
                } else if op == CONSTRAINT_LE && val == ((array_size as u32) - 1u) as i32 {
                    has_upper_bound = 1;
                }
            }
        }
        i = i + 1;
    }

    if has_lower_bound != 0 && has_upper_bound != 0 {
        return 1;  // 证明安全
    }
    return 0;  // 无法证明
}

// 线性表达式结构（用于符号执行）
// 表示 var + offset 或 var - offset 的形式
struct LinearExpr {
    var_name: &byte,      // 基础变量名（null 表示纯常量）
    offset: i32,          // 偏移量（正数表示加，负数表示减）
    is_valid: i32,        // 是否是有效的线性表达式
}

// 区间结构（用于非线性表达式边界分析）
// 表示变量可能值的范围 [min, max]
struct Interval {
    min: i32,             // 最小值
    max: i32,             // 最大值
    is_valid: i32,        // 是否是有效区间
}

// 创建常量区间（单点区间）
fn interval_const(val: i32) Interval {
    return Interval {
        min: val,
        max: val,
        is_valid: 1,
    };
}

// 创建范围区间
fn interval_range(min_val: i32, max_val: i32) Interval {
    return Interval {
        min: min_val,
        max: max_val,
        is_valid: 1,
    };
}

// 创建无效区间
fn interval_invalid() Interval {
    return Interval {
        min: 0,
        max: 0,
        is_valid: 0,
    };
}

// 把 i64 端点在 i32 范围内**饱和**。
// 注意：不能用 u32 回绕。抽象区间域必须保证 min <= max 且「包含所有真实值」，
// 回绕会把 [MAX,MAX] + [1,1] 算成 [MIN,MIN] —— 既反转了端点，又让结果假称
// 「落在 i32 范围内」，会让溢出证明把真实溢出判成安全（unusound）。
fn interval_i32_min() i32 {
    const v: i32 = @min;
    return v;
}

fn interval_i32_max() i32 {
    const v: i32 = @max;
    return v;
}

fn interval_saturate_i32(v: i64) i32 {
    // 不用 i64 字面量 -2147483648：checker 的常量折叠是 i32 域，
    // `0i64 - 2147483648i64` 会被自己判成 i32 溢出。
    const hi: i64 = interval_i32_max() as i64;
    const lo: i64 = interval_i32_min() as i64;
    if v > hi {
        return interval_i32_max();
    }
    if v < lo {
        return interval_i32_min();
    }
    return v as i32;
}

// 区间加法
fn interval_add(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    // [a.min, a.max] + [b.min, b.max] = [a.min + b.min, a.max + b.max]
    // u32 回绕消除有符号溢出 UB（i32 加法溢出在 C 里未定义；带 UBSan 的 zig cc 交叉
    // 编译 Windows 时直接 panic）。u32 相加良定义，位模式与原符号回绕一致。
    //
    // 注意：回绕区间**不能**用于溢出证明（会把 [MAX,MAX]+[1,1] 算成 [MIN,MIN]，
    // 假称落在 i32 内）。溢出证明用 wide_* 系列 + constraint_sound 标记，见下方。
    const lo_u: u32 = (a.min as u32) + (b.min as u32);
    const hi_u: u32 = (a.max as u32) + (b.max as u32);
    return interval_range(lo_u as i32, hi_u as i32);
}

// 区间减法
fn interval_sub(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    // [a.min, a.max] - [b.min, b.max] = [a.min - b.max, a.max - b.min]
    // 同样以 u32 回绕消除有符号溢出 UB。
    const lo_s: u32 = (a.min as u32) - (b.max as u32);
    const hi_s: u32 = (a.max as u32) - (b.min as u32);
    return interval_range(lo_s as i32, hi_s as i32);
}

// 区间乘法
fn interval_mul(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    // 乘法需要考虑所有组合，找出最小和最大值
    // 乘积以 u32 回绕消除有符号溢出 UB（u32 乘法良定义，位模式与原语义一致）。
    const p1: i32 = ((a.min as u32) * (b.min as u32)) as i32;
    const p2: i32 = ((a.min as u32) * (b.max as u32)) as i32;
    const p3: i32 = ((a.max as u32) * (b.min as u32)) as i32;
    const p4: i32 = ((a.max as u32) * (b.max as u32)) as i32;

    var min_val: i32 = p1;
    var max_val: i32 = p1;

    if p2 < min_val { min_val = p2; }
    if p3 < min_val { min_val = p3; }
    if p4 < min_val { min_val = p4; }
    if p2 > max_val { max_val = p2; }
    if p3 > max_val { max_val = p3; }
    if p4 > max_val { max_val = p4; }

    return interval_range(min_val, max_val);
}

// 区间整数除法（保守估计）
fn interval_div(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    // 除以零检查：如果 b 区间包含 0，结果不确定。
    // 必须先排除端点反转：回绕得到的 [0, -4] 会让下面的含零判据失效，
    // 随后 `a.min / b.min` 就是编译期除零，编译器自己以 SIGFPE（退出码 136）中止。
    if b.min > b.max {
        return interval_range(-2147483647, 2147483647);
    }
    if b.min <= 0 && b.max >= 0 {
        // 包含 0，保守估计为全范围
        return interval_range(-2147483647, 2147483647);
    }

    // 整数除法：需要考虑所有组合
    // 注意：整数除法向零取整
    const q1: i32 = a.min / b.min;
    const q2: i32 = a.min / b.max;
    const q3: i32 = a.max / b.min;
    const q4: i32 = a.max / b.max;

    var min_val: i32 = q1;
    var max_val: i32 = q1;

    if q2 < min_val { min_val = q2; }
    if q3 < min_val { min_val = q3; }
    if q4 < min_val { min_val = q4; }
    if q2 > max_val { max_val = q2; }
    if q3 > max_val { max_val = q3; }
    if q4 > max_val { max_val = q4; }

    return interval_range(min_val, max_val);
}

// 区间左移（等价于乘以 2^n，但只支持常量移位）
fn interval_shl(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    // 如果 b 是常量，转换为乘法
    if b.min == b.max && b.min >= 0 && b.min < 31 {
        const factor: i32 = 1 << b.min;  // 2^n
        return interval_mul(a, interval_const(factor));
    }
    // 保守估计：左移 n 位 = 乘以 [2^0, 2^30]
    return interval_mul(a, interval_range(1, 1073741824));
}

// 区间右移
fn interval_shr(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    // 如果 b 是常量
    if b.min == b.max && b.min >= 0 && b.min < 31 {
        // 右移 n 位 = 除以 2^n（向下取整）
        const factor: i32 = 1 << b.min;
        return interval_div(a, interval_const(factor));
    }
    // 保守估计
    return interval_div(a, interval_range(1, 1073741824));
}

// 区间按位与
// 对常见的 mask 场景（x & (2^n-1)）收敛到 [0, mask]
fn interval_bitand(a: Interval, b: Interval) Interval {
    if a.is_valid == 0 || b.is_valid == 0 {
        return interval_invalid();
    }
    if b.min == b.max && b.min >= 0 {
        var upper: i32 = b.min;
        if a.min >= 0 && a.max < upper {
            upper = a.max;
        }
        return interval_range(0, upper);
    }
    if a.min == a.max && a.min >= 0 {
        var upper2: i32 = a.min;
        if b.min >= 0 && b.max < upper2 {
            upper2 = b.max;
        }
        return interval_range(0, upper2);
    }
    return interval_invalid();
}

// 检查区间是否完全在 [lower, upper) 范围内
fn interval_within_bounds(interval: Interval, lower: i32, upper: i32) i32 {
    if interval.is_valid == 0 {
        return 0;
    }
    // 端点反转的区间不构成证明：i32 回绕会产出 min > max 的区间（如 [2, -2]），
    // 只比较两个端点会误判为「完全在 [lower, upper) 内」，放行真实越界。
    if interval.min > interval.max {
        return 0;
    }
    if interval.min >= lower && interval.max < upper {
        return 1;
    }
    return 0;
}

// ===== 溢出证明专用：i64 宽化区间 =====
//
// 上面 Interval 的 min/max 是 i32，且 interval_add/sub/mul 刻意用 u32 回绕消除
// 有符号溢出 UB —— 这对越界检查是「保守安全」，但**不能**用于溢出证明：
// [MAX,MAX] + [1,1] 会算出 [MIN,MIN]，落在 i32 范围内被误判为「无溢出」。
//
// 因此溢出证明单独用 i64 宽化的 WideInterval：
//   - 上下界用 i64 表示，能覆盖 i8/i16/i32/u8/u16/u32 的完整范围；
//   - u64/usize 的上界无法用 i64 表示，用 hi_known = 0 标记「上界未知」，
//     只保留已知的 lo（默认为 0）；
//   - 所有运算在 i64 上做显式溢出预处理，越界即标记为「不可证明」，绝不静默回绕。
// 保守优先：证明不出来就是证明不出来，不允许任何「可能溢出却判安全」的路径。

struct WideInterval {
    lo: i64,
    hi: i64,
    lo_known: i32,   // lo 是否已知
    hi_known: i32,   // hi 是否已知
}

fn wide_i64_min() i64 {
    const v: i64 = @min;
    return v;
}

fn wide_i64_max() i64 {
    const v: i64 = @max;
    return v;
}

// 上界超过 i64 表示范围（u64 / usize）
const WIDE_TYPE_KIND_U64: i32 = TypeKind.TYPE_U64 as i32;
const WIDE_TYPE_KIND_USIZE: i32 = TypeKind.TYPE_USIZE as i32;

fn wide_unknown() WideInterval {
    return WideInterval {
        lo: 0i64,
        hi: 0i64,
        lo_known: 0,
        hi_known: 0,
    };
}

fn wide_point(val: i64) WideInterval {
    return WideInterval {
        lo: val,
        hi: val,
        lo_known: 1,
        hi_known: 1,
    };
}

// 整数类型 kind（TypeKind as i32）对应的溢出上界是否为「超出 i64」
fn wide_kind_hi_overflows_i64(kind: i32) i32 {
    if kind == WIDE_TYPE_KIND_U64 || kind == WIDE_TYPE_KIND_USIZE {
        return 1;
    }
    return 0;
}

// 整数类型 kind 的完整取值范围
fn wide_of_type_kind(kind: i32) WideInterval {
    if kind == TypeKind.TYPE_I8 as i32 {
        return WideInterval { lo: 0i64 - 128i64, hi: 127i64, lo_known: 1, hi_known: 1 };
    }
    if kind == TypeKind.TYPE_I16 as i32 {
        return WideInterval { lo: 0i64 - 32768i64, hi: 32767i64, lo_known: 1, hi_known: 1 };
    }
    if kind == TypeKind.TYPE_I32 as i32 {
        return WideInterval { lo: 0i64 - 2147483648i64, hi: 2147483647i64, lo_known: 1, hi_known: 1 };
    }
    if kind == TypeKind.TYPE_I64 as i32 {
        return WideInterval { lo: wide_i64_min(), hi: wide_i64_max(), lo_known: 1, hi_known: 1 };
    }
    if kind == TypeKind.TYPE_U8 as i32 || kind == TypeKind.TYPE_BYTE as i32 {
        return WideInterval { lo: 0i64, hi: 255i64, lo_known: 1, hi_known: 1 };
    }
    if kind == TypeKind.TYPE_U16 as i32 {
        return WideInterval { lo: 0i64, hi: 65535i64, lo_known: 1, hi_known: 1 };
    }
    if kind == TypeKind.TYPE_U32 as i32 {
        return WideInterval { lo: 0i64, hi: 4294967295i64, lo_known: 1, hi_known: 1 };
    }
    if wide_kind_hi_overflows_i64(kind) != 0 {
        // u64 / usize：下界 0 已知，上界超出 i64，标记为未知
        return WideInterval { lo: 0i64, hi: 0i64, lo_known: 1, hi_known: 0 };
    }
    return wide_unknown();
}

// i64 加法，溢出时返回 0（out 不写入）
fn wide_add_i64(a: i64, b: i64, out: &i64) i32 {
    if b > 0i64 {
        if a > wide_i64_max() - b {
            return 0;
        }
    } else {
        if a < wide_i64_min() - b {
            return 0;
        }
    }
    out[0] = a + b;
    return 1;
}

// i64 减法，溢出时返回 0
fn wide_sub_i64(a: i64, b: i64, out: &i64) i32 {
    if b > 0i64 {
        if a < wide_i64_min() + b {
            return 0;
        }
    } else {
        if a > wide_i64_max() + b {
            return 0;
        }
    }
    out[0] = a - b;
    return 1;
}

// 乘法安全阈值：|bound| <= 2^31 时四个乘积都能落在 i64 内（2^62）
const WIDE_MUL_SAFE_BOUND: i64 = 2147483647i64;

fn wide_bound_mul_is_safe(v: i64) i32 {
    if v > WIDE_MUL_SAFE_BOUND {
        return 0;
    }
    if v < 0i64 - WIDE_MUL_SAFE_BOUND {
        return 0;
    }
    return 1;
}

fn wide_add(a: WideInterval, b: WideInterval) WideInterval {
    var out: WideInterval = wide_unknown();
    out.lo_known = a.lo_known & b.lo_known;
    out.hi_known = a.hi_known & b.hi_known;
    if out.lo_known != 0 {
        var lo_v: [i64: 1] = [0i64];
        if wide_add_i64(a.lo, b.lo, &lo_v[0]) == 0 {
            out.lo_known = 0;
        } else {
            out.lo = lo_v[0];
        }
    }
    if out.hi_known != 0 {
        var hi_v: [i64: 1] = [0i64];
        if wide_add_i64(a.hi, b.hi, &hi_v[0]) == 0 {
            out.hi_known = 0;
        } else {
            out.hi = hi_v[0];
        }
    }
    return out;
}

fn wide_sub(a: WideInterval, b: WideInterval) WideInterval {
    var out: WideInterval = wide_unknown();
    out.lo_known = a.lo_known & b.hi_known;
    out.hi_known = a.hi_known & b.lo_known;
    if out.lo_known != 0 {
        var lo_v: [i64: 1] = [0i64];
        if wide_sub_i64(a.lo, b.hi, &lo_v[0]) == 0 {
            out.lo_known = 0;
        } else {
            out.lo = lo_v[0];
        }
    }
    if out.hi_known != 0 {
        var hi_v: [i64: 1] = [0i64];
        if wide_sub_i64(a.hi, b.lo, &hi_v[0]) == 0 {
            out.hi_known = 0;
        } else {
            out.hi = hi_v[0];
        }
    }
    return out;
}

// 区间乘法：四个端点两两相乘取极值。任一端点超出安全阈值即放弃（保守）
fn wide_mul(a: WideInterval, b: WideInterval) WideInterval {
    if a.lo_known == 0 || a.hi_known == 0 || b.lo_known == 0 || b.hi_known == 0 {
        return wide_unknown();
    }
    if wide_bound_mul_is_safe(a.lo) == 0 || wide_bound_mul_is_safe(a.hi) == 0 ||
        wide_bound_mul_is_safe(b.lo) == 0 || wide_bound_mul_is_safe(b.hi) == 0 {
        return wide_unknown();
    }
    const p1: i64 = a.lo * b.lo;
    const p2: i64 = a.lo * b.hi;
    const p3: i64 = a.hi * b.lo;
    const p4: i64 = a.hi * b.hi;
    var lo: i64 = p1;
    var hi: i64 = p1;
    if p2 < lo { lo = p2; }
    if p3 < lo { lo = p3; }
    if p4 < lo { lo = p4; }
    if p2 > hi { hi = p2; }
    if p3 > hi { hi = p3; }
    if p4 > hi { hi = p4; }
    return WideInterval { lo: lo, hi: hi, lo_known: 1, hi_known: 1 };
}

fn wide_neg(a: WideInterval) WideInterval {
    var out: WideInterval = wide_unknown();
    out.lo_known = a.hi_known;
    out.hi_known = a.lo_known;
    // -hi / -lo：hi 为 i64 最小值时取负溢出（i64 最小值的相反数不可表示）
    if out.lo_known != 0 {
        if a.hi == wide_i64_min() {
            out.lo_known = 0;
        } else {
            out.lo = 0i64 - a.hi;
        }
    }
    if out.hi_known != 0 {
        if a.lo == wide_i64_min() {
            out.hi_known = 0;
        } else {
            out.hi = 0i64 - a.lo;
        }
    }
    return out;
}

// 两个区间的交集（用于「类型值域 ∩ 已知内层区间」）。
// 任一方向已知就收紧对应端点；交集为空时返回 unknown（保守）。
fn wide_intersect(a: WideInterval, b: WideInterval) WideInterval {
    var out: WideInterval = wide_unknown();
    out.lo_known = a.lo_known | b.lo_known;
    out.hi_known = a.hi_known | b.hi_known;
    if a.lo_known != 0 && b.lo_known != 0 {
        if a.lo > b.lo { out.lo = a.lo; } else { out.lo = b.lo; }
    } else if a.lo_known != 0 {
        out.lo = a.lo;
    } else if b.lo_known != 0 {
        out.lo = b.lo;
    }
    if a.hi_known != 0 && b.hi_known != 0 {
        if a.hi < b.hi { out.hi = a.hi; } else { out.hi = b.hi; }
    } else if a.hi_known != 0 {
        out.hi = a.hi;
    } else if b.hi_known != 0 {
        out.hi = b.hi;
    }
    if out.lo_known != 0 && out.hi_known != 0 && out.lo > out.hi {
        return wide_unknown();
    }
    return out;
}

// 该区间是否完全落在整数类型 kind 的取值范围内（即不会溢出）
fn wide_fits_type_kind(w: WideInterval, kind: i32) i32 {
    if w.lo_known == 0 || w.hi_known == 0 {
        return 0;
    }
    if w.lo > w.hi {
        return 0;
    }
    const bounds: WideInterval = wide_of_type_kind(kind);
    if w.lo < bounds.lo {
        return 0;
    }
    // u64 / usize 的上界超出 i64：任何 i64 可表示的上界都满足
    if wide_kind_hi_overflows_i64(kind) != 0 {
        return 1;
    }
    if w.hi > bounds.hi {
        return 0;
    }
    return 1;
}

// 基于约束表构造变量的宽化区间：从类型全域出发，按已收集约束收窄
fn wide_interval_of_var(checker: &TypeChecker, var_name: &byte, kind: i32) WideInterval {
    if checker == null || var_name == null {
        return wide_unknown();
    }
    var out: WideInterval = wide_of_type_kind(kind);
    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS && wide_constraint_is_sound_at(i) != 0 {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) == 0 {
                const op: i32 = checker.constraint_ops[i];
                const val: i64 = checker.constraint_values[i] as i64;
                if op == CONSTRAINT_EQ {
                    out = wide_point(val);
                } else if op == CONSTRAINT_GE {
                    if out.lo_known == 0 || val > out.lo {
                        out.lo = val;
                        out.lo_known = 1;
                    }
                } else if op == CONSTRAINT_GT {
                    const val_p1: i64 = val + 1i64;
                    if out.lo_known == 0 || val_p1 > out.lo {
                        out.lo = val_p1;
                        out.lo_known = 1;
                    }
                } else if op == CONSTRAINT_LE {
                    if out.hi_known == 0 || val < out.hi {
                        out.hi = val;
                        out.hi_known = 1;
                    }
                } else if op == CONSTRAINT_LT {
                    const val_m1: i64 = val - 1i64;
                    if out.hi_known == 0 || val_m1 < out.hi {
                        out.hi = val_m1;
                        out.hi_known = 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

// 表达式的宽化区间。
// 只识别能提供可靠边界的形态：整数字面量、局部/全局标识符（查约束表）、
// 一元负、加减乘。其余（调用、成员访问、下标、转换等）一律返回「未知」——
// 保守失败，绝不猜测。
fn wide_interval_of_expr(checker: &TypeChecker, expr: &ASTNode, kind: i32) WideInterval {
    if checker == null || expr == null {
        return wide_unknown();
    }
    if expr.type == ASTNodeType.AST_NUMBER {
        return wide_point(expr.number_value);
    }
    if expr.type == ASTNodeType.AST_INT_LIMIT {
        if expr.int_limit_is_max != 0 {
            const bounds_max: WideInterval = wide_of_type_kind(kind);
            if bounds_max.hi_known != 0 {
                return wide_point(bounds_max.hi);
            }
            return wide_unknown();
        }
        const bounds_min: WideInterval = wide_of_type_kind(kind);
        if bounds_min.lo_known != 0 {
            return wide_point(bounds_min.lo);
        }
        return wide_unknown();
    }
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        return wide_interval_of_var(checker, expr.identifier_name, kind);
    }
    if expr.type == ASTNodeType.AST_CAST_EXPR && expr.cast_expr_target_type != null {
        // 转换到整数类型后，取值必然落在目标类型的值域内（`as` 是截断语义，
        // `as!` 检查失败会返回错误而不是越界值）。例如 `(x as byte)` 恒在 [0,255]，
        // 这是 `48 + (c as byte)` 这类写法可证的关键。
        const target: Type = type_from_ast(checker, expr.cast_expr_target_type);
        const target_kind: i32 = target.kind as i32;
        if proof_type_kind_is_integer(target_kind) != 0 || is_unsigned_type(target.kind) != 0 {
            // 取「目标类型值域」∩「内层区间」：转换既受目标类型限幅，
            // 内层若已有更窄的守卫也必须继承，否则会把有界表达式放宽。
            const domain: WideInterval = wide_of_type_kind(target_kind);
            const inner: WideInterval = wide_interval_of_expr(checker, expr.cast_expr_expr, target_kind);
            return wide_intersect(domain, inner);
        }
        // 非整数目标（指针等）：继续看内层表达式
        if expr.cast_expr_expr != null {
            return wide_interval_of_expr(checker, expr.cast_expr_expr, kind);
        }
        return wide_unknown();
    }
    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        // 成员访问 / 转换表达式：约束表本来就按 constraint_expr_name 的规范化名字
        // 跟踪（越界证明一直在用），这里复用同一套名字即可拿到可信守卫。
        // 例如 `if c.count > 0 { c.count - 1 }` 可以证明不溢出。
        const path_name: &byte = constraint_expr_name(checker, expr);
        if (path_name != null) {
            return wide_interval_of_var(checker, path_name, kind);
        }
        // 转换表达式继续往里看（as 不改变值域时仍可用内层区间）
        if expr.type == ASTNodeType.AST_CAST_EXPR && expr.cast_expr_expr != null {
            return wide_interval_of_expr(checker, expr.cast_expr_expr, kind);
        }
        return wide_unknown();
    }
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        const uop_tmp: !TokenType = expr.unary_expr_op as! TokenType;
        const uop: TokenType = uop_tmp.value;
        if uop != TokenType.TOKEN_MINUS {
            return wide_unknown();
        }
        return wide_neg(wide_interval_of_expr(checker, expr.unary_expr_operand, kind));
    }
    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        const op_tmp: !TokenType = expr.binary_expr_op as! TokenType;
        const op: TokenType = op_tmp.value;
        const left: WideInterval = wide_interval_of_expr(checker, expr.binary_expr_left, kind);
        const right: WideInterval = wide_interval_of_expr(checker, expr.binary_expr_right, kind);
        if op == TokenType.TOKEN_PLUS {
            return wide_add(left, right);
        }
        if op == TokenType.TOKEN_MINUS {
            return wide_sub(left, right);
        }
        if op == TokenType.TOKEN_ASTERISK {
            return wide_mul(left, right);
        }
        const is_div_op: i32 = (op == TokenType.TOKEN_SLASH || op == TokenType.TOKEN_PERCENT) as i32;
        if is_div_op != 0 && right.lo_known != 0 && right.hi_known != 0 {
            // 除数必须是**确定的非零单点**常量，否则无法排除除零 UB。
            // `x % k` 的结果落在 (-k, k)：C 的取模符号跟随被除数，
            // 所以区间是 [-(k-1), k-1]；被除数已知非负时收窄到 [0, k-1]。
            // 这条规则让 `48 + (x % 10)` 这类数字格式化可以证明。
            if right.lo == right.hi && right.lo != 0i64 && right.lo != 0i64 - 1i64 {
                if op == TokenType.TOKEN_PERCENT {
                    var m: i64 = right.lo;
                    if m < 0i64 {
                        m = 0i64 - m;
                    }
                    const span: i64 = m - 1i64;
                    var lo_v: i64 = 0i64 - span;
                    if left.lo_known != 0 && left.lo >= 0i64 {
                        lo_v = 0i64;
                    }
                    const mod_r: WideInterval = WideInterval {
                        lo: lo_v,
                        hi: span,
                        lo_known: 1,
                        hi_known: 1,
                    };
                    return wide_intersect(mod_r, left);
                }
                // 除法：按绝对值上界保守估计
                if left.lo_known != 0 && left.hi_known != 0 {
                    var abs_max: i64 = 0i64;
                    if left.lo < 0i64 {
                        abs_max = 0i64 - left.lo;
                    } else {
                        abs_max = left.lo;
                    }
                    const hi_abs: i64 = left.hi;
                    if hi_abs > abs_max {
                        abs_max = hi_abs;
                    }
                    if hi_abs < 0i64 && (0i64 - hi_abs) > abs_max {
                        abs_max = 0i64 - hi_abs;
                    }
                    var k: i64 = right.lo;
                    if k < 0i64 {
                        k = 0i64 - k;
                    }
                    const bound: i64 = abs_max / k;
                    const div_r: WideInterval = WideInterval {
                        lo: 0i64 - bound,
                        hi: bound,
                        lo_known: 1,
                        hi_known: 1,
                    };
                    return wide_intersect(div_r, left);
                }
            }
        }
        return wide_unknown();
    }
    return wide_unknown();
}


// 支持：标识符、常量、标识符+常量、标识符-常量、类型转换表达式
// 返回 LinearExpr 结构
fn extract_linear_expr(checker: &TypeChecker, expr: &ASTNode) LinearExpr {
    var result: LinearExpr = LinearExpr {
        var_name: null,
        offset: 0,
        is_valid: 0,
    };

    if checker == null || expr == null {
        return result;
    }

    if expr.type == ASTNodeType.AST_NUMBER {
        // 纯常量
        result.offset = expr.number_value;
        result.is_valid = 1;
        return result;
    }

    if expr.type == ASTNodeType.AST_IDENTIFIER {
        // 检查是否是 const 变量，如果是则尝试获取其常量值
        const symbol: &Symbol = symbol_table_lookup(checker, expr.identifier_name);
        if symbol != null && symbol.is_const != 0 {
            // const 变量：尝试获取其常量值（用成功标志区分「非常量」与「常量 -1」）
            var const_ok: i32 = 0;
            const const_val: i32 = checker_eval_const_expr_ex(checker, expr, &const_ok);
            if const_ok != 0 {
                // 成功获取常量值，作为纯常量处理
                result.var_name = null;
                result.offset = const_val;
                result.is_valid = 1;
                return result;
            }
        }
        // 非 const 变量或无法求值：作为纯变量处理
        result.var_name = expr.identifier_name;
        result.offset = 0;
        result.is_valid = 1;
        return result;
    }

    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        const member_name: &byte = constraint_expr_name(checker, expr);
        if member_name != null {
            result.var_name = member_name;
            result.offset = 0;
            result.is_valid = 1;
        }
        return result;
    }

    // 类型转换表达式：递归提取内部表达式
    // 例如：base + 3 as usize -> base + 3
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        const inner_expr: &ASTNode = expr.cast_expr_expr;
        if inner_expr != null {
            return extract_linear_expr(checker, inner_expr);
        }
        return result;
    }

    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        const op_tmp: !TokenType = expr.binary_expr_op as! TokenType;
        const op: TokenType = op_tmp.value;
        // 操作符 i32 快照：独立检查时枚举被多次读取会被判为「已被移动」。
        const op_code: i32 = op as i32;
        const left: &ASTNode = expr.binary_expr_left;
        const right: &ASTNode = expr.binary_expr_right;

        // 只支持 + 和 - 运算
        if op_code != TokenType.TOKEN_PLUS as i32 && op_code != TokenType.TOKEN_MINUS as i32 {
            return result;
        }

        // 提取左边和右边
        const left_expr: LinearExpr = extract_linear_expr(checker, left);
        const right_expr: LinearExpr = extract_linear_expr(checker, right);

        // 检查是否可以组合
        // 情况1: var + const 或 var - const
        // 情况2: const + var 或 const - var
        if left_expr.is_valid != 0 && right_expr.is_valid != 0 {
            if left_expr.var_name != null && right_expr.var_name == null {
                // var + const 或 var - const
                result.var_name = left_expr.var_name;
                if op_code == TokenType.TOKEN_PLUS as i32 {
                    result.offset = ((left_expr.offset as u32) + (right_expr.offset as u32)) as i32;
                } else {
                    result.offset = ((left_expr.offset as u32) - (right_expr.offset as u32)) as i32;
                }
                result.is_valid = 1;
                return result;
            } else if left_expr.var_name == null && right_expr.var_name != null && op_code == TokenType.TOKEN_PLUS as i32 {
                // const + var（只有加法支持交换律）
                result.var_name = right_expr.var_name;
                result.offset = ((left_expr.offset as u32) + (right_expr.offset as u32)) as i32;
                result.is_valid = 1;
                return result;
            }
        }
    }

    return result;  // 无法识别的线性表达式
}

// 从约束系统获取变量的区间
// 参数：var_name - 变量名
// 返回：变量的区间估计（基于已收集的约束）
fn get_var_interval(checker: &TypeChecker, var_name: &byte) Interval {
    if checker == null || var_name == null {
        return interval_invalid();
    }

    // 初始区间：无界
    var min_val: i32 = -2147483647;
    var max_val: i32 = 2147483647;

    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) == 0 {
                const op: i32 = checker.constraint_ops[i];
                const val: i32 = checker.constraint_values[i];

                // 根据约束类型更新区间
                if op == CONSTRAINT_EQ {
                    // 精确值约束：区间收缩为单点
                    min_val = val;
                    max_val = val;
                } else if op == CONSTRAINT_GE {
                    // >= val：更新下界
                    if val > min_val {
                        min_val = val;
                    }
                } else if op == CONSTRAINT_GT {
                    // > val：更新下界（至少 val + 1）
                    // +1/-1 以 u32 回绕消除溢出 UB。
                    const val_p1: i32 = ((val as u32) + 1u) as i32;
                    if val_p1 > min_val {
                        min_val = val_p1;
                    }
                } else if op == CONSTRAINT_LE {
                    // <= val：更新上界
                    if val < max_val {
                        max_val = val;
                    }
                } else if op == CONSTRAINT_LT {
                    // < val：更新上界（最多 val - 1）
                    const val_m1: i32 = ((val as u32) - 1u) as i32;
                    if val_m1 < max_val {
                        max_val = val_m1;
                    }
                }
            }
        }
        i = i + 1;
    }

    if min_val == -2147483647 {
        const sym: &Symbol = symbol_table_lookup(checker, var_name);
        if sym != null {
            const kind: TypeKind = sym.type.kind;
            if kind == TypeKind.TYPE_U8 || kind == TypeKind.TYPE_U16 ||
                kind == TypeKind.TYPE_U32 || kind == TypeKind.TYPE_U64 ||
                kind == TypeKind.TYPE_USIZE || kind == TypeKind.TYPE_BYTE {
                min_val = 0;
            }
        }
    }

    // 检查区间有效性
    if min_val > max_val {
        return interval_invalid();  // 矛盾的约束
    }

    return interval_range(min_val, max_val);
}

// 把表达式的区间写成约束。
// src_expr 用于判定该区间是否**可信**：eval_expr_interval 内部用 u32 位模式回绕，
// 端点可能已经被绕成假值（例如 [MAX,MAX]+[1,1] → [MIN,MIN]）。只有当同一表达式在
// i64 宽化域里算出完整且在 i32 内的区间时，才认为这条约束可用于溢出证明。
// 参数：checker - 类型检查器；var_name - 被约束的变量/路径名；
//       interval - 已算出的 i32 区间；src_expr - 区间来源表达式（可为 null）
// 返回：无
fn constraint_replace_with_interval(checker: &TypeChecker, var_name: &byte, interval: &Interval, src_expr: &ASTNode) void {
    if checker == null || var_name == null || interval == null || interval.is_valid == 0 {
        return;
    }
    constraint_remove_var(checker, var_name);
    if interval.min == interval.max {
        constraint_add(checker, var_name, CONSTRAINT_EQ, interval.min);
    } else {
        if interval.min > -2147483647 {
            constraint_add(checker, var_name, CONSTRAINT_GE, interval.min);
        }
        if interval.max < 2147483647 {
            constraint_add(checker, var_name, CONSTRAINT_LE, interval.max);
        }
    }
    if interval.min >= 0 {
        constraint_add(checker, var_name, CONSTRAINT_GE, 0);
    }
    // 可信度：只有 wide 域能给出完整且落在 i32 内的区间时，这条约束才可用于溢出证明
    var trusted: i32 = 0;
    if (src_expr != null) {
        const wide: WideInterval = wide_interval_of_expr(checker, src_expr, TypeKind.TYPE_I32 as i32);
        if (wide.lo_known != 0 && wide.hi_known != 0 && wide.lo <= wide.hi &&
            wide.lo >= (interval_i32_min() as i64) && wide.hi <= (interval_i32_max() as i64)) {
            trusted = 1;
        }
    }
    var mi: i32 = 0;
    while mi < checker.constraint_count {
        if mi < MAX_CONSTRAINTS && checker.constraint_var_names[mi] != null &&
            strcmp(checker.constraint_var_names[mi] as *byte, var_name as *byte) == 0 {
            if trusted != 0 {
                wide_mark_constraint_sound_at(mi);
            } else {
                wide_mark_constraint_unsound_at(mi);
            }
        }
        mi = mi + 1;
    }
}

// 对表达式进行区间求值
// 支持：常量、变量、加法、减法、乘法、除法、移位运算
// 参数：expr - AST 表达式节点
// 返回：表达式的区间估计
fn eval_expr_interval(checker: &TypeChecker, expr: &ASTNode) Interval {
    if checker == null || expr == null {
        return interval_invalid();
    }

    if expr.type == ASTNodeType.AST_CALL_EXPR {
        const token_index_capacity: i32 = constraint_call_returns_token_index_capacity(checker, expr);
        if token_index_capacity >= 0 {
            return interval_range(0, token_index_capacity);
        }
    }

    // 常量
    if expr.type == ASTNodeType.AST_NUMBER {
        return interval_const(expr.number_value);
    }

    // 变量
    if expr.type == ASTNodeType.AST_IDENTIFIER {
        const var_name: &byte = expr.identifier_name;
        if var_name != null {
            // 用成功标志区分「非常量」与「常量 -1」
            var const_ok: i32 = 0;
            const const_val: i32 = checker_eval_const_expr_ex(checker, expr, &const_ok);
            if const_ok != 0 {
                return interval_const(const_val);
            }
            return get_var_interval(checker, var_name);
        }
        return interval_invalid();
    }

    if expr.type == ASTNodeType.AST_MEMBER_ACCESS {
        const member_name: &byte = constraint_expr_name(checker, expr);
        const member_capacity: i32 = constraint_member_length_capacity(checker, expr);
        if member_name != null {
            const member_interval: Interval = get_var_interval(checker, member_name);
            if member_interval.is_valid != 0 {
                if member_capacity >= 0 {
                    var merged_min: i32 = member_interval.min;
                    var merged_max: i32 = member_interval.max;
                    if merged_min < 0 {
                        merged_min = 0;
                    }
                    if merged_max > member_capacity {
                        merged_max = member_capacity;
                    }
                    return interval_range(merged_min, merged_max);
                }
                return member_interval;
            }
        }
        if member_capacity >= 0 {
            return interval_range(0, member_capacity);
        }
        return interval_invalid();
    }

    // 类型转换
    if expr.type == ASTNodeType.AST_CAST_EXPR {
        const inner_expr: &ASTNode = expr.cast_expr_expr;
        if inner_expr != null {
            return eval_expr_interval(checker, inner_expr);
        }
        return interval_invalid();
    }

    if expr.type == ASTNodeType.AST_LEN {
        const len_val: i32 = checker_eval_const_expr(checker, expr);
        if len_val >= 0 {
            return interval_const(len_val);
        }
        return interval_invalid();
    }

    if expr.type == ASTNodeType.AST_CHAR {
        return interval_const(expr.char_literal_value);
    }

    // 一元运算：`i <= -1` 这类守卫的右操作数是 AST_UNARY_EXPR，
    // 旧实现直接判为无效区间，于是整条约束都不会被记录
    // （导致等价于 `i >= 0` 的下界证明失败）。
    if expr.type == ASTNodeType.AST_UNARY_EXPR {
        const u_op_tmp: !TokenType = expr.unary_expr_op as! TokenType;
        const u_op: TokenType = u_op_tmp.value;
        const operand_interval: Interval = eval_expr_interval(checker, expr.unary_expr_operand);
        if operand_interval.is_valid == 0 {
            return interval_invalid();
        }
        if u_op == TokenType.TOKEN_PLUS {
            return operand_interval;
        }
        if u_op == TokenType.TOKEN_MINUS {
            return interval_range(0 - operand_interval.max, 0 - operand_interval.min);
        }
        if u_op == TokenType.TOKEN_TILDE {
            // ~x 等价于 -x - 1
            return interval_range((0 - operand_interval.max) - 1, (0 - operand_interval.min) - 1);
        }
        if u_op == TokenType.TOKEN_EXCLAMATION {
            return interval_range(0, 1);
        }
        return interval_invalid();
    }

    // 二元运算
    if expr.type == ASTNodeType.AST_BINARY_EXPR {
        const op_tmp: !TokenType = expr.binary_expr_op as! TokenType;
        const op: TokenType = op_tmp.value;
        // 操作符 i32 快照：独立检查时枚举被多次读取会被判为「已被移动」。
        const op_code: i32 = op as i32;
        const left: &ASTNode = expr.binary_expr_left;
        const right: &ASTNode = expr.binary_expr_right;
        if op_code == TokenType.TOKEN_AMPERSAND as i32 {
            const right_const: i32 = checker_eval_const_expr(checker, right);
            if right_const >= 0 {
                return interval_range(0, right_const);
            }
            const left_const: i32 = checker_eval_const_expr(checker, left);
            if left_const >= 0 {
                return interval_range(0, left_const);
            }
        } else if op_code == TokenType.TOKEN_PERCENT as i32 {
            const mod_const: i32 = checker_eval_const_expr(checker, right);
            if mod_const > 0 {
                const left_mod_interval: Interval = eval_expr_interval(checker, left);
                if left_mod_interval.is_valid != 0 && left_mod_interval.min >= 0 {
                    if left_mod_interval.max < mod_const {
                        return interval_range(left_mod_interval.min, left_mod_interval.max);
                    }
                    return interval_range(0, mod_const - 1);
                }
            }
        }

        const left_interval: Interval = eval_expr_interval(checker, left);
        const right_interval: Interval = eval_expr_interval(checker, right);

        if left_interval.is_valid == 0 || right_interval.is_valid == 0 {
            return interval_invalid();
        }

        if op_code == TokenType.TOKEN_PLUS as i32 {
            return interval_add(left_interval, right_interval);
        } else if op_code == TokenType.TOKEN_MINUS as i32 {
            return interval_sub(left_interval, right_interval);
        } else if op_code == TokenType.TOKEN_ASTERISK as i32 {
            return interval_mul(left_interval, right_interval);
        } else if op_code == TokenType.TOKEN_SLASH as i32 {
            return interval_div(left_interval, right_interval);
        } else if op_code == TokenType.TOKEN_PERCENT as i32 {
            if right_interval.min == right_interval.max && right_interval.min > 0 && left_interval.min >= 0 {
                if left_interval.max < right_interval.min {
                    return interval_range(left_interval.min, left_interval.max);
                }
                return interval_range(0, ((right_interval.min as u32) - 1u) as i32);
            }
            return interval_invalid();
        } else if op_code == TokenType.TOKEN_AMPERSAND as i32 {
            return interval_bitand(left_interval, right_interval);
        } else if op_code == TokenType.TOKEN_LSHIFT as i32 {
            return interval_shl(left_interval, right_interval);
        } else if op_code == TokenType.TOKEN_RSHIFT as i32 {
            return interval_shr(left_interval, right_interval);
        }

        // 其他运算暂不支持
        return interval_invalid();
    }

    return interval_invalid();
}

// 验证表达式的数组访问边界（使用区间分析）
// 支持：非线性表达式（乘法、除法、移位等）
// 参数：expr - 索引表达式，array_size - 数组大小
// 返回：1 表示证明安全，0 表示无法证明
fn verify_expr_bounds_interval(checker: &TypeChecker, expr: &ASTNode, array_size: i32) i32 {
    if checker == null || expr == null {
        return 0;
    }

    // 对索引表达式进行区间求值
    const index_interval: Interval = eval_expr_interval(checker, expr);

    if index_interval.is_valid == 0 {
        return 0;
    }

    // 检查区间是否完全在有效范围内 [0, array_size)
    return interval_within_bounds(index_interval, 0, array_size);
}

fn constraint_value_implies_greater_than_offset(op: i32, val: i32, offset: i32) i32 {
    if op == CONSTRAINT_EQ || op == CONSTRAINT_GE {
        if val > offset {
            return 1;
        }
    } else if op == CONSTRAINT_GT {
        if val >= offset {
            return 1;
        }
    }
    return 0;
}

fn verify_linear_expr_upper_from_span_len(checker: &TypeChecker, linear_expr: &LinearExpr, array_size: i32) i32 {
    if checker == null || linear_expr == null || linear_expr.var_name == null || linear_expr.offset < 0 {
        return 0;
    }
    const start_name: &byte = linear_expr.var_name;
    const offset: i32 = linear_expr.offset;

    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const len_name: &byte = checker.constraint_var_names[i];
            if len_name != null {
                const op: i32 = checker.constraint_ops[i];
                const val: i32 = checker.constraint_values[i];
                if constraint_value_implies_greater_than_offset(op, val, offset) != 0 {
                    const sym: &Symbol = symbol_table_lookup(checker, len_name);
                    if sym != null && sym.decl_node != null && sym.decl_node.type == ASTNodeType.AST_VAR_DECL {
                        const init: &ASTNode = sym.decl_node.var_decl_init;
                        if init != null && init.type == ASTNodeType.AST_BINARY_EXPR {
                            const op_tmp: !TokenType = init.binary_expr_op as! TokenType;
                            const init_op: TokenType = op_tmp.value;
                            if init_op == TokenType.TOKEN_MINUS {
                                const start_expr: LinearExpr = extract_linear_expr(checker, init.binary_expr_right);
                                if start_expr.is_valid != 0 && start_expr.var_name != null &&
                                    start_expr.offset == 0 &&
                                    strcmp(start_expr.var_name as *byte, start_name as *byte) == 0 {
                                    const end_interval: Interval = eval_expr_interval(checker, init.binary_expr_left);
                                    if end_interval.is_valid != 0 && end_interval.max <= array_size {
                                        return 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// 验证线性表达式的数组访问边界
// 对于 expr = var + offset，验证 var >= -offset && var < size - offset
// 参数：linear_expr - 线性表达式，array_size - 数组大小，node - AST节点（用于错误报告）
// 返回：1 表示证明安全，0 表示无法证明
fn verify_linear_expr_bounds(checker: &TypeChecker, linear_expr: &LinearExpr, array_size: i32, node: &ASTNode) i32 {
    if checker == null || linear_expr == null || linear_expr.is_valid == 0 {
        return 0;
    }

    // 证明步数检查
    if checker_proof_step(checker, node) == 0 {
        return 1;  // 超限，已报告错误，返回1避免重复报告
    }

    // 纯常量：直接检查
    if linear_expr.var_name == null {
        if linear_expr.offset >= 0 && linear_expr.offset < array_size {
            return 1;
        }
        return 0;
    }

    // 变量 + 偏移量：需要检查调整后的边界
    // arr[i + offset] 安全需要: i >= -offset 且 i < size - offset
    const offset: i32 = linear_expr.offset;
    const var_name: &byte = linear_expr.var_name;
    const var_interval: Interval = get_var_interval(checker, var_name);

    var has_lower_bound: i32 = 0;
    var has_upper_bound: i32 = 0;

    // 计算需要的下界和上界
    const need_lower: i32 = -offset;  // i >= -offset
    // array_size - offset 与 -offset 均以 u32 回绕消除溢出 UB。
    const need_upper: i32 = ((array_size as u32) - (offset as u32)) as i32;  // i < size - offset

    // 端点反转不构成证明（证明不成立就不放行）。
    if var_interval.is_valid != 0 && var_interval.min <= var_interval.max &&
        var_interval.min >= need_lower && var_interval.max < need_upper {
        return 1;
    }

    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) == 0 {
                const op: i32 = checker.constraint_ops[i];
                const val: i32 = checker.constraint_values[i];

                // 检查下界：需要 i >= need_lower
                // 如果约束是 i >= val，需要 val >= need_lower（val 更强）
                if op == CONSTRAINT_GE && val >= need_lower {
                    has_lower_bound = 1;
                } else if op == CONSTRAINT_GT && val < 2147483647 && ((val as u32) + 1u) as i32 >= need_lower {
                    // i > val 等价于 i >= val + 1
                    has_lower_bound = 1;
                }

                // 检查上界：需要 i < need_upper
                // 如果约束是 i < val，需要 val <= need_upper（val 更强）
                if op == CONSTRAINT_LT && val <= need_upper {
                    has_upper_bound = 1;
                } else if op == CONSTRAINT_LE && val < 2147483647 && ((val as u32) + 1u) as i32 <= need_upper {
                    // i <= val 等价于 i < val + 1
                    has_upper_bound = 1;
                }
            }
        }
        i = i + 1;
    }

    if has_lower_bound != 0 && has_upper_bound != 0 {
        return 1;
    }
    if has_lower_bound != 0 && verify_linear_expr_upper_from_span_len(checker, linear_expr, array_size) != 0 {
        return 1;
    }
    return 0;
}

// 验证线性表达式的数组访问边界（扩展版本）
// 对于无符号类型索引，下界自动为 0
// 参数：linear_expr - 线性表达式，array_size - 数组大小，node - AST节点，is_unsigned - 是否是无符号类型
// 返回：1 表示证明安全，0 表示无法证明
fn verify_linear_expr_bounds_ex(checker: &TypeChecker, linear_expr: &LinearExpr, array_size: i32, node: &ASTNode, is_unsigned: i32) i32 {
    if checker == null || linear_expr == null || linear_expr.is_valid == 0 {
        return 0;
    }

    // 证明步数检查
    if checker_proof_step(checker, node) == 0 {
        return 1;  // 超限，已报告错误，返回1避免重复报告
    }

    // 纯常量：直接检查
    if linear_expr.var_name == null {
        if linear_expr.offset >= 0 && linear_expr.offset < array_size {
            return 1;
        }
        return 0;
    }

    // 变量 + 偏移量：需要检查调整后的边界
    // arr[i + offset] 安全需要: i >= -offset 且 i < size - offset
    const offset: i32 = linear_expr.offset;
    const var_name: &byte = linear_expr.var_name;
    const var_interval: Interval = get_var_interval(checker, var_name);

    var has_lower_bound: i32 = 0;
    var has_upper_bound: i32 = 0;

    // 对于无符号类型，下界自动为 0
    if is_unsigned != 0 {
        // 无符号类型：i >= 0 恒成立
        // 但仍需检查 i >= -offset（如果 offset < 0）
        if offset >= 0 {
            // offset >= 0: i >= 0 自动满足，i >= -offset 也自动满足
            has_lower_bound = 1;
        } else {
            // offset < 0: 需要 i >= -offset > 0
            // 这种情况下仍需检查约束
        }
    }

    // 计算需要的下界和上界
    const need_lower: i32 = -offset;  // i >= -offset
    // array_size - offset 与 -offset 均以 u32 回绕消除溢出 UB。
    const need_upper: i32 = ((array_size as u32) - (offset as u32)) as i32;  // i < size - offset

    // 端点反转不构成证明（证明不成立就不放行）。
    if var_interval.is_valid != 0 && var_interval.min <= var_interval.max &&
        var_interval.min >= need_lower && var_interval.max < need_upper {
        return 1;
    }

    var i: i32 = 0;
    const count: i32 = checker.constraint_count;
    while i < count {
        if i < MAX_CONSTRAINTS {
            const name: &byte = checker.constraint_var_names[i];
            if name != null && strcmp(name as *byte, var_name as *byte) == 0 {
                const op: i32 = checker.constraint_ops[i];
                const val: i32 = checker.constraint_values[i];

                // 检查下界：需要 i >= need_lower
                // 如果约束是 i >= val，需要 val >= need_lower（val 更强）
                if op == CONSTRAINT_GE && val >= need_lower {
                    has_lower_bound = 1;
                } else if op == CONSTRAINT_GT && val < 2147483647 && ((val as u32) + 1u) as i32 >= need_lower {
                    // i > val 等价于 i >= val + 1
                    has_lower_bound = 1;
                }

                // 检查上界：需要 i < need_upper
                // 如果约束是 i < val，需要 val <= need_upper（val 更强）
                if op == CONSTRAINT_LT && val <= need_upper {
                    has_upper_bound = 1;
                } else if op == CONSTRAINT_LE && val < 2147483647 && ((val as u32) + 1u) as i32 <= need_upper {
                    // i <= val 等价于 i < val + 1
                    has_upper_bound = 1;
                }
            }
        }
        i = i + 1;
    }

    // 对于无符号类型，如果 offset >= 0，下界已自动满足
    // 如果 offset < 0，需要显式检查约束
    if has_lower_bound != 0 && has_upper_bound == 0 {
        if verify_linear_expr_upper_from_span_len(checker, linear_expr, array_size) != 0 {
            has_upper_bound = 1;
        }
    }

    if has_lower_bound != 0 && has_upper_bound != 0 {
        return 1;
    }
    return 0;
}
