// checker/types.uya - 类型定义
// 从 checker.uya 拆分

use libc.atoi;
use std.string.strlen;
use libc.Stat;
use libc.stat;
use std.runtime.ptr_diff;
use std.string.strcat;
use std.string.strcpy;
use std.string.strrchr;
use std.mem.memcpy;

// ===== 常量定义 =====

const MAX_ERROR_NAMES: i32 = 1024;
const MAX_MOVED_NAMES: i32 = 128;
const MONO_INSTANCE_INITIAL_CAPACITY: i32 = 64;
const MAX_UNION_VARIANTS: i32 = 32;
const MAX_INTERFACE_METHODS: i32 = 128;
const MAX_INTERFACE_STACK: i32 = 64;
const MAX_BASE_NAME_LEN: i32 = 256;
const MAX_MONO_NAME_LEN: i32 = 256;
const MAX_MONO_NAME_LIMIT: i32 = 250;
const MAX_POINTER_NAMES: i32 = 32;
const MAX_CONSTRAINTS: i32 = 64;
const MAX_ASYNC_CALL_EDGES: i32 = 512;
// 顶层函数 call edge 表的**初始**容量（不再是上限：满了按 2 倍增长，
// 见 checker_grow_call_edges）。数值沿用历史值 —— 小工程不发生扩容。
const MAX_FN_CALL_EDGES: i32 = 16384;
const MAX_FN_ROOTS: i32 = 8192;
const MAX_REACHABLE_FN_DECLS: i32 = 8192;
// 顶层可达性 visited 集的**初始**容量（不再是上限：负载因子超过 3/4 时容量翻倍
// 并整表 rehash，见 checker_reachability_visit_grow）。数值沿用历史值 ——
// 小工程不发生扩容，与改动前逐字节一致。
//
// 为什么必须可扩容：自举编译一次可达性遍历要访问一百多万个 AST 节点，定长表在
// 负载趋近 1 时成功查找的平均探测长度 ~1/(1-α)；最后 1% 的插入每次要扫十几万
// 个槽位，实测 `uya check` 有 39% 的时间耗在这个探测回边上。表满之后原实现还会
// `return 1` 假装「没访问过」，visited 集彻底失效，共享子树被反复重走。
const REACHABILITY_VISIT_INITIAL_SLOTS: i32 = 262144;

// ===== 各表的**初始**容量 =====
// 不再是「上限」：表满了会按 DYN_TABLE_GROW_FACTOR 倍增并 rehash（见 dyn_table.uya）。
// 数值刻意与历史值相同 —— 小工程不发生扩容，容量与性能与改动前逐字节一致。
const SYMBOL_TABLE_SIZE: i32 = 32768;   // symbol_table 初始容量
// 作用域内名字哈希桶：每层 512 个桶，最多 64 层嵌套（与 scope_heads 同界）。
// 32768 = 64 * 512，见 TypeChecker.scope_buckets。
const SYMBOL_SCOPE_BUCKET_COUNT: i32 = 512;
const SYMBOL_SCOPE_BUCKET_MASK: i32 = 511;
const SYMBOL_SCOPE_BUCKET_SLOTS: i32 = 32768;
const FUNCTION_TABLE_SIZE: i32 = 8192;  // function_table 初始容量
const MODULE_TABLE_SIZE: i32 = 256;     // module_table 初始容量
const IMPORT_TABLE_SIZE: i32 = 512;     // import_table 初始容量
const STRING_POOL_SIZE: i32 = 16384;    // 字符串池初始桶数

// ===== 类型枚举 =====

enum TypeKind {
    TYPE_I8,
    TYPE_I16,
    TYPE_I32,
    TYPE_I64,
    TYPE_U8,
    TYPE_U16,
    TYPE_U32,
    TYPE_USIZE,
    TYPE_U64,
    TYPE_BOOL,
    TYPE_BYTE,
    TYPE_F32,
    TYPE_F64,
    TYPE_VOID,
    TYPE_ENUM,
    TYPE_INTERFACE,
    TYPE_STRUCT,
    TYPE_UNION,
    TYPE_POINTER,
    TYPE_ARRAY,
    TYPE_SLICE,
    TYPE_TUPLE,
    TYPE_ERROR_UNION,
    TYPE_ERROR,
    TYPE_INT_LIMIT,
    TYPE_ATOMIC,
    TYPE_VECTOR,
    TYPE_MASK,
    TYPE_GENERIC_PARAM,
    // @asm 寄存器类型
    TYPE_ASM_REG,          // 通用寄存器（编译器自动分配）
    TYPE_ASM_REG_X64,      // x86-64 通用寄存器
    TYPE_ASM_REG_X86,      // x86 通用寄存器
    TYPE_ASM_REG_ARM64,    // ARM64 通用寄存器
    TYPE_ASM_REG_RISCV,    // RISC-V 通用寄存器
    // @asm SIMD 寄存器类型
    TYPE_ASM_REG_X64_XMM,  // x86-64 SSE (128-bit)
    TYPE_ASM_REG_X64_YMM,  // x86-64 AVX/AVX2 (256-bit)
    TYPE_ASM_REG_X64_ZMM,  // x86-64 AVX-512 (512-bit)
    TYPE_ASM_REG_ARM64_V,  // ARM64 NEON (128-bit)
    TYPE_ASM_REG_RISCV_V,  // RISC-V V 扩展 (可变长度向量)
    TYPE_ASM_REG_RISCV_F,  // RISC-V F 扩展 (单精度浮点)
    TYPE_ASM_REG_RISCV_D,  // RISC-V D 扩展 (双精度浮点)
    // @asm 内存操作类型
    TYPE_ASM_MEM,          // 内存操作数
    // va_list 内置类型
    TYPE_VA_LIST,          // 可变参数列表类型（平台相关大小）
}

// ===== 类型数据辅助结构体（阶段四：Union 化重构）=====

// 指针类型数据
struct PointerData {
    pointee: &Type,
    is_ffi: i32,
}

// 数组类型数据
struct ArrayData {
    element: &Type,
    size: i32,
}

// 切片类型数据
struct SliceData {
    element: &Type,
    len: i32,
}

// 元组类型数据
struct TupleData {
    elements: &Type,
    count: i32,
}

// 错误联合类型数据
struct ErrorUnionData {
    payload: &Type,
    error_id: u32,
}

// 原子类型数据
struct AtomicData {
    inner: &Type,
}

// 泛型参数数据
struct GenericParamData {
    name: &byte,
}

// 结构体泛型数据
struct StructGenericData {
    name: &byte,
    type_args: &Type,
    type_arg_count: i32,
}

// 类型数据联合体（Tagged Union，类型安全）
// 注意：虽然有额外的标签开销，但提供类型安全
// Type.kind 字段用于区分类型，可以视为冗余但无害
union TypeData {
    named: &byte,                 // TYPE_ENUM, TYPE_STRUCT, TYPE_UNION, TYPE_INTERFACE 的名称
    pointer: PointerData,         // TYPE_POINTER
    array: ArrayData,             // TYPE_ARRAY
    slice: SliceData,             // TYPE_SLICE
    tuple: TupleData,             // TYPE_TUPLE
    error_union: ErrorUnionData,  // TYPE_ERROR_UNION
    atomic_data: AtomicData,      // TYPE_ATOMIC (atomic 是关键字)
    generic_param: GenericParamData, // TYPE_GENERIC_PARAM
    struct_generic: StructGenericData, // TYPE_STRUCT 带泛型参数
}

// ===== 类型结构 =====

struct Type {
    kind: TypeKind,
    data: TypeData,  // 新增：union 类型数据
    // === 以下为过渡期保留的旧字段（迁移完成后移除）===
    // @deprecated: 使用 data 访问
    enum_name: &byte,
    interface_name: &byte,
    interface_type_args: &Type,
    interface_type_arg_count: i32,
    struct_name: &byte,
    union_name: &byte,
    pointer_to: &Type,
    is_ffi_pointer: i32,
    element_type: &Type,
    array_size: i32,
    slice_element_type: &Type,
    slice_len: i32,
    slice_element_is_const: i32,
    tuple_element_types: &Type,
    tuple_count: i32,
    error_union_payload_type: &Type,
    error_error_id: u32,
    atomic_inner_type: &Type,
    generic_param_name: &byte,
    struct_type_args: &Type,
    struct_type_arg_count: i32,
    union_type_args: &Type,
    union_type_arg_count: i32,
    // 命名类型的 canonical 声明节点（struct/interface/union/enum）。
    // 用于按声明身份识别特殊类型（如 Pipeline），不依赖未限定名字符串。
    decl_node: &ASTNode,
}

struct Symbol {
    name: &byte,
    // `hash_string(name)` 的缓存，0 表示尚未计算。插入时（symbol_table_insert）
    // 算一次落盘，作用域桶查找先用它做整数比较，相等才去碰 name 的字节 ——
    // `str_equals` 的首字节访问在自举编译里几乎必然 L1 miss（名字散落在 400 MB
    // 的 arena 里），是检查器最大的单点开销。
    name_hash: i32,
    type: Type,
    is_const: i32,
    is_initialized: i32,
    scope_level: i32,
    line: i32,
    column: i32,
    pointee_of: &byte,
    decl_node: &ASTNode,
    next_in_scope: &Symbol,  // 同一作用域的下一个符号（用于快速遍历）
    next_in_bucket: &Symbol,  // 同一作用域内同一哈希桶的下一个符号（见 TypeChecker.scope_buckets）
    pointer_known_length: i32,  // 指针已知长度（如 *byte = "ab" 为 3），-1 表示未知；用于 --safety-proof 时下标边界证明
    pointer_length_param: &byte,  // 若为函数参数且与下一参数成 (ptr, len) 对，则为 len 参数名，否则 null；有此时允许 ptr[i] 作长度证明
    // 跨函数后置事实（B4）：该变量的值来自某个「下标或 -1」语义函数的返回值时，
    // 记下那个函数承诺的上界 N（`值 >= 0` 时必有 `值 < N`），否则 0。
    //
    // 用法上有两条硬约束：
    //   ①只能在 `if v >= 0` 的 **then 分支内**把它变成 `v < N` 的约束
    //     （见 lifetime_apply_post_index_bound），绝不能在赋值点无条件加 ——
    //     那样 `a[v]` 在 v == -1 的路径上也会被放行，反而制造 UB。
    //   ②约束随分支一起回滚（main.uya 的 if 处理本来就这么做），逃不出分支。
    post_index_upper: i32,
    // 声明该符号的作用域 id（见 TypeChecker.scope_id_seq）。
    //
    // scope_level 只能区分「第几层」，无法区分同一层级的两次进入（循环体每轮复用
    // 同一 scope_level）。跨函数证明的 origin 格需要「LOCAL(a) 是否活得比 LOCAL(b)
    // 久」这种比较，同层的两次进入必须能分开，所以另开一个单调递增的作用域 id。
    // 0 表示尚未记录（顶层或未接线路径），比较时按最外层处理。
    scope_id: i32,
}

struct FunctionSignature {
    name: &byte,
    param_types: &Type,
    param_count: i32,
    return_type: Type,
    is_extern: i32,
    is_varargs: i32,
    line: i32,
    column: i32,
    // 声明所属模块文件。函数表按名索引且可容纳不同模块的同名函数，
    // 查找时据此优先返回调用点所在模块的签名。
    filename: &byte,
    // 该签名的 `AST_FN_DECL` 声明节点。
    // 跨函数证明需要读被调方的**函数体**才能算出 requirement 摘要
    // （如「该形参会被直接解引用、且全文无 null 守卫」），而签名表里只有类型。
    // extern / 接口声明没有函数体，此时为 null。
    decl_node: &ASTNode,
}

// 五张表都是**动态哈希表**（见 checker/dyn_table.uya 的文件头注释）：
// 旧的 SYMBOL_TABLE_SIZE / FUNCTION_TABLE_SIZE / MODULE_TABLE_SIZE / IMPORT_TABLE_SIZE /
// STRING_POOL_SIZE 现在是**初始容量**，不再是上限 —— 装不下就 2 倍扩容 rehash。
// 保留这些常量名与数值：小工程的容量、内存画像与性能与改动前**完全一致**。
//
// 表本身是**非泛型**的字节缓冲表（DynTable 在构造时拿 elem_size = @size_of(元素)），
// 元素类型只在各表的 accessor 里出现 —— 见 checker_function_slot_at 的注释。
struct SymbolTable {
    table: DynTable,
}

struct FunctionTable {
    table: DynTable,
}

struct ExportedItem {
    name: &byte,
    decl_node: &ASTNode,
    module_name: &byte,
    item_type: i32,
}

struct ModuleDependency {
    target_module: &byte,
    use_stmt_node: &ASTNode,
}

struct ModuleInfo {
    module_name: &byte,
    filename: &byte,
    exports: &ExportedItem,
    export_count: i32,
    // `exports` 的已分配容量。每加一条导出就把整块重分配并复制是 O(n²)：
    // callgrind 里 `memcpy'append_module_export` 单独占 5.7% 的指令数。
    export_capacity: i32,
    dependencies: &ModuleDependency,
    dependency_count: i32,
}

struct ModuleTable {
    table: DynTable,
}

struct ImportedItem {
    local_name: &byte,
    original_name: &byte,
    module_name: &byte,
    item_type: i32,
}

struct ImportTable {
    table: DynTable,
}

// 字符串池条目
struct StringPoolEntry {
    str: &byte,           // 字符串指针
    hash: i32,            // 哈希值（用于快速比较）
    next: &StringPoolEntry, // 链表下一个（哈希冲突时）
}

// 字符串池（用于字符串 intern）。
// 桶链形态不变（StringPoolEntry.next 拉链），只把桶数组从定长 16384 换成动态的：
// 桶数按负载因子倍增，扩容时把每条链按新桶号重挂（见 string_pool_intern 的 ensure）。
struct StringPool {
    buckets: & &StringPoolEntry,   // 哈希桶
    bucket_count: i32,
    count: i32,
}

struct MonoInstance {
    generic_name: &byte,
    type_args: &Type,
    type_arg_nodes: & & ASTNode,
    type_arg_count: i32,
    is_function: i32,
}

struct TypeChecker {
    arena: &CompilerArena,
    symbol_table: SymbolTable,
    function_table: FunctionTable,
    module_table: ModuleTable,
    import_table: ImportTable,
    string_pool: StringPool,  // 字符串池
    scope_level: i32,
    // 作用域 id 发号器：每次 checker_enter_scope 递增一次，产生的 id 记进
    // Symbol.scope_id。与 scope_level 的区别见 Symbol.scope_id 的注释。
    // 0 保留给「未记录」，所以从 LIFETIME_SCOPE_ID_BASE 起发号。
    scope_id_seq: i32,
    // 当前作用域 id 栈：作用域索引（同 scope_level）→ 该层最近一次进入的 id。
    // exit 时用它把 scope_id_seq 回退，避免同一层级每轮循环都涨号。
    scope_id_stack: [i32: 64],
    loop_depth: i32,
    program_node: &ASTNode,
    error_count: i32,
    last_reported_error_filename: &byte,
    last_reported_error_message: &byte,
    last_reported_error_line: i32,
    last_reported_error_column: i32,
    default_filename: &byte,
    current_return_type: Type,
    in_function: i32,
    in_defer_or_errdefer: i32,
    current_function_decl: &ASTNode,
    current_self_type_name: &byte,
    current_self_is_union: i32,
    suppress_codegen_diagnostics: i32,
    error_names: [&byte: MAX_ERROR_NAMES],
    error_hashes: [u32: MAX_ERROR_NAMES],
    error_name_count: i32,
    moved_names: [&byte: 128],
    moved_count: i32,
    // 成员访问链深度：推断 `expr.field` 期间 > 0，用于把「已移动」判定从
    // 裸标识符扩到访问链根（`h.buf.data` 里的 `h`）。
    // 见 symbols.uya 的 checker_moved_access_root / moved_access_path_set。
    member_access_depth: i32,
    module_root_dir: &byte,
    uya_root_dir: &byte,
    current_type_params: &TypeParam,
    current_type_param_count: i32,
    // 单态化 lowering 用的临时类型替换：把类型参数名（如 T）替换成具体类型。
    // 只有 subst_active != 0 时生效，lowering 结束会清掉。
    subst_active: i32,
    subst_name: &byte,
    subst_type: Type,
    mono_instances: &MonoInstance,
    mono_instance_count: i32,
    mono_instance_capacity: i32,
    constraint_var_names: [&byte: 64],
    constraint_ops: [i32: 64],
    constraint_values: [i32: 64],
    constraint_count: i32,
    pointer_nonnull_names: [&byte: 32],
    pointer_nonnull_count: i32,
    pointer_nullable_names: [&byte: 32],
    pointer_nullable_count: i32,
    enable_safety_proof: i32,
    // --strict-overflow：普通上下文的整数算术必须能证明无溢出，否则报编译错误。
    // 默认 0（关闭），避免一次性砸坏存量代码；分阶段迁移见 buglist.md。
    strict_overflow: i32,
    // 1 = 循环体里被赋值的变量，进入循环时清掉它的外部约束（下标证明的
    // 循环不动点近似）。默认 0：打开后存量代码会有一批真实越界报出来，
    // 迁移是独立工作项（见 buglist P0「数组边界证明对循环里被改写的变量不生效」）。
    strict_loop_bounds: i32,
    // --strict-div：整数 `/` 与 `%` 的除数必须能证明非零（规范 §14.2 的除零正确性证明）。
    // 默认 0（关闭）：存量库大量依赖「调用方保证非零」的跨函数不变量，证明器无法表达。
    strict_div: i32,
    // 抑制计数：>0 时跳过溢出闸门判定。
    suppress_overflow_gate: i32,
    // --lifetime-report：输出跨函数证明的度量报告（只算不报）。
    // 见 docs/interprocedural_proof_plan.md §6.2 的字段定义。
    lifetime_report: i32,
    // 度量计数器（lifetime_report != 0 时才累加；报告出口在 checker_lifetime_report_flush）。
    lifetime_req_total: i32,
    lifetime_req_param_null: i32,   // 形参「非空」义务总数（B2 受影响面）
    lifetime_req_div_zero: i32,     // 除数「非零」义务总数（B3 受影响面）
    lifetime_req_resolved: i32,     // 已消解（任一桶）
    lifetime_req_unresolved: i32,   // 未消解（Pass C 候选误报）
    lifetime_returns_local: i32,    // return 返回指向局部存储的站点数（B1 受检面）
    lifetime_fn_count: i32,         // 已扫过的函数体数量
    lifetime_summary_fail: i32,     // 摘要降级为 unknown 的次数
    // 调用点摘要消解率的分母 / 分子（--lifetime-report）：遍历函数体时对每个调用
    // 表达式求一次 origin，给出非 UNKNOWN 来源的算「消解」。说明见
    // lifetime_account_escape_sites（这两个数字此前从未被真正统计过）。
    lifetime_summary_calls: i32,    // 被求过 origin 的调用点总数
    lifetime_summary_resolved: i32, // 其中给出非 UNKNOWN 来源的数量
    // --escape-list：逐站点打印逃逸口明细（`[escape] kind file:line`），只列不报。
    // 汇总计数（下面的 escapes 组）回答「有多少」，本开关回答「在哪」——
    // 白名单冻结与 CI 闸门用的是后者（见 docs/unsafe_audit_plan.md §3）。
    escape_list: i32,
    // ===== 逃逸口登记（--lifetime-report 的 escapes 段）=====
    //
    // 「不安全之处必须显式」这条主线的前提是**知道不安全之处在哪、有多少、能不能冻结**。
    // 下面这组计数器把编译器眼里所有能绕过证明的构造按类别数出来（只数不报），
    // 供 `--lifetime-report` 输出、供白名单 diff、供 CI 冻结基线。
    // 详见 docs/unsafe_audit_plan.md。
    lifetime_escape_extern_fn: i32,     // extern "lib" fn 声明（信任边界，编译器不看实现）
    lifetime_escape_extern_var: i32,    // extern 变量声明（同上）
    lifetime_escape_asm: i32,           // @asm 内联汇编块
    lifetime_escape_union: i32,         // union 声明（各变体共享存储，类型系统不跟踪活跃变体）
    lifetime_escape_extern_union: i32,  // extern union（直接映射 C union）
    lifetime_escape_ptr_int: i32,       // 真正的整数↔指针桥：@ptr_from_usize / @usize_from_ptr / 指针→usize
    lifetime_escape_ptr_cast: i32,      // 指针换类型（`"fmt" as *byte`、`p as &void`）：来源未变，属债不属洞
    lifetime_escape_alloc: i32,         // 指向 malloc/free/calloc/realloc 的调用（所有权面）
    // 上一次就「null 实参」报错过的调用节点。
    // checker_infer_type 对同一表达式可能被调用多次（求类型 + 校验各一遍），
    // 没有这个标记会把同一条诊断打两遍。只记最近一个节点足够：
    // 重复推导总是紧接着发生，中间不会插入另一个待报错的调用节点。
    lifetime_last_null_arg_node: &ASTNode,
    // B4 后置事实摘要的扫描累加器（见 lifetime_scan_guarded_returns）。
    // 做成 checker 上的临时字段而不是出参，是为了把扫描函数的参数控制在 4 个以内
    // （AGENTS.md：超过 5 个参数优先拆分）。每次调用摘要前由调用方清零。
    lifetime_scan_good: i32,        // 受 `v < N` 守卫的 `return v` 站点数
    lifetime_scan_bad: i32,         // 无法归类（既不是负数哨兵也不是受守卫的 v）的 return 站点数
    // 已识别的 checked 算术根（try/catch 的操作数）。闸门对这些根的整棵子树豁免：
    // 那部分由运行时 checked 检查负责，不该再被静态闸门拦一次。
    // 按函数重置（见 checker_reset_proof_steps）。
    checked_arith_roots: [&ASTNode: 64],
    checked_arith_root_count: i32,
    container_mode: i32,        // 1 = microapp 模式: 禁止 @asm/extern
    proof_step_limit: i32,
    proof_step_count: i32,
    // 作用域链表头数组：每个作用域的符号链表头
    // 用于快速遍历当前作用域的符号，避免遍历整个符号表
    scope_heads: [&Symbol: 64],  // 支持最多 64 层嵌套作用域
    // 作用域内「名字哈希 → 符号」的桶头：`scope_buckets[level*512 + (hash&511)]`。
    //
    // 有了它，符号查找在第 level 层只扫 1~2 个桶，而不是整条作用域链。
    // 这是检查器最大的单点开销：链上每跳都要读一个散落在 arena 里的 Symbol
    // （几乎必然 L1 miss），自举编译一次 `uya check` 里这个循环占 30% 采样。
    scope_buckets: [&Symbol: SYMBOL_SCOPE_BUCKET_SLOTS],
    // 异步函数调用图（用于在完整状态机大小计算前先检测 async 调用环）
    async_call_edge_from: [&byte: MAX_ASYNC_CALL_EDGES],
    async_call_edge_to: [&byte: MAX_ASYNC_CALL_EDGES],
    async_call_edge_count: i32,
    // 顶层函数可达性（由 checker 收集，codegen 只消费结果）
    // 边表是**按需增长**的指针表（初始 MAX_FN_CALL_EDGES，满了 2 倍扩容）——
    // 见 checker_grow_call_edges。原先它是定长数组，装不下就报「容量已满」并
    // 让整个工程编不过（uya-agent 实测只剩 48 条边的余量）。
    fn_call_edge_from: &(&ASTNode),
    fn_call_edge_to: &(&ASTNode),
    fn_call_edge_count: i32,
    fn_call_edge_capacity: i32,
    fn_root_decls: [&ASTNode: MAX_FN_ROOTS],
    fn_root_count: i32,
    reachable_fn_decls: [&ASTNode: MAX_REACHABLE_FN_DECLS],
    reachable_fn_decl_count: i32,
    reachability_visit_count: i32,
    // 可达性 visited 集：arena 拥有的开放寻址槽位表（元素是指针）+ 容量。
    // 容量恒为 2 的幂；0 表示尚未分配（见 checker_reachability_visit_ensure）。
    reachability_visit_capacity: i32,
    reachability_visit_table: &(&ASTNode),
    async_frame_metas: &AsyncFrameMeta,
    async_frame_meta_count: i32,
    async_frame_meta_capacity: i32,
    // canonical Pipeline 类型声明节点（std.process.Pipeline）。
    // 由 checker_resolve_pipeline_decl 延迟解析并缓存。
    pipeline_decl: &ASTNode,
    // pipeline 链类型检查嵌套深度；用于把最左侧变量 moved 标记推迟到最外层 pipeline。
    pipeline_chain_depth: i32,
}
