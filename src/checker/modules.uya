// checker/modules.uya - 模块系统函数
// 从 main.uya 拆分
// 包含：模块路径提取、模块表管理、use 语句处理、循环依赖检测

// 从项目根目录提取模块路径
fn extract_module_from_project_root(checker: &TypeChecker, filename: &byte) &byte {
    if checker.project_root_dir == null {
        return null;
    }
    
    const root_len: usize = strlen(checker.project_root_dir as *byte);
    if strncmp(filename as *byte, checker.project_root_dir as *byte, root_len) != 0 {
        return null;
    }
    
    const relative_path: &byte = (filename as *byte + root_len) as &byte;
    var first_slash: *byte = strchr(relative_path as *byte, 47);
    if first_slash == null {
        first_slash = strchr(relative_path as *byte, 92);
    }
    
    if first_slash == null {
        const main_str: &byte = "main" as *byte;
        return checker_arena_strdup(checker.arena, main_str);
    }
    
    var last_slash: *byte = strrchr(relative_path as *byte, 47);
    if last_slash == null {
        last_slash = strrchr(relative_path as *byte, 92);
    }
    
    if last_slash == null {
        const main_str: &byte = "main" as *byte;
        return checker_arena_strdup(checker.arena, main_str);
    }
    
    const dir_start: &byte = relative_path;
    const dir_end: *byte = last_slash;
    var total_len: usize = 0;
    var p: &byte = dir_start;
    var dir_count: i32 = 0;
    while (p as *byte) < dir_end {
        var next_slash: *byte = strchr(p as *byte, 47);
        if next_slash == null {
            next_slash = strchr(p as *byte, 92);
        }
        if next_slash == null || next_slash >= dir_end {
            next_slash = dir_end;
        }
        
        const dir_len: usize = ptr_diff(next_slash, p as *byte) as usize;
        if dir_len > 0 {
            total_len = total_len + dir_len;
            if dir_count > 0 {
                total_len = total_len + 1;
            }
            dir_count = dir_count + 1;
        }
        
        if next_slash >= dir_end {
            break;
        }
        p = (next_slash + 1) as &byte;
    }
    
    if dir_count == 0 {
        const main_str: &byte = "main" as *byte;
        return checker_arena_strdup(checker.arena, main_str);
    }
    
    const module_name: &byte = arena_alloc(checker.arena, total_len + 1) as &byte;
    if module_name == null {
        return null;
    }
    
    var dst: &byte = module_name;
    p = dir_start;
    dir_count = 0;
    while (p as *byte) < dir_end {
        var next_slash: *byte = strchr(p as *byte, 47);
        if next_slash == null {
            next_slash = strchr(p as *byte, 92);
        }
        if next_slash == null || next_slash >= dir_end {
            next_slash = dir_end;
        }
        
        const dir_len: usize = ptr_diff(next_slash, p as *byte) as usize;
        if dir_len > 0 {
            if dir_count > 0 {
                dst[0] = 46;
                dst = &dst[1];
            }
            memcpy(dst as *void, p as *void, dir_len);
            dst = &dst[dir_len];
            dir_count = dir_count + 1;
        }
        
        if next_slash >= dir_end {
            break;
        }
        p = (next_slash + 1) as &byte;
    }
    dst[0] = 0;
    
    return module_name;
}

// 从 lib/xxx/ 目录提取模块名
fn extract_module_from_lib_general(checker: &TypeChecker, filename: &byte) &byte {
    var lib_general: *byte = strstr(filename as *byte, "/lib/" as *byte);
    if lib_general == null {
        lib_general = strstr(filename as *byte, "lib/" as *byte);
    }
    if lib_general == null {
        return null;
    }
    
    var rel: &byte = lib_general as &byte;
    if rel[0] == 47 {
        rel = &rel[1];
    }
    if strncmp(rel as *byte, "lib/" as *byte, 4) != 0 {
        return null;
    }
    
    rel = &rel[4];
    const rel_len: usize = strlen(rel as *byte);
    var module_name_len: usize = rel_len;
    var si: usize = 0;
    while si < rel_len {
        if rel[si] == 47 || rel[si] == 92 {
            module_name_len = si;
            break;
        }
        si = si + 1;
    }
    
    if module_name_len == rel_len && rel_len > 4 {
        module_name_len = rel_len - 4;
    }
    if module_name_len == 0 {
        return null;
    }
    
    const module_name: &byte = arena_alloc(checker.arena, module_name_len + 1) as &byte;
    if module_name != null {
        memcpy(module_name as *void, rel as *void, module_name_len);
        module_name[module_name_len] = 0;
    }
    return module_name;
}

// 从 lib/std/c/ 目录提取模块名（旧代码路径）
fn extract_module_from_lib_std_c(checker: &TypeChecker, filename: &byte) &byte {
    var lib_std_c: *byte = strstr(filename as *byte, "/lib/std/c/" as *byte);
    if lib_std_c == null {
        lib_std_c = strstr(filename as *byte, "lib//std/c/" as *byte);
    }
    if lib_std_c == null {
        lib_std_c = strstr(filename as *byte, "/lib//std/c/" as *byte);
    }
    if lib_std_c == null {
        return null;
    }
    
    var relative_path: *byte = lib_std_c;
    if relative_path[0] == 47 {
        relative_path = relative_path + 1;
    }
    
    if strncmp(relative_path, "lib//std/c/" as *byte, 10) == 0 {
        relative_path = relative_path + 10;
        const module_name: &byte = arena_alloc(checker.arena, 7) as &byte;
        if module_name != null {
            memcpy(module_name as *void, "libc" as *void, 4);
            module_name[4] = 46;
            memcpy(module_name as *byte + 5, relative_path as *void, 1);
            module_name[6] = 0;
            return module_name;
        }
    } else if strncmp(relative_path, "lib/std/c/" as *byte, 9) == 0 {
        relative_path = relative_path + 9;
        const module_name: &byte = arena_alloc(checker.arena, 7) as &byte;
        if module_name != null {
            memcpy(module_name as *void, "libc" as *void, 4);
            module_name[4] = 46;
            memcpy(module_name as *byte + 5, relative_path as *void, 1);
            module_name[6] = 0;
            return module_name;
        }
    }
    return null;
}

// 从文件名和目录名构建模块名
fn build_module_name_from_path(checker: &TypeChecker, filename: &byte, dir_start: &byte, dir_end: &byte, name_start: &byte, name_end: &byte) &byte {
    const dir_len: usize = ptr_diff(dir_end as *byte, dir_start as *byte) as usize;
    const name_len: usize = ptr_diff(name_end as *byte, name_start as *byte) as usize;
    const total_len: usize = dir_len + 1 + name_len;
    
    const module_name: &byte = arena_alloc(checker.arena, total_len + 1) as &byte;
    if module_name == null {
        return null;
    }
    
    memcpy(module_name as *void, dir_start as *void, dir_len);
    module_name[dir_len] = 46;
    memcpy(module_name as *byte + dir_len + 1, name_start as *void, name_len);
    module_name[total_len] = 0;
    return module_name;
}

// 从 lib 或 src 目录提取模块名
fn extract_module_from_lib_or_src(checker: &TypeChecker, filename: &byte, dir_start: &byte, dir_end: &byte, name_start: &byte, name_end: &byte) &byte {
    const dir_len: i32 = ptr_diff(dir_end as *byte, dir_start as *byte) as i32;
    const is_lib: i32 = (dir_len == 3 && strncmp(dir_start as *byte, "lib" as *byte, 3) == 0) as i32;
    const is_src: i32 = (dir_len == 3 && strncmp(dir_start as *byte, "src" as *byte, 3) == 0) as i32;
    
    if is_lib != 0 || is_src != 0 {
        const name_len: usize = ptr_diff(name_end as *byte, name_start as *byte) as usize;
        const module_name: &byte = arena_alloc(checker.arena, name_len + 1) as &byte;
        if module_name != null {
            memcpy(module_name as *void, name_start as *void, name_len);
            module_name[name_len] = 0;
        }
        return module_name;
    }
    return null;
}

// 从文件名提取目录和文件名信息
fn extract_file_components(filename: &byte, name_start: &&byte, name_end: &&byte, dir_start: &&byte, dir_end: &&byte) i32 {
    var name_start_local: &byte = null;
    var name_start_temp: *byte = strrchr(filename as *byte, 47 as byte);
    if name_start_temp == null {
        name_start_temp = strrchr(filename as *byte, 92 as byte);
    }
    if name_start_temp != null {
        name_start_local = (name_start_temp + 1) as &byte;
    } else {
        name_start_local = filename;
    }
    name_start[0] = name_start_local;
    
    var name_end_local: &byte = null;
    var name_end_temp: *byte = strrchr(name_start_local as *byte, 46 as byte);
    if name_end_temp == null {
        name_end_temp = name_start_local as *byte + strlen(name_start_local as *byte);
    }
    name_end_local = name_end_temp as &byte;
    name_end[0] = name_end_local;
    
    var dir_end_local: &byte = null;
    var dir_end_temp: *byte = strrchr(filename as *byte, 47 as byte);
    if dir_end_temp == null {
        dir_end_temp = strrchr(filename as *byte, 92 as byte);
    }
    dir_end_local = dir_end_temp as &byte;
    dir_end[0] = dir_end_local;
    return 0;
}

// 从文件名提取模块名（通用情况）
fn extract_module_from_filename_generic(checker: &TypeChecker, filename: &byte) &byte {
    var name_start: &byte = null;
    var name_end: &byte = null;
    var dir_start: &byte = null;
    var dir_end: &byte = null;
    
    extract_file_components(filename, &name_start, &name_end, &dir_start, &dir_end);
    
    if dir_end == null || dir_end as *byte == null {
        const name_len: usize = ptr_diff(name_end as *byte, name_start as *byte) as usize;
        const module_name: &byte = arena_alloc(checker.arena, name_len + 1) as &byte;
        if module_name != null {
            memcpy(module_name as *void, name_start as *void, name_len);
            module_name[name_len] = 0;
        }
        return module_name;
    }
    
    dir_start = dir_end;
    while dir_start as *byte > filename as *byte && dir_start as *byte > filename as *byte && (dir_start as *byte)[-1] != 47 && (dir_start as *byte)[-1] != 92 {
        dir_start = ((dir_start as *byte) - 1) as &byte;
    }
    
    const from_lib_src: &byte = extract_module_from_lib_or_src(checker, filename, dir_start, dir_end, name_start, name_end);
    if from_lib_src != null {
        return from_lib_src;
    }
    
    return build_module_name_from_path(checker, filename, dir_start, dir_end, name_start, name_end);
}

// 提取模块路径（从文件名）
fn extract_module_path_allocated(checker: &TypeChecker, filename: &byte) &byte {
    if checker == null || filename == null {
        return null;
    }
    
    const from_root: &byte = extract_module_from_project_root(checker, filename);
    if from_root != null {
        return from_root;
    }
    
    const from_lib: &byte = extract_module_from_lib_general(checker, filename);
    if from_lib != null {
        return from_lib;
    }
    
    const from_lib_std_c: &byte = extract_module_from_lib_std_c(checker, filename);
    if from_lib_std_c != null {
        return from_lib_std_c;
    }
    
    return extract_module_from_filename_generic(checker, filename);
}

// 查找或创建模块信息
fn find_or_create_module(checker: &TypeChecker, module_name: &byte, filename: &byte) &ModuleInfo {
    if checker == null || module_name == null {
        return null;
    }
    
    const hash: i32 = hash_string(module_name);
    var index: i32 = hash & (MODULE_TABLE_SIZE - 1);
    
    var i: i32 = 0;
    while i < MODULE_TABLE_SIZE {
        const slot: i32 = (index + i) & (MODULE_TABLE_SIZE - 1);
        var module: &ModuleInfo = checker.module_table.slots[slot];
        if module != null && str_equals(module.module_name, module_name) != 0 {
            return module;
        }
        if module == null {
            module = arena_alloc(checker.arena, @size_of(ModuleInfo)) as &ModuleInfo;
            if module == null {
                return null;
            }
            module.module_name = module_name;
            module.filename = filename;
            module.exports = null;
            module.export_count = 0;
            module.dependencies = null;
            module.dependency_count = 0;
            checker.module_table.slots[slot] = module;
            checker.module_table.count = checker.module_table.count + 1;
            return module;
        }
        i = i + 1;
    }
    
    return null;
}

// 建立模块导出表（遍历所有声明，收集 export 标记的项）
fn build_module_exports(checker: &TypeChecker, program: &ASTNode) void {
    if checker == null || program == null || program.type != ASTNodeType.AST_PROGRAM {
        return;
    }
    
    var i: i32 = 0;
    while i < program.program_decl_count {
        const decl: &ASTNode = program.program_decls[i];
        if decl == null {
            i = i + 1;
            continue;
        }
        
        const filename: &byte = decl.filename;
        if filename == null {
            i = i + 1;
            continue;
        }
        
        const module_name: &byte = extract_module_path_allocated(checker, filename);
        if module_name == null {
            i = i + 1;
            continue;
        }
        
        const module: &ModuleInfo = find_or_create_module(checker, module_name, filename);
        if module == null {
            i = i + 1;
            continue;
        }
        
        var is_export: i32 = 0;
        var item_name: &byte = null;
        var item_type: i32 = 0;
        
        if decl.type == ASTNodeType.AST_FN_DECL {
            is_export = decl.fn_decl_is_export;
            item_name = decl.fn_decl_name;
            item_type = 1;
        } else if decl.type == ASTNodeType.AST_STRUCT_DECL {
            is_export = decl.struct_decl_is_export;
            item_name = decl.struct_decl_name;
            item_type = 2;
        } else if decl.type == ASTNodeType.AST_UNION_DECL {
            is_export = decl.union_decl_is_export;
            item_name = decl.union_decl_name;
            item_type = 3;
        } else if decl.type == ASTNodeType.AST_INTERFACE_DECL {
            is_export = decl.interface_decl_is_export;
            item_name = decl.interface_decl_name;
            item_type = 4;
        } else if decl.type == ASTNodeType.AST_ENUM_DECL {
            is_export = decl.enum_decl_is_export;
            item_name = decl.enum_decl_name;
            item_type = 5;
        } else if decl.type == ASTNodeType.AST_ERROR_DECL {
            is_export = decl.error_decl_is_export;
            item_name = decl.error_decl_name;
            item_type = 7;
        } else if decl.type == ASTNodeType.AST_VAR_DECL {
            is_export = decl.var_decl_is_export;
            item_name = decl.var_decl_name;
            item_type = 10;
        }
        
        if is_export == 0 || item_name == null {
            i = i + 1;
            continue;
        }
        
        if module.exports == null {
            const new_exports: &ModuleExport = arena_alloc(checker.arena, @size_of(ModuleExport) * 16) as &ModuleExport;
            if new_exports == null {
                i = i + 1;
                continue;
            }
            module.exports = new_exports;
        }
        
        const last_idx: i32 = module.export_count;
        if last_idx >= 0 && last_idx < 16 {
            module.exports[last_idx].name = item_name;
            module.exports[last_idx].item_type = item_type;
            module.exports[last_idx].decl_node = decl;
            module.export_count = module.export_count + 1;
        }
        i = i + 1;
    }
}

// 检查目录是否存在
fn check_directory_exists(checker: &TypeChecker, dir_path: &byte) i32 {
    var st: Stat = Stat { st_dev: 0, st_ino: 0, st_nlink: 0, st_mode: 0, st_uid: 0, st_gid: 0, _pad0: 0, st_rdev: 0, st_size: 0, st_blksize: 0, st_blocks: 0, st_atime: 0, st_atime_nsec: 0, st_mtime: 0, st_mtime_nsec: 0, st_ctime: 0, st_ctime_nsec: 0, _unused0: 0, _unused1: 0, _unused2: 0 };
    if stat(dir_path as *byte, &st as &Stat) != 0 {
        return 0;
    }
    if ((st.st_mode as u32) & S_IFMT) == S_IFDIR {
        return 1;
    }
    return 0;
}

// 构建目录路径并检查
fn try_find_module_directory(checker: &TypeChecker, root_dir: &byte, file_path: &byte, full_path: &byte) i32 {
    var dir_path: [byte: PATH_MAX] = [];
    const root_len: usize = strlen(root_dir as *byte);
    const file_path_len: usize = strlen(file_path as *byte);
    
    if root_len + file_path_len >= PATH_MAX {
        return 0;
    }
    
    strcpy(&dir_path[0], root_dir as *byte);
    strcat(&dir_path[0] as *byte, file_path as *byte);
    return check_directory_exists(checker, &dir_path[0]);
}

// 查找模块目录
fn find_module_directory(checker: &TypeChecker, full_path: &byte) i32 {
    // 尝试项目根目录
    if checker.project_root_dir != null {
        if try_find_module_directory(checker, checker.project_root_dir, full_path, full_path) != 0 {
            return 1;
        }
    }
    
    // 尝试 checker.project_root_dir
    if try_find_module_directory(checker, checker.project_root_dir, full_path, full_path) != 0 {
        return 1;
    }
    
    // 尝试 UYA_ROOT
    if checker.uya_root_dir != null {
        if try_find_module_directory(checker, checker.uya_root_dir, full_path, full_path) != 0 {
            return 1;
        }
    }
    
    return 0;
}

// 在模块表中查找模块
fn find_module_in_table(checker: &TypeChecker, module_name: &byte) &ModuleInfo {
    const fh: i32 = hash_string(module_name);
    var fi: i32 = fh & (MODULE_TABLE_SIZE - 1);
    var i: i32 = 0;
    
    while i < MODULE_TABLE_SIZE {
        const slot: i32 = (fi + i) & (MODULE_TABLE_SIZE - 1);
        const m: &ModuleInfo = checker.module_table.slots[slot];
        if m != null && str_equals(m.module_name, module_name) != 0 {
            return m;
        }
        if m == null {
            break;
        }
        i = i + 1;
    }
    return null;
}

// 构建模块路径字符串
fn build_module_name_from_segs(checker: &TypeChecker, segs: &&byte, seg_count: i32, strip_count: i32) &byte {
    var strip_total: usize = 0;
    var i: i32 = 0;
    while i < strip_count {
        if segs[i] != null {
            strip_total = strip_total + strlen(segs[i] as *byte);
            if i > 0 {
                strip_total = strip_total + 1;
            }
        }
        i = i + 1;
    }
    
    if strip_total == 0 {
        return null;
    }
    
    const sbuf: &byte = arena_alloc(checker.arena, strip_total + 1) as &byte;
    if sbuf == null {
        return null;
    }
    
    var sdst: &byte = sbuf;
    i = 0;
    while i < strip_count {
        if segs[i] != null {
            if i > 0 {
                sdst[0] = 46;
                sdst = &sdst[1];
            }
            const sl: usize = strlen(segs[i] as *byte);
            memcpy(sdst as *void, segs[i] as *void, sl);
            sdst = &sdst[sl];
        }
        i = i + 1;
    }
    sdst[0] = 0;
    return sbuf;
}

// 处理模块路径解析
fn resolve_module_path(checker: &TypeChecker, node: &ASTNode, segs: &&byte, seg_count: i32, module_name: &&byte, item_name: &&byte, is_whole_module_import: &i32) i32 {
    if seg_count <= 0 {
        return 0;
    }
    
    var full_path_buf: [byte: PATH_MAX] = [];
    full_path_buf[0] = 0;
    var i: i32 = 0;
    while i < seg_count {
        if segs[i] != null {
            if i > 0 {
                strcat(&full_path_buf[0] as *byte, "/" as *byte);
            }
            strcat(&full_path_buf[0] as *byte, segs[i] as *byte);
        }
        i = i + 1;
    }
    const full_path: &byte = &full_path_buf[0];
    
    if find_module_directory(checker, full_path) != 0 {
        module_name[0] = full_path;
        is_whole_module_import[0] = 1;
        return 1;
    }
    
    const full_mod: &ModuleInfo = find_module_in_table(checker, full_path);
    if full_mod != null && full_mod.export_count > 0 {
        module_name[0] = full_path;
        is_whole_module_import[0] = 1;
        return 1;
    }
    
    item_name[0] = segs[seg_count - 1];
    const strip_count: i32 = seg_count - 1;
    
    if strip_count == 1 {
        module_name[0] = segs[0];
        return 1;
    }
    
    module_name[0] = build_module_name_from_segs(checker, segs, seg_count, strip_count);
    return 1;
}

// 验证模块名称
fn validate_module_name(checker: &TypeChecker, node: &ASTNode, module_name: &byte) i32 {
    if module_name == null {
        checker_report_error(checker, node, "use 语句的模块名无效" as *byte);
        return 0;
    }
    
    if strlen(module_name as *byte) >= 5 &&
       (module_name[0] as byte) == 108 && (module_name[1] as byte) == 105 &&
       (module_name[2] as byte) == 98 && (module_name[3] as byte) == 99 &&
       (module_name[4] as byte) == 46 {
        checker_report_error(checker, node, "libc 模块是扁平化的，请使用 'use libc.xxx;' 而不是 'use libc.stdio.xxx;'" as *byte);
        return 0;
    }
    
    return 1;
}

// 在模块导出表中查找项
fn find_item_in_module_exports(checker: &TypeChecker, module: &ModuleInfo, item_name: &byte, item_type: &i32, export_decl: &&ASTNode) i32 {
    if module.exports == null {
        return 0;
    }
    
    var k: i32 = 0;
    while k < module.export_count {
        if str_equals(module.exports[k].name, item_name) != 0 {
            item_type[0] = module.exports[k].item_type;
            export_decl[0] = module.exports[k].decl_node;
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

// 检查是否为外部符号
fn is_external_symbol(module_name: &byte) i32 {
    if module_name == null || strlen(module_name as *byte) < 4 {
        return 0;
    }
    
    const is_std: i32 = (
        (module_name[0] as byte) == 115 && (module_name[1] as byte) == 116 &&
        (module_name[2] as byte) == 100 && (module_name[3] as byte) == 46
    ) as i32;
    
    const is_libc: i32 = (
        (module_name[0] as byte) == 108 && (module_name[1] as byte) == 105 &&
        (module_name[2] as byte) == 98 && (module_name[3] as byte) == 99
    ) as i32;
    
    return (is_std != 0 || is_libc != 0) as i32;
}

// 添加导入项到导入表
fn add_import_to_table(checker: &TypeChecker, local_name: &byte, original_name: &byte, module_name: &byte, item_type: i32) i32 {
    const import: &ImportedItem = arena_alloc(checker.arena, @size_of(ImportedItem)) as &ImportedItem;
    if import == null {
        return 0;
    }
    
    import.local_name = local_name;
    import.original_name = original_name;
    import.module_name = module_name;
    import.item_type = item_type;
    
    const import_hash: i32 = hash_string(import.local_name);
    var import_index: i32 = import_hash & (IMPORT_TABLE_SIZE - 1);
    var j: i32 = 0;
    
    while j < IMPORT_TABLE_SIZE {
        const slot: i32 = (import_index + j) & (IMPORT_TABLE_SIZE - 1);
        if checker.import_table.slots[slot] == null {
            checker.import_table.slots[slot] = import;
            checker.import_table.count = checker.import_table.count + 1;
            return 1;
        }
        j = j + 1;
    }
    
    return 0;
}

// 获取当前模块名
fn get_current_module_name(checker: &TypeChecker, node: &ASTNode) &byte {
    if node.filename == null {
        return null;
    }
    return extract_module_path_allocated(checker, node.filename);
}

// 添加模块依赖
fn add_module_dependency(checker: &TypeChecker, current_module_name: &byte, module_name: &byte, node: &ASTNode) i32 {
    const current_module: &ModuleInfo = find_or_create_module(checker, current_module_name, node.filename);
    if current_module == null {
        return 0;
    }
    
    const new_count: i32 = current_module.dependency_count + 1;
    const new_deps: &ModuleDependency = arena_alloc(checker.arena, @size_of(ModuleDependency) * new_count) as &ModuleDependency;
    if new_deps == null {
        return 0;
    }
    
    var i: i32 = 0;
    while i < current_module.dependency_count {
        new_deps[i] = current_module.dependencies[i];
        i = i + 1;
    }
    
    const last_idx: i32 = current_module.dependency_count;
    new_deps[last_idx].target_module = module_name;
    new_deps[last_idx].use_stmt_node = node;
    current_module.dependencies = new_deps;
    current_module.dependency_count = new_count;
    return 1;
}

// 处理模块导入（整体导入）
fn process_whole_module_import(checker: &TypeChecker, node: &ASTNode, module: &ModuleInfo, module_name: &byte, segs: &&byte, seg_count: i32, alias: &byte) i32 {
    var local_name: &byte = alias;
    if local_name == null && seg_count > 0 {
        local_name = segs[seg_count - 1];
    }
    if local_name == null {
        checker_report_error(checker, node, "use 语句的本地名称无效" as *byte);
        return 0;
    }
    
    return add_import_to_table(checker, local_name, null, module_name, 0 - 1);
}

// 处理特定项导入
fn process_item_import(checker: &TypeChecker, node: &ASTNode, module: &ModuleInfo, module_name: &byte, item_name: &byte, alias: &byte) i32 {
    var item_type: i32 = 0;
    var export_decl: &ASTNode = null;
    
    if find_item_in_module_exports(checker, module, item_name, &item_type, &export_decl) == 0 {
        if is_external_symbol(module_name) == 0 {
            checker_report_error(checker, node, "模块中未找到导出项" as *byte);
            return 0;
        }
        item_type = 0;
    }
    
    var local_name: &byte = alias;
    if local_name == null {
        local_name = item_name;
    }
    
    if item_type == 1 && export_decl != null && export_decl.type == ASTNodeType.AST_FN_DECL {
        const fn_decl: &ASTNode = export_decl;
        if fn_decl.fn_decl_generic_params != null && fn_decl.fn_decl_generic_param_count > 0 {
            const poly_name: &byte = checker_arena_sprintf(checker.arena, "%s_poly" as *byte, item_name as *byte);
            if poly_name != null {
                return add_import_to_table(checker, local_name, item_name, module_name, item_type);
            }
        }
    }
    
    return add_import_to_table(checker, local_name, item_name, module_name, item_type);
}

// 处理 use 语句
fn process_use_stmt(checker: &TypeChecker, node: &ASTNode) i32 {
    if checker == null || node == null || node.type != ASTNodeType.AST_USE_STMT {
        return 0;
    }
    
    const segs: &&byte = node.use_stmt_path_segments;
    const seg_count: i32 = node.use_stmt_path_segment_count;
    const alias: &byte = node.use_stmt_alias;
    
    if seg_count <= 0 || segs == null {
        checker_report_error(checker, node, "use 语句路径无效" as *byte);
        return 0;
    }
    
    var module_name: &byte = null;
    var item_name: &byte = null;
    var is_whole_module_import: i32 = 0;
    
    resolve_module_path(checker, node, segs, seg_count, &module_name, &item_name, &is_whole_module_import);
    
    if module_name == null && seg_count == 1 {
        module_name = segs[0];
    }
    
    if validate_module_name(checker, node, module_name) == 0 {
        return 0;
    }
    
    const module: &ModuleInfo = find_or_create_module(checker, module_name, node.filename);
    if module == null {
        checker_report_error(checker, node, "模块未找到或无法创建" as *byte);
        return 0;
    }
    
    const current_module_name: &byte = get_current_module_name(checker, node);
    if current_module_name != null && str_equals(current_module_name, module_name) == 0 {
        add_module_dependency(checker, current_module_name, module_name, node);
    }
    
    if is_whole_module_import != 0 || item_name == null {
        return process_whole_module_import(checker, node, module, module_name, segs, seg_count, alias);
    }
    
    return process_item_import(checker, node, module, module_name, item_name, alias);
}

// DFS 辅助函数（用于循环依赖检测）
fn dfs_visit_module(checker: &TypeChecker, module_name: &byte, visited: &i32, visiting: &i32, result: &i32) i32 {
    if checker == null || module_name == null || visited as *i32 == null || visiting as *i32 == null || result == null {
        return 0;
    }
    
    const vh: i32 = hash_string(module_name);
    const vi: i32 = vh & (MODULE_TABLE_SIZE - 1);
    const visited_ptr: &i32 = &visited[vi];
    const visiting_ptr: &i32 = &visiting[vi];
    
    if visiting_ptr[0] != 0 {
        result[0] = 1;
        return 1;
    }
    
    if visited_ptr[0] != 0 {
        return 0;
    }
    
    const module: &ModuleInfo = find_or_create_module(checker, module_name, null);
    if module == null || module.dependencies == null || module.dependency_count <= 0 {
        visited_ptr[0] = 1;
        return 0;
    }
    
    visiting_ptr[0] = 1;
    var i: i32 = 0;
    while i < module.dependency_count {
        const dep: &ModuleDependency = module.dependencies[i];
        if dep.target_module != null {
            dfs_visit_module(checker, dep.target_module, visited, visiting, result);
        }
        i = i + 1;
    }
    
    visiting_ptr[0] = 0;
    visited_ptr[0] = 1;
    return 0;
}

// 检测循环依赖
fn detect_circular_dependencies(checker: &TypeChecker) void {
    if checker == null {
        return;
    }
    
    var visited: [i32: MODULE_TABLE_SIZE] = [];
    var visiting: [i32: MODULE_TABLE_SIZE] = [];
    var i: i32 = 0;
    while i < MODULE_TABLE_SIZE {
        visited[i] = 0;
        visiting[i] = 0;
        i = i + 1;
    }
    
    var result: i32 = 0;
    i = 0;
    
    while i < MODULE_TABLE_SIZE {
        const module: &ModuleInfo = checker.module_table.slots[i];
        if module != null && module.module_name != null {
            const vh: i32 = hash_string(module.module_name);
            const vi: i32 = vh & (MODULE_TABLE_SIZE - 1);
            if visited[vi] == 0 {
                dfs_visit_module(checker, module.module_name, &visited[0], &visiting[0], &result);
                if result != 0 {
                    break;
                }
            }
        }
        i = i + 1;
    }
}
