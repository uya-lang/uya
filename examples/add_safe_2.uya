// add_safe_2.uya - 饱和与包装运算符
//
// 饱和：`+|` `-|` `*|` 溢出时返回类型极值
// 包装：`+%` `-%` `*%` 溢出时按模运算回绕
//
// 运行：./bin/uya run examples/add_safe_2.uya

const MAXV: i32 = @max;
const MINV: i32 = @min;

fn add_saturating(a: i32, b: i32) i32 {
    return a +| b;
}

fn add_wrapping(a: i32, b: i32) i32 {
    return a +% b;
}

fn main() i32 {
    if add_saturating(MAXV, 1) != MAXV {
        return 1;
    }
    if add_wrapping(MAXV, 1) != MINV {
        return 1;
    }
    if add_saturating(1, 2) != 3 {
        return 1;
    }
    return 0;
}
