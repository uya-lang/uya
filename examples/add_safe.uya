// add_safe.uya - 整数溢出：编译期证明 + 显式检查
//
// Uya 的整数溢出规则：
//   - 常量运算溢出 -> 编译错误
//   - 变量运算 -> 必须让编译器证明无溢出，或显式检查后返回错误/极值
//   - `try` 只做 !T 错误传播，不做算术溢出检查（`try a + b` 会报错）
//
// 运行：./bin/uya run examples/add_safe.uya

const MAXV: i32 = @max;
const MINV: i32 = @min;

// 常量折叠：编译器证明 100 + 200 不溢出
const X: i32 = 100 + 200;

// 显式检查：返回 !i32，溢出时返回 error.Overflow
fn add_safe(a: i32, b: i32) !i32 {
    if a > 0 && b > 0 && a > MAXV - b {
        return error.Overflow;
    }
    if a < 0 && b < 0 && a < MINV - b {
        return error.Overflow;
    }
    return a + b;
}

fn main() i32 {
    const sum: i32 = add_safe(2, 3) catch { return 1; };
    if sum != 5 {
        return 1;
    }
    if X != 300 {
        return 1;
    }
    return 0;
}
