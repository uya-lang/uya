// add_safe_1.uya - 手动溢出检查 + 饱和/包装运算符
//
// 运行：./bin/uya run examples/add_safe_1.uya

const MAXV: i32 = @max;
const MINV: i32 = @min;

// 返回错误：显式检查上溢/下溢
fn add_safe(a: i32, b: i32) !i32 {
    if a > 0 && b > 0 && a > MAXV - b {
        return error.Overflow;
    }
    if a < 0 && b < 0 && a < MINV - b {
        return error.Overflow;
    }
    return a + b;
}

// 返回饱和值：溢出时钳到类型极值
fn add_saturating(a: i32, b: i32) i32 {
    return a +| b;
}

// 返回包装值：溢出时按模运算回绕
fn add_wrapping(a: i32, b: i32) i32 {
    return a +% b;
}

fn main() i32 {
    const s: i32 = add_safe(1, 2) catch { return 1; };
    if s != 3 {
        return 1;
    }
    if add_saturating(MAXV, 1) != MAXV {
        return 1;
    }
    if add_wrapping(MAXV, 1) != MINV {
        return 1;
    }
    return 0;
}
