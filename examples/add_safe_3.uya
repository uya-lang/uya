// add_safe_3.uya - 溢出错误处理与传播
//
// `try` 只传播 !T；溢出检查要写成显式条件 + 返回 error.Overflow。
//
// 运行：./bin/uya run examples/add_safe_3.uya

const MAXV: i32 = @max;
const MINV: i32 = @min;

fn add_checked(a: i32, b: i32) !i32 {
    if a > 0 && b > 0 && a > MAXV - b {
        return error.Overflow;
    }
    if a < 0 && b < 0 && a < MINV - b {
        return error.Overflow;
    }
    return a + b;
}

// 在 catch 里处理错误，返回默认值
fn add_or_default(a: i32, b: i32) i32 {
    const result: i32 = add_checked(a, b) catch |err| {
        if @error_id(err) == @error_id(error.Overflow) {
            return 0;
        }
        return 0;
    };
    return result;
}

// 用 try 向上传播错误
fn add_twice(a: i32, b: i32, c: i32) !i32 {
    const sum: i32 = try add_checked(a, b);
    return try add_checked(sum, c);
}

fn main() i32 {
    if add_or_default(1, 2) != 3 {
        return 1;
    }
    const r: i32 = add_twice(1, 2, 3) catch { return 1; };
    if r != 6 {
        return 1;
    }
    return 0;
}
