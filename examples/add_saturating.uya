// add_saturating.uya - 饱和算术
//
// 饱和：`+|` `-|` `*|` 溢出时返回类型极值，不返回错误。
//
// 运行：./bin/uya run examples/add_saturating.uya

const MAXV: i32 = @max;
const MINV: i32 = @min;

fn add_saturating(a: i32, b: i32) i32 {
    return a +| b;
}

fn sub_saturating(a: i32, b: i32) i32 {
    return a -| b;
}

fn mul_saturating(a: i32, b: i32) i32 {
    return a *| b;
}

fn main() i32 {
    if add_saturating(100, 200) != 300 {
        return 1;
    }
    if add_saturating(MAXV, 1) != MAXV {
        return 1;
    }
    if sub_saturating(MINV, 1) != MINV {
        return 1;
    }
    if mul_saturating(MAXV, 2) != MAXV {
        return 1;
    }
    return 0;
}
