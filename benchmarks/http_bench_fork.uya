// benchmarks/http_bench_fork.uya — 多进程阻塞 accept + 连接级 fork HTTP 服务器
//
// 构建：
//   bin/uya build benchmarks/http_bench_fork.uya -o /tmp/http_bench_fork.c --c99 && cc -std=c99 -no-pie -O2 -o /tmp/http_bench_fork /tmp/http_bench_fork.c -lm

use libc.syscall;
use libc.signal;
use std.runtime.entry.set_process_stack_limit_bytes;

const PORT: u16 = 8876;
const BACKLOG: i32 = 1024;
const NUM_PROCESSES: usize = 28;
const READ_BUF_SIZE: usize = 2048;
const MAX_PATH_LEN: usize = 256;
const BENCH_PROCESS_STACK_BYTES: u64 = 1024 * 1024;

// BufferStream 结构体
struct BufferStream {
    fd: i32 = 0,
    buf: [byte: 4096] = [],
    buf_len: usize = 0,
    buf_pos: usize = 0,
}

// 初始化 BufferStream
fn stream_init(fd: i32) BufferStream {
    return BufferStream{ fd: fd };
}

// 查找缓冲区中是否有完整的分隔符（从 buf_pos 开始查找）
fn find_in_buf(buf: &byte, buf_pos: usize, buf_len: usize, delim: &byte, delim_len: usize) usize {
    if delim_len == 0 || buf_len - buf_pos < delim_len { return 0; }
    var i: usize = buf_pos;
    while i + delim_len <= buf_len {
        var found: bool = true;
        var j: usize = 0;
        while j < delim_len {
            if buf[i + j] != delim[j] {
                found = false;
                break;
            }
            j = j + 1;
        }
        if found { return i + delim_len; }
        i = i + 1;
    }
    return 0;
}

// 读取直到遇到指定分隔符（包含分隔符），返回总读取字节数（包括分隔符）
// 返回 0 表示出错或连接关闭
fn read_until(s: &BufferStream, delim: &byte, delim_len: usize) usize {
    while true {
        // 先在缓冲区中查找
        const found: usize = find_in_buf(&s.buf[0] as &byte, s.buf_pos, s.buf_len, delim, delim_len);
        if found > 0 {
            // 找到分隔符，返回从 buf_pos 到 found 的总长度
            return found - s.buf_pos;
        }

        // 没有找到，先压缩缓冲区（移动数据到开头）
        if s.buf_pos > 0 {
            var i: usize = 0;
            while i < s.buf_len - s.buf_pos {
                s.buf[i] = s.buf[s.buf_pos + i];
                i = i + 1;
            }
            s.buf_len = s.buf_len - s.buf_pos;
            s.buf_pos = 0;
        }

        // 如果缓冲区满了也没找到分隔符，报错
        if s.buf_len >= 4096 { return 0; }

        // 填充数据
        const nr: !isize = sys_read(s.fd, &s.buf[s.buf_len] as *byte, 4096 - s.buf_len);
        if nr.error_id != 0 { return 0; }
        const n: isize = nr.value;
        if n <= 0 { return 0; }
        s.buf_len = s.buf_len + (n as usize);
    }
}

// 读取指定长度的字节，返回实际读取的字节数
fn read_exact(s: &BufferStream, len: usize) usize {
    while s.buf_len - s.buf_pos < len {
        // 先压缩缓冲区
        if s.buf_pos > 0 {
            var i: usize = 0;
            while i < s.buf_len - s.buf_pos {
                s.buf[i] = s.buf[s.buf_pos + i];
                i = i + 1;
            }
            s.buf_len = s.buf_len - s.buf_pos;
            s.buf_pos = 0;
        }

        const nr: !isize = sys_read(s.fd, &s.buf[s.buf_len] as *byte, 4096 - s.buf_len);
        if nr.error_id != 0 { return 0; }
        const n: isize = nr.value;
        if n <= 0 { return 0; }
        s.buf_len = s.buf_len + (n as usize);
    }
    s.buf_pos = s.buf_pos + len;
    return len;
}

// 获取缓冲区内可用的数据指针
fn stream_data(s: &BufferStream) &byte {
    return &s.buf[s.buf_pos] as &byte;
}

// 跳过指定字节
fn stream_skip(s: &BufferStream, len: usize) void {
    s.buf_pos = s.buf_pos + len;
}

// 获取已缓冲的数据长度
fn stream_available(s: &BufferStream) usize {
    return s.buf_len - s.buf_pos;
}

const SIGPIPE: i32 = 13;
const SIGCHLD: i32 = 17;
const SIG_IGN: usize = 1;
const BENCH_HELLO_BODY_LEN: usize = 5;
const BENCH_JSON_BODY_LEN: usize = 11;

var g_hello_body: [byte: BENCH_HELLO_BODY_LEN] = [];
var g_json_body: [byte: BENCH_JSON_BODY_LEN] = [];
var g_http200: [byte: 18] = [];
var g_http200ka: [byte: 18] = [];
var g_content_len: [byte: 17] = [];
var g_crlfcrlf: [byte: 5] = [];
var g_connection_ka: [byte: 25] = [];
var g_payload1k: [byte: 1024] = [];

fn init_payloads() void {
    g_hello_body[0] = 'h'; g_hello_body[1] = 'e'; g_hello_body[2] = 'l';
    g_hello_body[3] = 'l'; g_hello_body[4] = 'o';
    g_json_body[0] = '{'; g_json_body[1] = '"'; g_json_body[2] = 'o';
    g_json_body[3] = 'k'; g_json_body[4] = '"'; g_json_body[5] = ':';
    g_json_body[6] = 't'; g_json_body[7] = 'r'; g_json_body[8] = 'u';
    g_json_body[9] = 'e'; g_json_body[10] = '}';
    g_http200[0] = 'H'; g_http200[1] = 'T'; g_http200[2] = 'T';
    g_http200[3] = 'P'; g_http200[4] = '/'; g_http200[5] = '1';
    g_http200[6] = '.'; g_http200[7] = '1'; g_http200[8] = ' ';
    g_http200[9] = '2'; g_http200[10] = '0'; g_http200[11] = '0';
    g_http200[12] = ' '; g_http200[13] = 'O'; g_http200[14] = 'K';
    g_http200[15] = '\r'; g_http200[16] = '\n';
    g_http200ka[0] = 'H'; g_http200ka[1] = 'T'; g_http200ka[2] = 'T';
    g_http200ka[3] = 'P'; g_http200ka[4] = '/'; g_http200ka[5] = '1';
    g_http200ka[6] = '.'; g_http200ka[7] = '1'; g_http200ka[8] = ' ';
    g_http200ka[9] = '2'; g_http200ka[10] = '0'; g_http200ka[11] = '0';
    g_http200ka[12] = ' '; g_http200ka[13] = 'O'; g_http200ka[14] = 'K';
    g_http200ka[15] = '\r'; g_http200ka[16] = '\n';
    g_connection_ka[0] = 'C'; g_connection_ka[1] = 'o'; g_connection_ka[2] = 'n';
    g_connection_ka[3] = 'n'; g_connection_ka[4] = 'e'; g_connection_ka[5] = 'c';
    g_connection_ka[6] = 't'; g_connection_ka[7] = 'i'; g_connection_ka[8] = 'o';
    g_connection_ka[9] = 'n'; g_connection_ka[10] = ':'; g_connection_ka[11] = ' ';
    g_connection_ka[12] = 'k'; g_connection_ka[13] = 'e'; g_connection_ka[14] = 'e';
    g_connection_ka[15] = 'p'; g_connection_ka[16] = '-'; g_connection_ka[17] = 'a';
    g_connection_ka[18] = 'l'; g_connection_ka[19] = 'i'; g_connection_ka[20] = 'v';
    g_connection_ka[21] = 'e'; g_connection_ka[22] = '\r'; g_connection_ka[23] = '\n';
    g_content_len[0] = 'C'; g_content_len[1] = 'o'; g_content_len[2] = 'n';
    g_content_len[3] = 't'; g_content_len[4] = 'e'; g_content_len[5] = 'n';
    g_content_len[6] = 't'; g_content_len[7] = '-'; g_content_len[8] = 'L';
    g_content_len[9] = 'e'; g_content_len[10] = 'n'; g_content_len[11] = 'g';
    g_content_len[12] = 't'; g_content_len[13] = 'h'; g_content_len[14] = ':';
    g_content_len[15] = ' ';
    g_crlfcrlf[0] = '\r'; g_crlfcrlf[1] = '\n';
    g_crlfcrlf[2] = '\r'; g_crlfcrlf[3] = '\n';
    var i: usize = 0;
    while i < 1024 { g_payload1k[i] = 'a' as byte; i = i + 1; }
}

fn find_crlf(buf: &byte, len: usize) bool {
    var i: usize = 0;
    while i + 1 < len {
        if buf[i] == '\r' as byte && buf[i + 1] == '\n' as byte {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 判断请求是否为 HTTP/1.1。
// 这里保留与现有解析一致的扫描方式，避免把头部重新拷贝到临时结构里。
fn request_is_http11(data: &byte, avail: usize) bool {
    if avail <= 14 {
        return false;
    }
    if data[avail - 2] != '\r' as byte || data[avail - 1] != '\n' as byte {
        return false;
    }
    var j: usize = 0;
    while j < avail - 14 {
        if j + 8 < avail &&
           data[j] == 'H' as byte && data[j+1] == 'T' as byte &&
           data[j+2] == 'T' as byte && data[j+3] == 'P' as byte &&
           data[j+4] == '/' as byte &&
           data[j+5] == '1' as byte && data[j+6] == '.' as byte {
            return data[j+7] == '1' as byte;
        }
        j = j + 1;
    }
    return false;
}

fn fmt_usize(buf: &byte, n: usize) usize {
    if n == 0 { buf[0] = '0' as byte; return 1; }
    var tmp: [byte: 24] = [];
    var t: usize = 0;
    var x: usize = n;
    while x > 0 {
        tmp[t] = (((x % 10) as u32 + 48) as! byte).value;
        t = t + 1;
        x = x / 10;
    }
    var i: usize = 0;
    while i < t { buf[i] = tmp[t - 1 - i]; i = i + 1; }
    return t;
}

fn close_fd(fd: i32) void {
    _ = sys_close(fd);
}

// 关闭客户端连接前尽量把内核里已到达但尚未读取的数据读掉，降低 Linux close 触发 RST 的概率。
fn close_client_fd_quiet(fd: i32) void {
    if fd < 0 {
        return;
    }
    const flags_r: !i32 = sys_fcntl(fd, F_GETFL, 0);
    if flags_r.error_id == 0 {
        const flags: i32 = flags_r.value;
        if (flags & O_NONBLOCK) == 0 {
            _ = sys_fcntl(fd, F_SETFL, flags | O_NONBLOCK);
        }
    }
    var junk: [byte: 512] = [];
    while true {
        const rr: !isize = sys_read(fd, &junk[0] as *byte, 512);
        if rr.error_id != 0 {
            break;
        }
        if rr.value <= 0 {
            break;
        }
    }
    _ = sys_close(fd);
}

// 接受连接后再 fork 出子进程处理该连接，避免 keep-alive 长连接占住 accept worker。
fn serve_accept_loop(listen_fd: i32) void {
    while true {
        const ar: !i32 = sys_accept(listen_fd, null, 0);
        if ar.error_id != 0 { continue; }
        const cfd: i32 = ar.value;

        const pid_r: !i64 = sys_fork();
        if pid_r.error_id != 0 {
            var nodelay_fallback: i32 = 1;
            _ = sys_setsockopt(cfd, 6, 1, &nodelay_fallback as &void, 4);
            handle_client(cfd);
            continue;
        }

        const pid: i64 = pid_r.value;
        if pid == 0 {
            close_fd(listen_fd);
            var nodelay_child: i32 = 1;
            _ = sys_setsockopt(cfd, 6, 1, &nodelay_child as &void, 4);
            handle_client(cfd);
            sys_exit(0);
        }

        close_fd(cfd);
    }
}

fn handle_client(cfd: i32) void {
    // 设置读取超时 60 秒（x86_64 上 timeval 为 16 字节：tv_sec + tv_usec）
    var tv: [byte: 16] = [];
    tv[0] = 60; tv[1] = 0;  // tv_sec = 60 (little endian)
    _ = sys_setsockopt(cfd, 1, 20, &tv[0] as &void, 16);  // SOL_SOCKET=1, SO_RCVTIMEO=20

    var s: BufferStream = stream_init(cfd);
    // ab -k 这类客户端在同一 HTTP/1.0 keep-alive 连接上，后续请求可能不再重复发送 Connection 头。
    // 一旦本连接已成功协商过 keep-alive，就继续把无 Connection 头的 HTTP/1.0 请求视为可保持。
    var http10_session_keep_alive: bool = false;
    var crlf: [byte: 4] = [];
    crlf[0] = '\r' as byte; crlf[1] = '\n' as byte;
    crlf[2] = '\r' as byte; crlf[3] = '\n' as byte;

    while true {
        // 1. 读取直到 \r\n\r\n
        const hdr_len: usize = read_until(&s, &crlf[0] as &byte, 4);
        if hdr_len == 0 { close_client_fd_quiet(cfd); return; }

        // 2. 获取头部数据并解析
        const data: &byte = stream_data(&s);
        const avail: usize = stream_available(&s);
        if avail < 14 { close_client_fd_quiet(cfd); return; }

        // 解析请求行
        if data[0] != 'G' as byte || data[1] != 'E' as byte ||
           data[2] != 'T' as byte || data[3] != ' ' as byte {
            close_client_fd_quiet(cfd); return;
        }

        // 找到路径结束
        var path_end: usize = 4;
        while path_end < avail && data[path_end] != ' ' as byte { path_end = path_end + 1; }
        if path_end >= avail { close_client_fd_quiet(cfd); return; }
        const plen: usize = path_end - 4;
        if plen == 0 || plen > MAX_PATH_LEN - 1 { close_client_fd_quiet(cfd); return; }

        // 3. 解析 Content-Length（不区分大小写）
        var content_length: usize = 0;
        var i: usize = 0;
        while i + 15 < avail {
            // 查找 "content-length:" 或 "Content-Length:" 头（不区分大小写）
            if (data[i] == 'C' as byte || data[i] == 'c' as byte) &&
               (data[i+1] == 'O' as byte || data[i+1] == 'o' as byte) &&
               (data[i+2] == 'N' as byte || data[i+2] == 'n' as byte) &&
               (data[i+3] == 'T' as byte || data[i+3] == 't' as byte) &&
               (data[i+4] == 'E' as byte || data[i+4] == 'e' as byte) &&
               (data[i+5] == 'N' as byte || data[i+5] == 'n' as byte) &&
               (data[i+6] == 'T' as byte || data[i+6] == 't' as byte) &&
               data[i+7] == '-' as byte &&
               (data[i+8] == 'L' as byte || data[i+8] == 'l' as byte) &&
               (data[i+9] == 'E' as byte || data[i+9] == 'e' as byte) &&
               (data[i+10] == 'N' as byte || data[i+10] == 'n' as byte) &&
               (data[i+11] == 'G' as byte || data[i+11] == 'g' as byte) &&
               (data[i+12] == 'T' as byte || data[i+12] == 't' as byte) &&
               (data[i+13] == 'H' as byte || data[i+13] == 'h' as byte) &&
               data[i+14] == ':' as byte {
                // 解析数字
                var val_start: usize = i + 15;
                while val_start < avail && (data[val_start] == ' ' as byte || data[val_start] == '\t' as byte) {
                    val_start = val_start + 1;
                }
                while val_start < avail && data[val_start] >= '0' as byte && data[val_start] <= '9' as byte {
                    content_length = content_length * 10 + ((data[val_start] as i32) - 48) as usize;
                    val_start = val_start + 1;
                }
                break;
            }
            i = i + 1;
        }

        // 4. 解析 Connection 头（不区分大小写）
        var wants_close: bool = true;
        var has_connection: bool = false;
        i = 0;
        while i + 12 < avail {
            // 查找 "connection:" 或 "Connection:" 头（不区分大小写）
            if (data[i] == 'C' as byte || data[i] == 'c' as byte) &&
               (data[i+1] == 'O' as byte || data[i+1] == 'o' as byte) &&
               (data[i+2] == 'N' as byte || data[i+2] == 'n' as byte) &&
               (data[i+3] == 'N' as byte || data[i+3] == 'n' as byte) &&
               (data[i+4] == 'E' as byte || data[i+4] == 'e' as byte) &&
               (data[i+5] == 'C' as byte || data[i+5] == 'c' as byte) &&
               (data[i+6] == 'T' as byte || data[i+6] == 't' as byte) &&
               (data[i+7] == 'I' as byte || data[i+7] == 'i' as byte) &&
               (data[i+8] == 'O' as byte || data[i+8] == 'o' as byte) &&
               (data[i+9] == 'N' as byte || data[i+9] == 'n' as byte) &&
               data[i+10] == ':' as byte {
                // 找到 Connection 头，检查值（忽略大小写）
                var val_start: usize = i + 11;
                while val_start < avail && (data[val_start] == ' ' as byte || data[val_start] == '\t' as byte) {
                    val_start = val_start + 1;
                }
                has_connection = true;
                // 检查 "keep-alive" 或 "Keep-Alive"
                if val_start + 9 < avail &&
                   (data[val_start] == 'k' as byte || data[val_start] == 'K' as byte) &&
                   (data[val_start+1] == 'e' as byte || data[val_start+1] == 'E' as byte) &&
                   (data[val_start+2] == 'e' as byte || data[val_start+2] == 'E' as byte) &&
                   (data[val_start+3] == 'p' as byte || data[val_start+3] == 'P' as byte) &&
                   data[val_start+4] == '-' as byte &&
                   (data[val_start+5] == 'a' as byte || data[val_start+5] == 'A' as byte) &&
                   (data[val_start+6] == 'l' as byte || data[val_start+6] == 'L' as byte) &&
                   (data[val_start+7] == 'i' as byte || data[val_start+7] == 'I' as byte) &&
                   (data[val_start+8] == 'v' as byte || data[val_start+8] == 'V' as byte) &&
                   (data[val_start+9] == 'e' as byte || data[val_start+9] == 'E' as byte) {
                    wants_close = false;
                }
                // 检查 "close"
                if val_start + 4 < avail &&
                   (data[val_start] == 'c' as byte || data[val_start] == 'C' as byte) &&
                   (data[val_start+1] == 'l' as byte || data[val_start+1] == 'L' as byte) &&
                   (data[val_start+2] == 'o' as byte || data[val_start+2] == 'O' as byte) &&
                   (data[val_start+3] == 's' as byte || data[val_start+3] == 'S' as byte) &&
                   (data[val_start+4] == 'e' as byte || data[val_start+4] == 'E' as byte) {
                    wants_close = true;
                }
                break;
            }
            i = i + 1;
        }

        // 请求行里的 HTTP 版本，后面决定默认连接语义与会话级 keep-alive 行为。
        var http11: bool = request_is_http11(data, avail);

        // 如果没有 Connection 头，根据 HTTP 版本决定
        if !has_connection {
            // HTTP/1.0 默认 close，HTTP/1.1 默认 keep-alive。
            // 若本连接已经成功协商过 HTTP/1.0 keep-alive，则 ab -k 后续请求即使省略 Connection 头，也应继续保持。
            if http10_session_keep_alive {
                wants_close = false;
            } else {
                wants_close = !http11;
            }
        }

        // 5. 跳过已处理的 header
        stream_skip(&s, hdr_len);

        // 6. 如果有 Content-Length，读取并跳过完整的 body
        if content_length > 0 {
            const body_in_buf: usize = stream_available(&s);
            if body_in_buf < content_length {
                const need: usize = content_length - body_in_buf;
                const got: usize = read_exact(&s, need);
                if got != need { close_client_fd_quiet(cfd); return; }
                // read_exact 已经移动了 buf_pos，不需要再 skip
            } else {
                stream_skip(&s, content_length);
            }
        }

        // 7. 确定响应内容
        var body_ptr: &byte = &g_hello_body[0] as &byte;
        var body_len: usize = BENCH_HELLO_BODY_LEN;

        if plen == 1 && data[4] == '/' as byte {
            body_ptr = &g_hello_body[0] as &byte; body_len = BENCH_HELLO_BODY_LEN;
        } else if plen == 10 && data[4] == '/' as byte &&
                  data[5] == 'p' as byte && data[6] == 'l' as byte &&
                  data[7] == 'a' as byte && data[8] == 'i' as byte &&
                  data[9] == 'n' as byte && data[10] == 't' as byte &&
                  data[11] == 'e' as byte && data[12] == 'x' as byte &&
                  data[13] == 't' as byte {
            body_ptr = &g_hello_body[0] as &byte; body_len = BENCH_HELLO_BODY_LEN;
        } else if plen == 5 && data[4] == '/' as byte &&
                  data[5] == 'j' as byte && data[6] == 's' as byte &&
                  data[7] == 'o' as byte && data[8] == 'n' as byte {
            body_ptr = &g_json_body[0] as &byte; body_len = BENCH_JSON_BODY_LEN;
        } else if plen > 6 && data[4] == '/' as byte &&
                  data[5] == 'i' as byte && data[6] == 't' as byte &&
                  data[7] == 'e' as byte && data[8] == 'm' as byte &&
                  data[9] == '/' as byte {
            body_ptr = &data[10] as &byte; body_len = plen - 6;
        } else if plen == 10 && data[4] == '/' as byte &&
                  data[5] == 'p' as byte && data[6] == 'a' as byte &&
                  data[7] == 'y' as byte && data[8] == 'l' as byte &&
                  data[9] == 'o' as byte && data[10] == 'a' as byte &&
                  data[11] == 'd' as byte && data[12] == '1' as byte &&
                  data[13] == 'k' as byte {
            body_ptr = &g_payload1k[0] as &byte; body_len = 1024;
        }

        // 8. 发送响应
        var hdr: [byte: 128] = [];
        var pos: usize = 0;
        var j: usize = 0;
        while j < 17 { hdr[pos] = g_http200ka[j]; pos = pos + 1; j = j + 1; }
        if wants_close {
            // Connection: close
            hdr[pos] = 'C' as byte; hdr[pos+1] = 'o' as byte;
            hdr[pos+2] = 'n' as byte; hdr[pos+3] = 'n' as byte;
            hdr[pos+4] = 'e' as byte; hdr[pos+5] = 'c' as byte;
            hdr[pos+6] = 't' as byte; hdr[pos+7] = 'i' as byte;
            hdr[pos+8] = 'o' as byte; hdr[pos+9] = 'n' as byte;
            hdr[pos+10] = ':' as byte; hdr[pos+11] = ' ' as byte;
            hdr[pos+12] = 'c' as byte; hdr[pos+13] = 'l' as byte;
            hdr[pos+14] = 'o' as byte; hdr[pos+15] = 's' as byte;
            hdr[pos+16] = 'e' as byte; hdr[pos+17] = '\r' as byte;
            hdr[pos+18] = '\n' as byte;
            pos = pos + 19;
        } else {
            j = 0;
            while j < 24 { hdr[pos] = g_connection_ka[j]; pos = pos + 1; j = j + 1; }
        }
        j = 0;
        while j < 16 { hdr[pos] = g_content_len[j]; pos = pos + 1; j = j + 1; }
        pos = pos + fmt_usize(&hdr[pos] as &byte, body_len);
        j = 0;
        while j < 4 { hdr[pos] = g_crlfcrlf[j]; pos = pos + 1; j = j + 1; }

        var sent: usize = 0;
        while sent < pos {
            const nw: !isize = sys_write(cfd, &hdr[sent] as *byte, pos - sent);
            if nw.error_id != 0 { close_client_fd_quiet(cfd); return; }
            const w: isize = nw.value;
            if w <= 0 { close_client_fd_quiet(cfd); return; }
            sent = sent + (w as usize);
        }
        sent = 0;
        while sent < body_len {
            const nw: !isize = sys_write(cfd, &body_ptr[sent] as *byte, body_len - sent);
            if nw.error_id != 0 { close_client_fd_quiet(cfd); return; }
            const w: isize = nw.value;
            if w <= 0 { close_client_fd_quiet(cfd); return; }
            sent = sent + (w as usize);
        }

        // 9. 更新 HTTP/1.0 keep-alive 会话状态；若本轮需要 close，则关闭连接
        if !wants_close && !http11 {
            http10_session_keep_alive = true;
        }
        if wants_close { close_client_fd_quiet(cfd); return; }
    }
}

fn main_loop() void {
    // 主进程：创建 listen socket
    const lfd: !i32 = sys_socket(2, 1, 6);
    if lfd.error_id != 0 { return; }
    const listen_fd: i32 = lfd.value;
    var reuse: i32 = 1;
    _ = sys_setsockopt(listen_fd, 1, 2, &reuse as &void, 4);  // SO_REUSEADDR
    _ = sys_setsockopt(listen_fd, 1, 15, &reuse as &void, 4); // SO_REUSEPORT
    var addr: [byte: 16] = [];
    addr[0] = 2;
    addr[1] = 0;
    addr[2] = (((PORT >> 8) & (0xff as u16)) as! byte).value;
    addr[3] = ((PORT & (0xff as u16)) as! byte).value;
    addr[4] = 127;
    addr[7] = 1;
    const br: !i32 = sys_bind(listen_fd, &addr[0] as &void, 16);
    if br.error_id != 0 { close_fd(listen_fd); return; }
    _ = sys_listen(listen_fd, BACKLOG);

    // 创建 NUM_PROCESSES 个子进程
    var i: usize = 0;
    while i < NUM_PROCESSES {
        const pid_r: !i64 = sys_fork();
        if pid_r.error_id != 0 { i = i + 1; continue; }
        const pid: i64 = pid_r.value;
        if pid == 0 {
            // 子进程：直接继承同一个 listen_fd 做 accept，避免多套监听 socket 的竞争/分流差异。
            serve_accept_loop(listen_fd);
        }
        i = i + 1;
    }

    // 主进程自己也 accept，并把每个连接再 fork 给独立子进程
    serve_accept_loop(listen_fd);
}

fn argv_is_once() bool {
    if get_argc() < 2 { return false; }
    const p: &byte = get_argv(1);
    if p == null { return false; }
    if p[0] != '-' as byte || p[1] != '-' as byte { return false; }
    if p[2] != 'o' as byte || p[3] != 'n' as byte ||
       p[4] != 'c' as byte || p[5] != 'e' as byte { return false; }
    return p[6] == 0 as byte;
}

fn run_once() void {
    const fd: !i32 = sys_socket(2, 1, 6);
    if fd.error_id != 0 { return; }
    const listen_fd: i32 = fd.value;
    var one: i32 = 1;
    _ = sys_setsockopt(listen_fd, 1, 2, &one as &void, 4);
    var addr: [byte: 16] = [];
    addr[0] = 2;
    addr[1] = 0;
    addr[2] = (((PORT >> 8) & (0xff as u16)) as! byte).value;
    addr[3] = ((PORT & (0xff as u16)) as! byte).value;
    addr[4] = 127;
    addr[7] = 1;
    _ = sys_bind(listen_fd, &addr[0] as &void, 16);
    _ = sys_listen(listen_fd, 1);
    const ar: !i32 = sys_accept(listen_fd, null, 0);
    if ar.error_id != 0 { close_fd(listen_fd); return; }
    handle_client(ar.value);
}

export fn main() i32 {
    set_process_stack_limit_bytes(BENCH_PROCESS_STACK_BYTES);
    _ = signal(SIGPIPE, SIG_IGN as &void);
    _ = signal(SIGCHLD, SIG_IGN as &void);
    init_payloads();
    if argv_is_once() { run_once(); }
    else { main_loop(); }
    return 0;
}
