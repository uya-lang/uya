// The Computer Language Benchmarks Game
// https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
// Uya port of n-body C gcc #6

use std.runtime;
use libc.math;
extern "libc" fn printf(fmt: *byte, ...) i32;
extern "libc" fn atoi(s: &const byte) i32;

const pi: f64 = 3.141592653589793;
const solar_mass: f64 = 4.0 * pi * pi;
const year: f64 = 365.24;

struct Planet {
    x: [f64: 3],
    v: [f64: 3],
    mass: f64,
}

fn advance(bodies: &Planet, dt: f64, steps: i32) void {
    var steps_left: i32 = steps;
    while steps_left > 0 {
        var i: i32 = 0;
        while i < 5 {
            var j: i32 = i + 1;
            while j < 5 {
                var d0: f64 = bodies[i].x[0] - bodies[j].x[0];
                var d1: f64 = bodies[i].x[1] - bodies[j].x[1];
                var d2: f64 = bodies[i].x[2] - bodies[j].x[2];

                var dist2: f64 = d0 * d0 + d1 * d1 + d2 * d2;
                var mag: f64 = dt / (dist2 * sqrt(dist2));

                bodies[i].v[0] = bodies[i].v[0] - d0 * bodies[j].mass * mag;
                bodies[i].v[1] = bodies[i].v[1] - d1 * bodies[j].mass * mag;
                bodies[i].v[2] = bodies[i].v[2] - d2 * bodies[j].mass * mag;

                bodies[j].v[0] = bodies[j].v[0] + d0 * bodies[i].mass * mag;
                bodies[j].v[1] = bodies[j].v[1] + d1 * bodies[i].mass * mag;
                bodies[j].v[2] = bodies[j].v[2] + d2 * bodies[i].mass * mag;

                j = j + 1;
            }
            i = i + 1;
        }

        var i2: i32 = 0;
        while i2 < 5 {
            bodies[i2].x[0] = bodies[i2].x[0] + dt * bodies[i2].v[0];
            bodies[i2].x[1] = bodies[i2].x[1] + dt * bodies[i2].v[1];
            bodies[i2].x[2] = bodies[i2].x[2] + dt * bodies[i2].v[2];
            i2 = i2 + 1;
        }

        steps_left = steps_left - 1;
    }
}

fn energy(bodies: &Planet) f64 {
    var e: f64 = 0.0;
    var i: i32 = 0;
    var j: i32 = 0;
    var k: i32 = 0;
    var d0: f64 = 0.0;
    var d1: f64 = 0.0;
    var d2: f64 = 0.0;

    while i < 5 {
        k = 0;
        while k < 3 {
            e = e + bodies[i].mass * bodies[i].v[k] * bodies[i].v[k] / 2.0;
            k = k + 1;
        }

        j = i + 1;
        while j < 5 {
            d0 = bodies[i].x[0] - bodies[j].x[0];
            d1 = bodies[i].x[1] - bodies[j].x[1];
            d2 = bodies[i].x[2] - bodies[j].x[2];
            e = e - (bodies[i].mass * bodies[j].mass) / sqrt(d0 * d0 + d1 * d1 + d2 * d2);
            j = j + 1;
        }

        i = i + 1;
    }

    return e;
}

fn offset_momentum(bodies: &Planet) void {
    var i: i32 = 0;
    var k: i32 = 0;
    while i < 5 {
        k = 0;
        while k < 3 {
            bodies[0].v[k] = bodies[0].v[k] - bodies[i].v[k] * bodies[i].mass / solar_mass;
            k = k + 1;
        }
        i = i + 1;
    }
}

fn main() i32 {
    var dt: f64 = 0.01;
    var steps: i32 = 1000;

    const argc: i32 = get_argc();
    if argc > 1 {
        const arg1: &byte = get_argv(1);
        steps = atoi(arg1 as &const byte);
    }

    var bodies: [Planet: 5] = [];
    bodies[0] = Planet{ x: [0.0, 0.0, 0.0], v: [0.0, 0.0, 0.0], mass: solar_mass };
    bodies[1] = Planet{ x: [4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01],
                        v: [1.66007664274403694e-03 * year, 7.69901118419740425e-03 * year, -6.90460016972063023e-05 * year],
                        mass: 9.54791938424326609e-04 * solar_mass };
    bodies[2] = Planet{ x: [8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01],
                        v: [-2.76742510726862411e-03 * year, 4.99852801234917238e-03 * year, 2.30417297573763929e-05 * year],
                        mass: 2.85885980666130812e-04 * solar_mass };
    bodies[3] = Planet{ x: [1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01],
                        v: [2.96460137564761618e-03 * year, 2.37847173959480950e-03 * year, -2.96589568540237556e-05 * year],
                        mass: 4.36624404335156298e-05 * solar_mass };
    bodies[4] = Planet{ x: [1.53796971148509165e+01, -2.59193146099879643e+01, 1.79258772950371181e-01],
                        v: [2.68067772490389322e-03 * year, 1.62824170038242295e-03 * year, -9.51592254519715870e-05 * year],
                        mass: 5.15138902046611451e-05 * solar_mass };

    offset_momentum(&bodies[0]);
    printf("%.9f\n", energy(&bodies[0]));
    advance(&bodies[0], dt, steps);
    printf("%.9f\n", energy(&bodies[0]));
    return 0;
}
